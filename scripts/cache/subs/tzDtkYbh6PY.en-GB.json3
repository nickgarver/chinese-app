    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "that you especially recommend?"
    } ]
  }, {
    "tStartMs": 423833,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I usually buy ground coffee"
    } ]
  }, {
    "tStartMs": 426566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "because I have a coffee maker at home,"
    } ]
  }, {
    "tStartMs": 428566,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "so I make my own coffee."
    } ]
  }, {
    "tStartMs": 431733,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Wow, is ground coffee really this expensive now?"
    } ]
  }, {
    "tStartMs": 436300,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I can barely find any under ten dollars."
    } ]
  }, {
    "tStartMs": 442300,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "And these prices are after the discount."
    } ]
  }, {
    "tStartMs": 444333,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "Even on sale, they're $13 or $14. So expensive!"
    } ]
  }, {
    "tStartMs": 448966,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "What should I do? I'll run out of coffee tomorrow."
    } ]
  }, {
    "tStartMs": 452766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hmm..."
    } ]
  }, {
    "tStartMs": 454933,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "Forget it. I won't buy it now—it's too expensive."
    } ]
  }, {
    "tStartMs": 457966,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "I'll check another supermarket next time."
    } ]
  }, {
    "tStartMs": 461233,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "At the supermarket,"
    } ]
  }, {
    "tStartMs": 462933,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "there are some Chinese sentences we may use often."
    } ]
  }, {
    "tStartMs": 467133,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "For example, I just taught you “I want to buy...”"
    } ]
  }, {
    "tStartMs": 471400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "For example, “I want to buy ground coffee.”"
    } ]
  }, {
    "tStartMs": 473600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "You can also say, “I'm looking for ground coffee.”"
    } ]
  }, {
    "tStartMs": 476933,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "“I'm looking for...” Or,"
    } ]
  }, {
    "tStartMs": 479966,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "“Let me think about what I need to buy.”"
    } ]
  }, {
    "tStartMs": 482633,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "What do I need to buy?"
    } ]
  }, {
    "tStartMs": 484900,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "What do I need to buy?"
    } ]
  }, {
    "tStartMs": 487033,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "This section"
    } ]
  }, {
    "tStartMs": 488166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "is all freezer cases."
    } ]
  }, {
    "tStartMs": 491233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Freezer cases."
    } ]
  }, {
    "tStartMs": 493133,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Everything sold in here"
    } ]
  }, {
    "tStartMs": 494700,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "needs to be kept frozen."
    } ]
  }, {
    "tStartMs": 497500,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "For example, this is yogurt. Yogurt."
    } ]
  }, {
    "tStartMs": 501100,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "And there are some frozen foods."
    } ]
  }, {
    "tStartMs": 506133,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Here is the milk. Milk."
    } ]
  }, {
    "tStartMs": 510600,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "Here in Vancouver,"
    } ]
  }, {
    "tStartMs": 512766,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "the milk sold in supermarkets comes in huge jugs."
    } ]
  }, {
    "tStartMs": 517800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "I can't finish one by myself,"
    } ]
  }, {
    "tStartMs": 520166,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "because I don't drink milk every day."
    } ]
  }, {
    "tStartMs": 523966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "So I think such a big jug would be wasteful."
    } ]
  }, {
    "tStartMs": 526533,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "If I can't finish it, it won't stay fresh."
    } ]
  }, {
    "tStartMs": 529333,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "But if you buy the small jug,"
    } ]
  }, {
    "tStartMs": 531300,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "it's not as good a deal."
    } ]
  }, {
    "tStartMs": 533433,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "Let me show you the prices."
    } ]
  }, {
    "tStartMs": 537000,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "Look, the large jug is over six dollars,"
    } ]
  }, {
    "tStartMs": 541700,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "while the small one is over five dollars."
    } ]
  }, {
    "tStartMs": 547233,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "So the large jug is definitely a better deal."
    } ]
  }, {
    "tStartMs": 551833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "But I can't finish the large one."
    } ]
  }, {
    "tStartMs": 556300,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "What I was just doing"
    } ]
  }, {
    "tStartMs": 557233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "was comparing prices."
    } ]
  }, {
    "tStartMs": 559766,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "Compare—compare prices. Right."
    } ]
  }, {
    "tStartMs": 563633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "Look at these seasonings."
    } ]
  }, {
    "tStartMs": 567366,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "These sauces are more"
    } ]
  }, {
    "tStartMs": 570833,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "suited to the kind of cooking you do, right?"
    } ]
  }, {
    "tStartMs": 574433,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "Western food, right?"
    } ]
  }, {
    "tStartMs": 577700,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "But people like us"
    } ]
  }, {
    "tStartMs": 579400,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "use them less often."
    } ]
  }, {
    "tStartMs": 582733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "This section sells many"
    } ]
  }, {
    "tStartMs": 584933,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Asian seasonings."
    } ]
  }, {
    "tStartMs": 588000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "For example, this one:"
    } ]
  }, {
    "tStartMs": 592100,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "Lao Gan Ma chili sauce. Lao Gan Ma chili sauce."
    } ]
  }, {
    "tStartMs": 595366,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "It's something we often eat with our meals."
    } ]
  }, {
    "tStartMs": 598833,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "But supermarkets like this"
    } ]
  }, {
    "tStartMs": 600600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "don't sell a very large selection."
    } ]
  }, {
    "tStartMs": 602533,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Usually, when I need sauces or seasonings,"
    } ]
  }, {
    "tStartMs": 605033,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "I go to a Chinese supermarket."
    } ]
  }, {
    "tStartMs": 607833,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Oh, right—earlier,"
    } ]
  }, {
    "tStartMs": 610433,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "some of you reminded me"
    } ]
  }, {
    "tStartMs": 612366,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "that this pizza needs to go in the freezer. Aha!"
    } ]
  }, {
    "tStartMs": 617433,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "Some friends even emailed me"
    } ]
  }, {
    "tStartMs": 620200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "to tell me to put it in the freezer."
    } ]
  }, {
    "tStartMs": 622600,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "Now I know!"
    } ]
  }, {
    "tStartMs": 623733,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I immediately put it in the freezer compartment"
    } ]
  }, {
    "tStartMs": 627400,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "of my refrigerator."
    } ]
  }, {
    "tStartMs": 628733,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Thank you, really!"
    } ]
  }, {
    "tStartMs": 631000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Look,"
    } ]
  }, {
    "tStartMs": 631966,
    "dDurationMs": 5267,
    "segs": [ {
      "utf8": "this supermarket also sells my favorite dumplings."
    } ]
  }, {
    "tStartMs": 637233,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "These—"
    } ]
  }, {
    "tStartMs": 639300,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "I absolutely love these dumplings."
    } ]
  }, {
    "tStartMs": 647033,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "These are pork and napa cabbage dumplings."
    } ]
  }, {
    "tStartMs": 652033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 653366,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But I'm not planning to buy them today"
    } ]
  }, {
    "tStartMs": 655833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "because I still have two bags at home."
    } ]
  }, {
    "tStartMs": 657833,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "I want to finish those before buying more. Haha!"
    } ]
  }, {
    "tStartMs": 660333,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "We open the freezer door. Open it."
    } ]
  }, {
    "tStartMs": 664166,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "Then put them back. Put them back."
    } ]
  }, {
    "tStartMs": 669700,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "And close it again. Close it."
    } ]
  }, {
    "tStartMs": 673033,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "I also really like buying frozen vegetables like these"
    } ]
  }, {
    "tStartMs": 676500,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "because they're very convenient."
    } ]
  }, {
    "tStartMs": 677766,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "You can just toss them into a pot and cook them."
    } ]
  }, {
    "tStartMs": 681600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "We call these frozen vegetables."
    } ]
  }, {
    "tStartMs": 683900,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Frozen vegetables."
    } ]
  }, {
    "tStartMs": 686200,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Something like this"
    } ]
  }, {
    "tStartMs": 687100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "is called a price tag."
    } ]
  }, {
    "tStartMs": 690233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "A label with the price—a tag."
    } ]
  }, {
    "tStartMs": 692733,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "It shows the price of each product."
    } ]
  }, {
    "tStartMs": 700700,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "Next, I'm going to look at the meat."
    } ]
  }, {
    "tStartMs": 702600,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "Let's see if there are any good deals or specials."
    } ]
  }, {
    "tStartMs": 706533,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "I really feel that in this episode,"
    } ]
  }, {
    "tStartMs": 708100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I've kept talking about two words:"
    } ]
  }, {
    "tStartMs": 710200,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "one is “a good deal,”"
    } ]
  }, {
    "tStartMs": 711733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "and the other is “on sale.”"
    } ]
  }, {
    "tStartMs": 713966,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "That's because the cost of living here is really high,"
    } ]
  }, {
    "tStartMs": 717133,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "so you have to spend carefully"
    } ]
  }, {
    "tStartMs": 720533,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "and be very frugal."
    } ]
  }, {
    "tStartMs": 723500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "Hey, I can see myself here! Haha!"
    } ]
  }, {
    "tStartMs": 726233,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Okay, over here is the chicken."
    } ]
  }, {
    "tStartMs": 730833,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I think chicken is very expensive in Canada."
    } ]
  }, {
    "tStartMs": 733933,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "It's almost the same price as pork."
    } ]
  }, {
    "tStartMs": 738833,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Over here are some sausages."
    } ]
  }, {
    "tStartMs": 743300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "And over here is the pork."
    } ]
  }, {
    "tStartMs": 746900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "For this one, look—"
    } ]
  }, {
    "tStartMs": 748566,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "there's a label on it."
    } ]
  }, {
    "tStartMs": 749966,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It says “$2 off.”"
    } ]
  }, {
    "tStartMs": 753566,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "In Chinese, we would say “two dollars cheaper”"
    } ]
  }, {
    "tStartMs": 757500,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "or “two dollars off.”"
    } ]
  }, {
    "tStartMs": 760666,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "And look at what's written up here."
    } ]
  }, {
    "tStartMs": 762233,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "These are points. Points."
    } ]
  }, {
    "tStartMs": 766433,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "When we shop at a supermarket,"
    } ]
  }, {
    "tStartMs": 769033,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "we usually have a supermarket rewards card."
    } ]
  }, {
    "tStartMs": 772166,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "When we use that rewards card"
    } ]
  }, {
    "tStartMs": 773633,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "to buy things,"
    } ]
  }, {
    "tStartMs": 776000,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "points are added to our account."
    } ]
  }, {
    "tStartMs": 778266,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "It's a great deal."
    } ]
  }, {
    "tStartMs": 780366,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "These points"
    } ]
  }, {
    "tStartMs": 781266,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "can be redeemed for money in the future."
    } ]
  }, {
    "tStartMs": 784433,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Let me show you."
    } ]
  }, {
    "tStartMs": 785266,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "I often buy this rotisserie chicken too,"
    } ]
  }, {
    "tStartMs": 788100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "but their rotisserie chicken is a little expensive:"
    } ]
  }, {
    "tStartMs": 791033,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "$13.99. Mm-hmm."
    } ]
  }, {
    "tStartMs": 793233,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "Wow, it's nice and hot!"
    } ]
  }, {
    "tStartMs": 795466,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "When we shop, we often say,"
    } ]
  }, {
    "tStartMs": 798700,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "“This product is a little expensive,”"
    } ]
  }, {
    "tStartMs": 801633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "or “It's a little cheap.”"
    } ]
  }, {
    "tStartMs": 804233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Expensive; cheap."
    } ]
  }, {
    "tStartMs": 806100,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "That's how we say it when comparing things:"
    } ]
  }, {
    "tStartMs": 809000,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "“a little expensive,” “a little cheap,”"
    } ]
  }, {
    "tStartMs": 812066,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "or “This is a really good deal,”"
    } ]
  }, {
    "tStartMs": 814000,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "or “This is a good price.”"
    } ]
  }, {
    "tStartMs": 816466,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "If you want to ask the price,"
    } ]
  }, {
    "tStartMs": 818166,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "we usually say,"
    } ]
  }, {
    "tStartMs": 819466,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "“How much is this?”"
    } ]
  }, {
    "tStartMs": 823800,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "All right, because I don't have much time,"
    } ]
  }, {
    "tStartMs": 826566,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I have to go home."
    } ]
  }, {
    "tStartMs": 827966,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "And from my original shopping list,"
    } ]
  }, {
    "tStartMs": 831633,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "I didn't buy very many things."
    } ]
  }, {
    "tStartMs": 834100,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "I only bought grapes and bananas, so"
    } ]
  }, {
    "tStartMs": 838666,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "I've decided to take that bag of mandarins—"
    } ]
  }, {
