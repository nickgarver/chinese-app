  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 60700,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "Episode 11 Has Sun Wukong learned it"
    } ]
  }, {
    "tStartMs": 65466,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "In the last episode\nthe master promised Sun Wukong"
    } ]
  }, {
    "tStartMs": 68566,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "to teach him how to avoid danger"
    } ]
  }, {
    "tStartMs": 72366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "Sun Wukong was very happy"
    } ]
  }, {
    "tStartMs": 75466,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "He watched his master carefully"
    } ]
  }, {
    "tStartMs": 79766,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "The master said There are two methods"
    } ]
  }, {
    "tStartMs": 84700,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "One is the Thirty-Six Transformations"
    } ]
  }, {
    "tStartMs": 88133,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "The other is\nthe Seventy-Two Transformations"
    } ]
  }, {
    "tStartMs": 91600,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "Which one do you want to learn"
    } ]
  }, {
    "tStartMs": 97200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "Sun Wukong thought for a moment"
    } ]
  }, {
    "tStartMs": 100766,
    "dDurationMs": 4634,
    "segs": [ {
      "utf8": "He said I want to learn\nthe Seventy-Two Transformations"
    } ]
  }, {
    "tStartMs": 105800,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "Seventy-two is more than thirty-six"
    } ]
  }, {
    "tStartMs": 110766,
    "dDurationMs": 6634,
    "segs": [ {
      "utf8": "The master asked Sun Wukong to come closer"
    } ]
  }, {
    "tStartMs": 117400,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "The master spoke softly\ninto Sun Wukong's ear"
    } ]
  }, {
    "tStartMs": 123666,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "Sun Wukong listened for a long time"
    } ]
  }, {
    "tStartMs": 127100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "He now knew how to transform"
    } ]
  }, {
    "tStartMs": 130133,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "Sun Wukong had to practice\nthe Seventy-Two Transformations carefully"
    } ]
  }, {
    "tStartMs": 137200,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "Sun Wukong practiced during the day"
    } ]
  }, {
    "tStartMs": 140266,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "and also at night"
    } ]
  }, {
    "tStartMs": 143100,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "He could turn into a tree"
    } ]
  }, {
    "tStartMs": 145200,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "He could also turn into a stone"
    } ]
  }, {
    "tStartMs": 147866,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "He could turn into many other things too"
    } ]
  }, {
    "tStartMs": 151600,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Sun Wukong learned\nthe Seventy-Two Transformations"
    } ]
  }, {
    "tStartMs": 156733,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "One day\nthe master and everyone else went outside"
    } ]
  }, {
    "tStartMs": 161966,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "The master asked Can you fly now"
    } ]
  }, {
    "tStartMs": 167733,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Sun Wukong said I can"
    } ]
  }, {
    "tStartMs": 170900,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "I will fly and show everyone"
    } ]
  }, {
    "tStartMs": 174966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "Sun Wukong jumped onto a cloud"
    } ]
  }, {
    "tStartMs": 177766,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "He walked for a long time"
    } ]
  }, {
    "tStartMs": 179766,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "but only traveled three li"
    } ]
  }, {
    "tStartMs": 182133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "He said"
    } ]
  }, {
    "tStartMs": 183466,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Master I can ride clouds now"
    } ]
  }, {
    "tStartMs": 188133,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The master smiled and said"
    } ]
  }, {
    "tStartMs": 190800,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "That is not cloud riding"
    } ]
  }, {
    "tStartMs": 193566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "You are just walking on a cloud"
    } ]
  }, {
    "tStartMs": 197000,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "Those who can ride clouds\ncan fly across four seas in a day"
    } ]
  }, {
    "tStartMs": 202933,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Sun Wukong said"
    } ]
  }, {
    "tStartMs": 204966,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "That is too hard"
    } ]
  }, {
    "tStartMs": 208466,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "Sun Wukong bowed to his master"
    } ]
  }, {
    "tStartMs": 212166,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "He said Please teach me how to ride clouds"
    } ]
  }, {
    "tStartMs": 217100,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The master said You just did a somersault"
    } ]
  }, {
    "tStartMs": 221800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So I will teach you the Somersault Cloud"
    } ]
  }, {
    "tStartMs": 226066,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "That night Sun Wukong practiced hard"
    } ]
  }, {
    "tStartMs": 229666,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "He did a somersault"
    } ]
  }, {
    "tStartMs": 231666,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "and jumped onto the Somersault Cloud"
    } ]
  }, {
    "tStartMs": 234266,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "The Somersault Cloud\nflew far away in an instant"
    } ]
  }, {
    "tStartMs": 239733,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "Sun Wukong learned the Somersault Cloud"
    } ]
  } ]
}
