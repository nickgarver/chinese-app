    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "kě yǐ yòng zhī fù bǎo zhí jiē\nYou can use Alipay directly"
    } ]
  }, {
    "tStartMs": 740700,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "zuò gōng jiāo chē huò zhě zuò dì tiě\nTo take the bus or subway"
    } ]
  }, {
    "tStartMs": 744633,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "hěn fāng biàn\nVery convenient"
    } ]
  }, {
    "tStartMs": 746533,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "rú guǒ nǐ yào zuò huǒ chē\nIf you want to take the train"
    } ]
  }, {
    "tStartMs": 749066,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "kě yǐ qù huǒ chē zhàn mǎi piào\nYou can go to the train station to buy tickets"
    } ]
  }, {
    "tStartMs": 752500,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "méi yǒu wèn tí\nNo problem"
    } ]
  }, {
    "tStartMs": 754000,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "nà lǐ yǒu jī qì yě yǒu rén   kě yǐ mǎi piào\nThere are machines and people there, you can buy tickets"
    } ]
  }, {
    "tStartMs": 759466,
    "dDurationMs": 4967,
    "segs": [ {
      "utf8": "dàn shì wǒ men yì bān huì yòng yí gè ruǎn jiàn   yí gè a p p\nBut we usually use a software, an app"
