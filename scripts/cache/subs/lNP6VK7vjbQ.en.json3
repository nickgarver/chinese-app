    } ]
  }, {
    "tStartMs": 806000,
    "dDurationMs": 4499,
    "segs": [ {
      "utf8": "dāng rán rú guǒ nǐ xiǎng dǎ chē   nǐ kě yǐ yòng dī dī\nOf course, if you want to take a taxi, you can use Didi"
    } ]
  }, {
    "tStartMs": 810600,
    "dDurationMs": 4633,
    "segs": [ {
