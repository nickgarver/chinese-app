    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "wǒ zuì xǐ huan de jiāo tōng fāng shì hái shì zǒu lù\nMy favorite way to get around is still walking"
    } ]
  }, {
    "tStartMs": 854566,
    "dDurationMs": 6167,
    "segs": [ {
