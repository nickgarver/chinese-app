  }, {
    "tStartMs": 818233,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "nà wǒ zuì xǐ huan de jiāo tōng fāng shì hái shì zǒu lù\nBut my favorite way to get around is still walking"
    } ]
  }, {
    "tStartMs": 823600,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "yīn wèi rú guǒ wǒ yào qù de dì fāng bú tài yuǎn\nBecause if the place I'm going isn't too far"
    } ]
  }, {
    "tStartMs": 829100,
    "dDurationMs": 6366,
    "segs": [ {
      "utf8": "bǐ rú zhǐ yǒu yì gōng lǐ 、 liǎng gōng lǐ huò zhě sān gōng lǐ\nlike only one kilometer, two kilometers, or three kilometers"
    } ]
  }, {
    "tStartMs": 835466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "wǒ huì xuǎn zé zǒu lù\nI'll choose to walk"
    } ]
  }, {
    "tStartMs": 838433,
    "dDurationMs": 2766,
    "segs": [ {
