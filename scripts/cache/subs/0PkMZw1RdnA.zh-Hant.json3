{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 133,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "每當我回想起幼年的時候"
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "我就覺得我的幼年無比快樂"
    } ]
  }, {
    "tStartMs": 8333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "幼年總是會結束的"
    } ]
  }, {
    "tStartMs": 11233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "一定要適應長大的生活"
    } ]
  }, {
    "tStartMs": 15733,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "這是8歲時的我寫的"
    } ]
  }, {
    "tStartMs": 19433,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "我8歲的時候就開始懷念我的幼年了"
    } ]
  }, {
    "tStartMs": 24966,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "最近我在我的爸媽家裡翻到了"
    } ]
  }, {
    "tStartMs": 28933,
    "dDurationMs": 5533,
    "segs": [ {
      "utf8": "這些從小學到高中的作文本"
    } ]
  }, {
    "tStartMs": 35100,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "7歲到17歲"
    } ]
  }, {
    "tStartMs": 38333,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我真的沒想到他們還留著"
    } ]
  }, {
    "tStartMs": 41033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "所以今天我想跟你們一起看一看"
    } ]
  }, {
    "tStartMs": 44233,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "一箇中國小孩是怎麼"
    } ]
  }, {
    "tStartMs": 46866,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "一點一點學會用中文寫作的"
    } ]
  }, {
    "tStartMs": 51833,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "每一個在中國上小學或者中學的人"
    } ]
  }, {
    "tStartMs": 56466,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "都必須寫作文"
    } ]
  }, {
    "tStartMs": 59833,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "都必須用作文通過語文考試"
    } ]
  }, {
    "tStartMs": 64733,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "小時候我們什麼都寫。寫人，寫動物"
    } ]
  }, {
    "tStartMs": 69533,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "寫植物，寫一次經歷，寫景，寫日記"
    } ]
  }, {
    "tStartMs": 75700,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "後來還會寫調查、議論文"
    } ]
  }, {
    "tStartMs": 79166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "在我的印象裡"
    } ]
  }, {
    "tStartMs": 80766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "不管是小學還是中學"
    } ]
  }, {
    "tStartMs": 83633,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "每個星期我們都要練習寫作文"
    } ]
  }, {
    "tStartMs": 88033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "寫完以後"
    } ]
  }, {
    "tStartMs": 89300,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "老師還會批改、打分、寫評語"
    } ]
  }, {
    "tStartMs": 95233,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "那你們可以看到我有這麼多的作文本"
    } ]
  }, {
    "tStartMs": 100000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "應該你們也會好奇"
    } ]
  }, {
    "tStartMs": 102633,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "為什麼呢？"
    } ]
  }, {
    "tStartMs": 104266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "寫作文很重要嗎？"
    } ]
  }, {
    "tStartMs": 106800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "是的。因為"
    } ]
  }, {
    "tStartMs": 108833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "在當時的語文考試裡"
    } ]
  }, {
    "tStartMs": 111133,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "作文一般是很大很大的一個部分"
    } ]
  }, {
    "tStartMs": 115000,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我們甚至會有一句比較誇張的話"
    } ]
  }, {
    "tStartMs": 118833,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "得作文者得天下"
    } ]
  }, {
    "tStartMs": 122700,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "意思差不多就是"
    } ]
  }, {
    "tStartMs": 124633,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "如果你的作文成績好"
    } ]
  }, {
    "tStartMs": 127400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "你的語文成績差不多就穩了一半"
    } ]
  }, {
    "tStartMs": 131466,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "不過"
    } ]
  }, {
    "tStartMs": 133133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "小學中學時的我"
    } ]
  }, {
    "tStartMs": 135533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "真的喜歡寫作文嗎？"
    } ]
  }, {
    "tStartMs": 138866,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "真的能寫出好作文嗎？"
    } ]
  }, {
    "tStartMs": 142500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "今天我就想和你們一起來"
    } ]
  }, {
    "tStartMs": 144833,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "讀一讀不同年級的我寫的幾篇作文"
    } ]
  }, {
    "tStartMs": 149633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "第一篇作文"
    } ]
  }, {
    "tStartMs": 151666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "二年級的"
    } ]
  }, {
    "tStartMs": 153233,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "8歲的我寫的"
    } ]
  }, {
    "tStartMs": 155900,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "題目叫《西瓜》"
    } ]
  }, {
    "tStartMs": 158900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "當時的老師給了我一個優"
    } ]
  }, {
    "tStartMs": 161833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "加三顆星"
    } ]
  }, {
    "tStartMs": 165233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我最喜歡吃的水果是西瓜"
    } ]
  }, {
    "tStartMs": 169466,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "西瓜又大又圓"
    } ]
  }, {
    "tStartMs": 171933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "像個大皮球"
    } ]
  }, {
    "tStartMs": 174833,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "它有一條小辮子"
    } ]
  }, {
    "tStartMs": 177533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "又細又短"
    } ]
  }, {
    "tStartMs": 179333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "像小豬的尾巴"
    } ]
  }, {
    "tStartMs": 181666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "熟透的西瓜穿著一件濃淡相間的衣服"
    } ]
  }, {
    "tStartMs": 187466,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "上面還點綴著一個個黑色的小斑紋"
    } ]
  }, {
    "tStartMs": 192233,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "外形真是好看極了"
    } ]
  }, {
    "tStartMs": 195000,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "我本來以為8歲的我中文會特別簡單"
    } ]
  }, {
    "tStartMs": 200000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "特別幼稚"
    } ]
  }, {
    "tStartMs": 201433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "可是打開一看"
    } ]
  }, {
    "tStartMs": 202900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "並不是這樣的"
    } ]
  }, {
    "tStartMs": 204833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "裡面還有很多比喻"
    } ]
  }, {
    "tStartMs": 207133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "很多複雜的"
    } ]
  }, {
    "tStartMs": 208433,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "可能你們也不知道的形容詞"
    } ]
  }, {
    "tStartMs": 211533,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "為什麼呢？"
    } ]
  }, {
    "tStartMs": 212900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "現在我想起來了"
    } ]
  }, {
    "tStartMs": 214933,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "當時一年級二年級剛進小學的時候"
    } ]
  }, {
    "tStartMs": 220100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我們怎麼可能會"
    } ]
  }, {
    "tStartMs": 222200,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "一開始就直接寫作文呀"
    } ]
  }, {
    "tStartMs": 225333,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "當時的老師肯定是讓我們先去模仿"
    } ]
  }, {
    "tStartMs": 229033,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我們要學會模仿"
    } ]
  }, {
    "tStartMs": 231466,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "讓自己寫出來的中文像作文"
    } ]
  }, {
    "tStartMs": 236033,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "而不像直接嘴巴說出來的"
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我們模仿學到的課文"
    } ]
  }, {
    "tStartMs": 243300,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "模仿老師教給我們的表達"
    } ]
  }, {
    "tStartMs": 246333,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "努力去用新學的詞語"
    } ]
  }, {
    "tStartMs": 249533,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "那個階段是不是和你們"
    } ]
  }, {
    "tStartMs": 252333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "學中文的時候有點像呢？"
    } ]
  }, {
    "tStartMs": 266733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "第二篇作文"
    } ]
  }, {
    "tStartMs": 268500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "三年級寫的"
    } ]
  }, {
    "tStartMs": 270533,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "當時我9歲"
    } ]
  }, {
    "tStartMs": 275100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "陪表妹玩"
    } ]
  }, {
    "tStartMs": 277466,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "每個禮拜天"
    } ]
  }, {
    "tStartMs": 279066,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "表妹都要來我家玩、吃飯"
    } ]
  }, {
    "tStartMs": 283000,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "表妹是我舅舅的女兒"
    } ]
  }, {
    "tStartMs": 285466,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "剛滿4週歲"
    } ]
  }, {
    "tStartMs": 287800,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "廢話卻一籮筐"
    } ]
  }, {
    "tStartMs": 290400,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "一籮筐的廢話"
    } ]
  }, {
    "tStartMs": 293200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "這天表妹又來了"
    } ]
  }, {
    "tStartMs": 296666,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "那時我正在做作業"
    } ]
  }, {
    "tStartMs": 300066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "不想陪她玩"
    } ]
  }, {
    "tStartMs": 302300,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "可是不陪"
    } ]
  }, {
    "tStartMs": 303866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "老媽又要嘮叨半天"
    } ]
  }, {
    "tStartMs": 306833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我只好不情願的答應了"
    } ]
  }, {
    "tStartMs": 312633,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "表妹拿出我的一些玩具"
    } ]
  }, {
    "tStartMs": 315500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "叫我做病人"
    } ]
  }, {
    "tStartMs": 317400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "她做醫生"
    } ]
  }, {
    "tStartMs": 319633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "又叫我到她跟前"
    } ]
  }, {
    "tStartMs": 322200,
    "dDurationMs": 5333,
    "segs": [ {
      "utf8": "她裝模作樣的給我打針開藥"
    } ]
  }, {
    "tStartMs": 327933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "搞得我哭笑不得"
    } ]
  }, {
    "tStartMs": 332033,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "她又要玩超市遊戲"
    } ]
  }, {
    "tStartMs": 334800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "表妹讓我當顧客"
    } ]
  }, {
    "tStartMs": 336833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "她當服務員"
    } ]
  }, {
    "tStartMs": 339200,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "我拿出一些要買的物品給表妹"
    } ]
  }, {
    "tStartMs": 343433,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "她用我的電話碰一下物品"
    } ]
  }, {
    "tStartMs": 347100,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "我假裝拿出一些錢給她"
    } ]
  }, {
    "tStartMs": 351600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "她接過錢，把物品給我"
    } ]
  }, {
    "tStartMs": 356000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "吃飯的時間到了"
    } ]
  }, {
    "tStartMs": 357833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "我終於不用陪她玩了"
    } ]
  }, {
    "tStartMs": 360866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "謝天謝地"
    } ]
  }, {
    "tStartMs": 362733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "當時的我還貼心的提醒老師"
    } ]
  }, {
    "tStartMs": 365866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "反面還有"
    } ]
  }, {
    "tStartMs": 367466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "這篇作文還沒有結束呢"
    } ]
  }, {
    "tStartMs": 372600,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "哎，你說這個表妹煩不煩？"
    } ]
  }, {
    "tStartMs": 378100,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "說實話，我看到題目《陪表妹玩》的時候"
    } ]
  }, {
    "tStartMs": 382633,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "我真的沒有想到"
    } ]
  }, {
    "tStartMs": 383866,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "這是一篇有一點抱怨的作文"
    } ]
  }, {
    "tStartMs": 387433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "但是是很真實的情緒"
    } ]
  }, {
    "tStartMs": 390066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是很真實的故事"
    } ]
  }, {
    "tStartMs": 392133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "我讀的時候感覺自己"
    } ]
  }, {
    "tStartMs": 394466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "彷彿回到了那個時候"
    } ]
  }, {
    "tStartMs": 397333,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "三年級的我"
    } ]
  }, {
    "tStartMs": 398866,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "9歲的我"
    } ]
  }, {
    "tStartMs": 400333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "沒有再繼續模仿寫作文了"
    } ]
  }, {
    "tStartMs": 403433,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "而是開始真正寫發生在自己身上的事"
    } ]
  }, {
    "tStartMs": 408700,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "哎，現在想想"
    } ]
  }, {
    "tStartMs": 410066,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我的表妹也已經成年了"
    } ]
  }, {
    "tStartMs": 413100,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "但當時的我倆其實都是"
    } ]
  }, {
    "tStartMs": 415666,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "差不了太多的小孩子"
    } ]
  }, {
    "tStartMs": 418333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "三年級的時候還有一篇作文"
    } ]
  }, {
    "tStartMs": 420500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "我也想跟你們分享"
    } ]
  }, {
    "tStartMs": 422833,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "題目叫《我的自畫像》"
    } ]
  }, {
    "tStartMs": 426433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "不是真的是一幅畫"
    } ]
  }, {
    "tStartMs": 428666,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "是一篇介紹自己的作文"
    } ]
  }, {
    "tStartMs": 432500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我是一個平凡的女孩"
    } ]
  }, {
    "tStartMs": 435733,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "今年8週歲了"
    } ]
  }, {
    "tStartMs": 438533,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我梳著蘑菇頭"
    } ]
  }, {
    "tStartMs": 441466,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "鼻子小小的"
    } ]
  }, {
    "tStartMs": 443900,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "眼睛也很小"
    } ]
  }, {
    "tStartMs": 446266,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "但是很有神"
    } ]
  }, {
    "tStartMs": 449233,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我這個人急性子"
    } ]
  }, {
    "tStartMs": 452066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "做什麼事都匆匆忙忙"
    } ]
  }, {
    "tStartMs": 454733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "但我很有好奇心"
    } ]
  }, {
    "tStartMs": 457066,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "一有什麼新鮮事就跑上去湊熱鬧"
    } ]
  }, {
    "tStartMs": 462400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我呀，興趣愛好多著呢"
    } ]
  }, {
    "tStartMs": 465666,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "書法、鋼琴、素描、英語"
    } ]
  }, {
    "tStartMs": 469800,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "每天晚上都要練一小時鋼琴"
    } ]
  }, {
    "tStartMs": 472733,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "一小時書法，真累呀"
    } ]
  }, {
    "tStartMs": 476800,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我最喜歡的運動是跑步、排球"
    } ]
  }, {
    "tStartMs": 480800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "這就是我"
    } ]
  }, {
    "tStartMs": 482333,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "你願意和我做朋友嗎？"
    } ]
  }, {
    "tStartMs": 486033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "當時的老師還給了一個評語"
    } ]
  }, {
    "tStartMs": 489133,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "作文如有具體實例來寫自己的特點"
    } ]
  }, {
    "tStartMs": 493633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就生動了"
    } ]
  }, {
    "tStartMs": 495700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "然後給了我一個優減"
    } ]
  }, {
    "tStartMs": 497966,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "你們可別小看這個減號的力量"
    } ]
  }, {
    "tStartMs": 502033,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "當時的“優減”對我來說比“優”差多了"
    } ]
  }, {
    "tStartMs": 507300,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就像c和a的差別一樣"
    } ]
  }, {
    "tStartMs": 510633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "但現在看著這篇自我介紹"
    } ]
  }, {
    "tStartMs": 513866,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "感覺現在的我和當時差別也不大嘛"
    } ]
  }, {
    "tStartMs": 518866,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "可能只是髮型變了"
    } ]
  }, {
    "tStartMs": 521300,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "更加有耐心了"
    } ]
  }, {
    "tStartMs": 523466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但是還是想找人做朋友"
    } ]
  }, {
    "tStartMs": 525933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "但是我覺得現在對我來說"
    } ]
  }, {
    "tStartMs": 529200,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "自我介紹真的沒那麼容易了"
    } ]
  }, {
    "tStartMs": 532033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "有好多想說的"
    } ]
  }, {
    "tStartMs": 533766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "不知道跟別人說什麼"
    } ]
  }, {
    "tStartMs": 536333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "但是當時多簡單"
    } ]
  }, {
    "tStartMs": 538966,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "然後我還發現一件特別有意思的事"
    } ]
  }, {
    "tStartMs": 541733,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "就是你們看這些紙"
    } ]
  }, {
    "tStartMs": 544633,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "它們不是平的"
    } ]
  }, {
    "tStartMs": 546833,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "它們凹凸不平"
    } ]
  }, {
    "tStartMs": 549800,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "因為當時寫字"
    } ]
  }, {
    "tStartMs": 551666,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我真的特別用力"
    } ]
  }, {
    "tStartMs": 554066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "一筆一畫都寫得特別用力"
    } ]
  }, {
    "tStartMs": 558033,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "每一筆都會壓到後面幾張紙上"
    } ]
  }, {
    "tStartMs": 564566,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "其實你們可以看"
    } ]
  }, {
    "tStartMs": 565833,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "現在我的中指這邊還有一個老繭"
    } ]
  }, {
    "tStartMs": 570766,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "快沒有了"
    } ]
  }, {
    "tStartMs": 571733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "因為現在寫字不太多"
    } ]
  }, {
    "tStartMs": 573800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "但是這個老繭就是小時候用"
    } ]
  }, {
    "tStartMs": 576133,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "右手寫字太用力抓筆留下的"
    } ]
  }, {
    "tStartMs": 582600,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "所以啊"
    } ]
  }, {
    "tStartMs": 583266,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "我們中國人小時候學寫中文也真的"
    } ]
  }, {
    "tStartMs": 587333,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "是一筆一畫寫出來、記下來的"
    } ]
  }, {
    "tStartMs": 592433,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "告訴你們一個秘密"
    } ]
  }, {
    "tStartMs": 594200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "其實當時我們學漢字也"
    } ]
  }, {
    "tStartMs": 596833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "經常就是一個字一個詞"
    } ]
  }, {
    "tStartMs": 599433,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "要重複寫30遍50遍"
    } ]
  }, {
    "tStartMs": 603500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "這是我們的作業"
    } ]
  }, {
    "tStartMs": 606000,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我想"
    } ]
  }, {
    "tStartMs": 607033,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "如果我也給我的學生布置這樣的作業"
    } ]
  }, {
    "tStartMs": 611000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "你們會接受嗎？"
    } ]
  }, {
    "tStartMs": 613266,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "第三篇，六年級的作文"
    } ]
  }, {
    "tStartMs": 616633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "當時我12歲"
    } ]
  }, {
    "tStartMs": 619200,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "這篇作文我必須要跟你們分享"
    } ]
  }, {
    "tStartMs": 622433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "因為它和其他的作文不太一樣"
    } ]
  }, {
    "tStartMs": 625766,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "我寫的不再是花草小動物或者我自己"
    } ]
  }, {
    "tStartMs": 630733,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "這篇作文的題目叫"
    } ]
  }, {
    "tStartMs": 633800,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "《我班同學一個月零花錢使用統計》"
    } ]
  }, {
    "tStartMs": 637833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "隨著同學們年齡的增長"
    } ]
  }, {
    "tStartMs": 640866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "所需要的東西越來越多"
    } ]
  }, {
    "tStartMs": 643666,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "也要有屬於自己的零花錢了"
    } ]
  }, {
    "tStartMs": 646800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你們覺不覺得有種HSK"
    } ]
  }, {
    "tStartMs": 649233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "考試閱讀理解的味道"
    } ]
  }, {
    "tStartMs": 652000,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "今天我調查20個身邊的同學"
    } ]
  }, {
    "tStartMs": 654866,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "的零花錢數量和使用情況"
    } ]
  }, {
    "tStartMs": 658533,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "有50%的同學每月零花錢是100元以上"
    } ]
  }, {
    "tStartMs": 663533,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "500元以下的"
    } ]
  }, {
    "tStartMs": 665200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "是最多的"
    } ]
  }, {
    "tStartMs": 667166,
    "dDurationMs": 4434,
    "segs": [ {
      "utf8": "有15%的同學是500元及以上的"
    } ]
  }, {
    "tStartMs": 671766,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "我個人認為這有點多了"
    } ]
  }, {
    "tStartMs": 675833,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "我還調查了他們零花錢的使用情況"
    } ]
  }, {
    "tStartMs": 679800,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "有50%的學生使用零花錢主要買吃的"
    } ]
  }, {
    "tStartMs": 685466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "看來他們都是吃貨啊"
    } ]
  }, {
    "tStartMs": 688633,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "有30%的學生是用來買自己喜歡"
    } ]
  }, {
    "tStartMs": 693866,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "的亂七八糟的小玩意兒的"
    } ]
  }, {
    "tStartMs": 697000,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "看來同學們不太喜歡學習啊"
    } ]
  }, {
    "tStartMs": 700733,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "用在玩樂上的比較多"
    } ]
  }, {
    "tStartMs": 704333,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "現在的我要敲敲當時的我的小腦袋"
    } ]
  }, {
    "tStartMs": 708433,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "你這個人啊"
    } ]
  }, {
    "tStartMs": 709600,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "怎麼能這樣想"
    } ]
  }, {
    "tStartMs": 711233,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那麼小的我們就應該花錢在玩樂上啊"
    } ]
  }, {
    "tStartMs": 714966,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "花那麼多錢在學習上幹嘛"
    } ]
  }, {
    "tStartMs": 717533,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "後面那麼多年等著花錢在學習上呢"
    } ]
  }, {
    "tStartMs": 722566,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "唉"
    } ]
  }, {
    "tStartMs": 723200,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "可能當時是為了討好老師才這麼寫吧"
    } ]
  }, {
    "tStartMs": 727833,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "我覺得家長不應該給予孩子太多錢"
    } ]
  }, {
    "tStartMs": 732566,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "父母賺錢也很辛苦的"
    } ]
  }, {
    "tStartMs": 735466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "哎，到結尾就說教起來了"
    } ]
  }, {
    "tStartMs": 738700,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "不行"
    } ]
  }, {
    "tStartMs": 739733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但這篇作文還真"
    } ]
  }, {
    "tStartMs": 741333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "有點像個小型的調查報告"
    } ]
  }, {
    "tStartMs": 744000,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "在這一個方面還是要"
    } ]
  }, {
    "tStartMs": 745866,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "給當時的我點個贊"
    } ]
  }, {
    "tStartMs": 748433,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小學的最後兩年"
    } ]
  }, {
    "tStartMs": 750600,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "我遇到了我當時非常喜歡的語文老師"
    } ]
  }, {
    "tStartMs": 754766,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "現在看這些作文也能看到"
    } ]
  }, {
    "tStartMs": 757600,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "她當時多麼會鼓勵人"
    } ]
  }, {
    "tStartMs": 760566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "你們看這一篇她寫了“好棒呀”"
    } ]
  }, {
    "tStartMs": 763633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "這邊有個笑臉"
    } ]
  }, {
    "tStartMs": 765433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "這邊也有個笑臉"
    } ]
  }, {
    "tStartMs": 768433,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "這邊也說“丫頭，真棒！”"
    } ]
  }, {
    "tStartMs": 772966,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "這邊也說“相信你是好樣的！” 笑臉"
    } ]
  }, {
    "tStartMs": 777533,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "所以我當時寫作文也是充滿了熱情"
    } ]
  }, {
    "tStartMs": 781666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "會在上面畫這種搞怪"
    } ]
  }, {
    "tStartMs": 783566,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "的表情和老師互動"
    } ]
  }, {
    "tStartMs": 785933,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "然後我上初中了"
    } ]
  }, {
    "tStartMs": 788633,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "我的語文老師變成了"
    } ]
  }, {
    "tStartMs": 790866,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "一個完全不同風格的老師"
    } ]
  }, {
    "tStartMs": 808633,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "更多圈圈點點"
    } ]
  }, {
    "tStartMs": 811333,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "更多良而不是優"
    } ]
  }, {
    "tStartMs": 814533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "更多圈出的錯別字"
    } ]
  }, {
    "tStartMs": 818133,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "圈出的用的不好的詞語"
    } ]
  }, {
    "tStartMs": 821433,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "當然完全可以理解"
    } ]
  }, {
    "tStartMs": 823266,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "因為到了初中"
    } ]
  }, {
    "tStartMs": 824833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我們對作文的要求更高"
    } ]
  }, {
    "tStartMs": 827366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "老師肯定希望我們作文"
    } ]
  }, {
    "tStartMs": 829233,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "的水平能上一個臺階"
    } ]
  }, {
    "tStartMs": 832233,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "或者好幾個臺階"
    } ]
  }, {
    "tStartMs": 834466,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "希望我們表達的東西更廣更深"
    } ]
  }, {
    "tStartMs": 838800,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "現在看我那個階段的寫作並沒有多差"
    } ]
  }, {
    "tStartMs": 843233,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "但我可以清楚的記得當時我"
    } ]
  }, {
    "tStartMs": 847066,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "對於寫作文的熱情並沒有很高"
    } ]
  }, {
    "tStartMs": 850266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "甚至是比較抗拒的"
    } ]
  }, {
    "tStartMs": 852433,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我記得當時的老師好像也"
    } ]
  }, {
    "tStartMs": 855333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "不是很喜歡我的寫作風格"
    } ]
  }, {
    "tStartMs": 858533,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "當然這種東西本來就是很主觀的嘛"
    } ]
  }, {
    "tStartMs": 861766,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "但是還是有篇作文我想跟你們分享"
    } ]
  }, {
    "tStartMs": 865166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "第四篇作文"
    } ]
  }, {
    "tStartMs": 866800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "七年級的"
    } ]
  }, {
    "tStartMs": 868466,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "13歲的我寫的"
    } ]
  }, {
    "tStartMs": 871766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "題目叫《罰抄的領悟》"
    } ]
  }, {
    "tStartMs": 876233,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "罰抄你們知道是什麼東西嗎？"
    } ]
  }, {
    "tStartMs": 878933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "就是懲罰你抄寫"
    } ]
  }, {
    "tStartMs": 881200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "就是你做錯了一道題"
    } ]
  }, {
    "tStartMs": 883466,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "尤其是那種你非常不應該錯的"
    } ]
  }, {
    "tStartMs": 886800,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "老師為了讓你深刻的記住這個錯誤"
    } ]
  }, {
    "tStartMs": 890566,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "從錯誤中學習"
    } ]
  }, {
    "tStartMs": 892666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "會讓你罰抄這個題目"
    } ]
  }, {
    "tStartMs": 895333,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那罰抄到底是怎樣的體驗呢？"
    } ]
  }, {
    "tStartMs": 897666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "我們來讀一下吧"
    } ]
  }, {
    "tStartMs": 901866,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "今天數學作業發下來"
    } ]
  }, {
    "tStartMs": 904866,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "上面有四個鮮紅的字映入我眼簾"
    } ]
  }, {
    "tStartMs": 908933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "訂正10遍"
    } ]
  }, {
    "tStartMs": 911000,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "我頓時感到跌到了萬丈深淵"
    } ]
  }, {
    "tStartMs": 914366,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "臉上一黑"
    } ]
  }, {
    "tStartMs": 917400,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "趕緊拿出本子奮筆疾書起來"
    } ]
  }, {
    "tStartMs": 921233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "沒過多久"
    } ]
  }, {
    "tStartMs": 922600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "我畫了一半了"
    } ]
  }, {
    "tStartMs": 924600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "語文課開始了"
    } ]
  }, {
    "tStartMs": 926966,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "老師叫我們默新課文的單詞"
    } ]
  }, {
    "tStartMs": 930166,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "這課單詞都很難"
    } ]
  }, {
    "tStartMs": 932200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "我還沒預習就開默了"
    } ]
  }, {
    "tStartMs": 935366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "一共默5個"
    } ]
  }, {
    "tStartMs": 936933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我就錯了兩個"
    } ]
  }, {
    "tStartMs": 939266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "全班只有幾個同學全對"
    } ]
  }, {
    "tStartMs": 942833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "這裡我要說一句"
    } ]
  }, {
    "tStartMs": 944600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "所以你們可以看到"
    } ]
  }, {
    "tStartMs": 946800,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "中國人也很難記住一些字怎麼寫的"
    } ]
  }, {
    "tStartMs": 950733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "老師便很生氣"
    } ]
  }, {
    "tStartMs": 952600,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "要求我們把課後的詞語每個抄5遍"
    } ]
  }, {
    "tStartMs": 956466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "我當時就傻眼了"
    } ]
  }, {
    "tStartMs": 959133,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "下課後我使勁的抄寫"
    } ]
  }, {
    "tStartMs": 962266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "外面的朋友都在活動"
    } ]
  }, {
    "tStartMs": 965066,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我還是抑制住玩的慾望"
    } ]
  }, {
    "tStartMs": 967866,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "筆頭快速的移動"
    } ]
  }, {
    "tStartMs": 970833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "終於在放學前"
    } ]
  }, {
    "tStartMs": 972833,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我全部寫完了"
    } ]
  }, {
    "tStartMs": 975200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "如釋重負"
    } ]
  }, {
    "tStartMs": 976966,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "最搞笑的是當時的老師給我的評語是"
    } ]
  }, {
    "tStartMs": 981133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "吃一塹長一智"
    } ]
  }, {
    "tStartMs": 984533,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "意思就是"
    } ]
  }, {
    "tStartMs": 986000,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "當你從一個事情中間吃了教訓"
    } ]
  }, {
    "tStartMs": 990266,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "你才能記住"
    } ]
  }, {
    "tStartMs": 991833,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "下次不再犯錯誤"
    } ]
  }, {
    "tStartMs": 994233,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "接下來就是高中"
    } ]
  }, {
    "tStartMs": 996333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我記得到了高中"
    } ]
  }, {
    "tStartMs": 998166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我寫作文的興趣又上去了"
    } ]
  }, {
    "tStartMs": 1001133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我又比較喜歡寫了"
    } ]
  }, {
    "tStartMs": 1003433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "因為當時遇到了欣賞"
    } ]
  }, {
    "tStartMs": 1005200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我寫作風格的老師"
    } ]
  }, {
    "tStartMs": 1007300,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "而且我也有非常多東西想討論"
    } ]
  }, {
    "tStartMs": 1010433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "想去表達"
    } ]
  }, {
    "tStartMs": 1012000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "你們也可以看到當時高中我"
    } ]
  }, {
    "tStartMs": 1014533,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "的字跡發生了很大的變化"
    } ]
  }, {
    "tStartMs": 1017433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "其實還挺潦草的"
    } ]
  }, {
    "tStartMs": 1019766,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "現在讓我看有些字都"
    } ]
  }, {
    "tStartMs": 1022933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "要花幾秒才能看懂"
    } ]
  }, {
    "tStartMs": 1026266,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "當時我寫作的興趣也發生了變化"
    } ]
  }, {
    "tStartMs": 1029733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我變得更理性了"
    } ]
  }, {
    "tStartMs": 1031666,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我喜歡去寫議論文"
    } ]
  }, {
    "tStartMs": 1034266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "當然議論文也是高中我們"
    } ]
  }, {
    "tStartMs": 1037033,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "才會著重去訓練的東西"
    } ]
  }, {
    "tStartMs": 1041433,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "我變得不那麼喜歡寫太長的故事"
    } ]
  }, {
    "tStartMs": 1046000,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "反而我喜歡去抓住一個點"
    } ]
  }, {
    "tStartMs": 1048666,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "把它向深了挖"
    } ]
  }, {
    "tStartMs": 1050833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "向深了討論"
    } ]
  }, {
    "tStartMs": 1052466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "當時我還有一件很迷戀的事"
    } ]
  }, {
    "tStartMs": 1055833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "就是喜歡把中文寫的很高級"
    } ]
  }, {
    "tStartMs": 1060633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "甚至比較艱深"
    } ]
  }, {
    "tStartMs": 1062933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "給你們來讀一段"
    } ]
  }, {
    "tStartMs": 1065366,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "這應該是高二的作文本"
    } ]
  }, {
    "tStartMs": 1069200,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "很奇怪，難道我們的內心世界"
    } ]
  }, {
    "tStartMs": 1072266,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "不應本就是自由國度嗎？"
    } ]
  }, {
    "tStartMs": 1075966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "何以就成了圍城？"
    } ]
  }, {
    "tStartMs": 1078766,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "而再回到我關閉朋友圈後"
    } ]
  }, {
    "tStartMs": 1081566,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "為什麼會不安的問題"
    } ]
  }, {
    "tStartMs": 1084400,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "究其因是我內心有鬼"
    } ]
  }, {
    "tStartMs": 1087766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "審視自己的邪鬼"
    } ]
  }, {
    "tStartMs": 1089900,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "而非什麼手持天平的明眼人"
    } ]
  }, {
    "tStartMs": 1093600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我自認為不可見之於人的東西"
    } ]
  }, {
    "tStartMs": 1097100,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "是我自己最不願也最不敢直面之物"
    } ]
  }, {
    "tStartMs": 1101300,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "天吶"
    } ]
  }, {
    "tStartMs": 1102033,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "我這個語言也太複雜了"
    } ]
  }, {
    "tStartMs": 1104800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "就是它甚至不是現代人"
    } ]
  }, {
    "tStartMs": 1107233,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "在寫作時會常用的語言"
    } ]
  }, {
    "tStartMs": 1110066,
    "dDurationMs": 5434,
    "segs": [ {
      "utf8": "它有點位於古代漢語和現代漢語之間"
    } ]
  }, {
    "tStartMs": 1115500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "現在我覺得高級的語言"
    } ]
  }, {
    "tStartMs": 1117133,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "反而是簡單的清楚的"
    } ]
  }, {
    "tStartMs": 1120633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "而且如果我還是用這麼複雜的語言"
    } ]
  }, {
    "tStartMs": 1123633,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我是不可能去教人中文的"
    } ]
  }, {
    "tStartMs": 1126900,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "但怎麼辦呢"
    } ]
  }, {
    "tStartMs": 1128433,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "我當時就是喜歡這樣的語言"
    } ]
  }, {
    "tStartMs": 1132500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "我現在也不可能去批評當時的我"
    } ]
  }, {
    "tStartMs": 1135733,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "每個人在不同階段都會有不同的想法"
    } ]
  }, {
    "tStartMs": 1140933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "當時的我喜歡長句"
    } ]
  }, {
    "tStartMs": 1142733,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "喜歡引用"
    } ]
  }, {
    "tStartMs": 1144033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "喜歡讓一句話顯得很有分量"
    } ]
  }, {
    "tStartMs": 1147466,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "覺得一句話長、複雜就等於深刻"
    } ]
  }, {
    "tStartMs": 1152200,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "所以從小學到高中"
    } ]
  }, {
    "tStartMs": 1157000,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "我的中文寫作水平到底變了多少呢？"
    } ]
  }, {
    "tStartMs": 1162300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "我只能說"
    } ]
  }, {
    "tStartMs": 1163433,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我看到的變化不是一條線性的變化"
    } ]
  }, {
    "tStartMs": 1167300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "也不是說我的水平越來越高"
    } ]
  }, {
    "tStartMs": 1170333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我的寫作越來越高級的變化"
    } ]
  }, {
    "tStartMs": 1174100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "我看到的更多是我和"
    } ]
  }, {
    "tStartMs": 1176566,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "寫作之間關係的變化"
    } ]
  }, {
    "tStartMs": 1179133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "覺得看到這些對你們來說"
    } ]
  }, {
    "tStartMs": 1181666,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "應該也挺有意思的"
    } ]
  }, {
    "tStartMs": 1184500,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "也許這可以讓你們感受到"
    } ]
  }, {
    "tStartMs": 1187600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "學一門語言不僅僅是"
    } ]
  }, {
    "tStartMs": 1190200,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "從簡單走向高級，或者走向複雜"
    } ]
  }, {
    "tStartMs": 1194733,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "它更多是讓你去慢慢的學會"
    } ]
  }, {
    "tStartMs": 1198233,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "怎麼更好的去用語言表達自己"
    } ]
  }, {
    "tStartMs": 1202566,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "表現自己"
    } ]
  }, {
    "tStartMs": 1204233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "怎麼讓你去感受"
    } ]
  }, {
    "tStartMs": 1207966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "越來越多"
    } ]
  }, {
    "tStartMs": 1209333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "越來越深"
    } ]
  }, {
    "tStartMs": 1210333,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "你和這門你學習的語言之間的連接"
    } ]
  }, {
    "tStartMs": 1215166,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "說到這裡"
    } ]
  }, {
    "tStartMs": 1216066,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我也很好奇"
    } ]
  }, {
    "tStartMs": 1217633,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "在你們的母語考試中間"
    } ]
  }, {
    "tStartMs": 1221433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "寫作有多重要呢？"
    } ]
  }, {
    "tStartMs": 1224433,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "它讓你害怕？"
    } ]
  }, {
    "tStartMs": 1226166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "還是讓你興奮？"
    } ]
  }, {
    "tStartMs": 1227733,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "你們需要訓練寫作的時間多嗎？"
    } ]
  }, {
    "tStartMs": 1231433,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "你們又是怎麼訓練的呢？"
    } ]
  }, {
    "tStartMs": 1233733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "也會有這麼多作文本嗎？"
    } ]
  }, {
    "tStartMs": 1237700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "其實今天帶你們看的只是"
    } ]
  }, {
    "tStartMs": 1240233,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "這些作文裡的很小一部分"
    } ]
  }, {
    "tStartMs": 1242933,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "裡面還有其他很多東西"
    } ]
  }, {
    "tStartMs": 1244900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "比如一些奇怪的作文題目"
    } ]
  }, {
    "tStartMs": 1247900,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "老師的評語"
    } ]
  }, {
    "tStartMs": 1249533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "還有很多我現在都完全"
    } ]
  }, {
    "tStartMs": 1251866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "不記得自己寫過的東西"
    } ]
  }, {
    "tStartMs": 1255200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "如果你們喜歡"
    } ]
  }, {
    "tStartMs": 1256633,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "我之後還可以再出一期相關的視頻"
    } ]
  }, {
    "tStartMs": 1260633,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "比如我們可以來一期視頻"
    } ]
  }, {
    "tStartMs": 1263200,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "專門看一看中國的"
    } ]
  }, {
    "tStartMs": 1265333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "學生是怎麼寫作文的"
    } ]
  }, {
    "tStartMs": 1267700,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "或者看一看中國的"
    } ]
  }, {
    "tStartMs": 1269266,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "老師是怎麼批改作文的"
    } ]
  }, {
    "tStartMs": 1272066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那今天的視頻就到這裡結束了"
    } ]
  }, {
    "tStartMs": 1275466,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我們下期視頻再見吧，拜拜"
    } ]
  } ]
}
