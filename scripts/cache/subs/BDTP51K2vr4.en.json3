  }, {
    "tStartMs": 391166,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "super flexible"
    } ]
  }, {
    "tStartMs": 392400,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "and you can practice real conversations directly with native speakers"
