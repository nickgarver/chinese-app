  }, {
    "tStartMs": 400533,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "is incredibly helpful for improving your listening and speaking"
    } ]
  }, {
    "tStartMs": 404400,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "and it'll give you so much more confidence to speak Chinese"
    } ]
  }, {
    "tStartMs": 408433,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "The scheduling is also really flexible—"
    } ]
  }, {
    "tStartMs": 411266,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "no matter how busy you are"
    } ]
  }, {
    "tStartMs": 413633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "you can learn anytime, anywhere"
    } ]
  }, {
    "tStartMs": 416433,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "If you're already learning Chinese"
