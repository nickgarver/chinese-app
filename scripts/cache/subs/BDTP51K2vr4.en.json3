  }, {
    "tStartMs": 418633,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "or thinking about picking up a new language"
    } ]
  }, {
    "tStartMs": 421800,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "click the link below and give it a try"
    } ]
  }, {
    "tStartMs": 424900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "Use my exclusive promo code"
    } ]
  }, {
    "tStartMs": 427066,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "JIAYOU"
    } ]
  }, {
    "tStartMs": 427966,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "and get $5 off your first lesson purchase of $10 or more"
    } ]
  }, {
    "tStartMs": 432800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "Limited to the first 50 users only"
    } ]
  }, {
    "tStartMs": 435133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "If you're interested, go check it out!"
    } ]
  }, {
    "tStartMs": 437566,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "But at the same time I was always self-studying too"
    } ]
  }, {
    "tStartMs": 441266,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "A lot of self-study, because I think"
    } ]
  }, {
    "tStartMs": 442700,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "if you rely entirely on a textbook"
    } ]
  }, {
    "tStartMs": 445400,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "the content in there is pretty limited"
    } ]
  }, {
    "tStartMs": 449466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "so you need to find your own resources too"
    } ]
  }, {
    "tStartMs": 451933,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "topics that genuinely interest you"
    } ]
  }, {
    "tStartMs": 455066,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I think that leads to faster progress"
    } ]
  }, {
    "tStartMs": 457966,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "better results"
    } ]
  }, {
    "tStartMs": 459200,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "So to summarize"
    } ]
  }, {
    "tStartMs": 461366,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "your whole Chinese learning journey"
    } ]
  }, {
    "tStartMs": 463566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "was roughly two to three years, right?"
    } ]
  }, {
    "tStartMs": 466533,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Yeah"
    } ]
  }, {
    "tStartMs": 467033,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "about that, yeah"
    } ]
  }, {
    "tStartMs": 468066,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So two to three years in total"
    } ]
  }, {
    "tStartMs": 469566,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "with very intensive Chinese classes"
    } ]
  }, {
    "tStartMs": 472466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "but on top of the coursework"
    } ]
  }, {
    "tStartMs": 474733,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "you also spent a huge amount of time on input"
    } ]
  }, {
    "tStartMs": 477966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "all kinds of input"
    } ]
  }, {
    "tStartMs": 479133,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "like books"
    } ]
  }, {
    "tStartMs": 480733,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "videos, music"
    } ]
  }, {
    "tStartMs": 483366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "all sorts of content"
    } ]
  }, {
    "tStartMs": 485300,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "So consistently for two to three years"
    } ]
  }, {
    "tStartMs": 488566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "combining classes with self-study"
    } ]
  }, {
    "tStartMs": 491333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "is what led to such rapid progress"
    } ]
  }, {
    "tStartMs": 493866,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Yeah, and I think the most important thing was probably"
    } ]
  }, {
    "tStartMs": 497166,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "actually living in a Chinese-speaking environment"
    } ]
  }, {
    "tStartMs": 501033,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "because, how do I put it—"
    } ]
  }, {
    "tStartMs": 502566,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "the exposure is just so crucial"
    } ]
  }, {
    "tStartMs": 505866,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "Back then I was living in"
    } ]
  }, {
    "tStartMs": 507233,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Taipei, for example"
    } ]
  }, {
    "tStartMs": 508466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "or Beijing"
    } ]
  }, {
    "tStartMs": 509933,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "and then Chengdu later"
    } ]
  }, {
    "tStartMs": 511333,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and, how do you put it—"
    } ]
  }, {
    "tStartMs": 513833,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "you just can't avoid the language"
    } ]
  }, {
    "tStartMs": 517066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "you encounter it every single day"
    } ]
  }, {
    "tStartMs": 519533,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "If you don't use the language"
    } ]
  }, {
    "tStartMs": 521400,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "you simply can't function there"
    } ]
  }, {
    "tStartMs": 523766,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "You can't order food"
    } ]
  }, {
    "tStartMs": 524866,
    "dDurationMs": 5434,
    "segs": [ {
      "utf8": "you can't take public transport"
    } ]
  }, {
    "tStartMs": 530600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "or get anywhere you need to go"
    } ]
  }, {
    "tStartMs": 532566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "check into a hotel"
    } ]
  }, {
    "tStartMs": 533800,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "you have to use the language"
    } ]
  }, {
    "tStartMs": 536066,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "From what I've observed and worked out myself"
    } ]
  }, {
    "tStartMs": 539800,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "about why his Chinese is so good—"
    } ]
  }, {
    "tStartMs": 542200,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "he just mentioned he loves listening to music"
    } ]
  }, {
    "tStartMs": 546366,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and I'm always genuinely amazed"
    } ]
  }, {
    "tStartMs": 549000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "because every time we go to KTV"
    } ]
  }, {
    "tStartMs": 552633,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "or whenever he plays Chinese songs"
    } ]
  }, {
    "tStartMs": 556333,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "I always notice"
    } ]
  }, {
    "tStartMs": 557466,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "oh my gosh, the songs he knows"
    } ]
  }, {
    "tStartMs": 560033,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "are the exact songs I grew up with"
    } ]
  }, {
    "tStartMs": 562933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "those classic songs"
    } ]
  }, {
    "tStartMs": 564800,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "He even knows more songs than I do"
    } ]
  }, {
    "tStartMs": 569233,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "all of Chinese pop music"
    } ]
  }, {
    "tStartMs": 572533,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "plus all the classic songs — he just knows them all"
    } ]
  }, {
    "tStartMs": 575966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I'm genuinely amazed"
    } ]
  }, {
    "tStartMs": 577566,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "hahaha, yeah"
    } ]
  }, {
    "tStartMs": 579200,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "I honestly don't know why"
    } ]
  }, {
    "tStartMs": 580233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "but I guess you'd hear these songs everywhere you went"
    } ]
  }, {
    "tStartMs": 583400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and they'd just get stuck in your head"
    } ]
  }, {
    "tStartMs": 586233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and then you'd want to look them up"
    } ]
  }, {
    "tStartMs": 588833,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "find out what song it was"
    } ]
  }, {
    "tStartMs": 589866,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "and read the lyrics"
    } ]
  }, {
    "tStartMs": 591233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "figure out what they meant"
    } ]
  }, {
    "tStartMs": 593166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and then gradually you'd get used to them"
    } ]
  }, {
    "tStartMs": 595266,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "start to really like them"
    } ]
  }, {
    "tStartMs": 597766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "and then of course going to KTV"
    } ]
  }, {
    "tStartMs": 599800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you could, how do you say"
    } ]
  }, {
    "tStartMs": 603000,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "put on a whole performance"
    } ]
  }, {
    "tStartMs": 604033,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "hahaha exactly"
    } ]
  }, {
    "tStartMs": 605466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "So the second reason I've identified is"
    } ]
  }, {
    "tStartMs": 608000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "he absolutely loves to mimic"
    } ]
  }, {
    "tStartMs": 610000,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "not just in Chinese"
    } ]
  }, {
    "tStartMs": 611433,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "in English too"
    } ]
  }, {
    "tStartMs": 612466,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "he loves imitating all kinds of English accents"
    } ]
  }, {
    "tStartMs": 615266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "and sometimes even tries to impersonate Sichuanese people"
    } ]
  }, {
    "tStartMs": 618733,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "speaking Sichuan dialect and all"
    } ]
  }, {
    "tStartMs": 621366,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "I think that's definitely the second reason"
    } ]
  }, {
    "tStartMs": 623933,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "And the third thing I've noticed is"
    } ]
  }, {
    "tStartMs": 627166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "when we were in China"
    } ]
  }, {
    "tStartMs": 628566,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "he was constantly looking up words"
    } ]
  }, {
    "tStartMs": 632333,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "Whenever he came across a word he didn't know"
    } ]
  }, {
    "tStartMs": 635400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "he'd immediately pull out his phone and look it up"
    } ]
  }, {
    "tStartMs": 637433,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "and add it to his favorites"
    } ]
  }, {
    "tStartMs": 638833,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "Yeah, you really need that curiosity"
    } ]
  }, {
    "tStartMs": 642966,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "like when you're out"
    } ]
  }, {
    "tStartMs": 644266,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "and you see something you don't recognize"
    } ]
  }, {
    "tStartMs": 646166,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "and you, how do I say—"
    } ]
  }, {
    "tStartMs": 648300,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "you just have to go look it up"
    } ]
  }, {
    "tStartMs": 651366,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "otherwise it'll bother you hahaha"
    } ]
  }, {
    "tStartMs": 653433,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "Right, and the last point is"
    } ]
  }, {
    "tStartMs": 655266,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "back when he was in China"
    } ]
  }, {
    "tStartMs": 657766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "he still read Chinese books fairly often"
    } ]
  }, {
    "tStartMs": 660733,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and Chinese news too"
    } ]
  }, {
    "tStartMs": 663300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "maybe a bit less so now"
    } ]
  }, {
    "tStartMs": 665166,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "Yeah, definitely a bit more back then"
    } ]
  }, {
    "tStartMs": 667933,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "it was also tied to my work at the time"
    } ]
  }, {
    "tStartMs": 671233,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "reading articles and things"
    } ]
  }, {
    "tStartMs": 672866,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "still some now"
    } ]
  }, {
    "tStartMs": 673733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "just not nearly as much"
    } ]
  }, {
    "tStartMs": 675200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "Right. So those are my four observations"
    } ]
  }, {
    "tStartMs": 679666,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "Now, as for why his pronunciation is so good—"
    } ]
  }, {
    "tStartMs": 684033,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "I think it's still because of that love of mimicking"
    } ]
  }, {
    "tStartMs": 687633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "Any other reasons why your pronunciation is so good?"
    } ]
  }, {
    "tStartMs": 691333,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Pronunciation being so good..."
    } ]
  }, {
    "tStartMs": 692366,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "it might come down to the mimicking thing"
    } ]
  }, {
    "tStartMs": 695433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "including I'm not sure why"
    } ]
  }, {
    "tStartMs": 697000,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "but I've noticed about myself"
    } ]
  }, {
    "tStartMs": 699766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "that when I have a strong accent"
    } ]
  }, {
    "tStartMs": 701600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "I feel really uncomfortable"
    } ]
  }, {
    "tStartMs": 703933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "it's the same with English"
    } ]
  }, {
    "tStartMs": 705966,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "I always want to sound as close to standard as possible"
    } ]
  }, {
    "tStartMs": 710200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "Same with English too—"
    } ]
  }, {
    "tStartMs": 712566,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "even when I'm speaking with a native English speaker"
    } ]
  }, {
    "tStartMs": 716266,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "I naturally tend to"
    } ]
  }, {
    "tStartMs": 717433,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "sort of effortlessly"
    } ]
  }, {
    "tStartMs": 718933,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "adjust to how they speak"
    } ]
  }, {
    "tStartMs": 721866,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "If they have a British accent"
    } ]
  }, {
    "tStartMs": 724800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "I might find myself"
    } ]
  }, {
    "tStartMs": 726600,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "suddenly slipping into British English"
    } ]
  }, {
    "tStartMs": 730533,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Oh that code-switching of yours"
    } ]
  }, {
    "tStartMs": 732833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "Yeah, switching — if it's with an American"
    } ]
  }, {
    "tStartMs": 736766,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "I might shift in that direction too"
    } ]
  }, {
    "tStartMs": 738933,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Same thing in China"
    } ]
  }, {
    "tStartMs": 740266,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "if I'm talking with someone from the south"
    } ]
  }, {
    "tStartMs": 742000,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "my accent gradually drifts toward a southern flavor"
    } ]
  }, {
    "tStartMs": 746233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "And if I'm with someone from the north"
    } ]
  }, {
    "tStartMs": 747666,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "or someone who speaks more standard Mandarin"
    } ]
  }, {
    "tStartMs": 750566,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "then I'll sound more like standard Mandarin"
    } ]
  }, {
    "tStartMs": 752933,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "It's hard to pin down"
    } ]
  }, {
    "tStartMs": 754100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "Right, you used to have more of a Taiwanese accent"
    } ]
  }, {
    "tStartMs": 756566,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "and then when you moved to Beijing"
    } ]
  }, {
    "tStartMs": 757633,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "you shifted toward that standard Mandarin sound"
    } ]
  }, {
    "tStartMs": 760866,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Yeah, a little bit of that"
    } ]
  }, {
    "tStartMs": 762533,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Not that I can fully speak those dialects or anything"
    } ]
  }, {
    "tStartMs": 766133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "but just a slight trace of the accent"
    } ]
  }, {
    "tStartMs": 768166,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "Right"
    } ]
  }, {
    "tStartMs": 768800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "So you just can't stand having an accent"
    } ]
  }, {
    "tStartMs": 770766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "so you naturally put in extra effort"
    } ]
  }, {
    "tStartMs": 772566,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "to sound more standard across all the languages you speak"
    } ]
  }, {
    "tStartMs": 775766,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "Kind of"
    } ]
  }, {
    "tStartMs": 776400,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "It feels more like a natural thing"
    } ]
  }, {
    "tStartMs": 778533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "I'm not consciously choosing to do it"
    } ]
  }, {
    "tStartMs": 780866,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "I just naturally adapt"
    } ]
  }, {
    "tStartMs": 783166,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "I'm not sure why"
    } ]
  }, {
    "tStartMs": 784600,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "So the next question is"
    } ]
  }, {
    "tStartMs": 787133,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "has being good at Chinese brought any benefits to your life?"
    } ]
  }, {
    "tStartMs": 791833,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Let me say one first"
    } ]
  }, {
    "tStartMs": 793066,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Oh, go ahead"
    } ]
  }, {
    "tStartMs": 793666,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "hahahaha"
    } ]
  }, {
    "tStartMs": 796066,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "If your Chinese weren't good"
    } ]
  }, {
    "tStartMs": 799400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "you wouldn't have this wife"
    } ]
  }, {
    "tStartMs": 801800,
    "dDurationMs": 5633,
    "segs": [ {
      "utf8": "Because before we even met"
    } ]
  }, {
    "tStartMs": 807433,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "I had already made up my mind"
    } ]
  }, {
    "tStartMs": 809166,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that I would not be with someone who didn't understand my culture"
    } ]
  }, {
    "tStartMs": 812766,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "and couldn't speak my language"
    } ]
  }, {
    "tStartMs": 815600,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "So when I discovered how good your Chinese was"
    } ]
  }, {
    "tStartMs": 818933,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that's when I was willing to go on a date with you"
    } ]
  }, {
    "tStartMs": 822633,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Lucky I could speak Chinese back then"
    } ]
  }, {
    "tStartMs": 826133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "otherwise there'd be no wife"
    } ]
  }, {
    "tStartMs": 828533,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Exactly — and no kid either. Right, no kid"
    } ]
  }, {
    "tStartMs": 831533,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "Right"
    } ]
  }, {
    "tStartMs": 832200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And I do think that's genuinely a huge benefit"
    } ]
  }, {
    "tStartMs": 835400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "Of course, how we met is one thing"
    } ]
  }, {
    "tStartMs": 837866,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "but that wasn't the goal at the time"
    } ]
  }, {
    "tStartMs": 840366,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "And now we have a child together, right"
    } ]
  }, {
    "tStartMs": 845233,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "she's nearly three, and she's growing up with two languages"
    } ]
  }, {
    "tStartMs": 849666,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Chinese and German"
    } ]
  }, {
    "tStartMs": 850833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "And the way things are for me now"
    } ]
  }, {
    "tStartMs": 852733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "whatever language they're speaking"
    } ]
  }, {
    "tStartMs": 855333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "I can always follow along"
    } ]
  }, {
    "tStartMs": 857033,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "so I think that's a really big benefit"
    } ]
  }, {
    "tStartMs": 859333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "But beyond the personal reasons"
    } ]
  }, {
    "tStartMs": 861966,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "I think"
    } ]
  }, {
    "tStartMs": 863733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "being able to truly understand"
    } ]
  }, {
    "tStartMs": 865000,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "deeply understand a place as foreign to me as China was"
    } ]
  }, {
    "tStartMs": 868800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "at least at the start"
    } ]
  }, {
    "tStartMs": 870533,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "completely unfamiliar"
    } ]
  }, {
    "tStartMs": 872200,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "is a tremendous advantage"
    } ]
  }, {
    "tStartMs": 876133,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "If you think about other countries"
    } ]
  }, {
    "tStartMs": 881000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "European countries and so on"
    } ]
  }, {
    "tStartMs": 882966,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "a lot of people still speak English there"
    } ]
  }, {
    "tStartMs": 886666,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "and you'd still find plenty of"
    } ]
  }, {
    "tStartMs": 888433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "English-language resources about those countries"
    } ]
  }, {
    "tStartMs": 891000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "so that's generally fine"
    } ]
  }, {
    "tStartMs": 893166,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "But in China, if you don't speak Chinese"
    } ]
  }, {
    "tStartMs": 896333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "there's basically no way to get a real understanding of it"
    } ]
  }, {
    "tStartMs": 899133,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "which actually ties back to what I said earlier"
    } ]
  }, {
    "tStartMs": 901933,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "about why I started learning Chinese back then"
    } ]
  }, {
    "tStartMs": 905566,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "it was because I could feel that"
    } ]
  }, {
    "tStartMs": 907833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "without the language"
    } ]
  }, {
    "tStartMs": 910600,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "you can absolutely have a great time there"
    } ]
  }, {
    "tStartMs": 913266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "but you stay on the surface"
    } ]
  }, {
    "tStartMs": 915600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "you can't go deeper"
    } ]
  }, {
    "tStartMs": 917566,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "China really is a completely different world"
    } ]
  }, {
    "tStartMs": 921766,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and without the language"
    } ]
  }, {
    "tStartMs": 923466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "it's very hard to explore that world"
    } ]
  }, {
    "tStartMs": 925766,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Exactly"
    } ]
  }, {
    "tStartMs": 926666,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "So I think that's a really big benefit"
    } ]
  }, {
    "tStartMs": 929400,
    "dDurationMs": 4866,
    "segs": [ {
      "utf8": "and I'm really glad I took on that enormous task"
    } ]
  }, {
    "tStartMs": 934466,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Our little one's on her way"
    } ]
  }, {
    "tStartMs": 935766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Yes, our little one's on her way"
    } ]
  }, {
    "tStartMs": 936966,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Alright, last question then"
    } ]
  }, {
    "tStartMs": 939766,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "Can you give some advice to people learning Chinese"
    } ]
  }, {
    "tStartMs": 944466,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "on how to actually get good?"
    } ]
  }, {
    "tStartMs": 946266,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Okay, first of all I think if you want to learn Chinese"
    } ]
  }, {
    "tStartMs": 949566,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "you need a really strong motivation"
    } ]
  }, {
    "tStartMs": 951833,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "I really do"
    } ]
  }, {
    "tStartMs": 952533,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "because at least as a European"
    } ]
  }, {
    "tStartMs": 956166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "or a Westerner"
    } ]
  }, {
    "tStartMs": 957733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "learning Chinese is genuinely hard"
    } ]
  }, {
    "tStartMs": 960333,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "you're going to put in a lot of time"
    } ]
  }, {
    "tStartMs": 962066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "and the process is definitely going to be painful"
    } ]
  }, {
    "tStartMs": 964466,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I think so"
    } ]
  }, {
    "tStartMs": 965933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "And"
    } ]
  }, {
    "tStartMs": 967200,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "if you want to push through all that difficulty"
    } ]
  }, {
    "tStartMs": 972366,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "you need a really strong purpose"
    } ]
  }, {
    "tStartMs": 976000,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "or a really strong drive to keep you going"
    } ]
  }, {
    "tStartMs": 978966,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "I've already shared some of my personal motivations"
    } ]
  }, {
    "tStartMs": 982766,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "but everyone will have their own"
    } ]
  }, {
    "tStartMs": 985333,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "It might be connected to something personal"
    } ]
  }, {
    "tStartMs": 989766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "or tied to their career"
    } ]
  }, {
    "tStartMs": 992000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "or maybe, I don't know"
    } ]
  }, {
    "tStartMs": 997000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "the way they like to travel — anything goes"
    } ]
  }, {
    "tStartMs": 999133,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "or maybe there's someone Chinese in their family, who knows"
    } ]
  }, {
    "tStartMs": 1002366,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "But I think"
    } ]
  }, {
    "tStartMs": 1003733,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "there's a cat up in a tree"
    } ]
  }, {
    "tStartMs": 1007400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "sorry"
    } ]
  }, {
    "tStartMs": 1008533,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "But I think if you have that motivation"
    } ]
  }, {
    "tStartMs": 1012400,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "you're already set"
    } ]
  }, {
    "tStartMs": 1013666,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "and from that foundation"
    } ]
  }, {
    "tStartMs": 1016600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "from that starting point"
    } ]
  }, {
    "tStartMs": 1018233,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "find topics that genuinely interest you"
    } ]
  }, {
    "tStartMs": 1021566,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "or resources that excite you"
    } ]
  }, {
    "tStartMs": 1023933,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "and then your learning process"
    } ]
  }, {
    "tStartMs": 1026866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "will feel a little easier"
    } ]
  }, {
    "tStartMs": 1029066,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "less like forced studying"
    } ]
  }, {
    "tStartMs": 1031366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Use the language as much as you can"
    } ]
  }, {
    "tStartMs": 1033066,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and go somewhere with a Chinese-speaking environment"
    } ]
  }, {
    "tStartMs": 1037533,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you could go to certain parts of Southeast Asia"
    } ]
  }, {
    "tStartMs": 1039633,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "mainland China"
    } ]
  }, {
    "tStartMs": 1040866,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "Taiwan — any of those, it doesn't really matter"
    } ]
  }, {
    "tStartMs": 1043833,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "or if you're somewhere like the US"
    } ]
  }, {
    "tStartMs": 1045466,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "even a Chinatown works"
    } ]
  }, {
    "tStartMs": 1047366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "you just need that environment"
    } ]
  }, {
    "tStartMs": 1049266,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "though those tend to be Cantonese and Hokkien"
    } ]
  }, {
    "tStartMs": 1051566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "hahaha very possibly true"
    } ]
  }, {
    "tStartMs": 1053433,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "very possibly"
    } ]
  }, {
    "tStartMs": 1054433,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "The motivation part is so real though"
    } ]
  }, {
    "tStartMs": 1057566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "Like, why is learning German so painful for me"
    } ]
  }, {
    "tStartMs": 1060533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "with such slow progress?"
    } ]
  }, {
    "tStartMs": 1061966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "It's because I have zero motivation"
    } ]
  }, {
    "tStartMs": 1064666,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We've known each other all these years"
    } ]
  }, {
    "tStartMs": 1067066,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "and zero motivation?! hahaha"
    } ]
  }, {
    "tStartMs": 1069800,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "We've always just spoken Chinese — we don't even use English"
    } ]
  }, {
    "tStartMs": 1072766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "so I've never really felt it was necessary"
    } ]
  }, {
    "tStartMs": 1075833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and in Berlin too"
    } ]
  }, {
    "tStartMs": 1077333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "you can get by fine in English"
    } ]
  }, {
    "tStartMs": 1079166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "so with no strong motivation"
    } ]
  }, {
    "tStartMs": 1082266,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "I've just been stuck making very slow progress"
    } ]
  }, {
    "tStartMs": 1085466,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Yeah, exactly. And I think"
    } ]
  }, {
    "tStartMs": 1087833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "if you really want to master a language"
    } ]
  }, {
    "tStartMs": 1090666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "the best thing is to go live there for at least a year or so"
    } ]
  }, {
    "tStartMs": 1095600,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "and gradually immerse yourself in that environment"
    } ]
  }, {
    "tStartMs": 1098733,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "because that's where you'll progress the fastest"
    } ]
  }, {
    "tStartMs": 1101666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "and once you see how fast you're improving"
    } ]
  }, {
    "tStartMs": 1104200,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "your motivation grows even stronger"
    } ]
  }, {
    "tStartMs": 1106600,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "Alright, that's a wrap on today's video"
    } ]
  }, {
    "tStartMs": 1109333,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "our kid's about to come charging over"
    } ]
  }, {
    "tStartMs": 1111866,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "so that's goodbye from us!"
    } ]
  }, {
    "tStartMs": 1114033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Bye bye"
    } ]
  }, {
    "tStartMs": 1115200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "bye bye, jiayou"
    } ]
  }, {
    "tStartMs": 1118666,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "jiayou with your Chinese"
    } ]
  }, {
    "tStartMs": 1120066,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "jiayouchinese"
    } ]
  }, {
    "tStartMs": 1124266,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "if you'd like to support my work you can join as a YouTube member"
