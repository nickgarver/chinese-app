      "utf8": "對自己熟悉領域的東西"
    } ]
  }, {
    "tStartMs": 529466,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "或者是自己體驗過的一些東西"
    } ]
  }, {
