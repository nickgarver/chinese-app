    "tStartMs": 422400,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "Now I'll push this shopping cart."
    } ]
  }, {
    "tStartMs": 426466,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "I want one of these bagels."
    } ]
  }, {
    "tStartMs": 429466,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "One or one for each of you?"
    } ]
  }, {
    "tStartMs": 431200,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": " just one."
    } ]
  }, {
    "tStartMs": 432100,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 433033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I'm waiting for my bagel now."
    } ]
  }, {
    "tStartMs": 436433,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Okay, just put it here."
    } ]
  }, {
    "tStartMs": 437700,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Okay, thank you."
    } ]
  }, {
    "tStartMs": 439266,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "I took this for my students — they're foreign."
    } ]
  }, {
    "tStartMs": 441900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Are you a teacher?"
    } ]
  }, {
    "tStartMs": 443166,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "There is a huge beer here."
    } ]
  }, {
    "tStartMs": 445666,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "wheat beer."
    } ]
  }, {
    "tStartMs": 447066,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "eight point eight eight liters."
    } ]
  }, {
    "tStartMs": 451000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "This is the alcohol and beverage section."
    } ]
  }, {
    "tStartMs": 453066,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "There are many kinds of drinks and alcohol."
    } ]
  }, {
    "tStartMs": 457533,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "This can of fruit wine costs 14.9 yuan."
    } ]
  }, {
    "tStartMs": 462633,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Is this from Japan?"
    } ]
  }, {
    "tStartMs": 464933,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "It should be imported from Japan."
    } ]
  }, {
    "tStartMs": 467266,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "This coconut juice is a very old brand."
    } ]
  }, {
    "tStartMs": 470233,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "I don't know if it's available abroad."
    } ]
  }, {
    "tStartMs": 473800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Its packaging is a little fun."
    } ]
  }, {
    "tStartMs": 476100,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "and a little funny."
    } ]
  }, {
    "tStartMs": 477400,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "Here are all instant noodles."
    } ]
  }, {
    "tStartMs": 479266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "This is Korean ramen."
    } ]
  }, {
    "tStartMs": 482300,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Spicy Noodles."
    } ]
  }, {
    "tStartMs": 483233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "This side has Chinese instant noodles."
    } ]
  }, {
    "tStartMs": 484666,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "This is pasta."
    } ]
  }, {
    "tStartMs": 486533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "It can also be called pasta."
    } ]
  }, {
    "tStartMs": 488233,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "This is spaghetti with tomato meat sauce."
    } ]
  }, {
    "tStartMs": 491666,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "Creamy bacon and mushroom pasta."
    } ]
  }, {
    "tStartMs": 494733,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "A bag of pasta costs eleven point nine yuan."
    } ]
  }, {
    "tStartMs": 497533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Let’s have a look.\nI’ve never seen this before."
    } ]
  }, {
    "tStartMs": 500633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Violet tomatoes."
    } ]
  }, {
    "tStartMs": 502600,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Yeah, it's a hybrid."
    } ]
  }, {
    "tStartMs": 503666,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Hybrid? Where is it written?"
    } ]
  }, {
    "tStartMs": 504900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Violet"
    } ]
  }, {
    "tStartMs": 505900,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Violet is a vegetable."
    } ]
  }, {
    "tStartMs": 508200,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 508500,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "It's a vegetable."
    } ]
  }, {
    "tStartMs": 509133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "Isn't violet a color?"
    } ]
  }, {
    "tStartMs": 514200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "This row is for meat."
    } ]
  }, {
    "tStartMs": 516100,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "There are beef, pork, and chicken."
    } ]
  }, {
    "tStartMs": 521233,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "There is even cow here"
    } ]
  }, {
    "tStartMs": 523066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And it tells you the parts."
    } ]
  }, {
    "tStartMs": 525166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "There are many small pumpkins here,"
    } ]
  }, {
    "tStartMs": 527133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and white ones."
    } ]
  }, {
    "tStartMs": 528333,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "which are quite beautiful."
    } ]
  }, {
    "tStartMs": 532133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "Orange and green."
    } ]
  }, {
    "tStartMs": 534533,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "This is the seafood section."
    } ]
  }, {
    "tStartMs": 537266,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Wow, what big crabs!"
    } ]
  }, {
    "tStartMs": 539233,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "This is called king crab."
    } ]
  }, {
    "tStartMs": 543266,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "There are all kinds of seafood."
    } ]
  }, {
    "tStartMs": 547900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "What's this?"
    } ]
  }, {
    "tStartMs": 549166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "It should be lobster."
    } ]
  }, {
    "tStartMs": 553166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "There are many yogurts here."
    } ]
  }, {
    "tStartMs": 555266,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I have eaten this in Yunnan, dry choked yogurt"
    } ]
  }, {
    "tStartMs": 558066,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "It's quite special."
    } ]
  }, {
    "tStartMs": 559333,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "It tastes especially good with fruit."
    } ]
  }, {
    "tStartMs": 561466,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "This is blueberry flavor."
    } ]
  }, {
    "tStartMs": 563266,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "I’m going to buy a yogurt\nand make an oatmeal bowl."
    } ]
  }, {
    "tStartMs": 566566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Let’s choose some braised food."
