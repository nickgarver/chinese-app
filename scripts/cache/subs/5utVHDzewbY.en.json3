  }, {
    "tStartMs": 571266,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "Wow, this is so evil."
    } ]
  }, {
    "tStartMs": 572700,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "A century egg."
    } ]
  }, {
    "tStartMs": 574066,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "I’ll take one century egg."
    } ]
  }, {
    "tStartMs": 578866,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "What is this?"
    } ]
  }, {
    "tStartMs": 581633,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Pork skin."
    } ]
  }, {
    "tStartMs": 583366,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Is it delicious?"
    } ]
  }, {
    "tStartMs": 585033,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "You can try it."
    } ]
  }, {
    "tStartMs": 586366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It has a texture similar to fish jelly."
    } ]
  }, {
    "tStartMs": 588166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Try it."
    } ]
  }, {
    "tStartMs": 592966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "This is tofu stick."
    } ]
  }, {
    "tStartMs": 595466,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Let me weigh it now."
    } ]
  }, {
    "tStartMs": 597666,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Let him mix it for me."
    } ]
  }, {
    "tStartMs": 598933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "and then weigh it."
    } ]
  }, {
    "tStartMs": 605366,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "You don’t eat green onions?"
    } ]
  }, {
    "tStartMs": 606866,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "Green onions?I do eat them. I just usually choose not to add them if possible."
    } ]
  }, {
    "tStartMs": 609900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 614700,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "Now we are queuing up to pay."
    } ]
  }, {
    "tStartMs": 619166,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "There are self-checkout machines here."
    } ]
  }, {
    "tStartMs": 622666,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "There are machines here."
    } ]
  }, {
    "tStartMs": 624266,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "And there are also cashier counters."
    } ]
  }, {
    "tStartMs": 627366,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "Those counters have staff."
    } ]
  }, {
    "tStartMs": 630300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And this is the self-service checkout."
    } ]
  }, {
    "tStartMs": 633500,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "This is what we just bought at the supermarket."
    } ]
  }, {
    "tStartMs": 636900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "There's a big bag."
    } ]
  }, {
    "tStartMs": 639833,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "The waterfall on the wall is a decoration."
    } ]
  }, {
    "tStartMs": 643666,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "We have almost finished shopping."
    } ]
  }, {
    "tStartMs": 645633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Now we're going back."
    } ]
  }, {
    "tStartMs": 647833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "What do you think of this mall?"
    } ]
  }, {
    "tStartMs": 650300,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "You can tell me in the comments section."
    } ]
  }, {
    "tStartMs": 652466,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "I hope you can"
    } ]
  }, {
    "tStartMs": 654500,
    "dDurationMs": 6166,
    "segs": [ {
      "utf8": "Learn some words and expressions about shopping malls and supermarkets"
    } ]
  }, {
    "tStartMs": 661066,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I will teach you Chinese in a natural way."
    } ]
  }, {
    "tStartMs": 664700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "That's all for today's video, bye!"
