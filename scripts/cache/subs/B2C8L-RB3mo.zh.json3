    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "现削 的 菠萝\nxiàn xiāo de bō luó\nFreshly peeled pineapple."
    } ]
  }, {
    "tStartMs": 1529233,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "这 是 什么？\nzhè shì shén me?\nWhat is this?"
    } ]
  }, {
    "tStartMs": 1532533,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "这 是 一 种 植物 的 果 实 吧\nzhè shì yī zhǒng zhí wù de guǒ shí ba\nThis is some kind of fruit from a plant, right?"
    } ]
  }, {
    "tStartMs": 1537300,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "从 来 没 有 见 过\ncóng lái méi yǒu jiàn guò\nI’ve never seen it before."
    } ]
  }, {
    "tStartMs": 1541966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "这 只 小 狗\nzhè zhī xiǎo gǒu\nThis little dog"
    } ]
  }, {
    "tStartMs": 1542766,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "应该 是 在 等 它 的 主 人\nyīng gāi shì zài děng tā de zhǔ rén\nmust be waiting for its owner."
    } ]
  }, {
    "tStartMs": 1545066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "它 的 主 人 应 该 是 进 去 买 菜 了\ntā de zhǔ rén yīng gāi shì jìn qù mǎi cài le\nIts owner must have gone inside to buy groceries."
    } ]
  }, {
    "tStartMs": 1549533,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "狗 狗\ngǒu gǒu\nDoggy."
    } ]
  }, {
    "tStartMs": 1552166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "你 怎么 这么 乖 呀\nnǐ zěn me zhè me guāi ya\nHow are you so well-behaved?"
    } ]
  } ]
}
