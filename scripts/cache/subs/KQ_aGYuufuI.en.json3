{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 33,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Hi everyone,"
    } ]
  }, {
    "tStartMs": 1533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "welcome back to my channel."
    } ]
  }, {
    "tStartMs": 3733,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "I'm Angela."
    } ]
  }, {
    "tStartMs": 5600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Today, we'll continue our Chinese podcast."
    } ]
  }, {
    "tStartMs": 9933,
    "dDurationMs": 8967,
    "segs": [ {
      "utf8": "Today, I'll mark ten very commonly used Chinese words that appear in the video"
    } ]
  }, {
    "tStartMs": 19566,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "and put their meanings and pronunciations at the end."
    } ]
  }, {
    "tStartMs": 26433,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "I hope that after watching this video,"
    } ]
  }, {
    "tStartMs": 30833,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "you can master these ten Chinese words."
    } ]
  }, {
    "tStartMs": 35633,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "\"Master\" means \"to learn.\" \"Palm\" is"
    } ]
  }, {
    "tStartMs": 38533,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "the palm of the hand. To grasp"
    } ]
  }, {
    "tStartMs": 39466,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 42166,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": ", to hold, to hold firmly, means that something is yours,"
    } ]
  }, {
    "tStartMs": 45933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "and you have learned it."
    } ]
  }, {
    "tStartMs": 47500,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "That's the meaning of \"mastering.\""
    } ]
  }, {
    "tStartMs": 49900,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I hope everyone can master ten words"
    } ]
  }, {
    "tStartMs": 53200,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "after watching this video today."
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Actually, if you can learn ten words from one video,"
    } ]
  }, {
    "tStartMs": 62466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "that's already very impressive."
    } ]
  }, {
    "tStartMs": 65133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Okay, let's begin."
    } ]
  }, {
    "tStartMs": 67733,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "Today, I want to talk about \"Versailles.\" When you"
    } ]
  }, {
    "tStartMs": 72933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "hear the word Versailles,"
    } ]
  }, {
    "tStartMs": 75266,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "you probably think of Versailles in France."
    } ]
  }, {
    "tStartMs": 80100,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "That's right, Versailles is a city"
    } ]
  }, {
    "tStartMs": 85600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "in France, probably near Paris."
    } ]
  }, {
    "tStartMs": 88533,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "I haven't been there;"
    } ]
  }, {
    "tStartMs": 89800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "this is what I found online."
    } ]
  }, {
    "tStartMs": 92666,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "There's a very famous palace there,"
    } ]
  }, {
    "tStartMs": 98233,
    "dDurationMs": 6167,
    "segs": [ {
      "utf8": "formerly the palace of the French kings, called the Palace of Versailles."
    } ]
  }, {
    "tStartMs": 104666,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "This palace is very luxurious"
    } ]
  }, {
    "tStartMs": 107933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and very famous."
    } ]
  }, {
    "tStartMs": 109866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Even though I've never been to France,"
    } ]
  }, {
    "tStartMs": 112466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "I've heard of this palace."
    } ]
  }, {
    "tStartMs": 116200,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "Many tourists who go"
    } ]
  }, {
    "tStartMs": 119433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "to France or Paris"
    } ]
  }, {
    "tStartMs": 121633,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "will definitely visit the Palace of Versailles."
    } ]
  }, {
    "tStartMs": 126400,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "Actually, there's also a \"Versailles\" in China."
    } ]
  }, {
    "tStartMs": 129733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Today's video topic is"
    } ]
  }, {
    "tStartMs": 131733,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "about the Chinese Versailles. The"
    } ]
  }, {
    "tStartMs": 136300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "Chinese Versailles isn't a palace"
    } ]
  }, {
    "tStartMs": 140233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": ", nor a city"
    } ]
  }, {
    "tStartMs": 142233,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": ", nor a place."
    } ]
  }, {
    "tStartMs": 143500,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "It's a newly emerging word"
    } ]
  }, {
    "tStartMs": 150333,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "in Chinese, a very recent"
    } ]
  }, {
    "tStartMs": 152333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "one. Initially,"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "it was a popular internet slang term."
    } ]
  }, {
    "tStartMs": 157133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "Gradually, more and more people"
    } ]
  }, {
    "tStartMs": 160133,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": ", especially young people, used"
    } ]
  }, {
    "tStartMs": 164066,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "it, and now it has almost become a regular word."
    } ]
  }, {
    "tStartMs": 169466,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "Have you encountered"
    } ]
  }, {
    "tStartMs": 172333,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "or heard this word"
    } ]
  }, {
    "tStartMs": 175700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "when learning Chinese ?"
    } ]
  }, {
    "tStartMs": 179200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "If you frequently browse Chinese social media,"
    } ]
  }, {
    "tStartMs": 183833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "watch Chinese short videos,"
    } ]
  }, {
    "tStartMs": 186800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "or have Chinese friends,"
    } ]
  }, {
    "tStartMs": 189466,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "you might see"
    } ]
  }, {
    "tStartMs": 192433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "or hear expressions like, \""
    } ]
  }, {
    "tStartMs": 194933,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Why are you so Versailles?\" or \""
    } ]
  }, {
    "tStartMs": 198033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "Don't be so Versailles, okay?"
    } ]
  }, {
    "tStartMs": 201033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "You're a typical Versailles!"
    } ]
  }, {
    "tStartMs": 204233,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "\" Do you know what \"Versailles\" means?"
    } ]
  }, {
    "tStartMs": 208000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Simply put,"
    } ]
  }, {
    "tStartMs": 209300,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "\"Versailles\" is a way of speaking."
    } ]
  }, {
    "tStartMs": 212833,
    "dDurationMs": 7700,
    "segs": [ {
      "utf8": "It's a way of speaking that uses a complaining or dissatisfied tone to show off."
    } ]
  }, {
    "tStartMs": 221433,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "Showing"
    } ]
  }, {
    "tStartMs": 222933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "off means boasting, bragging, being awesome, powerful"
    } ]
  }, {
    "tStartMs": 224633,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": ","
    } ]
  }, {
    "tStartMs": 227866,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "rich,"
    } ]
  }, {
    "tStartMs": 232133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "or anything else."
    } ]
  }, {
    "tStartMs": 234833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "The"
    } ]
  }, {
    "tStartMs": 236533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "key point is that"
    } ]
  }, {
    "tStartMs": 237700,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "it's not direct boasting"
    } ]
  }, {
    "tStartMs": 240133,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": ", but rather a way of speaking that uses a complaining"
    } ]
  }, {
    "tStartMs": 243100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "or dissatisfied tone"
    } ]
  }, {
    "tStartMs": 245066,
    "dDurationMs": 6134,
    "segs": [ {
      "utf8": "to subtly show off."
    } ]
  }, {
    "tStartMs": 251200,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Let me give you an example."
    } ]
  }, {
    "tStartMs": 254233,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "For instance, someone might say to you,"
    } ]
  }, {
    "tStartMs": 257200,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "\"Oh, my new house is so annoying,"
    } ]
  }, {
    "tStartMs": 259833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "there are too many rooms,"
    } ]
  }, {
    "tStartMs": 261866,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "I have to...\""
    } ]
  }, {
    "tStartMs": 266700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "On the surface,"
    } ]
  }, {
    "tStartMs": 268733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "he's complaining about how tiring it is to clean and tidy his house every day."
    } ]
  }, {
    "tStartMs": 270500,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "But actually"
    } ]
  }, {
    "tStartMs": 276400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": ","
    } ]
  }, {
    "tStartMs": 277800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "or what others might hear,"
    } ]
  }, {
    "tStartMs": 280033,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "he's expressing that his new house is very big,"
    } ]
  }, {
    "tStartMs": 284833,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "that he has a large house, and that he's very rich."
    } ]
  }, {
    "tStartMs": 290033,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "You see, he didn't directly say he's rich"
    } ]
  }, {
    "tStartMs": 293900,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "or flaunt his house's size;"
    } ]
  }, {
    "tStartMs": 297466,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "he used a tone of dissatisfaction"
    } ]
  }, {
    "tStartMs": 300600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and"
    } ]
  }, {
    "tStartMs": 302866,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "annoyance to subtly show off his house."
    } ]
  }, {
    "tStartMs": 306700,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "This is a typical Versailles way of speaking,"
    } ]
  }, {
    "tStartMs": 311533,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "which we also call \"Versailles literature.\""
    } ]
  }, {
    "tStartMs": 317266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "Here, \"literature\" doesn't refer to a specific academic discipline"
    } ]
  }, {
    "tStartMs": 321100,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "; it's a way of teasing"
    } ]
  }, {
    "tStartMs": 324466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": ", joking"
    } ]
  }, {
    "tStartMs": 327700,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": ", or even satirizing"
    } ]
  }, {
    "tStartMs": 331233,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "this boastful way of speaking."
    } ]
  }, {
    "tStartMs": 334833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "It's a form of satire,"
    } ]
  }, {
    "tStartMs": 336733,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "hence the term \"Versailles literature.\""
    } ]
  }, {
    "tStartMs": 339800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Do you understand?"
    } ]
  }, {
    "tStartMs": 341466,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "Where did the word \"Versailles\" come from?"
    } ]
  }, {
    "tStartMs": 344733,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "Although I often use this word in my daily life"
    } ]
  }, {
    "tStartMs": 349300,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": ", I didn't really know where it came from."
    } ]
  }, {
    "tStartMs": 353400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "So I looked it up online."
    } ]
  }, {
    "tStartMs": 356733,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "It turns out that around 2020,"
    } ]
  }, {
    "tStartMs": 360466,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "about six years ago,"
    } ]
  }, {
    "tStartMs": 362700,
    "dDurationMs": 7300,
    "segs": [ {
      "utf8": "someone online used this method to flaunt their"
    } ]
  }, {
    "tStartMs": 370300,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "luxurious lifestyle"
    } ]
  }, {
    "tStartMs": 373800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": ". She"
    } ]
  }, {
    "tStartMs": 375800,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "flaunted her wealth, showing off her mansion and luxurious house,"
    } ]
  }, {
    "tStartMs": 380233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "and how much her husband doted on her."
    } ]
  }, {
    "tStartMs": 383700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "Many people commented on her after seeing this."
    } ]
  }, {
    "tStartMs": 387500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "One person"
    } ]
  }, {
    "tStartMs": 389466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "thought her way of showing off"
    } ]
  }, {
    "tStartMs": 392866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and what she was flaunting"
    } ]
  }, {
    "tStartMs": 395300,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "was very similar to the life of French nobles depicted in"
    } ]
  }, {
    "tStartMs": 400733,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "the Japanese manga \"The Rose of Versailles.\""
    } ]
  }, {
    "tStartMs": 405333,
    "dDurationMs": 7567,
    "segs": [ {
      "utf8": "So, the word \"Versailles\" was used to satirize her ostentatious display."
    } ]
  }, {
    "tStartMs": 412900,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Gradually, the word spread and"
    } ]
  }, {
    "tStartMs": 417100,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "has now become a very common term."
    } ]
  }, {
    "tStartMs": 422833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "Let's look at a few more examples"
    } ]
  }, {
    "tStartMs": 425466,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "to see what the characteristics of this Versailles-style ostentation are."
    } ]
  }, {
    "tStartMs": 431033,
    "dDurationMs": 6067,
    "segs": [ {
      "utf8": "The first characteristic is to first belittle oneself and then elevate oneself."
    } ]
  }, {
    "tStartMs": 437100,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "Belittling and elevating"
    } ]
  }, {
    "tStartMs": 439400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "oneself means first saying that one is bad,"
    } ]
  }, {
    "tStartMs": 442300,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "then making others think that one is good."
    } ]
  }, {
    "tStartMs": 446500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "This is called belittling oneself, putting oneself down"
    } ]
  }, {
    "tStartMs": 450200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": ", and then"
    } ]
  }, {
    "tStartMs": 452066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "elevating oneself"
    } ]
  }, {
    "tStartMs": 454066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": ". In other"
    } ]
  }, {
    "tStartMs": 456466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "words,"
    } ]
  }, {
    "tStartMs": 457700,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "when speaking, one first says that one is"
    } ]
  }, {
    "tStartMs": 461100,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "bad, annoyed, and dissatisfied"
    } ]
  }, {
    "tStartMs": 464400,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": ", but actually wants others to think that one is very powerful and awesome."
    } ]
  }, {
    "tStartMs": 470800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "For example, if someone says to you,"
    } ]
  }, {
    "tStartMs": 473400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "\"Oh, I'm so annoyed every morning."
    } ]
  }, {
    "tStartMs": 475833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "My closet is full of bags,"
    } ]
  }, {
    "tStartMs": 477700,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "and I don't know which bag to take with me every day,"
    } ]
  }, {
    "tStartMs": 482000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "\" is she really annoyed?"
    } ]
  }, {
    "tStartMs": 484466,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "No, she's actually showing off."
    } ]
  }, {
    "tStartMs": 487833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "She has so many designer bags"
    } ]
  }, {
    "tStartMs": 490433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": ", so many high-end bags."
    } ]
  }, {
    "tStartMs": 492900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "For example, if"
    } ]
  }, {
    "tStartMs": 493833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "someone says to you,"
    } ]
  }, {
    "tStartMs": 495466,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "\"Ugh, it's so annoying!"
    } ]
  }, {
    "tStartMs": 496533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "I eat so much every day, but I"
    } ]
  }, {
    "tStartMs": 498600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "just don't gain weight"
    } ]
  }, {
    "tStartMs": 500033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": ". When will I ever get fat?\""
    } ]
  }, {
    "tStartMs": 503033,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "On the surface, she's complaining about herself, about being too thin,"
    } ]
  }, {
    "tStartMs": 507200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "about not gaining weight no matter how much she eats."
    } ]
  }, {
    "tStartMs": 510100,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But actually, or what others hear,"
    } ]
  }, {
    "tStartMs": 513433,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "she's showing off that she can eat whatever she wants and never gain weight,"
    } ]
  }, {
    "tStartMs": 518833,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "that she always has a great figure"
    } ]
  }, {
    "tStartMs": 521066,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": ". A fat person would be very angry if they heard that, right?"
    } ]
  }, {
    "tStartMs": 525066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "The second characteristic"
    } ]
  }, {
    "tStartMs": 526333,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "is that people from Versailles speak very casually,"
    } ]
  }, {
    "tStartMs": 530233,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "subtly"
    } ]
  }, {
    "tStartMs": 534000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "showing off. They don't directly show off;"
    } ]
  }, {
    "tStartMs": 536466,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "they don't say things like, \"Look how rich I am,"
    } ]
  }, {
    "tStartMs": 539800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "look how good my husband is to me,"
    } ]
  }, {
    "tStartMs": 542066,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "look how smart I am."
    } ]
  }, {
    "tStartMs": 543900,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "\" That's not Versailles"
    } ]
  }, {
    "tStartMs": 545866,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": ". That kind"
    } ]
  }, {
    "tStartMs": 547533,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "of direct showing off isn't Versailles."
    } ]
  }, {
    "tStartMs": 551300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "People from Versailles use a very casual tone,"
    } ]
  }, {
    "tStartMs": 556133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "as if they're quite..."
    } ]
  }, {
    "tStartMs": 558833,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "They pretend they're not showing off,"
    } ]
  }, {
    "tStartMs": 562033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "like"
    } ]
  }, {
    "tStartMs": 562833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "someone saying, \"Hey,"
    } ]
  }, {
    "tStartMs": 564833,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "I saw so many people at the LV store next to my house today, and"
    } ]
  }, {
    "tStartMs": 569000,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I just remembered I haven't even used my new bag yet!\""
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "That's unintentional showing"
    } ]
  }, {
    "tStartMs": 578133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "off"
    } ]
  }, {
    "tStartMs": 581466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": ". They seem to be chatting casually"
    } ]
  }, {
    "tStartMs": 584400,
    "dDurationMs": 6666,
    "segs": [ {
      "utf8": ", but you can also hear them bragging about how bustling their neighborhood is, right"
    } ]
  }, {
    "tStartMs": 591300,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "next to an LV store"
    } ]
  }, {
    "tStartMs": 593433,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": ", and how many bags"
    } ]
  }, {
    "tStartMs": 595100,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "they own—too many to carry"
    } ]
  }, {
    "tStartMs": 598533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": ", no time to use them all."
    } ]
  }, {
    "tStartMs": 601100,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "That's a kind of unintentional showing off."
    } ]
  }, {
    "tStartMs": 605700,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "The third characteristic"
    } ]
  }, {
    "tStartMs": 606933,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "is that people from Versailles like to use other people's words to praise themselves."
    } ]
  }, {
    "tStartMs": 612200,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "They don't directly use their own words to boast"
    } ]
  }, {
    "tStartMs": 616033,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": ", but rather through the words of others"
    } ]
  }, {
    "tStartMs": 618333,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "."
    } ]
  }, {
    "tStartMs": 622800,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "For example, \"Oh, my boyfriend always says I look like a celebrity."
    } ]
  }, {
    "tStartMs": 627666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "He says I look like that celebrity every day.\""
    } ]
  }, {
    "tStartMs": 630133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "I'm so annoyed,"
    } ]
  }, {
    "tStartMs": 631466,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "I don't want to look like a celebrity at all."
    } ]
  }, {
    "tStartMs": 634866,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "This is using your boyfriend's words to brag about how beautiful you are"
    } ]
  }, {
    "tStartMs": 641066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "and how you look like a celebrity."
    } ]
  }, {
    "tStartMs": 643066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "These are the three characteristics of Versailles."
    } ]
  }, {
    "tStartMs": 646700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Now, you might ask,"
    } ]
  }, {
    "tStartMs": 648500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "why do Chinese people use Versailles?"
    } ]
  }, {
    "tStartMs": 651533,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Can't they just say what they mean?"
    } ]
  }, {
    "tStartMs": 654466,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "That's a good question"
    } ]
  }, {
    "tStartMs": 656933,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": ". Actually, in Chinese culture, people"
    } ]
  }, {
    "tStartMs": 660233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "particularly value humility."
    } ]
  }, {
    "tStartMs": 663433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "If you directly brag about"
    } ]
  }, {
    "tStartMs": 666400,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "how beautiful, powerful, and rich you are"
    } ]
  }, {
    "tStartMs": 670800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": ", it will seem like you're not humble at all,"
    } ]
  }, {
    "tStartMs": 673433,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and people will think you're too arrogant."
    } ]
  }, {
    "tStartMs": 676100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "In Chinese culture,"
    } ]
  }, {
    "tStartMs": 677533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "humility is a virtue."
    } ]
  }, {
    "tStartMs": 680300,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "However, nowadays, many people"
    } ]
  }, {
    "tStartMs": 683233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "especially want others to know that they are doing well"
    } ]
  }, {
    "tStartMs": 686733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": ", that they are rich"
    } ]
  }, {
    "tStartMs": 688833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": ", and that they are successful."
    } ]
  }, {
    "tStartMs": 690900,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So, they've found this \"clever\" way:"
    } ]
  }, {
    "tStartMs": 695000,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "using a complaining, dissatisfied tone to brag about themselves."
    } ]
  }, {
    "tStartMs": 700500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "This way, they can say,"
    } ]
  }, {
    "tStartMs": 702033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "\"I'm not bragging,"
    } ]
  }, {
    "tStartMs": 703833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "I'm just expressing my dissatisfaction"
    } ]
  }, {
    "tStartMs": 707000,
    "dDurationMs": 6066,
    "segs": [ {
      "utf8": ".\" But the listener can immediately tell they're bragging."
    } ]
  }, {
    "tStartMs": 713300,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "So, the word \"Versailles\" actually has a slightly derogatory connotation."
    } ]
  }, {
    "tStartMs": 718700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "People generally dislike this way of speaking,"
    } ]
  }, {
    "tStartMs": 722533,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "finding it"
    } ]
  }, {
    "tStartMs": 726100,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "too pretentious and insincere."
    } ]
  }, {
    "tStartMs": 728466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "When someone tells you, \"Stop being so Versailles,\""
    } ]
  }, {
    "tStartMs": 732033,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "they actually mean"
    } ]
  }, {
    "tStartMs": 733600,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": ", \"Okay , okay, stop showing off. I know you're bragging, stop pretending.\""
    } ]
  }, {
    "tStartMs": 738966,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Now you know what \"Versailles\" means, right?"
    } ]
  }, {
    "tStartMs": 742466,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "Finally, let's look at the usage of \"Versailles.\""
    } ]
  }, {
    "tStartMs": 746500,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "The first usage"
    } ]
  }, {
    "tStartMs": 747900,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "is as an adjective;"
    } ]
  }, {
    "tStartMs": 751133,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "you can directly say, \""
    } ]
  }, {
    "tStartMs": 752933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "You're so Versailles!\""
    } ]
  }, {
    "tStartMs": 754900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "That's an adjective."
    } ]
  }, {
    "tStartMs": 756833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The second usage is"
    } ]
  }, {
    "tStartMs": 758333,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "as a verb: \"Stop being so Versailles!"
    } ]
  }, {
    "tStartMs": 762200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "You're being so Versailles right now!"
    } ]
  }, {
    "tStartMs": 765033,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "\" meaning you're showing off."
    } ]
  }, {
    "tStartMs": 768433,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The third usage can also be as a noun"
    } ]
  }, {
    "tStartMs": 773533,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": ", for example, \"This is typical Versailles!"
    } ]
  }, {
    "tStartMs": 777033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "This is typical showing off!\""
    } ]
  }, {
    "tStartMs": 780033,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "Okay, that's all for today's explanation of \"Versailles.\""
    } ]
  }, {
    "tStartMs": 783833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "Do you understand its meaning and usage?"
    } ]
  }, {
    "tStartMs": 787533,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "If you understand,"
    } ]
  }, {
    "tStartMs": 789300,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "you can write a Versailles phrase in the comments section"
    } ]
  }, {
    "tStartMs": 794066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "to let me know if you've learned it."
    } ]
  }, {
    "tStartMs": 796633,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Okay, that's all for today's video."
    } ]
  }, {
    "tStartMs": 799600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "Thank you for watching."
    } ]
  }, {
    "tStartMs": 801533,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "If you like my channel,"
    } ]
  }, {
    "tStartMs": 803466,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "please subscribe! Bye!"
    } ]
  } ]
}
