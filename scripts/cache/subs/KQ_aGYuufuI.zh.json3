  }, {
    "tStartMs": 30833,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "néng gòu zhǎng wò shí gè hàn yǔ dān cí\n能   够  掌    握 十  个 汉  语 单  词"
