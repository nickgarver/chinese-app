  }, {
    "tStartMs": 2933,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "nǐ zhù zài shén me dì fāng\n你住在什么地方"
    } ]
  }, {
    "tStartMs": 6066,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "nǐ zhù zài chéng shì hái shì nóng cūn\n你住在城市还是农村"
    } ]
  }, {
    "tStartMs": 10800,
    "dDurationMs": 5199,
    "segs": [ {
      "utf8": "nǐ zhù zài dài chéng shì hái shì xiǎo chéng shì\n你住在大城市还是小城市"
    } ]
  }, {
    "tStartMs": 17333,
    "dDurationMs": 6533,
    "segs": [ {
      "utf8": "jīn tiān wǒ men yào liáo de huà tí shì “ wǒ de chéng shì ”\n今天我们要聊的话题是“我的城市”"
    } ]
  }, {
    "tStartMs": 24133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "“ wǒ zhù de dì fāng ”\n“我住的地方”"
    } ]
  }, {
    "tStartMs": 28066,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "dà jiā hǎo   rú guǒ nǐ hái bú rèn shi wǒ\n大家好 如果你还不认识我"
    } ]
  }, {
    "tStartMs": 32500,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "wǒ jiào xiǎo nà\n我叫小娜"
    } ]
  }, {
    "tStartMs": 34466,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "huān yíng nǐ hé wǒ yì qǐ xué zhōng wén\n欢迎你和我一起学中文"
    } ]
  }, {
    "tStartMs": 40266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "wǒ zhù zài nǎ lǐ ne\n我住在哪里呢"
    } ]
  }, {
    "tStartMs": 43566,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "wǒ zhù zài tiān jīn\n我住在天津"
    } ]
  }, {
    "tStartMs": 46400,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "tiān jīn shì yí gè chéng shì\n天津是一个城市"
    } ]
  }, {
    "tStartMs": 50566,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "hěn dà de chéng shì\n很大的城市"
    } ]
  }, {
    "tStartMs": 53166,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "tiān jīn zài zhōng guó de běi fāng\n天津在中国的北方"
    } ]
  }, {
    "tStartMs": 58133,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "lí běi jīng hěn jìn\n离北京很近"
    } ]
  }, {
    "tStartMs": 62533,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "nà tiān jīn shì hěn dà hěn dà de chéng shì ma\n那天津是很大很大的城市吗"
