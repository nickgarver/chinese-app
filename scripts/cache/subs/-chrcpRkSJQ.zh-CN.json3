  }, {
    "tStartMs": 67900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "zài zhōng guó\n在中国"
    } ]
  }, {
    "tStartMs": 69266,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "wǒ men shuō zhōng guó yǒu sì gè zuì dà de chéng shì\n我们说中国有四个最大的城市"
    } ]
  }, {
    "tStartMs": 76166,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "wǒ men jiào yí xiàn chéng shì\n我们叫一线城市"
