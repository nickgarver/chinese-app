  }, {
    "tStartMs": 109400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "běi shàng guǎng shēn\n北上广深"
    } ]
  }, {
    "tStartMs": 112766,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "jiù shì běi jīng 、 shàng hǎi 、 guǎng zhōu 、 shēn zhèn\n就是北京、上海、广州、深圳"
