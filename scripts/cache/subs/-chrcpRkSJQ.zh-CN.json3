  }, {
    "tStartMs": 91933,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "chéng shì de jīng jì hěn hǎo\n城市的经济很好"
    } ]
  }, {
    "tStartMs": 95866,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "chéng shì lǐ yǒu hěn duō hěn duō gōng zuò\n城市里有很多很多工作"
