{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 166,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "大家好欢迎来到我的慢速中文播客"
    } ]
  }, {
    "tStartMs": 4400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "如果这是你第一次来到我的频道"
    } ]
  }, {
    "tStartMs": 8133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "那么我是一名对外汉语老师"
    } ]
  }, {
    "tStartMs": 11466,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "上个月我在越南旅居了一个月"
    } ]
  }, {
    "tStartMs": 15200,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "今天这个视频我想跟你们"
    } ]
  }, {
    "tStartMs": 17500,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "分享一下我在越南旅居的经历"
    } ]
  }, {
    "tStartMs": 21500,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "你可能会问我为什么选择越南"
    } ]
  }, {
    "tStartMs": 25100,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "其实主要的原因很简单"
    } ]
  }, {
    "tStartMs": 27900,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "主要原因呢"
    } ]
  }, {
    "tStartMs": 28966,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "是我某一天看到我喜欢的英文博主"
    } ]
  }, {
    "tStartMs": 33200,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "他们在越南一边旅居一边做内容创作"
    } ]
  }, {
    "tStartMs": 37900,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "这里我想解释一下旅居这个词"
    } ]
  }, {
    "tStartMs": 40866,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "它和旅游有一点不一样"
    } ]
  }, {
    "tStartMs": 43566,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "旅游呢可能是比较短时间的"
    } ]
  }, {
    "tStartMs": 47066,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "但是旅居就是你能够比较"
    } ]
  }, {
    "tStartMs": 51066,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "长时间的在一个地方生活"
    } ]
  }, {
    "tStartMs": 54533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "融入当地"
    } ]
  }, {
    "tStartMs": 55766,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "比如说像我这次就在"
    } ]
  }, {
    "tStartMs": 58133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "越南旅居了一个月"
    } ]
  }, {
    "tStartMs": 60200,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "然后我也突然有了"
    } ]
  }, {
    "tStartMs": 62333,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "想做这件事情的冲动"
    } ]
  }, {
    "tStartMs": 64466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我就告诉我的一个朋友"
    } ]
  }, {
    "tStartMs": 66766,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "她说不要犹豫冲"
    } ]
  }, {
    "tStartMs": 69966,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "别等下个月"
    } ]
  }, {
    "tStartMs": 71500,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "别等下周"
    } ]
  }, {
    "tStartMs": 72533,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "就是现在"
    } ]
  }, {
    "tStartMs": 73633,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我也觉得"
    } ]
  }, {
    "tStartMs": 74566,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "有的时候真正想做一件事情的时候"
    } ]
  }, {
    "tStartMs": 77900,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "不能想太多"
    } ]
  }, {
    "tStartMs": 79766,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "如果想多了"
    } ]
  }, {
    "tStartMs": 80933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "就容易因为对未知的恐惧"
    } ]
  }, {
    "tStartMs": 83066,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "而找各种理由"
    } ]
  }, {
    "tStartMs": 85166,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "然后不去做"
    } ]
  }, {
    "tStartMs": 86433,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "有时候恐惧的声音会占上风"
    } ]
  }, {
    "tStartMs": 89900,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "阻止我们去做一些事情"
    } ]
  }, {
    "tStartMs": 92000,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "于是我第二天就申请了去越南的签证"
    } ]
  }, {
    "tStartMs": 97133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "越南对中国不免签"
    } ]
  }, {
    "tStartMs": 99800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "但是只需要在网上填写"
    } ]
  }, {
    "tStartMs": 102300,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "一些简单的申请资料"
    } ]
  }, {
    "tStartMs": 104800,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "然后等大概三四个工作日就好了"
    } ]
  }, {
    "tStartMs": 108733,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "我记得申请签证的费用是25美金"
    } ]
  }, {
    "tStartMs": 112733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "第二个原因呢"
    } ]
  }, {
    "tStartMs": 114100,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就是生活成本比较低"
    } ]
  }, {
    "tStartMs": 116766,
    "dDurationMs": 6534,
    "segs": [ {
      "utf8": "越南的住宿吃饭交通都比很多国家要更便宜一些"
    } ]
  }, {
    "tStartMs": 123300,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "去之前我大概计算了一下"
    } ]
  }, {
    "tStartMs": 125866,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "在越南生活一个月的费用"
    } ]
  }, {
    "tStartMs": 128733,
    "dDurationMs": 5967,
    "segs": [ {
      "utf8": "包括机票签证住宿吃饭交通"
    } ]
  }, {
    "tStartMs": 134700,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "大概要1万人民币"
    } ]
  }, {
    "tStartMs": 137766,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "不到1,500美金这样"
    } ]
  }, {
    "tStartMs": 140300,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "之前我在云南旅居过一个月"
    } ]
  }, {
    "tStartMs": 142800,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "费用是7,000人民币"
    } ]
  }, {
    "tStartMs": 145766,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "差不多1,000美金"
    } ]
  }, {
    "tStartMs": 147666,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我觉得只要旅居成本"
    } ]
  }, {
    "tStartMs": 149733,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "在我的能力范围内"
    } ]
  }, {
    "tStartMs": 151600,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "那么就不是什么问题"
    } ]
  }, {
    "tStartMs": 153866,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "我前面提到了一个词叫生活成本"
    } ]
  }, {
    "tStartMs": 157966,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "生活成本就是你在一个地方生活所需要的花费"
    } ]
  }, {
    "tStartMs": 164066,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这里我给你们留两个问题"
    } ]
  }, {
    "tStartMs": 166333,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "第一个是在你们国家一个月的生活成本大概需要多少呢"
    } ]
  }, {
    "tStartMs": 172733,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "你觉得哪个国家的生活成本最高"
    } ]
  }, {
    "tStartMs": 177200,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "来到越南后"
    } ]
  }, {
    "tStartMs": 178733,
    "dDurationMs": 5967,
    "segs": [ {
      "utf8": "我印象最深的就是越南的摩托车真的非常多"
    } ]
  }, {
    "tStartMs": 184700,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "有时候我站在一个没有红绿灯的路口"
    } ]
  }, {
    "tStartMs": 188600,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "连续等几分钟都找不到"
    } ]
  }, {
    "tStartMs": 190966,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "一个好机会可以让我过马路"
    } ]
  }, {
    "tStartMs": 193866,
    "dDurationMs": 5234,
    "segs": [ {
      "utf8": "所以在越南过马路真的需要一些自信和勇气"
    } ]
  }, {
    "tStartMs": 199100,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "不过比起以前我在马来西亚的生活"
    } ]
  }, {
    "tStartMs": 202733,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "我觉得越南的马路已经好很多了"
    } ]
  }, {
    "tStartMs": 206366,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "因为在马来西亚基本上路就是给车的"
    } ]
  }, {
    "tStartMs": 211100,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "而不是给人走路的"
    } ]
  }, {
    "tStartMs": 212966,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "至少越南到处都是人行道"
    } ]
  }, {
    "tStartMs": 215666,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "然后红绿灯也比较多"
    } ]
  }, {
    "tStartMs": 218066,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "因为摩托车多"
    } ]
  }, {
    "tStartMs": 220200,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "司机也习惯按喇叭"
    } ]
  }, {
    "tStartMs": 222500,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "我在越南住了4个民宿"
    } ]
  }, {
    "tStartMs": 225200,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "虽然房间都是有隔音玻璃门的"
    } ]
  }, {
    "tStartMs": 228533,
    "dDurationMs": 6067,
    "segs": [ {
      "utf8": "但是每天还是不可避免的能听到摩托车的噪音"
    } ]
  }, {
    "tStartMs": 234600,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "不过听多了"
    } ]
  }, {
    "tStartMs": 236133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "好像也慢慢能习惯一点了"
    } ]
  }, {
    "tStartMs": 238866,
    "dDurationMs": 4334,
    "segs": [ {
      "utf8": "融入当地的生活方式之一就是打摩的"
    } ]
  }, {
    "tStartMs": 243200,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "在我的印象中"
    } ]
  }, {
    "tStartMs": 245266,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "摩的在我小时候还有"
    } ]
  }, {
    "tStartMs": 248200,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "但是现在逐渐已经看不见了"
    } ]
  }, {
    "tStartMs": 251933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "那时候还有一些可怕的新闻"
    } ]
  }, {
    "tStartMs": 254866,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "比如说一个女生打摩的"
    } ]
  }, {
    "tStartMs": 257000,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "然后被奸杀了之类的"
    } ]
  }, {
    "tStartMs": 259466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "现在的中国偶尔偶尔"
    } ]
  }, {
    "tStartMs": 262700,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "能看到一些不正规的摩的"
    } ]
  }, {
    "tStartMs": 265566,
    "dDurationMs": 4534,
    "segs": [ {
      "utf8": "我说的不正规就是他们不通过平台的"
    } ]
  }, {
    "tStartMs": 270200,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "我觉得现在基本上也没有人会去坐摩的了"
    } ]
  }, {
    "tStartMs": 275433,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "在越南呢"
    } ]
  }, {
    "tStartMs": 276400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "因为街道总是很拥堵"
    } ]
  }, {
    "tStartMs": 278900,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "打摩的比打出租车要快"
    } ]
  }, {
    "tStartMs": 281900,
    "dDurationMs": 6433,
    "segs": [ {
      "utf8": "价格也便宜很多大概1/3或者将近一半的价格吧"
    } ]
  }, {
    "tStartMs": 288333,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 288733,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "我在越南打摩的的次数其实是更多的"
    } ]
  }, {
    "tStartMs": 292866,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "就是有时候遇到开得很快的司机"
    } ]
  }, {
    "tStartMs": 296066,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "我坐在后面真的很紧张"
    } ]
  }, {
    "tStartMs": 298533,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "如果是晚上"
    } ]
  }, {
    "tStartMs": 300200,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "或者是去一些比较偏僻的地方"
    } ]
  }, {
    "tStartMs": 303200,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "那么我就会选择打出租车"
    } ]
  }, {
    "tStartMs": 306100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "而不是打摩的"
    } ]
  }, {
    "tStartMs": 307666,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "在这个部分呢"
    } ]
  }, {
    "tStartMs": 309000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我提到了印象"
    } ]
  }, {
    "tStartMs": 310900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "我给你们留两个问题"
    } ]
  }, {
    "tStartMs": 313366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "第一个问题是"
    } ]
  }, {
    "tStartMs": 314566,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "你觉得第一印象重要吗为什么"
    } ]
  }, {
    "tStartMs": 318666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "第二个问题是"
    } ]
  }, {
    "tStartMs": 320700,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "在你过往的旅行中"
    } ]
  }, {
    "tStartMs": 323733,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "你觉得什么事情给你留下了很深的印象"
    } ]
  }, {
    "tStartMs": 328933,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "在中国很多年轻人喜欢去咖啡店工作"
    } ]
  }, {
    "tStartMs": 333433,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "在越南也是一样的"
    } ]
  }, {
    "tStartMs": 335600,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "不过越南的咖啡有着自己的特色"
    } ]
  }, {
    "tStartMs": 340166,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "比如说鸡蛋咖啡"
    } ]
  }, {
    "tStartMs": 342333,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "第一次听到的时候"
    } ]
  }, {
    "tStartMs": 343766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "我会觉得很奇怪"
    } ]
  }, {
    "tStartMs": 346133,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "鸡蛋和咖啡怎么能放在一起"
    } ]
  }, {
    "tStartMs": 349633,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "鸡蛋的味道不会很腥吗"
    } ]
  }, {
    "tStartMs": 352233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "后来我去尝试了一下"
    } ]
  }, {
    "tStartMs": 355166,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "喝了一口发现味道很香很浓"
    } ]
  }, {
    "tStartMs": 359333,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "甚至都尝不出一点鸡蛋的味道"
    } ]
  }, {
    "tStartMs": 363000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "另外还有椰子咖啡"
    } ]
  }, {
    "tStartMs": 365533,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "它有一小杯浓缩咖啡"
    } ]
  }, {
    "tStartMs": 368766,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "然后还有一大杯椰奶"
    } ]
  }, {
    "tStartMs": 371833,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "可以自己把那一杯"
    } ]
  }, {
    "tStartMs": 373766,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "浓缩咖啡倒进椰奶里"
    } ]
  }, {
    "tStartMs": 376333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "天气热的时候喝一杯"
    } ]
  }, {
    "tStartMs": 378166,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "冰冰凉凉的椰子咖啡"
    } ]
  }, {
    "tStartMs": 380766,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "真的很舒服"
    } ]
  }, {
    "tStartMs": 382233,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "最后我比较喜欢的是越南的海盐咖啡"
    } ]
  }, {
    "tStartMs": 386800,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "它既有咖啡的一点甜味"
    } ]
  }, {
    "tStartMs": 389633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "也有海盐的咸味"
    } ]
  }, {
    "tStartMs": 391633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我是一个没有喝咖啡习惯的人"
    } ]
  }, {
    "tStartMs": 394100,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "但是在越南我基本上每天都在喝咖啡"
    } ]
  }, {
    "tStartMs": 398533,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "因为越南的咖啡真的是太好喝了"
    } ]
  }, {
    "tStartMs": 401800,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我在越南的首都河内"
    } ]
  }, {
    "tStartMs": 404433,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "发生了一件神奇的事情"
    } ]
  }, {
    "tStartMs": 407500,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我走进了一家河粉的餐厅"
    } ]
  }, {
    "tStartMs": 410700,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "然后墙上的菜单全部都是越南语"
    } ]
  }, {
    "tStartMs": 415233,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我用英文跟店里的小哥说"
    } ]
  }, {
    "tStartMs": 418233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "让他帮我选一个特色的(河粉）"
    } ]
  }, {
    "tStartMs": 421433,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "但是他听不懂我的英文"
    } ]
  }, {
    "tStartMs": 423533,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "然后我就拿出手机打开翻译"
    } ]
  }, {
    "tStartMs": 426566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我想翻译给他看"
    } ]
  }, {
    "tStartMs": 428666,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "然后他看到我的手机有中文页面"
    } ]
  }, {
    "tStartMs": 432466,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "他开始跟我说中文"
    } ]
  }, {
    "tStartMs": 434833,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "我心想没想到中文超过英文"
    } ]
  }, {
    "tStartMs": 438800,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "成为国际通用的语言了"
    } ]
  }, {
    "tStartMs": 441633,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "越南语和中文一样也有声调"
    } ]
  }, {
    "tStartMs": 444833,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "然后有些词的发音也很像"
    } ]
  }, {
    "tStartMs": 449033,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "所以我觉得对于越南人来说"
    } ]
  }, {
    "tStartMs": 452300,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "学中文应该是相对会更容易一点的"
    } ]
  }, {
    "tStartMs": 456300,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "你的母语有声调吗"
    } ]
  }, {
    "tStartMs": 459433,
    "dDurationMs": 6133,
    "segs": [ {
      "utf8": "在你的母语中有没有一些词的发音和中文是很像的？"
    } ]
  }, {
    "tStartMs": 465566,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "因为我是线上工作的原因"
    } ]
  }, {
    "tStartMs": 468466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "所以我有一台电脑就够了"
    } ]
  }, {
    "tStartMs": 471400,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "旅居能让我长时间的待在一个地方"
    } ]
  }, {
    "tStartMs": 475266,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "有机会深入体验当地人的生活"
    } ]
  }, {
    "tStartMs": 479366,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "来到新的地方以后"
    } ]
  }, {
    "tStartMs": 480900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我们会发现原来世界上"
    } ]
  }, {
    "tStartMs": 483000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "有很多不同的生活方式"
    } ]
  }, {
    "tStartMs": 485700,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "这些经历会让我面对学生的时候"
    } ]
  }, {
    "tStartMs": 489100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "成为一个更好的中文老师"
    } ]
  }, {
    "tStartMs": 492066,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "能让我更加了解他们的文化"
    } ]
  }, {
    "tStartMs": 495600,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "也会让我成为一个更包容的世界公民"
    } ]
  }, {
    "tStartMs": 499466,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "成为一个更好的自己"
    } ]
  }, {
    "tStartMs": 501933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "这段在越南的经历"
    } ]
  }, {
    "tStartMs": 503566,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我不但自己看了很多风景"
    } ]
  }, {
    "tStartMs": 506966,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "也面对了很多挑战"
    } ]
  }, {
    "tStartMs": 509833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "我觉得我比以前要勇敢很多"
    } ]
  }, {
    "tStartMs": 512066,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "因为相信自己不管遇到什么困难"
    } ]
  }, {
    "tStartMs": 515433,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "都有能够解决问题的能力"
    } ]
  }, {
    "tStartMs": 519000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "在面对很多事情的时候"
    } ]
  }, {
    "tStartMs": 522166,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "恐惧有时候会占据我们的大脑"
    } ]
  }, {
    "tStartMs": 525200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "替我们说话"
    } ]
  }, {
    "tStartMs": 526633,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "所以有时候发生一件事情"
    } ]
  }, {
    "tStartMs": 528966,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我会在脑子里问自己"
    } ]
  }, {
    "tStartMs": 532233,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "是选择勇敢还是恐惧"
    } ]
  }, {
    "tStartMs": 535733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "如果答案不是恐惧的那一方"
    } ]
  }, {
    "tStartMs": 538500,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "那么我就能更好的去直面恐惧"
    } ]
  }, {
    "tStartMs": 542633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "并且放下恐惧"
    } ]
  }, {
    "tStartMs": 544200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "好了今天的分享就到这里"
    } ]
  }, {
    "tStartMs": 546700,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "如果你也去过越南"
    } ]
  }, {
    "tStartMs": 549133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "欢迎你在评论区告诉我"
    } ]
  }, {
    "tStartMs": 551200,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "你最喜欢越南的什么地方"
    } ]
  }, {
    "tStartMs": 554333,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "如果你还没去过越南"
    } ]
  }, {
    "tStartMs": 556300,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那你最想体验的是什么呢"
    } ]
  }, {
    "tStartMs": 558666,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "如果你喜欢这样的慢速中文播客"
    } ]
  }, {
    "tStartMs": 563133,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "欢迎你点赞订阅"
    } ]
  }, {
    "tStartMs": 565600,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "那我们下次视频见吧拜拜"
    } ]
  } ]
}
