    "segs": [ {
      "utf8": "Wow, so many horses!"
    } ]
  }, {
    "tStartMs": 920399,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "Yes, they're pairs of horses."
    } ]
  }, {
    "tStartMs": 923100,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "A pair."
    } ]
  }, {
    "tStartMs": 923899,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 924333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Really."
    } ]
  }, {
    "tStartMs": 925533,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "Wow!"
    } ]
  }, {
    "tStartMs": 926399,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Time to go home."
    } ]
  }, {
    "tStartMs": 927399,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Yes, they come down"
    } ]
  }, {
    "tStartMs": 928899,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "in the evening, I think."
    } ]
  }, {
    "tStartMs": 930466,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 931133,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "I guess they went to walk that"
    } ]
  }, {
    "tStartMs": 933766,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "climb that mountain."
    } ]
  }, {
    "tStartMs": 935133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "Yes, they're going home now."
    } ]
  }, {
    "tStartMs": 940500,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "Someone is making a snowman."
    } ]
  }, {
    "tStartMs": 947266,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "You can hear the sound of the snow."
    } ]
  }, {
    "tStartMs": 1110299,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Warm packs."
    } ]
  }, {
    "tStartMs": 1111166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "So fragrant!"
    } ]
  }, {
    "tStartMs": 1112133,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "So fragrant!"
    } ]
  }, {
    "tStartMs": 1112833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Where do you want to stick them?"
    } ]
  }, {
    "tStartMs": 1114533,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "Stomach and shoulders."
    } ]
  }, {
    "tStartMs": 1116299,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Stick one on the shoulders."
    } ]
  }, {
    "tStartMs": 1118266,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "This is a warm pack."
    } ]
  }, {
    "tStartMs": 1119266,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Once you tear open the outer layer, it starts heating up."
    } ]
  }, {
    "tStartMs": 1122133,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Then peel off one layer,"
    } ]
  }, {
    "tStartMs": 1123566,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "and you can stick it here."
    } ]
  }, {
    "tStartMs": 1124966,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "It's best to leave a layer—"
    } ]
  }, {
    "tStartMs": 1126066,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Right now, we're"
    } ]
  }, {
    "tStartMs": 1126933,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "about to leave this hotel."
    } ]
  }, {
    "tStartMs": 1129466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "We're going to a new place."
    } ]
  }, {
    "tStartMs": 1132366,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "We're packing up now."
    } ]
  }, {
    "tStartMs": 1134566,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "We'll leave around 12 o'clock."
    } ]
  }, {
    "tStartMs": 1137500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "This room of ours"
    } ]
  }, {
    "tStartMs": 1138666,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "has a triangular roof."
    } ]
  }, {
    "tStartMs": 1141599,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "A triangular roof."
    } ]
  }, {
    "tStartMs": 1144966,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "The bathroom is pretty big."
    } ]
  }, {
    "tStartMs": 1146799,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "It has two doors."
    } ]
  }, {
    "tStartMs": 1148099,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "One door leads to just the toilet and tissues."
    } ]
  }, {
    "tStartMs": 1150766,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Inside the other door,"
    } ]
  }, {
    "tStartMs": 1152766,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "there's just the shower stuff."
    } ]
  }, {
    "tStartMs": 1155333,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "Outside this window here is a snowy view."
    } ]
  }, {
    "tStartMs": 1159500,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "Pretty nice."
    } ]
  }, {
    "tStartMs": 1162166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This is our bed."
    } ]
  }, {
    "tStartMs": 1164266,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "This is the desk and TV."
    } ]
  }, {
    "tStartMs": 1167133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "And over here, we also have our"
    } ]
  }, {
    "tStartMs": 1169766,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "sofa, a small sofa."
    } ]
  }, {
    "tStartMs": 1171400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Don't let the small size fool you—"
    } ]
  }, {
    "tStartMs": 1172933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "there's quite a lot of stuff!"
    } ]
  }, {
    "tStartMs": 1174866,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "January—"
    } ]
  }, {
    "tStartMs": 1175766,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "December is better to come."
    } ]
  }, {
    "tStartMs": 1177933,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "Because accommodation is cheaper."
    } ]
  }, {
    "tStartMs": 1180299,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "And the snow is thicker too."
    } ]
  }, {
    "tStartMs": 1182266,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "If you come during the Spring Festival,"
    } ]
  }, {
    "tStartMs": 1183500,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "although there's snow,"
    } ]
  }, {
    "tStartMs": 1184466,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "it's about to melt."
    } ]
  }, {
    "tStartMs": 1186000,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "And accommodation is more expensive."
    } ]
  }, {
    "tStartMs": 1189333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "Summer is also great to come."
    } ]
  }, {
    "tStartMs": 1191466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "Here you can see large herds of cattle and sheep."
    } ]
  }, {
    "tStartMs": 1194766,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "You can also go into the forest to pick mushrooms."
    } ]
  }, {
    "tStartMs": 1200400,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "Today we are going to move to the next place."
    } ]
  }, {
    "tStartMs": 1203099,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Not far from here."
    } ]
  }, {
    "tStartMs": 1203933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "That is Kanas National Park."
    } ]
  }, {
    "tStartMs": 1206200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "So we're going with our driver."
    } ]
  }, {
    "tStartMs": 1209166,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "And yesterday night,"
    } ]
  }, {
    "tStartMs": 1210866,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "the extreme temperatures: minus thirty-one."
    } ]
  }, {
    "tStartMs": 1213599,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "Now I think it's probably minus fifteen."
    } ]
  }, {
    "tStartMs": 1216133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "So it's really cold."
    } ]
  }, {
    "tStartMs": 1217500,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "I have two leather jackets."
    } ]
  }, {
    "tStartMs": 1220599,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "So I have two jackets."
    } ]
  }, {
    "tStartMs": 1222299,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "Uh, and I wore two jackets ahead."
    } ]
  }, {
    "tStartMs": 1226466,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And also prepared a mask."
    } ]
  }, {
    "tStartMs": 1229166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Meow team, meow team!"
    } ]
  }, {
    "tStartMs": 1231099,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "I'll break your dog legs!"
    } ]
  }, {
    "tStartMs": 1233066,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Left hand holding an AK,"
    } ]
  }, {
    "tStartMs": 1234866,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "right hand holding a grenade."
    } ]
  }, {
    "tStartMs": 1236766,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "Not afraid of lawbreakers, are you?"
    } ]
  }, {
    "tStartMs": 1239266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "No matter who you are, haha!"
    } ]
  }, {
    "tStartMs": 1241400,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "A song I made up myself."
    } ]
  }, {
    "tStartMs": 1242533,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "Hey, I see your eyelashes are already frozen!"
    } ]
  }, {
    "tStartMs": 1245400,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Do my eyelashes look nice?"
    } ]
  }, {
    "tStartMs": 1247299,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Yes, they look really nice!"
    } ]
  }, {
    "tStartMs": 1248900,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Your eyelashes—"
    } ]
  }, {
    "tStartMs": 1250000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Because I'm wearing glasses."
    } ]
  }, {
    "tStartMs": 1252000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Yours look especially nice."
    } ]
  }, {
    "tStartMs": 1253333,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "Sparkling!"
    } ]
  }, {
    "tStartMs": 1255500,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "Let's keep going."
    } ]
  }, {
    "tStartMs": 1258666,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "That electric car is totally trapped."
    } ]
  }, {
    "tStartMs": 1260933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "I wonder if the car"
    } ]
  }, {
    "tStartMs": 1262566,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "can start in such extreme weather."
    } ]
  }, {
    "tStartMs": 1269000,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 1269900,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "Then let me ask."
    } ]
  }, {
    "tStartMs": 1270766,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "I might be running out of time."
    } ]
  }, {
    "tStartMs": 1272200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Let me ask first."
    } ]
  }, {
    "tStartMs": 1273166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "In the Kanas National Park,"
    } ]
  }, {
    "tStartMs": 1275099,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "there is again a lot of activity."
    } ]
  }, {
    "tStartMs": 1278700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "This—"
    } ]
  }, {
    "tStartMs": 1280733,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "a balloon and a motorbike."
    } ]
  }, {
    "tStartMs": 1284933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "And also, uh, something"
    } ]
  }, {
    "tStartMs": 1287066,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "that is running around."
    } ]
  }, {
    "tStartMs": 1290166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah, so slippery!"
    } ]
  }, {
    "tStartMs": 1290966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "I can skate!"
    } ]
  }, {
    "tStartMs": 1292900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Come on, slide a bit!"
    } ]
  }, {
    "tStartMs": 1294766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Woo!"
    } ]
  }, {
    "tStartMs": 1296799,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "I'm about to fall!"
    } ]
  }, {
    "tStartMs": 1302833,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "I want to go to the snow ring!"
    } ]
  }, {
    "tStartMs": 1304500,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Let's go, to the snow ring!"
    } ]
  }, {
    "tStartMs": 1306099,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "Let's sit together in the ring!"
    } ]
  }, {
    "tStartMs": 1308099,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "Hahaha!"
    } ]
  }, {
    "tStartMs": 1310766,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "This is something"
    } ]
  }, {
    "tStartMs": 1311599,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "that I've wanted to try for a long time."
    } ]
  }, {
    "tStartMs": 1313866,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Snow ring!"
    } ]
  }, {
    "tStartMs": 1314900,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So basically, it's different tires"
    } ]
  }, {
    "tStartMs": 1316500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "that are tied together."
    } ]
  }, {
    "tStartMs": 1319299,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Uh..."
    } ]
  }, {
    "tStartMs": 1321466,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "Then, Auntie, will you sit next to me?"
    } ]
  }, {
    "tStartMs": 1324633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Then Auntie sits here."
    } ]
  }, {
    "tStartMs": 1328833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh!"
    } ]
  }, {
    "tStartMs": 1339166,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Turn him toward that direction."
    } ]
  }, {
    "tStartMs": 1342366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Turn to one side."
    } ]
  }, {
    "tStartMs": 1343633,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Turn around, turn around!"
    } ]
  }, {
    "tStartMs": 1344599,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Like this little kid."
    } ]
  }, {
    "tStartMs": 1346099,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "Otherwise, you might not hold on tight."
    } ]
  }, {
    "tStartMs": 1349166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yes, yes, very good!"
    } ]
  }, {
    "tStartMs": 1351400,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "Are you turning?"
    } ]
  }, {
    "tStartMs": 1352166,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "I turned too!"
    } ]
  }, {
    "tStartMs": 1352866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "See, I'm also facing the motorcycle"
    } ]
  }, {
    "tStartMs": 1354233,
    "dDurationMs": 1833,
