  }, {
    "tStartMs": 411266,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "There are many dogs and cats in Hemu."
    } ]
  }, {
    "tStartMs": 413566,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "But all of them are very mild."
    } ]
  }, {
    "tStartMs": 419300,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "For them, it's not cold at all."
    } ]
  }, {
    "tStartMs": 421800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "The dogs here are just"
    } ]
  }, {
    "tStartMs": 423233,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "sleeping in the snow."
    } ]
  }, {
    "tStartMs": 430266,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "What are we going to do now?"
    } ]
  }, {
    "tStartMs": 431699,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "Now we're going to take a horse-drawn sleigh."
    } ]
  }, {
    "tStartMs": 433933,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "Horse-drawn sleigh, excited?"
    } ]
  }, {
    "tStartMs": 436933,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "Very excited!"
    } ]
  }, {
    "tStartMs": 437366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "And we're going up during the blue hour."
    } ]
  }, {
    "tStartMs": 439300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 440100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "Yes, there's a horse in front,"
    } ]
  }, {
    "tStartMs": 442066,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "and a small sled behind it."
    } ]
  }, {
    "tStartMs": 444500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 447333,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Will the horse poop?"
    } ]
  }, {
    "tStartMs": 448566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Uh..."
    } ]
  }, {
    "tStartMs": 449899,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "No, it won't."
    } ]
  }, {
    "tStartMs": 450666,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Then will it..."
    } ]
  }, {
    "tStartMs": 451366,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Also, bring our..."
    } ]
  }, {
    "tStartMs": 453100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "He might poop while pulling."
    } ]
  }, {
    "tStartMs": 454966,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "You'll find out soon enough."
    } ]
  }, {
    "tStartMs": 456533,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Does he poop while walking?"
    } ]
  }, {
    "tStartMs": 458133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 460199,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "My mom said she wants to walk up."
    } ]
  }, {
    "tStartMs": 462866,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "She doesn't want to see the horse's butt."
    } ]
  }, {
    "tStartMs": 464500,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Hahaha!"
    } ]
  }, {
    "tStartMs": 467399,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Wow, look!"
    } ]
  }, {
    "tStartMs": 468699,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's so good, hurry up and get on!"
    } ]
  }, {
    "tStartMs": 471766,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "Okay, good!"
    } ]
  }, {
    "tStartMs": 473966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Okay, bye!"
    } ]
  }, {
    "tStartMs": 474899,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Bye bye!"
    } ]
  }, {
    "tStartMs": 476933,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "How is it?"
    } ]
  }, {
    "tStartMs": 477500,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "Look at this uncle's hat."
    } ]
  }, {
    "tStartMs": 478399,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Isn't it really cool?"
    } ]
  }, {
    "tStartMs": 479399,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Why is there no one"
    } ]
  }, {
    "tStartMs": 480699,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "riding that horse?"
    } ]
  }, {
    "tStartMs": 482733,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "Because the horse pulling three people"
    } ]
  }, {
    "tStartMs": 483899,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "is already tired enough."
    } ]
  }, {
    "tStartMs": 485733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The horse will take us to a viewing"
    } ]
  }, {
    "tStartMs": 488133,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "platform that is above the village."
    } ]
  }, {
    "tStartMs": 490366,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "So that we can see the whole village"
    } ]
  }, {
    "tStartMs": 493133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "when it's fully lit up."
    } ]
  }, {
    "tStartMs": 496566,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "Do you see the horse's butt?"
    } ]
  }, {
    "tStartMs": 499566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Wow, look over there, there are so many horses!"
    } ]
  }, {
    "tStartMs": 501766,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "It's really beautiful!"
    } ]
  }, {
    "tStartMs": 503733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Your mom probably walked up from here."
    } ]
  }, {
    "tStartMs": 505733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Our driver has already mounted the horse."
    } ]
  }, {
    "tStartMs": 507766,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "So cool, so cool! Wow!"
    } ]
  }, {
    "tStartMs": 514200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Sir, are you Mongolian"
    } ]
  }, {
    "tStartMs": 515500,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "or Kazakh?"
    } ]
  }, {
    "tStartMs": 516966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Kazakh."
    } ]
  }, {
    "tStartMs": 517866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Kazakh."
    } ]
  }, {
    "tStartMs": 519600,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "Right now,"
    } ]
  }, {
    "tStartMs": 520799,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "we're riding a horse-drawn sleigh."
    } ]
  }, {
    "tStartMs": 523600,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "Hitching the sleigh to that horse."
    } ]
  }, {
    "tStartMs": 526966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "The driver is riding the horse, and the two of us,"
    } ]
  }, {
    "tStartMs": 530299,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "my aunt and I, are sitting below."
    } ]
  }, {
    "tStartMs": 533399,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "On a small bench above."
    } ]
  }, {
    "tStartMs": 535866,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "The horse is walking through the snow."
    } ]
  }, {
    "tStartMs": 539366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "If you move it forward a bit, you can see."
    } ]
  }, {
    "tStartMs": 541000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "What we can see"
    } ]
  }, {
    "tStartMs": 543266,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "is that we can look to both sides."
    } ]
  }, {
    "tStartMs": 545000,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "We can see the snowy scenery,"
    } ]
  }, {
    "tStartMs": 546366,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "but we can't look forward."
    } ]
  }, {
    "tStartMs": 547799,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "Looking forward, you just see the horse's butt."
    } ]
  }, {
    "tStartMs": 550133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Nothing much to see."
    } ]
  }, {
    "tStartMs": 557566,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "Do you see him?"
    } ]
  }, {
    "tStartMs": 560500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "My cousin walked up to the platform."
    } ]
  }, {
    "tStartMs": 562366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "So let's see which one is faster."
    } ]
  }, {
    "tStartMs": 566466,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Hello! Hello! Hahaha!"
    } ]
  }, {
    "tStartMs": 571600,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "We're almost at the top of the mountain now."
    } ]
  }, {
    "tStartMs": 574266,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "There's blue hour at 8 o'clock, and now it's 7:40."
    } ]
  }, {
    "tStartMs": 579200,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "We're riding a horse-drawn carriage right now."
    } ]
  }, {
    "tStartMs": 582266,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "We've been riding for 10 minutes."
    } ]
  }, {
    "tStartMs": 583700,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "It should be going pretty fast."
    } ]
  }, {
    "tStartMs": 585799,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "This carriage can only..."
    } ]
  }, {
    "tStartMs": 622500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "If you think this looks beautiful,"
    } ]
  }, {
    "tStartMs": 624266,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "there is a whole different kind of winter"
    } ]
  }, {
    "tStartMs": 626333,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "waiting further north."
    } ]
  }, {
    "tStartMs": 627866,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "\"Lindu Express\" and \"Lindu Express\" are two winter trains."
    } ]
  }, {
    "tStartMs": 631666,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "That take you deep"
    } ]
  }, {
    "tStartMs": 632799,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "into the snow-covered forest of Northeast China."
    } ]
  }, {
    "tStartMs": 635833,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Where everything turns white from the"
    } ]
  }, {
    "tStartMs": 638266,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "forests and mountains"
    } ]
  }, {
    "tStartMs": 639466,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "to the villages along the way."
    } ]
  }, {
    "tStartMs": 641566,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "We'll leave the details in the description below."
    } ]
  }, {
    "tStartMs": 643799,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "If you'd like to take a closer look."
    } ]
  }, {
    "tStartMs": 748866,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "They're all skewers, freshly skewered!"
    } ]
  }, {
    "tStartMs": 751166,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "Three lamb skewers, three."
    } ]
  }, {
    "tStartMs": 752700,
    "dDurationMs": 699,
    "segs": [ {
      "utf8": "There are ones with two,"
    } ]
  }, {
    "tStartMs": 753399,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "and ones with three."
    } ]
  }, {
    "tStartMs": 756133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Here's one."
    } ]
  }, {
    "tStartMs": 758000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "Excuse me, is this also a baked bun?"
    } ]
  }, {
    "tStartMs": 761566,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "This is a baked bun."
    } ]
  }, {
    "tStartMs": 762899,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "\"Yibazhua\" (a type of pastry)."
    } ]
  }, {
    "tStartMs": 763666,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 764299,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Hmph."
    } ]
  }, {
    "tStartMs": 767566,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "Is it lamb?"
    } ]
  }, {
    "tStartMs": 768500,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Or something else?"
    } ]
  }, {
    "tStartMs": 769733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Beef."
    } ]
  }, {
    "tStartMs": 773000,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 775733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Okay, hurry up."
    } ]
  }, {
    "tStartMs": 779600,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Three lamb skewers."
    } ]
  }, {
    "tStartMs": 782666,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "Are the three lamb skewers ready?"
    } ]
  }, {
    "tStartMs": 784700,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Just 5 minutes."
    } ]
  }, {
    "tStartMs": 787066,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "No need to grill it again, right?"
    } ]
  }, {
    "tStartMs": 788066,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Grill it."
    } ]
  }, {
    "tStartMs": 788766,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Get me one of those,"
    } ]
  }, {
    "tStartMs": 790666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "the sesame naan."
    } ]
  }, {
    "tStartMs": 791500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Ah.\nOne sesame naan."
    } ]
  }, {
    "tStartMs": 792600,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "One sesame naan."
    } ]
  }, {
    "tStartMs": 793366,
    "dDurationMs": 367,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 793733,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "Grill it."
    } ]
  }, {
    "tStartMs": 794466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 795533,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "OK."
    } ]
  }, {
    "tStartMs": 796200,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Is this one hot?"
    } ]
  }, {
    "tStartMs": 800466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "10 yuan for spicy strips, 10 yuan."
    } ]
  }, {
    "tStartMs": 804166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 805366,
    "dDurationMs": 4634,
    "segs": [ {
      "utf8": "Hahaha!"
    } ]
  }, {
    "tStartMs": 811166,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "Done eating. I got my numbers."
    } ]
  }, {
    "tStartMs": 815399,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Touristic it is."
    } ]
  }, {
    "tStartMs": 816866,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "You can still feel this festival atmosphere."
    } ]
  }, {
    "tStartMs": 820066,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "So everywhere,"
    } ]
  }, {
    "tStartMs": 821166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "everyone is coming with their family."
    } ]
  }, {
    "tStartMs": 823066,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "With the kids."
    } ]
  }, {
    "tStartMs": 824299,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "They really enjoy the snow."
    } ]
  }, {
    "tStartMs": 834166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "That area smells like barbecue."
    } ]
  }, {
    "tStartMs": 836799,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "So despite Hemu being a small village,"
    } ]
  }, {
    "tStartMs": 838966,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "you will find all kinds of restaurants."
    } ]
  }, {
    "tStartMs": 841466,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "For example, here."
    } ]
  }, {
    "tStartMs": 844266,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "KFC, Kentucky Fried Chicken."
    } ]
  }, {
    "tStartMs": 847600,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "And then you can also find"
    } ]
  }, {
    "tStartMs": 849833,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "all kinds of cafes, milk teas,"
    } ]
  }, {
    "tStartMs": 852766,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "restaurants, hot pot."
    } ]
  }, {
    "tStartMs": 854733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hello."
    } ]
  }, {
    "tStartMs": 857000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Try mine and see how it is."
    } ]
  }, {
    "tStartMs": 859500,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "If it's good,"
    } ]
  }, {
    "tStartMs": 860166,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "then I'll follow my recipe."
    } ]
  }, {
    "tStartMs": 861700,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Okay, let me taste yours first."
    } ]
  }, {
    "tStartMs": 863766,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 864799,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "You tell me what to add."
    } ]
  }, {
    "tStartMs": 866966,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "We are having a Kazakh milk tea"
    } ]
  }, {
    "tStartMs": 870466,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "with some butter."
    } ]
  }, {
    "tStartMs": 872533,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So you took some butter into the milk."
    } ]
  }, {
    "tStartMs": 877333,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Put some millet in for me."
    } ]
  }, {
    "tStartMs": 880966,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "This is fried millet."
