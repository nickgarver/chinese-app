  }, {
    "tStartMs": 882366,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 882799,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "It makes it more fragrant."
    } ]
  }, {
    "tStartMs": 883899,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 886200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "And also a little more."
    } ]
  }, {
    "tStartMs": 887933,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "No sugar at all—"
    } ]
  }, {
    "tStartMs": 888899,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "it's hard to drink."
    } ]
  }, {
    "tStartMs": 889700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I like it plain."
    } ]
  }, {
    "tStartMs": 891100,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "Really."
    } ]
  }, {
    "tStartMs": 891533,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "Mm, stir it for me."
    } ]
  }, {
    "tStartMs": 893299,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "You can always add more later."
    } ]
  }, {
    "tStartMs": 894766,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 895299,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "I believe you'll regret it."
    } ]
  }, {
    "tStartMs": 897466,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "You believe I'll regret it."
    } ]
  }, {
    "tStartMs": 900333,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "For dinner, we ordered a"
