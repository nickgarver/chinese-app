  }, {
    "tStartMs": 915299,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Look, there are horses over there!"
    } ]
  }, {
    "tStartMs": 916766,
    "dDurationMs": 1300,
    "segs": [ {
