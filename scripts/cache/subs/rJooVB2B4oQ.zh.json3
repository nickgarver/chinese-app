    "tStartMs": 427600,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "zhè lǐ yǒu yí gè xiǎo shuǐ chí\n这  里 有  一 个 小   水   池 "
    } ]
  }, {
    "tStartMs": 432400,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "zhè lǐ ne ， yǒu yí kuài bái bǎn\n这  里 呢 ， 有  一 块   白  板 "
    } ]
  }, {
    "tStartMs": 435233,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "shàng miàn yě yǒu yì xiē cài de míng zì\n上    面   也 有  一 些  菜  的 名   字"
    } ]
  }, {
    "tStartMs": 439066,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "zhè shì yí fèn shǒu xiě de cài dān\n这  是  一 份  手   写  的 菜  单 "
    } ]
  }, {
    "tStartMs": 450766,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "nóng cūn de fàn diàn dà bù fen dōu shì cháng zhè ge yàng zi de\n农   村  的 饭  店   大 部 分  都  是  长    这  个 样   子 的"
    } ]
  }, {
    "tStartMs": 455566,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "jiù shì zhuāng xiū kě yǐ bù piào liang\n就  是  装     修  可 以 不 漂   亮   "
    } ]
  }, {
    "tStartMs": 458366,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "dàn shì dōng xī yí dìng yào hǎo chī\n但  是  东   西 一 定   要  好  吃 "
    } ]
  }, {
    "tStartMs": 461233,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "guǎng dōng rén chū qù chī fàn\n广    东   人  出  去 吃  饭 "
    } ]
  }, {
    "tStartMs": 462533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "tā bú huì guǎn nǐ de huán jìng hǎo bu hǎo\n他 不 会  管   你 的 环   境   好  不 好 "
    } ]
  }, {
    "tStartMs": 464733,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "dàn shì tā yí dìng fēi cháng zài yì nǐ de wèi dào\n但  是  他 一 定   非  常    在  意 你 的 味  道 "
    } ]
  }, {
    "tStartMs": 471733,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "zhè lǐ jiù shì zhè ge fàn diàn de chú fáng lā\n这  里 就  是  这  个 饭  店   的 厨  房   啦"
    } ]
  }, {
    "tStartMs": 480033,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "zhè ge fàn diàn ne ， hái tí gōng miǎn fèi de tāng\n这  个 饭  店   呢 ， 还  提 供   免   费  的 汤  "
    } ]
  }, {
    "tStartMs": 483166,
    "dDurationMs": 5134,
    "segs": [ {
      "utf8": "suǒ yǐ nǐ kě yǐ ná zhe wǎn zài zhè biān pái duì shèng tāng\n所  以 你 可 以 拿 着  碗  在  这  边   排  队  盛    汤  "
    } ]
  }, {
    "tStartMs": 489133,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "tīng shuō zhè lǐ de tāng shì fēi cháng měi wèi de\n听   说   这  里 的 汤   是  非  常    美  味  的"
    } ]
  }, {
    "tStartMs": 491933,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "suǒ yǐ yǒu hěn duō rén pái duì\n所  以 有  很  多  人  排  队 "
    } ]
  }, {
    "tStartMs": 498366,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "dà jiā kàn ， xiàn zài yǐ jīng zuò mǎn le pái duì de rén\n大 家  看  ， 现   在  已 经   坐  满  了 排  队  的 人 "
    } ]
  }, {
    "tStartMs": 505600,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "tā zhè ge fàn guǎn yǒu èr lóu\n他 这  个 饭  馆   有  二 楼 "
