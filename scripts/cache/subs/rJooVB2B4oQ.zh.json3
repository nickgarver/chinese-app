  }, {
    "tStartMs": 550133,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "dàn shì ne ， èr lóu de yōu diǎn jiù shì tā de jǐng sè bǐ jiào měi\n但  是  呢 ， 二 楼  的 优  点   就  是  它 的 景   色 比 较   美 "
    } ]
  }, {
    "tStartMs": 557033,
    "dDurationMs": 4600,
    "segs": [ {
