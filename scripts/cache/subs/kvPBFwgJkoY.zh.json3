{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "水开了"
    } ]
  }, {
    "tStartMs": 1166,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "你能闻到硫磺味"
    } ]
  }, {
    "tStartMs": 8199,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我来之前就听说"
    } ]
  }, {
    "tStartMs": 10266,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "腾冲有很多温泉"
    } ]
  }, {
    "tStartMs": 12866,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "据说有八十八处温泉"
    } ]
  }, {
    "tStartMs": 15566,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "和九十九座火山"
    } ]
  }, {
    "tStartMs": 18800,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "今天我们要前往中国最"
    } ]
  }, {
    "tStartMs": 21166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "迷人的火山地貌之一"
    } ]
  }, {
    "tStartMs": 23166,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "腾冲"
    } ]
  }, {
    "tStartMs": 23899,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "紧邻缅甸边境"
    } ]
  }, {
    "tStartMs": 26266,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "这也许是我去过最放松的"
    } ]
  }, {
    "tStartMs": 28899,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "目的地"
    } ]
  }, {
    "tStartMs": 30533,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我们穿越了亚洲的火山群"
    } ]
  }, {
    "tStartMs": 32700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "享受了一些很棒的美食"
    } ]
  }, {
    "tStartMs": 34366,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "在温泉里煮了鸡蛋"
    } ]
  }, {
    "tStartMs": 36133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "还泡在"
    } ]
  }, {
    "tStartMs": 37266,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "温暖的水中"
    } ]
  }, {
    "tStartMs": 37966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "看着云朵飘过"
    } ]
  }, {
    "tStartMs": 46666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 48200,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "对，包完全湿透了"
    } ]
  }, {
    "tStartMs": 53000,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "但电池、遥控器和无人机都没事"
    } ]
  }, {
    "tStartMs": 55399,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "所以我们真的非常非常幸运"
    } ]
  }, {
    "tStartMs": 59766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "第二天早上"
    } ]
  }, {
    "tStartMs": 62566,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我刚从酒店出来"
    } ]
  }, {
    "tStartMs": 64066,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "然后我发现整个晚上"
    } ]
  }, {
    "tStartMs": 66700,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "无人机就一直放在座椅这里"
    } ]
  }, {
    "tStartMs": 70566,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "但没有人拿走它"
    } ]
  }, {
    "tStartMs": 72066,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "真的是，哇"
    } ]
  }, {
    "tStartMs": 73500,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "这个无人机值大概三千美元"
    } ]
  }, {
    "tStartMs": 77733,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我很高兴它还在"
    } ]
  }, {
    "tStartMs": 80133,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "而且昨天下过雨"
    } ]
  }, {
    "tStartMs": 82099,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "无人机还能用，我们算很幸运了"
    } ]
  }, {
    "tStartMs": 85333,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "虽然我们的包现在挺湿的"
    } ]
  }, {
    "tStartMs": 117099,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "嗨，大家早上好"
    } ]
  }, {
    "tStartMs": 118466,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "欢迎回到我们的频道"
    } ]
  }, {
    "tStartMs": 120766,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "现在我们在一个本地市场"
    } ]
  }, {
    "tStartMs": 122799,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "在中国的最南端"
    } ]
  }, {
    "tStartMs": 124533,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "在云南南部"
    } ]
  }, {
    "tStartMs": 125666,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "在一个边境城市"
    } ]
  }, {
    "tStartMs": 127566,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "今天早上我们醒来"
    } ]
  }, {
    "tStartMs": 129300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "然后决定在这个早上"
    } ]
  }, {
    "tStartMs": 130400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "吃个早餐"
    } ]
  }, {
    "tStartMs": 132133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "在开车去火山和温泉之前"
    } ]
  }, {
    "tStartMs": 134466,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "逛一下市场"
    } ]
  }, {
    "tStartMs": 136133,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "今天下雨"
    } ]
  }, {
    "tStartMs": 137300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "所以人少一些"
    } ]
  }, {
    "tStartMs": 138366,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "但还是非常非常热闹"
    } ]
  }, {
    "tStartMs": 140866,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "很多人在这里"
    } ]
  }, {
    "tStartMs": 142599,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "想尝尝当地的美食"
    } ]
  }, {
    "tStartMs": 145500,
    "dDurationMs": 599,
    "segs": [ {
      "utf8": "也在看"
    } ]
  }, {
    "tStartMs": 146099,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "市场上都有什么"
    } ]
  }, {
    "tStartMs": 150400,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "外国人多吗"
    } ]
  }, {
    "tStartMs": 151566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "不多"
    } ]
  }, {
    "tStartMs": 152666,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "也有的"
    } ]
  }, {
    "tStartMs": 153366,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "俄罗斯的"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "跟你长的也一样"
    } ]
  }, {
    "tStartMs": 155900,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我们正在吃的是"
    } ]
  }, {
    "tStartMs": 158033,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "一种非常独特的云南奶酪"
    } ]
  }, {
    "tStartMs": 160199,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "像是一块干马苏里拉奶酪"
    } ]
  }, {
    "tStartMs": 163333,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "然后烤制"
    } ]
  }, {
    "tStartMs": 165699,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "你可以放玫瑰酱"
    } ]
  }, {
    "tStartMs": 167666,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "或者巧克力，如果你喜欢的话"
    } ]
  }, {
    "tStartMs": 172599,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "白族的小吃"
    } ]
  }, {
    "tStartMs": 173933,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "白族的，嗯"
    } ]
  }, {
    "tStartMs": 181133,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "谢谢"
    } ]
  }, {
    "tStartMs": 181966,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "谢谢"
    } ]
  }, {
    "tStartMs": 182466,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "你付过钱了吗"
    } ]
  }, {
    "tStartMs": 183199,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "付了"
    } ]
  }, {
    "tStartMs": 184199,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "哦，哇哇"
    } ]
  }, {
    "tStartMs": 186199,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "看看这个，我今天的早餐"
    } ]
  }, {
    "tStartMs": 189500,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "有点像哈鲁米奶酪"
    } ]
  }, {
    "tStartMs": 191400,
    "dDurationMs": 466,
    "segs": [ {
      "utf8": "我觉得"
    } ]
  }, {
    "tStartMs": 191866,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "里面夹了巧克力"
    } ]
  }, {
    "tStartMs": 193233,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "和玫瑰花酱"
    } ]
  }, {
    "tStartMs": 196099,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 203300,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "那是腾冲的特色菜"
    } ]
  }, {
    "tStartMs": 205599,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "香茅草烤鱼"
    } ]
  }, {
    "tStartMs": 206400,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "就是用当地的一种香草烤的鱼"
    } ]
  }, {
    "tStartMs": 209500,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "真的很香"
    } ]
  }, {
    "tStartMs": 214466,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "这些鱼一烤好"
    } ]
  }, {
    "tStartMs": 216166,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "就会被卖光"
    } ]
  }, {
    "tStartMs": 217300,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "大家都很喜欢这种鱼"
    } ]
  }, {
    "tStartMs": 225233,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "这个市场非常本土化"
    } ]
  }, {
    "tStartMs": 226566,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "有各种各样的东西"
    } ]
  }, {
    "tStartMs": 228266,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "比如有玉石"
    } ]
  }, {
    "tStartMs": 231000,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "还有中药材"
    } ]
  }, {
    "tStartMs": 233633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "蔬菜、水果"
    } ]
  }, {
    "tStartMs": 235466,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "还有本地小吃，哇"
    } ]
  }, {
    "tStartMs": 239433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "看看这个"
    } ]
  }, {
    "tStartMs": 240533,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "那是一朵荷花"
    } ]
  }, {
    "tStartMs": 242400,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "不，我觉得是莲藕"
    } ]
  }, {
    "tStartMs": 245633,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这个是烟草"
    } ]
  }, {
    "tStartMs": 248033,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "纯天然的"
    } ]
  }, {
    "tStartMs": 249066,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "多少钱一袋"
    } ]
  }, {
    "tStartMs": 249800,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "五块一袋"
    } ]
  }, {
    "tStartMs": 250966,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "行，要一袋"
    } ]
  }, {
    "tStartMs": 252000,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "一个就行了"
    } ]
  }, {
    "tStartMs": 252866,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我尝尝，没吃过"
    } ]
  }, {
    "tStartMs": 254566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "随便拿一袋都可以"
    } ]
  }, {
    "tStartMs": 255566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "随便拿一袋"
    } ]
  }, {
    "tStartMs": 257666,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "她说这叫野地瓜"
    } ]
  }, {
    "tStartMs": 259933,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "也就是地瓜"
    } ]
  }, {
    "tStartMs": 262366,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我在社交媒体上见过很多次"
    } ]
  }, {
    "tStartMs": 264733,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "但这是我第一次"
    } ]
  }, {
    "tStartMs": 265800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "准备尝一尝"
    } ]
  }, {
    "tStartMs": 266833,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "它长这样"
    } ]
  }, {
    "tStartMs": 268133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "要不要尝尝"
    } ]
  }, {
    "tStartMs": 269366,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "不用不用"
    } ]
  }, {
    "tStartMs": 270866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "谢谢"
    } ]
  }, {
    "tStartMs": 274000,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "它看起来其实是"
    } ]
  }, {
    "tStartMs": 276199,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "对，像无花果一样"
    } ]
  }, {
    "tStartMs": 277333,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 277633,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "他们不吃啊"
    } ]
  }, {
    "tStartMs": 278566,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "吃点"
    } ]
  }, {
    "tStartMs": 279133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 281233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 282966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 284566,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "比无花果的水果味更浓"
    } ]
  }, {
    "tStartMs": 287166,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "不是很甜"
    } ]
  }, {
    "tStartMs": 288199,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "是酸甜的，很好吃"
    } ]
  }, {
    "tStartMs": 292033,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "西瓜"
    } ]
  }, {
    "tStartMs": 292633,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "五块，五块"
    } ]
  }, {
    "tStartMs": 293333,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "要不要嘛"
    } ]
  }, {
    "tStartMs": 294733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "不要"
    } ]
  }, {
    "tStartMs": 296199,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "宝宝"
    } ]
  }, {
    "tStartMs": 296800,
    "dDurationMs": 399,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 297199,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "这市场里的东西你认识多少"
    } ]
  }, {
    "tStartMs": 300066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "大概一半吧"
    } ]
  }, {
    "tStartMs": 301333,
    "dDurationMs": 267,
    "segs": [ {
      "utf8": "真的吗"
    } ]
  }, {
    "tStartMs": 301600,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "我觉得是的"
    } ]
  }, {
    "tStartMs": 303399,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "有很多东西我都没吃过"
    } ]
  }, {
    "tStartMs": 305233,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我其实不知道那是什么"
    } ]
  }, {
    "tStartMs": 307566,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "老板，给我来一份这个米线吧"
    } ]
  }, {
    "tStartMs": 309833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好的"
    } ]
  }, {
    "tStartMs": 310800,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "小锅米线吗"
    } ]
  }, {
    "tStartMs": 311633,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 314466,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "这是最典型的云南早餐"
    } ]
  }, {
    "tStartMs": 316533,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "小锅米线"
    } ]
  }, {
    "tStartMs": 317233,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "它是，嗯"
    } ]
  }, {
    "tStartMs": 319033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "像一个小铜锅"
    } ]
  }, {
    "tStartMs": 320600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "然后他们把米线放进去"
    } ]
  }, {
    "tStartMs": 322866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我吃红米线"
    } ]
  }, {
    "tStartMs": 329966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "多少钱"
    } ]
  }, {
    "tStartMs": 330966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "十二"
    } ]
  }, {
    "tStartMs": 331600,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "好的"
    } ]
  }, {
    "tStartMs": 341800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "呃"
    } ]
  }, {
    "tStartMs": 343800,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "这碗米线里有很嫩滑的豆腐"
    } ]
  }, {
    "tStartMs": 350399,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "嗯嗯"
    } ]
  }, {
    "tStartMs": 353633,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "这碗米线里的豆腐"
    } ]
  }, {
    "tStartMs": 355666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "特别顺滑细腻"
    } ]
  }, {
    "tStartMs": 361000,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "老板是我在中国见到的第一个阿昌族"
    } ]
  }, {
    "tStartMs": 364600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "他全中国就四万左右嘛"
    } ]
  }, {
    "tStartMs": 366666,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 367366,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "他们主要住在什么地方"
    } ]
  }, {
    "tStartMs": 369533,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "阿昌族"
    } ]
  }, {
    "tStartMs": 370199,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "他们主要聚集在三个地方"
    } ]
  }, {
    "tStartMs": 373366,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "一个梁河"
    } ]
  }, {
    "tStartMs": 374133,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "一个腾冲"
    } ]
  }, {
    "tStartMs": 374800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "一个陇川"
    } ]
  }, {
    "tStartMs": 376000,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "哦，都是在云南"
    } ]
  }, {
    "tStartMs": 377533,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 378233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那阿昌族有什么自己的风俗吗"
    } ]
  }, {
    "tStartMs": 380166,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "特别的"
    } ]
  }, {
    "tStartMs": 380766,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "有，他们过一个阿露窝罗节"
    } ]
  }, {
    "tStartMs": 383399,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 385133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊，然后"
    } ]
  }, {
    "tStartMs": 387399,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "他们有特色"
    } ]
  }, {
    "tStartMs": 388066,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "放在手上吃的"
    } ]
  }, {
    "tStartMs": 391366,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "他们的手艺是打刀"
    } ]
  }, {
    "tStartMs": 393166,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "是中国四大名刀之一"
    } ]
  }, {
    "tStartMs": 395399,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 396433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "大姐你也是阿昌族的"
    } ]
  }, {
    "tStartMs": 397966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 398866,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "我也是"
    } ]
  }, {
    "tStartMs": 399366,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "我们的阿昌米线"
    } ]
  }, {
    "tStartMs": 401600,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "这个上热门了呢，你看"
    } ]
  }, {
    "tStartMs": 403766,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "十一万六千"
    } ]
  }, {
    "tStartMs": 404966,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 405366,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "播放量"
    } ]
  }, {
    "tStartMs": 406133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦哇"
    } ]
  }, {
    "tStartMs": 407166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这个半生不熟的肉"
    } ]
  }, {
    "tStartMs": 409366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "火烧猪肉"
    } ]
  }, {
    "tStartMs": 410366,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 410966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "这里的人真的非常热情"
    } ]
  }, {
    "tStartMs": 413000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "一旦我们开始和他们聊天"
    } ]
  }, {
    "tStartMs": 414833,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "问他们关于食物的事情"
    } ]
  }, {
    "tStartMs": 416000,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "他们会给你讲整个来龙去脉"
    } ]
  }, {
    "tStartMs": 417933,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "他们真的愿意花时间在你身上"
    } ]
  }, {
    "tStartMs": 420933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "好了，现在我们准备再次出发"
    } ]
  }, {
    "tStartMs": 424566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "回来"
    } ]
  }, {
    "tStartMs": 425766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "干嘛"
    } ]
  }, {
    "tStartMs": 427533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "嗯，开你的 TeamSpeak"
    } ]
  }, {
    "tStartMs": 431666,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "我不想开"
    } ]
  }, {
    "tStartMs": 433199,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "为什么"
    } ]
  }, {
    "tStartMs": 434033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "因为你讲话太多了"
    } ]
  }, {
    "tStartMs": 435600,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "有点烦人"
    } ]
  }, {
    "tStartMs": 438000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "烦人"
    } ]
  }, {
    "tStartMs": 438866,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "走"
    } ]
  }, {
    "tStartMs": 440966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "现在我们要去找"
    } ]
  }, {
    "tStartMs": 442433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "火山和温泉"
    } ]
  }, {
    "tStartMs": 443966,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "我读到腾冲有超过九十处温泉"
    } ]
  }, {
    "tStartMs": 448199,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "而且它是中国火山最多的城市"
    } ]
  }, {
    "tStartMs": 451600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "还有最年轻的火山"
    } ]
  }, {
    "tStartMs": 453833,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "我记得最近的一次喷发"
    } ]
  }, {
    "tStartMs": 457533,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "大概是在四千年前左右"
    } ]
  }, {
    "tStartMs": 547000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我们刚把无人机飞起来"
    } ]
  }, {
    "tStartMs": 549433,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那些小山丘都是"
    } ]
  }, {
    "tStartMs": 551799,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "它们过去是活火山"
    } ]
  }, {
    "tStartMs": 554966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "但在很多很多年前"
    } ]
  }, {
    "tStartMs": 558666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嘿"
    } ]
  }, {
    "tStartMs": 561533,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "虽然这里的火山"
    } ]
  }, {
    "tStartMs": 563133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "早已进入休眠状态"
    } ]
  }, {
    "tStartMs": 564200,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "地表之下仍然有大量的热量"
    } ]
  }, {
    "tStartMs": 565966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "残留在地底"
    } ]
  }, {
    "tStartMs": 567533,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "感觉就像地下的天然高压锅"
    } ]
  }, {
    "tStartMs": 570466,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "在一些地方"
    } ]
  }, {
    "tStartMs": 571733,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "滚烫的热水不断地冒着泡"
    } ]
  }, {
    "tStartMs": 574500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "并从地面喷涌而出"
    } ]
  }, {
    "tStartMs": 578633,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "哦哇"
    } ]
  }, {
    "tStartMs": 579333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "好热啊"
    } ]
  }, {
    "tStartMs": 582399,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "热死了"
    } ]
  }, {
    "tStartMs": 583200,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "热得让人难以靠近"
    } ]
  }, {
    "tStartMs": 600066,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "烫吗"
    } ]
  }, {
    "tStartMs": 600766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好热"
    } ]
  }, {
    "tStartMs": 602066,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "真的很烫"
    } ]
  }, {
    "tStartMs": 602633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "好烫"
    } ]
  }, {
    "tStartMs": 604866,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "水是沸腾的，但挺干净的"
    } ]
  }, {
    "tStartMs": 606833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "如果你想的话，甚至可以用它泡茶"
    } ]
  }, {
    "tStartMs": 611000,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "对，确实非常烫"
    } ]
  }, {
    "tStartMs": 618033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "嗯，挺好的"
    } ]
  }, {
    "tStartMs": 620033,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "相当烫"
    } ]
  }, {
    "tStartMs": 621600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "估计大概七十度左右"
    } ]
  }, {
    "tStartMs": 623933,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "这里也在沸腾"
    } ]
  }, {
    "tStartMs": 630566,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "所以腾冲相当独特"
    } ]
  }, {
    "tStartMs": 632066,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "因为在这里"
    } ]
  }, {
    "tStartMs": 633633,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "你既能找到火山，也能找到很多温泉"
    } ]
  }, {
    "tStartMs": 637466,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "原因是它处在一个非常独特的"
    } ]
  }, {
    "tStartMs": 640633,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "位置，位于"
    } ]
  }, {
    "tStartMs": 643966,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "印度板块和欧亚板块的碰撞带上"
    } ]
  }, {
    "tStartMs": 647133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "所以当这两个板块碰撞时"
    } ]
  }, {
    "tStartMs": 650266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "它们不仅造出了山脉"
    } ]
  }, {
    "tStartMs": 652833,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "还形成了很多温泉"
    } ]
  }, {
    "tStartMs": 657166,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "因为地底下"
    } ]
  }, {
    "tStartMs": 658399,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "就像一个熔炉"
    } ]
  }, {
    "tStartMs": 659633,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "地质活动非常活跃"
    } ]
  }, {
    "tStartMs": 660866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "而这些热量"
    } ]
  }, {
    "tStartMs": 662600,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "熔化的岩石不断"
    } ]
  }, {
    "tStartMs": 664833,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "把地下水加热"
    } ]
  }, {
    "tStartMs": 669466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "在入口处"
    } ]
  }, {
    "tStartMs": 670333,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "你可以买鸡蛋"
    } ]
  }, {
    "tStartMs": 671266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "然后在这个大蒸锅里"
    } ]
  }, {
    "tStartMs": 673133,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "你可以免费蒸熟"
    } ]
  }, {
    "tStartMs": 674933,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "就在它旁边是"
    } ]
  }, {
    "tStartMs": 677600,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "腾冲最有名的温泉"
    } ]
  }, {
    "tStartMs": 679899,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "在腾冲"
    } ]
  }, {
    "tStartMs": 680633,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "叫热海大滚锅"
    } ]
  }, {
    "tStartMs": 681899,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "它常年沸腾"
    } ]
  }, {
    "tStartMs": 686933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "蒸汽非常浓"
    } ]
  }, {
    "tStartMs": 719366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "橙汁多少钱一杯啊"
    } ]
  }, {
    "tStartMs": 720233,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "十五元一杯"
    } ]
  }, {
    "tStartMs": 721399,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "好的，要一杯"
    } ]
  }, {
    "tStartMs": 724266,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "这边可以买鸡蛋煮吗"
    } ]
  }, {
    "tStartMs": 725933,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "可以啊"
    } ]
  }, {
    "tStartMs": 726666,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "多少钱啊"
    } ]
  }, {
    "tStartMs": 727366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "两块钱一个"
    } ]
  }, {
    "tStartMs": 728433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "帮我拿两个鸡蛋呗"
    } ]
  }, {
    "tStartMs": 732366,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "好的，两个鸡蛋"
    } ]
  }, {
    "tStartMs": 734433,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "十分钟就行"
    } ]
  }, {
    "tStartMs": 735533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "煮十分钟"
    } ]
  }, {
    "tStartMs": 736366,
    "dDurationMs": 267,
    "segs": [ {
      "utf8": "多少钱"
    } ]
  }, {
    "tStartMs": 736633,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 737666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 740366,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "硫磺泉，看"
    } ]
  }, {
    "tStartMs": 744399,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "来腾冲之前"
    } ]
  }, {
    "tStartMs": 745933,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我听说有很多温泉"
    } ]
  }, {
    "tStartMs": 749066,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "有高档的，也有野生的"
    } ]
  }, {
    "tStartMs": 752433,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "很多村子其实都有温泉"
    } ]
  }, {
    "tStartMs": 756466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我刚拿到了鸡蛋"
    } ]
  }, {
    "tStartMs": 759799,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "因为发现了这个池子"
    } ]
  }, {
    "tStartMs": 762033,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "硫磺泉"
    } ]
  }, {
    "tStartMs": 763233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "七十一度"
    } ]
  }, {
    "tStartMs": 764666,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "所以你可以把鸡蛋"
    } ]
  }, {
    "tStartMs": 766100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "放进温泉里煮"
    } ]
  }, {
    "tStartMs": 768766,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "这里是石墙野温泉"
    } ]
  }, {
    "tStartMs": 771766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "看，水在沸腾"
    } ]
  }, {
    "tStartMs": 773633,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "你能闻到硫磺味"
    } ]
  }, {
    "tStartMs": 776166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "妈妈"
    } ]
  }, {
    "tStartMs": 787066,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "那显然是最热的"
    } ]
  }, {
    "tStartMs": 788966,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "七十一度"
    } ]
  }, {
    "tStartMs": 790366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "水流到这里"
    } ]
  }, {
    "tStartMs": 792533,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "让我试试这个池子"
    } ]
  }, {
    "tStartMs": 795733,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "嗯，这个相当热"
    } ]
  }, {
    "tStartMs": 798466,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "这个相当热"
    } ]
  }, {
    "tStartMs": 800633,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "你肯定不能在里面待太久"
    } ]
  }, {
    "tStartMs": 804366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "好，这个稍微暖和一点"
    } ]
  }, {
    "tStartMs": 808399,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "那个真的很烫，是的"
    } ]
  }, {
    "tStartMs": 810466,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "这位大叔告诉我这个有六十度"
    } ]
  }, {
    "tStartMs": 815000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这个应该是六十八度"
    } ]
  }, {
    "tStartMs": 818466,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "哦，我记得我们在塔吉克斯坦的时候"
    } ]
  }, {
    "tStartMs": 822299,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "在 Fatima 温泉"
    } ]
  }, {
    "tStartMs": 824700,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "泡完之后我累得不行"
    } ]
  }, {
    "tStartMs": 827833,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "泡热水的时候经常这样"
    } ]
  }, {
    "tStartMs": 829766,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "泡热水澡经常会这样"
    } ]
  }, {
    "tStartMs": 833233,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "哦，这是真的"
    } ]
  }, {
    "tStartMs": 834833,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "妈妈"
    } ]
  }, {
    "tStartMs": 837866,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "妈妈不见了"
    } ]
  }, {
    "tStartMs": 840799,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "这个池子的温度"
    } ]
  }, {
    "tStartMs": 844233,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "越往那一头走，温度会稍微升高"
    } ]
  }, {
    "tStartMs": 850033,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "你可以看到气泡从"
    } ]
  }, {
    "tStartMs": 852399,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "池底冒出来"
    } ]
  }, {
    "tStartMs": 854700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "那就是泉水"
    } ]
  }, {
    "tStartMs": 864399,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "这里真的很暖和"
    } ]
  }, {
    "tStartMs": 867066,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "过了一会儿我开始出汗了"
    } ]
  }, {
    "tStartMs": 876399,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "过了一会儿我真的开始出汗了"
    } ]
  }, {
    "tStartMs": 878899,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "当你靠近池子的那一边时"
    } ]
  }, {
    "tStartMs": 881433,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "真的挺烫的"
    } ]
  }, {
    "tStartMs": 883866,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "水从底部往上冒泡"
    } ]
  }, {
    "tStartMs": 886866,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "我刚拿了一个小桶"
    } ]
  }, {
    "tStartMs": 888633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "可以往脸上泼水"
    } ]
  }, {
    "tStartMs": 891766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "现在来看看鸡蛋怎么样了"
    } ]
  }, {
    "tStartMs": 895000,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "阳说最左边的是我们的"
    } ]
  }, {
    "tStartMs": 901433,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "其实不太确定"
    } ]
  }, {
    "tStartMs": 902500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "我觉得是这个"
    } ]
  }, {
    "tStartMs": 907666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "好，来吧"
    } ]
  }, {
    "tStartMs": 913766,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "哪个是我们的"
    } ]
  }, {
    "tStartMs": 919899,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "嘿，宝宝"
    } ]
  }, {
    "tStartMs": 921700,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "蛋，蛋煮好了"
    } ]
  }, {
    "tStartMs": 923866,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "谢谢"
    } ]
  }, {
    "tStartMs": 927833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "舒服吗"
    } ]
  }, {
    "tStartMs": 931233,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "我真的很敏感"
    } ]
  }, {
    "tStartMs": 932500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "我觉得我需要"
    } ]
  }, {
    "tStartMs": 934033,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "几分钟来适应"
    } ]
  }, {
    "tStartMs": 935566,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "这么高的水温"
    } ]
  }, {
    "tStartMs": 937066,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "对，好像"
    } ]
  }, {
    "tStartMs": 938066,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我觉得男人和女人对水温的"
    } ]
  }, {
    "tStartMs": 940466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "喜好真的很不一样"
    } ]
  }, {
    "tStartMs": 942933,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "对我来说这个还好"
    } ]
  }, {
    "tStartMs": 944133,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "不是特别烫"
    } ]
  }, {
    "tStartMs": 945833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那你呢"
    } ]
  }, {
    "tStartMs": 946966,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "对我来说已经是极限了，我会说"
    } ]
  }, {
    "tStartMs": 949866,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "但这是"
    } ]
  }, {
    "tStartMs": 950500,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "我想我得适应一下"
    } ]
  }, {
    "tStartMs": 952766,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "你知道我洗热水澡的时候"
    } ]
  }, {
    "tStartMs": 954166,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "需要一点时间"
    } ]
  }, {
    "tStartMs": 955200,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "才能慢慢把温度调高"
    } ]
  }, {
    "tStartMs": 957899,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "我一开始会用偏凉的水"
    } ]
  }, {
    "tStartMs": 959133,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "然后慢慢"
    } ]
  }, {
    "tStartMs": 960500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "逐步提高温度"
    } ]
  }, {
    "tStartMs": 967233,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "哇，这个是"
    } ]
  }, {
    "tStartMs": 971466,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "我来之前就听说"
    } ]
  }, {
    "tStartMs": 973833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "腾冲有很多温泉"
    } ]
  }, {
    "tStartMs": 976033,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "据说有八十八处温泉"
    } ]
  }, {
    "tStartMs": 978533,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "和九十九座火山"
    } ]
  }, {
    "tStartMs": 980833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "当我在地图上查找"
    } ]
  }, {
    "tStartMs": 983500,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "温泉的时候"
    } ]
  }, {
    "tStartMs": 984533,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我真的看到了很多"
    } ]
  }, {
    "tStartMs": 985633,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "有些村子有很多温泉度假村"
    } ]
  }, {
    "tStartMs": 989700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "而另一些则有那种野生的公共温泉"
    } ]
  }, {
    "tStartMs": 998933,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这太棒了"
    } ]
  }, {
    "tStartMs": 1004066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "我会在池子里多待一会儿"
    } ]
  }, {
    "tStartMs": 1007533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "我开始出很多汗了"
    } ]
  }, {
    "tStartMs": 1035533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "你好"
    } ]
  }, {
    "tStartMs": 1036900,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "请问这个是什么呀"
    } ]
  }, {
    "tStartMs": 1038566,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "艾草泡脚"
    } ]
  }, {
    "tStartMs": 1039866,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "艾蒿泡脚"
    } ]
  }, {
    "tStartMs": 1040866,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "哦，泡脚的"
    } ]
  }, {
    "tStartMs": 1051766,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 1063200,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "这绝对是我在中国"
    } ]
  }, {
    "tStartMs": 1065299,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "最独特的用餐体验"
    } ]
  }, {
    "tStartMs": 1067500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "整个环境都在大自然中"
    } ]
  }, {
    "tStartMs": 1070900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "有一条非常清澈的河流"
    } ]
  }, {
    "tStartMs": 1073633,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "还有无限供应的水果"
    } ]
  }, {
    "tStartMs": 1077900,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "然后这里是蒸锅"
    } ]
  }, {
    "tStartMs": 1082133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "好，我们得找个地方住"
    } ]
  }, {
    "tStartMs": 1087433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇哦"
    } ]
  }, {
    "tStartMs": 1089099,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "哇哦，那些串串好大"
    } ]
  }, {
    "tStartMs": 1093299,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我觉得那是我见过的"
    } ]
  }, {
    "tStartMs": 1095299,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "最大的串串"
    } ]
  }, {
    "tStartMs": 1111633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "他们把所有的食物都端上桌"
    } ]
  }, {
    "tStartMs": 1113766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我们有一个火锅"
    } ]
  }, {
    "tStartMs": 1115833,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "小火锅"
    } ]
  }, {
    "tStartMs": 1116700,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "米饭，还有新鲜蔬菜"
    } ]
  }, {
    "tStartMs": 1120433,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "那是蒸蛋"
    } ]
  }, {
    "tStartMs": 1121733,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "还有香菇蒸肉丸"
    } ]
  }, {
    "tStartMs": 1125599,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "粉蒸肉"
    } ]
  }, {
    "tStartMs": 1127233,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "蒸南瓜"
    } ]
  }, {
    "tStartMs": 1128200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦哇"
    } ]
  }, {
    "tStartMs": 1129533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "请问这个是什么呀"
    } ]
  }, {
    "tStartMs": 1130933,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "傣味排骨"
    } ]
  }, {
    "tStartMs": 1131900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "哦，傣味排骨"
    } ]
  }, {
    "tStartMs": 1132833,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 1133133,
    "dDurationMs": 267,
    "segs": [ {
      "utf8": "行"
    } ]
  }, {
    "tStartMs": 1133400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "酸辣口味"
    } ]
  }, {
    "tStartMs": 1134400,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "好的，给我一块就行了"
    } ]
  }, {
    "tStartMs": 1135966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯，好"
    } ]
  }, {
    "tStartMs": 1138133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我们桌上摆了好多"
    } ]
  }, {
    "tStartMs": 1139566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "而且不断有人过来"
    } ]
  }, {
    "tStartMs": 1141133,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "给我们上不同的菜"
    } ]
  }, {
    "tStartMs": 1144133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "这个自助餐是"
    } ]
  }, {
    "tStartMs": 1146033,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "您好，这个皮冻要不要尝一下"
    } ]
  }, {
    "tStartMs": 1148133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好的"
    } ]
  }, {
    "tStartMs": 1149833,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "这个是那个皮皮熬的"
    } ]
  }, {
    "tStartMs": 1153099,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "猪皮吗"
    } ]
  }, {
    "tStartMs": 1153766,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 1154233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 1155200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "都是胶原蛋白"
    } ]
  }, {
    "tStartMs": 1156400,
    "dDurationMs": 566,
    "segs": [ {
      "utf8": "好的，谢谢"
    } ]
  }, {
    "tStartMs": 1156966,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "可以了，可以了，可以了"
    } ]
  }, {
    "tStartMs": 1157933,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "再来两块吧"
    } ]
  }, {
    "tStartMs": 1158700,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "啊哈哈，好的，谢谢"
    } ]
  }, {
    "tStartMs": 1159433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "多吃点，一定要吃好啊"
    } ]
  }, {
    "tStartMs": 1161433,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "嗯，这是用猪肉"
    } ]
  }, {
    "tStartMs": 1164366,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "猪皮做的，所以是猪皮冻，哇"
    } ]
  }, {
    "tStartMs": 1169766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "我们桌上摆了很多"
    } ]
  }, {
    "tStartMs": 1171233,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "而且不断有人过来"
    } ]
  }, {
    "tStartMs": 1172966,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "给我们更多的食物"
    } ]
  }, {
    "tStartMs": 1176133,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "能再给我们一块吗"
    } ]
  }, {
    "tStartMs": 1177233,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "这一小块"
    } ]
  }, {
    "tStartMs": 1178700,
    "dDurationMs": 466,
    "segs": [ {
      "utf8": "这块"
    } ]
  }, {
    "tStartMs": 1179166,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 1179566,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "可以，可以，可以，可以"
    } ]
  }, {
    "tStartMs": 1180700,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "食物没有很重的香料"
    } ]
  }, {
    "tStartMs": 1184000,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "但都是当地的食材"
    } ]
  }, {
    "tStartMs": 1185599,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "所以非常非常好吃"
    } ]
  }, {
    "tStartMs": 1187933,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "说实话"
    } ]
  }, {
    "tStartMs": 1188799,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "这个地方可能是"
    } ]
  }, {
    "tStartMs": 1190099,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "最棒的就餐地点之一"
    } ]
  }, {
    "tStartMs": 1192299,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "食物的选择已经很棒了"
    } ]
  }, {
    "tStartMs": 1194733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "整个环境也让人神清气爽"
    } ]
  }, {
    "tStartMs": 1197133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "是在户外"
    } ]
  }, {
    "tStartMs": 1198000,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "有点像野餐"
    } ]
  }, {
    "tStartMs": 1199633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "这里有水"
    } ]
  }, {
    "tStartMs": 1200633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "有孩子在旁边玩"
    } ]
  }, {
    "tStartMs": 1203033,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "你坐在那些小椅子上"
    } ]
  }, {
    "tStartMs": 1204866,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "超级舒服"
    } ]
  }, {
    "tStartMs": 1207000,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "环境真的很棒"
    } ]
  }, {
    "tStartMs": 1208633,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "哦，我吃不下了"
    } ]
  }, {
    "tStartMs": 1209566,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "谢谢你"
    } ]
  }, {
    "tStartMs": 1210099,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "那我待会给你们提"
    } ]
  }, {
    "tStartMs": 1211233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好的"
    } ]
  }, {
    "tStartMs": 1339333,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "因为这次"
    } ]
  }, {
    "tStartMs": 1340799,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "我们的时间非常有限"
    } ]
  }, {
    "tStartMs": 1343099,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "否则我们真的很想开车去芒市"
    } ]
  }, {
    "tStartMs": 1346733,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "有人告诉我那里有"
    } ]
  }, {
    "tStartMs": 1348633,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "云南省最好吃的美食"
    } ]
  }, {
    "tStartMs": 1351299,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "但我想这个就留到"
    } ]
  }, {
    "tStartMs": 1352733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "下次吧"
    } ]
  }, {
    "tStartMs": 1353900,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "希望大家喜欢今天的视频"
    } ]
  }, {
    "tStartMs": 1356366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "感谢观看"
    } ]
  }, {
    "tStartMs": 1357299,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "也许在下一期"
    } ]
  }, {
    "tStartMs": 1359233,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "我们会在另一个省份见"
    } ]
  }, {
    "tStartMs": 1362500,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "拜拜拜拜"
    } ]
  }, {
    "tStartMs": 1364066,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "拜拜拜拜"
    } ]
  } ]
}
