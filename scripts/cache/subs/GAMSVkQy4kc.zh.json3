  }, {
    "tStartMs": 806633,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "洗一下洗一下锅"
    } ]
  }, {
    "tStartMs": 813500,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "好接下来还是重复上一道菜的步骤"
