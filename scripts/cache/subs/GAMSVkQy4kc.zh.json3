  }, {
    "tStartMs": 800666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "青椒炒肉"
    } ]
  }, {
    "tStartMs": 802533,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "那我们在炒第二道菜之前"
