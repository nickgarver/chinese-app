  }, {
    "tStartMs": 694866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "赶紧戴上"
    } ]
  }, {
    "tStartMs": 696566,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "不然等下我的白t恤就要弄脏了"
    } ]
  }, {
    "tStartMs": 701566,
    "dDurationMs": 6534,
    "segs": [ {
      "utf8": "这个是围裙围裙围裙戴围裙"
    } ]
  }, {
    "tStartMs": 711133,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "戴戴围裙"
    } ]
  }, {
    "tStartMs": 713533,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "嗯好啦戴好了"
    } ]
  }, {
    "tStartMs": 716066,
    "dDurationMs": 4934,
    "segs": [ {
      "utf8": "我们轻轻的掀开盖子闻一下轻轻的"
    } ]
  }, {
    "tStartMs": 722066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇哦"
    } ]
  }, {
    "tStartMs": 723766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "哇好香啊"
    } ]
  }, {
    "tStartMs": 726166,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "接下来我要尝一下尝一下"
    } ]
  }, {
    "tStartMs": 732133,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "太烫了所以我要吹一下吹"
    } ]
  }, {
    "tStartMs": 741133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 742166,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "很好吃了嗯"
    } ]
  }, {
    "tStartMs": 745433,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "因为刚才放的那个酱呢"
    } ]
  }, {
    "tStartMs": 747533,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "本身就很咸很咸"
    } ]
  }, {
    "tStartMs": 750166,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "所以我就不用再放盐了嗯"
