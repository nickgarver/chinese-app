  }, {
    "tStartMs": 987766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我很喜欢吃孜然的味道"
    } ]
  }, {
    "tStartMs": 990633,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "所以接下来我要撒一点孜然粉"
