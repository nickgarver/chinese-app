  "events": [ {
    "tStartMs": 433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "嗨亲爱的朋友们"
    } ]
  }, {
    "tStartMs": 1866,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "你们好我是Mini"
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "欢迎你来到我的频道"
    } ]
  }, {
    "tStartMs": 5733,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "今天这期节目"
    } ]
  }, {
    "tStartMs": 7333,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "我会带你们一块做一顿中餐"
    } ]
  }, {
    "tStartMs": 11500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "在做午饭的过程当中"
    } ]
  }, {
    "tStartMs": 13733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "学习实用的中文表达"
    } ]
  }, {
    "tStartMs": 19500,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我之前有一期节目拍摄"
    } ]
  }, {
    "tStartMs": 21433,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "了制作意大利面的过程"
    } ]
  }, {
    "tStartMs": 24033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "你们看了吗"
    } ]
  }, {
    "tStartMs": 25566,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "今天完全不一样哦中餐"
    } ]
  }, {
    "tStartMs": 29766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "给你们看一下我"
    } ]
  }, {
    "tStartMs": 31233,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "今天准备的食材食材"
    } ]
  }, {
    "tStartMs": 34900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "准备的食材有哪些"
    } ]
  }, {
    "tStartMs": 37766,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "这个是青椒青椒"
    } ]
  }, {
    "tStartMs": 41233,
    "dDurationMs": 7433,
    "segs": [ {
      "utf8": "然后我准备做两个青椒两个青椒"
    } ]
  }, {
    "tStartMs": 48900,
    "dDurationMs": 6633,
    "segs": [ {
      "utf8": "然后这是一块猪肉一块猪肉嗯"
    } ]
  }, {
    "tStartMs": 55700,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "所以呢青椒跟猪肉配在一起"
    } ]
  }, {
    "tStartMs": 59766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "我就准备做一道菜叫做"
    } ]
  }, {
    "tStartMs": 62233,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "青椒炒肉"
    } ]
  }, {
    "tStartMs": 64000,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "这个是我们经常会做的一道家常菜"
    } ]
  }, {
    "tStartMs": 68333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "家常菜嗯"
    } ]
  }, {
    "tStartMs": 70333,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "家常菜的意思就是"
    } ]
  }, {
    "tStartMs": 71633,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "在家里面自己会做的"
    } ]
  }, {
    "tStartMs": 73533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "跟饭店的呢不太一样"
    } ]
  }, {
    "tStartMs": 75866,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "下一道菜我觉得你们"
    } ]
  }, {
    "tStartMs": 77633,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "很多人应该会听说过"
    } ]
  }, {
    "tStartMs": 80000,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "叫做麻婆豆腐"
    } ]
  }, {
    "tStartMs": 83200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "有没有吃过"
    } ]
  }, {
    "tStartMs": 84400,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "一道非常经典的中国的川菜"
    } ]
  }, {
    "tStartMs": 88433,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "应该是啊"
    } ]
  }, {
    "tStartMs": 89200,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "川菜对"
    } ]
  }, {
    "tStartMs": 90366,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "所以这里我准备了"
    } ]
  }, {
    "tStartMs": 92233,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "两块豆腐两块豆腐嗯"
    } ]
  }, {
    "tStartMs": 96433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "那我们在炒菜之前"
    } ]
  }, {
    "tStartMs": 98400,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "我会要先焖米饭焖米饭"
    } ]
  }, {
    "tStartMs": 102433,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "你也可以简单的说焖饭焖饭"
    } ]
  }, {
    "tStartMs": 106333,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "因为焖饭的时间会比较久"
    } ]
  }, {
    "tStartMs": 109333,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "差不多要半个小时左右"
    } ]
  }, {
    "tStartMs": 112600,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "我们可以一边焖饭一边炒菜"
    } ]
  }, {
    "tStartMs": 117566,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "一边一边"
    } ]
  }, {
    "tStartMs": 119566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "这个表达呢"
    } ]
  }, {
    "tStartMs": 120566,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我之前的节目里也经常提到哦"
    } ]
  }, {
    "tStartMs": 123466,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "一边一边OK"
    } ]
  }, {
    "tStartMs": 126633,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我现在要去焖饭"
    } ]
  }, {
    "tStartMs": 130033,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我们先打开柜子"
    } ]
  }, {
    "tStartMs": 132466,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "打开打开柜子"
    } ]
  }, {
    "tStartMs": 136800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好"
    } ]
  }, {
    "tStartMs": 139600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "这个就是大米"
    } ]
  }, {
    "tStartMs": 143400,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "我们把它拿出来拿出来"
    } ]
  }, {
    "tStartMs": 149966,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "这个呢是碗碗"
    } ]
  }, {
    "tStartMs": 152666,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "我现在要把大米倒进碗里"
    } ]
  }, {
    "tStartMs": 156833,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "倒倒"
    } ]
  }, {
    "tStartMs": 159433,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "差不多了"
    } ]
  }, {
    "tStartMs": 161533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "把大米放回去"
    } ]
  }, {
    "tStartMs": 164933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "放回去"
    } ]
  }, {
    "tStartMs": 167466,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "然后我们再把门关上"
    } ]
  }, {
    "tStartMs": 171500,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "关上"
    } ]
  }, {
    "tStartMs": 173300,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "这个是我一会要焖米饭的内胆内胆"
    } ]
  }, {
    "tStartMs": 178966,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "用它来焖米饭"
    } ]
  }, {
    "tStartMs": 181166,
    "dDurationMs": 7300,
    "segs": [ {
      "utf8": "先把大米倒进去把大米倒进去"
    } ]
  }, {
    "tStartMs": 189766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "然后我们来洗一下米"
    } ]
  }, {
    "tStartMs": 192733,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "呃这个一般我们叫做淘米淘米"
    } ]
  }, {
    "tStartMs": 201333,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "然后把这个水倒掉"
    } ]
  }, {
    "tStartMs": 204866,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "这个是刚才我已经滤好的水把它呢"
    } ]
  }, {
    "tStartMs": 209300,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "倒进这个内胆里面"
    } ]
  }, {
    "tStartMs": 212133,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "倒倒水"
    } ]
  }, {
    "tStartMs": 215800,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "为了让焖出来的米饭是好吃的"
    } ]
  }, {
    "tStartMs": 218800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "加多少水特别重要"
    } ]
  }, {
    "tStartMs": 221466,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "然后呢我们有一个小习惯"
    } ]
  }, {
    "tStartMs": 224500,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "就是用手指去测量"
    } ]
  }, {
    "tStartMs": 227766,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "把手指呢"
    } ]
  }, {
    "tStartMs": 229500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "轻轻的放进这个水里面"
    } ]
  }, {
    "tStartMs": 232700,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "差不多接触到米的时候看一下"
    } ]
  }, {
    "tStartMs": 236933,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "水位线差不多到手指这里"
    } ]
  }, {
    "tStartMs": 240933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "这里有一个纹路对吧"
    } ]
  }, {
    "tStartMs": 242533,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "差不多到这里的时候呢"
    } ]
  }, {
    "tStartMs": 244533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这个水就加的差不多了"
    } ]
  }, {
    "tStartMs": 247333,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "这个是我们家的一个小习惯"
    } ]
  }, {
    "tStartMs": 249366,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "就是以前我妈妈这样子教我的"
    } ]
  }, {
    "tStartMs": 252266,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "那你们在蒸米饭的时候"
    } ]
  }, {
    "tStartMs": 254533,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "一般会怎么样去呃测量这个水位呢"
    } ]
  }, {
    "tStartMs": 258366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "欢迎你们在评论区告诉我"
    } ]
  }, {
    "tStartMs": 260700,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "好接下来我们把盖子盖上"
    } ]
  }, {
    "tStartMs": 263566,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "把盖子盖上"
    } ]
  }, {
    "tStartMs": 267466,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "把电源插上插上"
    } ]
  }, {
    "tStartMs": 271000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "那这边有一个开关开关"
    } ]
  }, {
    "tStartMs": 274000,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "把它按下去按下去"
    } ]
  }, {
    "tStartMs": 278133,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "这个灯亮了亮了OK"
    } ]
  }, {
    "tStartMs": 282100,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "现在它开始煮米饭了"
    } ]
  }, {
    "tStartMs": 285166,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "那在呃焖饭的过程当中呢"
    } ]
  }, {
    "tStartMs": 288266,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "我们就可以去炒菜了炒菜"
    } ]
  }, {
    "tStartMs": 292266,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "嗯因为今天我准备炒两个菜"
    } ]
  }, {
    "tStartMs": 295800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "工程量还有点大"
    } ]
  }, {
    "tStartMs": 297900,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "我们现在先去准备食材准备食材"
    } ]
  }, {
    "tStartMs": 303333,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我现在呢"
    } ]
  }, {
    "tStartMs": 304266,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "要先切一下这个青椒"
    } ]
  }, {
    "tStartMs": 307133,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "所以我拿了一个小的菜板菜板"
    } ]
  }, {
    "tStartMs": 311100,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "这是一个小一点的菜板"
    } ]
  }, {
    "tStartMs": 313633,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "它呢是专门切各种蔬菜和水果的"
    } ]
  }, {
    "tStartMs": 321900,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "这个是刀刀嗯"
    } ]
  }, {
    "tStartMs": 327533,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "然后呢我们先把这个青椒洗一下"
    } ]
  }, {
    "tStartMs": 332066,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "洗洗洗一下洗一下"
    } ]
  }, {
    "tStartMs": 338233,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "然后这个豆腐豆腐也洗一下"
    } ]
  }, {
    "tStartMs": 343966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "那这个呢"
    } ]
  }, {
    "tStartMs": 344866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我们也可以叫做冲冲"
    } ]
  }, {
    "tStartMs": 347766,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "把豆腐冲一下"
    } ]
  }, {
    "tStartMs": 353266,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "冲一下"
    } ]
  }, {
    "tStartMs": 355900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "接下来我们开始切切"
    } ]
  }, {
    "tStartMs": 363733,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "像这个呢"
    } ]
  }, {
    "tStartMs": 364700,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "是青椒的根茎"
    } ]
  }, {
    "tStartMs": 367133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我们是不吃的"
    } ]
  }, {
    "tStartMs": 368333,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "我要把它给掰下来掰下来"
    } ]
  }, {
    "tStartMs": 373966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "这个"
    } ]
  }, {
    "tStartMs": 375700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "掰"
    } ]
  }, {
    "tStartMs": 376966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "掰下来"
    } ]
  }, {
    "tStartMs": 378700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "继续切"
    } ]
  }, {
    "tStartMs": 381566,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "那我们一般切的时候呢"
    } ]
  }, {
    "tStartMs": 383933,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "可能会切成块或者切成丝"
    } ]
  }, {
    "tStartMs": 388166,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "块儿，丝儿"
    } ]
  }, {
    "tStartMs": 389933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但是我不会切丝"
    } ]
  }, {
    "tStartMs": 391566,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "因为太麻烦了"
    } ]
  }, {
    "tStartMs": 392733,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我一般就切成这种小小的块"
    } ]
  }, {
    "tStartMs": 396533,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "再把它这样放进碗里放"
    } ]
  }, {
    "tStartMs": 400366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "放进碗里"
    } ]
  }, {
    "tStartMs": 402766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "那接下来呢"
    } ]
  }, {
    "tStartMs": 403700,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "我还要继续切豆腐"
    } ]
  }, {
    "tStartMs": 406666,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "豆腐我一般也是切成块儿"
    } ]
  }, {
    "tStartMs": 409933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "切"
    } ]
  }, {
    "tStartMs": 413433,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "好的，我们把菜已经都切好了"
    } ]
  }, {
    "tStartMs": 417100,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "接下来呢我要切肉"
    } ]
  }, {
    "tStartMs": 419900,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "这个肉是从冰箱里拿出来缓缓"
    } ]
  }, {
    "tStartMs": 424166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "然后我用手这样子摸一下"
    } ]
  }, {
    "tStartMs": 426600,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "看看它缓的程度怎么样"
    } ]
  }, {
    "tStartMs": 430366,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "感觉差不多了"
    } ]
  }, {
    "tStartMs": 431700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "可以切了"
    } ]
  }, {
    "tStartMs": 433400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那我切肉的话"
    } ]
  }, {
    "tStartMs": 434900,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "我会拿出这个大一点的菜板"
    } ]
  }, {
    "tStartMs": 438566,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "哦好重啊"
    } ]
  }, {
    "tStartMs": 440300,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "这个这个很大"
    } ]
  }, {
    "tStartMs": 444366,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "而且很重"
    } ]
  }, {
    "tStartMs": 446000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "很大很重"
    } ]
  }, {
    "tStartMs": 449200,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "我也会换成这个"
    } ]
  }, {
    "tStartMs": 451466,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "这个我们叫菜刀菜刀"
    } ]
  }, {
    "tStartMs": 453966,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "嗯这个更大一点"
    } ]
  }, {
    "tStartMs": 456300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "用它来切肉"
    } ]
  }, {
    "tStartMs": 459866,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "切切肉"
    } ]
  }, {
    "tStartMs": 462000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "我要把这个肉切成片片"
    } ]
  }, {
    "tStartMs": 465333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "肉片肉片嗯"
    } ]
  }, {
    "tStartMs": 469933,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "这种我们会叫呃刀工刀工"
    } ]
  }, {
    "tStartMs": 473100,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "有的人刀工特别厉害"
    } ]
  }, {
    "tStartMs": 475300,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "不管是肉还是蔬菜都"
    } ]
  }, {
    "tStartMs": 477366,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "可以切的非常的好看"
    } ]
  }, {
    "tStartMs": 479866,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "但是像我的话就一般般"
    } ]
  }, {
    "tStartMs": 482100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "刀工没有那么好"
    } ]
  }, {
    "tStartMs": 483700,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "所以这个叫刀工"
    } ]
  }, {
    "tStartMs": 485333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "就是你切肉或者切菜"
    } ]
  }, {
    "tStartMs": 487166,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "的一个技巧特别好"
    } ]
  }, {
    "tStartMs": 489100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "叫做刀工特别好"
    } ]
  }, {
    "tStartMs": 491266,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "当当当当切好啦"
    } ]
  }, {
    "tStartMs": 493966,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "你们看这边呢"
    } ]
  }, {
    "tStartMs": 496166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "是刚刚切的猪肉"
    } ]
  }, {
    "tStartMs": 498966,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "这边呢是我切了一些蒜蒜"
    } ]
  }, {
    "tStartMs": 503033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "那我首先呢"
    } ]
  }, {
    "tStartMs": 504200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "会做第一个菜"
    } ]
  }, {
    "tStartMs": 506400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "麻婆豆腐"
    } ]
  }, {
    "tStartMs": 508566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "哈哈呃"
    } ]
  }, {
    "tStartMs": 510033,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "你们看这个是我炒菜用的锅"
    } ]
  }, {
    "tStartMs": 513933,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "这个是炒菜用的锅锅"
    } ]
  }, {
    "tStartMs": 517600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "然后等一下我们还会用到这个"
    } ]
  }, {
    "tStartMs": 520933,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "这个是铲子铲子"
    } ]
  }, {
    "tStartMs": 524266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "用来这样炒炒"
    } ]
  }, {
    "tStartMs": 526400,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "用来炒菜用的"
    } ]
  }, {
    "tStartMs": 528233,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "这里呢是电磁炉的开关打开"
    } ]
  }, {
    "tStartMs": 533966,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "然后呢往里面倒一些油"
    } ]
  }, {
    "tStartMs": 537933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "倒倒油"
    } ]
  }, {
    "tStartMs": 541133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "好一点点就可以了"
    } ]
  }, {
    "tStartMs": 543533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我不喜欢吃太多的油"
    } ]
  }, {
    "tStartMs": 546100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "所以我每次只放一点点一点点嗯"
    } ]
  }, {
    "tStartMs": 550500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "好我们现在等油热一点"
    } ]
  }, {
    "tStartMs": 554066,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "我要打开抽油烟机"
    } ]
  }, {
    "tStartMs": 559133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "好"
    } ]
  }, {
    "tStartMs": 561533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "接下来我要把这个酱"
    } ]
  }, {
    "tStartMs": 563766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "这个是豆瓣酱"
