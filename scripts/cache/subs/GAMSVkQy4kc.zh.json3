  }, {
    "tStartMs": 830033,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "接下来呢"
    } ]
  }, {
    "tStartMs": 830900,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "要把这个蒜放进锅里"
    } ]
  }, {
    "tStartMs": 835966,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我直接用手拿了"
    } ]
  }, {
    "tStartMs": 839066,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "好把蒜放进锅里"
    } ]
  }, {
    "tStartMs": 842533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "真的是边拍边做饭"
    } ]
  }, {
    "tStartMs": 845500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "就很手忙脚乱"
    } ]
  }, {
    "tStartMs": 848433,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "哦好的哎"
    } ]
  }, {
    "tStartMs": 849533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我的铲子去哪了"
    } ]
  }, {
    "tStartMs": 851766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "哦这里"
    } ]
  }, {
    "tStartMs": 853866,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "拿回我的铲子"
    } ]
  }, {
    "tStartMs": 858366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 859533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "蒜的香味真的好好闻啊"
    } ]
  }, {
    "tStartMs": 863733,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "很多人是不能吃蒜的"
    } ]
  }, {
    "tStartMs": 865500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "你们知道吗嗯"
    } ]
  }, {
    "tStartMs": 869533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "把这个肉放进锅里"
    } ]
  }, {
    "tStartMs": 872100,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "开始炒肉"
    } ]
  }, {
    "tStartMs": 877333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "哈哈"
    } ]
  }, {
    "tStartMs": 879566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "炒肉"
    } ]
  }, {
    "tStartMs": 881466,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "炒炒"
    } ]
  }, {
    "tStartMs": 884233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "把火调大一点"
    } ]
  }, {
    "tStartMs": 888166,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "把火调大一点"
    } ]
  }, {
    "tStartMs": 892633,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "现在呢这个肉这个肉呢变色了"
    } ]
  }, {
    "tStartMs": 897366,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "变色变色了之后呢"
    } ]
  }, {
    "tStartMs": 900033,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "我们就可以往里面加一些调料了"
    } ]
  }, {
    "tStartMs": 903766,
    "dDurationMs": 4334,
    "segs": [ {
      "utf8": "这个是老抽老抽老抽"
    } ]
  }, {
    "tStartMs": 908233,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "它是酱油的一种"
    } ]
  }, {
    "tStartMs": 910066,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "我们倒一点点进去一点点"
    } ]
  }, {
    "tStartMs": 914033,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "那我们放老抽的目的呢"
    } ]
  }, {
    "tStartMs": 916533,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "就是上色上色"
    } ]
  }, {
    "tStartMs": 919733,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "让这个菜看起来颜色更漂亮"
    } ]
  }, {
    "tStartMs": 924933,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "接下来我们把这个青椒青椒"
    } ]
  }, {
    "tStartMs": 929633,
    "dDurationMs": 5833,
    "segs": [ {
      "utf8": "再倒进去倒进去炒继续炒"
    } ]
  }, {
    "tStartMs": 936133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "现在我要放的是这个"
    } ]
  }, {
    "tStartMs": 939333,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "这个也是酱油的一种"
    } ]
  }, {
    "tStartMs": 941300,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "叫做生抽生抽"
    } ]
  }, {
    "tStartMs": 944033,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "这个呢就主要是为了呃调味调味"
    } ]
  }, {
    "tStartMs": 949233,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "倒一点酱油倒"
    } ]
  }, {
    "tStartMs": 954300,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "好了"
    } ]
  }, {
    "tStartMs": 955966,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "那我刚才呢"
    } ]
  }, {
    "tStartMs": 957266,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "放了两种酱油"
    } ]
  }, {
    "tStartMs": 959333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "这个是生抽调味"
    } ]
  }, {
    "tStartMs": 962433,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "这个是老抽上色"
    } ]
  }, {
    "tStartMs": 965666,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "哦这几个词你们可以把它学会"
    } ]
  }, {
    "tStartMs": 971433,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "而且这两种酱油呢"
    } ]
  }, {
    "tStartMs": 973133,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "是中餐里面炒菜最常用到的"
    } ]
  }, {
    "tStartMs": 977333,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "那接下来我还会放一种调料"
    } ]
  }, {
    "tStartMs": 980733,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "就是这个"
    } ]
  }, {
    "tStartMs": 981633,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "这个是孜然粉孜然粉"
    } ]
  }, {
    "tStartMs": 985833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "这个你们应该也常用吧"
