  }, {
    "tStartMs": 565433,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "豆瓣酱倒进锅里"
    } ]
  }, {
    "tStartMs": 569966,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "这个是我刚才放的豆瓣酱"
    } ]
  }, {
    "tStartMs": 573066,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "把它这样子炒一下"
    } ]
  }, {
    "tStartMs": 576333,
    "dDurationMs": 3900,
    "segs": [ {
