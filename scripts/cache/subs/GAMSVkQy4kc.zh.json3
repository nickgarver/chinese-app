  }, {
    "tStartMs": 1059366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 1061033,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我们把它盛盛出来"
