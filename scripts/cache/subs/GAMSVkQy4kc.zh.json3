  }, {
    "tStartMs": 683033,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "稍微的焖一会"
    } ]
  }, {
    "tStartMs": 685300,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "焖焖一会"
    } ]
  }, {
    "tStartMs": 688033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "啊完了朋友们"
    } ]
  }, {
    "tStartMs": 689766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我忘记戴围裙啦"
