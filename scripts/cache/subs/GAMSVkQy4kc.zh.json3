  }, {
    "tStartMs": 586266,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "继续炒炒炒豆腐"
    } ]
  }, {
    "tStartMs": 591233,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那既然是麻婆豆腐"
    } ]
  }, {
    "tStartMs": 593700,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "它就一定要有辣椒辣椒"
    } ]
  }, {
    "tStartMs": 597100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "你们很多人之前跟我讲"
    } ]
  }, {
    "tStartMs": 598933,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "说啊吃不惯我们的菜"
    } ]
  }, {
    "tStartMs": 601466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "是因为觉得它太辣了"
    } ]
  }, {
    "tStartMs": 604266,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "确实呃川菜"
    } ]
  }, {
    "tStartMs": 606466,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "中国的川菜会放很多的辣椒"
    } ]
  }, {
    "tStartMs": 609133,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "会比较辣"
    } ]
  }, {
    "tStartMs": 611100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "其实我也不太能吃很多辣椒"
    } ]
  }, {
    "tStartMs": 613566,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "但是放一点点还是可以的"
    } ]
  }, {
    "tStartMs": 618566,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "这个就是老干妈"
    } ]
  }, {
    "tStartMs": 621233,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "老干妈辣酱老干妈辣酱"
    } ]
  }, {
    "tStartMs": 624533,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "啊上期逛超市的时候也跟你们说过"
    } ]
  }, {
    "tStartMs": 627966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "这个我们做饭的时候经常会用"
    } ]
  }, {
    "tStartMs": 630833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "它是一种很好的调料调料"
    } ]
  }, {
    "tStartMs": 634833,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "我用勺子呢舀舀"
    } ]
  }, {
    "tStartMs": 639066,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "一点点就好了"
    } ]
  }, {
    "tStartMs": 640766,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "这个就是一点点一点点"
    } ]
  }, {
    "tStartMs": 643266,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "太多了的话会太辣"
    } ]
  }, {
    "tStartMs": 647500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "舀一点点"
    } ]
  }, {
    "tStartMs": 648300,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "把它放进锅里放进锅里"
    } ]
  }, {
    "tStartMs": 655733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "然后继续炒"
    } ]
  }, {
    "tStartMs": 658466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 660500,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "啊那个香气已经扑过来了"
    } ]
  }, {
    "tStartMs": 665033,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "然后要再往里面加一点点水"
