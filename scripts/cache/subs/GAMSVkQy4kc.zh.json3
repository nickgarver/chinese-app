  }, {
    "tStartMs": 757266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 758466,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "好吃已经熟了熟了"
