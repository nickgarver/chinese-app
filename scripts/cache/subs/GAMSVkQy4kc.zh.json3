  }, {
    "tStartMs": 774666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "所以我就没有放"
    } ]
  }, {
    "tStartMs": 776366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "好可以了"
    } ]
  }, {
    "tStartMs": 778233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我们把它盛出来"
    } ]
  }, {
    "tStartMs": 780500,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "盛到盘子里盛"
    } ]
  }, {
    "tStartMs": 784166,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "哇这个锅真的很重"
    } ]
  }, {
    "tStartMs": 787533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "怎么样"
    } ]
  }, {
    "tStartMs": 788433,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "这个就是我今天做的麻婆豆腐"
