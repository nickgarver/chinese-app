  "events": [ {
    "tStartMs": 188,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "你们好,我是Jade\nnǐ men hǎo, wǒ shì Jade"
    } ]
  }, {
    "tStartMs": 3908,
    "dDurationMs": 5281,
    "segs": [ {
      "utf8": "今天我穿了一件红色的\njīn tiān wǒ chuān le yī jiàn hóng sè de"
    } ]
  }, {
    "tStartMs": 9988,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "深红色的衣服\nshēn hóng sè de yī fú"
    } ]
  }, {
    "tStartMs": 13668,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "红色,红色的衣服\nhóng sè, hóng sè de yī fú"
    } ]
  }, {
    "tStartMs": 18308,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "因为我约了朋友见面\nyīn wèi wǒ yuē le péng yǒu jiàn miàn"
    } ]
  }, {
    "tStartMs": 23908,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "你们猜猜\nnǐ men cāi cāi"
    } ]
  }, {
    "tStartMs": 26428,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "我要和朋友一起做什么呢?\nwǒ yào hé péng yǒu yī qǐ zuò shén me ne ?"
    } ]
  }, {
    "tStartMs": 32828,
    "dDurationMs": 4852,
    "segs": [ {
      "utf8": "待会儿你们就会知道了\ndài huì ér nǐ men jiù huì zhī dào le"
    } ]
  }, {
    "tStartMs": 39607,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我现在在电梯\nwǒ xiàn zài zài diàn tī"
    } ]
  }, {
    "tStartMs": 44007,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "电梯,这里是电梯\ndiàn tī, zhè lǐ shì diàn tī"
    } ]
  }, {
    "tStartMs": 48847,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "我要去一个地方\nwǒ yào qù yí gè dì fāng"
    } ]
  }, {
    "tStartMs": 54367,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我要找一找\nwǒ yào zhǎo yī zhǎo"
    } ]
  }, {
    "tStartMs": 59887,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "今天我约了朋友打麻将\njīn tiān wǒ yuē le péng yǒu dǎ má jiāng"
    } ]
  }, {
    "tStartMs": 66287,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "打麻将\ndǎ má jiāng"
    } ]
  }, {
    "tStartMs": 68207,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "这是一个麻将房\nzhè shì yí gè má jiāng fáng"
    } ]
  }, {
    "tStartMs": 73207,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "麻将房\nmá jiāng fáng"
    } ]
  }, {
    "tStartMs": 75927,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "我们一般也会叫做棋牌室\nwǒ men yī bān yě huì jiào zuò qí pái shì"
