  }, {
    "tStartMs": 50300,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "xué xí yǔ yán de xí guàn\n学习语言的习惯"
    } ]
  }, {
    "tStartMs": 53600,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "wǒ de shǒu lǐ yǒu yí gè běn zi\n我的手里有一个本子"
