  }, {
    "tStartMs": 35300,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "yǒu yí gè hǎo de xué xí xí guàn hěn zhòng yào\n有一个好的学习习惯很重要"
    } ]
  }, {
    "tStartMs": 40900,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "dà jiā hǎo wǒ shì xiǎo nà\n大家好我是小娜"
    } ]
  }, {
    "tStartMs": 43900,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "jīn tiān wǒ men yào yì qǐ liáo yí xià\n今天我们要一起聊一下"
