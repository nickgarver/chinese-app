  }, {
    "tStartMs": 59766,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "wǒ huì wèn nǐ yì xiē wèn tí\n我会问你一些问题"
    } ]
  }, {
    "tStartMs": 62900,
    "dDurationMs": 5066,
    "segs": [ {
      "utf8": "rán hòu wǒ huì huí dá yí xià zhè xiē wèn tí\n然后我会回答一下这些问题"
