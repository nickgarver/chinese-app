    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "wǒ bù zhī dào nǐ shì shén me qíng kuàng\n我不知道你是什么情况"
    } ]
  }, {
    "tStartMs": 1008200,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "rán hòu nǐ yǒu méi yǒu xué guò qí tā de wài yǔ\n然后你有没有学过其他的外语"
    } ]
  }, {
    "tStartMs": 1012700,
    "dDurationMs": 3999,
    "segs": [ {
      "utf8": "hàn yǔ yǐ wài de wài yǔ\n汉语以外的外语"
    } ]
  }, {
    "tStartMs": 1017433,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "nǐ de xué xí xí guàn yí yàng ma\n你的学习习惯一样吗"
    } ]
  }, {
    "tStartMs": 1020933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "bǐ rú wǒ de huà\n比如我的话"
    } ]
  }, {
    "tStartMs": 1023933,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "bù yí yàng\n不一样"
    } ]
  }, {
    "tStartMs": 1025000,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "wǒ yǐ qián zài xué xiào xué de yīng yǔ\n我以前在学校学的英语"
    } ]
  }, {
    "tStartMs": 1028633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "zài zhōng guó xué de yīng yǔ\n在中国学的英语"
    } ]
  }, {
    "tStartMs": 1030733,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "wǒ shàng xué de shí hòu\n我上学的时候"
    } ]
  }, {
    "tStartMs": 1032733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "wǒ men zhī xué yǔ fǎ\n我们只学语法"
    } ]
  }, {
    "tStartMs": 1035100,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "zhī kǎo shì zuò liàn xí\n只考试做练习"
    } ]
  }, {
    "tStartMs": 1038500,
    "dDurationMs": 2499,
    "segs": [ {
      "utf8": "dàn shì wǒ cóng lái méi yǒu\n但是我从来没有"
    } ]
  }, {
    "tStartMs": 1041000,
    "dDurationMs": 3899,
    "segs": [ {
      "utf8": "wǒ hěn shǎo liàn xí tīng lì huò zhě liàn xí kǒu yǔ\n我很少练习听力或者练习口语"
    } ]
  }, {
    "tStartMs": 1045266,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "rán hòu hòu lái xué xí fǎ yǔ de shí hòu\n然后后来学习法语的时候"
    } ]
  }, {
    "tStartMs": 1048866,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "wǒ yě shì zài xué xiào xué xí de fǎ yǔ\n我也是在学校学习的法语"
    } ]
  }, {
    "tStartMs": 1053066,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "rán hòu dāng shí wǒ men yǒu wài jiào\n然后当时我们有外教"
    } ]
  }, {
    "tStartMs": 1055700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "yǒu fǎ guó de lǎo shī\n有法国的老师"
    } ]
  }, {
    "tStartMs": 1057433,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "suǒ yǐ tīng lì hé kǒu yǔ liàn xí dé duō yì diǎn\n所以听力和口语练习得多一点"
    } ]
  }, {
    "tStartMs": 1063866,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "dàn shì xiàn zài xué xí xī bān yá yǔ hé rì yǔ\n但是现在学习西班牙语和日语"
    } ]
  }, {
    "tStartMs": 1068266,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "shì wǒ zì jǐ xué de\n是我自己学的"
    } ]
  }, {
    "tStartMs": 1070933,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "wǒ zì xué de zhè liǎng mén yǔ yán\n我自学的这两门语言"
    } ]
  }, {
    "tStartMs": 1074633,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "suǒ yǐ hěn bù yí yàng\n所以很不一样"
    } ]
  }, {
    "tStartMs": 1077066,
    "dDurationMs": 5667,
    "segs": [ {
      "utf8": "wǒ jué de wǒ huā le hěn duō shí jiān lái liàn xí tīng lì\n我觉得我花了很多时间来练习听力"
    } ]
  }, {
    "tStartMs": 1082733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "kàn le hěn duō shì pín\n看了很多视频"
    } ]
  }, {
    "tStartMs": 1085066,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "tīng le hěn duō bō kè\n听了很多播客"
    } ]
  }, {
    "tStartMs": 1089266,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "yóu qí shì rì yǔ\n尤其是日语"
    } ]
  }, {
    "tStartMs": 1090900,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "yīn wèi wǒ yǐ qián méi yǒu xué guò rì yǔ\n因为我以前没有学过日语"
    } ]
  }, {
    "tStartMs": 1095533,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "suǒ yǐ xué xí de xí guàn wán quán bù yí yàng\n所以学习的习惯完全不一样"
    } ]
  }, {
    "tStartMs": 1101200,
    "dDurationMs": 999,
    "segs": [ {
      "utf8": "nà nǐ ne\n那你呢"
    } ]
  }, {
    "tStartMs": 1102200,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "nǐ xiàn zài xué xí zhōng wén\n你现在学习中文"
    } ]
  }, {
    "tStartMs": 1104633,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "nǐ yǒu shén me xué xí zhōng wén de xí guàn\n你有什么学习中文的习惯"
    } ]
  }, {
    "tStartMs": 1108333,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "nǐ shén me shí hòu xué xí\n你什么时候学习"
    } ]
  }, {
    "tStartMs": 1110233,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "nǐ měi zhōu xué xí jǐ cì\n你每周学习几次"
    } ]
  }, {
    "tStartMs": 1113200,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "nǐ měi cì xué xí shén me\n你每次学习什么"
    } ]
  }, {
    "tStartMs": 1116433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "nǐ yǒu méi yǒu bù xiǎng xué xí de shí hòu\n你有没有不想学习的时候"
    } ]
  }, {
    "tStartMs": 1119833,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "nà nǐ zuò shén me\n那你做什么"
    } ]
  }, {
    "tStartMs": 1122300,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "xī wàng nǐ kě yǐ fēn xiǎng gěi dà jiā\n希望你可以分享给大家"
    } ]
  }, {
    "tStartMs": 1125733,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "rán hòu zài píng lùn qū lǐ gào sù wǒ\n然后在评论区里告诉我"
    } ]
  }, {
    "tStartMs": 1129800,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "nà jīn tiān de shì pín jiù dào zhè lǐ\n那今天的视频就到这里"
    } ]
  }, {
    "tStartMs": 1132733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "wǒ men xià gè shì pín zài jiàn\n我们下个视频再见"
    } ]
  }, {
    "tStartMs": 1134733,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "bài bài\n拜拜"
    } ]
  } ]
}
