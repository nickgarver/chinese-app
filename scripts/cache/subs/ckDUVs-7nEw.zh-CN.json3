  "events": [ {
    "tStartMs": 700,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "hello大家好"
    } ]
  }, {
    "tStartMs": 1933,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "我是莫妮卡"
    } ]
  }, {
    "tStartMs": 3566,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "欢迎来到Chat-Chat with Monica"
    } ]
  }, {
    "tStartMs": 6333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "这是一档为中文学习者和"
    } ]
  }, {
    "tStartMs": 8733,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "中文爱好者提供的中文播客"
    } ]
  }, {
    "tStartMs": 11800,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "在这里你可以听到"
    } ]
  }, {
    "tStartMs": 13866,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "学到各种与中文以及"
    } ]
  }, {
    "tStartMs": 16300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "中国相关的话题"
    } ]
  }, {
    "tStartMs": 18200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "如果你对此感兴趣"
    } ]
  }, {
    "tStartMs": 20066,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "那就千万不要错过"
    } ]
  }, {
    "tStartMs": 24133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "嗯首先呢"
    } ]
  }, {
    "tStartMs": 27766,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "首先呢想要和大家say hello again"
    } ]
  }, {
    "tStartMs": 31533,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "祝大家新年快乐"
    } ]
  }, {
    "tStartMs": 33333,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "万事如意"
    } ]
  }, {
    "tStartMs": 34766,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "这好像是我第二次做春联了！做对联！"
    } ]
  }, {
    "tStartMs": 39266,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "没有办法"
    } ]
  }, {
    "tStartMs": 39966,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我们中国人还是要过两次新年的哦"
    } ]
  }, {
    "tStartMs": 43900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "想和大家分享一下我"
    } ]
  }, {
    "tStartMs": 46633,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "消失的这段时间做了什么"
    } ]
  }, {
    "tStartMs": 49466,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "一开始呢"
    } ]
  }, {
    "tStartMs": 50766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "是去年年底的时候"
    } ]
  }, {
    "tStartMs": 53000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "突然接到了一个项目"
    } ]
  }, {
    "tStartMs": 55100,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "这个项目呢"
    } ]
  }, {
    "tStartMs": 56066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "比较着急"
    } ]
  }, {
    "tStartMs": 57933,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "也是因为我们中国快要到年底放假了"
    } ]
  }, {
    "tStartMs": 61366,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "但是海外没有对吧"
    } ]
  }, {
    "tStartMs": 63633,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "所以呢这个期间我就跟着我的同事们"
    } ]
  }, {
    "tStartMs": 68566,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "一起在整个春节假期期间"
    } ]
  }, {
    "tStartMs": 72133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "把这个项目做完了"
    } ]
  }, {
    "tStartMs": 74333,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "第二件事情呢"
    } ]
  }, {
    "tStartMs": 76000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "就是我也不知道为什么"
    } ]
  }, {
    "tStartMs": 77500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "突然就在春节期间"
    } ]
  }, {
    "tStartMs": 79133,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "接到了很多新的学生"
    } ]
  }, {
    "tStartMs": 82166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "这个让我有点震惊啊"
    } ]
  }, {
    "tStartMs": 84066,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "而且都是零基础的学生"
    } ]
  }, {
    "tStartMs": 86300,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "说实话我之前零基础的教学经验呢"
    } ]
  }, {
    "tStartMs": 89266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "不是特别多但是呢"
    } ]
  }, {
    "tStartMs": 91366,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "经过这快要两个月的这段时间的"
    } ]
  }, {
    "tStartMs": 97033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "锻炼吧"
    } ]
  }, {
    "tStartMs": 98600,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "一个是锻炼"
    } ]
  }, {
    "tStartMs": 99666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "然后再加上准备"
    } ]
  }, {
    "tStartMs": 100966,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我觉得我现在教零基础"
    } ]
  }, {
    "tStartMs": 102833,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "算是我的舒适区了"
    } ]
  }, {
    "tStartMs": 104866,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我还蛮喜欢教零基础的学生的"
    } ]
  }, {
    "tStartMs": 107400,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "如果有这样的同学"
    } ]
  }, {
    "tStartMs": 110033,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "想要从头开始学中文的"
    } ]
  }, {
    "tStartMs": 112200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "也可以来找我报名哦"
    } ]
  }, {
    "tStartMs": 114666,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "嗯想要和大家分享一下"
    } ]
  }, {
    "tStartMs": 116633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "因为我一开始接到了"
    } ]
  }, {
    "tStartMs": 118233,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "第一个零基础的学生呢啊"
    } ]
  }, {
    "tStartMs": 120800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那我呢也是和他一起讨论了一下"
    } ]
  }, {
    "tStartMs": 123133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是否要用一些教材"
    } ]
  }, {
    "tStartMs": 125100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "但是后来呢"
    } ]
  }, {
    "tStartMs": 126133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我决定自己开发了一套教程"
    } ]
  }, {
    "tStartMs": 129300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "然后现在我所有的学生"
    } ]
  }, {
    "tStartMs": 131300,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "我所有的零基础的学生"
    } ]
  }, {
    "tStartMs": 132766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "可能有7个到8个吧"
    } ]
  }, {
    "tStartMs": 134533,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "都是使用我自己开发的这套教程的"
    } ]
  }, {
    "tStartMs": 138066,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "哈哈哈我自己开发了一套教程"
    } ]
  }, {
    "tStartMs": 140866,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "我就是很喜欢做这样的事情"
    } ]
  }, {
    "tStartMs": 142600,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我很喜欢开发一些东西"
    } ]
  }, {
    "tStartMs": 144500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我觉得这套教程就是对"
    } ]
  }, {
    "tStartMs": 146600,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "一些人是比较有效的"
    } ]
  }, {
    "tStartMs": 149133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "对一些人的效果呢"
    } ]
  }, {
    "tStartMs": 150833,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "不是很明显"
    } ]
  }, {
    "tStartMs": 152333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "所以呢就是我觉得啊"
    } ]
  }, {
    "tStartMs": 154233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "这个从某种程度上面呢"
    } ]
  }, {
    "tStartMs": 156166,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "也可以说明呢"
    } ]
  }, {
    "tStartMs": 157366,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "就是学生和老师的气场合不合"
    } ]
  }, {
    "tStartMs": 159700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "这个一对一的老师呢"
    } ]
  }, {
    "tStartMs": 161100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "也要看合不合适"
    } ]
  }, {
    "tStartMs": 162933,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "就跟谈恋爱一样"
    } ]
  }, {
    "tStartMs": 164433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "你找的这个老师说话的这种风格"
    } ]
  }, {
    "tStartMs": 166966,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "教学的风格是不是适合你"
    } ]
  }, {
    "tStartMs": 169700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "是不是你"
    } ]
  }, {
    "tStartMs": 170900,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "是不是适合你自己的一个学习的风格"
    } ]
  }, {
    "tStartMs": 174600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 175833,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我觉得这也是"
    } ]
  }, {
    "tStartMs": 176766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "为什么各种平台"
    } ]
  }, {
    "tStartMs": 178500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "设置这种试听课的一个理由吧"
    } ]
  }, {
    "tStartMs": 181466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "但是我很讨厌某平台"
    } ]
  }, {
    "tStartMs": 182933,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "就是试听课不给老师钱"
    } ]
  }, {
    "tStartMs": 185600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "那老师为了准备这个试听课 "
    } ]
  }, {
    "tStartMs": 188200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "投入的这些时间精力"
    } ]
  }, {
    "tStartMs": 190866,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "到最后呢"
    } ]
  }, {
    "tStartMs": 191933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "其实还要忍受"
    } ]
  }, {
    "tStartMs": 193600,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "学生如果在试听之后没有"
    } ]
  }, {
    "tStartMs": 197600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "继续地订阅你的课程"
    } ]
  }, {
    "tStartMs": 199466,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这个对我们的排名是有很大的影响的"
    } ]
  }, {
    "tStartMs": 202366,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "我也不可能让每一个人都喜欢我"
    } ]
  }, {
    "tStartMs": 204733,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "对吗哈哈哈对吧"
    } ]
  }, {
    "tStartMs": 207100,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "而且选择是很双向的一个事情"
    } ]
  }, {
    "tStartMs": 209700,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "我一直到现在"
    } ]
  }, {
    "tStartMs": 210700,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "我也有很多的学生"
    } ]
  }, {
    "tStartMs": 211966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "试听过之后我就直接把他们拉黑了"
    } ]
  }, {
    "tStartMs": 214333,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我也不想要教这样的学生"
    } ]
  }, {
    "tStartMs": 216766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "并不是说我很讨厌这个人"
    } ]
  }, {
    "tStartMs": 218800,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "而是呢就是大家都是成年人"
    } ]
  }, {
    "tStartMs": 221266,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "在交流的过程里面呢"
    } ]
  }, {
    "tStartMs": 223100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "大概也能知道啊"
    } ]
  }, {
    "tStartMs": 224400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "就是气场合不合"
    } ]
  }, {
    "tStartMs": 226066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "而且我也不是什么"
    } ]
  }, {
    "tStartMs": 227700,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "公立学校的一个专业的老师"
    } ]
  }, {
    "tStartMs": 230733,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "我是有自己选择的权利的所以呢"
    } ]
  }, {
    "tStartMs": 233466,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "那我呢我也不知道为什么"
    } ]
  }, {
    "tStartMs": 235633,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "就是过年期间呢"
    } ]
  }, {
    "tStartMs": 238033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我一边在家忙项目"
    } ]
  }, {
    "tStartMs": 239866,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "它项目呢"
    } ]
  }, {
    "tStartMs": 240700,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "就是项目它是这个样子"
    } ]
  }, {
    "tStartMs": 242866,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "它有很多交流的过程"
    } ]
  }, {
    "tStartMs": 245133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我接的这个项目在过年期间"
    } ]
  }, {
    "tStartMs": 247800,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "差不多就是两三天开一次会"
    } ]
  }, {
    "tStartMs": 249933,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那我每天投入3个小时呢"
    } ]
  }, {
    "tStartMs": 251866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就忙项目上面的内容就可以了"
    } ]
  }, {
    "tStartMs": 254466,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "其余的时间呢"
    } ]
  }, {
    "tStartMs": 255633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我基本上就在电脑面前坐着"
    } ]
  }, {
    "tStartMs": 258266,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "另外呢"
    } ]
  }, {
    "tStartMs": 259600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "我现在不是大学老师吗"
    } ]
  }, {
    "tStartMs": 262000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "对吧我所在的大学呢"
    } ]
  }, {
    "tStartMs": 263833,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "也已经开学了其实呢"
    } ]
  }, {
    "tStartMs": 266066,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "都已经是学期中了吧"
    } ]
  }, {
    "tStartMs": 268266,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "我那我每个星期呢要上一堂课"
    } ]
  }, {
    "tStartMs": 270633,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "剩余的时间呢"
    } ]
  }, {
    "tStartMs": 271933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "都要给学生改paper改作业"
    } ]
  }, {
    "tStartMs": 275100,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "所以我都所以我都笑称我每天"
    } ]
  }, {
    "tStartMs": 278766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "一睁开眼睛就是改无数的作业哈哈"
    } ]
  }, {
    "tStartMs": 281800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "所以大学的工作"
    } ]
  }, {
    "tStartMs": 283300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "再加上我年底接了一个比较着急的项目"
    } ]
  }, {
    "tStartMs": 287066,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "然后呢再加上我莫名其妙地接到了"
    } ]
  }, {
    "tStartMs": 290700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "七八个零基础的学生"
    } ]
  }, {
    "tStartMs": 292933,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "所以呢就让我"
    } ]
  }, {
    "tStartMs": 294866,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "过去的两个月变得异常忙碌"
    } ]
  }, {
    "tStartMs": 297200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "我甚至有两个星期忙到上火"
    } ]
  }, {
    "tStartMs": 301666,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "上火呢是中医里面的一个概念啊"
    } ]
  }, {
    "tStartMs": 304666,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "上火其实就是身体里面有炎症"
    } ]
  }, {
    "tStartMs": 307000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "那我的表现呢"
    } ]
  }, {
    "tStartMs": 308100,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "就表现在我舌头出了问题哈哈哈"
    } ]
  }, {
    "tStartMs": 312833,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我觉得就是"
    } ]
  }, {
    "tStartMs": 315633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "作为一个人类其实很奇妙"
    } ]
  }, {
    "tStartMs": 317833,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "就是你每年身体的自己的一个变化呢"
    } ]
  }, {
    "tStartMs": 320766,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "它都是不一样的"
    } ]
  }, {
    "tStartMs": 322400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那我以前上火的话"
    } ]
  }, {
    "tStartMs": 323800,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "我可能就是啊"
    } ]
  }, {
    "tStartMs": 325966,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "舌头上面或者是嘴巴里面长口腔溃疡"
    } ]
  }, {
    "tStartMs": 329733,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "或者有其他一些身体上面的反应"
    } ]
  }, {
    "tStartMs": 333000,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "但是这次我上火上的特别严重"
    } ]
  }, {
    "tStartMs": 336200,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "就是我舌头下面啊有有一个部分"
    } ]
  }, {
    "tStartMs": 341433,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "那我就是呢"
    } ]
  }, {
    "tStartMs": 342366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "舌头下面有一个部分呢"
    } ]
  }, {
    "tStartMs": 344200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "肿起来了"
    } ]
  }, {
    "tStartMs": 345733,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "给我吓得不轻哦哈哈哈"
    } ]
  }, {
    "tStartMs": 350166,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "给我吓得不轻"
    } ]
  }, {
    "tStartMs": 351200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "然后我过年期间还去医院呢"
    } ]
  }, {
    "tStartMs": 353900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "去检查了一下啊"
    } ]
  }, {
    "tStartMs": 355400,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "医生只是说我上火了"
    } ]
  }, {
    "tStartMs": 357700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "啊这个让我害怕"
    } ]
  }, {
    "tStartMs": 359633,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "因为你舌头自己"
    } ]
  }, {
    "tStartMs": 362333,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "舌头在嘴巴里面转来转去呢"
    } ]
  }, {
    "tStartMs": 364566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你也会发现一些异常"
    } ]
  }, {
    "tStartMs": 366666,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "我一开始呢"
    } ]
  }, {
    "tStartMs": 367433,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "只是舌头下面有一个小疙瘩"
    } ]
  }, {
    "tStartMs": 369900,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "就是硬硬的一个疙瘩然后呢"
    } ]
  }, {
    "tStartMs": 373466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "我就每天都在舔它"
    } ]
  }, {
    "tStartMs": 374700,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "我就看"
    } ]
  }, {
    "tStartMs": 375333,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "那我也要观察它有没有变大对吧"
    } ]
  }, {
    "tStartMs": 378066,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "谁也不知道"
    } ]
  }, {
    "tStartMs": 378966,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "嗯然后呢"
    } ]
  }, {
    "tStartMs": 380066,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "我去医院检查的时候"
    } ]
  }, {
    "tStartMs": 381400,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "医生告诉我是不是最近休息的很少"
    } ]
  }, {
    "tStartMs": 383966,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "是不是最近工作很忙"
    } ]
  }, {
    "tStartMs": 385766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "哈哈哈还问我是不是因为"
    } ]
  }, {
    "tStartMs": 387800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "最近吃了太多辣的东西"
    } ]
  }, {
    "tStartMs": 390400,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "而且呢"
    } ]
  }, {
    "tStartMs": 391666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "就是很多人在过年期间呢"
    } ]
  }, {
    "tStartMs": 393566,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "会吃很多的干货"
    } ]
  }, {
    "tStartMs": 395500,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "干货呢就是指瓜子啊"
    } ]
  }, {
    "tStartMs": 397566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这些坚果类的"
    } ]
  }, {
    "tStartMs": 399566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "或者吃很多的零食"
    } ]
  }, {
    "tStartMs": 401700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "啊还有是不是熬夜了嗯"
    } ]
  }, {
    "tStartMs": 403600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "那我其实呢"
    } ]
  }, {
    "tStartMs": 404600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "中间有三个星期吧"
    } ]
  }, {
    "tStartMs": 406933,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "其实每天就只"
    } ]
  }, {
    "tStartMs": 407966,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "就是就只睡三四个小时"
    } ]
  }, {
    "tStartMs": 410133,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我5点钟起床"
    } ]
  }, {
    "tStartMs": 411700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "晚上1点钟睡觉啊"
    } ]
  }, {
    "tStartMs": 413700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "那我五点钟起床了之后呢"
    } ]
  }, {
    "tStartMs": 415600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我就是在备课哈哈哈"
    } ]
  }, {
    "tStartMs": 419666,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我想要说呢我唉"
    } ]
  }, {
    "tStartMs": 421700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "这个问题呢"
    } ]
  }, {
    "tStartMs": 422500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我其实之前呢"
    } ]
  }, {
    "tStartMs": 423600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "没有离职之前啊"
    } ]
  }, {
    "tStartMs": 425300,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "就是在我开始我的Youtube之前"
    } ]
  }, {
    "tStartMs": 428200,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "我就一直有这个问题"
    } ]
  }, {
    "tStartMs": 429800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我就是做事情有点拼命"
    } ]
  }, {
    "tStartMs": 432333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我就是不会劳逸结合"
    } ]
  }, {
    "tStartMs": 434133,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "就如果我摆烂的时候呢"
    } ]
  }, {
    "tStartMs": 436833,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "比任何人都摆烂"
    } ]
  }, {
    "tStartMs": 438266,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "那我忙起来有动力的时候呢"
    } ]
  }, {
    "tStartMs": 440633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我比任何人都拼"
    } ]
  }, {
    "tStartMs": 442200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "这个其实不好"
    } ]
  }, {
    "tStartMs": 444333,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "就是有一点点不好"
    } ]
  }, {
    "tStartMs": 445566,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "就是经常会让自己特别特别累"
    } ]
  }, {
    "tStartMs": 449366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "就累到精疲力尽"
    } ]
  }, {
    "tStartMs": 451966,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我觉得我上火也是"
    } ]
  }, {
    "tStartMs": 453466,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "就是身体告诉我啊"
    } ]
  }, {
    "tStartMs": 455100,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "你这段时间实在是太累了啊"
    } ]
  }, {
    "tStartMs": 457400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "以这样的一个形式"
    } ]
  }, {
    "tStartMs": 459200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "把这种压力发泄出来了"
    } ]
  }, {
    "tStartMs": 461866,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "哈哈哈那我后来好了吗"
    } ]
  }, {
    "tStartMs": 464333,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "没有我自己都没有决定想要休息"
    } ]
  }, {
    "tStartMs": 467300,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "啊那这不是"
    } ]
  }, {
    "tStartMs": 469300,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "渐渐的就流量就下来了嘛"
    } ]
  }, {
    "tStartMs": 471700,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "那一个呢也是因为呢项目做完了"
    } ]
  }, {
    "tStartMs": 473966,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "第二件事情呢"
    } ]
  }, {
    "tStartMs": 475266,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "那零基础的学生有一两个"
    } ]
  }, {
    "tStartMs": 477266,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "他在一个月之后呢"
    } ]
  }, {
    "tStartMs": 478500,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "他们就不学了呀"
    } ]
  }, {
    "tStartMs": 480500,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "就是有的学生他就只是"
    } ]
  }, {
    "tStartMs": 482166,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "这一个月他有这个时间"
    } ]
  }, {
    "tStartMs": 484333,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "他想，他有这个兴趣"
    } ]
  }, {
    "tStartMs": 485200,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "就想要学一下"
    } ]
  }, {
    "tStartMs": 486466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "然后学了一个月之后他就不学了"
    } ]
  }, {
    "tStartMs": 488933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "那现在呢课程呢"
    } ]
  }, {
    "tStartMs": 490733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "就比较稳定一点"
    } ]
  }, {
    "tStartMs": 492200,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "然后呢"
    } ]
  }, {
    "tStartMs": 493666,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我自己大学的工作呢"
    } ]
  }, {
    "tStartMs": 495166,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我也已经适应了啊"
    } ]
  }, {
    "tStartMs": 497033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我从第一期的视频呢"
    } ]
  }, {
    "tStartMs": 498600,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "有和大家讲"
    } ]
  }, {
    "tStartMs": 499733,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我其实很讨厌老师这个职业"
    } ]
  }, {
    "tStartMs": 501866,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "但是没有想到啊哈哈哈"
    } ]
  }, {
    "tStartMs": 504333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "但是完全没有想到我现在"
    } ]
  }, {
    "tStartMs": 506000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "是正式的一个老师了啊"
    } ]
  }, {
    "tStartMs": 507966,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "那我现在呢"
    } ]
  }, {
    "tStartMs": 508666,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "是一个大学老师"
    } ]
  }, {
    "tStartMs": 509833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我也是一个中文老师对吧"
    } ]
  }, {
    "tStartMs": 511633,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "哈哈哈我也是一个中文老师"
    } ]
  }, {
    "tStartMs": 514166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那我以前呢"
    } ]
  }, {
    "tStartMs": 514966,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "可能教的比较多的是这种free talk啊"
    } ]
  }, {
    "tStartMs": 517700,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "就是帮助大家完善一些口语表达"
    } ]
  }, {
    "tStartMs": 521400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那我现在呢"
    } ]
  }, {
    "tStartMs": 522200,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "从零基础或者中级别"
    } ]
  }, {
    "tStartMs": 524566,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我都有学生"
    } ]
  }, {
    "tStartMs": 525666,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "那我自己呢"
    } ]
  }, {
    "tStartMs": 526433,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "也在备课"
    } ]
  }, {
    "tStartMs": 527600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "这个备课的过程里面"
    } ]
  }, {
    "tStartMs": 529033,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "自己也重新学习了一遍中文"
    } ]
  }, {
    "tStartMs": 531033,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "我觉得（学）语言还是蛮有意思的一件事情"
    } ]
  }, {
    "tStartMs": 534866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "包括我自己呢最近呢"
    } ]
  }, {
    "tStartMs": 536666,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "因为时间又慢慢开始充裕了起来"
    } ]
  }, {
    "tStartMs": 540300,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我也开始啊"
    } ]
  }, {
    "tStartMs": 541900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "从头开始学一学德语什么的"
    } ]
  }, {
    "tStartMs": 544466,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "啊其实还蛮有意思的啊"
    } ]
  }, {
    "tStartMs": 546066,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "当我把我自己的德语书拿出来的时候"
    } ]
  }, {
    "tStartMs": 549433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "一般就是A1级别的书里面呢"
    } ]
  }, {
    "tStartMs": 551733,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "都有自我介绍"
    } ]
  }, {
    "tStartMs": 553233,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "然后这个时候呢"
    } ]
  }, {
    "tStartMs": 554166,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "有什么啊自我介绍的卡片"
    } ]
  }, {
    "tStartMs": 558000,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "啊我就发现"
    } ]
  }, {
    "tStartMs": 559566,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "当年我一开始学德语的时候是27岁"
    } ]
  }, {
    "tStartMs": 563400,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "哈哈哈然后我就想起来自己在"
    } ]
  }, {
    "tStartMs": 567533,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "一开始学习自我介绍的时候呢"
    } ]
  }, {
    "tStartMs": 570133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "我27岁（德语版）"
    } ]
  }, {
    "tStartMs": 573266,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "哈哈哈还在说27岁呢"
    } ]
  }, {
    "tStartMs": 576400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "啊一晃好多年过去了呀"
    } ]
  }, {
    "tStartMs": 579733,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "啊我最近总是会有这样那样的感慨"
    } ]
  }, {
    "tStartMs": 583466,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "可能也是因为最近接触的一些学生"
    } ]
  }, {
    "tStartMs": 587266,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "都是我当年学习一些外语的年纪"
    } ]
  }, {
    "tStartMs": 591200,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "所以就给了我一些感触吧啊"
    } ]
  }, {
    "tStartMs": 593933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我觉得还蛮有意思的"
    } ]
  }, {
    "tStartMs": 595366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "有一些学生还是蛮有意思的啊"
    } ]
  }, {
    "tStartMs": 597433,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "其实说实话"
    } ]
  }, {
    "tStartMs": 598433,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "我过去工作的五六年吧"
    } ]
  }, {
    "tStartMs": 601700,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "我都很少有接触到比"
    } ]
  }, {
    "tStartMs": 603666,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "自己小很多很多的人"
    } ]
  }, {
    "tStartMs": 606966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "这个是真话"
    } ]
  }, {
    "tStartMs": 607766,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "尤其是过去我三四年工作期间"
    } ]
  }, {
    "tStartMs": 611433,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我接触的都是和我"
    } ]
  }, {
    "tStartMs": 614033,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "同龄的或者比我大的"
    } ]
  }, {
    "tStartMs": 616333,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "大多数都是比我年纪大的"
    } ]
  }, {
    "tStartMs": 620000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "就哪怕我生活里面"
    } ]
  }, {
    "tStartMs": 622500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "很少很少有比我年纪小的"
    } ]
  }, {
    "tStartMs": 624600,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "好像大家就"
    } ]
  }, {
    "tStartMs": 625500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "根本就不是生活在同一个世界里面"
    } ]
  }, {
    "tStartMs": 628100,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "我都已经很久很久没有接触到"
    } ]
  }, {
    "tStartMs": 632233,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "比我年轻6岁以上的人吧哈哈哈"
    } ]
  }, {
    "tStartMs": 637633,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "6岁以上的人吧对吧"
    } ]
  }, {
    "tStartMs": 639566,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "所以我最近在和他们"
    } ]
  }, {
    "tStartMs": 641000,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "交流的过程里面呢"
    } ]
  }, {
    "tStartMs": 642366,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "我会觉得"
    } ]
  }, {
    "tStartMs": 643200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "你说这个年纪相差很大吗"
    } ]
  }, {
    "tStartMs": 645866,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "好像也没有"
    } ]
  }, {
    "tStartMs": 646933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "他们现在学习这个语言"
    } ]
  }, {
    "tStartMs": 649400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "从头开始学习一门语言的这个开始"
    } ]
  }, {
    "tStartMs": 652700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "和我当初自己学习"
    } ]
  }, {
    "tStartMs": 654900,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "不也差不多吗"
    } ]
  }, {
    "tStartMs": 656233,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "哈哈哈对吧"
    } ]
  }, {
    "tStartMs": 658200,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 658600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就是有一些些"
    } ]
  }, {
    "tStartMs": 661366,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "所以呢这就是有一些些感慨吧"
    } ]
  }, {
    "tStartMs": 664266,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "那同时呢"
    } ]
  }, {
    "tStartMs": 664966,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "我在教学的过程里面呢"
    } ]
  }, {
    "tStartMs": 667233,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我其实也想和大家分享一下"
    } ]
  }, {
    "tStartMs": 669800,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "就是学习语言的一些经验吧"
    } ]
  }, {
    "tStartMs": 672866,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我自己来讲啊"
    } ]
  }, {
    "tStartMs": 674500,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "我其实学语言呢"
    } ]
  }, {
    "tStartMs": 675866,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "我有一点点的天赋"
    } ]
  }, {
    "tStartMs": 677400,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "这个呢"
    } ]
  }, {
    "tStartMs": 678033,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "我一直都是承认的"
    } ]
  }, {
    "tStartMs": 679300,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "就是我自己是模仿能力很强"
    } ]
  }, {
    "tStartMs": 681833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "比如说"
    } ]
  }, {
    "tStartMs": 683200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "那我从小学英语"
    } ]
  }, {
    "tStartMs": 684800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "学普通话"
    } ]
  }, {
    "tStartMs": 685900,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我没有什么口音"
    } ]
  }, {
    "tStartMs": 687366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "就是没有口音这件事情"
    } ]
  }, {
    "tStartMs": 689266,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "其实就已经是一个天赋了嗯"
    } ]
  }, {
    "tStartMs": 691700,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "再加上呢"
    } ]
  }, {
    "tStartMs": 692666,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "有一些语言在我耳朵里面听起来呢"
    } ]
  }, {
    "tStartMs": 696266,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "从我个人的角度来听一些语言的时候"
    } ]
  }, {
    "tStartMs": 699300,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我就很容易抓住那个韵律去模仿"
    } ]
  }, {
    "tStartMs": 702566,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "但是对于一些人他"
    } ]
  }, {
    "tStartMs": 705400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "可能不是这样子的啊"
    } ]
  }, {
    "tStartMs": 706800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "最近呢接触的学生会比较多一点"
    } ]
  }, {
    "tStartMs": 709533,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "然后有很多人自学的经历让我比较惊讶"
    } ]
  }, {
    "tStartMs": 713333,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "就是他们通过自己自学"
    } ]
  }, {
    "tStartMs": 715533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "通过那种Anki"
    } ]
  }, {
    "tStartMs": 717266,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "Anki还是Anki"
    } ]
  }, {
    "tStartMs": 718800,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "这个软件啊来认识汉字单词"
    } ]
  }, {
    "tStartMs": 723100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "他们的词汇量真的很大"
    } ]
  }, {
    "tStartMs": 724700,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我和不同的学生"
    } ]
  }, {
    "tStartMs": 725800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "在交流的过程里面呢其实呢"
    } ]
  }, {
    "tStartMs": 727400,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "我会觉得说呃每个人呢"
    } ]
  }, {
    "tStartMs": 730266,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "学习语言都有自己的一个"
    } ]
  }, {
    "tStartMs": 732700,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "一个习惯吧"
    } ]
  }, {
    "tStartMs": 734066,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "有一些人比较喜欢跟着老师来学"
    } ]
  }, {
    "tStartMs": 736700,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "那有一些人呢"
    } ]
  }, {
    "tStartMs": 737700,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "喜欢自学对吧"
    } ]
  }, {
    "tStartMs": 739033,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "这个其实都是要靠自己去发掘"
    } ]
  }, {
    "tStartMs": 741966,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "你自己适合什么样的方式"
    } ]
  }, {
    "tStartMs": 744000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那比如说我自己"
    } ]
  }, {
    "tStartMs": 745800,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "我说实话"
    } ]
  }, {
    "tStartMs": 746966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "我是比较喜欢自学的"
    } ]
  }, {
    "tStartMs": 749033,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我连看视频我都懒得看"
    } ]
  }, {
    "tStartMs": 751600,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我不喜欢看视频"
    } ]
  }, {
    "tStartMs": 753100,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我不喜欢看视频的原因是因为"
    } ]
  }, {
    "tStartMs": 755900,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "我自己对我自己的发音有一个认知"
    } ]
  }, {
    "tStartMs": 761266,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "因为我知道我读的不算特别差"
    } ]
  }, {
    "tStartMs": 764600,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "啊我只是指我自己啊"
    } ]
  }, {
    "tStartMs": 766300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我学过的一些语言"
    } ]
  }, {
    "tStartMs": 768266,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "我觉得看视频有一点点慢"
    } ]
  }, {
    "tStartMs": 770833,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "所以我看视频我不喜欢"
    } ]
  }, {
    "tStartMs": 773333,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "我也不太喜欢和老师一对一啊"
    } ]
  }, {
    "tStartMs": 777600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就是这个我也不喜欢"
    } ]
  }, {
    "tStartMs": 779500,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "但是呢我很舍得花钱去国外去做"
    } ]
  }, {
    "tStartMs": 783066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "沉浸式的这样一个体验"
    } ]
  }, {
    "tStartMs": 786833,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "我不知道大家能不能理解我的意思啊"
    } ]
  }, {
    "tStartMs": 789100,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "我脸皮呢比较厚"
    } ]
  }, {
    "tStartMs": 790833,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "那我可能有的时候呢"
    } ]
  }, {
    "tStartMs": 792466,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "我就只会说一两句"
    } ]
  }, {
    "tStartMs": 794533,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "但是这一两句我能够"
    } ]
  }, {
    "tStartMs": 795866,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "练得特别特别熟练"
    } ]
  }, {
    "tStartMs": 797600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "因为我逢人就说"
    } ]
  }, {
    "tStartMs": 799966,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我见人就说"
    } ]
  }, {
    "tStartMs": 801466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "但是我会觉得"
    } ]
  }, {
    "tStartMs": 802966,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "当你把一些简单的句子说得很流利"
    } ]
  }, {
    "tStartMs": 806233,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "说得很标准的时候"
    } ]
  }, {
    "tStartMs": 808233,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这个从某种程度上会"
    } ]
  }, {
    "tStartMs": 810233,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "建立你说外语的一个自信"
    } ]
  }, {
    "tStartMs": 812700,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "这个是我自己的一个经验啊"
    } ]
  }, {
    "tStartMs": 814600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我特别记得我在欧洲的时候"
    } ]
  }, {
    "tStartMs": 816433,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我经常会找日本人讲话"
    } ]
  }, {
    "tStartMs": 818300,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "然后我开口总会让他们震惊啊"
    } ]
  }, {
    "tStartMs": 823333,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "他们不知道我到底是哪里的人哈哈哈"
    } ]
  }, {
    "tStartMs": 828166,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "就是一开始啊自我介绍啊"
    } ]
  }, {
    "tStartMs": 830800,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "或者说一些简单句的时候"
    } ]
  }, {
    "tStartMs": 832866,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "可以说的特别流利嗯"
    } ]
  }, {
    "tStartMs": 834066,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "这是我自己邪修的一个方式啊"
    } ]
  }, {
    "tStartMs": 836200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "那还有另外一个呢"
    } ]
  }, {
    "tStartMs": 837633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "就是学习的经历"
    } ]
  }, {
    "tStartMs": 838966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我觉得以前呢"
    } ]
  }, {
    "tStartMs": 840766,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "我对于这个理由置若罔闻吧"
    } ]
  }, {
    "tStartMs": 845666,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "很多人会讲说谈恋爱其实"
    } ]
  }, {
    "tStartMs": 847766,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "是学习语言的一个很好的途径"
    } ]
  }, {
    "tStartMs": 849900,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "啊不可否认啊"
    } ]
  }, {
    "tStartMs": 850900,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "这真的是一个"
    } ]
  }, {
    "tStartMs": 853066,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "很好很好的途径"
    } ]
  }, {
    "tStartMs": 854666,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "我觉得我的英语"
    } ]
  }, {
    "tStartMs": 856400,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "突飞猛进就是因为要吵架"
    } ]
  }, {
    "tStartMs": 860100,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "就是因为要和对方吵架"
    } ]
  }, {
    "tStartMs": 862500,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "那因为自己在关系过程里面呢"
    } ]
  }, {
    "tStartMs": 867033,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "啊再去看一些美剧或者"
    } ]
  }, {
    "tStartMs": 869333,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "看一些视频的时候"
    } ]
  }, {
    "tStartMs": 871233,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "会特别注意那些咬文嚼字哈哈"
    } ]
  }, {
    "tStartMs": 875333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "这个时候呢"
    } ]
  }, {
    "tStartMs": 876233,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "有一些词汇呢"
    } ]
  }, {
    "tStartMs": 877366,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "它会很容易被记住"
    } ]
  }, {
    "tStartMs": 879900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "因为你知道它有用所以呢"
    } ]
  }, {
    "tStartMs": 882133,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 883566,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "我会觉得不管是谈恋爱"
    } ]
  }, {
    "tStartMs": 885833,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "还是工作中的使用吧"
    } ]
  }, {
    "tStartMs": 888366,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "从这个角度来讲的话"
    } ]
  }, {
    "tStartMs": 890300,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "从头开始学"
    } ]
  }, {
    "tStartMs": 891266,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "可能有一点点难"
    } ]
  }, {
    "tStartMs": 893466,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "如果大家是为了"
    } ]
  }, {
    "tStartMs": 894466,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "很实用的一些场景的话"
    } ]
  }, {
    "tStartMs": 896300,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "直接去学句子"
    } ]
  }, {
    "tStartMs": 898366,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "比从头开始学要好一些"
    } ]
  }, {
    "tStartMs": 902300,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "这个是我的一些经验之谈啊"
    } ]
  }, {
    "tStartMs": 904166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "可能有一些人会反驳我啊"
    } ]
  }, {
    "tStartMs": 906633,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "那你比如说"
    } ]
  }, {
    "tStartMs": 908366,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "对吧最近你要吵架"
    } ]
  }, {
    "tStartMs": 909666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "你就学几个吵架的句子"
    } ]
  }, {
    "tStartMs": 911566,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 912333,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "最近我要去买东西"
    } ]
  }, {
    "tStartMs": 913733,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "那我就只学买东西的"
    } ]
  }, {
    "tStartMs": 916433,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "在学买东西的这些对话的过程里面呢"
    } ]
  }, {
    "tStartMs": 919366,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "然后去补充一些知识"
    } ]
  }, {
    "tStartMs": 921766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "比如说对这个语法不熟悉"
    } ]
  }, {
    "tStartMs": 923800,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "对这个单词不熟悉"
    } ]
  }, {
    "tStartMs": 925266,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "然后再去记"
    } ]
  }, {
    "tStartMs": 926800,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "可能会更加适合一点嗯"
    } ]
  }, {
    "tStartMs": 930233,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "我是这么觉得"
    } ]
  }, {
    "tStartMs": 931266,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "包括我自己在教零基础的学生的时候"
    } ]
  }, {
    "tStartMs": 933833,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那我跟学生在聊天"
    } ]
  }, {
    "tStartMs": 935800,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我说你这个周末做什么了"
    } ]
  }, {
    "tStartMs": 938433,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "他如果告诉我他在做饭"
    } ]
  }, {
    "tStartMs": 940633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那我就会紧接着"
    } ]
  }, {
    "tStartMs": 943033,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "这两个星期就只教做饭相关的一些"
    } ]
  }, {
    "tStartMs": 947866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "词汇语法"
    } ]
  }, {
    "tStartMs": 949366,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "这样子的话"
    } ]
  }, {
    "tStartMs": 950666,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "那每次课上面都会很顺畅地交流"
    } ]
  }, {
    "tStartMs": 955033,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "而不是只在记住一些单词"
    } ]
  }, {
    "tStartMs": 958633,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "或者记住一些新的语法"
    } ]
  }, {
    "tStartMs": 961966,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "这个是我的一些经验"
    } ]
  }, {
    "tStartMs": 963333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "也是我自己和我目前带的学生呢"
    } ]
  }, {
    "tStartMs": 966033,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "我们共同商讨"
    } ]
  }, {
    "tStartMs": 967300,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "共同接受的一个教学的方式"
    } ]
  }, {
    "tStartMs": 969633,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "这个呢不是为了去考试之类的"
    } ]
  }, {
    "tStartMs": 972666,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "可能"
    } ]
  }, {
    "tStartMs": 973433,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "如果是为了应试的话"
    } ]
  }, {
    "tStartMs": 974833,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那是另外的一种策略"
    } ]
  }, {
    "tStartMs": 976833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "嗯好吧嗯"
    } ]
  }, {
    "tStartMs": 978500,
    "dDurationMs": 566,
    "segs": [ {
      "utf8": "以上呢"
    } ]
  }, {
    "tStartMs": 979066,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "就是我最近呢想要和大家分享的一个"
    } ]
  }, {
    "tStartMs": 982466,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "一点点事情吧啊"
    } ]
  }, {
    "tStartMs": 983800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "那莫妮卡老师呢对吧"
    } ]
  }, {
    "tStartMs": 985866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "没想到半年过去了啊"
    } ]
  }, {
    "tStartMs": 987666,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我居然成为了一个"
    } ]
  }, {
    "tStartMs": 990166,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "比较正式的老师吧"
    } ]
  }, {
    "tStartMs": 992133,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我正式的成为了一名老师"
    } ]
  }, {
    "tStartMs": 994566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "还是挺神奇的嗯"
    } ]
  }, {
    "tStartMs": 998300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "包括在大学里面"
    } ]
  }, {
    "tStartMs": 999500,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我作为老师"
    } ]
  }, {
    "tStartMs": 1000433,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "然后给学生改作业的过程里面呢也会"
    } ]
  }, {
    "tStartMs": 1004300,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "也能够体会到做老师的一些不容易吧"
    } ]
  }, {
    "tStartMs": 1007666,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "嗯现在的大学生呢"
    } ]
  }, {
    "tStartMs": 1009666,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "和我们那个年代不太一样"
    } ]
  }, {
    "tStartMs": 1012066,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我读大学的时候"
    } ]
  }, {
    "tStartMs": 1013800,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "如果作业写不出来"
    } ]
  }, {
    "tStartMs": 1016500,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "你就只能瞎拼乱凑对吧"
    } ]
  }, {
    "tStartMs": 1019066,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "嗯但是现在的学生都有AI"
    } ]
  }, {
    "tStartMs": 1022300,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那有很多的学生呢"
    } ]
  }, {
    "tStartMs": 1024266,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "他们完全不动脑子"
    } ]
  }, {
    "tStartMs": 1027000,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "纯靠AI来输出一些作业"
    } ]
  }, {
    "tStartMs": 1030766,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我从一开始的时候呢"
    } ]
  }, {
    "tStartMs": 1032166,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "我也会很气愤"
    } ]
  }, {
    "tStartMs": 1033766,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "我说连题目都没有读"
    } ]
  }, {
    "tStartMs": 1036033,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "那你至少要让AI理解一下"
    } ]
  }, {
    "tStartMs": 1038800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "你这个作业要做什么吧"
    } ]
  }, {
    "tStartMs": 1041733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "就自己心态的这一个变化吧"
    } ]
  }, {
    "tStartMs": 1043666,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "也是蛮有意思的"
    } ]
  }, {
    "tStartMs": 1045466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "然后呢在这个做老师的过程里面"
    } ]
  }, {
    "tStartMs": 1047933,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我也发现了自己一些性格上面的"
    } ]
  }, {
    "tStartMs": 1052033,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "不一样吧"
    } ]
  }, {
    "tStartMs": 1053133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "我都不能说它是问题"
    } ]
  }, {
    "tStartMs": 1054833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "我就发现我其实自己"
    } ]
  }, {
    "tStartMs": 1056366,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "也是一个比较轴的人哈哈哈"
    } ]
  }, {
    "tStartMs": 1060900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "轴用中文来理解的话"
    } ]
  }, {
    "tStartMs": 1063066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "就是不懂得变通"
    } ]
  }, {
    "tStartMs": 1064800,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "我倒不能说我不懂变通"
    } ]
  }, {
    "tStartMs": 1067166,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我就是发现呢"
    } ]
  }, {
    "tStartMs": 1068266,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "我其实呃"
    } ]
  }, {
    "tStartMs": 1069433,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "我自己呢"
    } ]
  }, {
    "tStartMs": 1070200,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "是一个很有责任心的人"
    } ]
  }, {
    "tStartMs": 1072433,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "我想要给学生提供一些更多的帮助"
    } ]
  }, {
    "tStartMs": 1076166,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "尽可能的帮助我的学生嗯"
    } ]
  }, {
    "tStartMs": 1079366,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "我从三个月之前"
    } ]
  }, {
    "tStartMs": 1081100,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "我还在跟我的导师"
    } ]
  }, {
    "tStartMs": 1082666,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我还在跟我的professor要reference letter"
    } ]
  }, {
    "tStartMs": 1085733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "那我现在都已经变成了一个"
    } ]
  }, {
    "tStartMs": 1087766,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "可以给我的学生写reference letter的人"
    } ]
  }, {
    "tStartMs": 1090900,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "当我收到这种请求"
    } ]
  }, {
    "tStartMs": 1093133,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "然后要给对方写推荐信的时候"
    } ]
  }, {
    "tStartMs": 1096466,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我突然发现我有这种责任感"
    } ]
  }, {
    "tStartMs": 1099133,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "哎呀那我得看看你做作业认不认真"
    } ]
  }, {
    "tStartMs": 1103100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "你平时的态度怎么样"
    } ]
  }, {
    "tStartMs": 1105266,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我才能给你写呀哈哈哈"
    } ]
  }, {
    "tStartMs": 1108733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "是吧然后呢"
    } ]
  }, {
    "tStartMs": 1110300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我突然也就能够理解"
    } ]
  }, {
    "tStartMs": 1112566,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "可能我当初的一些教授对我啊"
    } ]
  }, {
    "tStartMs": 1115366,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "就是那种欲言又止的"
    } ]
  }, {
    "tStartMs": 1118533,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "一些态度是为什么吧"
    } ]
  }, {
    "tStartMs": 1120300,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "啊我突然就理解了嗯"
    } ]
  }, {
    "tStartMs": 1123266,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "所以你看啊人呢"
    } ]
  }, {
    "tStartMs": 1125166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "都是会成长的"
    } ]
  }, {
    "tStartMs": 1126566,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "在这个过程里面呢"
    } ]
  }, {
    "tStartMs": 1128000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "你慢慢的也会发现自己"
    } ]
  }, {
    "tStartMs": 1130100,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "曾经的幼稚和自己的成长"
    } ]
  }, {
    "tStartMs": 1134300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "虽然只有短短的两个月啊"
    } ]
  }, {
    "tStartMs": 1135966,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "但是这两个月里面我"
    } ]
  }, {
    "tStartMs": 1137200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "其实发生了很多事情"
    } ]
  }, {
    "tStartMs": 1138800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那我身份的一个转变"
    } ]
  }, {
    "tStartMs": 1140800,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "包括说我现在工作模式的一个彻底的转变"
    } ]
  }, {
    "tStartMs": 1144600,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "再加上我工作内容的一个彻底的转变"
    } ]
  }, {
    "tStartMs": 1148133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "让我有点感慨吧"
    } ]
  }, {
    "tStartMs": 1149533,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我最近呢又经过了一轮的"
    } ]
  }, {
    "tStartMs": 1153133,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这种高强度工作的洗礼啊"
    } ]
  }, {
    "tStartMs": 1155566,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我现在呢最近呢有点平静下来了"
    } ]
  }, {
    "tStartMs": 1158600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "哈哈哈我最近呢有一点平静下来了"
    } ]
  }, {
    "tStartMs": 1161600,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "所以呢我觉得是时候要重新录制视频"
    } ]
  }, {
    "tStartMs": 1165466,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "和大家聊一聊生活"
    } ]
  }, {
    "tStartMs": 1167700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "聊一聊感触"
    } ]
  }, {
    "tStartMs": 1169166,
    "dDurationMs": 2334,
