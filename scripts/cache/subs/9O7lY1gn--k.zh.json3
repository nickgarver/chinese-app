  }, {
    "tStartMs": 57966,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "你问你的家人"
    } ]
  }, {
    "tStartMs": 59500,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "你今天晚上想吃什么"
