    } ]
  }, {
    "tStartMs": 440366,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "一点的软一点的面条"
    } ]
  }, {
    "tStartMs": 442766,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "所以我一般会煮个15分钟嗯"
    } ]
  }, {
    "tStartMs": 446866,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "那有的人会喜欢吃硬"
    } ]
  }, {
    "tStartMs": 449400,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "一点的硬一点的面条"
    } ]
  }, {
    "tStartMs": 451766,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "所以大家的呃口味都不太一样"
    } ]
  }, {
    "tStartMs": 455000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "软硬"
    } ]
  }, {
    "tStartMs": 456600,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "那你们喜欢吃软一点"
    } ]
  }, {
    "tStartMs": 458633,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "的还是硬一点的呢"
    } ]
  }, {
    "tStartMs": 460600,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "欢迎你在评论区告诉我"
    } ]
  }, {
    "tStartMs": 463066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "等一下做酱汁的时候呢"
    } ]
  }, {
    "tStartMs": 465066,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "我会想往里面放一些蒜蒜"
    } ]
  }, {
    "tStartMs": 468566,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "看这个是蒜"
    } ]
  }, {
    "tStartMs": 470266,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "所以我现在要切一下蒜"
    } ]
  }, {
    "tStartMs": 473000,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "我们一般的做法是拍拍"
    } ]
  }, {
    "tStartMs": 476166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "这样拍几下"
    } ]
  }, {
    "tStartMs": 477900,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "然后它的皮就更容易剥下来了"
    } ]
  }, {
    "tStartMs": 481666,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "所以这个动作是拍"
    } ]
  }, {
    "tStartMs": 486366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 487700,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "你看这个皮就特别容易剥下来"
    } ]
  }, {
    "tStartMs": 495300,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "然后再把它切碎切碎"
    } ]
  }, {
    "tStartMs": 500300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "把切好的蒜呢"
    } ]
  }, {
    "tStartMs": 502233,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "放到这个碟子里"
    } ]
  }, {
    "tStartMs": 503966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "这是一个碟子"
    } ]
  }, {
    "tStartMs": 506166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "放放到碟子里"
    } ]
  }, {
    "tStartMs": 509166,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "来看看我的面条"
    } ]
  }, {
    "tStartMs": 512300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 513366,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "我用筷子这样子去搅拌"
    } ]
  }, {
    "tStartMs": 516833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "搅拌的时候呢"
    } ]
  }, {
    "tStartMs": 518300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我就能感受到这个"
    } ]
  }, {
    "tStartMs": 520100,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "面条的呃软硬程度"
    } ]
  }, {
    "tStartMs": 524166,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "我觉得现在这个差不多了可以了嗯"
    } ]
  }, {
    "tStartMs": 529233,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "接下来呢"
    } ]
  }, {
    "tStartMs": 530100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "我拿一个碗"
    } ]
  }, {
    "tStartMs": 532200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "拿了一个碗"
    } ]
  }, {
    "tStartMs": 533766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "准备把面条盛出来"
    } ]
  }, {
    "tStartMs": 536700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "我要先夹夹"
    } ]
  }, {
    "tStartMs": 539866,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "用筷子夹"
    } ]
  }, {
    "tStartMs": 542166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "把面条夹起来"
    } ]
  }, {
    "tStartMs": 543666,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "然后盛到这个碗里"
    } ]
  }, {
    "tStartMs": 547200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "哇哈"
    } ]
  }, {
    "tStartMs": 550366,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "因为我一只手拿着相机"
    } ]
  }, {
    "tStartMs": 552800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "另外一只手用筷子夹这个面条"
    } ]
  }, {
    "tStartMs": 556633,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "有点不太好操作"
    } ]
  }, {
    "tStartMs": 560800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "哎这个时候要是有一个"
    } ]
  }, {
    "tStartMs": 562766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "摄影师帮我拍就好了"
    } ]
  }, {
    "tStartMs": 565266,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "嗯真的"
    } ]
  }, {
    "tStartMs": 566900,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "自己一个人拍这种vlog就是会"
    } ]
  }, {
    "tStartMs": 570833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "有的时候会手忙脚乱"
    } ]
  }, {
    "tStartMs": 573566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "这是个成语哦教你们"
    } ]
  }, {
    "tStartMs": 575666,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "手忙脚乱"
    } ]
  }, {
    "tStartMs": 577900,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "你们可以去查一查是什么意思"
    } ]
  }, {
    "tStartMs": 580733,
    "dDurationMs": 6533,
    "segs": [ {
      "utf8": "好我继续把面条夹起来盛到碗里"
    } ]
  }, {
    "tStartMs": 588500,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "好的"
    } ]
  }, {
    "tStartMs": 589233,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "那接下来我要开始做酱汁做酱汁"
    } ]
  }, {
    "tStartMs": 594600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "那我要换另外一个锅"
    } ]
  }, {
    "tStartMs": 600433,
    "dDurationMs": 7233,
    "segs": [ {
      "utf8": "这个这个是一个炒锅炒锅嗯"
    } ]
  }, {
    "tStartMs": 608166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "用它来做酱汁"
    } ]
  }, {
    "tStartMs": 610300,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "哦对了"
    } ]
  }, {
    "tStartMs": 611066,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我要带一下围裙"
    } ]
  }, {
    "tStartMs": 614033,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "等我一下"
    } ]
  }, {
    "tStartMs": 618100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "你们看这个是围裙围裙嗯"
    } ]
  }, {
    "tStartMs": 623033,
    "dDurationMs": 5733,
    "segs": [ {
      "utf8": "做饭之前就应该把它戴戴上戴围裙"
    } ]
  }, {
    "tStartMs": 629833,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "我要先把这个酱汁打开"
    } ]
  }, {
    "tStartMs": 633466,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "这个是意大利面酱"
    } ]
  }, {
    "tStartMs": 636066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 637600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "这个好难拧啊"
    } ]
  }, {
    "tStartMs": 639900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "这个动作是拧拧"
    } ]
  }, {
    "tStartMs": 642666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "它现在非常的紧"
    } ]
  }, {
    "tStartMs": 644666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "非常紧我很难拧开"
    } ]
  }, {
    "tStartMs": 647800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "因为它有一些滑滑"
    } ]
  }, {
    "tStartMs": 650433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "上面有水"
    } ]
  }, {
    "tStartMs": 651866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "啊有点滑"
    } ]
  }, {
    "tStartMs": 653500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "我看一下"
    } ]
  }, {
    "tStartMs": 655433,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "拿一个毛巾拿一个毛巾这样试一试"
    } ]
  }, {
    "tStartMs": 659300,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "啊不行"
    } ]
  }, {
    "tStartMs": 660000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "还是很滑"
    } ]
  }, {
    "tStartMs": 662766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "啊怎么办"
    } ]
  }, {
    "tStartMs": 665366,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "用力"
    } ]
  }, {
    "tStartMs": 667633,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "使劲"
    } ]
  }, {
    "tStartMs": 669466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "哎呀还是不行"
    } ]
  }, {
    "tStartMs": 671066,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "天呐这个真的很难拧开呀"
    } ]
  }, {
    "tStartMs": 675900,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "朋友们遇到这种情况"
    } ]
  }, {
    "tStartMs": 678166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "你们会怎么办"
    } ]
  }, {
    "tStartMs": 680500,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "我再试试另外一个方法"
    } ]
  }, {
    "tStartMs": 682966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "把它这样倒过来倒过来"
    } ]
  }, {
    "tStartMs": 686100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "然后拍底部拍"
    } ]
  }, {
    "tStartMs": 692166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "这些都是我在网上学到的方法"
    } ]
  }, {
    "tStartMs": 694866,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "不知道管不管用啊"
    } ]
  }, {
    "tStartMs": 698400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "还是不行"
    } ]
  }, {
    "tStartMs": 701900,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "气死我了"
    } ]
  }, {
    "tStartMs": 704366,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "拿一张纸"
    } ]
  }, {
    "tStartMs": 709800,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "拿了一个纸"
    } ]
  }, {
    "tStartMs": 711466,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "面巾纸看看行不行"
    } ]
  }, {
    "tStartMs": 716766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "啊我忽然想起来"
    } ]
  }, {
    "tStartMs": 718233,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "这是一瓶新的新的酱没开封哦"
    } ]
  }, {
    "tStartMs": 725233,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "所以我必须呢"
    } ]
  }, {
    "tStartMs": 726700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "先用勺子撬一下它"
    } ]
  }, {
    "tStartMs": 730800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "这个是撬"
    } ]
  }, {
    "tStartMs": 732800,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "用勺子这样是撬撬"
    } ]
  }, {
    "tStartMs": 738800,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "哎你们听到那个声音了吗"
    } ]
  }, {
    "tStartMs": 742066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "这回应该没问题了"
    } ]
  }, {
    "tStartMs": 745633,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "啊终于打开了"
    } ]
  }, {
    "tStartMs": 748266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "我现在呢"
    } ]
  }, {
    "tStartMs": 749066,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "要炒一下这个酱汁"
    } ]
  }, {
    "tStartMs": 751800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "呃"
    } ]
  }, {
    "tStartMs": 753066,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "在炒之前呢"
    } ]
  }, {
    "tStartMs": 754400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "我要先打开这个抽油烟机"
    } ]
  }, {
    "tStartMs": 757633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "这个是抽油烟机"
    } ]
  }, {
    "tStartMs": 762600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "好打开了"
    } ]
  }, {
    "tStartMs": 764733,
    "dDurationMs": 5533,
    "segs": [ {
      "utf8": "然后我们往锅里倒一些油倒油"
    } ]
  }, {
    "tStartMs": 771200,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "接下来等油热了就可以炒了"
    } ]
  }, {
    "tStartMs": 774933,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我一般会用手去试油温"
    } ]
  }, {
    "tStartMs": 779400,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "差不多了"
    } ]
  }, {
    "tStartMs": 780933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "先把蒜倒进锅里"
    } ]
  }, {
    "tStartMs": 785633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "翻炒几下"
    } ]
  }, {
    "tStartMs": 787633,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "翻炒翻炒"
    } ]
  }, {
    "tStartMs": 793633,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "我呢还很喜欢这样去闻一下味道"
    } ]
  }, {
    "tStartMs": 797433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "嗯好香啊"
    } ]
  }, {
    "tStartMs": 801066,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "后面呢"
    } ]
  }, {
    "tStartMs": 801766,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "我把肉和西红柿都放进了锅里"
    } ]
  }, {
    "tStartMs": 805800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "继续炒炒"
    } ]
  }, {
    "tStartMs": 812000,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "差不多了"
    } ]
  }, {
    "tStartMs": 813033,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "我接下来要把酱汁倒进去"
    } ]
  }, {
    "tStartMs": 820000,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "用勺子呢舀"
    } ]
  }, {
    "tStartMs": 822166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "这个是舀"
    } ]
  }, {
    "tStartMs": 825000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "舀出来啊"
    } ]
  }, {
    "tStartMs": 831500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "那我这里呢"
    } ]
  }, {
    "tStartMs": 832500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "是调整火的"
    } ]
  }, {
    "tStartMs": 836000,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "这个是加号"
    } ]
  }, {
    "tStartMs": 837600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "加号就是火再大一点"
    } ]
  }, {
    "tStartMs": 840500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "减号就是火小一点"
    } ]
  }, {
    "tStartMs": 844500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "小火"
    } ]
  }, {
    "tStartMs": 847100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "大火"
    } ]
  }, {
    "tStartMs": 848900,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "然后这个的话我们叫瓦"
    } ]
  }, {
    "tStartMs": 851300,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "比如说这个是800瓦"
    } ]
  }, {
    "tStartMs": 854466,
    "dDurationMs": 2734,
