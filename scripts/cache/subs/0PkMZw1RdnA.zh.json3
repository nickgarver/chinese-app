{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 133,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "每当我回想起幼年的时候"
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "我就觉得我的幼年无比快乐"
    } ]
  }, {
    "tStartMs": 8333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "幼年总是会结束的"
    } ]
  }, {
    "tStartMs": 11233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "一定要适应长大的生活"
    } ]
  }, {
    "tStartMs": 15733,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "这是8岁时的我写的"
    } ]
  }, {
    "tStartMs": 19433,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "我8岁的时候就开始怀念我的幼年了"
    } ]
  }, {
    "tStartMs": 24966,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "最近我在我的爸妈家里翻到了"
    } ]
  }, {
    "tStartMs": 28933,
    "dDurationMs": 5533,
    "segs": [ {
      "utf8": "这些从小学到高中的作文本"
    } ]
  }, {
    "tStartMs": 35100,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "7岁到17岁"
    } ]
  }, {
    "tStartMs": 38333,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我真的没想到他们还留着"
    } ]
  }, {
    "tStartMs": 41033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "所以今天我想跟你们一起看一看"
    } ]
  }, {
    "tStartMs": 44233,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "一个中国小孩是怎么"
    } ]
  }, {
    "tStartMs": 46866,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "一点一点学会用中文写作的"
    } ]
  }, {
    "tStartMs": 51833,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "每一个在中国上小学或者中学的人"
    } ]
  }, {
    "tStartMs": 56466,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "都必须写作文"
    } ]
  }, {
    "tStartMs": 59833,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "都必须用作文通过语文考试"
    } ]
  }, {
    "tStartMs": 64733,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "小时候我们什么都写。写人，写动物"
    } ]
  }, {
    "tStartMs": 69533,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "写植物，写一次经历，写景，写日记"
    } ]
  }, {
    "tStartMs": 75700,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "后来还会写调查、议论文"
    } ]
  }, {
    "tStartMs": 79166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "在我的印象里"
    } ]
  }, {
    "tStartMs": 80766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "不管是小学还是中学"
    } ]
  }, {
    "tStartMs": 83633,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "每个星期我们都要练习写作文"
    } ]
  }, {
    "tStartMs": 88033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "写完以后"
    } ]
  }, {
    "tStartMs": 89300,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "老师还会批改、打分、写评语"
    } ]
  }, {
    "tStartMs": 95233,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "那你们可以看到我有这么多的作文本"
    } ]
  }, {
    "tStartMs": 100000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "应该你们也会好奇"
    } ]
  }, {
    "tStartMs": 102633,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "为什么呢？"
    } ]
  }, {
    "tStartMs": 104266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "写作文很重要吗？"
    } ]
  }, {
    "tStartMs": 106800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "是的。因为"
    } ]
  }, {
    "tStartMs": 108833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "在当时的语文考试里"
    } ]
  }, {
    "tStartMs": 111133,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "作文一般是很大很大的一个部分"
    } ]
  }, {
    "tStartMs": 115000,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我们甚至会有一句比较夸张的话"
    } ]
  }, {
    "tStartMs": 118833,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "得作文者得天下"
    } ]
  }, {
    "tStartMs": 122700,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "意思差不多就是"
    } ]
  }, {
    "tStartMs": 124633,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "如果你的作文成绩好"
    } ]
  }, {
    "tStartMs": 127400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "你的语文成绩差不多就稳了一半"
    } ]
  }, {
    "tStartMs": 131466,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "不过"
    } ]
  }, {
    "tStartMs": 133133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "小学中学时的我"
    } ]
  }, {
    "tStartMs": 135533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "真的喜欢写作文吗？"
    } ]
  }, {
    "tStartMs": 138866,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "真的能写出好作文吗？"
    } ]
  }, {
    "tStartMs": 142500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "今天我就想和你们一起来"
    } ]
  }, {
    "tStartMs": 144833,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "读一读不同年级的我写的几篇作文"
    } ]
  }, {
    "tStartMs": 149633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "第一篇作文"
    } ]
  }, {
    "tStartMs": 151666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "二年级的"
    } ]
  }, {
    "tStartMs": 153233,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "8岁的我写的"
    } ]
  }, {
    "tStartMs": 155900,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "题目叫《西瓜》"
    } ]
  }, {
    "tStartMs": 158900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "当时的老师给了我一个优"
    } ]
  }, {
    "tStartMs": 161833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "加三颗星"
    } ]
  }, {
    "tStartMs": 165233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我最喜欢吃的水果是西瓜"
    } ]
  }, {
    "tStartMs": 169466,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "西瓜又大又圆"
    } ]
  }, {
    "tStartMs": 171933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "像个大皮球"
    } ]
  }, {
    "tStartMs": 174833,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "它有一条小辫子"
    } ]
  }, {
    "tStartMs": 177533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "又细又短"
    } ]
  }, {
    "tStartMs": 179333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "像小猪的尾巴"
    } ]
  }, {
    "tStartMs": 181666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "熟透的西瓜穿着一件浓淡相间的衣服"
    } ]
  }, {
    "tStartMs": 187466,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "上面还点缀着一个个黑色的小斑纹"
    } ]
  }, {
    "tStartMs": 192233,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "外形真是好看极了"
    } ]
  }, {
    "tStartMs": 195000,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "我本来以为8岁的我中文会特别简单"
    } ]
  }, {
    "tStartMs": 200000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "特别幼稚"
    } ]
  }, {
    "tStartMs": 201433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "可是打开一看"
    } ]
  }, {
    "tStartMs": 202900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "并不是这样的"
    } ]
  }, {
    "tStartMs": 204833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "里面还有很多比喻"
    } ]
  }, {
    "tStartMs": 207133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "很多复杂的"
    } ]
  }, {
    "tStartMs": 208433,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "可能你们也不知道的形容词"
    } ]
  }, {
    "tStartMs": 211533,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "为什么呢？"
    } ]
  }, {
    "tStartMs": 212900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "现在我想起来了"
    } ]
  }, {
    "tStartMs": 214933,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "当时一年级二年级刚进小学的时候"
    } ]
  }, {
    "tStartMs": 220100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我们怎么可能会"
    } ]
  }, {
    "tStartMs": 222200,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "一开始就直接写作文呀"
    } ]
  }, {
    "tStartMs": 225333,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "当时的老师肯定是让我们先去模仿"
    } ]
  }, {
    "tStartMs": 229033,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我们要学会模仿"
    } ]
  }, {
    "tStartMs": 231466,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "让自己写出来的中文像作文"
    } ]
  }, {
    "tStartMs": 236033,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "而不像直接嘴巴说出来的"
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我们模仿学到的课文"
    } ]
  }, {
    "tStartMs": 243300,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "模仿老师教给我们的表达"
    } ]
  }, {
    "tStartMs": 246333,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "努力去用新学的词语"
    } ]
  }, {
    "tStartMs": 249533,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "那个阶段是不是和你们"
    } ]
  }, {
    "tStartMs": 252333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "学中文的时候有点像呢？"
    } ]
  }, {
    "tStartMs": 266733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "第二篇作文"
    } ]
  }, {
    "tStartMs": 268500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "三年级写的"
    } ]
  }, {
    "tStartMs": 270533,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "当时我9岁"
    } ]
  }, {
    "tStartMs": 275100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "陪表妹玩"
    } ]
  }, {
    "tStartMs": 277466,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "每个礼拜天"
    } ]
  }, {
    "tStartMs": 279066,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "表妹都要来我家玩、吃饭"
    } ]
  }, {
    "tStartMs": 283000,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "表妹是我舅舅的女儿"
    } ]
  }, {
    "tStartMs": 285466,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "刚满4周岁"
    } ]
  }, {
    "tStartMs": 287800,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "废话却一箩筐"
    } ]
  }, {
    "tStartMs": 290400,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "一箩筐的废话"
    } ]
  }, {
    "tStartMs": 293200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "这天表妹又来了"
    } ]
  }, {
    "tStartMs": 296666,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "那时我正在做作业"
    } ]
  }, {
    "tStartMs": 300066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "不想陪她玩"
    } ]
  }, {
    "tStartMs": 302300,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "可是不陪"
    } ]
  }, {
    "tStartMs": 303866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "老妈又要唠叨半天"
    } ]
  }, {
    "tStartMs": 306833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我只好不情愿的答应了"
    } ]
  }, {
    "tStartMs": 312633,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "表妹拿出我的一些玩具"
    } ]
  }, {
    "tStartMs": 315500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "叫我做病人"
    } ]
  }, {
    "tStartMs": 317400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "她做医生"
    } ]
  }, {
    "tStartMs": 319633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "又叫我到她跟前"
    } ]
  }, {
    "tStartMs": 322200,
    "dDurationMs": 5333,
    "segs": [ {
      "utf8": "她装模作样的给我打针开药"
    } ]
  }, {
    "tStartMs": 327933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "搞得我哭笑不得"
    } ]
  }, {
    "tStartMs": 332033,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "她又要玩超市游戏"
    } ]
  }, {
    "tStartMs": 334800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "表妹让我当顾客"
    } ]
  }, {
    "tStartMs": 336833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "她当服务员"
    } ]
  }, {
    "tStartMs": 339200,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "我拿出一些要买的物品给表妹"
    } ]
  }, {
    "tStartMs": 343433,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "她用我的电话碰一下物品"
    } ]
  }, {
    "tStartMs": 347100,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "我假装拿出一些钱给她"
    } ]
  }, {
    "tStartMs": 351600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "她接过钱，把物品给我"
    } ]
  }, {
    "tStartMs": 356000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "吃饭的时间到了"
    } ]
  }, {
    "tStartMs": 357833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "我终于不用陪她玩了"
    } ]
  }, {
    "tStartMs": 360866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "谢天谢地"
    } ]
  }, {
    "tStartMs": 362733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "当时的我还贴心的提醒老师"
    } ]
  }, {
    "tStartMs": 365866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "反面还有"
    } ]
  }, {
    "tStartMs": 367466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "这篇作文还没有结束呢"
    } ]
  }, {
    "tStartMs": 372600,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "哎，你说这个表妹烦不烦？"
    } ]
  }, {
    "tStartMs": 378100,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "说实话，我看到题目《陪表妹玩》的时候"
    } ]
  }, {
    "tStartMs": 382633,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "我真的没有想到"
    } ]
  }, {
    "tStartMs": 383866,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "这是一篇有一点抱怨的作文"
    } ]
  }, {
    "tStartMs": 387433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "但是是很真实的情绪"
    } ]
  }, {
    "tStartMs": 390066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是很真实的故事"
    } ]
  }, {
    "tStartMs": 392133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "我读的时候感觉自己"
    } ]
  }, {
    "tStartMs": 394466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "仿佛回到了那个时候"
    } ]
  }, {
    "tStartMs": 397333,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "三年级的我"
    } ]
  }, {
    "tStartMs": 398866,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "9岁的我"
    } ]
  }, {
    "tStartMs": 400333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "没有再继续模仿写作文了"
    } ]
  }, {
    "tStartMs": 403433,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "而是开始真正写发生在自己身上的事"
    } ]
  }, {
    "tStartMs": 408700,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "哎，现在想想"
    } ]
  }, {
    "tStartMs": 410066,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我的表妹也已经成年了"
    } ]
  }, {
    "tStartMs": 413100,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "但当时的我俩其实都是"
    } ]
  }, {
    "tStartMs": 415666,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "差不了太多的小孩子"
    } ]
  }, {
    "tStartMs": 418333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "三年级的时候还有一篇作文"
    } ]
  }, {
    "tStartMs": 420500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "我也想跟你们分享"
    } ]
  }, {
    "tStartMs": 422833,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "题目叫《我的自画像》"
    } ]
  }, {
    "tStartMs": 426433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "不是真的是一幅画"
    } ]
  }, {
    "tStartMs": 428666,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "是一篇介绍自己的作文"
    } ]
  }, {
    "tStartMs": 432500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我是一个平凡的女孩"
    } ]
  }, {
    "tStartMs": 435733,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "今年8周岁了"
    } ]
  }, {
    "tStartMs": 438533,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我梳着蘑菇头"
    } ]
  }, {
    "tStartMs": 441466,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "鼻子小小的"
    } ]
  }, {
    "tStartMs": 443900,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "眼睛也很小"
    } ]
  }, {
    "tStartMs": 446266,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "但是很有神"
    } ]
  }, {
    "tStartMs": 449233,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我这个人急性子"
    } ]
  }, {
    "tStartMs": 452066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "做什么事都匆匆忙忙"
    } ]
  }, {
    "tStartMs": 454733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "但我很有好奇心"
    } ]
  }, {
    "tStartMs": 457066,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "一有什么新鲜事就跑上去凑热闹"
    } ]
  }, {
    "tStartMs": 462400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我呀，兴趣爱好多着呢"
    } ]
  }, {
    "tStartMs": 465666,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "书法、钢琴、素描、英语"
    } ]
  }, {
    "tStartMs": 469800,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "每天晚上都要练一小时钢琴"
    } ]
  }, {
    "tStartMs": 472733,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "一小时书法，真累呀"
    } ]
  }, {
    "tStartMs": 476800,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我最喜欢的运动是跑步、排球"
    } ]
  }, {
    "tStartMs": 480800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "这就是我"
    } ]
  }, {
    "tStartMs": 482333,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "你愿意和我做朋友吗？"
    } ]
  }, {
    "tStartMs": 486033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "当时的老师还给了一个评语"
    } ]
  }, {
    "tStartMs": 489133,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "作文如有具体实例来写自己的特点"
    } ]
  }, {
    "tStartMs": 493633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就生动了"
    } ]
  }, {
    "tStartMs": 495700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "然后给了我一个优减"
    } ]
  }, {
    "tStartMs": 497966,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "你们可别小看这个减号的力量"
    } ]
  }, {
    "tStartMs": 502033,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "当时的“优减”对我来说比“优”差多了"
    } ]
  }, {
    "tStartMs": 507300,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就像c和a的差别一样"
    } ]
  }, {
    "tStartMs": 510633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "但现在看着这篇自我介绍"
    } ]
  }, {
    "tStartMs": 513866,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "感觉现在的我和当时差别也不大嘛"
    } ]
  }, {
    "tStartMs": 518866,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "可能只是发型变了"
    } ]
  }, {
    "tStartMs": 521300,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "更加有耐心了"
    } ]
  }, {
    "tStartMs": 523466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但是还是想找人做朋友"
    } ]
  }, {
    "tStartMs": 525933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "但是我觉得现在对我来说"
    } ]
  }, {
    "tStartMs": 529200,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "自我介绍真的没那么容易了"
    } ]
  }, {
    "tStartMs": 532033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "有好多想说的"
    } ]
  }, {
    "tStartMs": 533766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "不知道跟别人说什么"
    } ]
  }, {
    "tStartMs": 536333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "但是当时多简单"
    } ]
  }, {
    "tStartMs": 538966,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "然后我还发现一件特别有意思的事"
    } ]
  }, {
    "tStartMs": 541733,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "就是你们看这些纸"
    } ]
  }, {
    "tStartMs": 544633,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "它们不是平的"
    } ]
  }, {
    "tStartMs": 546833,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "它们凹凸不平"
    } ]
  }, {
    "tStartMs": 549800,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "因为当时写字"
    } ]
  }, {
    "tStartMs": 551666,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我真的特别用力"
    } ]
  }, {
    "tStartMs": 554066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "一笔一画都写得特别用力"
    } ]
  }, {
    "tStartMs": 558033,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "每一笔都会压到后面几张纸上"
    } ]
  }, {
    "tStartMs": 564566,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "其实你们可以看"
    } ]
  }, {
    "tStartMs": 565833,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "现在我的中指这边还有一个老茧"
    } ]
  }, {
    "tStartMs": 570766,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "快没有了"
    } ]
  }, {
    "tStartMs": 571733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "因为现在写字不太多"
    } ]
  }, {
    "tStartMs": 573800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "但是这个老茧就是小时候用"
    } ]
  }, {
    "tStartMs": 576133,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "右手写字太用力抓笔留下的"
    } ]
  }, {
    "tStartMs": 582600,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "所以啊"
    } ]
  }, {
    "tStartMs": 583266,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "我们中国人小时候学写中文也真的"
    } ]
  }, {
    "tStartMs": 587333,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "是一笔一画写出来、记下来的"
    } ]
  }, {
    "tStartMs": 592433,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "告诉你们一个秘密"
    } ]
  }, {
    "tStartMs": 594200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "其实当时我们学汉字也"
    } ]
  }, {
    "tStartMs": 596833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "经常就是一个字一个词"
    } ]
  }, {
    "tStartMs": 599433,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "要重复写30遍50遍"
    } ]
  }, {
    "tStartMs": 603500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "这是我们的作业"
    } ]
  }, {
    "tStartMs": 606000,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我想"
    } ]
  }, {
    "tStartMs": 607033,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "如果我也给我的学生布置这样的作业"
    } ]
  }, {
    "tStartMs": 611000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "你们会接受吗？"
    } ]
  }, {
    "tStartMs": 613266,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "第三篇，六年级的作文"
    } ]
  }, {
    "tStartMs": 616633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "当时我12岁"
    } ]
  }, {
    "tStartMs": 619200,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "这篇作文我必须要跟你们分享"
    } ]
  }, {
    "tStartMs": 622433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "因为它和其他的作文不太一样"
    } ]
  }, {
    "tStartMs": 625766,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "我写的不再是花草小动物或者我自己"
    } ]
  }, {
    "tStartMs": 630733,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "这篇作文的题目叫"
    } ]
  }, {
    "tStartMs": 633800,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "《我班同学一个月零花钱使用统计》"
    } ]
  }, {
    "tStartMs": 637833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "随着同学们年龄的增长"
    } ]
  }, {
    "tStartMs": 640866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "所需要的东西越来越多"
    } ]
  }, {
    "tStartMs": 643666,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "也要有属于自己的零花钱了"
    } ]
  }, {
    "tStartMs": 646800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你们觉不觉得有种HSK"
    } ]
  }, {
    "tStartMs": 649233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "考试阅读理解的味道"
    } ]
  }, {
    "tStartMs": 652000,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "今天我调查20个身边的同学"
    } ]
  }, {
    "tStartMs": 654866,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "的零花钱数量和使用情况"
    } ]
  }, {
    "tStartMs": 658533,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "有50%的同学每月零花钱是100元以上"
    } ]
  }, {
    "tStartMs": 663533,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "500元以下的"
    } ]
  }, {
    "tStartMs": 665200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "是最多的"
    } ]
  }, {
    "tStartMs": 667166,
    "dDurationMs": 4434,
    "segs": [ {
      "utf8": "有15%的同学是500元及以上的"
    } ]
  }, {
    "tStartMs": 671766,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "我个人认为这有点多了"
    } ]
  }, {
    "tStartMs": 675833,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "我还调查了他们零花钱的使用情况"
    } ]
  }, {
    "tStartMs": 679800,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "有50%的学生使用零花钱主要买吃的"
    } ]
  }, {
    "tStartMs": 685466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "看来他们都是吃货啊"
    } ]
  }, {
    "tStartMs": 688633,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "有30%的学生是用来买自己喜欢"
    } ]
  }, {
    "tStartMs": 693866,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "的乱七八糟的小玩意儿的"
    } ]
  }, {
    "tStartMs": 697000,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "看来同学们不太喜欢学习啊"
    } ]
  }, {
    "tStartMs": 700733,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "用在玩乐上的比较多"
    } ]
  }, {
    "tStartMs": 704333,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "现在的我要敲敲当时的我的小脑袋"
    } ]
  }, {
    "tStartMs": 708433,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "你这个人啊"
    } ]
  }, {
    "tStartMs": 709600,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "怎么能这样想"
    } ]
  }, {
    "tStartMs": 711233,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那么小的我们就应该花钱在玩乐上啊"
    } ]
  }, {
    "tStartMs": 714966,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "花那么多钱在学习上干嘛"
    } ]
  }, {
    "tStartMs": 717533,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "后面那么多年等着花钱在学习上呢"
    } ]
  }, {
    "tStartMs": 722566,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "唉"
    } ]
  }, {
    "tStartMs": 723200,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "可能当时是为了讨好老师才这么写吧"
    } ]
  }, {
    "tStartMs": 727833,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "我觉得家长不应该给予孩子太多钱"
    } ]
  }, {
    "tStartMs": 732566,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "父母赚钱也很辛苦的"
    } ]
  }, {
    "tStartMs": 735466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "哎，到结尾就说教起来了"
    } ]
  }, {
    "tStartMs": 738700,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "不行"
    } ]
  }, {
    "tStartMs": 739733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但这篇作文还真"
    } ]
  }, {
    "tStartMs": 741333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "有点像个小型的调查报告"
    } ]
  }, {
    "tStartMs": 744000,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "在这一个方面还是要"
    } ]
  }, {
    "tStartMs": 745866,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "给当时的我点个赞"
    } ]
  }, {
    "tStartMs": 748433,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小学的最后两年"
    } ]
  }, {
    "tStartMs": 750600,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "我遇到了我当时非常喜欢的语文老师"
    } ]
  }, {
    "tStartMs": 754766,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "现在看这些作文也能看到"
    } ]
  }, {
    "tStartMs": 757600,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "她当时多么会鼓励人"
    } ]
  }, {
    "tStartMs": 760566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "你们看这一篇她写了“好棒呀”"
    } ]
  }, {
    "tStartMs": 763633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "这边有个笑脸"
    } ]
  }, {
    "tStartMs": 765433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "这边也有个笑脸"
    } ]
  }, {
    "tStartMs": 768433,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "这边也说“丫头，真棒！”"
    } ]
  }, {
    "tStartMs": 772966,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "这边也说“相信你是好样的！” 笑脸"
    } ]
  }, {
    "tStartMs": 777533,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "所以我当时写作文也是充满了热情"
    } ]
  }, {
    "tStartMs": 781666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "会在上面画这种搞怪"
    } ]
  }, {
    "tStartMs": 783566,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "的表情和老师互动"
    } ]
  }, {
    "tStartMs": 785933,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "然后我上初中了"
    } ]
  }, {
    "tStartMs": 788633,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "我的语文老师变成了"
    } ]
  }, {
    "tStartMs": 790866,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "一个完全不同风格的老师"
    } ]
  }, {
    "tStartMs": 808633,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "更多圈圈点点"
    } ]
  }, {
    "tStartMs": 811333,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "更多良而不是优"
    } ]
  }, {
    "tStartMs": 814533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "更多圈出的错别字"
    } ]
  }, {
    "tStartMs": 818133,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "圈出的用的不好的词语"
    } ]
  }, {
    "tStartMs": 821433,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "当然完全可以理解"
    } ]
  }, {
    "tStartMs": 823266,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "因为到了初中"
    } ]
  }, {
    "tStartMs": 824833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我们对作文的要求更高"
    } ]
  }, {
    "tStartMs": 827366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "老师肯定希望我们作文"
    } ]
  }, {
    "tStartMs": 829233,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "的水平能上一个台阶"
    } ]
  }, {
    "tStartMs": 832233,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "或者好几个台阶"
    } ]
  }, {
    "tStartMs": 834466,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "希望我们表达的东西更广更深"
    } ]
  }, {
    "tStartMs": 838800,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "现在看我那个阶段的写作并没有多差"
    } ]
  }, {
    "tStartMs": 843233,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "但我可以清楚的记得当时我"
    } ]
  }, {
    "tStartMs": 847066,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "对于写作文的热情并没有很高"
    } ]
  }, {
    "tStartMs": 850266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "甚至是比较抗拒的"
    } ]
  }, {
    "tStartMs": 852433,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我记得当时的老师好像也"
    } ]
  }, {
    "tStartMs": 855333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "不是很喜欢我的写作风格"
    } ]
  }, {
    "tStartMs": 858533,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "当然这种东西本来就是很主观的嘛"
    } ]
  }, {
    "tStartMs": 861766,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "但是还是有篇作文我想跟你们分享"
    } ]
  }, {
    "tStartMs": 865166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "第四篇作文"
    } ]
  }, {
    "tStartMs": 866800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "七年级的"
    } ]
  }, {
    "tStartMs": 868466,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "13岁的我写的"
    } ]
  }, {
    "tStartMs": 871766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "题目叫《罚抄的领悟》"
    } ]
  }, {
    "tStartMs": 876233,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "罚抄你们知道是什么东西吗？"
    } ]
  }, {
    "tStartMs": 878933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "就是惩罚你抄写"
    } ]
  }, {
    "tStartMs": 881200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "就是你做错了一道题"
    } ]
  }, {
    "tStartMs": 883466,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "尤其是那种你非常不应该错的"
    } ]
  }, {
    "tStartMs": 886800,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "老师为了让你深刻的记住这个错误"
    } ]
  }, {
    "tStartMs": 890566,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "从错误中学习"
    } ]
  }, {
    "tStartMs": 892666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "会让你罚抄这个题目"
    } ]
  }, {
    "tStartMs": 895333,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那罚抄到底是怎样的体验呢？"
    } ]
  }, {
    "tStartMs": 897666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "我们来读一下吧"
    } ]
  }, {
    "tStartMs": 901866,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "今天数学作业发下来"
    } ]
  }, {
    "tStartMs": 904866,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "上面有四个鲜红的字映入我眼帘"
    } ]
  }, {
    "tStartMs": 908933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "订正10遍"
    } ]
  }, {
    "tStartMs": 911000,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "我顿时感到跌到了万丈深渊"
    } ]
  }, {
    "tStartMs": 914366,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "脸上一黑"
    } ]
  }, {
    "tStartMs": 917400,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "赶紧拿出本子奋笔疾书起来"
    } ]
  }, {
    "tStartMs": 921233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "没过多久"
    } ]
  }, {
    "tStartMs": 922600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "我画了一半了"
    } ]
  }, {
    "tStartMs": 924600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "语文课开始了"
    } ]
  }, {
    "tStartMs": 926966,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "老师叫我们默新课文的单词"
    } ]
  }, {
    "tStartMs": 930166,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "这课单词都很难"
    } ]
  }, {
    "tStartMs": 932200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "我还没预习就开默了"
    } ]
  }, {
    "tStartMs": 935366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "一共默5个"
    } ]
  }, {
    "tStartMs": 936933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我就错了两个"
    } ]
  }, {
    "tStartMs": 939266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "全班只有几个同学全对"
    } ]
  }, {
    "tStartMs": 942833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这里我要说一句"
    } ]
  }, {
    "tStartMs": 944600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "所以你们可以看到"
    } ]
  }, {
    "tStartMs": 946800,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "中国人也很难记住一些字怎么写的"
    } ]
  }, {
    "tStartMs": 950733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "老师便很生气"
    } ]
  }, {
    "tStartMs": 952600,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "要求我们把课后的词语每个抄5遍"
    } ]
  }, {
    "tStartMs": 956466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "我当时就傻眼了"
    } ]
  }, {
    "tStartMs": 959133,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "下课后我使劲的抄写"
    } ]
  }, {
    "tStartMs": 962266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "外面的朋友都在活动"
    } ]
  }, {
    "tStartMs": 965066,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我还是抑制住玩的欲望"
    } ]
  }, {
    "tStartMs": 967866,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "笔头快速的移动"
    } ]
  }, {
    "tStartMs": 970833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "终于在放学前"
    } ]
  }, {
    "tStartMs": 972833,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我全部写完了"
    } ]
  }, {
    "tStartMs": 975200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "如释重负"
    } ]
  }, {
    "tStartMs": 976966,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "最搞笑的是当时的老师给我的评语是"
    } ]
  }, {
    "tStartMs": 981133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "吃一堑长一智"
    } ]
  }, {
    "tStartMs": 984533,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "意思就是"
    } ]
  }, {
    "tStartMs": 986000,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "当你从一个事情中间吃了教训"
    } ]
  }, {
    "tStartMs": 990266,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "你才能记住"
    } ]
  }, {
    "tStartMs": 991833,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "下次不再犯错误"
    } ]
  }, {
    "tStartMs": 994233,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "接下来就是高中"
    } ]
  }, {
    "tStartMs": 996333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我记得到了高中"
    } ]
  }, {
    "tStartMs": 998166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我写作文的兴趣又上去了"
    } ]
  }, {
    "tStartMs": 1001133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我又比较喜欢写了"
    } ]
  }, {
    "tStartMs": 1003433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "因为当时遇到了欣赏"
    } ]
  }, {
    "tStartMs": 1005200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我写作风格的老师"
    } ]
  }, {
    "tStartMs": 1007300,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "而且我也有非常多东西想讨论"
    } ]
  }, {
    "tStartMs": 1010433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "想去表达"
    } ]
  }, {
    "tStartMs": 1012000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "你们也可以看到当时高中我"
    } ]
  }, {
    "tStartMs": 1014533,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "的字迹发生了很大的变化"
    } ]
  }, {
    "tStartMs": 1017433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "其实还挺潦草的"
    } ]
  }, {
    "tStartMs": 1019766,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "现在让我看有些字都"
    } ]
  }, {
    "tStartMs": 1022933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "要花几秒才能看懂"
    } ]
  }, {
    "tStartMs": 1026266,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "当时我写作的兴趣也发生了变化"
    } ]
  }, {
    "tStartMs": 1029733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我变得更理性了"
    } ]
  }, {
    "tStartMs": 1031666,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我喜欢去写议论文"
    } ]
  }, {
    "tStartMs": 1034266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "当然议论文也是高中我们"
    } ]
  }, {
    "tStartMs": 1037033,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "才会着重去训练的东西"
    } ]
  }, {
    "tStartMs": 1041433,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "我变得不那么喜欢写太长的故事"
    } ]
  }, {
    "tStartMs": 1046000,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "反而我喜欢去抓住一个点"
    } ]
  }, {
    "tStartMs": 1048666,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "把它向深了挖"
    } ]
  }, {
    "tStartMs": 1050833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "向深了讨论"
    } ]
  }, {
    "tStartMs": 1052466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "当时我还有一件很迷恋的事"
    } ]
  }, {
    "tStartMs": 1055833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "就是喜欢把中文写的很高级"
    } ]
  }, {
    "tStartMs": 1060633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "甚至比较艰深"
    } ]
  }, {
    "tStartMs": 1062933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "给你们来读一段"
    } ]
  }, {
    "tStartMs": 1065366,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "这应该是高二的作文本"
    } ]
  }, {
    "tStartMs": 1069200,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "很奇怪，难道我们的内心世界"
    } ]
  }, {
    "tStartMs": 1072266,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "不应本就是自由国度吗？"
    } ]
  }, {
    "tStartMs": 1075966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "何以就成了围城？"
    } ]
  }, {
    "tStartMs": 1078766,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "而再回到我关闭朋友圈后"
    } ]
  }, {
    "tStartMs": 1081566,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "为什么会不安的问题"
    } ]
  }, {
    "tStartMs": 1084400,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "究其因是我内心有鬼"
    } ]
  }, {
    "tStartMs": 1087766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "审视自己的邪鬼"
    } ]
  }, {
    "tStartMs": 1089900,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "而非什么手持天平的明眼人"
    } ]
  }, {
    "tStartMs": 1093600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我自认为不可见之于人的东西"
    } ]
  }, {
    "tStartMs": 1097100,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "是我自己最不愿也最不敢直面之物"
    } ]
  }, {
    "tStartMs": 1101300,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "天呐"
    } ]
  }, {
    "tStartMs": 1102033,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "我这个语言也太复杂了"
    } ]
  }, {
    "tStartMs": 1104800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "就是它甚至不是现代人"
    } ]
  }, {
    "tStartMs": 1107233,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "在写作时会常用的语言"
    } ]
  }, {
    "tStartMs": 1110066,
    "dDurationMs": 5434,
    "segs": [ {
      "utf8": "它有点位于古代汉语和现代汉语之间"
    } ]
  }, {
    "tStartMs": 1115500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "现在我觉得高级的语言"
    } ]
  }, {
    "tStartMs": 1117133,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "反而是简单的清楚的"
    } ]
  }, {
    "tStartMs": 1120633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "而且如果我还是用这么复杂的语言"
    } ]
  }, {
    "tStartMs": 1123633,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我是不可能去教人中文的"
    } ]
  }, {
    "tStartMs": 1126900,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "但怎么办呢"
    } ]
  }, {
    "tStartMs": 1128433,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "我当时就是喜欢这样的语言"
    } ]
  }, {
    "tStartMs": 1132500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "我现在也不可能去批评当时的我"
    } ]
  }, {
    "tStartMs": 1135733,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "每个人在不同阶段都会有不同的想法"
    } ]
  }, {
    "tStartMs": 1140933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "当时的我喜欢长句"
    } ]
  }, {
    "tStartMs": 1142733,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "喜欢引用"
    } ]
  }, {
    "tStartMs": 1144033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "喜欢让一句话显得很有分量"
    } ]
  }, {
    "tStartMs": 1147466,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "觉得一句话长、复杂就等于深刻"
    } ]
  }, {
    "tStartMs": 1152200,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "所以从小学到高中"
    } ]
  }, {
    "tStartMs": 1157000,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "我的中文写作水平到底变了多少呢？"
    } ]
  }, {
    "tStartMs": 1162300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "我只能说"
    } ]
  }, {
    "tStartMs": 1163433,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我看到的变化不是一条线性的变化"
    } ]
  }, {
    "tStartMs": 1167300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "也不是说我的水平越来越高"
    } ]
  }, {
    "tStartMs": 1170333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我的写作越来越高级的变化"
    } ]
  }, {
    "tStartMs": 1174100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "我看到的更多是我和"
    } ]
  }, {
    "tStartMs": 1176566,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "写作之间关系的变化"
    } ]
  }, {
    "tStartMs": 1179133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "觉得看到这些对你们来说"
    } ]
  }, {
    "tStartMs": 1181666,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "应该也挺有意思的"
    } ]
  }, {
    "tStartMs": 1184500,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "也许这可以让你们感受到"
    } ]
  }, {
    "tStartMs": 1187600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "学一门语言不仅仅是"
    } ]
  }, {
    "tStartMs": 1190200,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "从简单走向高级，或者走向复杂"
    } ]
  }, {
    "tStartMs": 1194733,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "它更多是让你去慢慢的学会"
    } ]
  }, {
    "tStartMs": 1198233,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "怎么更好的去用语言表达自己"
    } ]
  }, {
    "tStartMs": 1202566,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "表现自己"
    } ]
  }, {
    "tStartMs": 1204233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "怎么让你去感受"
    } ]
  }, {
    "tStartMs": 1207966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "越来越多"
