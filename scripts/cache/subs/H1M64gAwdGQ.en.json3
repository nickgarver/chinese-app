    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "become a little more closed off,"
    } ]
  }, {
    "tStartMs": 671066,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "especially in the last two years."
    } ]
  }, {
    "tStartMs": 673366,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "My life has changed a lot,"
    } ]
  }, {
    "tStartMs": 676800,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "which has made me"
    } ]
  }, {
    "tStartMs": 679733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "even more closed off"
    } ]
  }, {
    "tStartMs": 681933,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "in some ways."
    } ]
  }, {
    "tStartMs": 682966,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "I'm wondering if"
    } ]
  }, {
    "tStartMs": 684266,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "this closed-off state is a good thing or a bad thing"
