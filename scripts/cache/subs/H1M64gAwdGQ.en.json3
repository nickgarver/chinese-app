    "segs": [ {
      "utf8": "taken my Freetalk classes,"
    } ]
  }, {
    "tStartMs": 642800,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "but they've never left"
    } ]
  }, {
    "tStartMs": 644200,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "comments on my channel."
    } ]
  }, {
    "tStartMs": 645966,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "I feel honored that"
    } ]
  }, {
    "tStartMs": 648600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "many friends have had a pleasant chat with me"
    } ]
  }, {
    "tStartMs": 651000,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": ". My experiences can attract some people"
    } ]
  }, {
    "tStartMs": 654300,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "and keep them"
    } ]
  }, {
    "tStartMs": 655933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "curious about the world."
    } ]
  }, {
    "tStartMs": 658133,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "But in recent conversations,"
    } ]
  }, {
    "tStartMs": 661500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I've realized that"
    } ]
  }, {
    "tStartMs": 663900,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "compared to my twenties,"
    } ]
  }, {
    "tStartMs": 667300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "I feel my world has"
