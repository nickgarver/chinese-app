  }, {
    "tStartMs": 598166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "I can't open my eyes"
    } ]
  }, {
    "tStartMs": 600166,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": ", my eyes water constantly"
    } ]
  }, {
    "tStartMs": 602700,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": ", and my nose runs."
    } ]
  }, {
    "tStartMs": 605100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "These are all my allergy symptoms."
    } ]
  }, {
    "tStartMs": 608233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Recently, it's gotten much better"
    } ]
  }, {
    "tStartMs": 609900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": ", and the weather has warmed up,"
    } ]
  }, {
    "tStartMs": 611900,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "so I'm more willing to go out."
    } ]
  }, {
    "tStartMs": 614366,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "I've recently"
    } ]
  }, {
    "tStartMs": 616833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "gone to the gym,"
    } ]
  }, {
    "tStartMs": 618666,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "and"
    } ]
  }, {
    "tStartMs": 619233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "I've also resumed my weekly swimming routine"
    } ]
  }, {
    "tStartMs": 622066,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": ". I still need to exercise"
    } ]
  }, {
    "tStartMs": 624800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "to stay healthy."
    } ]
  }, {
    "tStartMs": 627300,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "I 'm very grateful to the YouTube viewers who"
    } ]
  }, {
    "tStartMs": 631666,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "have supported my educational endeavors."
    } ]
  }, {
    "tStartMs": 636166,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "Some friends have booked classes on my Italki channel or"
    } ]
  }, {
