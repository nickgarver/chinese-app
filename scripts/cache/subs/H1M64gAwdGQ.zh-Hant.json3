    "segs": [ {
      "utf8": "hello hello"
    } ]
  }, {
    "tStartMs": 2033,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "大家好我是貓咪卡"
    } ]
  }, {
    "tStartMs": 4466,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "歡迎來到我的頻道"
    } ]
  }, {
    "tStartMs": 7800,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "今天呢想要和大家更新一期vlog"
    } ]
  }, {
    "tStartMs": 11000,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "因為呢我剛剛從健身房健身回來"
    } ]
  }, {
    "tStartMs": 16866,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "最近我發現我們家附近呢"
    } ]
  }, {
    "tStartMs": 19866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "開了一家新的健身房"
    } ]
  }, {
    "tStartMs": 22500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "然後環境不錯"
    } ]
  }, {
    "tStartMs": 24400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "嗯我想著春天來了"
    } ]
  }, {
    "tStartMs": 26833,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我 這一隻冬眠的動物可以"
    } ]
  }, {
    "tStartMs": 30466,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "出洞了"
    } ]
  }, {
    "tStartMs": 31333,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "可以出門去看"
    } ]
  }, {
    "tStartMs": 33900,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "啊我"
    } ]
  }, {
    "tStartMs": 37300,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "會"
    } ]
  }, {
    "tStartMs": 38000,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "去這"
    } ]
  }, {
    "tStartMs": 42133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "家健身房"
    } ]
  }, {
    "tStartMs": 44466,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "做飯"
    } ]
  }, {
    "tStartMs": 46533,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "的人"
    } ]
  }, {
    "tStartMs": 49233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "那我要從爸爸"
    } ]
  }, {
    "tStartMs": 52333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "回家常回家吃飯"
    } ]
  }, {
    "tStartMs": 54133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那我今天呢"
    } ]
  }, {
    "tStartMs": 54933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "想要給大家分享一下"
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "自己做一個快手餐"
    } ]
  }, {
    "tStartMs": 59466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "首先呢"
    } ]
  }, {
    "tStartMs": 60266,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "想要和大家來分享一下今天的食材"
    } ]
  }, {
    "tStartMs": 66600,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "這個呢是一盒鮭魚碎肉"
    } ]
  }, {
    "tStartMs": 69966,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "就是切碎的三文魚肉"
    } ]
  }, {
    "tStartMs": 73933,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "然後呢這個是雞蛋嗯"
    } ]
  }, {
    "tStartMs": 78200,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "這個呢是捲餅"
    } ]
  }, {
    "tStartMs": 80966,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "大家可以看哦"
    } ]
  }, {
    "tStartMs": 82033,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "這個是需要冷凍保存的"
    } ]
  }, {
    "tStartMs": 85800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "捲餅"
    } ]
  }, {
    "tStartMs": 87333,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "嗯我感覺這個捲餅應該很健康"
    } ]
  }, {
    "tStartMs": 91533,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "它上面寫著蛋白質很高"
    } ]
  }, {
    "tStartMs": 95533,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "然後呢GI值又很低"
    } ]
  }, {
    "tStartMs": 100433,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "然後這個呢"
    } ]
  }, {
    "tStartMs": 101633,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "是一包沙拉菜"
    } ]
  }, {
    "tStartMs": 103966,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "我很喜歡吃這個芝麻菜"
    } ]
  }, {
    "tStartMs": 108066,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "我很喜歡吃這種沙拉菜裡面的芝麻菜"
