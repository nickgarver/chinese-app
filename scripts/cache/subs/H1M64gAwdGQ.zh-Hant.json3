  }, {
    "tStartMs": 115166,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "一罐 這個辣醬"
    } ]
  }, {
    "tStartMs": 118333,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 119200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我等一下會來做一個捲餅"
    } ]
  }, {
    "tStartMs": 123433,
    "dDurationMs": 5833,
    "segs": [ {
      "utf8": "就是雞蛋炒三文魚捲餅"
