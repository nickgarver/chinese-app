{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1000,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "hello大家好。好久好久不见了\nhello dàjiā hǎo. hǎojiǔ hǎojiǔbujiàn le"
    } ]
  }, {
    "tStartMs": 5466,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "我好久好久没有录vlog了\nwǒ hǎojiǔ hǎojiǔ méiyǒu lù vlog le"
    } ]
  }, {
    "tStartMs": 20266,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "那这几天\nnà zhèjǐtiān"
    } ]
  }, {
    "tStartMs": 21766,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "我在进行一个短途旅行\nwǒ zài jìnxíng yígè duǎn tú lǔxíng"
    } ]
  }, {
    "tStartMs": 25800,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "我在镇江\nwǒ zài zhènjiāng"
    } ]
  }, {
    "tStartMs": 28666,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "这个地方在上海的西北部\nzhège dìfāng zài shànghǎi de xīběibù"
    } ]
  }, {
    "tStartMs": 34566,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "离上海坐火车大概只要一个半小时\nlí shànghǎi zuò huǒchē dàgài zhǐyào yígè bànxiǎoshí"
    } ]
  }, {
    "tStartMs": 39066,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我住的酒店就在镇江\nwǒ zhù de jiǔdiàn jiù zài zhènjiāng"
    } ]
  }, {
    "tStartMs": 42500,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "最著名的一个景点旁边\nzuì zhùmíng de yígè jǐngdiǎn pángbiān"
    } ]
  }, {
    "tStartMs": 45700,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "这个景点叫做西津渡\nzhège jǐngdiǎn jiàozuò xī jīn dù"
    } ]
  }, {
    "tStartMs": 49100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "在古代是一个渡口\nzài gǔdài shì yígè dùkǒu"
    } ]
  }, {
    "tStartMs": 52966,
    "dDurationMs": 4734,
    "segs": [ {
      "utf8": "所以镇江在古代其实挺重要的\nsuǒyǐ zhènjiāng zài gǔdài qíshí tǐng zhòngyào de"
    } ]
  }, {
    "tStartMs": 58066,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "但我猜你们现在应该\ndàn wǒ cāi nǐmen xiànzài yīnggāi"
    } ]
  }, {
    "tStartMs": 60566,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "没有多少人听过这个城市\nméiyǒu duōshǎo rén tīng guò zhège chéngshì"
    } ]
  }, {
    "tStartMs": 64033,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "所以今天我就想带你们一起看一看\nsuǒyǐ jīntiān wǒ jiù xiǎng dài nǐmen yīqǐ kànyīkàn"
    } ]
  }, {
    "tStartMs": 68500,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "西津渡现在是一个\nxī jīn dù xiànzài shì yígè"
    } ]
  }, {
    "tStartMs": 71833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "像商业古街一样的地方\nxiàng shāngyè gǔ jiē yīyàng de dìfāng"
    } ]
  }, {
    "tStartMs": 75066,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "其实这样的古街\nqíshí zhèyàng de gǔ jiē"
    } ]
  }, {
    "tStartMs": 76633,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "现在在中国很多景点都非常常见\nxiànzài zài zhōngguó hěn duō jǐngdiǎn dōu fēicháng chángjiàn"
    } ]
  }, {
    "tStartMs": 81166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "而且很多看起来都很像\nérqiě hěn duō kànqǐlai dōu hěn xiàng"
    } ]
  }, {
    "tStartMs": 85366,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "但好在今天是周一\ndàn hǎozài jīntiān shì zhōuyī"
    } ]
  }, {
    "tStartMs": 89100,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "和以前周末来旅游不一样\nhé yǐqián zhōumò lái lǔyóu bùyīyàng"
    } ]
  }, {
    "tStartMs": 92633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "人少很多\nrén shǎo hěn duō"
    } ]
  }, {
    "tStartMs": 95366,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "但也不是特别特别少\ndàn yě bùshì tèbié tèbié shǎo"
    } ]
  }, {
    "tStartMs": 98800,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "所以对我来说就有一种刚刚好的氛围\nsuǒyǐ duìwǒláishuō jiù yǒu yīzhǒng gānggang hǎo de fēnwéi"
    } ]
  }, {
    "tStartMs": 104766,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "那像这样一条老街\nnà xiàng zhèyàng yī tiáo lǎojiē"
    } ]
  }, {
    "tStartMs": 107933,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "现在就主要是传统\nxiànzài jiù zhǔyào shì chuántǒng"
    } ]
  }, {
    "tStartMs": 110866,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "民居和一些商铺饭店\nmínjū hé yīxiē shāngpù fàndiàn"
    } ]
  }, {
    "tStartMs": 114833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "民宿的结合\nmínsù de jiéhé"
    } ]
  }, {
    "tStartMs": 116766,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "有很多民宿\nyǒu hěn duō mínsù"
    } ]
  }, {
    "tStartMs": 118600,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "他们一楼是咖啡厅或者酒吧\ntāmen yī lóu shì kāfēitīng huòzhě jiǔbā"
    } ]
  }, {
    "tStartMs": 122666,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "二楼三楼或者更高的\nèr lóu sān lóu huòzhě gèng gāo de"
    } ]
  }, {
    "tStartMs": 125333,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "楼层就是住宿的地方\nlóucéng jiùshì zhùsù de dìfāng"
    } ]
  }, {
    "tStartMs": 128866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "和很多地方一样\nhé hěn duō dìfāng yīyàng"
    } ]
  }, {
    "tStartMs": 130733,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "这里的星巴克也建成了\nzhèlǐ de xīngbākè yě jiànchéng le"
    } ]
  }, {
    "tStartMs": 134633,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "和当地建筑风格匹配的样子\nhé dāngdì jiànzhù fēnggé pǐpèi de yàngzi"
    } ]
  }, {
    "tStartMs": 140133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "包括麦当劳也是\nbāokuò màidāngláo yě shì"
    } ]
  }, {
    "tStartMs": 143533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "在我的印象中\nzài wǒ de yìnxiàng zhōng"
    } ]
  }, {
    "tStartMs": 145333,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "肯德基做的本地化的尝试\nkěndéjī zuò de běndìhuà de chángshì"
    } ]
  }, {
    "tStartMs": 149966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "其实是比麦当劳更多的\nqíshí shì bǐ màidāngláo gèng duō de"
    } ]
  }, {
    "tStartMs": 152433,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "但我觉得这样的建筑设计应该也是\ndàn wǒ juéde zhèyàng de jiànzhù shèjì yīnggāi yě shì"
    } ]
  }, {
    "tStartMs": 155633,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "麦当劳做的一个本地化的尝试吧\nmàidāngláo zuò de yígè běndìhuà de chángshì ba"
    } ]
  }, {
    "tStartMs": 160866,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "你们看这里有一个小小的装饰\nnǐmen kàn zhèlǐ yǒu yígè xiǎoxiǎo de zhuāngshì"
    } ]
  }, {
    "tStartMs": 166066,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "这个写的是篆书\nzhège xiě de shì zhuànshū"
    } ]
  }, {
    "tStartMs": 169366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "我大概能认出来\nwǒ dàgài néng rènchū lái"
    } ]
  }, {
    "tStartMs": 171200,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "它写的就是“西津渡码头”\ntā xiě de jiùshì \"xī jīn dù mǎtóu\""
    } ]
  }, {
    "tStartMs": 178433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "这边有一座雕塑\nzhèbiān yǒu yī zuò diāosù"
    } ]
  }, {
    "tStartMs": 181733,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "我觉得应该就是以前码头的\nwǒ juéde yīnggāi jiùshì yǐqián mǎtóu de"
    } ]
  }, {
    "tStartMs": 187166,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "码头的船夫的样子\nmǎtóu de chuánfū de yàngzi"
    } ]
  }, {
    "tStartMs": 191766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这一块特别安静\nzhè yīkuài tèbié ānjìng"
    } ]
  }, {
    "tStartMs": 195233,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "这里眼前就是一片绿意\nzhèlǐ yǎnqián jiùshì yī piàn lǜ yì"
    } ]
  }, {
    "tStartMs": 199766,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "如果我们看到眼前有\nrúguǒ wǒmen kàn dào yǎnqián yǒu"
    } ]
  }, {
    "tStartMs": 202400,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "一大片绿色的植物\nyī dàpiàn lùsè de zhíwù"
    } ]
  }, {
    "tStartMs": 205166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "一大片绿色的自然的景观\nyī dàpiàn lùsè de zìrán de jǐngguān"
    } ]
  }, {
    "tStartMs": 207866,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "我们就可以说眼前有一片绿意\nwǒmen jiù kěyǐ shuō yǎnqián yǒu yī piàn lǜ yì"
    } ]
  }, {
    "tStartMs": 211833,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这是比较诗意的说法\nzhè shì bǐjiào shīyì de shuōfa"
    } ]
  }, {
    "tStartMs": 214966,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "但是古街我今天想带你们就看到这里\ndànshì gǔ jiē wǒ jīntiān xiǎng dài nǐmen jiù kàn dào zhèlǐ"
    } ]
  }, {
    "tStartMs": 220000,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "现在我要去一个我更期待的地方\nxiànzài wǒ yào qù yígè wǒ gèng qīdài de dìfāng"
    } ]
  }, {
    "tStartMs": 224366,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "也希望是一个更安静的地方\nyě xīwàng shì yígè gèng ānjìng de dìfāng"
    } ]
  }, {
    "tStartMs": 229366,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "好的，现在我们到了\nhǎo de, xiànzài wǒmen dàoliǎo"
    } ]
  }, {
    "tStartMs": 232466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "我们今天的第二个地方\nwǒmen jīntiān de dìèr gè dìfāng"
    } ]
  }, {
    "tStartMs": 235266,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "这个地方叫焦山\nzhège dìfāng jiào jiāo shān"
    } ]
  }, {
    "tStartMs": 237866,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "就是后面那座山\njiùshì hòumiàn nà zuò shān"
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "我们现在要等渡船过来\nwǒmen xiànzài yào děng dùchuán guòlai"
    } ]
  }, {
    "tStartMs": 243133,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "接我们去那座山\njiē wǒmen qù nà zuò shān"
    } ]
  }, {
    "tStartMs": 246000,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "其实镇江有三座比较有名的山\nqíshí zhènjiāng yǒu sān zuò bǐjiào yǒumíng de shān"
    } ]
  }, {
    "tStartMs": 251133,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "但是我选这里是因为这座山\ndànshì wǒ xuǎn zhèlǐ shì yīnwèi zhè zuò shān"
    } ]
  }, {
    "tStartMs": 255433,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "是唯一一座在长江中的山\nshì wéiyī yī zuò zài chángjiāng zhòngdì shān"
    } ]
  }, {
    "tStartMs": 260366,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "它被江水环绕\ntā bèi jiāngshuǐ huánrào"
    } ]
  }, {
    "tStartMs": 264166,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "所以我觉得比较特别\nsuǒyǐ wǒ juéde bǐjiào tèbié"
    } ]
  }, {
    "tStartMs": 266533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "比较吸引我\nbǐjiào xīyǐn wǒ"
    } ]
  }, {
    "tStartMs": 268366,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "那也有的人把这座山叫做“江中浮玉”\nnà yě yǒude rén bǎ zhè zuò shān jiàozuò \"jiāng zhōng fú yù\""
    } ]
  }, {
    "tStartMs": 273566,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "就是浮在江中的一块玉\njiùshì fú zài jiāng zhòngdì yīkuài yù"
    } ]
  }, {
    "tStartMs": 278166,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "可以看到现在渡船向我们开过来了\nkěyǐ kàn dàoxiànzài dùchuán xiàng wǒmen kāi guòlai le"
    } ]
  }, {
    "tStartMs": 289600,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "现在我们上船啦\nxiànzài wǒmen shàngchuán la"
    } ]
  }, {
    "tStartMs": 316200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "现在准备靠岸\nxiànzài zhǔnbèi kàoàn"
    } ]
  }, {
    "tStartMs": 321366,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "现在我们到焦山门口了\nxiànzài wǒmen dào jiāo shānmén kǒu le"
    } ]
  }, {
    "tStartMs": 326666,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "这就是大门口\nzhè jiùshì dàmén kǒu"
    } ]
  }, {
    "tStartMs": 330333,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "上面从右往左写着“焦山胜境”\nshàngmiàn cóng yòu wǎng zuǒ xiě zhe \"jiāo shān shèng jìng\""
    } ]
  }, {
    "tStartMs": 337166,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "“胜境”一般就是用来形容一个特别好\n\"shèng jìng\" yībān jiùshì yònglái xíngróng yígè tèbié hǎo"
    } ]
  }, {
    "tStartMs": 340366,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "特别美的地方\ntèbié měidí dìfāng"
    } ]
  }, {
    "tStartMs": 343466,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "你们应该会注意到很多中国\nnǐmen yīnggāi huì zhùyì dào hěn duō zhōngguó"
    } ]
  }, {
    "tStartMs": 346033,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "的景区都有这样的石狮子\nde jǐngqū dōu yǒu zhèyàng de shíshīzi"
    } ]
  }, {
    "tStartMs": 349566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "其实是一对\nqíshí shì yīduì"
    } ]
  }, {
    "tStartMs": 351966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "一公一母\nyī gōng yī mǔ"
    } ]
  }, {
    "tStartMs": 355133,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "母狮子的脚下一般都有一头小狮子\nmǔ shīzi de jiǎoxià yībān dōu yǒu yītóu xiǎo shīzi"
    } ]
  }, {
    "tStartMs": 360966,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "而公狮子的脚下一般都会踩着一个球\nér gōng shīzi de jiǎoxià yībān dūhuì cǎi zhe yígè qiú"
    } ]
  }, {
    "tStartMs": 369566,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "这边还有更多石雕的狮子\nzhèbiān háiyǒu gèng duō shídiāo de shīzi"
    } ]
  }, {
    "tStartMs": 374733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "撅着屁股的狮子\njuē zhe pìgu de shīzi"
    } ]
  }, {
    "tStartMs": 379333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "现在我们进了山\nxiànzài wǒmen jìn le shān"
    } ]
  }, {
    "tStartMs": 381433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "因为有了树荫\nyīnwèi yǒule shùyìn"
    } ]
  }, {
    "tStartMs": 383866,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "终于感觉凉快多了\nzhōngyú gǎnjué liángkuai duō le"
    } ]
  }, {
    "tStartMs": 391033,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "这边还有一个佛学院\nzhèbiān háiyǒu yígè fóxué yuàn"
    } ]
  }, {
    "tStartMs": 406966,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "再往前走就是一座寺庙\nzài wǎngqián zǒu jiùshì yī zuò sìmiào"
    } ]
  }, {
    "tStartMs": 411000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这座寺庙叫定慧寺\nzhè zuò sìmiào jiào dìng huì sì"
    } ]
  }, {
    "tStartMs": 414566,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "有三个石桥通向它\nyǒu sānge shí qiáo tōngxiàng tā"
    } ]
  }, {
    "tStartMs": 420033,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "定慧寺后面又有一座塔\ndìng huì sì hòumiàn yòu yǒu yī zuò tǎ"
    } ]
  }, {
    "tStartMs": 424733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "现在我进来\nxiànzài wǒ jìnlái"
    } ]
  }, {
    "tStartMs": 426966,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "整体的感受就是\nzhěngtǐ de gǎnshòu jiùshì"
    } ]
  }, {
    "tStartMs": 429566,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "整个景区非常有层次\nzhěnggè jǐngqū fēicháng yǒu céngcì"
    } ]
  }, {
    "tStartMs": 432633,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "走进来一层又一层的\nzǒujìn lái yīcéng yòu yīcéng de"
    } ]
  }, {
    "tStartMs": 436566,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "每一个地方都是景色\nměiyī gè dìfāng dōu shì jǐngsè"
    } ]
  }, {
    "tStartMs": 443133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "这些都是用来烧香的\nzhèxiē dōu shì yònglái shāoxiāng de"
    } ]
  }, {
    "tStartMs": 448633,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但可能因为今天是周一吧\ndàn kěnéng yīnwèi jīntiān shì zhōuyī ba"
    } ]
  }, {
    "tStartMs": 451833,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "没有什么人来烧香\nméiyǒushénme rén lái shāoxiāng"
    } ]
  }, {
    "tStartMs": 455033,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "你更多看到的是这里的\nnǐ gèng duō kàn dào de shì zhèlǐ de"
    } ]
  }, {
    "tStartMs": 457733,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "工作人员或者一些僧侣走来走去\ngōngzuòrényuán huòzhě yīxiē sēnglǔ zǒu lái zǒuqù"
    } ]
  }, {
    "tStartMs": 464433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "游客很少\nyóukè hěn shǎo"
    } ]
  }, {
    "tStartMs": 467400,
    "dDurationMs": 6666,
    "segs": [ {
      "utf8": "你们看这个寺庙前面也有一对石狮子\nnǐmen kàn zhège sìmiào qiánmiàn yě yǒu yīduì shíshīzi"
    } ]
  }, {
    "tStartMs": 474633,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "只不过比我们刚刚在\nzhǐbuguò bǐ wǒmen gānggang zài"
    } ]
  }, {
    "tStartMs": 476833,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "门口看到的小多了\nménkǒu kàn dào de xiǎo duō le"
    } ]
  }, {
    "tStartMs": 481000,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "我们发现了一只非常亲人的小猫\nwǒmen fāxiàn le yìzhī fēicháng qīnrén de xiǎomāo"
    } ]
  }, {
    "tStartMs": 486200,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "而且因为听说这上面有一些猫\nérqiě yīnwèi tīngshuō zhè shàngmiàn yǒuyīxiē māo"
    } ]
  }, {
    "tStartMs": 490866,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "所以我提前准备了食物（猫粮）\nsuǒyǐ wǒ tíqián zhǔnbèi le shíwù (māo liáng)"
    } ]
  }, {
    "tStartMs": 496733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "啊，等一下\na, děngyīxià"
    } ]
  }, {
    "tStartMs": 497733,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我解不开\nwǒ jiě bù kāi"
    } ]
  }, {
    "tStartMs": 506566,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "但不知道他现在饿不饿\ndàn bùzhī dào tā xiànzài è bù è"
    } ]
  }, {
    "tStartMs": 510033,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "等一下哦\nděngyīxià ó"
    } ]
  }, {
    "tStartMs": 513833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "他现在躺下来了\ntā xiànzài tǎngxià lái le"
    } ]
  }, {
    "tStartMs": 515800,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "非常放松\nfēicháng fàngsōng"
    } ]
  }, {
    "tStartMs": 519733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "等一下哦\nděngyīxià ó"
    } ]
  }, {
    "tStartMs": 524633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我就放一点吧\nwǒ jiù fàng yīdiǎn ba"
    } ]
  }, {
    "tStartMs": 526066,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "不然把这边的环境弄脏了\nbùrán bǎ zhèbiān de huánjìng nòngzāng le"
    } ]
  }, {
    "tStartMs": 542200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "但我觉得这边的人\ndàn wǒ juéde zhèbiān de rén"
    } ]
  }, {
    "tStartMs": 543766,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "应该也有在规律的喂它\nyīnggāi yě yǒu zài guīlù de wèi tā"
    } ]
  }, {
    "tStartMs": 549766,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "看起来被养的挺好的\nkànqǐlai bèi yǎng de tǐnghǎo de"
    } ]
  }, {
    "tStartMs": 561733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "吃完了\nchīwán le"
    } ]
  }, {
    "tStartMs": 564466,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "很满足的样子\nhěn mǎnzú de yàngzi"
    } ]
  }, {
    "tStartMs": 569833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "你想打招呼吗？\nnǐ xiǎng dǎzhāohu ma?"
    } ]
  }, {
    "tStartMs": 580800,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "哇，你们看这边有一个龙的造型的钟\nwa, nǐmen kàn zhèbiān yǒu yígè lóng de zàoxíng de zhōng"
    } ]
  }, {
    "tStartMs": 586966,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我猜应该是钟吧\nwǒ cāi yīnggāi shì zhōng ba"
    } ]
  }, {
    "tStartMs": 588833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "用来敲的\nyònglái qiāo de"
    } ]
  }, {
    "tStartMs": 593166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "真的一个人都没有\nzhēn de yīgèrén dōu méiyǒu"
    } ]
  }, {
    "tStartMs": 595566,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我很少在寺庙有这样的体验\nwǒ hěn shǎo zài sìmiào yǒu zhèyàng de tǐyàn"
    } ]
  }, {
    "tStartMs": 599600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "看来以后真的要选工作日来寺庙\nkànlai yǐhòu zhēn de yào xuǎn gōngzuòrì lái sìmiào"
    } ]
  }, {
    "tStartMs": 605933,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "接下来我会安静的逛一会寺庙\njiēxiàlái wǒ huìān jìng de guàng yīhuì sìmiào"
    } ]
  }, {
    "tStartMs": 609066,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "然后把相机关掉\nránhòu bǎ xiàngjī guāndiào"
    } ]
  }, {
    "tStartMs": 613633,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "现在我走到景区更里面了\nxiànzài wǒ zǒu dào jǐngqū gèng lǐmiàn le"
    } ]
  }, {
    "tStartMs": 617433,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这边反而有更多人\nzhèbiān fǎnér yǒu gèng duō rén"
    } ]
  }, {
    "tStartMs": 620566,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "大家好像都在坐着乘凉休息\ndàjiā hǎoxiàng dōu zài zuò zhe chéngliáng xiūxi"
    } ]
  }, {
    "tStartMs": 624800,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "可能因为天气真的太热了吧\nkěnéng yīnwèi tiānqì zhēn de tài rè le ba"
    } ]
  }, {
    "tStartMs": 627966,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "你们看\nnǐmen kàn"
    } ]
  }, {
    "tStartMs": 629933,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "从这个角度看刚刚的\ncóng zhège jiǎodù kàn gānggang de"
    } ]
  }, {
    "tStartMs": 633266,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "寺院和石桥那一块好美啊\nsìyuàn hé shí qiáo nà yīkuài hǎo měi a"
    } ]
  }, {
    "tStartMs": 638766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "真的就像一幅画\nzhēn de jiù xiàng yī fú huà"
    } ]
  }, {
    "tStartMs": 641800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我们走近一点\nwǒmen zǒujìn yīdiǎn"
    } ]
  }, {
    "tStartMs": 648800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这垂下来的树叶就像\nzhè chuíxià lái de shùyè jiù xiàng"
    } ]
  }, {
    "tStartMs": 652000,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "画框上的装饰一样\nhuàkuàng shàng de zhuāngshì yīyàng"
    } ]
  }, {
    "tStartMs": 656866,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我没想到这边还有一个\nwǒ méixiǎngdào zhèbiān háiyǒu yígè"
    } ]
  }, {
    "tStartMs": 663400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "碑林\nbēilín"
    } ]
  }, {
    "tStartMs": 666233,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "这特别吸引我这样的书法爱好者\nzhè tèbié xīyǐn wǒ zhèyàng de shūfǎ àihàozhě"
    } ]
  }, {
    "tStartMs": 671466,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "让我们进去看一下\nràng wǒmen jìnqù kàn yīxià"
    } ]
  }, {
    "tStartMs": 687833,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "这一块碑是清代乾隆皇帝留下的\nzhè yīkuài bēi shì qīngdài qiánlóng huángdì liúxià de"
    } ]
  }, {
    "tStartMs": 695800,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "哇，你们看阳光透过这一个\nwa, nǐmen kàn yángguāng tòuguò zhè yígè"
    } ]
  }, {
    "tStartMs": 699533,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "花窗打在地上的阴影\nhuā chuāng dǎ zàidì shàng de yīnyǐng"
    } ]
  }, {
    "tStartMs": 707466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "又一只小猫\nyòu yìzhī xiǎomāo"
    } ]
  }, {
    "tStartMs": 711333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这只白猫比起我一般\nzhè zhǐ bái māo bǐqǐ wǒ yībān"
    } ]
  }, {
    "tStartMs": 713400,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "看到的白猫要大胆很多\nkàn dào de bái māo yào dàdǎn hěn duō"
    } ]
  }, {
    "tStartMs": 718800,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "一直闭着眼睛，打了个哈欠\nyīzhí bìzhe yǎnjing, dǎ le gè hāqian"
    } ]
  }, {
    "tStartMs": 726066,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "我没想到这座碑林这么大\nwǒ méixiǎngdào zhè zuò bēilín zhème dà"
    } ]
  }, {
    "tStartMs": 733066,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "这里面还有一些石桌子石椅子\nzhèlǐ miàn háiyǒu yīxiē shí zhuōzi shí yǐzi"
    } ]
  }, {
    "tStartMs": 737866,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "还有一个像茶室一样的地方\nháiyǒu yígè xiàng chá shì yīyàng de dìfāng"
    } ]
  }, {
    "tStartMs": 742466,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "整个碑林看起来就像一座小小的园林\nzhěnggè bēilín kànqǐlai jiù xiàng yī zuò xiǎoxiǎo de yuánlín"
    } ]
  }, {
    "tStartMs": 753433,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "没想到这里面还藏着一片竹林\nméixiǎngdào zhèlǐ miàn hái cáng zhe yī piàn zhúlín"
    } ]
  }, {
    "tStartMs": 758366,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "特别茂密的竹子\ntèbié màomì de zhúzi"
    } ]
  }, {
    "tStartMs": 761666,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "就好像突然会有一只熊猫出现一样\njiù hǎoxiàng tūrán huì yǒu yìzhī xióngmāo chūxiàn yīyàng"
    } ]
  }, {
    "tStartMs": 767866,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "这里面还有更多更多的碑刻\nzhèlǐ miàn háiyǒu gèng duō gèng duō de bēikè"
    } ]
  }, {
    "tStartMs": 773133,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "真是很安静的一片地呢\nzhēnshi hěn ānjìng de yī piàn dì ne"
    } ]
  }, {
    "tStartMs": 781566,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "那你们应该知道书法有不同的字体\nnà nǐmen yīnggāi zhīdào shūfǎ yǒu bùtóng de zìtǐ"
    } ]
  }, {
    "tStartMs": 786533,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "像这种比较规整的就是楷书\nxiàng zhèzhǒng bǐjiào guīzhěng de jiùshì kǎishū"
    } ]
  }, {
    "tStartMs": 791800,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "这种笔画之间连起来的\nzhèzhǒng bǐhuà zhījiān lián qilai de"
    } ]
  }, {
    "tStartMs": 794866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "你们可能有点看不懂的\nnǐmen kěnéng yǒudiǎn kànbudǒng de"
    } ]
  }, {
    "tStartMs": 797333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "就叫行书\njiù jiào xíngshū"
    } ]
  }, {
    "tStartMs": 799733,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "如果连的不那么厉害\nrúguǒ lián de bù nàme lìhai"
    } ]
  }, {
    "tStartMs": 802133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我们也会叫行楷\nwǒmen yě huì jiào xíng kǎi"
    } ]
  }, {
    "tStartMs": 807933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "不仅有刻字\nbùjǐn yǒu kè zì"
    } ]
  }, {
    "tStartMs": 809566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "还有像这样的刻画\nháiyǒu xiàng zhèyàng de kèhuà"
    } ]
  }, {
    "tStartMs": 812333,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这一位就是观音\nzhè yī wèi jiùshì guānyīn"
    } ]
  }, {
    "tStartMs": 814933,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "对中国人来说很重要的神仙\nduì zhōngguórén lái shuō hěn zhòngyào de shénxiān"
    } ]
  }, {
    "tStartMs": 818266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "还有梅花的刻画\nháiyǒu méihuā de kèhuà"
    } ]
  }, {
    "tStartMs": 821433,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "它没有画一整棵树的梅花\ntā méiyǒu huà yī zhěng kē shù de méihuā"
    } ]
  }, {
    "tStartMs": 825533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "而是画了其中的一枝\nérshì huà le qízhōng de yī zhī"
    } ]
  }, {
    "tStartMs": 829533,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "这么这么多的竹子\nzhème zhème duō de zhúzi"
    } ]
  }, {
    "tStartMs": 831400,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "真的让这个地方显得特别安静\nzhēn de ràng zhège dìfāng xiǎnde tèbié ānjìng"
    } ]
  }, {
    "tStartMs": 835833,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "如果可以\nrúguǒ kěyǐ"
    } ]
  }, {
    "tStartMs": 837400,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "真希望在这边待一整个下午\nzhēn xīwàng zài zhèbiān dài yī zhěnggè xiàwǔ"
    } ]
  }, {
    "tStartMs": 840966,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "而且这里面还特别凉快\nérqiě zhèlǐ miàn hái tèbié liángkuai"
    } ]
  }, {
    "tStartMs": 843866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但是现在已经3点多了\ndànshì xiànzài yǐjīng 3 diǎn duō le"
    } ]
  }, {
    "tStartMs": 846433,
    "dDurationMs": 5567,
    "segs": [ {
      "utf8": "然后从焦山回到市区的\nránhòu cóng jiāo shān huídào shìqū de"
    } ]
  }, {
    "tStartMs": 852933,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "渡船最晚的一班是5:45\ndùchuán zuì wǎn de yī bān shì 5: 45"
    } ]
  }, {
    "tStartMs": 857600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "所以我现在要抓紧一点\nsuǒyǐ wǒ xiànzài yào zhuājǐn yīdiǎn"
    } ]
  }, {
    "tStartMs": 861033,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "马上爬到山顶去看一下那座塔\nmǎshàng pá dào shāndǐng qù kàn yīxià nà zuò tǎ"
    } ]
  }, {
    "tStartMs": 866966,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "哎，人就是不能太贪心\nāi, rén jiùshì bùnéng tài tānxīn"
    } ]
  }, {
    "tStartMs": 870533,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "就是如果想要像我这样慢慢走慢慢看\njiùshì rúguǒ xiǎngyào xiàng wǒ zhèyàng mànmàn zǒu mànmàn kàn"
    } ]
  }, {
    "tStartMs": 875200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "还给你们录视频的话\nhuángěi nǐmen lù shìpín dehuà"
    } ]
  }, {
    "tStartMs": 878733,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "应该早上八九点就过来的\nyīnggāi zǎoshang bā jiǔ diǎn jiù guòlai de"
    } ]
  }, {
    "tStartMs": 882200,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "可是我太懒了起不来\nkěshì wǒ tài lǎn le qǐ bù lái"
    } ]
  }, {
    "tStartMs": 885200,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "看到了吗\nkàn dàoliǎo ma"
    } ]
  }, {
    "tStartMs": 886133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "一只黑猫\nyìzhī hēi māo"
    } ]
  }, {
    "tStartMs": 890133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "你在吃什么\nnǐ zài chī shénme"
    } ]
  }, {
    "tStartMs": 894833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "你在做什么呢\nnǐ zài zuòshímǒ ne"
    } ]
  }, {
    "tStartMs": 897600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "你的牙齿痒吗\nnǐ de yáchǐ yǎng ma"
    } ]
  }, {
    "tStartMs": 900333,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "没想到这里还藏着一个盆景园\nméixiǎngdào zhèlǐ hái cáng zhe yígè pénjǐng yuán"
    } ]
  }, {
    "tStartMs": 905433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "天呐\ntiān nà"
    } ]
  }, {
    "tStartMs": 907366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "你们可以告诉我焦山\nnǐmen kěyǐ gàosu wǒ jiāo shān"
    } ]
  }, {
    "tStartMs": 909166,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "还有什么地方是它没有的吗？\nháiyǒu shénmedìfang shì tā méiyǒu de ma?"
    } ]
  }, {
    "tStartMs": 912466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "这个地方真的值得逛一天\nzhège dìfāng zhēn de zhíde guàng yìtiān"
    } ]
  }, {
    "tStartMs": 915800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "可惜我来的太晚了\nkěxī wǒ lái de tài wǎn le"
    } ]
  }, {
    "tStartMs": 918400,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "只能选择性的逛一逛\nzhǐnéng xuǎnzéxìng de guàng yī guàng"
    } ]
  }, {
    "tStartMs": 922333,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "不过本来旅游就是有\nbùguò běnlái lǔyóu jiùshì yǒu"
    } ]
  }, {
    "tStartMs": 925000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "一些地方要错过的嘛\nyīxiē dìfāng yào cuòguò de ma"
    } ]
  }, {
    "tStartMs": 930766,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "现在这里应该就正式上山了\nxiànzài zhèlǐ yīnggāi jiù zhèngshì shàngshān le"
    } ]
  }, {
    "tStartMs": 935166,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我们走上台阶\nwǒmen zǒu shàngtái jiē"
    } ]
  }, {
    "tStartMs": 939133,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "说实话我第一次看到这样的标识\nshuōshíhuà wǒ dìyīcì kàn dào zhèyàng de biāozhì"
    } ]
  }, {
    "tStartMs": 943633,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "两个标识都是是告诉你上山\nliǎng gè biāozhì dōu shì shì gàosu nǐ shàngshān"
    } ]
  }, {
    "tStartMs": 947133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "而不是去哪个地方\nér bùshì qù nǎge dìfāng"
    } ]
  }, {
    "tStartMs": 950166,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "不知道这样的标识是否真的有意义\nbùzhī dào zhèyàng de biāozhì shìfǒu zhēn de yǒuyìyì"
    } ]
  }, {
    "tStartMs": 955833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "那我们选择这条上山之路吧\nnà wǒmen xuǎnzé zhè tiáo shàngshān zhī lù ba"
    } ]
  }, {
    "tStartMs": 962400,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "爬山的时候\npáshān de shíhou"
    } ]
  }, {
    "tStartMs": 963666,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "我特别特别喜欢这些\nwǒ tèbié tèbié xǐhuan zhèxiē"
    } ]
  }, {
    "tStartMs": 966400,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "从树叶之间照下来的阳光\ncóng shùyè zhījiān zhào xiàlai de yángguāng"
    } ]
  }, {
    "tStartMs": 973566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "从这边可以看到市区\ncóng zhèbiān kěyǐ kàn dào shìqū"
    } ]
  }, {
    "tStartMs": 976733,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "但是你能感觉到我们离市区很远\ndànshì nǐ néng gǎnjuédào wǒmen lí shìqū hěn yuǎn"
    } ]
  }, {
    "tStartMs": 980033,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "我们隔绝了市区的噪音啊\nwǒmen géjué le shìqū de zàoyīn a"
    } ]
  }, {
    "tStartMs": 984866,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "污染啊\nwūrǎn a"
    } ]
  }, {
    "tStartMs": 989466,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但我觉得这座山应该不太高\ndàn wǒ juéde zhè zuò shān yīnggāi bù tài gāo"
    } ]
  }, {
    "tStartMs": 993533,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "很快就可以爬到山顶了\nhěn kuài jiù kěyǐ pá dào shāndǐng le"
    } ]
  }, {
    "tStartMs": 1032433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "这座亭子的名字很有意思\nzhè zuò tíngzi de míngzi hěn yǒuyìsi"
    } ]
  }, {
    "tStartMs": 1041233,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "叫做“吸江楼”\njiàozuò \"xī jiāng lóu\""
    } ]
  }, {
    "tStartMs": 1046033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "这个就是“吸”\nzhège jiùshì \"xī\""
    } ]
  }, {
    "tStartMs": 1048666,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "好像这座亭子要把旁边的\nhǎoxiàng zhè zuò tíngzi yào bǎ pángbiān de"
    } ]
  }, {
    "tStartMs": 1052333,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "长江的水全部吸进去一样\nchángjiāng de shuǐ quánbù xījìn qù yīyàng"
    } ]
  }, {
    "tStartMs": 1058933,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "我感觉我到山顶了\nwǒ gǎnjué wǒ dào shāndǐng le"
    } ]
  }, {
    "tStartMs": 1063266,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我觉得我的体力不如以前了\nwǒ juéde wǒ de tǐlì bùrú yǐqián le"
    } ]
  }, {
    "tStartMs": 1066366,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "可能因为前不久感染了新冠吧\nkěnéng yīnwèi qiánbùjiǔ gǎnrǎn le xīn guān ba"
    } ]
  }, {
    "tStartMs": 1070066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "对身体的打击真的很大\nduì shēntǐ de dǎjī zhēn de hěn dà"
    } ]
  }, {
    "tStartMs": 1081200,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "前面就是一座塔\nqiánmiàn jiùshì yī zuò tǎ"
    } ]
  }, {
    "tStartMs": 1087766,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "这座塔叫“万佛塔”\nzhè zuò tǎ jiào \"wàn fótǎ\""
    } ]
  }, {
    "tStartMs": 1090666,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "因为里面据说有一万尊佛像\nyīnwèi lǐmiàn jùshuō yǒu yī wàn zūn fóxiàng"
    } ]
  }, {
    "tStartMs": 1096000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "但它已经不是原来的塔了\ndàn tā yǐjīng bùshì yuánlái de tǎ le"
    } ]
  }, {
    "tStartMs": 1099000,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "是重建的\nshì chóngjiàn de"
    } ]
  }, {
    "tStartMs": 1101466,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "应该是有七层高\nyīnggāi shì yǒu qī céng gāo"
    } ]
  }, {
    "tStartMs": 1104966,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我们在这边还可以\nwǒmen zài zhèbiān hái kěyǐ"
    } ]
  }, {
    "tStartMs": 1106466,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "看到远处的江景和市区\nkàn dào yuǎnchù de jiāng jǐng hé shìqū"
    } ]
  }, {
    "tStartMs": 1119633,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "但是这座万佛塔看起来好像不能进去\ndànshì zhè zuò wàn fótǎ kànqǐlai hǎoxiàng bùnéng jìnqù"
    } ]
  }, {
    "tStartMs": 1127000,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "门上上了锁\nmén shàng shàng le suǒ"
    } ]
  }, {
    "tStartMs": 1129433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "但我能通过这个门缝看到里面\ndàn wǒ néng tōngguò zhège mén fèng kàn dào lǐmiàn"
    } ]
  }, {
    "tStartMs": 1134366,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "里面在施工\nlǐmiàn zài shīgōng"
    } ]
  }, {
    "tStartMs": 1136366,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "难怪不能进去呢\nnánguài bùnéng jìnqù ne"
    } ]
  }, {
    "tStartMs": 1142333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "现在下午4:15\nxiànzài xiàwǔ 4: 15"
    } ]
  }, {
    "tStartMs": 1145866,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我准备下山啦\nwǒ zhǔnbèi xiàshān la"
    } ]
  }, {
    "tStartMs": 1151866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "现在我们下来了\nxiànzài wǒmen xiàlai le"
    } ]
  }, {
    "tStartMs": 1153733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "到江边了\ndào jiāngbiān le"
    } ]
  }, {
    "tStartMs": 1155866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "在这里可以欣赏江景\nzài zhèlǐ kěyǐ xīnshǎng jiāng jǐng"
    } ]
  }, {
    "tStartMs": 1159333,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "虽然已经下午4点多了\nsuīrán yǐjīng xiàwǔ 4 diǎn duō le"
    } ]
  }, {
    "tStartMs": 1161200,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "但是太阳还是挺晒的\ndànshì tàiyang háishi tǐng shài de"
    } ]
  }, {
    "tStartMs": 1167600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "但说实话\ndàn shuōshíhuà"
    } ]
  }, {
    "tStartMs": 1169333,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "从这这座江中小山往\ncóng zhè zhè zuò jiāng zhōng xiǎo shān wǎng"
    } ]
  }, {
    "tStartMs": 1174166,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "远处看的景色并不怎么好\nyuǎnchù kàn de jǐngsè bìngbù zěnme hǎo"
    } ]
  }, {
    "tStartMs": 1177833,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "因为它自己本身就是江上最好的景色\nyīnwèi tā zìjǐ běnshēn jiùshì jiāng shàng zuìhǎo de jǐngsè"
    } ]
  } ]
}
