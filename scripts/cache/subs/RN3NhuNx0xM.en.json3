  }, {
    "tStartMs": 364833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hehehe."
    } ]
  }, {
    "tStartMs": 366199,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "This one too—"
