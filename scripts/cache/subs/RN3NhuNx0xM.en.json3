  }, {
    "tStartMs": 332000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 332833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Let's take it."
    } ]
  }, {
    "tStartMs": 334833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "What? This is a giant."
    } ]
  }, {
    "tStartMs": 337600,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "So pretty."
    } ]
  }, {
    "tStartMs": 339466,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "Let me take a photo."
    } ]
  }, {
    "tStartMs": 340100,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "Oh wow, there's a mushroom forest."
    } ]
  }, {
    "tStartMs": 342866,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "These are spicy."
    } ]
  }, {
    "tStartMs": 344066,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "We usually don't eat them,"
    } ]
  }, {
    "tStartMs": 345266,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "but some people do."
    } ]
  }, {
    "tStartMs": 346000,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "Some people also collect them."
    } ]
  }, {
    "tStartMs": 347766,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "So we won't pick them,"
    } ]
  }, {
    "tStartMs": 349433,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "but I just want to show them—yeah,"
    } ]
  }, {
    "tStartMs": 351666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "how they look."
    } ]
  }, {
    "tStartMs": 353300,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 354666,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "Is this the lime mushroom?"
    } ]
  }, {
    "tStartMs": 356600,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "Yes, lime mushroom."
    } ]
  }, {
    "tStartMs": 357466,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "It's lime mushroom."
    } ]
  }, {
    "tStartMs": 359466,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "They have some new discoveries."
    } ]
  }, {
    "tStartMs": 360866,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "Oh wow, it's so big."
