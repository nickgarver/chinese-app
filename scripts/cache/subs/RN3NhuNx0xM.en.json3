  }, {
    "tStartMs": 1097133,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "that this one is poisonous."
    } ]
  }, {
    "tStartMs": 1098966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "It's a member of the amanita family."
