  }, {
    "tStartMs": 297866,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 299633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Purple, yellow,"
    } ]
  }, {
    "tStartMs": 301100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and there's also a white one."
    } ]
  }, {
    "tStartMs": 303300,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 303966,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "Actually, this one looks better."
    } ]
  }, {
    "tStartMs": 305899,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 308033,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "So those giants are not so tasty."
    } ]
  }, {
    "tStartMs": 310866,
    "dDurationMs": 5434,
    "segs": [ {
      "utf8": "You can just step on it. Wow."
    } ]
  }, {
    "tStartMs": 317233,
    "dDurationMs": 466,
    "segs": [ {
      "utf8": "Oh my god."
    } ]
  }, {
    "tStartMs": 317699,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "This one shouldn't be—"
    } ]
  }, {
    "tStartMs": 318899,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "This one isn't."
    } ]
  }, {
    "tStartMs": 319766,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "That one isn't."
    } ]
  }, {
    "tStartMs": 320500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "That one is also edible."
    } ]
  }, {
    "tStartMs": 322366,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "I think I've had this one"
    } ]
  }, {
    "tStartMs": 323833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "when I was in Garze Prefecture."
    } ]
  }, {
    "tStartMs": 325266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yes, yes, this is edible."
    } ]
  }, {
    "tStartMs": 326066,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "We call it \"egg mushroom.\""
    } ]
  }, {
    "tStartMs": 328199,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Goose-egg mushroom."
    } ]
  }, {
    "tStartMs": 329166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Is this one tasty?"
    } ]
  }, {
    "tStartMs": 330566,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "It's edible too."
