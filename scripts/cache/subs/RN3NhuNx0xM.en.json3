  }, {
    "tStartMs": 1500366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "OK."
    } ]
  }, {
    "tStartMs": 1502766,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "See?"
    } ]
  }, {
    "tStartMs": 1503299,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "Is this boletus?"
