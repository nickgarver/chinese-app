  }, {
    "tStartMs": 1489500,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Milky mushroom."
    } ]
  }, {
    "tStartMs": 1492099,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Stir-fried with some meat."
    } ]
  }, {
    "tStartMs": 1494599,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "I want to get some."
    } ]
  }, {
    "tStartMs": 1495799,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "Come on."
    } ]
  }, {
    "tStartMs": 1496366,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "This is boletus."
