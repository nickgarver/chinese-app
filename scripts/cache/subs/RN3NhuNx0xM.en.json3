  }, {
    "tStartMs": 290833,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "We call it \"skin-head mushroom.\""
    } ]
  }, {
    "tStartMs": 292033,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "Skin-head mushroom."
    } ]
  }, {
    "tStartMs": 292600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "Mm, they're just too small."
    } ]
  }, {
    "tStartMs": 294033,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "What's the purple one called?"
    } ]
  }, {
    "tStartMs": 295366,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Also skin-head mushroom."
    } ]
  }, {
    "tStartMs": 296433,
    "dDurationMs": 1400,
    "segs": [ {
