  }, {
    "tStartMs": 1333666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "They need to sort things out."
    } ]
  }, {
    "tStartMs": 1334966,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I think probably many"
