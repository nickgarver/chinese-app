  }, {
    "tStartMs": 996566,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "And I think this should be about five kilograms,"
    } ]
  }, {
    "tStartMs": 999100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "at least—hahaha."
    } ]
  }, {
    "tStartMs": 1000200,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "So happy."
