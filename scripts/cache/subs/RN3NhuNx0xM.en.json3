  }, {
    "tStartMs": 368866,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "Not edible."
    } ]
  }, {
    "tStartMs": 369399,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Not edible.\nHaha, what's it called?"
    } ]
  }, {
    "tStartMs": 373100,
    "dDurationMs": 1099,
    "segs": [ {
      "utf8": "This is Chinese amanita."
    } ]
  }, {
    "tStartMs": 374199,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "This is also Chinese amanita."
    } ]
  }, {
    "tStartMs": 375199,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Ah, it's amanita."
    } ]
  }, {
    "tStartMs": 376566,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 377166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "It's beautiful."
    } ]
  }, {
    "tStartMs": 378300,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Chinese amanita."
    } ]
  }, {
    "tStartMs": 378800,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "Poisonous."
    } ]
  }, {
    "tStartMs": 382366,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Is it poisonous?"
    } ]
  }, {
    "tStartMs": 383266,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "He says it's not edible."
    } ]
  }, {
    "tStartMs": 384266,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not edible, not edible, not edible."
    } ]
  }, {
    "tStartMs": 385633,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "This is a mushroom that's only appeared in recent years."
    } ]
  }, {
    "tStartMs": 387800,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "We don't dare to eat it either."
    } ]
  }, {
    "tStartMs": 388966,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Oh, it's a new variety."
    } ]
  }, {
    "tStartMs": 390233,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "A new variety."
    } ]
  }, {
    "tStartMs": 390833,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "You don't know either—"
    } ]
  }, {
    "tStartMs": 394100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Haha, forget it."
    } ]
  }, {
    "tStartMs": 395633,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Better not try it."
    } ]
  }, {
    "tStartMs": 398766,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 402466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "The first—"
    } ]
  }, {
    "tStartMs": 403266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "there's another one here."
    } ]
  }, {
    "tStartMs": 404100,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "Oh wow wow wow.\nIt's cute."
    } ]
  }, {
    "tStartMs": 405800,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "Ah, don't step on it."
    } ]
  }, {
    "tStartMs": 408399,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "There are more over there."
    } ]
  }, {
    "tStartMs": 410566,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "There are many here."
    } ]
  }, {
    "tStartMs": 411566,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "You stepped on one."
    } ]
  }, {
    "tStartMs": 413166,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Really?"
