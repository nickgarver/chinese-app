  }, {
    "tStartMs": 1131633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Take them over there."
    } ]
  }, {
    "tStartMs": 1133299,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Take them to the restaurant."
    } ]
  }, {
    "tStartMs": 1134166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Take them to the restaurant."
    } ]
  }, {
    "tStartMs": 1135633,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Carrie can't bear to part with them."
