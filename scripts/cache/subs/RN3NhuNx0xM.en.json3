  }, {
    "tStartMs": 1148000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "At least three of the four baskets are edible, right?"
    } ]
  }, {
    "tStartMs": 1150200,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "Hahaha."
    } ]
  }, {
    "tStartMs": 1153866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "It also looks nice in the car."
    } ]
  }, {
    "tStartMs": 1155566,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Now we're going to take the mushrooms,"
    } ]
  }, {
    "tStartMs": 1159500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "find a restaurant,"
    } ]
  }, {
    "tStartMs": 1160666,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and then cook them."
    } ]
  }, {
    "tStartMs": 1172366,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "Now we are at the market in Mouding county town."
    } ]
  }, {
    "tStartMs": 1176766,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "So every morning,"
    } ]
  }, {
    "tStartMs": 1177599,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "the local farmers"
    } ]
  }, {
    "tStartMs": 1180766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "go to the mountain for mushrooms,"
    } ]
  }, {
    "tStartMs": 1182866,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "and then around three PM,"
    } ]
  }, {
    "tStartMs": 1185500,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "they bring all the mushrooms here."
    } ]
  }, {
    "tStartMs": 1188033,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "So here you will find all the expensive mushrooms,"
    } ]
  }, {
    "tStartMs": 1190599,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "big mushrooms."
    } ]
  }, {
    "tStartMs": 1192233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "How much is this dried mushroom per catty?"
    } ]
  }, {
    "tStartMs": 1195166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Three hundred."
    } ]
  }, {
    "tStartMs": 1196033,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Ah, three hundred?"
    } ]
  }, {
    "tStartMs": 1197000,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Ah, three hundred yuan."
    } ]
  }, {
    "tStartMs": 1198166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Per kilogram."
    } ]
  }, {
    "tStartMs": 1199166,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 1199766,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Maybe he just realized it's a bit expensive."
    } ]
  }, {
    "tStartMs": 1201266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1203233,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "If you buy it, you won't be able to eat it at the restaurant."
    } ]
  }, {
    "tStartMs": 1205799,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 1206799,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "How much is it?"
    } ]
  }, {
    "tStartMs": 1207666,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "How much was it before?"
    } ]
  }, {
    "tStartMs": 1209233,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "Uh, a few days ago it was five thousand, around five thousand."
    } ]
  }, {
    "tStartMs": 1212400,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "These past two days it's eight hundred."
    } ]
  }, {
    "tStartMs": 1214033,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Eight hundred."
    } ]
  }, {
    "tStartMs": 1214433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Eight hundred, four hundred, six hundred—"
    } ]
  }, {
    "tStartMs": 1215866,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "it varies."
    } ]
  }, {
    "tStartMs": 1216566,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Just now that person told me three hundred."
    } ]
  }, {
    "tStartMs": 1218266,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Three hundred is from yesterday."
    } ]
  }, {
    "tStartMs": 1219866,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Oh, from yesterday."
    } ]
  }, {
    "tStartMs": 1221633,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "If they don't sell it all, they—"
    } ]
  }, {
    "tStartMs": 1223233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 1224666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Our tour guide said"
    } ]
  }, {
    "tStartMs": 1225966,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "we had enough mushrooms,"
    } ]
  }, {
    "tStartMs": 1227766,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "so we can't buy more."
    } ]
  }, {
    "tStartMs": 1230366,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "But if you come to Yunnan,"
    } ]
  }, {
    "tStartMs": 1231766,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "I recommend you try this dried mushroom,"
    } ]
  }, {
    "tStartMs": 1234033,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "because it's pretty unique."
    } ]
  }, {
    "tStartMs": 1237099,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "When you are in the market,"
    } ]
  }, {
    "tStartMs": 1238299,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "you can feel how crazy"
    } ]
  }, {
    "tStartMs": 1240866,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "Yunnan people are about mushrooms."
    } ]
  }, {
    "tStartMs": 1244366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "You can barely move your feet."
    } ]
  }, {
    "tStartMs": 1246966,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "Everyone is looking for mushrooms."
    } ]
  }, {
    "tStartMs": 1252666,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "That's much bigger than what we found."
    } ]
  }, {
    "tStartMs": 1255966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Termite mushroom."
    } ]
  }, {
    "tStartMs": 1257766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "Boss, how much are termite mushrooms per catty?"
    } ]
  }, {
    "tStartMs": 1259799,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "One hundred eighty."
    } ]
  }, {
    "tStartMs": 1260466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "One hundred eighty."
    } ]
  }, {
    "tStartMs": 1262700,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "Can this be eaten?"
    } ]
  }, {
    "tStartMs": 1264200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "Can this be eaten?"
    } ]
  }, {
    "tStartMs": 1267000,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 1267900,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "It's a beehive."
    } ]
  }, {
    "tStartMs": 1268766,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "But this bee is apparently"
    } ]
  }, {
    "tStartMs": 1270066,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "a lot bigger than the normal one."
    } ]
  }, {
    "tStartMs": 1274266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "This brother"
    } ]
  }, {
    "tStartMs": 1275066,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "sells three-year-old bacon."
    } ]
  }, {
    "tStartMs": 1276666,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I'd love to try it,"
    } ]
  }, {
    "tStartMs": 1278433,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "but I'm afraid we won't finish it."
    } ]
  }, {
    "tStartMs": 1280900,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "You can eat it at home."
    } ]
  }, {
    "tStartMs": 1292400,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Fantastic."
    } ]
  }, {
    "tStartMs": 1293733,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "It's so tender, so juicy, salty."
    } ]
  }, {
    "tStartMs": 1299466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "Perfect bacon, really."
