  }, {
    "tStartMs": 413766,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 414399,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 415166,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Oh, this baby is gone."
    } ]
  }, {
    "tStartMs": 417166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 418233,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "Yeah, OK, that's it."
    } ]
  }, {
    "tStartMs": 420500,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "This one—"
    } ]
  }, {
    "tStartMs": 421033,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "yes, it's too small."
    } ]
  }, {
    "tStartMs": 421966,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "It got stepped on."
    } ]
  }, {
    "tStartMs": 424066,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Flo just stepped on this."
    } ]
  }, {
    "tStartMs": 426066,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Found another red mushroom here."
    } ]
  }, {
    "tStartMs": 433500,
    "dDurationMs": 2699,
    "segs": [ {
      "utf8": "You've already exceeded your goal."
    } ]
  }, {
    "tStartMs": 436199,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "Yeah, and look how huge this one is."
    } ]
  }, {
    "tStartMs": 438833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 441266,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The mushroom season"
    } ]
  }, {
    "tStartMs": 442866,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "starts in summer and ends roughly in October."
    } ]
  }, {
    "tStartMs": 447500,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "Many places in Yunnan produce mushrooms,"
    } ]
  }, {
    "tStartMs": 449566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "but Chuxiong is so famous—"
    } ]
  }, {
    "tStartMs": 451199,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "it's known as the kingdom of mushrooms."
    } ]
  }, {
    "tStartMs": 453833,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Um, for example,"
    } ]
  }, {
    "tStartMs": 456300,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "in Shangri-La,"
    } ]
  }, {
    "tStartMs": 457833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "you mostly find matsutake—"
    } ]
  }, {
    "tStartMs": 459633,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "matsutake."
    } ]
  }, {
    "tStartMs": 460500,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "But here you find"
    } ]
  }, {
    "tStartMs": 462233,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "really, really different kinds."
    } ]
  }, {
    "tStartMs": 465899,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "This one—"
    } ]
  }, {
    "tStartMs": 466699,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 467300,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "At first I thought this was a milk-cap mushroom too,"
    } ]
  }, {
    "tStartMs": 469500,
    "dDurationMs": 466,
    "segs": [ {
      "utf8": "mm,"
    } ]
  }, {
    "tStartMs": 469966,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "but it doesn't produce"
    } ]
  }, {
    "tStartMs": 471500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "any milk."
    } ]
  }, {
    "tStartMs": 472300,
    "dDurationMs": 599,
    "segs": [ {
      "utf8": "No milk."
    } ]
  }, {
    "tStartMs": 472899,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "And it seems to be spicy."
    } ]
  }, {
    "tStartMs": 474366,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 475100,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "I don't know—let me taste it."
    } ]
  }, {
    "tStartMs": 481000,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "You can tell if it's edible just by tasting it?"
    } ]
  }, {
    "tStartMs": 485566,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "Spicy."
    } ]
  }, {
    "tStartMs": 486233,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Spicy."
    } ]
  }, {
    "tStartMs": 486633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Mm, this is the spicy mushroom."
    } ]
  }, {
    "tStartMs": 488066,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "Spicy mushroom."
    } ]
  }, {
    "tStartMs": 488500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Look at this bunch."
    } ]
  }, {
    "tStartMs": 490666,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So that's the spicy one."
    } ]
  }, {
    "tStartMs": 492366,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "It's quite spicy."
    } ]
  }, {
    "tStartMs": 494166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "You're not going to get poisoned, are you?"
    } ]
  }, {
    "tStartMs": 495566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 497800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "This mushroom, it looks exactly like"
    } ]
  }, {
    "tStartMs": 500199,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "the big milk-cap mushroom—"
    } ]
  }, {
    "tStartMs": 502300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "they look identical."
    } ]
  }, {
    "tStartMs": 503366,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 503766,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "So it's easy to confuse them."
    } ]
  }, {
    "tStartMs": 505466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 506399,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "There's a type of milk-cap mushroom"
    } ]
  }, {
    "tStartMs": 507166,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "that's also this big,"
    } ]
  }, {
    "tStartMs": 508066,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "and that one tastes fragrant."
    } ]
  }, {
    "tStartMs": 511566,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "Oh, this one tastes spicy."
    } ]
  }, {
    "tStartMs": 513200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 515399,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "That's the real milk-cap mushroom—"
    } ]
  }, {
    "tStartMs": 517666,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "the milky mushroom."
    } ]
  }, {
    "tStartMs": 521833,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "When you break one part—"
    } ]
  }, {
    "tStartMs": 524166,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "let me show you."
    } ]
  }, {
    "tStartMs": 528000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Uh, over here."
    } ]
  }, {
    "tStartMs": 529200,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "There are a few more."
    } ]
  }, {
    "tStartMs": 530799,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "See, there is milk dripping."
    } ]
  }, {
    "tStartMs": 535899,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "There are two."
    } ]
  }, {
    "tStartMs": 536833,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "Oh."
