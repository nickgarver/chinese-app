  }, {
    "tStartMs": 1141766,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "Do we have enough mushrooms to eat?"
    } ]
  }, {
    "tStartMs": 1144000,
    "dDurationMs": 599,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 1144599,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Enough."
