  }, {
    "tStartMs": 1003033,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "We've become mushroom-finding experts."
    } ]
  }, {
    "tStartMs": 1005366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Isn't that right?"
