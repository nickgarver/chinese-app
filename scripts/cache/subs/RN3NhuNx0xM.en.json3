  }, {
    "tStartMs": 1303799,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 1305200,
    "dDurationMs": 5833,
    "segs": [ {
      "utf8": "His definition of \"a little smaller.\""
    } ]
  }, {
    "tStartMs": 1311233,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "OK, you can give it."
    } ]
  }, {
    "tStartMs": 1312866,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Very good, very good."
    } ]
  }, {
    "tStartMs": 1314366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Twenty yuan."
    } ]
  }, {
    "tStartMs": 1315599,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 1321866,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "This is the blue-staining mushroom."
    } ]
  }, {
    "tStartMs": 1323299,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "Mm, after washing your hands,"
    } ]
  }, {
    "tStartMs": 1324233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "you didn't find any."
    } ]
  }, {
    "tStartMs": 1325033,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "Only buying?"
