  }, {
    "tStartMs": 1338166,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "um, are not edible."
    } ]
  }, {
    "tStartMs": 1341833,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "The hospital is pretty close, though."
    } ]
  }, {
    "tStartMs": 1343500,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "Hahaha."
    } ]
  }, {
    "tStartMs": 1347866,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "You—you eat them yourselves—"
    } ]
  }, {
    "tStartMs": 1349000,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "have you ever seen little people?"
    } ]
  }, {
    "tStartMs": 1352200,
    "dDurationMs": 366,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 1352566,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "We make sure everything is edible."
    } ]
  }, {
    "tStartMs": 1355566,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "If you ate them and saw little people,"
    } ]
  }, {
    "tStartMs": 1357166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "that would be dangerous."
    } ]
  }, {
    "tStartMs": 1359000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "You'd tire out the ambulance crew."
    } ]
  }, {
    "tStartMs": 1362166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "We need to keep you safe! Yes."
    } ]
  }, {
    "tStartMs": 1363966,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Keep you safe."
    } ]
  }, {
    "tStartMs": 1364366,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "If you ate them and saw little people, we'd be embarrassed—hahaha."
    } ]
  }, {
    "tStartMs": 1369033,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Not for the first time."
    } ]
  }, {
    "tStartMs": 1370599,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "We're going to cook"
    } ]
  }, {
    "tStartMs": 1371466,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "them in three ways."
    } ]
  }, {
    "tStartMs": 1372400,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "So this blue-staining mushroom will be stir-fried."
    } ]
  }, {
    "tStartMs": 1376433,
    "dDurationMs": 333,
    "segs": [ {
      "utf8": "This termite mushroom—"
    } ]
  }, {
    "tStartMs": 1376766,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "we bought it from the market."
    } ]
  }, {
    "tStartMs": 1378700,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Those are the most delicious type."
    } ]
  }, {
    "tStartMs": 1380599,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "We're going to stir-fry them."
    } ]
  }, {
    "tStartMs": 1381966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "And for the rest,"
    } ]
  }, {
    "tStartMs": 1383666,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "um, we're going to make a soup."
    } ]
  }, {
    "tStartMs": 1387000,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "Are you scared"
    } ]
  }, {
    "tStartMs": 1387766,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "to eat these mushrooms?"
    } ]
  }, {
    "tStartMs": 1388633,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Ah, no."
    } ]
  }, {
    "tStartMs": 1390566,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "I trust them."
    } ]
  }, {
    "tStartMs": 1396466,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "In a restaurant—"
    } ]
  }, {
    "tStartMs": 1397666,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "a local restaurant like this—"
    } ]
  }, {
    "tStartMs": 1399166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "the mushroom cooking"
    } ]
  }, {
    "tStartMs": 1400566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "felt like a social activity."
    } ]
  }, {
    "tStartMs": 1403299,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "You can learn about the mushrooms."
    } ]
  }, {
    "tStartMs": 1406500,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "And also there is a fruit here,"
    } ]
  }, {
    "tStartMs": 1408500,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "so you will see different kinds of mushrooms."
    } ]
  }, {
    "tStartMs": 1414266,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Back in the kitchen,"
    } ]
  }, {
    "tStartMs": 1415266,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "in order to spice things up,"
    } ]
  }, {
    "tStartMs": 1417433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "they have nearly like thirty"
    } ]
  }, {
    "tStartMs": 1419033,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "or forty different kinds of spices."
    } ]
  }, {
    "tStartMs": 1420566,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "And when I'm standing here,"
    } ]
  }, {
    "tStartMs": 1421500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I can smell the strong smell of this chili pepper."
    } ]
  }, {
    "tStartMs": 1472066,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Hey, it's all here."
