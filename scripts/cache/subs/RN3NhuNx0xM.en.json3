  }, {
    "tStartMs": 282266,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Purple one."
    } ]
  }, {
    "tStartMs": 285433,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "These small ones—"
    } ]
  }, {
    "tStartMs": 286600,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "just these small ones—"
    } ]
  }, {
    "tStartMs": 287566,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "these can—"
    } ]
  }, {
    "tStartMs": 288466,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "these are edible."
    } ]
  }, {
    "tStartMs": 289800,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "What mushroom is this?"
