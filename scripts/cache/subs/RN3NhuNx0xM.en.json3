  }, {
    "tStartMs": 1037866,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1038299,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Guide, let me ask you—"
    } ]
  }, {
    "tStartMs": 1039666,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "how do you think we performed today?"
