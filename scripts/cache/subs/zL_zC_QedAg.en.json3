  }, {
    "tStartMs": 1544466,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "This is one of the least—"
    } ]
  }, {
    "tStartMs": 1545733,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "like, most impoverished regions in China."
    } ]
  }, {
    "tStartMs": 1548599,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "But compared with the past,"
    } ]
  }, {
    "tStartMs": 1550733,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "life has"
    } ]
  }, {
    "tStartMs": 1552166,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "improved a lot."
    } ]
  }, {
    "tStartMs": 1553500,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Because now at least"
    } ]
  }, {
    "tStartMs": 1554466,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "people have enough food,"
    } ]
  }, {
    "tStartMs": 1555933,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "enough water,"
    } ]
  }, {
    "tStartMs": 1556566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "uh, they can go to school."
    } ]
  }, {
    "tStartMs": 1558933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "And for my parents' generation—they—"
    } ]
  }, {
    "tStartMs": 1561066,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "and also my grandparents' generation—"
    } ]
  }, {
    "tStartMs": 1562966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "they really lived through poverty."
    } ]
  }, {
    "tStartMs": 1564966,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So one of my mom's older sisters died"
    } ]
  }, {
    "tStartMs": 1567666,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "because of starvation,"
    } ]
  }, {
    "tStartMs": 1569400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "because simply my grandparents"
    } ]
  }, {
    "tStartMs": 1572200,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "didn't have enough food to"
    } ]
  }, {
    "tStartMs": 1574933,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "feed the kids."
    } ]
  }, {
    "tStartMs": 1576700,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "And if you compare that"
    } ]
  }, {
    "tStartMs": 1578400,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "with the life we have right now,"
    } ]
  }, {
    "tStartMs": 1581900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "things have"
