  }, {
    "tStartMs": 1632900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "is the magnitude and the pace"
    } ]
  }, {
    "tStartMs": 1635333,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "in which China managed"
    } ]
  }, {
    "tStartMs": 1636466,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to lift people out of poverty."
    } ]
  }, {
    "tStartMs": 1638466,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "If I think of Yan's parents—"
    } ]
  }, {
    "tStartMs": 1640166,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "my parents-in-law—"
    } ]
  }, {
    "tStartMs": 1642000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "they grew up when China was one of"
