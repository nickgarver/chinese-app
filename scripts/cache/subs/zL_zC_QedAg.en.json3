  }, {
    "tStartMs": 1583900,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "changed a lot."
    } ]
  }, {
    "tStartMs": 1584933,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "And I hope that in the future,"
    } ]
  }, {
    "tStartMs": 1586933,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "this part of China will also have a"
