  }, {
    "tStartMs": 1591266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "much better life in the future."
    } ]
  }, {
    "tStartMs": 1594333,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "So two years ago,"
    } ]
  }, {
