      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 420200,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "走上来的感觉好好"
    } ]
  }, {
    "tStartMs": 424933,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 428933,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "很美很漂亮"
    } ]
  }, {
    "tStartMs": 434933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "这是两位仙女"
    } ]
  }, {
    "tStartMs": 437533,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "坠落在人间"
    } ]
  }, {
    "tStartMs": 438800,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "忘记了回家的路"
    } ]
  }, {
    "tStartMs": 442600,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "我将担此大任"
    } ]
  }, {
    "tStartMs": 445866,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "送她们回家"
    } ]
  }, {
    "tStartMs": 447100,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "哇好大的狗"
    } ]
  }, {
    "tStartMs": 450800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 453033,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "小狗"
    } ]
  }, {
    "tStartMs": 453666,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "而且不好斗"
    } ]
  }, {
    "tStartMs": 454833,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "大狗"
    } ]
  }, {
    "tStartMs": 456866,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "好想养一只这么大的狗"
    } ]
  }, {
    "tStartMs": 460766,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "养我吧妈妈"
    } ]
  }, {
    "tStartMs": 462466,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 463300,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "滚蛋"
    } ]
  }, {
    "tStartMs": 464200,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "哈哈哈哈哈哈哈"
    } ]
  }, {
    "tStartMs": 466666,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "好了我们现在骑着小蓝车"
    } ]
  }, {
    "tStartMs": 470600,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "回我们的酒店"
    } ]
  }, {
    "tStartMs": 472333,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "回我们的新疆大厦"
    } ]
  }, {
    "tStartMs": 473966,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "运动40分钟"
    } ]
  }, {
    "tStartMs": 475333,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "开始let's go"
    } ]
  }, {
    "tStartMs": 476900,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "这边呢是亮马河"
    } ]
  }, {
    "tStartMs": 482266,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "这风有点冷啊"
    } ]
  }, {
    "tStartMs": 486200,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "还好今天出门大家都穿了外套"
    } ]
  }, {
    "tStartMs": 489066,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 491133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "明智"
    } ]
  }, {
    "tStartMs": 492766,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "聪明哈哈"
    } ]
  }, {
    "tStartMs": 495600,
    "dDurationMs": 6966,
    "segs": [ {
      "utf8": "🎵"
    } ]
  }, {
    "tStartMs": 502566,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "哇这个亮马河很长哎"
    } ]
  }, {
    "tStartMs": 505533,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "对这边还可以看到"
    } ]
  }, {
    "tStartMs": 510533,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "我们最喜欢晚上在大城市或者是"
    } ]
  }, {
    "tStartMs": 514166,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "任何一个旅游的城市晚上骑车回家"
    } ]
  }, {
    "tStartMs": 516766,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "尤其是夏天的时候太爽了"
    } ]
  }, {
    "tStartMs": 520900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "你知道大城市有时候是堵车的"
    } ]
  }, {
    "tStartMs": 523633,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "哇大家看一下亮马河这些树上的灯"
    } ]
  }, {
    "tStartMs": 528133,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "和河岸边的灯是一样的呀"
    } ]
  }, {
    "tStartMs": 531666,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "变换一致"
    } ]
  }, {
    "tStartMs": 542000,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "哇好长一条亮马河"
    } ]
  }, {
    "tStartMs": 545066,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "是他是他就是他"
    } ]
  }, {
    "tStartMs": 548666,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "我们的小朋友小哪吒"
    } ]
  }, {
    "tStartMs": 552933,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "是他，就是他"
    } ]
  }, {
    "tStartMs": 558533,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "少年英雄小哪吒"
    } ]
  }, {
    "tStartMs": 563100,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "上天入地  他不怕"
    } ]
  }, {
    "tStartMs": 567166,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "下海他比  海更大"
    } ]
  }, {
    "tStartMs": 570933,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "智斗妖魔   降鬼怪"
    } ]
  }, {
    "tStartMs": 574533,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "少年英雄   就是小哪吒"
    } ]
  }, {
    "tStartMs": 578533,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "有时他很顽皮"
    } ]
  }, {
    "tStartMs": 580466,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "塔园外交公寓"
    } ]
  }, {
    "tStartMs": 584200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "他的个头跟我一（般高）"
    } ]
  }, {
    "tStartMs": 586566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "前面有一辆猪"
    } ]
  }, {
    "tStartMs": 589333,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "哈哈哈一辆狗"
    } ]
  }, {
    "tStartMs": 591700,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "好大的好胖的狗"
    } ]
  }, {
    "tStartMs": 594300,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "胖乎乎的"
    } ]
  }, {
    "tStartMs": 599000,
    "dDurationMs": 9433,
    "segs": [ {
      "utf8": "🎵"
    } ]
  }, {
    "tStartMs": 608966,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "还是亮马河哇好宽"
    } ]
  }, {
    "tStartMs": 614300,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "这个小狗有嘴套子"
    } ]
  }, {
    "tStartMs": 631966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "现在能左转吗"
    } ]
  }, {
    "tStartMs": 633533,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "好像可以"
    } ]
  }, {
    "tStartMs": 634466,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "可以"
    } ]
  }, {
    "tStartMs": 636800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "不行了，这个灯der"
    } ]
  }, {
    "tStartMs": 640000,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "这个灯儿"
    } ]
  }, {
    "tStartMs": 640700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "这个灯啊耍人呢"
    } ]
  }, {
    "tStartMs": 644100,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "冷不冷"
    } ]
  }, {
    "tStartMs": 646866,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "冷不冷"
    } ]
  }, {
    "tStartMs": 652533,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "那我们是不是能"
    } ]
  }, {
    "tStartMs": 653600,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "就是跟着他们这么走"
    } ]
  }, {
    "tStartMs": 655000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "哎不是这个"
    } ]
  }, {
    "tStartMs": 657800,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那咱们这过去还得从那头对吧"
    } ]
  }, {
    "tStartMs": 661200,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那就跟着左转吧"
    } ]
  }, {
    "tStartMs": 663533,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "走吧"
    } ]
  }, {
    "tStartMs": 665333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "走，不对啊"
    } ]
  }, {
    "tStartMs": 668100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "他是那个头是那么掉的"
    } ]
  }, {
    "tStartMs": 669933,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 670400,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "那咱们得从这过去"
    } ]
  }, {
    "tStartMs": 672533,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "咱们往哪走"
    } ]
  }, {
    "tStartMs": 674300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "就从这走啊"
    } ]
  }, {
    "tStartMs": 675400,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "你们先走"
    } ]
  }, {
    "tStartMs": 676366,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "不知道往哪走"
    } ]
  }, {
    "tStartMs": 677100,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "哎等等等红灯"
    } ]
  }, {
    "tStartMs": 678066,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "又是黄灯了"
    } ]
  }, {
    "tStartMs": 679100,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "这个灯啊"
    } ]
  }, {
    "tStartMs": 683566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我们要是走在这边就"
    } ]
  }, {
    "tStartMs": 685133,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "可以随时从那边过了吧"
    } ]
  }, {
    "tStartMs": 687000,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "不用在马路这过哈哈哈"
    } ]
  }, {
    "tStartMs": 690666,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "咱到前头过也可以"
    } ]
  }, {
    "tStartMs": 692700,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "在这过吧"
    } ]
  }, {
    "tStartMs": 693366,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "不然就逆行"
    } ]
  }, {
    "tStartMs": 694866,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "这前面这个是可以放手机（的）"
    } ]
  }, {
    "tStartMs": 697300,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "然后你就听着你的"
    } ]
  }, {
    "tStartMs": 698333,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "导航一起走就ok了"
    } ]
  }, {
    "tStartMs": 700800,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 702200,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "用支付宝扫码可以骑"
    } ]
  }, {
    "tStartMs": 705366,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我们这个蓝色的小车"
    } ]
  }, {
    "tStartMs": 707066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "叫哈啰单车"
    } ]
  }, {
    "tStartMs": 709533,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我的朋友在前面"
    } ]
  }, {
    "tStartMs": 711466,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "后面还有一个"
    } ]
  }, {
    "tStartMs": 713300,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "刚开始骑的时候可能冷一点"
    } ]
  }, {
    "tStartMs": 715933,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "但是呢现在热身开始"
    } ]
  }, {
    "tStartMs": 720166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "马上要结束了"
    } ]
  }, {
    "tStartMs": 722600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "这是我们的公交站"
    } ]
  }, {
    "tStartMs": 725000,
    "dDurationMs": 4766,
    "segs": [ {
      "utf8": "有很多公交车在这里"
    } ]
  }, {
    "tStartMs": 729766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "可以看到它的信息"
    } ]
  }, {
    "tStartMs": 731800,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "有没有公交车"
    } ]
  }, {
    "tStartMs": 732866,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "还有几站快来"
    } ]
  }, {
    "tStartMs": 734266,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "大概多少分钟"
    } ]
  }, {
    "tStartMs": 737366,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "这条路是很漂亮的"
    } ]
  }, {
    "tStartMs": 741133,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "地上这些闪烁的黄灯啊"
    } ]
  }, {
    "tStartMs": 743766,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "是告诉你这边是有人行道的"
    } ]
  }, {
    "tStartMs": 746133,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "在这里的时候"
    } ]
  }, {
    "tStartMs": 747800,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "汽车要慢一点减速"
    } ]
  }, {
    "tStartMs": 752333,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "以免撞到行人"
    } ]
  }, {
    "tStartMs": 755933,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "比较老式一点的建筑"
    } ]
  }, {
    "tStartMs": 759933,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "看胡同里面都是胡同"
    } ]
  }, {
    "tStartMs": 764666,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "但是晚上有点黑了啊"
    } ]
  }, {
    "tStartMs": 766900,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "所以我们就不进去喽"
    } ]
  }, {
    "tStartMs": 768766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "但是这个晚上骑行的体验"
    } ]
  }, {
    "tStartMs": 770733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "还是很不错的"
    } ]
  }, {
    "tStartMs": 772700,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "建议大家如果能来中国的(城市)"
    } ]
  }, {
    "tStartMs": 779100,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "旅游晚上可以试试骑行哦"
    } ]
  }, {
    "tStartMs": 783066,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "骑行的时候"
    } ]
  }, {
    "tStartMs": 783966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "你们可以用微信扫码"
    } ]
  }, {
    "tStartMs": 786533,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "也可以用支付宝扫一下"
    } ]
  }, {
    "tStartMs": 790000,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "蓝色的黄色的还有绿色的车都有"
    } ]
  }, {
    "tStartMs": 793666,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "都是共享单车哦"
    } ]
  }, {
    "tStartMs": 796700,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "甚至在一些很大的城市"
    } ]
  }, {
    "tStartMs": 799133,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "也有那个共享电动车"
    } ]
  }, {
    "tStartMs": 803133,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "但是我觉得骑行还是更环保"
    } ]
  }, {
    "tStartMs": 806866,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "更可以欣赏沿途的风景"
    } ]
  }, {
    "tStartMs": 810733,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "你们说呢"
    } ]
  }, {
    "tStartMs": 812600,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "你看这些都是小黄车小蓝车小绿车"
    } ]
  }, {
    "tStartMs": 817333,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "都是共享单车"
    } ]
  }, {
    "tStartMs": 819366,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "你们可以在这里借"
    } ]
  }, {
    "tStartMs": 828900,
    "dDurationMs": 3900,
