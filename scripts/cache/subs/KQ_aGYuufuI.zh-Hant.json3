{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 33,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "嗨，大家好"
    } ]
  }, {
    "tStartMs": 1533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "歡迎回到我的頻道"
    } ]
  }, {
    "tStartMs": 3733,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我是安吉拉"
    } ]
  }, {
    "tStartMs": 5600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "今天繼續咱們的中文播客"
    } ]
  }, {
    "tStartMs": 9933,
    "dDurationMs": 8967,
    "segs": [ {
      "utf8": "今天，呢我會把視頻中出現的十個非常常用的漢語單詞標出來"
    } ]
  }, {
    "tStartMs": 19566,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "並且把它們的意思和發音放到視頻的最後"
    } ]
  }, {
    "tStartMs": 26433,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "我希望大家今天看完這個視頻"
    } ]
  }, {
    "tStartMs": 30833,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "能夠掌握十個漢語單詞"
    } ]
  }, {
    "tStartMs": 35633,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "掌握的意思呢就是“學會”"
    } ]
  }, {
    "tStartMs": 38533,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "掌，手掌 握"
    } ]
  }, {
    "tStartMs": 39466,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": " "
    } ]
  }, {
    "tStartMs": 42166,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "，握住 手掌握住，它就是你的東西了"
    } ]
  }, {
    "tStartMs": 45933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "你就學會了"
    } ]
  }, {
    "tStartMs": 47500,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "這就是“掌握”的意思"
    } ]
  }, {
    "tStartMs": 49900,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我希望大家今天看完這個視頻"
    } ]
  }, {
    "tStartMs": 53200,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "能夠掌握十個單詞"
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "其實如果一段視頻能夠學會十個單詞的話"
    } ]
  }, {
    "tStartMs": 62466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "已經非常非常厲害了"
    } ]
  }, {
    "tStartMs": 65133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "好吧咱們現在開始吧"
    } ]
  }, {
    "tStartMs": 67733,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "今天我想跟大家聊的話題是「凡爾賽」"
    } ]
  }, {
    "tStartMs": 72933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "聽到凡爾賽這個詞呢"
    } ]
  }, {
    "tStartMs": 75266,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "大家肯定想到的是法國的凡爾賽"
    } ]
  }, {
    "tStartMs": 80100,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "沒錯，凡爾賽呢是法國的一個城市"
    } ]
  }, {
    "tStartMs": 85600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "應該是在巴黎附近吧"
    } ]
  }, {
    "tStartMs": 88533,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "我沒有去過"
    } ]
  }, {
    "tStartMs": 89800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "這是我在網上查的"
    } ]
  }, {
    "tStartMs": 92666,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "那在那兒呢有一個非常有名的皇宮"
    } ]
  }, {
    "tStartMs": 98233,
    "dDurationMs": 6167,
    "segs": [ {
      "utf8": "以前法國國王的一個皇宮，叫凡爾賽宮"
    } ]
  }, {
    "tStartMs": 104666,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "那這個皇宮非常的豪華"
    } ]
  }, {
    "tStartMs": 107933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "也非常的有名"
    } ]
  }, {
    "tStartMs": 109866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "像我根本沒有去過法國"
    } ]
  }, {
    "tStartMs": 112466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我也聽說過這個皇宮"
    } ]
  }, {
    "tStartMs": 116200,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "那很多去法國旅遊的人呢"
    } ]
  }, {
    "tStartMs": 119433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "去巴黎旅遊的人"
    } ]
  }, {
    "tStartMs": 121633,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "也一定會去這個凡爾賽宮打過卡"
    } ]
  }, {
    "tStartMs": 126400,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "其實啊中國也有一個「凡爾賽」"
    } ]
  }, {
    "tStartMs": 129733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "今天影片的主題呢"
    } ]
  }, {
    "tStartMs": 131733,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "我就想跟大家聊一聊中國這個凡爾賽"
    } ]
  }, {
    "tStartMs": 136300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "中國的凡爾賽不是一個皇宮"
    } ]
  }, {
    "tStartMs": 140233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "也不是一個城市"
    } ]
  }, {
    "tStartMs": 142233,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "不是一個地方"
    } ]
  }, {
    "tStartMs": 143500,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "它是漢語中、中文中最近新出現的一個單詞"
    } ]
  }, {
    "tStartMs": 150333,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "一個新詞"
    } ]
  }, {
    "tStartMs": 152333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "最開始的時候呢"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "它是一個網絡流行語"
    } ]
  }, {
    "tStartMs": 157133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "慢慢地，用的人越來越多"
    } ]
  }, {
    "tStartMs": 160133,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "尤其是年輕人用的越來越多"
    } ]
  }, {
    "tStartMs": 164066,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "它現在已經幾乎變成了一個常規詞彙了"
    } ]
  }, {
    "tStartMs": 169466,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "大家在學習中文的時候"
    } ]
  }, {
    "tStartMs": 172333,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "有沒有遇見過這個詞呢"
    } ]
  }, {
    "tStartMs": 175700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "有沒有聽過這個詞呢"
    } ]
  }, {
    "tStartMs": 179200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "如果你常刷中國的社群媒體"
    } ]
  }, {
    "tStartMs": 183833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "看中國的短片呀"
    } ]
  }, {
    "tStartMs": 186800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "或是說你有中國的朋友"
    } ]
  }, {
    "tStartMs": 189466,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "你可能會看到這樣的表達"
    } ]
  }, {
    "tStartMs": 192433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "聽到這樣的表達"
    } ]
  }, {
    "tStartMs": 194933,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你這人怎麼這麼凡爾賽呀"
    } ]
  }, {
    "tStartMs": 198033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "你別這麼凡爾賽了行嗎"
    } ]
  }, {
    "tStartMs": 201033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "你這是典型的凡爾賽啊"
    } ]
  }, {
    "tStartMs": 204233,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "那大家知道凡爾賽是什什麼意思嗎"
    } ]
  }, {
    "tStartMs": 208000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "簡單的來說"
    } ]
  }, {
    "tStartMs": 209300,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "凡爾賽是一種說話方式"
    } ]
  }, {
    "tStartMs": 212833,
    "dDurationMs": 7700,
    "segs": [ {
      "utf8": "它是用一種抱怨或者不滿的語氣來炫耀自己的一種說話方式"
    } ]
  }, {
    "tStartMs": 221433,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "炫耀自己"
    } ]
  }, {
    "tStartMs": 222933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "顯擺自己"
    } ]
  }, {
    "tStartMs": 224633,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "顯擺也是炫耀的意思"
    } ]
  }, {
    "tStartMs": 227866,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "炫耀自己很牛、很牛逼、很厲害"
    } ]
  }, {
    "tStartMs": 232133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "很有錢或者其他的"
    } ]
  }, {
    "tStartMs": 234833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "炫耀什麼都可以"
    } ]
  }, {
    "tStartMs": 236533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "重點是呢"
    } ]
  }, {
    "tStartMs": 237700,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "它不是直接的炫耀"
    } ]
  }, {
    "tStartMs": 240133,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "而是用一種抱怨的語氣"
    } ]
  }, {
    "tStartMs": 243100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "或者不滿的語氣"
    } ]
  }, {
    "tStartMs": 245066,
    "dDurationMs": 6134,
    "segs": [ {
      "utf8": "在不經意之間炫耀自己的一種說話方式"
    } ]
  }, {
    "tStartMs": 251200,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我舉個例子大家就知道了"
    } ]
  }, {
    "tStartMs": 254233,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "比如說一個人跟你說"
    } ]
  }, {
    "tStartMs": 257200,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "哎我的新房子太煩了"
    } ]
  }, {
    "tStartMs": 259833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "房間太多了"
    } ]
  }, {
    "tStartMs": 261866,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "每天我都要花很長的時間打掃衛生"
    } ]
  }, {
    "tStartMs": 266700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "太累了"
    } ]
  }, {
    "tStartMs": 268733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "那表面上看呢"
    } ]
  }, {
    "tStartMs": 270500,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "他是在抱怨每天收拾房間、打掃房間很累"
    } ]
  }, {
    "tStartMs": 276400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那實際上呢"
    } ]
  }, {
    "tStartMs": 277800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "或者別人聽起來呢"
    } ]
  }, {
    "tStartMs": 280033,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "其實是他想在表達他的新房子很大"
    } ]
  }, {
    "tStartMs": 284833,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "他有一個很大的房子、他很有錢"
    } ]
  }, {
    "tStartMs": 290033,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "你看啊，他沒有直接說他很有錢"
    } ]
  }, {
    "tStartMs": 293900,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "沒有直接地炫耀他的房子很大"
    } ]
  }, {
    "tStartMs": 297466,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "他是用一種不滿的語氣"
    } ]
  }, {
    "tStartMs": 300600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "用一種很煩的語氣"
    } ]
  }, {
    "tStartMs": 302866,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "不經意之間炫耀了他的房子"
    } ]
  }, {
    "tStartMs": 306700,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "這就是一種典型的凡爾賽的說話方式"
    } ]
  }, {
    "tStartMs": 311533,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "那我們也把這種說話方式叫做“凡爾賽文學”"
    } ]
  }, {
    "tStartMs": 317266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "這裡的文學並不是一個學科"
    } ]
  }, {
    "tStartMs": 321100,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "它是一種調侃的方式"
    } ]
  }, {
    "tStartMs": 324466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "或者說是一種開玩笑的方式"
    } ]
  }, {
    "tStartMs": 327700,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "甚至是有一些諷刺"
    } ]
  }, {
    "tStartMs": 331233,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "來諷刺這種炫耀的說話方式"
    } ]
  }, {
    "tStartMs": 334833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "對它是一種諷刺"
    } ]
  }, {
    "tStartMs": 336733,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "所以說它是凡爾賽文學"
    } ]
  }, {
    "tStartMs": 339800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "大家能理解嗎"
    } ]
  }, {
    "tStartMs": 341466,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "凡爾賽這個詞兒是怎麼來的呢"
    } ]
  }, {
    "tStartMs": 344733,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "雖然我在生活中也會經常說這個詞"
    } ]
  }, {
    "tStartMs": 349300,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "但是我還真不知道它是怎麼來的"
    } ]
  }, {
    "tStartMs": 353400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "於是我就去上網查了一下"
    } ]
  }, {
    "tStartMs": 356733,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "原來是在2020年的時候"
    } ]
  }, {
    "tStartMs": 360466,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "大概六年前了"
    } ]
  }, {
    "tStartMs": 362700,
    "dDurationMs": 7300,
    "segs": [ {
      "utf8": "有一個人在網上用這種方式炫耀她自己的生活"
    } ]
  }, {
    "tStartMs": 370300,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "顯擺她自己豪華的生活"
    } ]
  }, {
    "tStartMs": 373800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "顯擺她很有錢"
    } ]
  }, {
    "tStartMs": 375800,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "顯擺她自己的豪宅，很豪華的房子"
    } ]
  }, {
    "tStartMs": 380233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "顯擺她的老公特別寵愛她"
    } ]
  }, {
    "tStartMs": 383700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "很多人看到之後都給她評論"
    } ]
  }, {
    "tStartMs": 387500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "其中有一個人呀"
    } ]
  }, {
    "tStartMs": 389466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "認為她這種炫耀的方式"
    } ]
  }, {
    "tStartMs": 392866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "她炫耀的這些東西"
    } ]
  }, {
    "tStartMs": 395300,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "特別像一部日本漫畫《凡爾賽玫瑰》"
    } ]
  }, {
    "tStartMs": 400733,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "這本漫畫中描寫的法國貴族的生活"
    } ]
  }, {
    "tStartMs": 405333,
    "dDurationMs": 7567,
    "segs": [ {
      "utf8": "於是呢就用凡爾賽這個詞來諷刺她的這種炫耀"
    } ]
  }, {
    "tStartMs": 412900,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "慢慢地，這個詞就流傳開了"
    } ]
  }, {
    "tStartMs": 417100,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "現在就變成了一個大家非常常用的一個詞彙了"
    } ]
  }, {
    "tStartMs": 422833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "咱們現在再舉幾個例子"
    } ]
  }, {
    "tStartMs": 425466,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "看看凡爾賽這種炫耀的方式有什麼特點"
    } ]
  }, {
    "tStartMs": 431033,
    "dDurationMs": 6067,
    "segs": [ {
      "utf8": "第一個特點就是先貶低自己、再抬高自己"
    } ]
  }, {
    "tStartMs": 437100,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "貶低、抬高"
    } ]
  }, {
    "tStartMs": 439400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "先把自己說得很不好"
    } ]
  }, {
    "tStartMs": 442300,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "然後呢再讓大家覺得他很好"
    } ]
  }, {
    "tStartMs": 446500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "這就叫先貶低自己，把自己放低"
    } ]
  }, {
    "tStartMs": 450200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "把自己弄得很低"
    } ]
  }, {
    "tStartMs": 452066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "再把自己弄得很高"
    } ]
  }, {
    "tStartMs": 454066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "貶低、抬高"
    } ]
  }, {
    "tStartMs": 456466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "也就是說"
    } ]
  }, {
    "tStartMs": 457700,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "說話的時候先說自己不好"
    } ]
  }, {
    "tStartMs": 461100,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "很煩、很煩惱、很不滿"
    } ]
  }, {
    "tStartMs": 464400,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "實際上呢，是想讓大家覺得他自己很厲害、很牛逼"
    } ]
  }, {
    "tStartMs": 470800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那比如說有一個人跟你說"
    } ]
  }, {
    "tStartMs": 473400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "哎呀我每天早上太煩了"
    } ]
  }, {
    "tStartMs": 475833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "櫃子裡都是包兒"
    } ]
  }, {
    "tStartMs": 477700,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "我都不知道每天背哪個包兒出門"
    } ]
  }, {
    "tStartMs": 482000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "她是在煩惱嗎？"
    } ]
  }, {
    "tStartMs": 484466,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "不是，她其實是在炫耀自己"
    } ]
  }, {
    "tStartMs": 487833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "她有很多名牌包兒"
    } ]
  }, {
    "tStartMs": 490433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "有很多大牌兒的包兒"
    } ]
  }, {
    "tStartMs": 492900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "再比如說"
    } ]
  }, {
    "tStartMs": 493833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "有一個人跟你說"
    } ]
  }, {
    "tStartMs": 495466,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "哎呀真煩"
    } ]
  }, {
    "tStartMs": 496533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我每天吃這麼多東西"
    } ]
  }, {
    "tStartMs": 498600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我就是不長肉"
    } ]
  }, {
    "tStartMs": 500033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我什麼時候才能胖一點啊"
    } ]
  }, {
    "tStartMs": 503033,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "表面上她是在抱怨自己、嫌自己瘦"
    } ]
  }, {
    "tStartMs": 507200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "嫌自己 吃"
    } ]
  }, {
    "tStartMs": 510100,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "東西不長肉"
    } ]
  }, {
    "tStartMs": 513433,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "實際上吃"
    } ]
  }, {
    "tStartMs": 518833,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "怎麼的身材"
    } ]
  }, {
    "tStartMs": 521066,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "那麼胖子聽見的話會很生氣的，對不對"
    } ]
  }, {
    "tStartMs": 525066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "第二個特點"
    } ]
  }, {
    "tStartMs": 526333,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "凡爾賽的人呢說話會很隨意"
    } ]
  }, {
    "tStartMs": 530233,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "在不經意之間炫耀自己"
    } ]
  }, {
    "tStartMs": 534000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "他們不會直接地炫耀"
    } ]
  }, {
    "tStartMs": 536466,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "不會直接跟你說你看我多有錢"
    } ]
  }, {
    "tStartMs": 539800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "你看我老公對我多好"
    } ]
  }, {
    "tStartMs": 542066,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "你看我多聰明"
    } ]
  }, {
    "tStartMs": 543900,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那這些不是凡爾賽"
    } ]
  }, {
    "tStartMs": 545866,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "這些太直接了"
    } ]
  }, {
    "tStartMs": 547533,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "這種 語氣"
    } ]
  }, {
    "tStartMs": 551300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "不是凡爾賽"
    } ]
  }, {
    "tStartMs": 556133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "心說出來一樣"
    } ]
  }, {
    "tStartMs": 558833,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "假裝自己不是在炫耀"
    } ]
  }, {
    "tStartMs": 562033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那比如說"
    } ]
  }, {
    "tStartMs": 562833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "有一個人跟你說，"
    } ]
  }, {
    "tStartMs": 564833,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "哎，我家旁邊的那個大牌，LV店"
    } ]
  }, {
    "tStartMs": 569000,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我今天路過的時候，發現有好多人啊"
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "我才想起來，我上次新買的包兒我還沒背過呢"
    } ]
  }, {
    "tStartMs": 578133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "那這 就是"
    } ]
  }, {
    "tStartMs": 581466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "一個不經意的炫耀"
    } ]
  }, {
    "tStartMs": 584400,
    "dDurationMs": 6666,
    "segs": [ {
      "utf8": "她 好像在隨便的聊天"
    } ]
  }, {
    "tStartMs": 591300,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "店"
    } ]
  }, {
    "tStartMs": 593433,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "她還有很多包兒"
    } ]
  }, {
    "tStartMs": 595100,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "她有很多LV的包兒都背不過來"
    } ]
  }, {
    "tStartMs": 598533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "太多了，沒有時間背"
    } ]
  }, {
    "tStartMs": 601100,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "那這就是一種不經意之間的炫耀"
    } ]
  }, {
    "tStartMs": 605700,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "第三個特點"
    } ]
  }, {
    "tStartMs": 606933,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "凡爾賽的人呢喜歡用別人的話來誇自己"
    } ]
  }, {
    "tStartMs": 612200,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "他不是直接用自己的話來炫耀"
    } ]
  }, {
    "tStartMs": 616033,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "而是通過別人的嘴"
    } ]
  }, {
    "tStartMs": 618333,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "通過別人說的話來炫耀"
    } ]
  }, {
    "tStartMs": 622800,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "哎呀說我我每天都說我像個明星"
    } ]
  }, {
    "tStartMs": 627666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "他每天都說我像個明星"
    } ]
  }, {
    "tStartMs": 630133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我都煩死了"
    } ]
  }, {
    "tStartMs": 631466,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "我一點兒都不想跟明星長得一樣"
    } ]
  }, {
    "tStartMs": 634866,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "那這個就是用男朋友的話來炫耀自己長得很漂亮"
    } ]
  }, {
    "tStartMs": 641066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "長得像明星"
    } ]
  }, {
    "tStartMs": 643066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "這就是凡爾賽的三個特點"
    } ]
  }, {
    "tStartMs": 646700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "那大家可能會問"
    } ]
  }, {
    "tStartMs": 648500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "中國人為什麼會凡爾賽呢"
    } ]
  }, {
    "tStartMs": 651533,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "有話直接說看起來像明星這就是凡爾賽的三個特點"
    } ]
  }, {
    "tStartMs": 654466,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "那"
    } ]
  }, {
    "tStartMs": 656933,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "大家可能會"
    } ]
  }, {
    "tStartMs": 660233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "問中國人為什麼會凡爾賽呢有話直接說不好嗎這"
    } ]
  }, {
    "tStartMs": 663433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "是一個很好的"
    } ]
  }, {
    "tStartMs": 666400,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "問題"
    } ]
  }, {
    "tStartMs": 670800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "其實"
    } ]
  }, {
    "tStartMs": 673433,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "牛"
    } ]
  }, {
    "tStartMs": 676100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "在中國的文化裡"
    } ]
  }, {
    "tStartMs": 677533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "謙虛才是美德"
    } ]
  }, {
    "tStartMs": 680300,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "但是呢現在又有很多人"
    } ]
  }, {
    "tStartMs": 683233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "特別希望別人知道自己過得好"
    } ]
  }, {
    "tStartMs": 686733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "知道自己很有錢"
    } ]
  }, {
    "tStartMs": 688833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "知道自己很成功"
    } ]
  }, {
    "tStartMs": 690900,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "所以呢他們找到了這種「聰明」的方式"
    } ]
  }, {
    "tStartMs": 695000,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "用一種抱怨的語氣、不滿的語氣來炫耀自己"
    } ]
  }, {
    "tStartMs": 700500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "這樣他們就可以說"
    } ]
  }, {
    "tStartMs": 702033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我沒有"
    } ]
  }, {
    "tStartMs": 703833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "在炫耀我"
    } ]
  }, {
    "tStartMs": 707000,
    "dDurationMs": 6066,
    "segs": [ {
      "utf8": "只是在說我自己的不滿是"
    } ]
  }, {
    "tStartMs": 713300,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "聽"
    } ]
  }, {
    "tStartMs": 718700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "大家其實不喜歡這種說話方式"
    } ]
  }, {
    "tStartMs": 722533,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "覺得這種說話方式太做作了"
    } ]
  }, {
    "tStartMs": 726100,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "太不真誠了"
    } ]
  }, {
    "tStartMs": 728466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "當一個人跟你說，「你別凡爾賽了」"
    } ]
  }, {
    "tStartMs": 732033,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "其實他的意思是"
    } ]
  }, {
    "tStartMs": 733600,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "行了行了，你別炫耀了，我知道你在顯擺，別裝了"
    } ]
  }, {
    "tStartMs": 738966,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "好啦現在你知道凡爾賽的意思了吧"
    } ]
  }, {
    "tStartMs": 742466,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "最後呢咱們再看看凡爾賽的用法"
    } ]
  }, {
    "tStartMs": 746500,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "第一種用法"
    } ]
  }, {
    "tStartMs": 747900,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "直接把它當做形容詞"
    } ]
  }, {
    "tStartMs": 751133,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "你可以直接說一個人"
    } ]
  }, {
    "tStartMs": 752933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "你也太凡爾賽了"
    } ]
  }, {
    "tStartMs": 754900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那這是形容詞"
    } ]
  }, {
    "tStartMs": 756833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "第二個用法呢"
    } ]
  }, {
    "tStartMs": 758333,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "是動詞，你別凡爾賽了"
    } ]
  }, {
    "tStartMs": 762200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "你現在是在凡爾賽"
    } ]
  }, {
    "tStartMs": 765033,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "意思是你現在是在炫耀"
    } ]
  }, {
    "tStartMs": 768433,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "那第三種用法呢也可以當成一個名詞"
    } ]
  }, {
    "tStartMs": 773533,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "比如說，你這是在凡爾賽意思是"
    } ]
  }, {
    "tStartMs": 777033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "你現在是在炫耀那第三種用法呢也可以當成一個名詞"
    } ]
  }, {
    "tStartMs": 780033,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "比如說，"
    } ]
  }, {
    "tStartMs": 783833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "你這是在凡爾賽意思是你現在是在炫耀"
    } ]
  }, {
    "tStartMs": 787533,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "那"
    } ]
  }, {
    "tStartMs": 789300,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "第三種用法呢也可以當成一個名詞比如說，你這是典型的凡爾賽你這是典型的炫耀行為好了凡爾賽"
    } ]
  }, {
    "tStartMs": 794066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "今天"
    } ]
  }, {
    "tStartMs": 796633,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "就 講到這兒"
    } ]
  }, {
    "tStartMs": 799600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "你們明白 它的意思和用法了嗎"
    } ]
  }, {
    "tStartMs": 801533,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "如果你們聽明白了"
    } ]
  }, {
    "tStartMs": 803466,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "可以在評論區寫一句 我的話"
    } ]
  } ]
}
