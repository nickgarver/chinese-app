    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "gōng chéng liàng hái yǒu diǎn dà\n工程量还有点大"
    } ]
  }, {
    "tStartMs": 297900,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "wǒ men xiàn zài xiān qù zhǔn bèi shí cái zhǔn bèi shí cái\n我们现在先去准备食材准备食材"
    } ]
  }, {
    "tStartMs": 303333,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "wǒ xiàn zài ne\n我现在呢"
    } ]
  }, {
    "tStartMs": 304266,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "yào xiān qiè yī xià zhè ge qīng jiāo\n要先切一下这个青椒"
    } ]
  }, {
    "tStartMs": 307133,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ ná le yí gè xiǎo de cài bǎn cài bǎn\n所以我拿了一个小的菜板菜板"
    } ]
  }, {
    "tStartMs": 311100,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "zhè shì yí gè xiǎo yì diǎn de cài bǎn\n这是一个小一点的菜板"
    } ]
  }, {
    "tStartMs": 313633,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "tā ne shì zhuān mén qiè gè zhǒng shū cài hé shuǐ guǒ de\n它呢是专门切各种蔬菜和水果的"
    } ]
  }, {
    "tStartMs": 321900,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "zhè ge shì dāo dāo ń\n这个是刀刀嗯"
    } ]
  }, {
    "tStartMs": 327533,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "rán hòu ne wǒ men xiān bǎ zhè ge qīng jiāo xǐ yī xià\n然后呢我们先把这个青椒洗一下"
    } ]
  }, {
    "tStartMs": 332066,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "xǐ xǐ xǐ yī xià xǐ yī xià\n洗洗洗一下洗一下"
    } ]
  }, {
    "tStartMs": 338233,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "rán hòu zhè ge dòu fǔ dòu fǔ yě xǐ yī xià\n然后这个豆腐豆腐也洗一下"
    } ]
  }, {
    "tStartMs": 343966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "nà zhè ge ne\n那这个呢"
    } ]
  }, {
    "tStartMs": 344866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "wǒ men yě kě yǐ jiào zuò chōng chōng\n我们也可以叫做冲冲"
    } ]
  }, {
    "tStartMs": 347766,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "bǎ dòu fǔ chōng yī xià\n把豆腐冲一下"
    } ]
  }, {
    "tStartMs": 353266,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "chōng yī xià\n冲一下"
    } ]
  }, {
    "tStartMs": 355900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "jiē xià lái wǒ men kāi shǐ qiē qiē\n接下来我们开始切切"
    } ]
  }, {
    "tStartMs": 363733,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "xiàng zhè ge ne\n像这个呢"
    } ]
  }, {
    "tStartMs": 364700,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "shì qīng jiāo de gēn jīng\n是青椒的根茎"
    } ]
  }, {
    "tStartMs": 367133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "wǒ men shì bù chī de\n我们是不吃的"
    } ]
  }, {
    "tStartMs": 368333,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "wǒ yào bǎ tā gěi bāi xià lái bāi xià lái\n我要把它给掰下来掰下来"
    } ]
  }, {
    "tStartMs": 373966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "zhè ge\n这个"
    } ]
  }, {
    "tStartMs": 375700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "bāi\n掰"
    } ]
  }, {
    "tStartMs": 376966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "bāi xià lái\n掰下来"
    } ]
  }, {
    "tStartMs": 378700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "jì xù qiè\n继续切"
    } ]
  }, {
    "tStartMs": 381566,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "nà wǒ men yì bān qiè de shí hòu ne\n那我们一般切的时候呢"
    } ]
  }, {
    "tStartMs": 383933,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "kě néng huì qiè chéng kuài huò zhě qiè chéng sī\n可能会切成块或者切成丝"
    } ]
  }, {
    "tStartMs": 388166,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "kuài ér ， sī ér\n块儿，丝儿"
    } ]
  }, {
    "tStartMs": 389933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "dàn shì wǒ bú huì qiè sī\n但是我不会切丝"
    } ]
  }, {
    "tStartMs": 391566,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "yīn wèi tài má fán le\n因为太麻烦了"
    } ]
  }, {
    "tStartMs": 392733,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "wǒ yì bān jiù qiè chéng zhè zhǒng xiǎo xiǎo de kuài\n我一般就切成这种小小的块"
    } ]
  }, {
    "tStartMs": 396533,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "zài bǎ tā zhè yàng fàng jìn wǎn lǐ fàng\n再把它这样放进碗里放"
    } ]
  }, {
    "tStartMs": 400366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "fàng jìn wǎn lǐ\n放进碗里"
    } ]
  }, {
    "tStartMs": 402766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "nà jiē xià lái ne\n那接下来呢"
    } ]
  }, {
    "tStartMs": 403700,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "wǒ hái yào jì xù qiè dòu fǔ\n我还要继续切豆腐"
    } ]
  }, {
    "tStartMs": 406666,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "dòu fǔ wǒ yì bān yě shì qiè chéng kuài ér\n豆腐我一般也是切成块儿"
    } ]
  }, {
    "tStartMs": 409933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "qiè\n切"
    } ]
  }, {
    "tStartMs": 413433,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "hǎo de ， wǒ men bǎ cài yǐ jīng dōu qiè hǎo le\n好的，我们把菜已经都切好了"
    } ]
  }, {
    "tStartMs": 417100,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "jiē xià lái ne wǒ yào qiè ròu\n接下来呢我要切肉"
    } ]
  }, {
    "tStartMs": 419900,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "zhè ge ròu shì cóng bīng xiāng lǐ ná chū lái huǎn huǎn\n这个肉是从冰箱里拿出来缓缓"
    } ]
  }, {
    "tStartMs": 424166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "rán hòu wǒ yòng shǒu zhè yàng zi mō yī xià\n然后我用手这样子摸一下"
    } ]
  }, {
    "tStartMs": 426600,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "kàn kàn tā huǎn de chéng dù zěn me yàng\n看看它缓的程度怎么样"
    } ]
  }, {
    "tStartMs": 430366,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "gǎn jué chà bu duō le\n感觉差不多了"
    } ]
  }, {
    "tStartMs": 431700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "kě yǐ qiè le\n可以切了"
    } ]
  }, {
    "tStartMs": 433400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "nà wǒ qiè ròu de huà\n那我切肉的话"
    } ]
  }, {
    "tStartMs": 434900,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "wǒ huì ná chū zhè ge dà yī diǎn de cài bǎn\n我会拿出这个大一点的菜板"
    } ]
  }, {
    "tStartMs": 438566,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "ó hǎo zhòng a\n哦好重啊"
    } ]
  }, {
    "tStartMs": 440300,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "zhè ge zhè ge hěn dà\n这个这个很大"
    } ]
  }, {
    "tStartMs": 444366,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "ér qiě hěn zhòng\n而且很重"
    } ]
  }, {
    "tStartMs": 446000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "hěn dà hěn zhòng\n很大很重"
    } ]
  }, {
    "tStartMs": 449200,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "wǒ yě huì huàn chéng zhè ge\n我也会换成这个"
    } ]
  }, {
    "tStartMs": 451466,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "zhè ge wǒ men jiào cài dāo cài dāo\n这个我们叫菜刀菜刀"
    } ]
  }, {
    "tStartMs": 453966,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "ń zhè ge gèng dà yī diǎn\n嗯这个更大一点"
    } ]
  }, {
    "tStartMs": 456300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "yòng tā lái qiè ròu\n用它来切肉"
    } ]
  }, {
    "tStartMs": 459866,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "qiē qiē ròu\n切切肉"
    } ]
  }, {
    "tStartMs": 462000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "wǒ yào bǎ zhè ge ròu qiè chéng piàn piàn\n我要把这个肉切成片片"
    } ]
  }, {
    "tStartMs": 465333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "ròu piàn ròu piàn ń\n肉片肉片嗯"
    } ]
  }, {
    "tStartMs": 469933,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "zhè zhǒng wǒ men huì jiào è dāo gōng dāo gōng\n这种我们会叫呃刀工刀工"
    } ]
  }, {
    "tStartMs": 473100,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "yǒu de rén dāo gōng tè bié lì hài\n有的人刀工特别厉害"
    } ]
  }, {
    "tStartMs": 475300,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "bù guǎn shì ròu hái shì shū cài dōu\n不管是肉还是蔬菜都"
    } ]
  }, {
    "tStartMs": 477366,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "kě yǐ qiè de fēi cháng de hǎo kàn\n可以切的非常的好看"
    } ]
  }, {
    "tStartMs": 479866,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "dàn shì xiàng wǒ de huà jiù yì bān bān\n但是像我的话就一般般"
    } ]
  }, {
    "tStartMs": 482100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "dāo gōng méi yǒu nà me hǎo\n刀工没有那么好"
    } ]
  }, {
    "tStartMs": 483700,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "suǒ yǐ zhè ge jiào dāo gōng\n所以这个叫刀工"
    } ]
  }, {
    "tStartMs": 485333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "jiù shì nǐ qiè ròu huò zhě qiè cài\n就是你切肉或者切菜"
    } ]
  }, {
    "tStartMs": 487166,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "de yí gè jì qiǎo tè bié hǎo\n的一个技巧特别好"
    } ]
  }, {
    "tStartMs": 489100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "jiào zuò dāo gōng tè bié hǎo\n叫做刀工特别好"
    } ]
  }, {
    "tStartMs": 491266,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "dāng dāng dāng dāng qiè hǎo la\n当当当当切好啦"
    } ]
  }, {
    "tStartMs": 493966,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "nǐ men kàn zhè biān ne\n你们看这边呢"
    } ]
  }, {
    "tStartMs": 496166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "shì gāng gāng qiè de zhū ròu\n是刚刚切的猪肉"
    } ]
  }, {
    "tStartMs": 498966,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "zhè biān ne shì wǒ qiè le yī xiē suàn suàn\n这边呢是我切了一些蒜蒜"
    } ]
  }, {
    "tStartMs": 503033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "nà wǒ shǒu xiān ne\n那我首先呢"
    } ]
  }, {
    "tStartMs": 504200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "huì zuò dì yí gè cài\n会做第一个菜"
    } ]
  }, {
    "tStartMs": 506400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "má pó dòu fǔ\n麻婆豆腐"
    } ]
  }, {
    "tStartMs": 508566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "hā hā è\n哈哈呃"
    } ]
  }, {
    "tStartMs": 510033,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "nǐ men kàn zhè ge shì wǒ chǎo cài yòng de guō\n你们看这个是我炒菜用的锅"
    } ]
  }, {
    "tStartMs": 513933,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "zhè ge shì chǎo cài yòng de guō guō\n这个是炒菜用的锅锅"
    } ]
  }, {
    "tStartMs": 517600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "rán hòu děng yí xià wǒ men hái huì yòng dào zhè ge\n然后等一下我们还会用到这个"
    } ]
  }, {
    "tStartMs": 520933,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "zhè ge shì chǎn zi chǎn zi\n这个是铲子铲子"
    } ]
  }, {
    "tStartMs": 524266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "yòng lái zhè yàng chǎo chǎo\n用来这样炒炒"
    } ]
  }, {
    "tStartMs": 526400,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "yòng lái chǎo cài yòng de\n用来炒菜用的"
    } ]
  }, {
    "tStartMs": 528233,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "zhè lǐ ne shì diàn cí lú de kāi guān dǎ kāi\n这里呢是电磁炉的开关打开"
    } ]
  }, {
    "tStartMs": 533966,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "rán hòu ne wǎng lǐ miàn dào yī xiē yóu\n然后呢往里面倒一些油"
    } ]
  }, {
    "tStartMs": 537933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "dào dào yóu\n倒倒油"
    } ]
  }, {
    "tStartMs": 541133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "hǎo yì diǎn diǎn jiù kě yǐ le\n好一点点就可以了"
    } ]
  }, {
    "tStartMs": 543533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "wǒ bù xǐ huān chī tài duō de yóu\n我不喜欢吃太多的油"
    } ]
  }, {
    "tStartMs": 546100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ měi cì zhǐ fàng yì diǎn diǎn yì diǎn diǎn ń\n所以我每次只放一点点一点点嗯"
    } ]
  }, {
    "tStartMs": 550500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "hǎo wǒ men xiàn zài děng yóu rè yì diǎn\n好我们现在等油热一点"
    } ]
  }, {
    "tStartMs": 554066,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "wǒ yào dǎ kāi chōu yóu yān jī\n我要打开抽油烟机"
    } ]
  }, {
    "tStartMs": 559133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "hǎo\n好"
    } ]
  }, {
    "tStartMs": 561533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "jiē xià lái wǒ yào bǎ zhè ge jiàng\n接下来我要把这个酱"
    } ]
  }, {
    "tStartMs": 563766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "zhè ge shì dòu bàn jiàng\n这个是豆瓣酱"
    } ]
  }, {
    "tStartMs": 565433,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "dòu bàn jiàng dào jìn guō lǐ\n豆瓣酱倒进锅里"
    } ]
  }, {
    "tStartMs": 569966,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "zhè ge shì wǒ gāng cái fàng de dòu bàn jiàng\n这个是我刚才放的豆瓣酱"
    } ]
  }, {
    "tStartMs": 573066,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "bǎ tā zhè yàng zi chǎo yī xià\n把它这样子炒一下"
    } ]
  }, {
    "tStartMs": 576333,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "bǎ zhè ge dòu fǔ dòu fǔ dào jìn qù\n把这个豆腐豆腐倒进去"
    } ]
  }, {
    "tStartMs": 580833,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "dào dào jìn qù\n倒倒进去"
    } ]
  }, {
    "tStartMs": 586266,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "jì xù chǎo chǎo chǎo dòu fǔ\n继续炒炒炒豆腐"
    } ]
  }, {
    "tStartMs": 591233,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "nà jì rán shì má pó dòu fǔ\n那既然是麻婆豆腐"
    } ]
  }, {
    "tStartMs": 593700,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "tā jiù yí dìng yào yǒu là jiāo là jiāo\n它就一定要有辣椒辣椒"
    } ]
  }, {
    "tStartMs": 597100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "nǐ men hěn duō rén zhī qián gēn wǒ jiǎng\n你们很多人之前跟我讲"
    } ]
  }, {
    "tStartMs": 598933,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "shuō a chī bù guàn wǒ men de cài\n说啊吃不惯我们的菜"
    } ]
  }, {
    "tStartMs": 601466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "shì yīn wèi jué de tā tài là le\n是因为觉得它太辣了"
    } ]
  }, {
    "tStartMs": 604266,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "què shí è chuān cài\n确实呃川菜"
    } ]
  }, {
    "tStartMs": 606466,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "zhōng guó de chuān cài huì fàng hěn duō de là jiāo\n中国的川菜会放很多的辣椒"
    } ]
  }, {
    "tStartMs": 609133,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "huì bǐ jiào là\n会比较辣"
    } ]
  }, {
    "tStartMs": 611100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "qí shí wǒ yě bù tài néng chī hěn duō là jiāo\n其实我也不太能吃很多辣椒"
    } ]
  }, {
    "tStartMs": 613566,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "dàn shì fàng yì diǎn diǎn hái shì kě yǐ de\n但是放一点点还是可以的"
    } ]
  }, {
    "tStartMs": 618566,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "zhè ge jiù shì lǎo gàn mā\n这个就是老干妈"
    } ]
  }, {
    "tStartMs": 621233,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "lǎo gàn mā là jiàng lǎo gàn mā là jiàng\n老干妈辣酱老干妈辣酱"
    } ]
  }, {
    "tStartMs": 624533,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "a shàng qī guàng chāo shì de shí hòu yě gēn nǐ men shuō guò\n啊上期逛超市的时候也跟你们说过"
    } ]
  }, {
    "tStartMs": 627966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "zhè ge wǒ men zuò fàn de shí hòu jīng cháng huì yòng\n这个我们做饭的时候经常会用"
    } ]
  }, {
    "tStartMs": 630833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "tā shì yī zhǒng hěn hǎo de tiáo liào tiáo liào\n它是一种很好的调料调料"
    } ]
  }, {
    "tStartMs": 634833,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "wǒ yòng sháo zi ne yǎo yǎo\n我用勺子呢舀舀"
    } ]
  }, {
    "tStartMs": 639066,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "yì diǎn diǎn jiù hǎo le\n一点点就好了"
    } ]
  }, {
    "tStartMs": 640766,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "zhè ge jiù shì yì diǎn diǎn yì diǎn diǎn\n这个就是一点点一点点"
    } ]
  }, {
    "tStartMs": 643266,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "tài duō le de huà huì tài là\n太多了的话会太辣"
    } ]
  }, {
    "tStartMs": 647500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "yǎo yì diǎn diǎn\n舀一点点"
    } ]
  }, {
    "tStartMs": 648300,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "bǎ tā fàng jìn guō lǐ fàng jìn guō lǐ\n把它放进锅里放进锅里"
    } ]
  }, {
    "tStartMs": 655733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "rán hòu jì xù chǎo\n然后继续炒"
    } ]
  }, {
    "tStartMs": 658466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯"
    } ]
  }, {
    "tStartMs": 660500,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "a nà ge xiāng qì yǐ jīng pū guò lái le\n啊那个香气已经扑过来了"
    } ]
  }, {
    "tStartMs": 665033,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "rán hòu yào zài wǎng lǐ miàn jiā yì diǎn diǎn shuǐ\n然后要再往里面加一点点水"
    } ]
  }, {
    "tStartMs": 671700,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "jiā le yì diǎn shuǐ\n加了一点水"
    } ]
  }, {
    "tStartMs": 673966,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "wǒ men bǎ zhè ge guō gài gài shàng\n我们把这个锅盖盖上"
    } ]
  }, {
    "tStartMs": 677266,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "zhè ge shì guō gài guō gài\n这个是锅盖锅盖"
    } ]
  }, {
    "tStartMs": 679933,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "bǎ tā gài shàng gài shàng\n把它盖上盖上"
    } ]
  }, {
    "tStartMs": 683033,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "shāo wēi de mèn yī huì\n稍微的焖一会"
    } ]
  }, {
    "tStartMs": 685300,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "mèn mèn yī huì\n焖焖一会"
    } ]
  }, {
    "tStartMs": 688033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "a wán le péng yǒu men\n啊完了朋友们"
    } ]
  }, {
    "tStartMs": 689766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "wǒ wàng jì dài wéi qún la\n我忘记戴围裙啦"
    } ]
  }, {
    "tStartMs": 694866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "gǎn jǐn dài shàng\n赶紧戴上"
    } ]
  }, {
    "tStartMs": 696566,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "bù rán děng xià wǒ de bái t xù jiù yào nòng zāng le\n不然等下我的白t恤就要弄脏了"
    } ]
  }, {
    "tStartMs": 701566,
    "dDurationMs": 6534,
    "segs": [ {
      "utf8": "zhè ge shì wéi qún wéi qún wéi qún dài wéi qún\n这个是围裙围裙围裙戴围裙"
    } ]
  }, {
    "tStartMs": 711133,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "dài dài wéi qún\n戴戴围裙"
    } ]
  }, {
    "tStartMs": 713533,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "ń hǎo la dài hǎo le\n嗯好啦戴好了"
    } ]
  }, {
    "tStartMs": 716066,
    "dDurationMs": 4934,
    "segs": [ {
      "utf8": "wǒ men qīng qīng de xiān kāi gài zi wén yī xià qīng qīng de\n我们轻轻的掀开盖子闻一下轻轻的"
    } ]
  }, {
    "tStartMs": 722066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa ó\n哇哦"
    } ]
  }, {
    "tStartMs": 723766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "wa hǎo xiāng a\n哇好香啊"
    } ]
  }, {
    "tStartMs": 726166,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "jiē xià lái wǒ yào cháng yī xià cháng yī xià\n接下来我要尝一下尝一下"
    } ]
  }, {
    "tStartMs": 732133,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "tài tàng le suǒ yǐ wǒ yào chuī yī xià chuī\n太烫了所以我要吹一下吹"
    } ]
  }, {
    "tStartMs": 741133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯"
    } ]
  }, {
    "tStartMs": 742166,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "hěn hǎo chī le ń\n很好吃了嗯"
    } ]
  }, {
    "tStartMs": 745433,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "yīn wèi gāng cái fàng de nà ge jiàng ne\n因为刚才放的那个酱呢"
    } ]
  }, {
    "tStartMs": 747533,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "běn shēn jiù hěn xián hěn xián\n本身就很咸很咸"
    } ]
  }, {
    "tStartMs": 750166,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ jiù bù yòng zài fàng yán le ń\n所以我就不用再放盐了嗯"
    } ]
  }, {
    "tStartMs": 757266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯"
    } ]
  }, {
    "tStartMs": 758466,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "hǎo chī yǐ jīng shú le shú le\n好吃已经熟了熟了"
    } ]
  }, {
    "tStartMs": 763533,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "ń zhēn zhèng de má pó dòu fǔ lǐ miàn\n嗯真正的麻婆豆腐里面"
    } ]
  }, {
    "tStartMs": 766066,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "yīng gāi zài fàng yī xiē ń ròu xiàn ròu xiàn\n应该再放一些嗯肉馅肉馅"
    } ]
  }, {
    "tStartMs": 771133,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "dàn shì yīn wèi wǒ de ròu xiàn chī wán le méi yǒu le\n但是因为我的肉馅吃完了没有了"
    } ]
  }, {
    "tStartMs": 774666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ jiù méi yǒu fàng\n所以我就没有放"
    } ]
  }, {
    "tStartMs": 776366,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "hǎo kě yǐ le\n好可以了"
    } ]
  }, {
    "tStartMs": 778233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "wǒ men bǎ tā shèng chū lái\n我们把它盛出来"
    } ]
  }, {
    "tStartMs": 780500,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "shèng dào pán zi lǐ shèng\n盛到盘子里盛"
    } ]
  }, {
    "tStartMs": 784166,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "wa zhè ge guō zhēn de hěn zhòng\n哇这个锅真的很重"
    } ]
  }, {
    "tStartMs": 787533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "zěn me yàng\n怎么样"
    } ]
  }, {
    "tStartMs": 788433,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "zhè ge jiù shì wǒ jīn tiān zuò de má pó dòu fǔ\n这个就是我今天做的麻婆豆腐"
    } ]
  }, {
    "tStartMs": 792433,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "hā hā hā\n哈哈哈"
    } ]
  }, {
    "tStartMs": 794166,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "zuò hǎo le zuò hǎo le\n做好了做好了"
