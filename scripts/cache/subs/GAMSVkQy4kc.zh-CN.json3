  }, {
    "tStartMs": 802533,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "nà wǒ men zài chǎo dì èr dào cài zhī qián\n那我们在炒第二道菜之前"
    } ]
  }, {
    "tStartMs": 804666,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "yào xiān bǎ zhè ge guō\n要先把这个锅"
    } ]
  }, {
    "tStartMs": 806633,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "xǐ yī xià xǐ yī xià guō\n洗一下洗一下锅"
    } ]
  }, {
    "tStartMs": 813500,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "hǎo jiē xià lái hái shì chóng fù shàng yī dào cài de bù zhòu\n好接下来还是重复上一道菜的步骤"
    } ]
  }, {
    "tStartMs": 817233,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "è xiān dǎ kāi zhè ge chōu yóu yān jī\n呃先打开这个抽油烟机"
    } ]
  }, {
    "tStartMs": 820566,
    "dDurationMs": 1900,
    "segs": [ {
