    "segs": [ {
      "utf8": "hǎo bǎ suàn fàng jìn guō lǐ\n好把蒜放进锅里"
    } ]
  }, {
    "tStartMs": 842533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "zhēn de shì biān pāi biān zuò fàn\n真的是边拍边做饭"
    } ]
  }, {
    "tStartMs": 845500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "jiù hěn shǒu máng jiǎo luàn\n就很手忙脚乱"
    } ]
  }, {
    "tStartMs": 848433,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "ó hǎo de āi\n哦好的哎"
    } ]
  }, {
    "tStartMs": 849533,
    "dDurationMs": 1700,
    "segs": [ {
