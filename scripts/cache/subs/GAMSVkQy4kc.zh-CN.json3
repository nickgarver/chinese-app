  }, {
    "tStartMs": 797100,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "hǎo de jiē xià lái wǒ men zuò dì èr dào cài\n好的接下来我们做第二道菜"
    } ]
  }, {
    "tStartMs": 800666,
    "dDurationMs": 1634,
    "segs": [ {
