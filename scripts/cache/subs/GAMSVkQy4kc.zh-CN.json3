    } ]
  }, {
    "tStartMs": 884233,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "bǎ huǒ diào dà yī diǎn\n把火调大一点"
    } ]
  }, {
    "tStartMs": 888166,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "bǎ huǒ diào dà yī diǎn\n把火调大一点"
    } ]
  }, {
    "tStartMs": 892633,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "xiàn zài ne zhè ge ròu zhè ge ròu ne biàn sè le\n现在呢这个肉这个肉呢变色了"
    } ]
  }, {
    "tStartMs": 897366,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "biàn sè biàn sè le zhī hòu ne\n变色变色了之后呢"
    } ]
  }, {
    "tStartMs": 900033,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "wǒ men jiù kě yǐ wǎng lǐ miàn jiā yī xiē tiáo liào le\n我们就可以往里面加一些调料了"
    } ]
  }, {
    "tStartMs": 903766,
    "dDurationMs": 4334,
    "segs": [ {
      "utf8": "zhè ge shì lǎo chōu lǎo chōu lǎo chōu\n这个是老抽老抽老抽"
    } ]
  }, {
    "tStartMs": 908233,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "tā shì jiàng yóu de yī zhǒng\n它是酱油的一种"
    } ]
  }, {
    "tStartMs": 910066,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "wǒ men dào yì diǎn diǎn jìn qù yì diǎn diǎn\n我们倒一点点进去一点点"
    } ]
  }, {
    "tStartMs": 914033,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "nà wǒ men fàng lǎo chōu de mù dì ne\n那我们放老抽的目的呢"
    } ]
  }, {
    "tStartMs": 916533,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "jiù shì shàng sè shàng sè\n就是上色上色"
    } ]
  }, {
    "tStartMs": 919733,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "ràng zhè ge cài kàn qǐ lái yán sè gèng piào liàng\n让这个菜看起来颜色更漂亮"
    } ]
  }, {
    "tStartMs": 924933,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "jiē xià lái wǒ men bǎ zhè ge qīng jiāo qīng jiāo\n接下来我们把这个青椒青椒"
    } ]
  }, {
    "tStartMs": 929633,
    "dDurationMs": 5833,
    "segs": [ {
      "utf8": "zài dào jìn qù dào jìn qù chǎo jì xù chǎo\n再倒进去倒进去炒继续炒"
    } ]
  }, {
    "tStartMs": 936133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "xiàn zài wǒ yào fàng de shì zhè ge\n现在我要放的是这个"
    } ]
  }, {
    "tStartMs": 939333,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "zhè ge yě shì jiàng yóu de yī zhǒng\n这个也是酱油的一种"
    } ]
  }, {
    "tStartMs": 941300,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "jiào zuò shēng chōu shēng chōu\n叫做生抽生抽"
    } ]
  }, {
    "tStartMs": 944033,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "zhè ge ne jiù zhǔ yào shì wèi le è tiáo wèi tiáo wèi\n这个呢就主要是为了呃调味调味"
    } ]
  }, {
    "tStartMs": 949233,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "dào yì diǎn jiàng yóu dào\n倒一点酱油倒"
    } ]
  }, {
    "tStartMs": 954300,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "hǎo le\n好了"
    } ]
  }, {
    "tStartMs": 955966,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "nà wǒ gāng cái ne\n那我刚才呢"
    } ]
  }, {
    "tStartMs": 957266,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "fàng le liǎng zhǒng jiàng yóu\n放了两种酱油"
    } ]
  }, {
    "tStartMs": 959333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "zhè ge shì shēng chōu diào wèi\n这个是生抽调味"
    } ]
  }, {
    "tStartMs": 962433,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "zhè ge shì lǎo chōu shàng sè\n这个是老抽上色"
    } ]
  }, {
    "tStartMs": 965666,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "ó zhè jǐ gè cí nǐ men kě yǐ bǎ tā xué huì\n哦这几个词你们可以把它学会"
    } ]
  }, {
    "tStartMs": 971433,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "ér qiě zhè liǎng zhǒng jiàng yóu ne\n而且这两种酱油呢"
    } ]
  }, {
    "tStartMs": 973133,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "shì zhōng cān lǐ miàn chǎo cài zuì cháng yòng dào de\n是中餐里面炒菜最常用到的"
    } ]
  }, {
    "tStartMs": 977333,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "nà jiē xià lái wǒ hái huì fàng yī zhǒng tiáo liào\n那接下来我还会放一种调料"
    } ]
  }, {
    "tStartMs": 980733,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "jiù shì zhè ge\n就是这个"
    } ]
  }, {
    "tStartMs": 981633,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "zhè ge shì zī rán fěn zī rán fěn\n这个是孜然粉孜然粉"
    } ]
  }, {
    "tStartMs": 985833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "zhè ge nǐ men yīng gāi yě cháng yòng ba\n这个你们应该也常用吧"
    } ]
  }, {
    "tStartMs": 987766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "wǒ hěn xǐ huān chī zī rán de wèi dào\n我很喜欢吃孜然的味道"
    } ]
  }, {
    "tStartMs": 990633,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "suǒ yǐ jiē xià lái wǒ yào sā yì diǎn zī rán fěn\n所以接下来我要撒一点孜然粉"
    } ]
  }, {
    "tStartMs": 995133,
    "dDurationMs": 6667,
    "segs": [ {
      "utf8": "sā sā sā le yī xiē zī rán fěn\n撒撒撒了一些孜然粉"
    } ]
  }, {
    "tStartMs": 1002433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "hǎo de wǒ men chǎo hǎo le\n好的我们炒好了"
    } ]
  }, {
    "tStartMs": 1006100,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "hái shì bǎ tā shèng chū lái\n还是把它盛出来"
    } ]
  }, {
    "tStartMs": 1008300,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "shèng dào pán zi lǐ\n盛到盘子里"
    } ]
  }, {
    "tStartMs": 1011700,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "wǒ men ná yí gè pán zi\n我们拿一个盘子"
    } ]
  }, {
    "tStartMs": 1018966,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "shèng shèng dào pán pán zi lǐ\n盛盛到盘盘子里"
    } ]
  }, {
    "tStartMs": 1024666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa\n哇"
    } ]
  }, {
    "tStartMs": 1026566,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "wū hǎo xiāng a\n呜好香啊"
    } ]
  }, {
    "tStartMs": 1029333,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "lái gěi nǐ men kàn yī xià wǒ chǎo de liǎng gè cài wā sāi\n来给你们看一下我炒的两个菜哇塞"
    } ]
  }, {
    "tStartMs": 1034366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "gǎn jué hǎo lèi ya\n感觉好累呀"
    } ]
  }, {
    "tStartMs": 1036533,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "kàn zhè ge jiù shì qīng jiāo chǎo ròu\n看这个就是青椒炒肉"
    } ]
  }, {
    "tStartMs": 1040166,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "zhè ge jiù shì má pó dòu fǔ\n这个就是麻婆豆腐"
    } ]
  }, {
    "tStartMs": 1042933,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "yǐ jīng dōu zuò hǎo le hā hā hā\n已经都做好了哈哈哈"
    } ]
  }, {
    "tStartMs": 1046700,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "wǒ ná le yí gè wǎn\n我拿了一个碗"
    } ]
  }, {
    "tStartMs": 1048433,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "zhè ge shì wǎn\n这个是碗"
    } ]
  }, {
    "tStartMs": 1049566,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "zhè ge shì fàn sháo fàn sháo\n这个是饭勺饭勺"
    } ]
  }, {
    "tStartMs": 1052366,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "yòng lái chéng fàn de ń\n用来盛饭的嗯"
    } ]
  }, {
    "tStartMs": 1054100,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "gāng gāng wǒ men mèn de mǐ fàn yǐ jīng hǎo le\n刚刚我们焖的米饭已经好了"
    } ]
  }, {
    "tStartMs": 1057400,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "kàn zài zhè lǐ\n看在这里"
    } ]
  }, {
    "tStartMs": 1059366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa\n哇"
    } ]
  }, {
    "tStartMs": 1061033,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "wǒ men bǎ tā shèng shèng chū lái\n我们把它盛盛出来"
    } ]
  }, {
    "tStartMs": 1063666,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "chéng fàn chéng fàn chéng fàn\n盛饭盛饭盛饭"
    } ]
  }, {
    "tStartMs": 1070066,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "hǎo le ń\n好了嗯"
    } ]
  }, {
    "tStartMs": 1071433,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "nà wǒ xiàn zài yào kāi shǐ chī wǔ fàn le\n那我现在要开始吃午饭了"
    } ]
  }, {
    "tStartMs": 1074533,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "jīn tiān zhè qī jié mù jiù pāi dào zhè lǐ ba\n今天这期节目就拍到这里吧"
    } ]
  }, {
    "tStartMs": 1076633,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "huān yíng nǐ men dìng yuè wǒ de huì yuán pín dào\n欢迎你们订阅我的会员频道"
    } ]
  }, {
    "tStartMs": 1078533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "huì yǒu gèng duō jīng cǎi de nèi róng fēn xiǎng\n会有更多精彩的内容分享"
    } ]
  }, {
    "tStartMs": 1081033,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "nà rú guǒ nǐ xiǎng yào gèng duō de xué xí zī liào\n那如果你想要更多的学习资料"
    } ]
  }, {
    "tStartMs": 1084266,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "huò zhě gēn wǒ yī duì yī jìn xíng kǒu yǔ liàn xí\n或者跟我一对一进行口语练习"
    } ]
  }, {
    "tStartMs": 1087133,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "yě huān yíng nǐ men dìng yuè wǒ de Patreon\n也欢迎你们订阅我的Patreon"
    } ]
  }, {
    "tStartMs": 1089966,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "ń hǎo de\n嗯好的"
    } ]
  }, {
    "tStartMs": 1092166,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "nà wǒ men xià qī jié mù zài jiàn lóu bài bài\n那我们下期节目再见喽拜拜"
    } ]
  }, {
    "tStartMs": 1096033,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "wa zhēn de hǎo è hǎo è hǎo è\n哇真的好饿好饿好饿"
    } ]
  }, {
    "tStartMs": 1100466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯"
    } ]
  }, {
    "tStartMs": 1101866,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "zhè zhǒng chī fǎ yǒu yí gè chéng yǔ kě yǐ xíng róng\n这种吃法有一个成语可以形容"
    } ]
  }, {
    "tStartMs": 1104733,
    "dDurationMs": 5833,
    "segs": [ {
      "utf8": "jiào zuò láng tūn hǔ yàn láng tūn hǔ yàn hēng hēng\n叫做狼吞虎咽狼吞虎咽哼哼"
    } ]
  }, {
    "tStartMs": 1111233,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "jiù shì wǒ xiàn zài zhè yàng jiù shì láng tūn hǔ yàn\n就是我现在这样就是狼吞虎咽"
    } ]
  }, {
    "tStartMs": 1117333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯"
    } ]
  }, {
    "tStartMs": 1119666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "tài è le zhēn de tài è le\n太饿了真的太饿了"
    } ]
  } ]
}
