  }, {
    "tStartMs": 858366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa\n哇"
    } ]
  }, {
    "tStartMs": 859533,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "suàn de xiāng wèi zhēn de hǎo hǎo wén a\n蒜的香味真的好好闻啊"
    } ]
  }, {
    "tStartMs": 863733,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "hěn duō rén shì bù néng chī suàn de\n很多人是不能吃蒜的"
    } ]
  }, {
    "tStartMs": 865500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "nǐ men zhī dào ma ń\n你们知道吗嗯"
    } ]
  }, {
    "tStartMs": 869533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "bǎ zhè ge ròu fàng jìn guō lǐ\n把这个肉放进锅里"
    } ]
  }, {
    "tStartMs": 872100,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "kāi shǐ chǎo ròu\n开始炒肉"
    } ]
  }, {
    "tStartMs": 877333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "hā hā\n哈哈"
    } ]
  }, {
    "tStartMs": 879566,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "chǎo ròu\n炒肉"
    } ]
  }, {
    "tStartMs": 881466,
    "dDurationMs": 1600,
    "segs": [ {
