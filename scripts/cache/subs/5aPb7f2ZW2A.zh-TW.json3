{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "首爾房價，又爆掉了？！"
    } ]
  }, {
    "tStartMs": 1619,
    "dDurationMs": 1797,
    "segs": [ {
      "utf8": "韓國總統李在明上任後"
    } ]
  }, {
    "tStartMs": 3416,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "誓言要給民眾「付得起」的住宅"
    } ]
  }, {
    "tStartMs": 5521,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "祭出號稱「史上最嚴」的打房政策"
    } ]
  }, {
    "tStartMs": 7689,
    "dDurationMs": 2625,
    "segs": [ {
      "utf8": "新增超嚴格的稅制和限貸令"
    } ]
  }, {
    "tStartMs": 10314,
    "dDurationMs": 2295,
    "segs": [ {
      "utf8": "甚至還低價賣掉自己的房子"
    } ]
  }, {
    "tStartMs": 12609,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "結果，房價不但沒跌"
    } ]
  }, {
    "tStartMs": 14528,
    "dDurationMs": 1625,
    "segs": [ {
      "utf8": "反而還破紀錄狂飆"
    } ]
  }, {
    "tStartMs": 16153,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "在 2026 年第一季"
    } ]
  }, {
    "tStartMs": 17886,
    "dDurationMs": 1146,
    "segs": [ {
      "utf8": "首爾的房價所得比"
    } ]
  }, {
    "tStartMs": 19032,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "已經來到 10.49 倍"
    } ]
  }, {
    "tStartMs": 20595,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "代表一般家庭"
    } ]
  }, {
    "tStartMs": 21638,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "要不吃不喝超過 10 年"
    } ]
  }, {
    "tStartMs": 23346,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "才可能買得起房子"
    } ]
  }, {
    "tStartMs": 24723,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "面對這個狀況"
    } ]
  }, {
    "tStartMs": 26500,
    "dDurationMs": 1423,
    "segs": [ {
      "utf8": "執政黨議員提出的解方"
    } ]
  }, {
    "tStartMs": 27923,
    "dDurationMs": 2887,
    "segs": [ {
      "utf8": "竟然是「把廢棄公車改裝成宿舍」"
    } ]
  }, {
    "tStartMs": 30810,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "直接讓韓國年輕人集體氣瘋"
    } ]
  }, {
    "tStartMs": 33250,
    "dDurationMs": 1316,
    "segs": [ {
      "utf8": "今天我們就會來聊聊"
    } ]
  }, {
    "tStartMs": 34566,
    "dDurationMs": 2188,
    "segs": [ {
      "utf8": "現在首爾房價漲多兇？"
    } ]
  }, {
    "tStartMs": 36754,
    "dDurationMs": 3274,
    "segs": [ {
      "utf8": "李在明大力打房，又為何會越打越失控呢？"
    } ]
  }, {
    "tStartMs": 40028,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "不過在開始今天的討論之前"
    } ]
  }, {
    "tStartMs": 41361,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "先讓我們進一段工商服務時間！"
    } ]
  }, {
    "tStartMs": 88273,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "【首爾房價破紀錄飆漲！】"
    } ]
  }, {
    "tStartMs": 91043,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "hiho～大家好，我是志祺！"
    } ]
  }, {
    "tStartMs": 92505,
    "dDurationMs": 2774,
    "segs": [ {
      "utf8": "長年來，韓國都以「高房價」著稱"
    } ]
  }, {
    "tStartMs": 95279,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "很多年輕人不僅買不起房"
    } ]
  }, {
    "tStartMs": 97029,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "還只租得起環境糟糕的考試院雅房"
    } ]
  }, {
    "tStartMs": 99970,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "頂加、或「半地下室」"
    } ]
  }, {
    "tStartMs": 102200,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "而近年韓國房價更是一路狂飆"
    } ]
  }, {
    "tStartMs": 105119,
    "dDurationMs": 3085,
    "segs": [ {
      "utf8": "其中推升全國房價的主力，就是首爾"
    } ]
  }, {
    "tStartMs": 108204,
    "dDurationMs": 788,
    "segs": [ {
      "utf8": "截至 9 月初"
    } ]
  }, {
    "tStartMs": 108992,
    "dDurationMs": 2819,
    "segs": [ {
      "utf8": "首爾房價已經連續 86 週上漲"
    } ]
  }, {
    "tStartMs": 111811,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "漲幅更直接來到 16.9%"
    } ]
  }, {
    "tStartMs": 114605,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "就連公寓平均月租，也漲了 11.8%"
    } ]
  }, {
    "tStartMs": 118088,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "根據《德意志銀行》數據"
    } ]
  }, {
    "tStartMs": 119754,
    "dDurationMs": 1628,
    "segs": [ {
      "utf8": "現在首爾買房成本"
    } ]
  }, {
    "tStartMs": 121382,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "已經高居全球第三"
    } ]
  }, {
    "tStartMs": 123049,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "僅次於香港和蘇黎世"
    } ]
  }, {
    "tStartMs": 125093,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "那隨著房價越來越失控"
    } ]
  }, {
    "tStartMs": 126990,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "首爾的無殼蝸牛族"
    } ]
  }, {
    "tStartMs": 128657,
    "dDurationMs": 1545,
    "segs": [ {
      "utf8": "也過得越來越慘"
    } ]
  }, {
    "tStartMs": 130202,
    "dDurationMs": 2187,
    "segs": [ {
      "utf8": "因此這幾年，不只年輕人"
    } ]
  }, {
    "tStartMs": 132389,
    "dDurationMs": 1524,
    "segs": [ {
      "utf8": "就連很多 40 多歲"
    } ]
  }, {
    "tStartMs": 133913,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "擁有穩定收入的中年人"
    } ]
  }, {
    "tStartMs": 135539,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "也負擔不起獨居成本"
    } ]
  }, {
    "tStartMs": 137290,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "乾脆就住在爸媽家"
    } ]
  }, {
    "tStartMs": 138959,
    "dDurationMs": 2605,
    "segs": [ {
      "utf8": "也被網友戲稱為「袋鼠族」"
    } ]
  }, {
    "tStartMs": 141564,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "首爾研究院調查就顯示"
    } ]
  }, {
    "tStartMs": 143212,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "現在 40 歲左右的首爾人"
    } ]
  }, {
    "tStartMs": 145359,
    "dDurationMs": 1815,
    "segs": [ {
      "utf8": "每 5 個當中，就有 2 個"
    } ]
  }, {
    "tStartMs": 147174,
    "dDurationMs": 1394,
    "segs": [ {
      "utf8": "還跟爸媽一起住"
    } ]
  }, {
    "tStartMs": 148568,
    "dDurationMs": 1232,
    "segs": [ {
      "utf8": "那麼，首爾的房價"
    } ]
  }, {
    "tStartMs": 149800,
    "dDurationMs": 2357,
    "segs": [ {
      "utf8": "到底為什麼會一路狂飆呢？"
    } ]
  }, {
    "tStartMs": 152157,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "【韓國房市面臨「供應懸崖」？！】"
    } ]
  }, {
    "tStartMs": 154826,
    "dDurationMs": 2688,
    "segs": [ {
      "utf8": "最顯著的一個原因，是供不應求"
    } ]
  }, {
    "tStartMs": 157514,
    "dDurationMs": 1231,
    "segs": [ {
      "utf8": "韓國不動產院"
    } ]
  }, {
    "tStartMs": 158745,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "針對房市的供需狀況"
    } ]
  }, {
    "tStartMs": 161123,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "設計了一個"
    } ]
  }, {
    "tStartMs": 161957,
    "dDurationMs": 2126,
    "segs": [ {
      "utf8": "「公寓買賣供需指數」"
    } ]
  }, {
    "tStartMs": 164083,
    "dDurationMs": 2397,
    "segs": [ {
      "utf8": "簡單來說，這個指數只要超過 100"
    } ]
  }, {
    "tStartMs": 166480,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "就代表想買房的人"
    } ]
  }, {
    "tStartMs": 167982,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "比想賣房的人多"
    } ]
  }, {
    "tStartMs": 169650,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "低於 100 則相反"
    } ]
  }, {
    "tStartMs": 171297,
    "dDurationMs": 1397,
    "segs": [ {
      "utf8": "那在 2023 年初"
    } ]
  }, {
    "tStartMs": 172694,
    "dDurationMs": 2691,
    "segs": [ {
      "utf8": "首爾的指數還只有 66 左右"
    } ]
  }, {
    "tStartMs": 175385,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "但到了今年初"
    } ]
  }, {
    "tStartMs": 176551,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "就暴增到了 104"
    } ]
  }, {
    "tStartMs": 178303,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "想買房的人超越想賣的人"
    } ]
  }, {
    "tStartMs": 180597,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "那之所以會有這種狀況"
    } ]
  }, {
    "tStartMs": 182181,
    "dDurationMs": 2523,
    "segs": [ {
      "utf8": "可以先從「供給減少」説起"
    } ]
  }, {
    "tStartMs": 184704,
    "dDurationMs": 814,
    "segs": [ {
      "utf8": "報導指出"
    } ]
  }, {
    "tStartMs": 185518,
    "dDurationMs": 2772,
    "segs": [ {
      "utf8": "由於疫情、俄烏戰爭接連爆發"
    } ]
  }, {
    "tStartMs": 188290,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "造成全球通膨"
    } ]
  }, {
    "tStartMs": 189833,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "也使得近年鋼筋、水泥等等的"
    } ]
  }, {
    "tStartMs": 191940,
    "dDurationMs": 1269,
    "segs": [ {
      "utf8": "建材價格大漲"
    } ]
  }, {
    "tStartMs": 193209,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "加上韓國勞力工資也不斷提升"
    } ]
  }, {
    "tStartMs": 196088,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "導致「蓋房子」越來越貴"
    } ]
  }, {
    "tStartMs": 198173,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "根據官方數據"
    } ]
  }, {
    "tStartMs": 199090,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "韓國的「基礎建造成本」"
    } ]
  }, {
    "tStartMs": 200840,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "在 2022 到 2025 年間"
    } ]
  }, {
    "tStartMs": 203220,
    "dDurationMs": 1291,
    "segs": [ {
      "utf8": "上漲了 14%"
    } ]
  }, {
    "tStartMs": 204511,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "那也由於成本增加"
    } ]
  }, {
    "tStartMs": 205741,
    "dDurationMs": 2816,
    "segs": [ {
      "utf8": "加上前幾年韓國房市一度暴跌"
    } ]
  }, {
    "tStartMs": 208557,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "就讓銀行開始覺得"
    } ]
  }, {
    "tStartMs": 210037,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "這些建案可能賺不了錢"
    } ]
  }, {
    "tStartMs": 211414,
    "dDurationMs": 2355,
    "segs": [ {
      "utf8": "所以更不願意借錢給建商"
    } ]
  }, {
    "tStartMs": 213769,
    "dDurationMs": 1457,
    "segs": [ {
      "utf8": "但偏偏，韓國建商"
    } ]
  }, {
    "tStartMs": 215226,
    "dDurationMs": 2213,
    "segs": [ {
      "utf8": "又極度依賴銀行貸款"
    } ]
  }, {
    "tStartMs": 217439,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "根據韓國智庫 KDI"
    } ]
  }, {
    "tStartMs": 218898,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "韓國建商蓋房成本"
    } ]
  }, {
    "tStartMs": 220858,
    "dDurationMs": 1063,
    "segs": [ {
      "utf8": "有高達 97%"
    } ]
  }, {
    "tStartMs": 221921,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "都是跟銀行借來的"
    } ]
  }, {
    "tStartMs": 223757,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "在這種情況下"
    } ]
  }, {
    "tStartMs": 224674,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "韓國前幾年就出現了"
    } ]
  }, {
    "tStartMs": 226176,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "一波建商倒閉潮"
    } ]
  }, {
    "tStartMs": 227802,
    "dDurationMs": 2272,
    "segs": [ {
      "utf8": "新建房屋數量也跟著大減"
    } ]
  }, {
    "tStartMs": 230074,
    "dDurationMs": 2078,
    "segs": [ {
      "utf8": "韓國國土交通省就統計"
    } ]
  }, {
    "tStartMs": 232152,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "2022 到 2024 年"
    } ]
  }, {
    "tStartMs": 234488,
    "dDurationMs": 2675,
    "segs": [ {
      "utf8": "首爾住宅開工量跌了將近六成"
    } ]
  }, {
    "tStartMs": 237163,
    "dDurationMs": 1181,
    "segs": [ {
      "utf8": "使得這兩年"
    } ]
  }, {
    "tStartMs": 238344,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "新落成的首爾公寓數量"
    } ]
  }, {
    "tStartMs": 240222,
    "dDurationMs": 1105,
    "segs": [ {
      "utf8": "硬生生腰斬"
    } ]
  }, {
    "tStartMs": 241327,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "今年前七個月"
    } ]
  }, {
    "tStartMs": 242370,
    "dDurationMs": 1422,
    "segs": [ {
      "utf8": "就只有 1 萬 7 千多戶"
    } ]
  }, {
    "tStartMs": 243792,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "不到去年同期的一半"
    } ]
  }, {
    "tStartMs": 245515,
    "dDurationMs": 2046,
    "segs": [ {
      "utf8": "那不只是新屋數量減少"
    } ]
  }, {
    "tStartMs": 247561,
    "dDurationMs": 1729,
    "segs": [ {
      "utf8": "讓房市供給緊縮"
    } ]
  }, {
    "tStartMs": 249290,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "首爾人買房的需求量"
    } ]
  }, {
    "tStartMs": 250834,
    "dDurationMs": 1145,
    "segs": [ {
      "utf8": "也越來越大"
    } ]
  }, {
    "tStartMs": 251979,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "【老百姓恐慌買房！】"
    } ]
  }, {
    "tStartMs": 254961,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "由於城鄉差距嚴重"
    } ]
  }, {
    "tStartMs": 256651,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "韓國半數人口集中在大首爾地區"
    } ]
  }, {
    "tStartMs": 259320,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "所以首爾的買房需求一直很高"
    } ]
  }, {
    "tStartMs": 261781,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "空屋率更是只有 3.9%"
    } ]
  }, {
    "tStartMs": 264450,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "幾乎是台北的一半"
    } ]
  }, {
    "tStartMs": 266054,
    "dDurationMs": 1607,
    "segs": [ {
      "utf8": "而近幾年，這樣的需求"
    } ]
  }, {
    "tStartMs": 267661,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "又持續被推升"
    } ]
  }, {
    "tStartMs": 268994,
    "dDurationMs": 1856,
    "segs": [ {
      "utf8": "首先是 2022 年"
    } ]
  }, {
    "tStartMs": 270850,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "韓國爆發「全租房詐騙危機」"
    } ]
  }, {
    "tStartMs": 273477,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "這件事我們之前有談過"
    } ]
  }, {
    "tStartMs": 275062,
    "dDurationMs": 1146,
    "segs": [ {
      "utf8": "這邊就不細談"
    } ]
  }, {
    "tStartMs": 276208,
    "dDurationMs": 2106,
    "segs": [ {
      "utf8": "總之因為這波詐騙危機"
    } ]
  }, {
    "tStartMs": 278314,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "很多人寧可買房也不敢租房"
    } ]
  }, {
    "tStartMs": 280525,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "使得首爾的首購族"
    } ]
  }, {
    "tStartMs": 282255,
    "dDurationMs": 1689,
    "segs": [ {
      "utf8": "暴增了將近八成"
    } ]
  }, {
    "tStartMs": 283944,
    "dDurationMs": 2398,
    "segs": [ {
      "utf8": "後來，又因為新房子越蓋越少"
    } ]
  }, {
    "tStartMs": 286342,
    "dDurationMs": 1642,
    "segs": [ {
      "utf8": "「供給下降，價格就會上升」"
    } ]
  }, {
    "tStartMs": 287984,
    "dDurationMs": 1058,
    "segs": [ {
      "utf8": "的預期心理"
    } ]
  }, {
    "tStartMs": 289042,
    "dDurationMs": 1970,
    "segs": [ {
      "utf8": "讓很多本來還在觀望的人"
    } ]
  }, {
    "tStartMs": 291012,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "害怕「再不買就買不起」"
    } ]
  }, {
    "tStartMs": 292993,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "而紛紛跳進房市"
    } ]
  }, {
    "tStartMs": 294432,
    "dDurationMs": 1314,
    "segs": [ {
      "utf8": "除了恐慌買房"
    } ]
  }, {
    "tStartMs": 295746,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "還有一批人是因為"
    } ]
  }, {
    "tStartMs": 297079,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "突然暴富而買房"
    } ]
  }, {
    "tStartMs": 299082,
    "dDurationMs": 999,
    "segs": [ {
      "utf8": "《金融時報》指出"
    } ]
  }, {
    "tStartMs": 300081,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "這幾年受惠於 AI 熱潮"
    } ]
  }, {
    "tStartMs": 301440,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "三星電子跟 SK 海力士的"
    } ]
  }, {
    "tStartMs": 303522,
    "dDurationMs": 1731,
    "segs": [ {
      "utf8": "利潤破紀錄暴增"
    } ]
  }, {
    "tStartMs": 305253,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "而員工們也拿到了"
    } ]
  }, {
    "tStartMs": 306504,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "非常驚人的分紅"
    } ]
  }, {
    "tStartMs": 308151,
    "dDurationMs": 1815,
    "segs": [ {
      "utf8": "例如 SK 海力士今年 2 月"
    } ]
  }, {
    "tStartMs": 309966,
    "dDurationMs": 1063,
    "segs": [ {
      "utf8": "就發出了相當於"
    } ]
  }, {
    "tStartMs": 311029,
    "dDurationMs": 1731,
    "segs": [ {
      "utf8": "30 個月的年終獎金"
    } ]
  }, {
    "tStartMs": 312760,
    "dDurationMs": 1665,
    "segs": [ {
      "utf8": "導致首爾的科技人才們"
    } ]
  }, {
    "tStartMs": 314425,
    "dDurationMs": 1378,
    "segs": [ {
      "utf8": "大量湧入房市"
    } ]
  }, {
    "tStartMs": 315803,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "半導體公司周遭的房價"
    } ]
  }, {
    "tStartMs": 317763,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "漲幅更是達到首爾平均的 4 倍"
    } ]
  }, {
    "tStartMs": 320724,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "甚至催生了一個新名詞"
    } ]
  }, {
    "tStartMs": 322517,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "叫做「接駁車生活圈」"
    } ]
  }, {
    "tStartMs": 324393,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "那為了抑制供需失衡"
    } ]
  }, {
    "tStartMs": 326334,
    "dDurationMs": 1562,
    "segs": [ {
      "utf8": "造成的房價飆漲"
    } ]
  }, {
    "tStartMs": 327896,
    "dDurationMs": 1628,
    "segs": [ {
      "utf8": "李在明去年上任後"
    } ]
  }, {
    "tStartMs": 329524,
    "dDurationMs": 2687,
    "segs": [ {
      "utf8": "也試圖兌現選前的「打房」承諾"
    } ]
  }, {
    "tStartMs": 332211,
    "dDurationMs": 855,
    "segs": [ {
      "utf8": "祭出了號稱"
    } ]
  }, {
    "tStartMs": 333066,
    "dDurationMs": 1524,
    "segs": [ {
      "utf8": "「史上最嚴」的打房行動"
    } ]
  }, {
    "tStartMs": 334590,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "沒想到房價反倒漲更兇"
    } ]
  }, {
    "tStartMs": 337611,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "【李在明越打房越失控！】"
    } ]
  }, {
    "tStartMs": 340532,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "去年6月，韓國政府公布了"
    } ]
  }, {
    "tStartMs": 342616,
    "dDurationMs": 1856,
    "segs": [ {
      "utf8": "一連串房貸管制政策"
    } ]
  }, {
    "tStartMs": 344472,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "尤其又以對多屋族的管制，最為嚴格"
    } ]
  }, {
    "tStartMs": 347871,
    "dDurationMs": 771,
    "segs": [ {
      "utf8": "根據新規定"
    } ]
  }, {
    "tStartMs": 348642,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "名下有超過 2 房的人"
    } ]
  }, {
    "tStartMs": 349935,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "貸款成數直接歸零"
    } ]
  }, {
    "tStartMs": 352312,
    "dDurationMs": 874,
    "segs": [ {
      "utf8": "如果想再買房"
    } ]
  }, {
    "tStartMs": 353186,
    "dDurationMs": 1898,
    "segs": [ {
      "utf8": "只能拿全額出來買"
    } ]
  }, {
    "tStartMs": 355084,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "除了不能申請房貸"
    } ]
  }, {
    "tStartMs": 356628,
    "dDurationMs": 1314,
    "segs": [ {
      "utf8": "從今年 5 月開始"
    } ]
  }, {
    "tStartMs": 357942,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "多屋族只要出售房屋"
    } ]
  }, {
    "tStartMs": 360047,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "還會被課徵最高 82.5% 的稅金"
    } ]
  }, {
    "tStartMs": 363592,
    "dDurationMs": 1542,
    "segs": [ {
      "utf8": "那政府原本的算盤是"
    } ]
  }, {
    "tStartMs": 365134,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "只要讓多屋族"
    } ]
  }, {
    "tStartMs": 366363,
    "dDurationMs": 1586,
    "segs": [ {
      "utf8": "「難以買房、賣房」"
    } ]
  }, {
    "tStartMs": 367949,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "就可以完全封鎖他們的炒房空間"
    } ]
  }, {
    "tStartMs": 370117,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "也能降低買房意願"
    } ]
  }, {
    "tStartMs": 371828,
    "dDurationMs": 1231,
    "segs": [ {
      "utf8": "讓房價降下來"
    } ]
  }, {
    "tStartMs": 373059,
    "dDurationMs": 998,
    "segs": [ {
      "utf8": "沒想到這項政策"
    } ]
  }, {
    "tStartMs": 374057,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "在今年初預告之後"
    } ]
  }, {
    "tStartMs": 375790,
    "dDurationMs": 1313,
    "segs": [ {
      "utf8": "卻起到了反效果"
    } ]
  }, {
    "tStartMs": 377103,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "《韓國經濟》解釋"
    } ]
  }, {
    "tStartMs": 378332,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "既然當多屋族那麼多限制"
    } ]
  }, {
    "tStartMs": 380293,
    "dDurationMs": 1188,
    "segs": [ {
      "utf8": "很多人乾脆不當了"
    } ]
  }, {
    "tStartMs": 381481,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "把手上幾棟位於"
    } ]
  }, {
    "tStartMs": 382565,
    "dDurationMs": 1419,
    "segs": [ {
      "utf8": "「邊緣地帶」的房子"
    } ]
  }, {
    "tStartMs": 383984,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "在 5 月之前全賣掉"
    } ]
  }, {
    "tStartMs": 385652,
    "dDurationMs": 1146,
    "segs": [ {
      "utf8": "然後把賣房賺的錢"
    } ]
  }, {
    "tStartMs": 386798,
    "dDurationMs": 2273,
    "segs": [ {
      "utf8": "all in 一棟首爾蛋黃區"
    } ]
  }, {
    "tStartMs": 389071,
    "dDurationMs": 896,
    "segs": [ {
      "utf8": "「穩賺」的房產"
    } ]
  }, {
    "tStartMs": 389967,
    "dDurationMs": 2106,
    "segs": [ {
      "utf8": "這種操作，也被韓國房市圈"
    } ]
  }, {
    "tStartMs": 392073,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "稱為「聰明的一套房」"
    } ]
  }, {
    "tStartMs": 394241,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "這使得首爾房屋需求"
    } ]
  }, {
    "tStartMs": 395784,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "在短時間內又提升了一波"
    } ]
  }, {
    "tStartMs": 397703,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "剛剛說到，首爾公寓"
    } ]
  }, {
    "tStartMs": 399204,
    "dDurationMs": 1356,
    "segs": [ {
      "utf8": "買賣供需指數"
    } ]
  }, {
    "tStartMs": 400560,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "在今年初就來到 104"
    } ]
  }, {
    "tStartMs": 402541,
    "dDurationMs": 2478,
    "segs": [ {
      "utf8": "結果八月更提高到 113"
    } ]
  }, {
    "tStartMs": 405019,
    "dDurationMs": 2004,
    "segs": [ {
      "utf8": "顯示房市供需進一步失衡"
    } ]
  }, {
    "tStartMs": 407023,
    "dDurationMs": 1021,
    "segs": [ {
      "utf8": "那想當然耳"
    } ]
  }, {
    "tStartMs": 408044,
    "dDurationMs": 2356,
    "segs": [ {
      "utf8": "房價也就被炒得更高了"
    } ]
  }, {
    "tStartMs": 410400,
    "dDurationMs": 1065,
    "segs": [ {
      "utf8": "《朝鮮日報》還指出"
    } ]
  }, {
    "tStartMs": 411465,
    "dDurationMs": 895,
    "segs": [ {
      "utf8": "這種供需失衡"
    } ]
  }, {
    "tStartMs": 412360,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "可能不只是短期亂象"
    } ]
  }, {
    "tStartMs": 414174,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "因為，目前上路的政策中"
    } ]
  }, {
    "tStartMs": 416343,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "並沒有增加房屋的持有成本"
    } ]
  }, {
    "tStartMs": 418720,
    "dDurationMs": 2689,
    "segs": [ {
      "utf8": "就可能會讓剩下的多屋族"
    } ]
  }, {
    "tStartMs": 421409,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "為了規避重稅，而選擇囤房不賣"
    } ]
  }, {
    "tStartMs": 423828,
    "dDurationMs": 2543,
    "segs": [ {
      "utf8": "漢城大學教授權大重也補充"
    } ]
  }, {
    "tStartMs": 426371,
    "dDurationMs": 2189,
    "segs": [ {
      "utf8": "由於長年來，歷屆政府"
    } ]
  }, {
    "tStartMs": 428560,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "幾乎都沒有成功打到房"
    } ]
  }, {
    "tStartMs": 430062,
    "dDurationMs": 1272,
    "segs": [ {
      "utf8": "所以市場信心很高"
    } ]
  }, {
    "tStartMs": 431334,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "即便賣房成本增加"
    } ]
  }, {
    "tStartMs": 433085,
    "dDurationMs": 1354,
    "segs": [ {
      "utf8": "許多人還是認為房子"
    } ]
  }, {
    "tStartMs": 434439,
    "dDurationMs": 919,
    "segs": [ {
      "utf8": "「囤著繼續漲」"
    } ]
  }, {
    "tStartMs": 435358,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "是更划算的選擇"
    } ]
  }, {
    "tStartMs": 436818,
    "dDurationMs": 1646,
    "segs": [ {
      "utf8": "因此就算拉長來看"
    } ]
  }, {
    "tStartMs": 438464,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "房價還是很難因為"
    } ]
  }, {
    "tStartMs": 440340,
    "dDurationMs": 1524,
    "segs": [ {
      "utf8": "這波政策而下跌"
    } ]
  }, {
    "tStartMs": 441864,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "而李在明這波政策"
    } ]
  }, {
    "tStartMs": 443304,
    "dDurationMs": 2395,
    "segs": [ {
      "utf8": "不僅被質疑「越打越漲」"
    } ]
  }, {
    "tStartMs": 445699,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "還被批評是濫傷無辜"
    } ]
  }, {
    "tStartMs": 448161,
    "dDurationMs": 2796,
    "segs": [ {
      "utf8": "【首購族躺著也中槍！】"
    } ]
  }, {
    "tStartMs": 450957,
    "dDurationMs": 1165,
    "segs": [ {
      "utf8": "因為，這波打房措施"
    } ]
  }, {
    "tStartMs": 452122,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "不只管制多屋族"
    } ]
  }, {
    "tStartMs": 453456,
    "dDurationMs": 1354,
    "segs": [ {
      "utf8": "更不分族群的"
    } ]
  }, {
    "tStartMs": 454810,
    "dDurationMs": 1898,
    "segs": [ {
      "utf8": "推出超嚴格的限貸令"
    } ]
  }, {
    "tStartMs": 456708,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "就連首購族的貸款成數"
    } ]
  }, {
    "tStartMs": 458586,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "也從最高八成降至七成"
    } ]
  }, {
    "tStartMs": 460733,
    "dDurationMs": 1771,
    "segs": [ {
      "utf8": "代表他們如果想要買房"
    } ]
  }, {
    "tStartMs": 462504,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "就得多準備一成頭期款"
    } ]
  }, {
    "tStartMs": 464152,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "那對韓國政府而言"
    } ]
  }, {
    "tStartMs": 465675,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "這樣全方面的限制"
    } ]
  }, {
    "tStartMs": 467238,
    "dDurationMs": 2647,
    "segs": [ {
      "utf8": "就是希望能全面降低買房需求"
    } ]
  }, {
    "tStartMs": 469885,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "進而替房市降溫"
    } ]
  }, {
    "tStartMs": 471679,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "不過，這個如意算盤"
    } ]
  }, {
    "tStartMs": 473283,
    "dDurationMs": 1482,
    "segs": [ {
      "utf8": "顯然沒有成真"
    } ]
  }, {
    "tStartMs": 474765,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "韓國法院的統計顯示"
    } ]
  }, {
    "tStartMs": 476223,
    "dDurationMs": 704,
    "segs": [ {
      "utf8": "去年 6 月"
    } ]
  }, {
    "tStartMs": 476927,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "也就是限貸令實施前"
    } ]
  }, {
    "tStartMs": 478685,
    "dDurationMs": 2912,
    "segs": [ {
      "utf8": "首爾總共有 7192 人"
    } ]
  }, {
    "tStartMs": 481597,
    "dDurationMs": 1257,
    "segs": [ {
      "utf8": "成為首購族"
    } ]
  }, {
    "tStartMs": 482854,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "而今年 6 月"
    } ]
  }, {
    "tStartMs": 483687,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "這個數字還小幅上升到 7210 人"
    } ]
  }, {
    "tStartMs": 487149,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "《首爾經濟日報》認為"
    } ]
  }, {
    "tStartMs": 488526,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "限貸令之所以"
    } ]
  }, {
    "tStartMs": 489694,
    "dDurationMs": 2313,
    "segs": [ {
      "utf8": "沒能抑制首購族的需求"
    } ]
  }, {
    "tStartMs": 492007,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "是因為打房行動"
    } ]
  }, {
    "tStartMs": 493425,
    "dDurationMs": 1103,
    "segs": [ {
      "utf8": "讓部分民眾預期"
    } ]
  }, {
    "tStartMs": 494528,
    "dDurationMs": 1525,
    "segs": [ {
      "utf8": "「現在貸款已經這麼難"
    } ]
  }, {
    "tStartMs": 496053,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "未來只會更難，應該趕快買」"
    } ]
  }, {
    "tStartMs": 499075,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "因為這種心理而進場的人數"
    } ]
  }, {
    "tStartMs": 500868,
    "dDurationMs": 2314,
    "segs": [ {
      "utf8": "剛好與因為購買力下降"
    } ]
  }, {
    "tStartMs": 503182,
    "dDurationMs": 1086,
    "segs": [ {
      "utf8": "而退場的人抵銷"
    } ]
  }, {
    "tStartMs": 504268,
    "dDurationMs": 1689,
    "segs": [ {
      "utf8": "結果就是房價沒跌"
    } ]
  }, {
    "tStartMs": 505957,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "而真的要自住"
    } ]
  }, {
    "tStartMs": 507186,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "需要靠貸款買房的小資族"
    } ]
  }, {
    "tStartMs": 508979,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "負擔變得更重"
    } ]
  }, {
    "tStartMs": 510479,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "明知大學名譽教授"
    } ]
  }, {
    "tStartMs": 511939,
    "dDurationMs": 1315,
    "segs": [ {
      "utf8": "曹東根就批評"
    } ]
  }, {
    "tStartMs": 513254,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "這種不分族群、無差別的管制"
    } ]
  }, {
    "tStartMs": 515340,
    "dDurationMs": 1105,
    "segs": [ {
      "utf8": "到頭來只製造了"
    } ]
  }, {
    "tStartMs": 516445,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "更多無辜受害者"
    } ]
  }, {
    "tStartMs": 517884,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "那一系列的政策失敗"
    } ]
  }, {
    "tStartMs": 519344,
    "dDurationMs": 1854,
    "segs": [ {
      "utf8": "本就讓民怨四起了"
    } ]
  }, {
    "tStartMs": 521198,
    "dDurationMs": 2064,
    "segs": [ {
      "utf8": "沒想到執政黨後續的做法"
    } ]
  }, {
    "tStartMs": 523262,
    "dDurationMs": 2587,
    "segs": [ {
      "utf8": "更是直接引爆年輕人的怒火"
    } ]
  }, {
    "tStartMs": 525849,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "【韓國補救措施被罵爆！】"
    } ]
  }, {
    "tStartMs": 529031,
    "dDurationMs": 2008,
    "segs": [ {
      "utf8": "執政黨議員黃熙在 8 月提出"
    } ]
  }, {
    "tStartMs": 531039,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "要把城市內即將廢棄的公⾞"
    } ]
  }, {
    "tStartMs": 533479,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "改裝成青年住宅"
    } ]
  }, {
    "tStartMs": 535023,
    "dDurationMs": 1331,
    "segs": [ {
      "utf8": "他說這項政策"
    } ]
  }, {
    "tStartMs": 536354,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "是參考荷蘭的船屋計劃"
    } ]
  }, {
    "tStartMs": 538275,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "希望透過低成本的空間再利⽤"
    } ]
  }, {
    "tStartMs": 540444,
    "dDurationMs": 1625,
    "segs": [ {
      "utf8": "緩解高房價問題"
    } ]
  }, {
    "tStartMs": 542069,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "但這個提案一出來"
    } ]
  }, {
    "tStartMs": 543550,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "不只在野黨批評是"
    } ]
  }, {
    "tStartMs": 544966,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "「把青年當難民」"
    } ]
  }, {
    "tStartMs": 546614,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "社群上也罵聲一片"
    } ]
  }, {
    "tStartMs": 548283,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "出現大量的 AI 諷刺影片"
    } ]
  }, {
    "tStartMs": 550117,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "甚至還有惡搞貼文"
    } ]
  }, {
    "tStartMs": 551327,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "把首爾頂級豪宅"
    } ]
  }, {
    "tStartMs": 553286,
    "dDurationMs": 1315,
    "segs": [ {
      "utf8": "「漢南 The Hill」"
    } ]
  }, {
    "tStartMs": 554601,
    "dDurationMs": 1855,
    "segs": [ {
      "utf8": "改成「漢南 The Wheel」"
    } ]
  }, {
    "tStartMs": 556456,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "這波反彈聲浪大到"
    } ]
  }, {
    "tStartMs": 558206,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "連李在明都出面切割"
    } ]
  }, {
    "tStartMs": 560376,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "不過他自己提出的補救措施"
    } ]
  }, {
    "tStartMs": 562043,
    "dDurationMs": 1586,
    "segs": [ {
      "utf8": "同樣也被罵到臭頭"
    } ]
  }, {
    "tStartMs": 563629,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "他在 8 月提案"
    } ]
  }, {
    "tStartMs": 564755,
    "dDurationMs": 1249,
    "segs": [ {
      "utf8": "針對名下有一房"
    } ]
  }, {
    "tStartMs": 566004,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "但沒住在裡面的人"
    } ]
  }, {
    "tStartMs": 567381,
    "dDurationMs": 1991,
    "segs": [ {
      "utf8": "不動產稅免稅額"
    } ]
  }, {
    "tStartMs": 569372,
    "dDurationMs": 2346,
    "segs": [ {
      "utf8": "要從 12 億降到 9 億韓元"
    } ]
  }, {
    "tStartMs": 571718,
    "dDurationMs": 1188,
    "segs": [ {
      "utf8": "希望藉此鼓勵自住"
    } ]
  }, {
    "tStartMs": 572906,
    "dDurationMs": 2564,
    "segs": [ {
      "utf8": "同時矯正「聰明的一套房」亂象"
    } ]
  }, {
    "tStartMs": 575470,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "結果這個提案"
    } ]
  }, {
    "tStartMs": 576347,
    "dDurationMs": 1898,
    "segs": [ {
      "utf8": "也被質疑「殃及無辜」"
    } ]
  }, {
    "tStartMs": 578245,
    "dDurationMs": 1312,
    "segs": [ {
      "utf8": "因為這樣的一房族之中"
    } ]
  }, {
    "tStartMs": 579557,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "有很多人是因為"
    } ]
  }, {
    "tStartMs": 580684,
    "dDurationMs": 2606,
    "segs": [ {
      "utf8": "在其他縣市工作、求學"
    } ]
  }, {
    "tStartMs": 583290,
    "dDurationMs": 1605,
    "segs": [ {
      "utf8": "才把名下房子出租"
    } ]
  }, {
    "tStartMs": 584895,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "自己另外租屋住"
    } ]
  }, {
    "tStartMs": 586479,
    "dDurationMs": 1336,
    "segs": [ {
      "utf8": "而不是在炒房"
    } ]
  }, {
    "tStartMs": 587815,
    "dDurationMs": 1542,
    "segs": [ {
      "utf8": "雖然這個改革方案"
    } ]
  }, {
    "tStartMs": 589357,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "已經在激烈的反彈聲浪下撤回"
    } ]
  }, {
    "tStartMs": 591837,
    "dDurationMs": 2817,
    "segs": [ {
      "utf8": "但接連的爭議、高居不下的房價"
    } ]
  }, {
    "tStartMs": 594654,
    "dDurationMs": 2146,
    "segs": [ {
      "utf8": "已經讓李在明的聲望暴跌"
    } ]
  }, {
    "tStartMs": 596800,
    "dDurationMs": 2649,
    "segs": [ {
      "utf8": "根據蓋洛普韓國九月的民調"
    } ]
  }, {
    "tStartMs": 599449,
    "dDurationMs": 2148,
    "segs": [ {
      "utf8": "李在明的支持率已經跌破四成"
    } ]
  }, {
    "tStartMs": 601597,
    "dDurationMs": 1625,
    "segs": [ {
      "utf8": "創下就任以來的新低"
    } ]
  }, {
    "tStartMs": 603222,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "政治學者「申律」也分析"
    } ]
  }, {
    "tStartMs": 605057,
    "dDurationMs": 898,
    "segs": [ {
      "utf8": "李在明支持度"
    } ]
  }, {
    "tStartMs": 605955,
    "dDurationMs": 2397,
    "segs": [ {
      "utf8": "下滑的最大原因，就是房價"
    } ]
  }, {
    "tStartMs": 608352,
    "dDurationMs": 1272,
    "segs": [ {
      "utf8": "那雖然民調重挫"
    } ]
  }, {
    "tStartMs": 609624,
    "dDurationMs": 1815,
    "segs": [ {
      "utf8": "但李在明政府的打房措施"
    } ]
  }, {
    "tStartMs": 611439,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "還在繼續"
    } ]
  }, {
    "tStartMs": 612273,
    "dDurationMs": 2926,
    "segs": [ {
      "utf8": "【其他打房措施，會有用嗎？】"
    } ]
  }, {
    "tStartMs": 615199,
    "dDurationMs": 1826,
    "segs": [ {
      "utf8": "其實除了壓抑需求"
    } ]
  }, {
    "tStartMs": 617025,
    "dDurationMs": 1542,
    "segs": [ {
      "utf8": "韓國政府也有嘗試往"
    } ]
  }, {
    "tStartMs": 618567,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "「分散需求」的方向努力"
    } ]
  }, {
    "tStartMs": 620487,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "包括推動公共機構搬遷"
    } ]
  }, {
    "tStartMs": 622634,
    "dDurationMs": 2106,
    "segs": [ {
      "utf8": "預計要把大約 350 個機構"
    } ]
  }, {
    "tStartMs": 624740,
    "dDurationMs": 2897,
    "segs": [ {
      "utf8": "分散搬到首爾以外的縣市"
    } ]
  }, {
    "tStartMs": 627637,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "而這樣的政策"
    } ]
  }, {
    "tStartMs": 628513,
    "dDurationMs": 1758,
    "segs": [ {
      "utf8": "也獲得了部分學者的認同"
    } ]
  }, {
    "tStartMs": 630271,
    "dDurationMs": 2475,
    "segs": [ {
      "utf8": "都市規劃學者馬康來就主張"
    } ]
  }, {
    "tStartMs": 632746,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "高房價的根源"
    } ]
  }, {
    "tStartMs": 633705,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "是需求全部集中在首爾"
    } ]
  }, {
    "tStartMs": 635705,
    "dDurationMs": 1232,
    "segs": [ {
      "utf8": "政府應該要想辦法"
    } ]
  }, {
    "tStartMs": 636937,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "降低城鄉差距"
    } ]
  }, {
    "tStartMs": 638355,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "避免讓人口跟高薪工作"
    } ]
  }, {
    "tStartMs": 640316,
    "dDurationMs": 1542,
    "segs": [ {
      "utf8": "都繼續集中在首都圈"
    } ]
  }, {
    "tStartMs": 641858,
    "dDurationMs": 2064,
    "segs": [ {
      "utf8": "不過，韓國產業研究院認為"
    } ]
  }, {
    "tStartMs": 643922,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "光是這樣做恐怕不夠"
    } ]
  }, {
    "tStartMs": 645882,
    "dDurationMs": 1542,
    "segs": [ {
      "utf8": "因為，早在 2010 年代"
    } ]
  }, {
    "tStartMs": 647424,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "韓國政府就搬過一輪公共機構"
    } ]
  }, {
    "tStartMs": 650303,
    "dDurationMs": 2126,
    "segs": [ {
      "utf8": "但首爾房價依然高漲"
    } ]
  }, {
    "tStartMs": 652429,
    "dDurationMs": 1104,
    "segs": [ {
      "utf8": "主因是，如果沒有"
    } ]
  }, {
    "tStartMs": 653533,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "同步創造民間工作機會"
    } ]
  }, {
    "tStartMs": 655432,
    "dDurationMs": 1624,
    "segs": [ {
      "utf8": "就算一些公務員搬了家"
    } ]
  }, {
    "tStartMs": 657056,
    "dDurationMs": 1158,
    "segs": [ {
      "utf8": "年輕人還是會繼續"
    } ]
  }, {
    "tStartMs": 658214,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "湧入首爾找工作"
    } ]
  }, {
    "tStartMs": 659654,
    "dDurationMs": 1044,
    "segs": [ {
      "utf8": "因此他們認為"
    } ]
  }, {
    "tStartMs": 660698,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "政府也應該要透過"
    } ]
  }, {
    "tStartMs": 662114,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "鼓勵性的政策"
    } ]
  }, {
    "tStartMs": 663156,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "讓更多企業總部、或研發中心"
    } ]
  }, {
    "tStartMs": 665219,
    "dDurationMs": 1689,
    "segs": [ {
      "utf8": "有搬離首爾的誘因"
    } ]
  }, {
    "tStartMs": 666908,
    "dDurationMs": 2254,
    "segs": [ {
      "utf8": "那除了公共機構搬遷"
    } ]
  }, {
    "tStartMs": 669162,
    "dDurationMs": 1522,
    "segs": [ {
      "utf8": "韓國政府也有規劃"
    } ]
  }, {
    "tStartMs": 670684,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "在 2030 年之前"
    } ]
  }, {
    "tStartMs": 671893,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "在首爾都會區興建"
    } ]
  }, {
    "tStartMs": 673623,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "158 萬戶住宅"
    } ]
  }, {
    "tStartMs": 675853,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "增加首爾的住房供給"
    } ]
  }, {
    "tStartMs": 677626,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "漢陽大學教授崔元哲認為"
    } ]
  }, {
    "tStartMs": 679586,
    "dDurationMs": 2064,
    "segs": [ {
      "utf8": "增加住房供給雖然是個好方法"
    } ]
  }, {
    "tStartMs": 681650,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "但「房價只漲不跌、"
    } ]
  }, {
    "tStartMs": 683110,
    "dDurationMs": 1478,
    "segs": [ {
      "utf8": "越打越漲」的預期心理"
    } ]
  }, {
    "tStartMs": 684588,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "才是造成高房價的根源"
    } ]
  }, {
    "tStartMs": 686488,
    "dDurationMs": 1603,
    "segs": [ {
      "utf8": "所以如果只是宣布開工"
    } ]
  }, {
    "tStartMs": 688091,
    "dDurationMs": 1894,
    "segs": [ {
      "utf8": "民眾不會有感、無法動搖"
    } ]
  }, {
    "tStartMs": 689985,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "市場對房價的信心"
    } ]
  }, {
    "tStartMs": 692054,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "因此，政府應該要盡可能縮短"
    } ]
  }, {
    "tStartMs": 694159,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "「開工到入住」的時間"
    } ]
  }, {
    "tStartMs": 696328,
    "dDurationMs": 1354,
    "segs": [ {
      "utf8": "同時，增加的住宅"
    } ]
  }, {
    "tStartMs": 697682,
    "dDurationMs": 2608,
    "segs": [ {
      "utf8": "也要是社會住宅、青年住宅"
    } ]
  }, {
    "tStartMs": 700290,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "這種民眾真的能負擔的房子"
    } ]
  }, {
    "tStartMs": 702500,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "會比較有可能"
    } ]
  }, {
    "tStartMs": 703480,
    "dDurationMs": 3357,
    "segs": [ {
      "utf8": "真正緩解「只漲不跌」的預期心理"
    } ]
  }, {
    "tStartMs": 706837,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "【我們的觀點】"
    } ]
  }, {
    "tStartMs": 709820,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "其實，我們負責寫這集腳本的企劃說"
    } ]
  }, {
    "tStartMs": 711822,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "他對房地產沒太多研究"
    } ]
  }, {
    "tStartMs": 713530,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "因為台灣的房價也是相當高"
    } ]
  }, {
    "tStartMs": 715177,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "高到他覺得自己這輩子"
    } ]
  }, {
    "tStartMs": 716344,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "大概不可能買房"
    } ]
  }, {
    "tStartMs": 718596,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "那既然買不起"
    } ]
  }, {
    "tStartMs": 719388,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "好像也就沒有必要"
    } ]
  }, {
    "tStartMs": 720681,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "搞懂房市怎麼運作"
    } ]
  }, {
    "tStartMs": 722328,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "也因為這樣"
    } ]
  }, {
    "tStartMs": 723203,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "他對於首爾袋鼠族、租屋族"
    } ]
  }, {
    "tStartMs": 725624,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "也蠻有共感的"
    } ]
  }, {
    "tStartMs": 727063,
    "dDurationMs": 1457,
    "segs": [ {
      "utf8": "那我們覺得比較不同的是"
    } ]
  }, {
    "tStartMs": 728520,
    "dDurationMs": 1044,
    "segs": [ {
      "utf8": "李在明從一開始"
    } ]
  }, {
    "tStartMs": 729564,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "就是打著要"
    } ]
  }, {
    "tStartMs": 730605,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "「對付高房價」的口號上台的"
    } ]
  }, {
    "tStartMs": 732712,
    "dDurationMs": 897,
    "segs": [ {
      "utf8": "而他上任以後"
    } ]
  }, {
    "tStartMs": 733609,
    "dDurationMs": 2022,
    "segs": [ {
      "utf8": "也真的是六親不認的在打房"
    } ]
  }, {
    "tStartMs": 735631,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "各種限貸令、交易稅"
    } ]
  }, {
    "tStartMs": 737279,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "一個接一個出來"
    } ]
  }, {
    "tStartMs": 738280,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "結果，首爾的房價不但沒跌"
    } ]
  }, {
    "tStartMs": 740343,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "反而還漲得更兇"
    } ]
  }, {
    "tStartMs": 741761,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "就讓我們覺得有點絕望"
    } ]
  }, {
    "tStartMs": 743523,
    "dDurationMs": 1491,
    "segs": [ {
      "utf8": "好像要降低房價"
    } ]
  }, {
    "tStartMs": 745014,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "幾乎是一個不可能的任務"
    } ]
  }, {
    "tStartMs": 747121,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "那雖然韓國的房市狀況"
    } ]
  }, {
    "tStartMs": 748474,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "跟台灣不能完全對比"
    } ]
  }, {
    "tStartMs": 750394,
    "dDurationMs": 1812,
    "segs": [ {
      "utf8": "但我們覺得有一點很像"
    } ]
  }, {
    "tStartMs": 752206,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "就是對房市的信心超強"
    } ]
  }, {
    "tStartMs": 754667,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "然後變成一個惡性循環"
    } ]
  }, {
    "tStartMs": 756252,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "信心越強、房價越高"
    } ]
  }, {
    "tStartMs": 758338,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "房價越高、信心越強"
    } ]
  }, {
    "tStartMs": 760108,
    "dDurationMs": 814,
    "segs": [ {
      "utf8": "所以我們覺得"
    } ]
  }, {
    "tStartMs": 760922,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "如果沒有從源頭去鬆動"
    } ]
  }, {
    "tStartMs": 763006,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "「房價一定會漲」的預期"
    } ]
  }, {
    "tStartMs": 764946,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "那再多的打房政策"
    } ]
  }, {
    "tStartMs": 766239,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "可能都只是治標不治本"
    } ]
  }, {
    "tStartMs": 768407,
    "dDurationMs": 1607,
    "segs": [ {
      "utf8": "話是這麼說沒錯啦"
    } ]
  }, {
    "tStartMs": 770014,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "但要怎麼治本⋯⋯"
    } ]
  }, {
    "tStartMs": 771515,
    "dDurationMs": 1271,
    "segs": [ {
      "utf8": "作為外行人的我們"
    } ]
  }, {
    "tStartMs": 772786,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "真給不太出什麼明確的答案"
    } ]
  }, {
    "tStartMs": 774996,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "尤其，之前我們也做過"
    } ]
  }, {
    "tStartMs": 776331,
    "dDurationMs": 1231,
    "segs": [ {
      "utf8": "很多房價相關的影片"
    } ]
  }, {
    "tStartMs": 777562,
    "dDurationMs": 2605,
    "segs": [ {
      "utf8": "看過很多分析、也訪過不少專家"
    } ]
  }, {
    "tStartMs": 780167,
    "dDurationMs": 3024,
    "segs": [ {
      "utf8": "大家認為「對的方法」也不盡相同"
    } ]
  }, {
    "tStartMs": 783191,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "比較有明確共識的是"
    } ]
  }, {
    "tStartMs": 784420,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "無論用什麼方法"
    } ]
  }, {
    "tStartMs": 785922,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "這件事都會非常非常難"
    } ]
  }, {
    "tStartMs": 788321,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "恐怕也要花很長的一段時間"
    } ]
  }, {
    "tStartMs": 790280,
    "dDurationMs": 1104,
    "segs": [ {
      "utf8": "才能看到成效"
    } ]
  }, {
    "tStartMs": 791384,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "所以我們也在想"
    } ]
  }, {
    "tStartMs": 792343,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "除了「降低房價」"
    } ]
  }, {
    "tStartMs": 793636,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "或許政府也應該同步處理"
    } ]
  }, {
    "tStartMs": 795555,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "「高房價造成的居住問題」"
    } ]
  }, {
    "tStartMs": 797473,
    "dDurationMs": 2605,
    "segs": [ {
      "utf8": "比如透過興建社宅、補助措施"
    } ]
  }, {
    "tStartMs": 800078,
    "dDurationMs": 1292,
    "segs": [ {
      "utf8": "或健全租屋市場"
    } ]
  }, {
    "tStartMs": 801370,
    "dDurationMs": 2004,
    "segs": [ {
      "utf8": "來保障青年、老年人"
    } ]
  }, {
    "tStartMs": 803374,
    "dDurationMs": 1437,
    "segs": [ {
      "utf8": "和弱勢族群的居住權"
    } ]
  }, {
    "tStartMs": 804811,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "那至少在房價依然高漲的時候"
    } ]
  }, {
    "tStartMs": 807063,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "需要的人，能有個穩定"
    } ]
  }, {
    "tStartMs": 808690,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "可負擔的居住空間"
    } ]
  }, {
    "tStartMs": 810234,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "讓日子能好好過下去吧"
    } ]
  }, {
    "tStartMs": 812339,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "不過還是要再次強調"
    } ]
  }, {
    "tStartMs": 813380,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "這些都只是我們外行人的看法"
    } ]
  }, {
    "tStartMs": 815383,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "而且房價議題真的、真的是超級複雜"
    } ]
  }, {
    "tStartMs": 818260,
    "dDurationMs": 1397,
    "segs": [ {
      "utf8": "所以這一集可能也有一些"
    } ]
  }, {
    "tStartMs": 819657,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "不完整、不精確的地方"
    } ]
  }, {
    "tStartMs": 820824,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "那如果有對這塊比較熟悉的觀眾"
    } ]
  }, {
    "tStartMs": 822784,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "也很歡迎在留言區補充分享喔！"
    } ]
  }, {
    "tStartMs": 824911,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "好啦，最後也想來問問大家"
    } ]
  }, {
    "tStartMs": 826684,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "你覺得要打房，應該怎麼做比較對呢？"
    } ]
  }, {
    "tStartMs": 843922,
    "dDurationMs": 1229,
    "segs": [ {
      "utf8": "最後，如果你喜歡今天的影片"
    } ]
  }, {
    "tStartMs": 845151,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "歡迎分享出去，讓更多人知道「韓國打房」！"
    } ]
  }, {
    "tStartMs": 847110,
    "dDurationMs": 689,
    "segs": [ {
      "utf8": "此外也可以點這邊"
    } ]
  }, {
    "tStartMs": 847799,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "看看「中國打房」以及「台灣高房價」"
    } ]
  }, {
    "tStartMs": 850383,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "那麼，今天的志祺七七"
    } ]
  }, {
    "tStartMs": 851467,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "就到這邊告一段落，我們明晚再見囉！"
    } ]
  } ]
}
