    "tStartMs": 343800,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "This rice noodle has some very silky tofu in it."
    } ]
  }, {
    "tStartMs": 350399,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "Mmm."
    } ]
  }, {
    "tStartMs": 353633,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "The tofu inside this rice noodle"
    } ]
  }, {
    "tStartMs": 355666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "is particularly smooth and silky."
    } ]
  }, {
    "tStartMs": 361000,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "The boss is the first Achang person I've met in China."
    } ]
  }, {
    "tStartMs": 364600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There are only about forty thousand of them in all of China."
    } ]
  }, {
    "tStartMs": 366666,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 367366,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "Where do they mainly live?"
    } ]
  }, {
    "tStartMs": 369533,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "The Achang."
    } ]
  }, {
    "tStartMs": 370199,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "They mainly gather in three places."
    } ]
  }, {
    "tStartMs": 373366,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "One is Lianghe."
    } ]
  }, {
    "tStartMs": 374133,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "One is Tengchong."
    } ]
  }, {
    "tStartMs": 374800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "One is Longchuan."
    } ]
  }, {
    "tStartMs": 376000,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Oh, they're all in Yunnan."
    } ]
  }, {
    "tStartMs": 377533,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 378233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "So do the Achang have their own customs?"
    } ]
  }, {
    "tStartMs": 380166,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Special ones."
    } ]
  }, {
    "tStartMs": 380766,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Yes, they celebrate the Alu Woluo Festival."
    } ]
  }, {
    "tStartMs": 383399,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 385133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah, and then..."
    } ]
  }, {
    "tStartMs": 387399,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "They have a specialty."
    } ]
  }, {
    "tStartMs": 388066,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "They eat with their hands."
    } ]
  }, {
    "tStartMs": 391366,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "As for their skill, they make knives."
    } ]
  }, {
    "tStartMs": 393166,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It's one of China's four famous knives."
    } ]
  }, {
    "tStartMs": 395399,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hmm."
    } ]
  }, {
    "tStartMs": 396433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Sister, are you also Achang?"
    } ]
  }, {
    "tStartMs": 397966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 398866,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "I am too."
    } ]
  }, {
    "tStartMs": 399366,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Our Achang rice noodle."
    } ]
  }, {
    "tStartMs": 401600,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "This has gone viral, look."
    } ]
  }, {
    "tStartMs": 403766,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "One hundred sixteen thousand."
    } ]
  }, {
    "tStartMs": 404966,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Hmm."
    } ]
  }, {
    "tStartMs": 405366,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "Views."
    } ]
  }, {
    "tStartMs": 406133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh, wow."
    } ]
  }, {
    "tStartMs": 407166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This half-cooked meat,"
    } ]
  }, {
    "tStartMs": 409366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "fire-roasted pork."
    } ]
  }, {
    "tStartMs": 410366,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Hmm."
    } ]
  }, {
    "tStartMs": 410966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "The people here are really extremely warm."
    } ]
  }, {
    "tStartMs": 413000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "Once we start talking with them,"
    } ]
  }, {
    "tStartMs": 414833,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "asking about the food,"
    } ]
  }, {
    "tStartMs": 416000,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "they will tell you the whole story."
    } ]
  }, {
    "tStartMs": 417933,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "They really spend their time for you."
    } ]
  }, {
    "tStartMs": 420933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "OK, now we are ready to go again."
    } ]
  }, {
    "tStartMs": 424566,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Come back."
    } ]
  }, {
    "tStartMs": 425766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 427533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "Open your TeamSpeak."
    } ]
  }, {
    "tStartMs": 431666,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "I don't want to."
    } ]
  }, {
    "tStartMs": 433199,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 434033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Because you talk too much."
    } ]
  }, {
    "tStartMs": 435600,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "It's a bit annoying."
    } ]
  }, {
    "tStartMs": 438000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Annoying?"
    } ]
  }, {
    "tStartMs": 438866,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Let's go."
    } ]
  }, {
    "tStartMs": 440966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "And now we are going to look for"
    } ]
  }, {
    "tStartMs": 442433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "volcanoes and hot springs."
    } ]
  }, {
    "tStartMs": 443966,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "I read that there are over ninety hot springs in Tengchong,"
    } ]
  }, {
    "tStartMs": 448199,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "and it's the city in China with the most volcanoes,"
    } ]
  }, {
    "tStartMs": 451600,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "and also with the youngest volcano."
    } ]
  }, {
    "tStartMs": 453833,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I think the last latest eruption is"
    } ]
  }, {
    "tStartMs": 457533,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "maybe around four thousand years ago."
    } ]
  }, {
    "tStartMs": 547000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "We just flew our drone, basically, so"
    } ]
  }, {
    "tStartMs": 549433,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "all those small hills, they are,"
    } ]
  }, {
    "tStartMs": 551799,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "they used to be active volcanoes,"
    } ]
  }, {
    "tStartMs": 554966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "but many, many years ago."
    } ]
  }, {
    "tStartMs": 558666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hey."
    } ]
  }, {
    "tStartMs": 561533,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Although the volcanoes here"
    } ]
  }, {
    "tStartMs": 563133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "have long gone dormant,"
    } ]
  }, {
    "tStartMs": 564200,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "there is still plenty of heat"
    } ]
  }, {
    "tStartMs": 565966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "left beneath the surface."
    } ]
  }, {
    "tStartMs": 567533,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "It feels like a natural pressure cooker underground."
    } ]
  }, {
    "tStartMs": 570466,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "In some places,"
    } ]
  }, {
    "tStartMs": 571733,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "boiling hot water is constantly bubbling"
    } ]
  }, {
    "tStartMs": 574500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "and shooting out of the ground."
    } ]
  }, {
    "tStartMs": 578633,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Oh, wow."
    } ]
  }, {
    "tStartMs": 579333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "So hot."
    } ]
  }, {
    "tStartMs": 582399,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Hot as hell."
    } ]
  }, {
    "tStartMs": 583200,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "It's so hot that it's difficult to get close."
    } ]
  }, {
    "tStartMs": 600066,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Is it hot?"
    } ]
  }, {
    "tStartMs": 600766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Very hot."
    } ]
  }, {
    "tStartMs": 602066,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "It's really hot."
    } ]
  }, {
    "tStartMs": 602633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So hot."
    } ]
  }, {
    "tStartMs": 604866,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "It's boiling, but the water is quite clean."
    } ]
  }, {
    "tStartMs": 606833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "If you want, you can even make tea."
    } ]
  }, {
    "tStartMs": 611000,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Yeah, it's definitely very hot."
    } ]
  }, {
    "tStartMs": 618033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Yeah, cool."
    } ]
  }, {
    "tStartMs": 620033,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "It's quite hot."
    } ]
  }, {
    "tStartMs": 621600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "Think around seventy degrees."
    } ]
  }, {
    "tStartMs": 623933,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "Here it's boiling too."
    } ]
  }, {
    "tStartMs": 630566,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So Tengchong is pretty unique"
    } ]
  }, {
    "tStartMs": 632066,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "in the sense that here you"
    } ]
  }, {
    "tStartMs": 633633,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "can find both volcanoes and lots of hot springs."
    } ]
  }, {
    "tStartMs": 637466,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The reason is that it sits on a very unique"
    } ]
  }, {
    "tStartMs": 640633,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "location on the collision zone between"
    } ]
  }, {
    "tStartMs": 643966,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "the Indian Plate and the Eurasian Plate."
    } ]
  }, {
    "tStartMs": 647133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So when those two plates collide,"
    } ]
  }, {
    "tStartMs": 650266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "they not only create mountains"
    } ]
  }, {
    "tStartMs": 652833,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "but also lots of hot springs,"
    } ]
  }, {
    "tStartMs": 657166,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "because underground"
    } ]
  }, {
    "tStartMs": 658399,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "it's like a furnace."
    } ]
  }, {
    "tStartMs": 659633,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "It's very active,"
    } ]
  }, {
    "tStartMs": 660866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "and the heat,"
    } ]
  }, {
    "tStartMs": 662600,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "the molten rock, keeps"
    } ]
  }, {
    "tStartMs": 664833,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "heating the underground water up."
    } ]
  }, {
    "tStartMs": 669466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "At the entrance,"
    } ]
  }, {
    "tStartMs": 670333,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "you can buy the eggs,"
    } ]
  }, {
    "tStartMs": 671266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "and here in this big steamer,"
    } ]
  }, {
    "tStartMs": 673133,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "you can steam them for free."
    } ]
  }, {
    "tStartMs": 674933,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And right next to it, that's"
    } ]
  }, {
    "tStartMs": 677600,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "the most famous hot spring in Tengchong,"
    } ]
  }, {
    "tStartMs": 679899,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "in Tengchong,"
    } ]
  }, {
    "tStartMs": 680633,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "called Rehai Big Boiling Pot."
    } ]
  }, {
    "tStartMs": 681899,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "It's boiling all year round."
    } ]
  }, {
    "tStartMs": 686933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "And it's so steamy."
    } ]
  }, {
    "tStartMs": 719366,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "How much is a cup of orange juice?"
    } ]
  }, {
    "tStartMs": 720233,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Fifteen yuan a cup."
    } ]
  }, {
    "tStartMs": 721399,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "OK, I'll have one."
    } ]
  }, {
    "tStartMs": 724266,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Can we buy eggs and cook them here?"
    } ]
  }, {
    "tStartMs": 725933,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "Sure."
    } ]
  }, {
    "tStartMs": 726666,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "How much?"
    } ]
  }, {
    "tStartMs": 727366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Two yuan each."
    } ]
  }, {
    "tStartMs": 728433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Can I get two eggs, please?"
    } ]
  }, {
    "tStartMs": 732366,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "OK, two eggs."
    } ]
  }, {
    "tStartMs": 734433,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Ten minutes is enough."
    } ]
  }, {
    "tStartMs": 735533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Cook for ten minutes."
    } ]
  }, {
    "tStartMs": 736366,
    "dDurationMs": 267,
    "segs": [ {
      "utf8": "How much?"
    } ]
  }, {
    "tStartMs": 736633,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Hahaha."
    } ]
  }, {
    "tStartMs": 737666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 740366,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Sulfur spring, look."
    } ]
  }, {
    "tStartMs": 744399,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "Before coming to Tengchong,"
    } ]
  }, {
    "tStartMs": 745933,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "I heard that there are lots of hot springs."
    } ]
  }, {
    "tStartMs": 749066,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "There are fancy ones and also wild ones."
    } ]
  }, {
    "tStartMs": 752433,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "Many villages actually have hot springs."
    } ]
  }, {
    "tStartMs": 756466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "I just got the eggs"
    } ]
  }, {
    "tStartMs": 759799,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "because I found this pool,"
    } ]
  }, {
    "tStartMs": 762033,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "the sulfur spring."
    } ]
  }, {
    "tStartMs": 763233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "It's seventy-one degrees,"
    } ]
  }, {
    "tStartMs": 764666,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "so you can put the eggs"
    } ]
  }, {
    "tStartMs": 766100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "inside the hot spring to boil them."
    } ]
  }, {
    "tStartMs": 768766,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Here it is, Shiqiang Wild Hot Spring."
    } ]
  }, {
    "tStartMs": 771766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Look, the water is boiling"
    } ]
  }, {
    "tStartMs": 773633,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "and you can smell the sulfur."
    } ]
  }, {
    "tStartMs": 776166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mom."
    } ]
  }, {
    "tStartMs": 787066,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "That is apparently the hottest,"
    } ]
  }, {
    "tStartMs": 788966,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "seventy-one degrees, and"
    } ]
  }, {
    "tStartMs": 790366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "water flows here."
    } ]
  }, {
    "tStartMs": 792533,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Let me try this pool."
    } ]
  }, {
    "tStartMs": 795733,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "Um, this is quite hot."
    } ]
  }, {
    "tStartMs": 798466,
    "dDurationMs": 933,
    "segs": [ {
