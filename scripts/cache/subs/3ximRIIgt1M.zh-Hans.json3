    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "但是很舒畅"
    } ]
  }, {
    "tStartMs": 558733,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "过程有点辛苦有点累"
    } ]
  }, {
    "tStartMs": 562533,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "但是打完以后非常满足、很舒畅"
    } ]
  }, {
    "tStartMs": 567000,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "这个就是运动的好处"
    } ]
  }, {
    "tStartMs": 570766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "快12点了"
    } ]
  }, {
    "tStartMs": 572566,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "回家做饭啦"
    } ]
  }, {
    "tStartMs": 574966,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "今天我想吃红烧排骨"
    } ]
  }, {
    "tStartMs": 579033,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "我把排骨洗干净了"
    } ]
  }, {
    "tStartMs": 581800,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "这里有大概300克的排骨"
    } ]
  }, {
    "tStartMs": 585600,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "姜片"
    } ]
  }, {
    "tStartMs": 587066,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "这种瓜在我们这里叫“丝瓜”"
    } ]
  }, {
    "tStartMs": 590766,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "做红烧排骨"
    } ]
  }, {
    "tStartMs": 592166,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "还有炒丝瓜"
    } ]
  }, {
    "tStartMs": 595066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "一荤一素"
    } ]
  }, {
    "tStartMs": 597066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "一肉一菜"
    } ]
  }, {
    "tStartMs": 599700,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "完美"
    } ]
  }, {
    "tStartMs": 648900,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "大家知道这是什么水果吗"
    } ]
  }, {
    "tStartMs": 653400,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "对了，就是百香果"
    } ]
  }, {
    "tStartMs": 661066,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "现在刚好是百香果的季节"
    } ]
  }, {
    "tStartMs": 664100,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "外面有很多百香果在卖"
    } ]
  }, {
    "tStartMs": 667400,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "红烧排骨差不多好了"
    } ]
  }, {
    "tStartMs": 673600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "红烧排骨差不多做好了"
    } ]
  }, {
    "tStartMs": 676200,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "我个人呢，喜欢加一点百香果进去"
    } ]
  }, {
    "tStartMs": 681100,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "酸酸甜甜的，很开胃"
    } ]
  }, {
    "tStartMs": 685133,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "没有人教我，是我自己想出来的办法"
    } ]
  }, {
    "tStartMs": 689100,
    "dDurationMs": 5666,
    "segs": [ {
      "utf8": "但是我觉得红烧排骨跟百香果是很配的"
    } ]
  }, {
    "tStartMs": 702033,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "百香果是我最喜欢吃的水果之一"
    } ]
  }, {
    "tStartMs": 708433,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "它有丰富的维生素c"
    } ]
  }, {
    "tStartMs": 715100,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "接下来把它拌匀了就可以出锅了"
    } ]
  }, {
    "tStartMs": 719033,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "哇，好美味的样子哦"
    } ]
  }, {
    "tStartMs": 724300,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "拿一个可爱的盘子"
    } ]
  }, {
    "tStartMs": 727300,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "来盛我最喜欢的红烧排骨"
    } ]
  }, {
    "tStartMs": 739100,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "怎么样？还可以吧？"
    } ]
  }, {
    "tStartMs": 743000,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "清炒丝瓜也出锅了"
    } ]
  }, {
    "tStartMs": 747633,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "简简单单"
    } ]
  }, {
    "tStartMs": 754433,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "饭做好了"
    } ]
  }, {
    "tStartMs": 756033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "马上要开饭了"
    } ]
  }, {
    "tStartMs": 758300,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "这个就是我普通又简单的一个早上"
    } ]
  }, {
    "tStartMs": 762433,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "在我眼中，简单就是幸福"
    } ]
  }, {
    "tStartMs": 766566,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "大家也是这么觉得的吗"
    } ]
  }, {
    "tStartMs": 769566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "希望大家喜欢这个视频"
    } ]
  }, {
    "tStartMs": 771433,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我们下个视频见"
    } ]
  }, {
