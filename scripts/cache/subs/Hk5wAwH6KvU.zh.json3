  "events": [ {
    "tStartMs": 7200,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "嗨朋友们"
    } ]
  }, {
    "tStartMs": 8166,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "我是Mini"
    } ]
  }, {
    "tStartMs": 9166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "欢迎你来到我的频道"
    } ]
  }, {
    "tStartMs": 11400,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "今天这期节目呢"
    } ]
  }, {
    "tStartMs": 12833,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "咱们一块在温哥华的"
    } ]
  }, {
    "tStartMs": 16066,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "傍晚时分出来走一走散散步"
    } ]
  }, {
    "tStartMs": 20200,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "一边散步呢"
    } ]
  }, {
    "tStartMs": 21466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "一边聊聊天"
    } ]
  }, {
    "tStartMs": 23166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "哈哈哈你们看"
    } ]
  }, {
    "tStartMs": 25933,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "这里有一只牛"
    } ]
  }, {
    "tStartMs": 28033,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "哦不是一只哦"
    } ]
  }, {
    "tStartMs": 29266,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "是好几只"
    } ]
  }, {
    "tStartMs": 33166,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "现在是晚上6点多你们看"
    } ]
  }, {
    "tStartMs": 36600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "太阳快要落山了"
    } ]
  }, {
    "tStartMs": 38733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这个是夕阳夕阳"
    } ]
  }, {
    "tStartMs": 41766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 43233,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "傍晚时分景色也很美"
    } ]
  }, {
    "tStartMs": 47133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 48366,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "还是能闻到那个牛的味道哈哈哈"
    } ]
  }, {
    "tStartMs": 52200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "因为刚才过去那边有好多只牛"
    } ]
  }, {
    "tStartMs": 55766,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "然后有一股牛粪的味道哈哈哈"
    } ]
  }, {
    "tStartMs": 60266,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "哇这个味道"
    } ]
  }, {
    "tStartMs": 61966,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "嗯不太好闻"
    } ]
  }, {
    "tStartMs": 63933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "现在是9月份了秋天了"
    } ]
  }, {
    "tStartMs": 66933,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "嗯你们那边的天气怎么样呢"
    } ]
  }, {
    "tStartMs": 69633,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "是不是也开始变冷了"
    } ]
  }, {
    "tStartMs": 73533,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "温哥华也是这样"
    } ]
  }, {
    "tStartMs": 74833,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "现在温哥华的早晨和晚上都很冷"
    } ]
  }, {
    "tStartMs": 79733,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "需要穿外套"
    } ]
  }, {
    "tStartMs": 81933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "比如说像我现在这件"
    } ]
  }, {
    "tStartMs": 84566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我今天呢穿了一个"
    } ]
  }, {
    "tStartMs": 86133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "这个是冲锋衣冲锋衣"
    } ]
  }, {
    "tStartMs": 89400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "这种冲锋衣在温哥华"
    } ]
  }, {
    "tStartMs": 91133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "这里穿就非常合适"
    } ]
  }, {
    "tStartMs": 93866,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "它呢不仅可以防风防风"
    } ]
  }, {
    "tStartMs": 97566,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "而且还防雨防雨"
    } ]
  }, {
    "tStartMs": 100633,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "嗯现在穿非常的舒服对"
    } ]
  }, {
    "tStartMs": 104633,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "然后温哥华现在的"
    } ]
  }, {
    "tStartMs": 106433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "天气就是早晚比较凉"
    } ]
  }, {
    "tStartMs": 109266,
    "dDurationMs": 4534,
    "segs": [ {
      "utf8": "呃下午的时候有太阳就会很热嗯"
    } ]
  }, {
    "tStartMs": 114266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "啊现在太阳还没落山你们看"
    } ]
  }, {
    "tStartMs": 118666,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "阳光洒在我的脸上"
    } ]
  }, {
    "tStartMs": 121366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "还是觉得很温暖哈哈哈"
    } ]
  }, {
    "tStartMs": 125200,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "傍晚的时候呢散散步啊"
    } ]
  }, {
    "tStartMs": 128533,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "感觉今天一天工作的压力都没有了"
    } ]
  }, {
    "tStartMs": 133600,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "很舒服很自在很惬意"
    } ]
  }, {
    "tStartMs": 137833,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "嗯刚刚我说的这三个词"
    } ]
  }, {
    "tStartMs": 140800,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "可以形容我们心情如何"
    } ]
  }, {
    "tStartMs": 144400,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "舒服自在惬意"
    } ]
  }, {
    "tStartMs": 148033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "这3个词经常使用哦"
    } ]
  }, {
    "tStartMs": 149733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "你们可以记住它们"
    } ]
  }, {
    "tStartMs": 152566,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "哇你们看夕阳多美啊"
    } ]
  }, {
    "tStartMs": 158000,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "听到了吗"
    } ]
  }, {
    "tStartMs": 158866,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "牛在叫哈哈哈"
    } ]
  }, {
    "tStartMs": 161933,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "然后这里呢"
    } ]
  }, {
    "tStartMs": 162833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "有很多这样的小花你们看"
    } ]
  }, {
    "tStartMs": 166133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "这个是花"
    } ]
  }, {
    "tStartMs": 168266,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "小花哈哈"
    } ]
  }, {
    "tStartMs": 170333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "好漂亮哦"
    } ]
  }, {
    "tStartMs": 173566,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "后面还有很多的草草"
    } ]
  }, {
    "tStartMs": 178066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "那我现在呢"
    } ]
  }, {
    "tStartMs": 179333,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "就沿着这条海岸线你们看"
    } ]
  }, {
    "tStartMs": 183933,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "那边是大海"
    } ]
  }, {
    "tStartMs": 185166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "然后沿着这条海岸线"
    } ]
  }, {
    "tStartMs": 188066,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我们一直往前走往前走"
    } ]
  }, {
    "tStartMs": 191733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "走到海边去嗯"
    } ]
  }, {
    "tStartMs": 196433,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "大概距离有两三公里左右吧"
    } ]
  }, {
    "tStartMs": 201833,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "其实这样慢慢走过去也很快嗯"
    } ]
  }, {
    "tStartMs": 208066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "这个距离的话"
    } ]
  }, {
    "tStartMs": 209333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "骑自行车是最好的"
    } ]
  }, {
    "tStartMs": 212266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "你会看到很多骑自行车的人对"
    } ]
  }, {
    "tStartMs": 216766,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "啊我觉得这边的房子真的很好哎"
    } ]
  }, {
    "tStartMs": 221633,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这些是房子房子"
    } ]
  }, {
    "tStartMs": 224533,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "那住在这里呢"
    } ]
  }, {
    "tStartMs": 226400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "对面哦你看这个房子的对面"
    } ]
  }, {
    "tStartMs": 229966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "就是这么美好的风景"
    } ]
  }, {
    "tStartMs": 232400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "远处就是海边"
    } ]
  }, {
    "tStartMs": 234833,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "我要是能住在这里该多好"
    } ]
  }, {
    "tStartMs": 239366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我觉得住在这风景真的很好"
    } ]
  }, {
    "tStartMs": 242400,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "每天都可以看着夕阳看日出"
    } ]
  }, {
    "tStartMs": 246966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "呵呵对"
    } ]
  }, {
    "tStartMs": 248166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我教你们这个词哈"
    } ]
  }, {
    "tStartMs": 249866,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "现在的时间"
    } ]
  }, {
    "tStartMs": 251133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "傍晚时分嘛"
    } ]
  }, {
    "tStartMs": 252633,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "然后这个落日呢"
    } ]
  }, {
    "tStartMs": 254666,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "叫做夕阳夕阳"
    } ]
  }, {
    "tStartMs": 257366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "然后早晨的时候"
    } ]
  }, {
    "tStartMs": 259233,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "太阳刚出来的"
    } ]
  }, {
    "tStartMs": 260466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "那个叫日出日出嗯"
    } ]
  }, {
    "tStartMs": 264600,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "这里有两个长椅两个长椅"
    } ]
  }, {
    "tStartMs": 268833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "可以坐在这休息看风景"
    } ]
  }, {
    "tStartMs": 273666,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我觉得傍晚时分"
    } ]
  }, {
    "tStartMs": 275766,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "这个时候的光很柔和柔和你们看"
    } ]
  }, {
    "tStartMs": 280833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "就是打在人的脸上"
    } ]
  }, {
    "tStartMs": 283366,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "感觉非常漂亮"
    } ]
  }, {
    "tStartMs": 285633,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "很自然嗯"
    } ]
  }, {
    "tStartMs": 288633,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "不过呢因为是海边的原因吧"
    } ]
  }, {
    "tStartMs": 291933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "虫子还是很多的"
    } ]
  }, {
    "tStartMs": 293766,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "我很怕虫子"
    } ]
  }, {
    "tStartMs": 295466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "尤其是蚊子"
    } ]
  }, {
    "tStartMs": 297533,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "之前呢上个月不是有蚊子把"
    } ]
  }, {
    "tStartMs": 300800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我的眼睛咬肿了吗"
    } ]
  }, {
    "tStartMs": 302733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "当时肿的很厉害哦"
    } ]
  }, {
    "tStartMs": 305466,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "而且很痛苦很难受啊"
    } ]
  }, {
    "tStartMs": 309400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "刚刚走过来的时候也有虫子在这飞"
    } ]
  }, {
    "tStartMs": 312466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "哎呦好怕"
    } ]
  }, {
    "tStartMs": 314833,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "哇放眼望去哦"
    } ]
  }, {
    "tStartMs": 317766,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "这里呢是一片的绿色"
    } ]
  }, {
    "tStartMs": 320666,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "绿色的草"
    } ]
  }, {
    "tStartMs": 322466,
    "dDurationMs": 5334,
    "segs": [ {
      "utf8": "然后远处呢是金黄色的太阳金黄色"
    } ]
  }, {
    "tStartMs": 327800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "哇你们看"
    } ]
  }, {
    "tStartMs": 328533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "马上就要下山喽"
    } ]
  }, {
    "tStartMs": 330733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "快看"
    } ]
  }, {
    "tStartMs": 332333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "快看快看"
    } ]
  }, {
    "tStartMs": 333166,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "太阳马上就要落山了"
    } ]
  }, {
    "tStartMs": 336033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 337833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "带你们看了一个日落"
    } ]
  }, {
    "tStartMs": 340066,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "真挺美的"
    } ]
  }, {
    "tStartMs": 342600,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "哇感觉太阳落山之后"
    } ]
  }, {
    "tStartMs": 345566,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "天色马上就暗下来了"
    } ]
  }, {
    "tStartMs": 348366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "天色天色暗下来了暗"
    } ]
  }, {
    "tStartMs": 351833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "我们快走两步快走"
    } ]
  }, {
    "tStartMs": 355466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "一直往前走去海边"
    } ]
  }, {
    "tStartMs": 359200,
    "dDurationMs": 4966,
    "segs": [ {
      "utf8": "看这里有一个指示牌指示牌"
    } ]
  }, {
    "tStartMs": 364166,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "一直往前走往前走"
    } ]
  }, {
    "tStartMs": 369733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我其实很喜欢看海"
    } ]
  }, {
    "tStartMs": 372500,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "尤其是当你感觉心情不好的时候"
    } ]
  }, {
    "tStartMs": 376366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "或者工作压力哦虫子"
    } ]
  }, {
    "tStartMs": 379733,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "或者工作压力大的时候"
    } ]
  }, {
    "tStartMs": 382533,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "压力大的时候"
    } ]
  }, {
    "tStartMs": 383533,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我就很喜欢到海边"
    } ]
  }, {
    "tStartMs": 385900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "一个人到海边啊"
    } ]
  }, {
    "tStartMs": 388366,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "什么也不做"
    } ]
  }, {
    "tStartMs": 389500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "什么也不想"
    } ]
  }, {
    "tStartMs": 390700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "就静静的看看大海"
    } ]
  }, {
    "tStartMs": 394100,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "我就会觉得非常的治愈治愈对"
    } ]
  }, {
    "tStartMs": 398066,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "因为大海呢"
    } ]
  }, {
    "tStartMs": 399500,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "给我们的感觉就是很辽阔的"
    } ]
  }, {
    "tStartMs": 402866,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "啊其实不仅是大海"
    } ]
  }, {
    "tStartMs": 404333,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "我觉得大自然就是有"
    } ]
  }, {
    "tStartMs": 405966,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这种很神奇的魅力"
    } ]
  }, {
    "tStartMs": 409366,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "可以帮我们去减轻很多的压力"
    } ]
  }, {
    "tStartMs": 412666,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "让我们重新充满能量"
    } ]
  }, {
    "tStartMs": 416733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "好的你们看"
    } ]
  }, {
    "tStartMs": 419966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我们到了这个公园了"
    } ]
  }, {
    "tStartMs": 422600,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "前面这里就是公园"
    } ]
  }, {
    "tStartMs": 427466,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "这里是一条小路小路"
    } ]
  }, {
    "tStartMs": 430933,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我们从这条小路走过去"
    } ]
  }, {
    "tStartMs": 435100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "前面就是大海啦"
    } ]
  }, {
    "tStartMs": 437133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "哈哈哈好兴奋啊"
    } ]
  }, {
    "tStartMs": 440100,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "我真的很久没来这里了"
    } ]
  }, {
    "tStartMs": 444966,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "哦我该走哪里"
    } ]
  }, {
    "tStartMs": 447466,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "从这过去好了"
    } ]
  }, {
    "tStartMs": 451766,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "哇天上有好多鸟在飞哎"
    } ]
  }, {
    "tStartMs": 455300,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "好多的鸟在飞"
    } ]
  }, {
    "tStartMs": 458766,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "天上还有月亮月亮"
    } ]
  }, {
    "tStartMs": 461300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "这个是月亮"
    } ]
  }, {
    "tStartMs": 463333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 465766,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "这里有很多的沙子沙子"
    } ]
  }, {
    "tStartMs": 472166,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "我们到了到了到海边了"
    } ]
  }, {
    "tStartMs": 476666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 479466,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "前面就是大海"
    } ]
  }, {
    "tStartMs": 483366,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "哇走过来还有点累呢"
    } ]
  }, {
    "tStartMs": 486500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 488200,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "看这个呢就是沙滩沙滩"
    } ]
  }, {
    "tStartMs": 492600,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "虽然它很脏"
    } ]
  }, {
    "tStartMs": 495966,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "但是它也是沙滩"
    } ]
  }, {
    "tStartMs": 498300,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "沙滩上呢有很多的木头"
    } ]
  }, {
    "tStartMs": 500666,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "这些都是木头木头"
    } ]
  }, {
    "tStartMs": 505700,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "然后我们看海边"
    } ]
  }, {
    "tStartMs": 509100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "海上有一艘很大的船"
    } ]
  }, {
    "tStartMs": 512400,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "这个是船"
    } ]
  }, {
    "tStartMs": 514466,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "应该是货船货船"
    } ]
  }, {
    "tStartMs": 517600,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "傍晚时分的海面非常的平静平静"
    } ]
  }, {
    "tStartMs": 524533,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 526400,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "好久没来这边了"
    } ]
  }, {
    "tStartMs": 529066,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "哦你们看啊"
    } ]
  }, {
    "tStartMs": 531200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "平静的海面上呢"
    } ]
  }, {
    "tStartMs": 532566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "有一艘快艇"
    } ]
  }, {
    "tStartMs": 534966,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "哇那个是快艇"
    } ]
  }, {
    "tStartMs": 536666,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "开的很快"
    } ]
  }, {
    "tStartMs": 539566,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "我现在呢"
    } ]
  }, {
    "tStartMs": 540466,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "是蹲在了呃海滩上蹲蹲着"
    } ]
  }, {
    "tStartMs": 545066,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "哈哈哈蹲着"
    } ]
  }, {
    "tStartMs": 547100,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "然后静静的看着我前面的大海"
    } ]
  }, {
    "tStartMs": 551933,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "我现在跟大海的距离很近你们看"
    } ]
  }, {
    "tStartMs": 555866,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "而且呢现在只有我一个人"
    } ]
  }, {
    "tStartMs": 558466,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "哇好舒服哦"
    } ]
  }, {
    "tStartMs": 560200,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "这种感觉很奇妙"
    } ]
  }, {
    "tStartMs": 563100,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "就是这样简简单单听着大海"
    } ]
  }, {
    "tStartMs": 566000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "的这种拍打在沙滩上的声音"
    } ]
  }, {
    "tStartMs": 569000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "然后天上有的时候会有海鸥"
    } ]
  }, {
    "tStartMs": 571466,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那个应该是海鸥"
    } ]
  }, {
    "tStartMs": 573533,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "海鸥的叫声"
    } ]
  }, {
    "tStartMs": 575866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我觉得好平静"
    } ]
  }, {
    "tStartMs": 579166,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "你们听"
    } ]
  }, {
    "tStartMs": 581200,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "哇好舒服哦"
    } ]
  }, {
    "tStartMs": 584966,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "真的很想在这里待一夜哈哈"
    } ]
  }, {
    "tStartMs": 588133,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "海浪的声音也很好听哎"
    } ]
  }, {
    "tStartMs": 591266,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "然后这个我们叫海浪海浪"
    } ]
  }, {
    "tStartMs": 595133,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "当然啦今天的浪不大，很小"
    } ]
  }, {
    "tStartMs": 600400,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "溅起来的这些水花呢"
    } ]
  }, {
    "tStartMs": 602066,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我们叫浪花浪花"
    } ]
  }, {
    "tStartMs": 609066,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "海边的这些木头的造型也很奇特"
    } ]
  }, {
    "tStartMs": 613000,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "非常奇特的造型"
    } ]
  }, {
    "tStartMs": 615900,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "那我先坐在这块木头上"
    } ]
  }, {
    "tStartMs": 619200,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "坐坐下来"
    } ]
  }, {
    "tStartMs": 621366,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "哇我已经陶醉了"
    } ]
  }, {
    "tStartMs": 624200,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "陶醉陶醉在海边的美景里了哈哈"
    } ]
  }, {
    "tStartMs": 630900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "天色也越来越暗了"
    } ]
  }, {
    "tStartMs": 634300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哦"
    } ]
  }, {
    "tStartMs": 637800,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "海浪的声音也变大了你们看"
    } ]
  }, {
    "tStartMs": 642733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哇哦"
    } ]
  }, {
    "tStartMs": 645400,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "哇这里还有风筝风筝"
    } ]
  }, {
    "tStartMs": 651966,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "有人呢在这边放风筝放风筝"
    } ]
  }, {
    "tStartMs": 657533,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "好吧现在天已经越来越黑了"
    } ]
  }, {
    "tStartMs": 659933,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我要回家了"
    } ]
  }, {
    "tStartMs": 661733,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "而且主要是这边的蚊子好多呀"
    } ]
  }, {
    "tStartMs": 664566,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "刚刚坐在那里呢"
    } ]
  }, {
    "tStartMs": 665700,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "有好多的蚊子在我旁边飞"
    } ]
  }, {
    "tStartMs": 668866,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我真的太招蚊子了哈哈"
    } ]
  }, {
    "tStartMs": 671733,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "那我们这期节目到这里喽"
    } ]
  }, {
    "tStartMs": 673766,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "你们可以用今天这期"
    } ]
  }, {
    "tStartMs": 675266,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "节目去练一下自己的听力"
    } ]
  }, {
    "tStartMs": 677300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "看看自己能听懂多少好不好"
    } ]
  }, {
    "tStartMs": 680000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "欢迎你们在评论区告诉我哦"
    } ]
  }, {
    "tStartMs": 682566,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "我们下期节目再见啦"
    } ]
  }, {
    "tStartMs": 684166,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "谢谢你们陪伴我一起在"
    } ]
  }, {
    "tStartMs": 686266,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "海边度过了一个美好的夜晚"
    } ]
  }, {
    "tStartMs": 689666,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "OK我们下期再见拜拜"
    } ]
  }, {
    "tStartMs": 695700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "木头"
    } ]
  }, {
    "tStartMs": 696566,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "有一只鸟落在了这边"
    } ]
  }, {
    "tStartMs": 700066,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "还有一个船"
    } ]
  } ]
}
