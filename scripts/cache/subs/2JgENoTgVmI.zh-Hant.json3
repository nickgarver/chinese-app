  "events": [ {
    "tStartMs": 69766,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "第十集"
    } ]
  }, {
    "tStartMs": 71700,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "三次危險"
    } ]
  }, {
    "tStartMs": 75200,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "孫悟空走進師父的房間"
    } ]
  }, {
    "tStartMs": 80500,
    "dDurationMs": 5333,
    "segs": [ {
      "utf8": "師父果然在裡面等牠"
    } ]
  }, {
    "tStartMs": 85966,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "孫悟空跪在師父面前"
    } ]
  }, {
    "tStartMs": 90366,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "師父要教牠不死的方法"
    } ]
  }, {
    "tStartMs": 97600,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "師父小聲地教牠"
    } ]
  }, {
    "tStartMs": 101666,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "孫悟空認真地聽"
    } ]
  }, {
    "tStartMs": 106000,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "不知不覺"
    } ]
  }, {
    "tStartMs": 108266,
    "dDurationMs": 4734,
    "segs": [ {
      "utf8": "天亮了"
    } ]
  }, {
    "tStartMs": 114266,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "孫悟空從後門走了出去"
    } ]
  }, {
    "tStartMs": 118966,
    "dDurationMs": 6167,
    "segs": [ {
      "utf8": "回到了牠和其他人的房間"
    } ]
  }, {
    "tStartMs": 125300,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "其他人還在睡"
    } ]
  }, {
    "tStartMs": 128533,
    "dDurationMs": 5667,
    "segs": [ {
      "utf8": "其他人不知道師父教了孫悟空"
    } ]
  }, {
    "tStartMs": 137766,
    "dDurationMs": 8167,
    "segs": [ {
      "utf8": "白天 孫悟空和其他人一起學習"
    } ]
  }, {
    "tStartMs": 146166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "沒有人的時候"
    } ]
  }, {
    "tStartMs": 148466,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "牠一個人練習"
    } ]
  }, {
    "tStartMs": 152766,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "晚上"
    } ]
  }, {
    "tStartMs": 154333,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "牠也認真練習"
    } ]
  }, {
    "tStartMs": 158666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "三年過去了"
    } ]
  }, {
    "tStartMs": 163800,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "師父問 你學會了嗎"
    } ]
  }, {
    "tStartMs": 168666,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "孫悟空說"
    } ]
  }, {
    "tStartMs": 170500,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "我學會了"
    } ]
  }, {
    "tStartMs": 174000,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "師父說 這還不夠"
    } ]
  }, {
    "tStartMs": 178400,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "以後你會遇到三次危險"
    } ]
  }, {
    "tStartMs": 184966,
    "dDurationMs": 5467,
    "segs": [ {
      "utf8": "第一次危險 是很大的雷"
    } ]
  }, {
    "tStartMs": 190566,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "五百年以後雷會打下來"
    } ]
  }, {
    "tStartMs": 194800,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "你一定要躲開"
    } ]
  }, {
    "tStartMs": 198666,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "孫悟空認真地聽"
    } ]
  }, {
    "tStartMs": 203566,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "再過五百年"
    } ]
  }, {
    "tStartMs": 206700,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "火會來"
    } ]
  }, {
    "tStartMs": 209733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "這不是普通的火"
    } ]
  }, {
    "tStartMs": 212333,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "火會從你的身體裡面燒起來"
    } ]
  }, {
    "tStartMs": 217566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "這次危險"
    } ]
  }, {
    "tStartMs": 219500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "你也要躲開"
    } ]
  }, {
    "tStartMs": 223766,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "再過五百年"
    } ]
  }, {
    "tStartMs": 226566,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "大風會來"
    } ]
  }, {
    "tStartMs": 231066,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "風會進入你的身體"
    } ]
  }, {
    "tStartMs": 235466,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "這次危險你也要躲開"
    } ]
  }, {
    "tStartMs": 240400,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "孫悟空聽了很害怕"
    } ]
  }, {
    "tStartMs": 247166,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "孫悟空向師父行禮"
    } ]
  }, {
    "tStartMs": 251266,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "牠說"
    } ]
  }, {
    "tStartMs": 252866,
    "dDurationMs": 5167,
    "segs": [ {
      "utf8": "請教我躲開危險的方法"
    } ]
  }, {
    "tStartMs": 258333,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "師父說 可是你和人不一樣"
    } ]
  }, {
    "tStartMs": 266800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "孫悟空問"
    } ]
  }, {
    "tStartMs": 269000,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "哪裡不一樣"
    } ]
  }, {
    "tStartMs": 273133,
    "dDurationMs": 6133,
    "segs": [ {
      "utf8": "師父說 你的臉頰比人小"
    } ]
  }, {
    "tStartMs": 279500,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "孫悟空摸摸自己的臉"
    } ]
  }, {
    "tStartMs": 283100,
    "dDurationMs": 7033,
    "segs": [ {
      "utf8": "牠說 可是我的嘴裡有放東西的小袋子"
    } ]
  }, {
    "tStartMs": 290366,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "師父笑了"
    } ]
  }, {
    "tStartMs": 293100,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "說 好 我教你"
    } ]
  }, {
    "tStartMs": 297800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "師父會教牠什麼呢"
    } ]
  }, {
    "tStartMs": 300200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我們下回說"
    } ]
  } ]
}
