    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "超级可爱的一只羊"
    } ]
  }, {
    "tStartMs": 310600,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这只羊的名字呢"
    } ]
  }, {
    "tStartMs": 312133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "叫piano"
    } ]
  }, {
    "tStartMs": 313633,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 316166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "这只羊的名字叫piano"
    } ]
  }, {
    "tStartMs": 318400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就是弹的钢琴的那个piano"
    } ]
  }, {
    "tStartMs": 321133,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我以前特别喜欢粉红色的东西"
    } ]
  }, {
    "tStartMs": 323600,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "所以很长一段时间我"
    } ]
  }, {
    "tStartMs": 325000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "对hello Kitty都是无感的"
    } ]
  }, {
    "tStartMs": 327533,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "这两年呢"
    } ]
  }, {
    "tStartMs": 328766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "在中国的社交媒体上面"
    } ]
  }, {
    "tStartMs": 331100,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "女孩子们争相购买的一个hello Kitty的商品"
    } ]
  }, {
    "tStartMs": 336000,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "那就是一个黑皮hello Kitty"
    } ]
  }, {
    "tStartMs": 339700,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "黑皮呢"
    } ]
  }, {
    "tStartMs": 340400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我现在手上是没有的"
    } ]
  }, {
    "tStartMs": 342133,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "我去年其实去夏威夷玩了一段时间"
    } ]
  }, {
    "tStartMs": 345833,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我在夏威夷的Souvenir"
    } ]
  }, {
    "tStartMs": 347833,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "就是纪念品商店里面逛了很久"
    } ]
  }, {
    "tStartMs": 351033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "看了很多的"
    } ]
  }, {
    "tStartMs": 353500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "这种黑皮的hello Kitty"
    } ]
  }, {
    "tStartMs": 355100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我最终都没有选择买"
    } ]
  }, {
    "tStartMs": 357300,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我现在又有一点后悔啊"
    } ]
  }, {
    "tStartMs": 358900,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 359666,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "我现在其实还有一点点后悔"
    } ]
  }, {
    "tStartMs": 362033,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "黑皮呢"
    } ]
  }, {
    "tStartMs": 362666,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "就是指的这种颜色的皮肤"
    } ]
  }, {
    "tStartMs": 366500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "中文网络上面会称它为黑皮"
    } ]
  }, {
    "tStartMs": 370300,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "它其实呢"
    } ]
  }, {
    "tStartMs": 370900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就是晒出来的小麦色"
    } ]
  }, {
    "tStartMs": 374000,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "然后呢"
    } ]
  }, {
    "tStartMs": 374600,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "这个玩偶给大家看到的"
    } ]
  }, {
    "tStartMs": 376633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "又是一个时代的回忆"
    } ]
  }, {
    "tStartMs": 379700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我们经常会说就是"
    } ]
  }, {
    "tStartMs": 382066,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "一个流行已经过去了之后呢"
    } ]
  }, {
    "tStartMs": 384266,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "中文里面会经常说"
    } ]
  }, {
    "tStartMs": 385666,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "这是一个时代的回忆"
    } ]
  }, {
    "tStartMs": 388666,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "这个娃娃来自于日本"
    } ]
  }, {
    "tStartMs": 391200,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "一个曾经特别火的模特"
    } ]
  }, {
    "tStartMs": 395066,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "混血模特叫梨花"
    } ]
  }, {
    "tStartMs": 397833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "她之前是作为一个vivi的当家模特"
    } ]
  }, {
    "tStartMs": 402200,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "日本的少女杂志里面"
    } ]
  }, {
    "tStartMs": 403733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "特别喜欢用混血模特"
    } ]
  }, {
    "tStartMs": 406133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "我特别记得是在2010年"
    } ]
  }, {
    "tStartMs": 409400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "至2020年这十年期间"
    } ]
  }, {
    "tStartMs": 412866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "整个日本的流行文化对"
    } ]
  }, {
    "tStartMs": 415066,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "中国的影响是比较大的"
    } ]
  }, {
    "tStartMs": 417633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但是在2020年之后呢"
    } ]
  }, {
    "tStartMs": 420100,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "这个影响就会慢慢减弱"
    } ]
  }, {
    "tStartMs": 423400,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "基本上已经很少会看到了"
    } ]
  }, {
    "tStartMs": 426633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "在社交媒体上面"
    } ]
  }, {
    "tStartMs": 428066,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "大家已经几乎不能够看到"
    } ]
  }, {
    "tStartMs": 430833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "就是一些特别特别日系打扮的小孩了"
    } ]
  }, {
    "tStartMs": 434800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "日系又重新回归到了"
    } ]
  }, {
    "tStartMs": 436833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "一个比较小众的一个状态"
    } ]
  }, {
    "tStartMs": 439166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "这也是一个时代的回忆"
    } ]
  }, {
    "tStartMs": 441066,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "当年这个日本模特"
    } ]
  }, {
    "tStartMs": 442766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "这个Rinka梨花"
    } ]
  }, {
    "tStartMs": 444633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "就是作为vivi的一个当家模特"
    } ]
  }, {
    "tStartMs": 447166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "出了一个自己的时装品牌"
    } ]
  }, {
    "tStartMs": 450200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "我记得我在东京的时候会经常去逛它"
    } ]
  }, {
    "tStartMs": 452866,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "在代官山的店"
    } ]
  }, {
    "tStartMs": 455533,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "当时就是连她出的这个玩偶都会非常的火"
    } ]
  }, {
    "tStartMs": 460333,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "大家就可以看啊"
    } ]
  }, {
    "tStartMs": 461300,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这个就是一个黑皮的娃娃"
    } ]
  }, {
    "tStartMs": 464266,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 465566,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "hello Kitty也出了一个黑皮款的hello Kitty"
    } ]
  }, {
    "tStartMs": 469833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "就爆火"
    } ]
  }, {
    "tStartMs": 471233,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "在中国就是「一猫难求」"
    } ]
  }, {
    "tStartMs": 474133,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "现在呢"
    } ]
  }, {
    "tStartMs": 474600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "中国的女孩子会把这种"
    } ]
  }, {
    "tStartMs": 476166,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Hello Kitty的玩偶挂在任何的地方"
    } ]
  }, {
    "tStartMs": 479866,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "我最近呢"
    } ]
  }, {
    "tStartMs": 480800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "是有想要买一辆自行车"
    } ]
  }, {
    "tStartMs": 483233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "然后"
    } ]
  }, {
    "tStartMs": 484233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "出去运动运动"
    } ]
  }, {
    "tStartMs": 485800,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "然后就发现社交媒体上面"
    } ]
  }, {
    "tStartMs": 487866,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "很多的女孩子"
    } ]
  }, {
    "tStartMs": 489700,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "会把Hello Kitty的挂件挂在自行车上"
    } ]
  }, {
    "tStartMs": 493800,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "哇"
    } ]
  }, {
    "tStartMs": 494333,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 495266,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "是一个新的流行"
    } ]
  }, {
    "tStartMs": 496966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "是一个新的潮流方式"
    } ]
  }, {
    "tStartMs": 499266,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "大家为什么会喜欢Hello Kitty呢"
    } ]
  }, {
    "tStartMs": 501866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "大家会说"
    } ]
  }, {
    "tStartMs": 502966,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "Hello Kitty它的形象其实是没有嘴的"
    } ]
  }, {
    "tStartMs": 506766,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "正是因为它没有嘴"
    } ]
  }, {
    "tStartMs": 509100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "所以大家才会借助它的形象"
    } ]
  }, {
    "tStartMs": 512033,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "去自由诠释心情和想法"
    } ]
  }, {
    "tStartMs": 516000,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "同时呢"
    } ]
  }, {
    "tStartMs": 517300,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "中国人不太喜欢用"
    } ]
  }, {
    "tStartMs": 519266,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "自己的照片来作为头像"
    } ]
  }, {
    "tStartMs": 522933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "是因为在中国"
    } ]
  }, {
    "tStartMs": 524633,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "社交媒体它承担着一个工作职能"
    } ]
  }, {
    "tStartMs": 528866,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "因为你工作上面也需要"
    } ]
  }, {
    "tStartMs": 530866,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "用这些即时通讯工具来联系"
    } ]
  }, {
    "tStartMs": 534033,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那在设置头像的时候呢"
    } ]
  }, {
    "tStartMs": 536500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "用自己的私人照片作为头像"
    } ]
  }, {
    "tStartMs": 539500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "可能就会显得。。。"
    } ]
  }, {
    "tStartMs": 541700,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "可能呢"
    } ]
  }, {
    "tStartMs": 542900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "有的时候大家也不希望"
    } ]
  }, {
    "tStartMs": 544666,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "被别人过多的关注到吧"
    } ]
  }, {
    "tStartMs": 547466,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "用自己的照片呢"
    } ]
  }, {
    "tStartMs": 548766,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "又不能够准确的传达自己最近的状态"
    } ]
  }, {
    "tStartMs": 553533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "给大家分享几个"
    } ]
  }, {
    "tStartMs": 555033,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "网友制作的hello Kitty的meme图"
    } ]
  }, {
    "tStartMs": 558366,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "首先第一张是这个"
    } ]
  }, {
    "tStartMs": 560400,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "花开富贵"
    } ]
  }, {
    "tStartMs": 562433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "大家也可以看到这张图里面"
    } ]
  }, {
    "tStartMs": 564733,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "Hello Kitty作为一个普通工作人员的形象"
    } ]
  }, {
    "tStartMs": 569200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "出现在办公室里面"
    } ]
  }, {
    "tStartMs": 571433,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "然后周围点缀着一圈的花朵"
    } ]
  }, {
    "tStartMs": 575700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "花开富贵"
    } ]
  }, {
    "tStartMs": 577100,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "这在中国是一句吉祥语"
    } ]
  }, {
    "tStartMs": 580766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "同样呢"
    } ]
  }, {
    "tStartMs": 581700,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "也是一个吉祥图案"
    } ]
  }, {
    "tStartMs": 584033,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "以繁花盛开象征着富贵"
    } ]
  }, {
    "tStartMs": 587300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "然后第二张图大家可以看到"
    } ]
  }, {
    "tStartMs": 589766,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "Hello Kitty还是作为一个"
    } ]
  }, {
    "tStartMs": 592233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "工作者出现在这个图片里面的"
    } ]
  }, {
    "tStartMs": 596033,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "然后Kitty在用着一台电脑"
    } ]
  }, {
    "tStartMs": 600633,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 601200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "它在工作"
    } ]
  }, {
    "tStartMs": 602600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "然后有四个中文字"
    } ]
  }, {
    "tStartMs": 605066,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "与世无争"
    } ]
  }, {
    "tStartMs": 607000,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 608666,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "与世无争"
    } ]
  }, {
    "tStartMs": 610133,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 610566,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "这个就是中国人典型的那种"
    } ]
  }, {
    "tStartMs": 613766,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "「既要又要还要」的心态"
    } ]
  }, {
    "tStartMs": 615933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我既要努力工作"
    } ]
  }, {
    "tStartMs": 617966,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "但是呢"
    } ]
  }, {
    "tStartMs": 618833,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "我又不能够显示出我努力的太多"
    } ]
  }, {
    "tStartMs": 622800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "我们要淡泊名利"
    } ]
  }, {
    "tStartMs": 624766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "要与世无争"
    } ]
  }, {
    "tStartMs": 626733,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "可以把这种图呢"
    } ]
  }, {
    "tStartMs": 628133,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "作为一个MEME"
    } ]
  }, {
    "tStartMs": 629500,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "作为一个表情包"
    } ]
  }, {
    "tStartMs": 630966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "在日常的交流里面使用"
    } ]
  }, {
    "tStartMs": 633566,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "同时呢"
    } ]
  }, {
    "tStartMs": 634133,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "有一些人也会把它直接作为头像"
    } ]
  }, {
    "tStartMs": 637366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "第三张图呢"
    } ]
  }, {
    "tStartMs": 638366,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "其实和前面一张的背景是一样的"
    } ]
  }, {
    "tStartMs": 641466,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "但是字已经换了啊"
    } ]
  }, {
    "tStartMs": 643300,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "然后这个周围一圈的花的图案也换了"
    } ]
  }, {
    "tStartMs": 647466,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "它叫「好运莲莲」"
    } ]
  }, {
    "tStartMs": 650266,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "中国文化里面特别喜欢用谐音"
    } ]
  }, {
    "tStartMs": 653733,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "「好运连连」是一个成语"
    } ]
  }, {
    "tStartMs": 656500,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "但是大家可以看到这个图片里面呢"
    } ]
  }, {
    "tStartMs": 659400,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "把「连」换成了莲花的「莲」"
    } ]
  }, {
    "tStartMs": 662500,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "这是一个谐音梗"
    } ]
  }, {
    "tStartMs": 664166,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 664866,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "大家可以看到这张图里面"
    } ]
  }, {
    "tStartMs": 667500,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "它周围围着的就不是牡丹花"
    } ]
  }, {
    "tStartMs": 671200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "不是一些富贵花的图案"
    } ]
  }, {
    "tStartMs": 673600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "而是莲花"
    } ]
  }, {
    "tStartMs": 675333,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "然后这张图片"
    } ]
  }, {
    "tStartMs": 677366,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "这是一只Kitty手中握着一种植物"
    } ]
  }, {
    "tStartMs": 683133,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "这个头像呢"
    } ]
  }, {
    "tStartMs": 684033,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "在中国的社交媒体上也同样很火"
    } ]
  }, {
    "tStartMs": 687433,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "就很多人会下载下来"
    } ]
  }, {
    "tStartMs": 689166,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "然后把它作为自己的社交媒体头像"
    } ]
  }, {
    "tStartMs": 694033,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "这个hello Kitty手中拿着的植物叫菖蒲"
    } ]
  }, {
    "tStartMs": 698433,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "菖蒲一般是在清明节的时候使用的"
    } ]
  }, {
    "tStartMs": 702133,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "听说菖蒲挂在门口可以驱邪"
    } ]
  }, {
    "tStartMs": 706100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "可以辟邪"
    } ]
  }, {
    "tStartMs": 707633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "传统文化里面会说用菖蒲"
    } ]
  }, {
    "tStartMs": 710100,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "然后沾水到处洒一洒"
    } ]
  }, {
    "tStartMs": 713100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "可以赶走小人"
    } ]
  }, {
    "tStartMs": 714933,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "赶走霉运"
    } ]
  }, {
    "tStartMs": 716266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 717066,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 717833,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "这是这样一个形象"
    } ]
  }, {
    "tStartMs": 719366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "最后最后是特别火的"
    } ]
  }, {
    "tStartMs": 722066,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "大家可以看到这只hello Kitty"
    } ]
  }, {
    "tStartMs": 723733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "躺在浴缸里面"
    } ]
  }, {
    "tStartMs": 725733,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "是作为一个富婆的形象出现的"
    } ]
  }, {
    "tStartMs": 728966,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "它的浴缸里面不是水"
    } ]
  }, {
    "tStartMs": 730700,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "而是铺满了金币"
    } ]
  }, {
    "tStartMs": 732966,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "哈哈"
    } ]
  }, {
    "tStartMs": 733666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "这个就象征着什么呢"
    } ]
  }, {
    "tStartMs": 735300,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "象征着这只富贵的hello Kitty啊"
    } ]
  }, {
    "tStartMs": 737866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "到处都是钱"
    } ]
  }, {
    "tStartMs": 739333,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "充满着金钱"
    } ]
  }, {
    "tStartMs": 741100,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "所以大家为什么不喜欢"
    } ]
  }, {
    "tStartMs": 742666,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "用自己的照片来作为头像呢"
    } ]
  }, {
    "tStartMs": 745633,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "不能够传达这么多的感想"
    } ]
  }, {
    "tStartMs": 748700,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "不能够传达这么多的心情呀"
    } ]
  }, {
    "tStartMs": 751666,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "如果换成这种特别可爱的卡通形象"
    } ]
  }, {
    "tStartMs": 755433,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "配上这种各种形式的背景"
    } ]
  }, {
    "tStartMs": 758733,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "然后呢"
    } ]
  }, {
    "tStartMs": 759366,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "就可以准确的传达出最近的心情"
    } ]
  }, {
    "tStartMs": 763300,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "比如说我最近在职场上面"
    } ]
  }, {
    "tStartMs": 765733,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我受到了不公正的待遇"
    } ]
  }, {
    "tStartMs": 768066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我就觉得我碰到了小人了"
    } ]
  }, {
    "tStartMs": 770700,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "赶紧换上这张图片"
    } ]
  }, {
    "tStartMs": 772933,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "我要驱邪"
    } ]
  }, {
    "tStartMs": 773966,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "我要赶小人"
    } ]
  }, {
    "tStartMs": 775400,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 775933,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "如果换上这张富婆的hello Kitty头像"
    } ]
  }, {
    "tStartMs": 778700,
    "dDurationMs": 266,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 778966,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "那就代表着「我想要赚钱」"
    } ]
  }, {
    "tStartMs": 781300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "「搞钱」最重要呀"
    } ]
  }, {
    "tStartMs": 783033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "哈哈"
    } ]
  }, {
    "tStartMs": 783833,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "「搞钱」最重要！ "
    } ]
  }, {
    "tStartMs": 785466,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "有的时候呢"
    } ]
  }, {
    "tStartMs": 786766,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "又和另外一个比较火的话题相关"
    } ]
  }, {
    "tStartMs": 790500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "那就是「玄学」"
    } ]
  }, {
    "tStartMs": 794100,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "我也不知道这个说法是从哪里来的"
    } ]
  }, {
    "tStartMs": 797733,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "就是换头像可以改变最近的运气"
    } ]
  }, {
    "tStartMs": 804333,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我表示无法理解"
    } ]
  }, {
    "tStartMs": 806500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "比如说一些玄学博主会说"
    } ]
  }, {
    "tStartMs": 808966,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "1995年7月出生的"
    } ]
  }, {
    "tStartMs": 811966,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "最近呢"
    } ]
  }, {
    "tStartMs": 812466,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "需要换上一个绿色的头像"
    } ]
  }, {
    "tStartMs": 814833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "那大家选来选去"
    } ]
  }, {
    "tStartMs": 816200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "那换一个绿色的头像"
    } ]
  }, {
    "tStartMs": 817866,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "哎"
    } ]
  }, {
    "tStartMs": 818166,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "正好最近呢"
    } ]
  }, {
    "tStartMs": 819833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "有在职场上面碰到了一些不开心"
    } ]
  }, {
    "tStartMs": 822666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "那我就换上这张"
    } ]
  }, {
    "tStartMs": 824133,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Hello Kitty手拿菖蒲的头像"
    } ]
  }, {
    "tStartMs": 827800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "听说可以避小人"
    } ]
  }, {
    "tStartMs": 829833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "听说可以转运"
    } ]
  }, {
    "tStartMs": 831700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "在中国"
    } ]
  }, {
    "tStartMs": 832900,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "如果说最近你特别特别想要谈恋爱"
    } ]
  }, {
    "tStartMs": 836333,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "你就要通过一些方式来「招引桃花」"
    } ]
  }, {
    "tStartMs": 841133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "「招桃花」"
    } ]
  }, {
    "tStartMs": 842633,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "那招桃花在玄学领域"
    } ]
  }, {
    "tStartMs": 845333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "最常见最常见的一个做法就是"
    } ]
  }, {
    "tStartMs": 848100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "穿粉红色(的衣服）"
    } ]
  }, {
    "tStartMs": 849866,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "佩戴粉红色的水晶"
    } ]
  }, {
    "tStartMs": 852433,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "粉水晶特别招桃花"
    } ]
  }, {
    "tStartMs": 854566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "还有就是给自己的头像"
    } ]
  }, {
    "tStartMs": 856566,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "换成这种粉粉嫩嫩的"
    } ]
  }, {
    "tStartMs": 859000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "花开富贵"
    } ]
  }, {
    "tStartMs": 860600,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "好运连连的头像"
    } ]
  }, {
    "tStartMs": 864333,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 865600,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "就让我觉得特别有意思"
    } ]
  }, {
    "tStartMs": 867533,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "就很神奇"
    } ]
  }, {
    "tStartMs": 868833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "换头像这件事情"
    } ]
  }, {
    "tStartMs": 870200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "又让我想起来我们家"
    } ]
  }, {
    "tStartMs": 872033,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "之前就是发生的一件事情"
    } ]
  }, {
    "tStartMs": 874033,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我妈有一段时间特别"
    } ]
  }, {
    "tStartMs": 875966,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "沉迷于玄学这个话题"
    } ]
  }, {
    "tStartMs": 878166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "然后"
    } ]
  }, {
    "tStartMs": 879366,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "又因为抖音快手各种社交媒体的轰炸"
    } ]
  }, {
    "tStartMs": 883333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "她有一段时间就迷信这种东西"
    } ]
  }, {
    "tStartMs": 886633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "然后有某位大师吧"
    } ]
  }, {
    "tStartMs": 889033,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "可能就是在他的视频里面有提到过"
    } ]
  }, {
    "tStartMs": 892566,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "说现在的女孩子都喜欢把"
    } ]
  }, {
    "tStartMs": 894900,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "把自己养的宠物来作为头像"
    } ]
  }, {
    "tStartMs": 898133,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "这个其实呢"
    } ]
  }, {
    "tStartMs": 899100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "是破坏「运」的一种行为"
    } ]
  }, {
    "tStartMs": 902100,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "不太好"
    } ]
  }, {
    "tStartMs": 903633,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "我之前特别喜欢用我们家猫作为头像"
    } ]
  }, {
    "tStartMs": 907433,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "然后我妈就因为听信了这些大师的说法"
    } ]
  }, {
    "tStartMs": 911966,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "每次和我用了微信聊天之后"
    } ]
  }, {
    "tStartMs": 915200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "就会再加一句："
    } ]
  }, {
    "tStartMs": 917133,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "“你赶紧把你那个头像换了！”"
    } ]
  }, {
    "tStartMs": 919566,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "“不好！”之类的"
    } ]
  }, {
    "tStartMs": 921300,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我跟她争吵了很多回"
    } ]
  }, {
    "tStartMs": 922700,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "但是她就是会一遍一遍地说"
    } ]
  }, {
    "tStartMs": 925266,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那就很神奇"
    } ]
  }, {
    "tStartMs": 926466,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "对吧"
    } ]
  }, {
    "tStartMs": 927233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "每个说法又不一样"
    } ]
  }, {
    "tStartMs": 928933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我不能够放自己的猫"
    } ]
  }, {
    "tStartMs": 930733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但是放Hello Kitty又可以招桃花"
    } ]
  }, {
    "tStartMs": 933333,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "又可以赶小人"
    } ]
  }, {
    "tStartMs": 934666,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "这是什么说法呢"
    } ]
  }, {
    "tStartMs": 936033,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我就会觉得很神奇"
    } ]
  }, {
    "tStartMs": 937633,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这个牛头不对马嘴的说法"
    } ]
  }, {
    "tStartMs": 939700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "对吗"
    } ]
  }, {
    "tStartMs": 940800,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "其实大家也可以看到这些图片呢"
    } ]
  }, {
    "tStartMs": 944133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "有一点点摆烂"
    } ]
  }, {
    "tStartMs": 945866,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "有一点点叛逆"
    } ]
  }, {
    "tStartMs": 947466,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "它和原始的那种很可爱的"
    } ]
  }, {
    "tStartMs": 949633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "只是一个很简单的卡通形象呢"
    } ]
  }, {
    "tStartMs": 952100,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "已经不一样了"
    } ]
  }, {
    "tStartMs": 953933,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "再包括"
    } ]
  }, {
    "tStartMs": 955233,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "其实在hello Kitty原著里面"
    } ]
  }, {
    "tStartMs": 958066,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "hello Kitty会经常语不惊人死不休"
    } ]
  }, {
    "tStartMs": 961600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "它会经常带着这种毒舌"
    } ]
  }, {
    "tStartMs": 964033,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "会莫名其妙的说出来"
    } ]
  }, {
    "tStartMs": 966233,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 966533,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "“你们都是神经病！”"
    } ]
  }, {
    "tStartMs": 968066,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "这种很可爱的毒舌语录"
    } ]
  }, {
    "tStartMs": 970800,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "再加上这些"
    } ]
  }, {
    "tStartMs": 973333,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "有些摆烂"
    } ]
  }, {
    "tStartMs": 974733,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "有一点发疯"
    } ]
  }, {
    "tStartMs": 976200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "甚至带着反骨的二次创作"
    } ]
  }, {
    "tStartMs": 979400,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "所以我觉得这也是为什么"
    } ]
  }, {
    "tStartMs": 981566,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "Hello Kitty现在在年轻人里面"
    } ]
  }, {
    "tStartMs": 984333,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "可以再次火爆的一个原因"
    } ]
  }, {
    "tStartMs": 987933,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "当然"
    } ]
  }, {
    "tStartMs": 988400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我觉得大家也不是真的迷信这些头像"
    } ]
  }, {
    "tStartMs": 991633,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "觉得可以通过换头像这件事情"
    } ]
  }, {
    "tStartMs": 994666,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "就能够改变我们当下的命运"
    } ]
  }, {
    "tStartMs": 997600,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "可能也只是"
    } ]
  }, {
    "tStartMs": 999066,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "在不那么重要的东西上面寄托一点点的希望"
    } ]
  }, {
    "tStartMs": 1003933,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "这是一个最低成本的转运仪式而已"
    } ]
  }, {
    "tStartMs": 1008500,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "当我们没有力气改变现状的时候"
    } ]
  }, {
    "tStartMs": 1011533,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "至少我还能够决定今天会用"
    } ]
  }, {
    "tStartMs": 1014233,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "一个什么样的头像来面对现实的困难"
    } ]
  }, {
    "tStartMs": 1018600,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "不确定性"
    } ]
  }, {
    "tStartMs": 1020066,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "偶尔呢"
    } ]
  }, {
    "tStartMs": 1020700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "我也会看给我留言的"
    } ]
  }, {
    "tStartMs": 1023233,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "这些朋友们的头像"
    } ]
  }, {
    "tStartMs": 1025066,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "我发现很多人并没有修改他们的头像"
    } ]
  }, {
    "tStartMs": 1027933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "只是用了一个默认的"
    } ]
  }, {
    "tStartMs": 1030866,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "名字生成的一个头像"
    } ]
  }, {
    "tStartMs": 1033666,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "大家对于头像会有什么样的看法呢"
    } ]
  }, {
    "tStartMs": 1037300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "你们日常会选择一些玄学的方式"
    } ]
  }, {
    "tStartMs": 1040866,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "帮助自己改一点点运气吗"
    } ]
  }, {
    "tStartMs": 1044300,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "还是说你们更愿意相信"
    } ]
  }, {
    "tStartMs": 1046533,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "脚踏实地"
    } ]
  }, {
    "tStartMs": 1047733,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "努力工作才能够改变自己的好运气呢"
    } ]
  }, {
    "tStartMs": 1052266,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "期待听见大家的回答"
    } ]
  }, {
    "tStartMs": 1055166,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "好啦"
    } ]
  }, {
    "tStartMs": 1055933,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "以上就是今天全部的内容"
    } ]
  }, {
    "tStartMs": 1058333,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "感谢大家的观看"
    } ]
  }, {
    "tStartMs": 1060033,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "感谢大家的陪伴"
    } ]
  }, {
    "tStartMs": 1061766,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "那我们就下期视频再见喽"
