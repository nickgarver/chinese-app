    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "duì yú wǒ lái shuō\nFor me"
    } ]
  }, {
    "tStartMs": 751766,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "rú guǒ wǒ yù dào le yí gè xīn de dān cí\nIf I come across a new word"
    } ]
  }, {
    "tStartMs": 756200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "wǒ bú rèn shi\nThat I don't know"
    } ]
  }, {
    "tStartMs": 758166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "wǒ huì jué de\nI'll think"
    } ]
  }, {
    "tStartMs": 759800,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "bǐ rú xià yí cì wǒ qù tīng dōng xī\nLike next time I listen to something"
    } ]
  }, {
    "tStartMs": 763433,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "wǒ huì yòu tīng dào le\nI'll hear it again"
    } ]
  }, {
    "tStartMs": 765033,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "huò zhě wǒ yòu\nOr I'll"
    } ]
  }, {
    "tStartMs": 766400,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "wǒ dú wén zhāng\nRead an article"
    } ]
  }, {
    "tStartMs": 769166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "wǒ yòu kàn dào le zhè ge dān cí\nAnd see that word again"
    } ]
  }, {
    "tStartMs": 771866,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "wǒ jué de\nI think"
    } ]
  }, {
    "tStartMs": 773800,
    "dDurationMs": 5399,
    "segs": [ {
      "utf8": "wǒ huì màn màn dì màn màn dì bǎ zhè ge dān cí xué huì\nI'll slowly, slowly learn that word"
    } ]
  }, {
    "tStartMs": 779400,
    "dDurationMs": 5733,
    "segs": [ {
      "utf8": "ér bú shì yòng hěn duō f l a s h   c a r d s qù jì dān cí\nInstead of using lots of flashcards to memorize words"
    } ]
  }, {
    "tStartMs": 785366,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "wǒ jué de wǒ bù xǐ huan bèi dān cí\nI think I don't like memorizing vocabulary"
    } ]
  }, {
    "tStartMs": 789400,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "wǒ xǐ huan tīng hěn duō cì\nI like hearing it many times"
    } ]
  }, {
    "tStartMs": 792400,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "kàn dào hěn duō cì zhè ge dān cí\nSeeing that word many times"
    } ]
  }, {
    "tStartMs": 795033,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "rán hòu jiù jì zhù le\nAnd then I remember it"
    } ]
  }, {
    "tStartMs": 797633,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "wǒ shì zhè yàng de\nThat's how I am"
    } ]
  }, {
    "tStartMs": 798966,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "dàn shì rú guǒ nǐ xǐ huan bèi dān cí\nBut if you like memorizing words"
    } ]
  }, {
    "tStartMs": 802166,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "nǐ jué de bèi dān cí hěn yǒu yòng\nAnd you find it useful"
    } ]
  }, {
    "tStartMs": 806233,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "nà wǒ jué de yě kě yǐ\nThen I think that's fine too"
    } ]
  }, {
    "tStartMs": 807633,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "yīn wèi měi gè rén de xí guàn bù yí yàng\nBecause everyone has different habits"
    } ]
  }, {
    "tStartMs": 811633,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "bǐ rú wǒ de lǎo gōng\nFor example, my husband"
    } ]
  }, {
    "tStartMs": 814033,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "tā zài xué yīng yǔ\nHe's learning English"
    } ]
  }, {
    "tStartMs": 815700,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "tā hěn xǐ huan bèi dān cí\nHe really likes memorizing words"
    } ]
  }, {
    "tStartMs": 817533,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "yīn wèi tā jué de\nBecause he thinks"
    } ]
  }, {
    "tStartMs": 820500,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "tā de cí huì liáng hěn shǎo\nHis vocabulary is very small"
    } ]
  }, {
    "tStartMs": 823666,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "tā rèn shi de dān cí hěn shǎo\nHe knows very few words"
    } ]
  }, {
    "tStartMs": 826400,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "suǒ yǐ tā xué yīng yǔ\nSo when he learns English"
    } ]
  }, {
    "tStartMs": 829166,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "jiù shì bèi hěn duō dān cí\nHe just memorizes a lot of words"
    } ]
  }, {
    "tStartMs": 832900,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "dàn shì wǒ xiǎng shuō de shì\nBut what I want to say is"
    } ]
  }, {
    "tStartMs": 836166,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "rú guǒ nǐ xiǎng liàn xí tīng lì\nIf you want to practice listening"
    } ]
  }, {
    "tStartMs": 840466,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "nà nǐ yào qù tīng\nThen you need to listen"
    } ]
  }, {
    "tStartMs": 843400,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "rú guǒ nǐ xiǎng liàn xí kǒu yǔ\nIf you want to practice speaking"
    } ]
  }, {
    "tStartMs": 846733,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "nà nǐ yào qù shuō\nThen you need to speak"
    } ]
  }, {
    "tStartMs": 848900,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "rú guǒ nǐ xiǎng rèn shi gèng duō de dān cí\nIf you want to learn more words"
    } ]
  }, {
    "tStartMs": 852766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "nà nǐ kě yǐ qù bèi dān cí\nThen you can memorize words"
    } ]
  }, {
    "tStartMs": 856900,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "dàn shì\nBut"
    } ]
  }, {
    "tStartMs": 859433,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "hěn zhòng yào de shì\nwhat's important is"
    } ]
  }, {
    "tStartMs": 861600,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "rú guǒ nǐ zhī bèi dān cí\nif you only memorize words"
    } ]
  }, {
    "tStartMs": 864000,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "nà nǐ de tīng lì bú huì hǎo\nyour listening won't improve"
    } ]
  }, {
    "tStartMs": 866400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "nǐ de kǒu yǔ yě bú huì hǎo\nand your speaking won't improve either"
    } ]
  }, {
    "tStartMs": 868833,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ jué de zhè ge hěn zhòng yào\nso I think this is really important"
    } ]
  }, {
    "tStartMs": 872300,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "nǐ xiǎng liàn xí shén me\nwhatever you want to practice"
    } ]
  }, {
    "tStartMs": 874366,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "nǐ jiù qù zuò shén me\njust go do that"
    } ]
  }, {
    "tStartMs": 876766,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "wǒ jué de shì zhè yàng de\nthat's what I believe"
    } ]
  }, {
    "tStartMs": 878833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "nǐ yǒu méi yǒu zhè yàng de qíng kuàng\nhave you ever had this situation"
    } ]
  }, {
    "tStartMs": 882833,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "jiù shì yǒu de shí hòu\nwhere sometimes"
    } ]
  }, {
    "tStartMs": 885400,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "nǐ bù xiǎng xué xí yǔ yán le\nyou don't feel like studying a language"
    } ]
  }, {
    "tStartMs": 889366,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "jīn tiān nǐ hěn lèi\ntoday you're really tired"
    } ]
  }, {
    "tStartMs": 890900,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "nǐ bù xiǎng xué xí le\nyou don't want to study"
    } ]
  }, {
    "tStartMs": 892700,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "huò zhě jīn tiān nǐ yǒu shì qíng\nor today you have things to do"
    } ]
  }, {
    "tStartMs": 895366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "nǐ méi bàn fǎ xué xí yǔ yán\nyou can't study the language"
    } ]
  }, {
    "tStartMs": 898633,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "nà nǐ huì zěn me bàn\nso what would you do"
    } ]
  }, {
    "tStartMs": 900866,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "huò zhě jīn tiān nǐ méi yǒu hěn duō shí jiān\nor today you don't have much time"
    } ]
  }, {
    "tStartMs": 904033,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "nà nǐ zěn me bàn\nthen what do you do"
    } ]
  }, {
    "tStartMs": 907566,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "yǐ qián\nbefore"
    } ]
  }, {
    "tStartMs": 909833,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "wǒ de huà wǒ jué de jiān chí hěn zhòng yào\nFor me, I think persistence is key"
    } ]
  }, {
    "tStartMs": 914566,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ huì jǐn liàng\nSo I'll try my best"
    } ]
  }, {
    "tStartMs": 917633,
    "dDurationMs": 5433,
    "segs": [ {
      "utf8": "wǒ huì jǐn liàng měi tiān dōu xué xí yí gè xiǎo shí\nI'll try to study for an hour every day"
    } ]
  }, {
    "tStartMs": 923066,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "měi tiān wǎn shàng dōu xué xí bàn gè xiǎo shí\nStudy for half an hour every night"
    } ]
  }, {
    "tStartMs": 927066,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "dàn shì yǒu de shí hòu hěn zhèng cháng\nBut sometimes it's normal"
    } ]
  }, {
    "tStartMs": 929600,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "wǒ men méi yǒu shí jiān\nWe don't have time"
    } ]
  }, {
    "tStartMs": 931866,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "wǒ men yǒu hěn duō shì qíng yào qù zuò\nWe have lots of things to do"
    } ]
  }, {
    "tStartMs": 935100,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "suǒ yǐ zhī qián\nSo before"
    } ]
  }, {
    "tStartMs": 937600,
    "dDurationMs": 2299,
    "segs": [ {
      "utf8": "yǐ qián de shí hòu wǒ huì hěn shēng qì\nIn the past, I'd get upset"
    } ]
  }, {
    "tStartMs": 939900,
    "dDurationMs": 4999,
    "segs": [ {
      "utf8": "wǒ jué de   āi yā wǒ jīn tiān méi yǒu xué xí\nI'd think, oh, I didn't study today"
    } ]
  }, {
    "tStartMs": 945066,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "dàn shì xiàn zài wǒ jué de\nBut now I think"
    } ]
  }, {
    "tStartMs": 947866,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "rú guǒ jīn tiān bù xiǎng xué xí le\nIf I don't feel like studying today"
    } ]
  }, {
    "tStartMs": 951600,
    "dDurationMs": 2599,
    "segs": [ {
      "utf8": "wǒ men kě yǐ bǐ rú kàn gè diàn yǐng\nWe can, for example, watch a movie"
    } ]
  }, {
    "tStartMs": 954233,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "kàn gè xī bān yá yǔ de diàn yǐng\nWatch a movie in Spanish"
    } ]
  }, {
    "tStartMs": 956466,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "huò zhě wǒ zuò gè yú jiā\nOr I do some yoga"
    } ]
  }, {
    "tStartMs": 958700,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "wǒ yòng xī bān yá yǔ de shì pín zuò yú jiā\nI do yoga with Spanish videos"
    } ]
  }, {
    "tStartMs": 962000,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "huò zhě wǒ tīng yì shǒu gē\nOr I listen to a song"
    } ]
  }, {
    "tStartMs": 963866,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "wǒ tīng yì shǒu xī bān yá yǔ de gē\nI listen to a Spanish song"
    } ]
  }, {
    "tStartMs": 966400,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "nà wǒ yě zài xué xí\nThen I'm still learning"
    } ]
  }, {
    "tStartMs": 968300,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "duì ba\nRight?"
    } ]
  }, {
    "tStartMs": 970066,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "huò zhě\nOr"
    } ]
  }, {
    "tStartMs": 971500,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "rú guǒ wǒ zhǐ yǒu 5 fēn zhōng\nif I only have 5 minutes"
    } ]
  }, {
    "tStartMs": 973600,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "1 0 fēn zhōng\nor 10 minutes"
    } ]
  }, {
    "tStartMs": 974566,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "nà wǒ yě kě yǐ\nthen I can also"
    } ]
  }, {
    "tStartMs": 977000,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "kàn yí xià yǐ qián xué guò de dān cí\nreview words I've learned before"
    } ]
  }, {
    "tStartMs": 980500,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "yě kě yǐ yě shì zài xué xí\nthat's still learning"
    } ]
  }, {
    "tStartMs": 983300,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ xiǎng shuō de shì\nso what I'm trying to say is"
    } ]
  }, {
    "tStartMs": 988166,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "wǒ men huì jǐn liàng měi tiān dōu xué xí yì diǎn yǔ yán\nwe'll try to learn a bit of the language every day"
    } ]
  }, {
    "tStartMs": 992966,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "dàn shì\nbut"
    } ]
  }, {
    "tStartMs": 993766,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "rú guǒ wǒ men zuò bú dào měi tiān dōu zhè yàng qù xué xí\nif we can't manage to study like that every day"
    } ]
  }, {
    "tStartMs": 998166,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "nà yě méi yǒu tài dà de guān xì\nit's not a big deal"
    } ]
  }, {
    "tStartMs": 1002433,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "zhè jù huà shì duì wǒ zì jǐ shuō de\nthis is something I tell myself"
    } ]
  }, {
    "tStartMs": 1005066,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "wǒ bù zhī dào nǐ shì shén me qíng kuàng\nI don't know what your situation is"
    } ]
  }, {
    "tStartMs": 1008200,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "rán hòu nǐ yǒu méi yǒu xué guò qí tā de wài yǔ\nand have you learned any other foreign languages"
    } ]
  }, {
    "tStartMs": 1012700,
    "dDurationMs": 3999,
    "segs": [ {
      "utf8": "hàn yǔ yǐ wài de wài yǔ\nbesides Chinese"
    } ]
  }, {
    "tStartMs": 1017433,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "nǐ de xué xí xí guàn yí yàng ma\nare your study habits the same"
    } ]
  }, {
    "tStartMs": 1020933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "bǐ rú wǒ de huà\nfor example, for me"
    } ]
  }, {
    "tStartMs": 1023933,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "bù yí yàng\nit's different"
    } ]
  }, {
    "tStartMs": 1025000,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "wǒ yǐ qián zài xué xiào xué de yīng yǔ\nI learned English in school before"
    } ]
  }, {
    "tStartMs": 1028633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "zài zhōng guó xué de yīng yǔ\nEnglish learned in China"
    } ]
  }, {
    "tStartMs": 1030733,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "wǒ shàng xué de shí hòu\nWhen I was in school"
    } ]
  }, {
    "tStartMs": 1032733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "wǒ men zhī xué yǔ fǎ\nWe only learned grammar"
    } ]
  }, {
    "tStartMs": 1035100,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "zhī kǎo shì zuò liàn xí\nOnly took exams and did exercises"
    } ]
  }, {
    "tStartMs": 1038500,
    "dDurationMs": 2499,
    "segs": [ {
      "utf8": "dàn shì wǒ cóng lái méi yǒu\nBut I never"
    } ]
  }, {
    "tStartMs": 1041000,
    "dDurationMs": 3899,
    "segs": [ {
      "utf8": "wǒ hěn shǎo liàn xí tīng lì huò zhě liàn xí kǒu yǔ\nI rarely practiced listening or speaking"
    } ]
  }, {
    "tStartMs": 1045266,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "rán hòu hòu lái xué xí fǎ yǔ de shí hòu\nThen later when I learned French"
    } ]
  }, {
    "tStartMs": 1048866,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "wǒ yě shì zài xué xiào xué xí de fǎ yǔ\nI also learned French at school"
    } ]
  }, {
    "tStartMs": 1053066,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "rán hòu dāng shí wǒ men yǒu wài jiào\nAnd back then we had foreign teachers"
    } ]
  }, {
    "tStartMs": 1055700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "yǒu fǎ guó de lǎo shī\nTeachers from France"
    } ]
  }, {
    "tStartMs": 1057433,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "suǒ yǐ tīng lì hé kǒu yǔ liàn xí dé duō yì diǎn\nSo we practiced listening and speaking more"
    } ]
  }, {
    "tStartMs": 1063866,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "dàn shì xiàn zài xué xí xī bān yá yǔ hé rì yǔ\nBut now learning Spanish and Japanese"
    } ]
  }, {
    "tStartMs": 1068266,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "shì wǒ zì jǐ xué de\nI'm learning them on my own"
    } ]
  }, {
    "tStartMs": 1070933,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "wǒ zì xué de zhè liǎng mén yǔ yán\nI self-studied both languages"
    } ]
  }, {
    "tStartMs": 1074633,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "suǒ yǐ hěn bù yí yàng\nSo it's very different"
    } ]
  }, {
    "tStartMs": 1077066,
    "dDurationMs": 5667,
    "segs": [ {
      "utf8": "wǒ jué de wǒ huā le hěn duō shí jiān lái liàn xí tīng lì\nI think I spent a lot of time practicing listening"
    } ]
  }, {
    "tStartMs": 1082733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "kàn le hěn duō shì pín\nWatched many videos"
    } ]
  }, {
    "tStartMs": 1085066,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "tīng le hěn duō bō kè\nListened to many podcasts"
    } ]
  }, {
    "tStartMs": 1089266,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "yóu qí shì rì yǔ\nEspecially Japanese"
    } ]
  }, {
    "tStartMs": 1090900,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "yīn wèi wǒ yǐ qián méi yǒu xué guò rì yǔ\nBecause I had never learned Japanese before"
    } ]
  }, {
    "tStartMs": 1095533,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "suǒ yǐ xué xí de xí guàn wán quán bù yí yàng\nSo the learning habits are completely different"
    } ]
  }, {
    "tStartMs": 1101200,
    "dDurationMs": 999,
    "segs": [ {
      "utf8": "nà nǐ ne\nWhat about you"
    } ]
  }, {
    "tStartMs": 1102200,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "nǐ xiàn zài xué xí zhōng wén\nYou're learning Chinese now"
    } ]
  }, {
    "tStartMs": 1104633,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "nǐ yǒu shén me xué xí zhōng wén de xí guàn\nWhat habits do you have for learning Chinese"
    } ]
  }, {
    "tStartMs": 1108333,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "nǐ shén me shí hòu xué xí\nWhen do you study"
    } ]
  }, {
    "tStartMs": 1110233,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "nǐ měi zhōu xué xí jǐ cì\nHow many times a week do you study"
    } ]
  }, {
    "tStartMs": 1113200,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "nǐ měi cì xué xí shén me\nWhat do you study each time"
    } ]
  }, {
    "tStartMs": 1116433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "nǐ yǒu méi yǒu bù xiǎng xué xí de shí hòu\nDo you ever not want to study"
    } ]
  }, {
    "tStartMs": 1119833,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "nà nǐ zuò shén me\nWhat do you do then"
    } ]
  }, {
    "tStartMs": 1122300,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "xī wàng nǐ kě yǐ fēn xiǎng gěi dà jiā\nI hope you can share with everyone"
    } ]
  }, {
    "tStartMs": 1125733,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "rán hòu zài píng lùn qū lǐ gào sù wǒ\nThen tell me in the comments"
    } ]
  }, {
    "tStartMs": 1129800,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "nà jīn tiān de shì pín jiù dào zhè lǐ\nThat's it for today's video"
