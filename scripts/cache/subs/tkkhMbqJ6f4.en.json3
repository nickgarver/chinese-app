  }, {
    "tStartMs": 281000,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "1 5 fēn zhōng huò zhě 2 0 fēn zhōng huò zhě bàn gè xiǎo shí\n15 minutes or 20 minutes or half an hour"
