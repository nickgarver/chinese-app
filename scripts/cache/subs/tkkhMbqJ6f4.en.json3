  "events": [ {
    "tStartMs": 666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "nǐ zài xué xí hàn yǔ\nYou're learning Chinese"
    } ]
  }, {
    "tStartMs": 3433,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "wǒ zài xué xí xī bān yá yǔ hé rì yǔ\nI'm learning Spanish and Japanese"
    } ]
  }, {
    "tStartMs": 8800,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "kě néng shì wèi le gōng zuò\nMaybe for work"
    } ]
  }, {
    "tStartMs": 11666,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "wèi le xué xí\nFor study"
    } ]
  }, {
    "tStartMs": 13766,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "huò zhě shì wèi le zì jǐ de xìng qù ài hào\nOr just for a personal hobby"
    } ]
  }, {
    "tStartMs": 18633,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "wǒ men dōu zài xué xí yǔ yán\nWe're all learning languages"
    } ]
  }, {
    "tStartMs": 23400,
    "dDurationMs": 6999,
    "segs": [ {
      "utf8": "dàn shì xué hǎo yì mén yǔ yán yào huā hěn duō shí jiān\nBut mastering a language takes a lot of time"
    } ]
  }, {
    "tStartMs": 31000,
    "dDurationMs": 3699,
    "segs": [ {
      "utf8": "suǒ yǐ jiān chí hěn zhòng yào\nSo persistence is key"
    } ]
  }, {
    "tStartMs": 35300,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "yǒu yí gè hǎo de xué xí xí guàn hěn zhòng yào\nHaving good study habits matters"
    } ]
  }, {
    "tStartMs": 40900,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "dà jiā hǎo wǒ shì xiǎo nà\nHi everyone, I'm Xiaona"
    } ]
  }, {
    "tStartMs": 43900,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "jīn tiān wǒ men yào yì qǐ liáo yí xià\nToday we're going to talk about"
    } ]
  }, {
    "tStartMs": 47433,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "xué xí yǔ yán zhè jiàn shì qíng\nLearning languages"
    } ]
  }, {
    "tStartMs": 50300,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "xué xí yǔ yán de xí guàn\nLanguage learning habits"
    } ]
  }, {
    "tStartMs": 53600,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "wǒ de shǒu lǐ yǒu yí gè běn zi\nI have a notebook in my hand"
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "běn zi shàng yǒu yì xiē wèn tí\nThere are some questions in it"
    } ]
  }, {
    "tStartMs": 59766,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "wǒ huì wèn nǐ yì xiē wèn tí\nI'll ask you some questions"
    } ]
  }, {
    "tStartMs": 62900,
    "dDurationMs": 5066,
    "segs": [ {
      "utf8": "rán hòu wǒ huì huí dá yí xià zhè xiē wèn tí\nThen I'll answer them myself"
    } ]
  }, {
    "tStartMs": 68000,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "wǒ huì fēn xiǎng yí xià wǒ de jīng lì\nI'll share my experiences"
    } ]
  }, {
    "tStartMs": 73200,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "shǒu xiān dì yī gè wèn tí\nFirst, question one"
    } ]
  }, {
    "tStartMs": 76900,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "nǐ yì bān shén me shí hòu xué xí zhōng wén\nWhen do you usually study Chinese"
    } ]
  }, {
    "tStartMs": 81366,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "zǎo shàng   wǎn shàng\nMorning or evening"
    } ]
  }, {
    "tStartMs": 83900,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "hái shì shàng bān de lù shang\nOr on the way to work"
    } ]
  }, {
    "tStartMs": 87766,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "hái shì xià bān yǐ hòu\nOr after work"
    } ]
  }, {
    "tStartMs": 90400,
    "dDurationMs": 2999,
    "segs": [ {
      "utf8": "nǐ shén me shí hòu xué xí zhōng wén\nWhen do you study Chinese"
    } ]
  }, {
    "tStartMs": 94700,
    "dDurationMs": 3599,
    "segs": [ {
      "utf8": "wǒ de huà wǒ yì bān zǎo shàng\nFor me, I usually study in the morning"
    } ]
  }, {
    "tStartMs": 98433,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "hái yǒu wǎn shàng xué xí yǔ yán\nAnd in the evening I study languages"
    } ]
  }, {
    "tStartMs": 103233,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "yīn wèi wǒ hěn xǐ huan zǎo qǐ\nBecause I really like waking up early"
    } ]
  }, {
    "tStartMs": 107066,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "qǐ hěn zǎo bǐ rú 6 diǎn\nGetting up very early, like at 6"
    } ]
  }, {
    "tStartMs": 110066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "5 diǎn bàn děng děng\nOr 5:30, etc."
    } ]
  }, {
    "tStartMs": 112100,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "yīn wèi zǎo shàng de shí hòu\nBecause in the morning"
    } ]
  }, {
    "tStartMs": 114466,
    "dDurationMs": 6867,
    "segs": [ {
      "utf8": "wǒ de dà nǎo hěn qīng xǐng\nMy brain is very clear"
    } ]
  }, {
    "tStartMs": 121766,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "zǎo shàng de shí hòu wǒ xué yǔ yán hěn kuài\nIn the morning I learn languages fast"
    } ]
  }, {
    "tStartMs": 125833,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "ér qiě zǎo shàng méi yǒu rén dǎ rǎo\nAnd in the morning no one disturbs me"
    } ]
  }, {
    "tStartMs": 130700,
    "dDurationMs": 2999,
    "segs": [ {
      "utf8": "zǎo shàng de shí jiān shì wǒ zì jǐ de\nThe morning time is my own"
    } ]
  }, {
    "tStartMs": 133700,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ hěn xǐ huan zǎo shàng de shí hòu\nSo I really like the morning"
    } ]
  }, {
    "tStartMs": 138233,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "chū lái sàn bù huò zhě lái gōng yuán lǐ\nGoing out for a walk or to the park"
    } ]
  }, {
    "tStartMs": 142000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "rán hòu wǒ yì biān sàn bù\nThen I walk"
    } ]
  }, {
    "tStartMs": 145033,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "wǒ yì biān sàn bù\nI walk"
    } ]
  }, {
    "tStartMs": 147000,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "yì biān xué xí yǔ yán\nAnd study languages at the same time"
    } ]
  }, {
    "tStartMs": 150100,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "xué xí xī bān yá yǔ\nStudying Spanish"
    } ]
  }, {
    "tStartMs": 153300,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "rán hòu wǎn shàng de shí hòu\nAnd in the evening,"
    } ]
  }, {
    "tStartMs": 155500,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "bǐ rú shuì jiào yǐ qián\nlike before going to bed,"
    } ]
  }, {
    "tStartMs": 158766,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "wǒ yě hěn xǐ huan xué xí yǔ yán\nI also really enjoy learning languages."
    } ]
  }, {
    "tStartMs": 161866,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "yīn wèi shuì jiào yǐ qián\nBecause before bed,"
    } ]
  }, {
    "tStartMs": 164866,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "kàn shǒu jī bù hǎo\nlooking at your phone isn't good,"
    } ]
  }, {
    "tStartMs": 166500,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "duì ba\nright?"
    } ]
  }, {
    "tStartMs": 167466,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "suǒ yǐ shuì jiào yǐ qián wǒ xǐ huan kàn yí huì er shū\nSo before bed, I like to read for a bit,"
    } ]
  }, {
    "tStartMs": 172433,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "huò zhě xué xí rì yǔ\nor study Japanese."
    } ]
  }, {
    "tStartMs": 176200,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "zhè yàng kě yǐ bāng zhù wǒ shuì jiào\nThis helps me fall asleep,"
    } ]
  }, {
    "tStartMs": 181666,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "duì shuì mián yǒu hǎo chù\nand it's good for my sleep."
    } ]
  }, {
    "tStartMs": 184466,
    "dDurationMs": 5467,
    "segs": [ {
      "utf8": "ér qiě wǒ jué de shuì jiào yǐ qián xué xí yǔ yán\nAlso, I feel that learning a language before bed"
    } ]
  }, {
    "tStartMs": 191000,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "huì xué dé hěn kuài\nhelps you learn faster."
    } ]
  }, {
    "tStartMs": 192966,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "hǎo xiàng nǐ shuì jiào de shí hòu yě zài xué xí\nIt's like you're still learning while you sleep."
    } ]
  }, {
    "tStartMs": 197566,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "bù zhī dào shì bu shì zhēn de\nI don't know if that's true,"
    } ]
  }, {
    "tStartMs": 200233,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "dàn shì wǒ jué de shì zhè yàng\nbut I think it is."
    } ]
  }, {
    "tStartMs": 204100,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ yì bān zǎo shàng xué xí xī bān yá yǔ\nSo I usually study Spanish in the morning,"
    } ]
  }, {
    "tStartMs": 208400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "wǎn shàng xué xí rì yǔ\nand Japanese at night."
    } ]
  }, {
    "tStartMs": 212900,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "nà xià yí gè wèn tí\nSo, next question:"
    } ]
  }, {
    "tStartMs": 217200,
    "dDurationMs": 5099,
    "segs": [ {
      "utf8": "nǐ měi tiān dōu xué xí zhōng wén ma\nDo you study Chinese every day,"
    } ]
  }, {
    "tStartMs": 222300,
    "dDurationMs": 5099,
    "segs": [ {
      "utf8": "huò zhě nǐ yì zhōu xué xí jǐ cì zhōng wén\nor how many times a week do you study it?"
    } ]
  }, {
    "tStartMs": 231000,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "wǒ de huà\nMy words"
    } ]
  }, {
    "tStartMs": 233100,
    "dDurationMs": 5799,
    "segs": [ {
      "utf8": "wǒ chà bù duō měi tiān dōu xué xí yǔ yán\nI study languages almost every day"
    } ]
  }, {
    "tStartMs": 239666,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chà bù duō měi tiān dōu xué xí\nAlmost every day I study"
    } ]
  }, {
    "tStartMs": 241900,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "zǎo shàng de shí hòu wǒ xué xí chà bù duō\nIn the morning I study for about"
    } ]
  }, {
    "tStartMs": 245900,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "yí gè xiǎo shí\nan hour"
    } ]
  }, {
