    "dDurationMs": 899,
    "segs": [ {
      "utf8": "bàn gè xiǎo shí\nhalf an hour"
    } ]
  }, {
    "tStartMs": 248500,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "huò zhě yí gè xiǎo shí zuǒ yòu de xī bān yá yǔ\nor about an hour of Spanish"
    } ]
  }, {
    "tStartMs": 253233,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "yīn wèi zǎo shàng wǒ yǒu hěn duō shí jiān\nBecause in the morning I have a lot of time"
    } ]
  }, {
    "tStartMs": 256633,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "dàn shì wǎn shàng de shí hòu\nBut in the evening"
    } ]
  }, {
    "tStartMs": 260000,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "wǒ de shí jiān hěn shǎo\nI have very little time"
    } ]
  }, {
    "tStartMs": 263233,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "wǎn shàng chī wán fàn yǐ hòu\nAfter dinner in the evening"
    } ]
  }, {
    "tStartMs": 267200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "rú guǒ wǒ chū qù sàn gè bù\nIf I go out for a walk"
    } ]
  }, {
    "tStartMs": 269866,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "rán hòu huí lái\nThen come back"
    } ]
  }, {
    "tStartMs": 272166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "rán hòu xǐ zǎo\nThen take a shower"
    } ]
  }, {
    "tStartMs": 274066,
    "dDurationMs": 1900,
    "segs": [ {
