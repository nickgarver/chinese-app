  }, {
    "tStartMs": 287466,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "dàn shì shí jiān bǐ jiào duǎn\nBut the time is quite short"
    } ]
  }, {
    "tStartMs": 291800,
