    "segs": [ {
      "utf8": "dàn shì wǒ jué de\nBut I think"
    } ]
  }, {
    "tStartMs": 293633,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "rú guǒ měi tiān xué xí yì diǎn\nIf you study a little every day"
    } ]
  }, {
    "tStartMs": 298600,
    "dDurationMs": 6766,
    "segs": [ {
      "utf8": "huì bǐ bǐ rú yī zhōu zhī xué xí yí cì\nIt's better than, say, studying only once a week"
    } ]
  }, {
    "tStartMs": 305600,
    "dDurationMs": 5933,
    "segs": [ {
      "utf8": "yí cì xué xí 2 gè xiǎo shí 3 gè xiǎo shí gèng hǎo\nStudying for 2 or 3 hours at a time"
    } ]
  }, {
    "tStartMs": 311833,
    "dDurationMs": 5933,
    "segs": [ {
      "utf8": "wǒ jué de měi tiān huā yì diǎn shí jiān xué xí yǔ yán gèng hǎo\nI think spending a little time on language every day is better"
    } ]
  }, {
    "tStartMs": 318166,
    "dDurationMs": 5933,
    "segs": [ {
      "utf8": "yīn wèi měi tiān nǐ dōu hé zhè mén yǔ yán jiē chù\nBecause every day you're in contact with the language"
    } ]
  }, {
    "tStartMs": 324466,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "nǐ dōu huì jiē chù zhè mén yǔ yán\nYou get exposed to the language"
    } ]
  }, {
    "tStartMs": 327800,
    "dDurationMs": 3699,
    "segs": [ {
      "utf8": "duì yǔ yán de xué xí gèng yǒu hǎo chù\nIt's more beneficial for language learning"
