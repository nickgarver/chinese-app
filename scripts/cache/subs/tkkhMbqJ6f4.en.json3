  }, {
    "tStartMs": 331866,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "rán hòu\nThen"
    } ]
  }, {
    "tStartMs": 333366,
    "dDurationMs": 4267,
    "segs": [ {
