    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "wǒ zài zì xué xī bān yá yǔ hé rì yǔ\nI'm self-studying Spanish and Japanese"
    } ]
  }, {
    "tStartMs": 353500,
