  }, {
    "tStartMs": 479966,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "我要想一想我要买什么"
    } ]
  }, {
    "tStartMs": 482633,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "嗯我要买什么"
