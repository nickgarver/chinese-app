  }, {
    "tStartMs": 471400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "比如我要买咖啡粉"
    } ]
  }, {
    "tStartMs": 473600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "然后你也可以说我在找咖啡粉"
    } ]
  }, {
    "tStartMs": 476933,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我在找或者呃"
