  }, {
    "tStartMs": 301666,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that I had \"heatiness\" (a concept in Traditional Chinese Medicine)."
    } ]
  }, {
    "tStartMs": 304666,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "\"Heatiness\" is actually"
    } ]
  }, {
    "tStartMs": 307000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "inflammation"
    } ]
  }, {
    "tStartMs": 308100,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "in the body. My manifestation"
    } ]
  }, {
    "tStartMs": 312833,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "was that my tongue had a problem, haha."
    } ]
  }, {
    "tStartMs": 315633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I think"
    } ]
  }, {
    "tStartMs": 317833,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "it's amazing that as a human being,"
    } ]
  }, {
    "tStartMs": 320766,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "your body changes every year."
    } ]
  }, {
    "tStartMs": 322400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "In the past, when I had \"heatiness,\""
    } ]
  }, {
    "tStartMs": 323800,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "I might have"
    } ]
  }, {
    "tStartMs": 325966,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "had mouth ulcers or other physical reactions"
    } ]
  }, {
    "tStartMs": 329733,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "on my tongue or inside my mouth."
    } ]
  }, {
