  }, {
    "tStartMs": 20066,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": ", don't miss it"
    } ]
  }, {
    "tStartMs": 24133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "! First of all,"
    } ]
  }, {
    "tStartMs": 27766,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "I want to say hello again"
    } ]
  }, {
    "tStartMs": 31533,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and wish everyone a Happy New Year"
    } ]
  }, {
    "tStartMs": 33333,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "and all the best."
    } ]
  }, {
    "tStartMs": 34766,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "This seems to be my second time making Spring Festival couplets! Making couplets!"
    } ]
  }, {
    "tStartMs": 39266,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "We Chinese people still celebrate the New Year twice."
    } ]
  }, {
    "tStartMs": 39966,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "I want to share with you what I"
    } ]
  }, {
    "tStartMs": 43900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "did"
    } ]
  }, {
    "tStartMs": 46633,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "during my absence."
    } ]
  }, {
    "tStartMs": 49466,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "First,"
    } ]
  }, {
    "tStartMs": 50766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "at the end of last year,"
    } ]
  }, {
    "tStartMs": 53000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I suddenly received a project."
    } ]
  }, {
    "tStartMs": 55100,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "This project"
    } ]
  }, {
    "tStartMs": 56066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "was quite urgent"
    } ]
  }, {
    "tStartMs": 57933,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "because it's almost the end of the year in China"
    } ]
  }, {
    "tStartMs": 61366,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": ", but overseas, right?"
    } ]
  }, {
    "tStartMs": 63633,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "So, during this period, I worked with my colleagues"
    } ]
  }, {
    "tStartMs": 68566,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "to finish this project"
    } ]
  }, {
    "tStartMs": 72133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "during the entire Spring Festival holiday."
    } ]
  }, {
    "tStartMs": 74333,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "The second thing"
    } ]
  }, {
    "tStartMs": 76000,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "is, I don't know why,"
    } ]
  }, {
    "tStartMs": 77500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "suddenly during the Spring Festival..."
    } ]
  }, {
    "tStartMs": 79133,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "I've received so many new students,"
    } ]
  }, {
    "tStartMs": 82166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "which is a bit of a shock,"
    } ]
  }, {
    "tStartMs": 84066,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "especially since they're all beginners."
    } ]
  }, {
    "tStartMs": 86300,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "To be honest, I didn't have much"
    } ]
  }, {
    "tStartMs": 89266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "experience teaching beginners before."
    } ]
  }, {
    "tStartMs": 91366,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "But after almost two months of"
    } ]
  }, {
    "tStartMs": 97033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "practice"
    } ]
  }, {
    "tStartMs": 98600,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "and"
    } ]
  }, {
    "tStartMs": 99666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "preparation,"
    } ]
  }, {
    "tStartMs": 100966,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "I feel like teaching beginners"
    } ]
  }, {
    "tStartMs": 102833,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "is now my comfort zone."
    } ]
  }, {
    "tStartMs": 104866,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I quite enjoy teaching beginners."
    } ]
  }, {
    "tStartMs": 107400,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "If any students"
    } ]
  }, {
    "tStartMs": 110033,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "want to start learning Chinese from scratch"
    } ]
  }, {
    "tStartMs": 112200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": ", you can contact me to sign up."
    } ]
  }, {
    "tStartMs": 114666,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "Oh, and I wanted to share something with you."
    } ]
  }, {
    "tStartMs": 116633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "When I first took on"
    } ]
  }, {
    "tStartMs": 118233,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "my beginner student,"
    } ]
  }, {
    "tStartMs": 120800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "we discussed"
    } ]
  }, {
    "tStartMs": 123133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "whether to use any textbooks."
    } ]
  }, {
    "tStartMs": 125100,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "But later,"
    } ]
  }, {
    "tStartMs": 126133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I decided to develop my own tutorial."
    } ]
  }, {
    "tStartMs": 129300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Now, all"
    } ]
  }, {
    "tStartMs": 131300,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "my students,"
    } ]
  }, {
    "tStartMs": 132766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "maybe seven or eight of them,"
    } ]
  }, {
    "tStartMs": 134533,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "are using this tutorial."
    } ]
  }, {
    "tStartMs": 138066,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "Haha,"
    } ]
  }, {
    "tStartMs": 140866,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "I really enjoy developing"
    } ]
  }, {
    "tStartMs": 142600,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "my own tutorial . I"
    } ]
  }, {
    "tStartMs": 144500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "think this tutorial is"
    } ]
  }, {
    "tStartMs": 146600,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "quite effective for some people, but"
    } ]
  }, {
    "tStartMs": 149133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "not so effective"
    } ]
  }, {
    "tStartMs": 150833,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "for others."
    } ]
  }, {
    "tStartMs": 152333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "So,"
    } ]
  }, {
    "tStartMs": 154233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "to some extent, I think this"
    } ]
  }, {
    "tStartMs": 156166,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "also reflects"
    } ]
  }, {
    "tStartMs": 157366,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "whether the student and teacher's personalities are compatible."
    } ]
  }, {
    "tStartMs": 159700,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "One-on-one tutoring"
    } ]
  }, {
    "tStartMs": 161100,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "also depends on compatibility"
    } ]
  }, {
    "tStartMs": 162933,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": ", just like dating."
    } ]
  }, {
    "tStartMs": 164433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "The teacher's speaking style matters."
    } ]
  }, {
    "tStartMs": 166966,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Is the teaching style suitable for you?"
    } ]
  }, {
    "tStartMs": 169700,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Is it"
    } ]
  }, {
    "tStartMs": 170900,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "a learning style that suits you?"
    } ]
  }, {
    "tStartMs": 174600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "I"
    } ]
  }, {
    "tStartMs": 175833,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "think that's"
    } ]
  }, {
    "tStartMs": 176766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "one of the reasons why various platforms"
    } ]
  }, {
    "tStartMs": 178500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "offer trial classes."
    } ]
  }, {
    "tStartMs": 181466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "But I hate that some platforms"
    } ]
  }, {
    "tStartMs": 182933,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "don't pay teachers for trial classes."
    } ]
  }, {
    "tStartMs": 185600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "The time and effort"
    } ]
  }, {
    "tStartMs": 188200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "teachers put into preparing these trial classes,"
    } ]
  }, {
    "tStartMs": 190866,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "in the end"
    } ]
  }, {
    "tStartMs": 191933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": ", they still have to endure"
    } ]
  }, {
    "tStartMs": 193600,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "students not continuing to subscribe to their courses"
    } ]
  }, {
    "tStartMs": 197600,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "after the trial class."
    } ]
  }, {
    "tStartMs": 199466,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "This has a big impact on our ranking."
    } ]
  }, {
    "tStartMs": 202366,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "I can't please everyone,"
    } ]
  }, {
    "tStartMs": 204733,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "right? Haha, right?"
    } ]
  }, {
    "tStartMs": 207100,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "And the choice is a two-way street."
    } ]
  }, {
    "tStartMs": 209700,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Even now,"
    } ]
  }, {
    "tStartMs": 210700,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "I have many students who"
    } ]
  }, {
    "tStartMs": 211966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "have tried the trial class and I've blocked them directly."
    } ]
  }, {
    "tStartMs": 214333,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "I don't want to teach such students."
    } ]
  }, {
    "tStartMs": 216766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "It's not that I hate the person"
    } ]
  }, {
    "tStartMs": 218800,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": ", but we are all adults."
    } ]
  }, {
    "tStartMs": 221266,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "In the process of communication, we"
    } ]
  }, {
    "tStartMs": 223100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "can probably tell if"
    } ]
  }, {
    "tStartMs": 224400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "our personalities are incompatible"
    } ]
  }, {
    "tStartMs": 226066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": ". And I'm not"
    } ]
  }, {
    "tStartMs": 227700,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "a professional teacher from a public school."
    } ]
  }, {
    "tStartMs": 230733,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "I have the right to choose. So,"
    } ]
  }, {
    "tStartMs": 233466,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "I don't know why,"
    } ]
  }, {
    "tStartMs": 235633,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "during the Chinese New Year,"
    } ]
  }, {
    "tStartMs": 238033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "I was busy with a project at home."
    } ]
  }, {
    "tStartMs": 239866,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "The project"
    } ]
  }, {
    "tStartMs": 240700,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "is like this."
    } ]
  }, {
    "tStartMs": 242866,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "It involves a lot of communication."
    } ]
  }, {
    "tStartMs": 245133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "The project I took on had a meeting every two or three days"
    } ]
  }, {
    "tStartMs": 247800,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "during the Chinese New Year."
    } ]
  }, {
    "tStartMs": 249933,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "So I spent 3 hours a day"
    } ]
  }, {
    "tStartMs": 251866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "working on the project content. The rest"
    } ]
  }, {
    "tStartMs": 254466,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "of the time,"
    } ]
  }, {
    "tStartMs": 255633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "I basically sit in front of the computer."
    } ]
  }, {
    "tStartMs": 258266,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "Also,"
    } ]
  }, {
    "tStartMs": 259600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "I'm a university teacher now,"
    } ]
  }, {
    "tStartMs": 262000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "right? My university"
    } ]
  }, {
    "tStartMs": 263833,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "has already started the semester, actually it's"
    } ]
  }, {
    "tStartMs": 266066,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "already in the middle of the semester."
    } ]
  }, {
    "tStartMs": 268266,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "I have to teach one class every week,"
    } ]
  }, {
    "tStartMs": 270633,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "and the rest of the time I"
    } ]
  }, {
    "tStartMs": 271933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "have to correct students' papers and assignments."
    } ]
  }, {
    "tStartMs": 275100,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "So I jokingly say that every day"
    } ]
  }, {
    "tStartMs": 278766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "I open my eyes, I'm correcting countless assignments, haha."
    } ]
  }, {
    "tStartMs": 281800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So the university work,"
    } ]
  }, {
    "tStartMs": 283300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "plus a rather urgent project I took on at the end of the year"
    } ]
  }, {
    "tStartMs": 287066,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": ", and then I inexplicably took on"
    } ]
  }, {
    "tStartMs": 290700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "seven or eight students with zero experience"
