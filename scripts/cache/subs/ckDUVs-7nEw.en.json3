  }, {
    "tStartMs": 292933,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": ", made"
    } ]
  }, {
    "tStartMs": 294866,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the past two months extremely busy."
    } ]
  }, {
    "tStartMs": 297200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "I was even so busy for two weeks"
