  }, {
    "tStartMs": 282233,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "现在我们坐电梯去第三层看一下"
    } ]
  }, {
    "tStartMs": 286900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "第三层有一些什么东西"
