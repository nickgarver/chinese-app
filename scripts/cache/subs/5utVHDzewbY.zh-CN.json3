  }, {
    "tStartMs": 462633,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "这是日本的吗"
    } ]
  }, {
    "tStartMs": 464933,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "这个应该是日本进口的"
    } ]
  }, {
    "tStartMs": 467266,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "这个椰子汁是一个很老的品牌"
    } ]
  }, {
    "tStartMs": 470233,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "不知道在国外有没有"
    } ]
  }, {
    "tStartMs": 473800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "它的包装有一点好玩"
    } ]
  }, {
    "tStartMs": 476100,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "有一点好笑"
    } ]
  }, {
    "tStartMs": 477400,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "这里全都是泡面"
    } ]
  }, {
    "tStartMs": 479266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "这个是韩国的拉面"
    } ]
  }, {
    "tStartMs": 482300,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "辛拉面"
    } ]
  }, {
    "tStartMs": 483233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "这边是中国的"
    } ]
  }, {
    "tStartMs": 484666,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "这是意大利面"
    } ]
  }, {
    "tStartMs": 486533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "也可以叫意面"
    } ]
  }, {
    "tStartMs": 488233,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "这是番茄肉酱意面"
    } ]
  }, {
    "tStartMs": 491666,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "奶油培根蘑菇意面"
    } ]
  }, {
    "tStartMs": 494733,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这样一袋意面是11块9"
    } ]
  }, {
    "tStartMs": 497533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "看一下没见过"
    } ]
  }, {
    "tStartMs": 508200,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 508500,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "是一种蔬菜"
    } ]
  }, {
    "tStartMs": 509133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "紫罗兰不是一个颜色吗"
    } ]
  }, {
    "tStartMs": 514200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "这一排是肉类"
    } ]
  }, {
    "tStartMs": 516100,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "有牛肉猪肉鸡肉"
    } ]
  }, {
    "tStartMs": 521233,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "甚至这里还有牛"
    } ]
  }, {
    "tStartMs": 523066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "然后告诉你每个部位"
    } ]
  }, {
    "tStartMs": 525166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "这里有很多小南瓜"
    } ]
  }, {
    "tStartMs": 527133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "还有白色的"
    } ]
  }, {
    "tStartMs": 528333,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "还挺漂亮"
    } ]
  }, {
    "tStartMs": 532133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "橙色绿色"
    } ]
  }, {
    "tStartMs": 534533,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "这里是海鲜区域"
    } ]
  }, {
    "tStartMs": 537266,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "哇好大的螃蟹"
    } ]
  }, {
    "tStartMs": 539233,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "这个叫帝王蟹"
    } ]
  }, {
    "tStartMs": 543266,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "有各种各样的海鲜"
    } ]
  }, {
    "tStartMs": 547900,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "这是什么"
    } ]
  }, {
    "tStartMs": 549166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "龙虾应该是"
    } ]
  }, {
    "tStartMs": 553166,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "这里有很多酸奶"
    } ]
  }, {
    "tStartMs": 555266,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这个我在云南吃过，干噎酸奶"
    } ]
  }, {
    "tStartMs": 558066,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "还挺特别的"
    } ]
  }, {
    "tStartMs": 559333,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "夹在水果里特别好吃"
    } ]
  }, {
    "tStartMs": 561466,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "这是蓝莓味的"
    } ]
  }, {
    "tStartMs": 563266,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "买一罐酸奶做燕麦碗"
    } ]
  }, {
    "tStartMs": 566566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "选一些卤菜"
    } ]
  }, {
    "tStartMs": 571266,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "哇这个好邪恶"
    } ]
  }, {
    "tStartMs": 572700,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "一个皮蛋"
    } ]
  }, {
    "tStartMs": 574066,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "我要一个皮蛋"
    } ]
  }, {
    "tStartMs": 578866,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "这是什么"
    } ]
  }, {
    "tStartMs": 581633,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "猪皮"
    } ]
  }, {
    "tStartMs": 583366,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "好吃吗"
    } ]
  }, {
    "tStartMs": 585033,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "可以试试"
    } ]
  }, {
    "tStartMs": 586366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "就像你吃鱼冻那种感觉"
    } ]
  }, {
    "tStartMs": 588166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "试一下"
    } ]
  }, {
    "tStartMs": 592966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "这个是腐竹"
    } ]
  }, {
    "tStartMs": 595466,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我现在来称一下"
    } ]
  }, {
    "tStartMs": 597666,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "让他帮我拌好"
    } ]
  }, {
    "tStartMs": 598933,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "然后再称"
    } ]
  }, {
    "tStartMs": 605366,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "你不吃葱吗"
    } ]
  }, {
    "tStartMs": 606866,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "葱，吃，只是一般能不放我就不放"
    } ]
  }, {
    "tStartMs": 609900,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 614700,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "现在我们排队买单"
    } ]
  }, {
    "tStartMs": 619166,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "这里是可以自助买单的"
    } ]
  }, {
    "tStartMs": 622666,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "这里有机器"
    } ]
  }, {
    "tStartMs": 624266,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "然后这边是收银台"
    } ]
  }, {
    "tStartMs": 627366,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "那边的收银台是有收银员的"
    } ]
  }, {
    "tStartMs": 630300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "然后这边是自助买单的"
    } ]
  }, {
    "tStartMs": 633500,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "这个是刚刚我们在超市买的东西"
    } ]
  }, {
    "tStartMs": 636900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "有一大袋"
    } ]
  }, {
    "tStartMs": 639833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "这个墙面的瀑布是一种装饰"
    } ]
  }, {
    "tStartMs": 643666,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "我们已经逛的差不多了"
    } ]
  }, {
    "tStartMs": 645633,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "现在要回去了"
    } ]
  }, {
    "tStartMs": 647833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "你们觉得这个商场怎么样呢"
    } ]
  }, {
    "tStartMs": 650300,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "可以在评论区告诉我"
    } ]
  }, {
    "tStartMs": 652466,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "我希望今天的视频你们能"
    } ]
  }, {
    "tStartMs": 654500,
    "dDurationMs": 6166,
    "segs": [ {
      "utf8": "学到关于商场超市的一些词还有表达"
    } ]
  }, {
    "tStartMs": 661066,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "我会用这样自然的方式来教你们中文"
    } ]
  }, {
    "tStartMs": 664700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "那我们今天的视频就到这里了拜拜"
    } ]
  } ]
}
