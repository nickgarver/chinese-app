  }, {
    "tStartMs": 217700,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "这里有一些手链"
    } ]
  }, {
    "tStartMs": 219800,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "很漂亮"
    } ]
  }, {
    "tStartMs": 221800,
    "dDurationMs": 1866,
    "segs": [ {
