  "events": [ {
    "tStartMs": 33,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "现在我们在路边等出租车"
    } ]
  }, {
    "tStartMs": 2900,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "今天我们会去一个新的商场"
    } ]
  }, {
    "tStartMs": 6466,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我会带你们逛一逛中国的商场"
    } ]
  }, {
    "tStartMs": 9600,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "我刚刚打了车"
    } ]
  }, {
    "tStartMs": 11000,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "然后在等出租车"
    } ]
  }, {
    "tStartMs": 16100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "现在我们在出租车上"
    } ]
  }, {
    "tStartMs": 19266,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "这个商场距离我家3公里"
    } ]
  }, {
    "tStartMs": 22333,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "所以打车过去大概10分钟"
    } ]
  }, {
    "tStartMs": 26100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "不到10分钟"
    } ]
  }, {
    "tStartMs": 27400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我们到了这个商场"
    } ]
  }, {
    "tStartMs": 29900,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "边上停了很多电动车"
    } ]
  }, {
    "tStartMs": 35133,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "这里有一个很大的饭店"
    } ]
  }, {
    "tStartMs": 37266,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "它是吃鱼的"
    } ]
  }, {
    "tStartMs": 49600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "那里还有一个星巴克"
    } ]
  }, {
    "tStartMs": 51366,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "这里的绿化做的挺不错的"
    } ]
  }, {
    "tStartMs": 53933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "等会我们可以走下去看看"
    } ]
  }, {
    "tStartMs": 56833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "这里有一个走廊"
    } ]
  }, {
    "tStartMs": 59700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "走吧"
    } ]
  }, {
    "tStartMs": 60933,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "这些挂的这些灯都很像我们家那边那样"
    } ]
  }, {
    "tStartMs": 65033,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "哦对是"
    } ]
  }, {
    "tStartMs": 66200,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "树上的这个星星月亮的灯"
    } ]
  }, {
    "tStartMs": 69600,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "晚上应该挺漂亮的"
    } ]
  }, {
    "tStartMs": 74133,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "这里有一个花瓶形状的凉亭"
    } ]
  }, {
    "tStartMs": 80000,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "里面有一些凳子椅子小桌子"
    } ]
  }, {
    "tStartMs": 84933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "可以在这里休息"
    } ]
  }, {
    "tStartMs": 87433,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "有点像一个鸟笼"
    } ]
  }, {
    "tStartMs": 91100,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "这里有一个火锅店"
    } ]
  }, {
    "tStartMs": 92800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "是一个连锁店"
    } ]
  }, {
    "tStartMs": 94900,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "在这边特别多"
    } ]
  }, {
    "tStartMs": 97733,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "然后最上面的那个影城是电影院"
    } ]
  }, {
    "tStartMs": 105333,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "远处还有一些正在建设的房子"
    } ]
  }, {
    "tStartMs": 111100,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "现在我们进去看看"
