  }, {
    "tStartMs": 301133,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "这里有一个乐园"
    } ]
  }, {
    "tStartMs": 303300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "是小孩子玩的地方"
