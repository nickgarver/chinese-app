  }, {
    "tStartMs": 257366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "And in the morning,"
    } ]
  }, {
    "tStartMs": 259233,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "when the sun has just come up,"
    } ]
  }, {
    "tStartMs": 260466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "that's called 日出, sunrise."
    } ]
  }, {
    "tStartMs": 264600,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "There are two benches here. Two benches."
    } ]
  }, {
    "tStartMs": 268833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "You can sit here, take a break, and enjoy the view."
    } ]
  }, {
    "tStartMs": 273666,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "I think in the evening,"
    } ]
  }, {
    "tStartMs": 275766,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "the light is really soft. Look."
    } ]
  }, {
    "tStartMs": 280833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It falls so gently on your face,"
    } ]
  }, {
    "tStartMs": 283366,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and it looks really beautiful."
    } ]
  }, {
    "tStartMs": 285633,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "Very natural."
    } ]
  }, {
    "tStartMs": 288633,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "But since we're by the ocean,"
    } ]
  }, {
    "tStartMs": 291933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "there are still quite a lot of bugs."
    } ]
  }, {
    "tStartMs": 293766,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "I'm really scared of bugs."
    } ]
  }, {
    "tStartMs": 295466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Especially mosquitoes."
    } ]
  }, {
    "tStartMs": 297533,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "Last month, remember how a mosquito"
    } ]
  }, {
    "tStartMs": 300800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "bit my eye and it swelled up?"
    } ]
  }, {
    "tStartMs": 302733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "It got really swollen."
    } ]
  }, {
    "tStartMs": 305466,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "And it was really painful and uncomfortable."
    } ]
  }, {
    "tStartMs": 309400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "There were bugs flying around here when I was walking over too."
    } ]
  }, {
    "tStartMs": 312466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Ew, I'm so scared."
    } ]
  }, {
    "tStartMs": 314833,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Wow, just look around."
    } ]
  }, {
    "tStartMs": 317766,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Everything here is so green."
