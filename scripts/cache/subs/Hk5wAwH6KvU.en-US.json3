  "events": [ {
    "tStartMs": 7200,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Hi, everyone!"
    } ]
  }, {
    "tStartMs": 8166,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "I'm Mini."
    } ]
  }, {
    "tStartMs": 9166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Welcome to my channel."
    } ]
  }, {
    "tStartMs": 11400,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "In today's video,"
    } ]
  }, {
    "tStartMs": 12833,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "we're going to spend some time here in Vancouver"
    } ]
  }, {
    "tStartMs": 16066,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "taking an evening walk."
    } ]
  }, {
    "tStartMs": 20200,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "We'll take a walk"
    } ]
  }, {
    "tStartMs": 21466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "and chat along the way."
    } ]
  }, {
    "tStartMs": 23166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "Haha, look!"
    } ]
  }, {
    "tStartMs": 25933,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "There's a cow over here."
    } ]
  }, {
    "tStartMs": 28033,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Oh, not just one."
    } ]
  }, {
    "tStartMs": 29266,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "There are several of them."
    } ]
  }, {
    "tStartMs": 33166,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "It's a little after six in the evening. Look."
    } ]
  }, {
    "tStartMs": 36600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "The sun is about to set."
    } ]
  }, {
    "tStartMs": 38733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "This is the sunset—the setting sun."
    } ]
  }, {
    "tStartMs": 41766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah!"
    } ]
  }, {
    "tStartMs": 43233,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "The scenery is beautiful in the evening too."
    } ]
  }, {
    "tStartMs": 47133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 48366,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "I can still smell those cows, haha."
    } ]
  }, {
    "tStartMs": 52200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "There were so many cows over there just now."
    } ]
  }, {
    "tStartMs": 55766,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And it smelled like cow manure, haha."
    } ]
  }, {
    "tStartMs": 60266,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "Wow, that smell..."
    } ]
  }, {
    "tStartMs": 61966,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Yeah, it doesn't smell very good."
    } ]
  }, {
    "tStartMs": 63933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "It's September now, so it's fall."
    } ]
  }, {
    "tStartMs": 66933,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "How's the weather where you are?"
    } ]
  }, {
    "tStartMs": 69633,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "Is it starting to get colder there too?"
    } ]
  }, {
    "tStartMs": 73533,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "It's the same here in Vancouver."
    } ]
  }, {
    "tStartMs": 74833,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Mornings and evenings are pretty chilly in Vancouver now."
    } ]
  }, {
    "tStartMs": 79733,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You need a jacket."
    } ]
  }, {
    "tStartMs": 81933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Like the one I'm wearing right now."
    } ]
  }, {
    "tStartMs": 84566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Today I'm wearing a"
    } ]
  }, {
    "tStartMs": 86133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "windbreaker. A windbreaker."
    } ]
  }, {
    "tStartMs": 89400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "A jacket like this is"
    } ]
  }, {
    "tStartMs": 91133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "perfect for Vancouver."
    } ]
  }, {
    "tStartMs": 93866,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "It not only blocks the wind,"
    } ]
  }, {
    "tStartMs": 97566,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "but it's also waterproof."
    } ]
  }, {
    "tStartMs": 100633,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "It's really comfortable to wear right now."
    } ]
  }, {
    "tStartMs": 104633,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And right now in Vancouver,"
    } ]
  }, {
    "tStartMs": 106433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "the mornings and evenings are cool,"
    } ]
  }, {
    "tStartMs": 109266,
    "dDurationMs": 4534,
    "segs": [ {
      "utf8": "but when the sun comes out in the afternoon, it can get pretty warm."
    } ]
  }, {
    "tStartMs": 114266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "The sun hasn't set yet. Look."
    } ]
  }, {
    "tStartMs": 118666,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "The sunlight is falling on my face."
    } ]
  }, {
    "tStartMs": 121366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It still feels so warm, haha."
    } ]
  }, {
    "tStartMs": 125200,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "Taking a walk in the evening"
    } ]
  }, {
    "tStartMs": 128533,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "makes all the stress from the day just disappear."
    } ]
  }, {
    "tStartMs": 133600,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "It's so comfortable, relaxing, and peaceful."
    } ]
  }, {
    "tStartMs": 137833,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "The three words I just used"
    } ]
  }, {
    "tStartMs": 140800,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "can be used to describe how we're feeling."
    } ]
  }, {
    "tStartMs": 144400,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Comfortable, relaxed, and content."
    } ]
  }, {
    "tStartMs": 148033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "These three words are used quite often."
    } ]
  }, {
    "tStartMs": 149733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So you can remember them."
    } ]
  }, {
    "tStartMs": 152566,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Wow, look how beautiful the sunset is!"
    } ]
  }, {
    "tStartMs": 158000,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "Did you hear that?"
    } ]
  }, {
    "tStartMs": 158866,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "The cows are mooing, haha."
    } ]
  }, {
    "tStartMs": 161933,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "And over here,"
    } ]
  }, {
    "tStartMs": 162833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "there are lots of little flowers like these. Look."
    } ]
  }, {
    "tStartMs": 166133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "This is a flower."
    } ]
  }, {
    "tStartMs": 168266,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "A little flower, haha."
    } ]
  }, {
    "tStartMs": 170333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "So pretty."
    } ]
  }, {
    "tStartMs": 173566,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "And there's lots of grass behind me."
    } ]
  }, {
    "tStartMs": 178066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "So now I'm going to"
    } ]
  }, {
    "tStartMs": 179333,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "follow this coastline. Look."
    } ]
  }, {
    "tStartMs": 183933,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "The ocean is over there."
    } ]
  }, {
    "tStartMs": 185166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "We'll follow this coastline"
    } ]
  }, {
    "tStartMs": 188066,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and keep walking straight ahead."
    } ]
  }, {
    "tStartMs": 191733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "all the way to the water."
    } ]
  }, {
    "tStartMs": 196433,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "It's probably about two or three kilometers."
    } ]
  }, {
    "tStartMs": 201833,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "But if we just take it slow, we'll get there pretty quickly."
    } ]
  }, {
    "tStartMs": 208066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "For a distance like this,"
    } ]
  }, {
    "tStartMs": 209333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "riding a bike is probably the best option."
    } ]
  }, {
    "tStartMs": 212266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "You'll see lots of people riding bikes around here."
    } ]
  }, {
    "tStartMs": 216766,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "I really like the houses around here."
    } ]
  }, {
    "tStartMs": 221633,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "These are houses. Houses."
    } ]
  }, {
    "tStartMs": 224533,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "If you lived here,"
    } ]
  }, {
    "tStartMs": 226400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "right across from this house—look—"
    } ]
  }, {
    "tStartMs": 229966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "you'd have this beautiful view."
