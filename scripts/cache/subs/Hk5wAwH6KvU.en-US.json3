  }, {
    "tStartMs": 232400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "The ocean is right over there in the distance."
    } ]
  }, {
    "tStartMs": 234833,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Wouldn't it be nice to live here?"
    } ]
  }, {
    "tStartMs": 239366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I think the view here would be amazing."
    } ]
  }, {
    "tStartMs": 242400,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "You could watch the sunset and sunrise every day."
    } ]
  }, {
    "tStartMs": 246966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Hehe, yeah."
    } ]
  }, {
    "tStartMs": 248166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Let me teach you this word."
    } ]
  }, {
    "tStartMs": 249866,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "At this time of day,"
    } ]
  }, {
    "tStartMs": 251133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "it's evening."
    } ]
  }, {
    "tStartMs": 252633,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "And this setting sun"
    } ]
  }, {
    "tStartMs": 254666,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "is called 夕阳, sunset."
