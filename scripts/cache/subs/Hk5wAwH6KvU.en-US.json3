  }, {
    "tStartMs": 327800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "Wow, look!"
    } ]
  }, {
    "tStartMs": 328533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "It's about to set."
    } ]
  }, {
    "tStartMs": 330733,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Look!"
    } ]
  }, {
    "tStartMs": 332333,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Look, look!"
    } ]
  }, {
    "tStartMs": 333166,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "The sun is about to set."
    } ]
  }, {
    "tStartMs": 336033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 337833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "I got to show you a sunset."
    } ]
  }, {
    "tStartMs": 340066,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's really beautiful."
    } ]
  }, {
    "tStartMs": 342600,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "Wow, it feels like once the sun goes down,"
