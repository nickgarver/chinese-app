  }, {
    "tStartMs": 345566,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "it gets dark so quickly."
    } ]
  }, {
    "tStartMs": 348366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "It's getting dark. Really dark."
    } ]
  }, {
    "tStartMs": 351833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "Let's pick up the pace and keep moving."
    } ]
  }, {
    "tStartMs": 355466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Let's keep going toward the ocean."
    } ]
  }, {
    "tStartMs": 359200,
    "dDurationMs": 4966,
    "segs": [ {
      "utf8": "Look, there's a sign here. A sign."
    } ]
  }, {
    "tStartMs": 364166,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "Keep going straight ahead."
    } ]
  }, {
    "tStartMs": 369733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "I really love looking at the ocean."
    } ]
  }, {
    "tStartMs": 372500,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "Especially when you're feeling down,"
    } ]
  }, {
    "tStartMs": 376366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "or when work is really stressful... Oh, a bug!"
    } ]
  }, {
    "tStartMs": 379733,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "or when you're under a lot of pressure at work,"
    } ]
  }, {
    "tStartMs": 382533,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "when you're feeling stressed,"
    } ]
  }, {
    "tStartMs": 383533,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "I really like coming to the ocean."
    } ]
  }, {
    "tStartMs": 385900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I like coming here by myself,"
    } ]
  }, {
    "tStartMs": 388366,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "doing nothing,"
    } ]
  }, {
    "tStartMs": 389500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "thinking about nothing,"
    } ]
  }, {
    "tStartMs": 390700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "just quietly looking out at the ocean."
    } ]
  }, {
    "tStartMs": 394100,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "It makes me feel really healed and refreshed."
    } ]
  }, {
    "tStartMs": 398066,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Because the ocean"
    } ]
  }, {
    "tStartMs": 399500,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "makes everything feel so vast and open."
    } ]
  }, {
    "tStartMs": 402866,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Actually, it's not just the ocean."
    } ]
  }, {
    "tStartMs": 404333,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "I think nature just has"
    } ]
  }, {
    "tStartMs": 405966,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "this incredible kind of magic."
    } ]
  }, {
    "tStartMs": 409366,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "It can help take away a lot of our stress"
    } ]
  }, {
    "tStartMs": 412666,
    "dDurationMs": 2867,
    "segs": [ {
