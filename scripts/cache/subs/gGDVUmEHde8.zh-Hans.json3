  }, {
    "tStartMs": 579733,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "对我的频道感兴趣"
    } ]
  }, {
    "tStartMs": 581800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "欢迎订阅我的频道"
    } ]
  }, {
    "tStartMs": 584033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "好吧咱们今天就到这吧"
