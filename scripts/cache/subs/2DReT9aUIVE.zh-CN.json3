{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 14533,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "hello大家好久不见"
    } ]
  }, {
    "tStartMs": 17866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "你们最近怎么样"
    } ]
  }, {
    "tStartMs": 21000,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我希望你们一切都好"
    } ]
  }, {
    "tStartMs": 25066,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "我最近去巴黎旅游了"
    } ]
  }, {
    "tStartMs": 28700,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "今天的视频我想和你们分享一下"
    } ]
  }, {
    "tStartMs": 33000,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "这次旅行"
    } ]
  }, {
    "tStartMs": 34700,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "巴黎是法国的首都"
    } ]
  }, {
    "tStartMs": 37733,
    "dDurationMs": 4967,
    "segs": [ {
      "utf8": "是全世界最受欢迎的旅游城市之一"
    } ]
  }, {
    "tStartMs": 43300,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "每年吸引了大量的游客来参观"
    } ]
  }, {
    "tStartMs": 48433,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "这是我第一次来巴黎"
    } ]
  }, {
    "tStartMs": 51700,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "所以我真的非常期待"
    } ]
  }, {
    "tStartMs": 55200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "if you'd like to support my work"
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "you can join as a YouTube member"
    } ]
  }, {
    "tStartMs": 59500,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "you will get early access to new videos"
    } ]
  }, {
    "tStartMs": 62200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "full transcripts and core vocabulary in pinyin"
    } ]
  }, {
    "tStartMs": 65433,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Chinese and English"
    } ]
  }, {
    "tStartMs": 66833,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "as well as audio files your support means a lot to me"
    } ]
  }, {
    "tStartMs": 74400,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "我们到酒店的时候还没到入住时间"
    } ]
  }, {
    "tStartMs": 79933,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "所以"
    } ]
  }, {
    "tStartMs": 80533,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "我们先去了酒店附近的一座教堂"
    } ]
  }, {
    "tStartMs": 85866,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "下午的光线"
    } ]
  }, {
    "tStartMs": 87533,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "让教堂看起来更加神圣了"
    } ]
  }, {
    "tStartMs": 93066,
    "dDurationMs": 4934,
    "segs": [ {
      "utf8": "我觉得这里的花窗玻璃非常精美"
    } ]
  }, {
    "tStartMs": 98833,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "你知道这个故事吗"
    } ]
  }, {
    "tStartMs": 103000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "参观完教堂后"
    } ]
  }, {
    "tStartMs": 105466,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "我们回酒店办理入住"
    } ]
  }, {
    "tStartMs": 109066,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "然后我们放下行李"
    } ]
  }, {
    "tStartMs": 112100,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "来到了附近的卢森堡公园"
    } ]
  }, {
    "tStartMs": 116700,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "幸运的是"
    } ]
  }, {
    "tStartMs": 118100,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "我们到巴黎的时候已经降温了"
    } ]
  }, {
    "tStartMs": 122433,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "所以现在的温度很舒服"
    } ]
  }, {
    "tStartMs": 126333,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "很多人在公园运动看书和放松"
    } ]
  }, {
    "tStartMs": 132700,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "晚餐我们吃了中餐"
    } ]
  }, {
    "tStartMs": 135600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "味道非常地道"
    } ]
  }, {
    "tStartMs": 140933,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "第二天一早"
    } ]
  }, {
    "tStartMs": 142800,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "我们先去一家面包店买可颂"
    } ]
  }, {
    "tStartMs": 147433,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "这家店在Google地图评分很高"
    } ]
  }, {
    "tStartMs": 151933,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "这是您的"
    } ]
  }, {
    "tStartMs": 153033,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "这是巧克力面包"
    } ]
  }, {
    "tStartMs": 155066,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "然后还有个可颂"
    } ]
  }, {
    "tStartMs": 158666,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "好漂亮的可颂"
    } ]
  }, {
    "tStartMs": 160533,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "然后我们找了一个安静的地方"
    } ]
  }, {
    "tStartMs": 164533,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "吃面包 喝咖啡"
    } ]
  }, {
    "tStartMs": 168800,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "树上的鸽子好像也在吃早餐"
    } ]
  }, {
    "tStartMs": 174266,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "路上我们遇到了一支乐队"
    } ]
  }, {
    "tStartMs": 178066,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "他们正在桥上演奏"
    } ]
  }, {
    "tStartMs": 181833,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "你听过这首歌吗"
    } ]
  }, {
    "tStartMs": 191266,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "现在我们到了一个有名的景点"
    } ]
  }, {
    "tStartMs": 195733,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "巴黎圣母院"
    } ]
  }, {
    "tStartMs": 198133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "入口有很多游客"
    } ]
  }, {
    "tStartMs": 200533,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "我们排队了大概20分钟"
    } ]
  }, {
    "tStartMs": 205600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "终于进来了"
    } ]
  }, {
    "tStartMs": 208900,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "这扇巨大的玫瑰窗真的很漂亮"
    } ]
  }, {
    "tStartMs": 215400,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "里面的油画也令人印象深刻"
    } ]
  }, {
    "tStartMs": 221266,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "出来后"
    } ]
  }, {
    "tStartMs": 222466,
    "dDurationMs": 4534,
    "segs": [ {
      "utf8": "我们沿着河边散步到了卢浮宫"
    } ]
  }, {
    "tStartMs": 228400,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "因为我们这次和女儿一起旅行"
    } ]
  }, {
    "tStartMs": 233100,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "所以没有计划参观任何博物馆"
    } ]
  }, {
    "tStartMs": 238200,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "留到下一次"
    } ]
  }, {
    "tStartMs": 239900,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "我们单独旅行的时候再去"
    } ]
  }, {
    "tStartMs": 244133,
    "dDurationMs": 4967,
    "segs": [ {
      "utf8": "然后我们来到了旁边的杜乐丽花园"
    } ]
  }, {
    "tStartMs": 250100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "坐在这里休息一下"
    } ]
  }, {
    "tStartMs": 254733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我女儿有点累了"
    } ]
  }, {
    "tStartMs": 257333,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "所以我们打算回酒店了"
    } ]
  }, {
    "tStartMs": 261333,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "顺便在附近的超市买了一点水果"
    } ]
  }, {
    "tStartMs": 268233,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Lina睡午觉了"
    } ]
  }, {
    "tStartMs": 270700,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "我们也休息一下"
    } ]
  }, {
    "tStartMs": 274266,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "晚上我们出发去坐游船"
    } ]
  }, {
    "tStartMs": 279000,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "在塞纳河上一边看日落"
    } ]
  }, {
    "tStartMs": 282700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "一边看景点"
    } ]
  }, {
    "tStartMs": 285033,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "用这种方式探索一个城市"
    } ]
  }, {
    "tStartMs": 288933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "让人感到放松"
    } ]
  }, {
    "tStartMs": 291800,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "但同时也能欣赏到很多风景"
    } ]
  }, {
    "tStartMs": 296466,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "很适合家庭"
    } ]
  }, {
    "tStartMs": 299066,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "岸边还有人在跳舞"
    } ]
  }, {
    "tStartMs": 302100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "这一刻"
    } ]
  }, {
    "tStartMs": 303100,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "我知道了为什么很多人说巴黎浪漫"
    } ]
  }, {
    "tStartMs": 309266,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "下船后我们买了晚餐"
    } ]
  }, {
    "tStartMs": 312200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "然后回酒店看世界杯"
    } ]
  }, {
    "tStartMs": 316466,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "你喜欢看足球比赛吗"
    } ]
  }, {
    "tStartMs": 321466,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "今天早上"
    } ]
  }, {
    "tStartMs": 322933,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "我要和一个住在巴黎的朋友见面"
    } ]
  }, {
    "tStartMs": 327833,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "我们约了一起吃一个早午餐"
    } ]
  }, {
    "tStartMs": 331800,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "喝咖啡"
    } ]
  }, {
    "tStartMs": 334100,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我们聊得很开心"
    } ]
  }, {
    "tStartMs": 336800,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "这里的咖啡也很好喝"
    } ]
  }, {
    "tStartMs": 340466,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "和朋友分别后"
    } ]
  }, {
    "tStartMs": 342500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "我们坐地铁去蒙马特高地"
    } ]
  }, {
    "tStartMs": 348500,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "这里有很多可爱的小店"
    } ]
  }, {
    "tStartMs": 354100,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "我们在山顶"
    } ]
  }, {
    "tStartMs": 355666,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "看到一对拍婚纱照的夫妻"
    } ]
  }, {
    "tStartMs": 360000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "祝福他们"
    } ]
  }, {
    "tStartMs": 363866,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "然后我发现远处好像发生了火灾"
    } ]
  }, {
    "tStartMs": 369733,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "逛了一会儿后"
    } ]
  }, {
    "tStartMs": 371400,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "我们的肚子饿了"
    } ]
  }, {
    "tStartMs": 373600,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我们在这家餐厅"
    } ]
  }, {
    "tStartMs": 375633,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "吃了一个简单的午餐"
    } ]
  }, {
    "tStartMs": 379100,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "Lina很喜欢他们的薯条"
    } ]
  }, {
    "tStartMs": 383933,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "吃完午饭后"
    } ]
  }, {
    "tStartMs": 385733,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "我们来到了大名鼎鼎的老佛爷商场"
    } ]
  }, {
    "tStartMs": 391933,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "楼顶的风景真的很不错"
    } ]
  }, {
    "tStartMs": 395933,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "可惜我们没有太多时间购物"
    } ]
  }, {
    "tStartMs": 400866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "下一站是凯旋门"
    } ]
  }, {
    "tStartMs": 403633,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "它也是法国最著名的地标之一"
    } ]
  }, {
    "tStartMs": 409466,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "最后一站当然是埃菲尔铁塔"
    } ]
  }, {
    "tStartMs": 414133,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "它比我想象中大很多"
    } ]
  }, {
    "tStartMs": 419700,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我们有点累了"
    } ]
  }, {
    "tStartMs": 422000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "决定吃一个冰淇淋"
    } ]
  }, {
    "tStartMs": 425633,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "这是我吃过最好吃的冰淇淋"
    } ]
  }, {
    "tStartMs": 429633,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "开心果味道太好吃了"
    } ]
  }, {
    "tStartMs": 433466,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "晚饭我们又来吃中餐了"
    } ]
  }, {
    "tStartMs": 437633,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "好久没吃油泼面"
    } ]
  }, {
    "tStartMs": 439900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "我有点想哭"
    } ]
  }, {
    "tStartMs": 442700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "吃饱后就回酒店休息啦"
    } ]
  }, {
    "tStartMs": 448800,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "这是我们在巴黎的最后一天"
    } ]
  }, {
    "tStartMs": 452233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "我竟然在巴黎看到了库迪"
    } ]
  }, {
    "tStartMs": 456300,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "当然要点一杯生椰拿铁"
    } ]
  }, {
    "tStartMs": 460633,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "还是熟悉的味道"
    } ]
  }, {
    "tStartMs": 463700,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "我们又来这家面包店买可颂了"
    } ]
  }, {
    "tStartMs": 468033,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "然后我们来附近的植物园散散步"
    } ]
  }, {
    "tStartMs": 473133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "你好呀小鸭子"
    } ]
  }, {
    "tStartMs": 476200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "蜜蜂在花丛采蜜"
    } ]
  }, {
    "tStartMs": 480866,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "不得不说再见啦"
    } ]
  }, {
    "tStartMs": 483433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我们出发去机场了"
    } ]
  }, {
    "tStartMs": 487100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我们玩得很开心"
    } ]
  }, {
    "tStartMs": 489500,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "但是也有一些遗憾"
    } ]
  }, {
    "tStartMs": 492733,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我们一定会再来的"
    } ]
  }, {
    "tStartMs": 495866,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "下次见巴黎"
    } ]
  } ]
}
