  }, {
    "tStartMs": 649770,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "所以它是六条\nsuǒ yǐ tā shì liù tiáo\nSo it's six bamboo."
    } ]
  }, {
    "tStartMs": 650970,
    "dDurationMs": 2078,
    "segs": [ {
      "utf8": "六条\nliù tiáo\nSix bamboo."
    } ]
  }, {
    "tStartMs": 653170,
    "dDurationMs": 3120,
    "segs": [ {
