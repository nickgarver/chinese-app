    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "六筒\nliù tǒng\nSix circles."
    } ]
  }, {
    "tStartMs": 641170,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "这有一二三四五六\nzhè yǒu yī èr sān sì wǔ liù\nThere are one, two, three, four, five, six here."
