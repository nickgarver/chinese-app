  }, {
    "tStartMs": 658957,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "一条到九条\nyī tiáo dào jiǔ tiáo\nOne bamboo to nine bamboo."
    } ]
  }, {
    "tStartMs": 662490,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "再上面\nzài shàng miàn\nAbove that,"
    } ]
  }, {
