    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "这有一些汉字和一个图案\nzhè yǒu yī xiē hàn zì hé yí gè tú àn\nThere are some Chinese characters and a pattern here."
    } ]
  }, {
    "tStartMs": 672010,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "这就是东\nzhè jiù shì dōng\nThis is East."
