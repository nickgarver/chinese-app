    "segs": [ {
      "utf8": "hello，大家好，欢迎来到今天的中文教学视频\nhello， dà jiā hǎo， huān yíng lái dào jīn tiān de zhōng wén jiào xué shì pín\nHello, everyone, welcome to today's Chinese learning video."
    } ]
  }, {
    "tStartMs": 5887,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "我是大贝。\nwǒ shì dà bèi。\nI'm Dabei."
    } ]
  }, {
    "tStartMs": 7513,
    "dDurationMs": 3440,
    "segs": [ {
