  } ],
  "events": [ {
    "tStartMs": 300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "嗨，大家好"
    } ]
  }, {
    "tStartMs": 2000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "歡迎回到我的頻道"
    } ]
  }, {
    "tStartMs": 4633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我是安吉拉"
    } ]
  }, {
    "tStartMs": 6600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "好久不見了"
    } ]
  }, {
    "tStartMs": 8500,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "我最近一直都沒有更新視頻"
    } ]
  }, {
    "tStartMs": 13400,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "因為我感冒一直都沒有好"
    } ]
  }, {
    "tStartMs": 17133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "前兩天又有點兒嚴重了"
    } ]
  }, {
    "tStartMs": 20833,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "一直在咳嗽"
    } ]
  }, {
    "tStartMs": 22700,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "咳嗽得很厲害"
    } ]
  }, {
    "tStartMs": 24800,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "所以沒有更新視頻"
    } ]
  }, {
    "tStartMs": 27600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "今天好一些了"
    } ]
  }, {
    "tStartMs": 29533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我又回來了"
    } ]
  }, {
    "tStartMs": 31200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "繼續和大家聊天兒"
    } ]
  }, {
    "tStartMs": 33933,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "今天想跟 中國"
    } ]
  }, {
    "tStartMs": 39033,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "聊的話題是“短視頻”"
    } ]
  }, {
    "tStartMs": 43133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "手機"
    } ]
  }, {
    "tStartMs": 45833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "平時會"
    } ]
  }, {
    "tStartMs": 48600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "短"
    } ]
  }, {
    "tStartMs": 50033,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "視頻刷"
    } ]
  }, {
    "tStartMs": 55033,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "用國也有很多短視頻的APP"
    } ]
  }, {
    "tStartMs": 59733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "其中最火的"
    } ]
  }, {
    "tStartMs": 62333,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "用的人最多的就是抖音"
    } ]
  }, {
    "tStartMs": 66133,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "抖音在其他的國家好像也可以用吧"
    } ]
  }, {
    "tStartMs": 70100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "但是只是在中國"
    } ]
  }, {
    "tStartMs": 72233,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "每天就有8億的人在用抖音刷短視頻"
    } ]
  }, {
    "tStartMs": 78000,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "並且這些人"
    } ]
  }, {
    "tStartMs": 79666,
    "dDurationMs": 4634,
    "segs": [ {
      "utf8": "每天用抖音刷短視頻的平均時間"
    } ]
  }, {
    "tStartMs": 84600,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "每個人是一個半小時"
    } ]
  }, {
    "tStartMs": 87733,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "​​可以看到"
    } ]
  }, {
    "tStartMs": 89066,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "中國人是多麼喜歡短視頻了"
    } ]
  }, {
    "tStartMs": 92466,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "我今天"
    } ]
  }, {
    "tStartMs": 96300,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "想"
    } ]
  }, {
    "tStartMs": 97400,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "聊這個話題"
    } ]
  }, {
    "tStartMs": 102333,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "有點上癮？做一件事情"
    } ]
  }, {
    "tStartMs": 107533,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "控制不住自己"
    } ]
  }, {
    "tStartMs": 109333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "想停下來卻停不下來"
    } ]
  }, {
    "tStartMs": 112400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "這就叫上癮了"
    } ]
  }, {
    "tStartMs": 114433,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "有的人會對抽煙上癮"
    } ]
  }, {
    "tStartMs": 117333,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "有的人會對喝酒上癮"
    } ]
  }, {
    "tStartMs": 119900,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我現在對刷短視頻上癮了"
    } ]
  }, {
    "tStartMs": 123500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "只要有時間"
    } ]
  }, {
    "tStartMs": 125000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我就想打開"
    } ]
  }, {
    "tStartMs": 128733,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "手機刷短視頻吃飯的時候會刷短視頻睡覺"
    } ]
  }, {
    "tStartMs": 132033,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "之前"
    } ]
  }, {
    "tStartMs": 133800,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "躺在"
    } ]
  }, {
    "tStartMs": 138733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "床上"
    } ]
  }, {
    "tStartMs": 140833,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "舒舒服服的"
    } ]
  }, {
    "tStartMs": 143900,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "， 想"
    } ]
  }, {
    "tStartMs": 148433,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "放鬆"
    } ]
  }, {
    "tStartMs": 152100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "視頻"
    } ]
  }, {
    "tStartMs": 153400,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "題的"
    } ]
  }, {
    "tStartMs": 155833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "那我現在的問題是"
    } ]
  }, {
    "tStartMs": 157833,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "明明我只想看一會兒"
    } ]
  }, {
    "tStartMs": 160666,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "但是我經常看著看著，就看了一個小時、兩個小時"
    } ]
  }, {
    "tStartMs": 168033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "那這種感覺呢"
    } ]
  }, {
    "tStartMs": 169233,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "讓我很不舒服"
    } ]
  }, {
    "tStartMs": 171133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "讓我有一種負罪感"
    } ]
  }, {
    "tStartMs": 174033,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "我覺得我現在每天花太多的時間"
    } ]
  }, {
    "tStartMs": 178300,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "在一些沒有用的事情上"
    } ]
  }, {
    "tStartMs": 181333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "讓我感覺有一些負罪感"
    } ]
  }, {
    "tStartMs": 183933,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "有一些焦慮"
    } ]
  }, {
    "tStartMs": 185700,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "我想戒掉短視頻這個習慣"
    } ]
  }, {
    "tStartMs": 190400,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "為了解決視頻上這個問題上"
    } ]
  }, {
    "tStartMs": 193900,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "我 會對"
    } ]
  }, {
    "tStartMs": 197333,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我"
    } ]
  }, {
    "tStartMs": 198666,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "的問題刷掉我為什麼？"
    } ]
  }, {
    "tStartMs": 202600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我怎麼才能戒掉短影片？"
    } ]
  }, {
    "tStartMs": 205800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "今天我就跟大家分享一下"
    } ]
  }, {
    "tStartMs": 208400,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "AI是怎麼回答我的"
    } ]
  }, {
    "tStartMs": 210733,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "它都跟我說了什麼"
    } ]
  }, {
    "tStartMs": 212733,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "在回答我的問題之前呢"
    } ]
  }, {
    "tStartMs": 215233,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "AI很貼心"
    } ]
  }, {
    "tStartMs": 217033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "它先安慰了我"
    } ]
  }, {
    "tStartMs": 218933,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "它跟我說"
    } ]
  }, {
    "tStartMs": 219900,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "對短視頻上癮不是我自己的問題"
    } ]
  }, {
    "tStartMs": 224233,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "不是因為我不夠自律"
    } ]
  }, {
    "tStartMs": 226866,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "讓我不要有負罪感"
    } ]
  }, {
    "tStartMs": 229300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "對短視頻上癮呢"
    } ]
  }, {
    "tStartMs": 231100,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "是 大腦、心情、還有軟體"
    } ]
  }, {
    "tStartMs": 235133,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "這三個東西一起 讓我知道"
    } ]
  }, {
    "tStartMs": 239233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "它"
    } ]
  }, {
    "tStartMs": 240466,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "會對"
    } ]
  }, {
    "tStartMs": 243633,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我"
    } ]
  }, {
    "tStartMs": 245466,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "遇到"
    } ]
  }, {
    "tStartMs": 247733,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "這種問題"
    } ]
  }, {
    "tStartMs": 250066,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "短片上癮的三個原因"
    } ]
  }, {
    "tStartMs": 254266,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "第一個原因是我們大腦的原因"
    } ]
  }, {
    "tStartMs": 258033,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "它說我們的大腦喜歡簡單、快速的快樂"
    } ]
  }, {
    "tStartMs": 263466,
    "dDurationMs": 5267,
    "segs": [ {
      "utf8": "比如說我們如果學習、看書或運動的時候"
    } ]
  }, {
    "tStartMs": 268833,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "快樂來的是很慢的"
    } ]
  }, {
    "tStartMs": 272033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我們 在學習看書的時候"
    } ]
  }, {
    "tStartMs": 274733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "通常要看很"
    } ]
  }, {
    "tStartMs": 277133,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "長時間"
    } ]
  }, {
    "tStartMs": 278833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "還要思考"
    } ]
  }, {
    "tStartMs": 281500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "才會"
    } ]
  }, {
    "tStartMs": 283600,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "是"
    } ]
  }, {
    "tStartMs": 285633,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "新的知識"
    } ]
  }, {
    "tStartMs": 288700,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "才有"
    } ]
  }, {
    "tStartMs": 291466,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "成就感"
    } ]
  }, {
    "tStartMs": 293000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "運動也是"
    } ]
  }, {
    "tStartMs": 294300,
    "dDurationMs": 5766,
    "segs": [ {
      "utf8": "放鬆、運動服"
    } ]
  }, {
    "tStartMs": 300500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "但是短視頻就不一樣了"
    } ]
  }, {
    "tStartMs": 303033,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "每個短視頻時間都很短"
    } ]
  }, {
    "tStartMs": 306200,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "只有十幾秒、幾十秒或者一分鐘的時間"
    } ]
  }, {
    "tStartMs": 311800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "那這些短視頻呢"
    } ]
  }, {
    "tStartMs": 313700,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "能夠很快讓我們變得很開心"
    } ]
  }, {
    "tStartMs": 317666,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "變得很刺激"
    } ]
  }, {
    "tStartMs": 319266,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "或者一下子變得心情很好"
    } ]
  }, {
    "tStartMs": 322266,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "每看到一條短視頻的時候"
    } ]
  }, {
    "tStartMs": 324500,
    "dDurationMs": 5833,
    "segs": [ {
      "utf8": "我們的大腦都會很快地分泌一種讓人快樂的東西"
    } ]
  }, {
    "tStartMs": 330700,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "那"
    } ]
  }, {
    "tStartMs": 332133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "一條"
    } ]
  }, {
    "tStartMs": 334833,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "結束之後"
    } ]
  }, {
    "tStartMs": 338233,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "慢慢"
    } ]
  }, {
    "tStartMs": 340633,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "地快樂"
    } ]
  }, {
    "tStartMs": 345333,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "如果我們再去看書啊"
    } ]
  }, {
    "tStartMs": 347933,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "寫東西啊"
    } ]
  }, {
    "tStartMs": 349300,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "想安靜做事的時候"
    } ]
  }, {
    "tStartMs": 351433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "就很難堅持下去"
    } ]
  }, {
    "tStartMs": 353500,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "會覺得很枯燥、很無聊"
    } ]
  }, {
    "tStartMs": 356400,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "沒辦法安靜下來"
    } ]
  }, {
    "tStartMs": 358866,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "這就是為什麼我們越刷短視頻"
    } ]
  }, {
    "tStartMs": 362666,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "越難專注地做一件事情的原因"
    } ]
  }, {
    "tStartMs": 366800,
    "dDurationMs": 6266,
    "segs": [ {
      "utf8": "第二個原因呢是短視頻能夠讓人的心情變好"
    } ]
  }, {
    "tStartMs": 373200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "現在"
    } ]
  }, {
    "tStartMs": 374600,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "的生活"
    } ]
  }, {
    "tStartMs": 377000,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "每個人的壓力都很大"
    } ]
  }, {
    "tStartMs": 380533,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "所以"
    } ]
  }, {
    "tStartMs": 382266,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "每個人都有時候"
    } ]
  }, {
    "tStartMs": 385100,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "在這種"
    } ]
  }, {
    "tStartMs": 386400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "方式"
    } ]
  }, {
    "tStartMs": 388833,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "下來"
    } ]
  }, {
    "tStartMs": 391066,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "能讓自己的心情變得好一點兒"
    } ]
  }, {
    "tStartMs": 394433,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那短視頻呢"
    } ]
  }, {
    "tStartMs": 395833,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "就是最簡單的一種方法"
    } ]
  }, {
    "tStartMs": 399100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "因為刷短視頻"
    } ]
  }, {
    "tStartMs": 401066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "你不需要出門"
    } ]
  }, {
    "tStartMs": 402866,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "也不需要花錢"
    } ]
  }, {
    "tStartMs": 404933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "只要打開手機就可以了"
    } ]
  }, {
    "tStartMs": 407833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "所以對很多人來說"
    } ]
  }, {
    "tStartMs": 409933,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "刷短視頻不僅是一種娛樂方式"
    } ]
  }, {
    "tStartMs": 414000,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "也能安慰人的情緒"
    } ]
  }, {
    "tStartMs": 416700,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "讓自己的心情變好"
    } ]
  }, {
    "tStartMs": 419333,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "所以慢慢地，人們在心情不好的時候"
    } ]
  }, {
    "tStartMs": 423733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "無聊"
    } ]
  }, {
    "tStartMs": 425233,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "的時候"
    } ]
  }, {
    "tStartMs": 427833,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "自然而然"
    } ]
  }, {
    "tStartMs": 431600,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "地"
    } ]
  }, {
    "tStartMs": 434933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "很"
    } ]
  }, {
    "tStartMs": 436200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "自然地打開手機 一個原因"
    } ]
  }, {
    "tStartMs": 439100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "短視頻的軟體"
    } ]
  }, {
    "tStartMs": 441000,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "就是為了讓觀眾一直不停地看下去"
    } ]
  }, {
    "tStartMs": 445666,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "因為短視頻是沒有結尾的"
    } ]
  }, {
    "tStartMs": 449133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "我們看書總會看完"
    } ]
  }, {
    "tStartMs": 451933,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "看電影呢"
    } ]
  }, {
    "tStartMs": 453066,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "也會有一個結局"
    } ]
  }, {
    "tStartMs": 455100,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "但是短視頻一條結束之後"
    } ]
  }, {
    "tStartMs": 458533,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "馬上會有下一條"
    } ]
  }, {
    "tStartMs": 460900,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "所以大腦接收不到結束的信號"
    } ]
  }, {
    "tStartMs": 465266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "就想一直看下去"
    } ]
  }, {
    "tStartMs": 467733,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "那另外呢"
    } ]
  }, {
    "tStartMs": 468933,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "短視頻也非常理解我們"
    } ]
  }, {
    "tStartMs": 471600,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "它會為我們做一個大數據的分析"
    } ]
  }, {
    "tStartMs": 475400,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "會 停下 給我們看給我們看"
    } ]
  }, {
    "tStartMs": 480200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "愛"
    } ]
  }, {
    "tStartMs": 481633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "的"
    } ]
  }, {
    "tStartMs": 483833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "內容"
    } ]
  }, {
    "tStartMs": 485200,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "們"
    } ]
  }, {
    "tStartMs": 485800,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "為什麼會對短視頻上癮的原因之外呢"
    } ]
  }, {
    "tStartMs": 490700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "AI還告訴了我"
    } ]
  }, {
    "tStartMs": 492433,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "幾個克服短視頻上癮的方法"
    } ]
  }, {
    "tStartMs": 496833,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "怎麼做才能讓自己不對短視頻上癮"
    } ]
  }, {
    "tStartMs": 502500,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "比如說"
    } ]
  }, {
    "tStartMs": 503533,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "它告訴我，限制刷短視頻的時間"
    } ]
  }, {
    "tStartMs": 508700,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "比如說"
    } ]
  }, {
    "tStartMs": 509200,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "限制自己每天只能刷10分鐘"
    } ]
  }, {
    "tStartMs": 514433,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "的短視頻只能刷20分鐘的短視頻"
    } ]
  }, {
    "tStartMs": 517433,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "給 自己"
    } ]
  }, {
    "tStartMs": 521266,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "限制"
    } ]
  }, {
    "tStartMs": 522500,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "一個嚴格的時間"
    } ]
  }, {
    "tStartMs": 525433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "那一天"
    } ]
  }, {
    "tStartMs": 527000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "就"
    } ]
  }, {
    "tStartMs": 530733,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "不會做"
    } ]
  }, {
    "tStartMs": 534466,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "手機響睡眠了"
    } ]
  }, {
    "tStartMs": 536433,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "那還有一個方法"
    } ]
  }, {
    "tStartMs": 537600,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "我覺得聽起來也是挺好的"
    } ]
  }, {
    "tStartMs": 540866,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "在你想刷短視頻的時候"
    } ]
  }, {
    "tStartMs": 543266,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "轉移一下自己的注意力"
    } ]
  }, {
    "tStartMs": 546033,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "去乾點別的事情"
    } ]
  }, {
    "tStartMs": 548200,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "這些方法我都準備試一下"
    } ]
  }, {
    "tStartMs": 551433,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "到時候告訴你們有沒有效果"
    } ]
  }, {
    "tStartMs": 554866,
    "dDurationMs": 5334,
    "segs": [ {
      "utf8": "那大家平時有沒有對短視頻上癮的困擾呢"
    } ]
  }, {
    "tStartMs": 560500,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "你們"
    } ]
  }, {
    "tStartMs": 564066,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "是怎麼解決這個問題的"
    } ]
  }, {
    "tStartMs": 566666,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "如果"
    } ]
  }, {
    "tStartMs": 568833,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "你們也有同樣的經歷"
    } ]
  }, {
    "tStartMs": 572666,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "和"
    } ]
  }, {
    "tStartMs": 575266,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "同樣"
    } ]
  }, {
    "tStartMs": 577933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "的問題"
    } ]
  }, {
    "tStartMs": 579733,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "對我的頻道有興趣"
    } ]
  }, {
    "tStartMs": 581800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "歡迎訂閱我的頻道"
    } ]
  }, {
    "tStartMs": 584033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "好吧咱們今天就到這吧"
    } ]
  }, {
    "tStartMs": 586500,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "下次再見拜拜"
    } ]
  } ]
}
