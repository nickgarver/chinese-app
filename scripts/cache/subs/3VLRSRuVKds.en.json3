  }, {
    "tStartMs": 926466,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "right?"
    } ]
  }, {
    "tStartMs": 927233,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Every explanation is different."
