  }, {
    "tStartMs": 903633,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "I used to love using our cat as my profile picture"
    } ]
  }, {
    "tStartMs": 907433,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": ", and because my mom believed these masters,"
