    "dDurationMs": 700,
    "segs": [ {
      "utf8": "hei pi"
    } ]
  }, {
    "tStartMs": 340400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "I don't have one on hand right now. "
    } ]
  }, {
    "tStartMs": 342133,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Last year, I actually spent some time traveling in Hawaii, "
    } ]
  }, {
    "tStartMs": 345833,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "and while I was there, "
    } ]
  }, {
    "tStartMs": 347833,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "I wandered around souvenir shops in Hawaii for a long time,"
    } ]
  }, {
    "tStartMs": 351033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": " looking at tons of these "
    } ]
  }, {
    "tStartMs": 353500,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "tanned/black skin Hello Kitty items, "
    } ]
  }, {
    "tStartMs": 355100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "but in the end, I didn't buy any"
    } ]
  }, {
    "tStartMs": 357300,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": ", and now I'm a little regretful,"
    } ]
  }, {
    "tStartMs": 358900,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "haha."
    } ]
  }, {
    "tStartMs": 359666,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "Actually, I'm still a little regretful."
    } ]
  }, {
    "tStartMs": 362033,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "\"hei pi\""
    } ]
  }, {
    "tStartMs": 362666,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "refers to this skin color, which"
    } ]
  }, {
    "tStartMs": 366500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "is called \"hei pi\" on the Chinese internet."
    } ]
  }, {
    "tStartMs": 370300,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "actually"
    } ]
  }, {
    "tStartMs": 370900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "it's just that sun-tanned wheat-colored (healthy tan) shade"
    } ]
  }, {
    "tStartMs": 374000,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "and then"
    } ]
  }, {
    "tStartMs": 374600,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "this doll that everyone is seeing here"
    } ]
  }, {
    "tStartMs": 376633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": " is another \"era's memory\""
    } ]
  }, {
    "tStartMs": 379700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "We often say that"
    } ]
  }, {
    "tStartMs": 382066,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": " once a trend has passed,"
    } ]
  }, {
    "tStartMs": 384266,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": " in Chinese we frequently call it "
    } ]
  }, {
    "tStartMs": 385666,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "\"an era's memory\" "
    } ]
  }, {
    "tStartMs": 388666,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "This doll comes from Japan, "
    } ]
  }, {
    "tStartMs": 391200,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "desighned by a once-super-popular model—"
    } ]
  }, {
    "tStartMs": 395066,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "mixed-race model named Rinka."
    } ]
  }, {
    "tStartMs": 397833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "She was a top model for Vivi."
    } ]
  }, {
    "tStartMs": 402200,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Japanese teen magazines"
    } ]
  }, {
    "tStartMs": 403733,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "especially liked using mixed-race models."
    } ]
  }, {
    "tStartMs": 406133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "I remember that from 2010"
    } ]
  }, {
    "tStartMs": 409400,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "to 2020,during that decade,"
    } ]
  }, {
    "tStartMs": 412866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Japanese pop culture"
    } ]
  }, {
    "tStartMs": 415066,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "had a significant influence on China."
    } ]
  }, {
    "tStartMs": 417633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "But after 2020, this"
    } ]
  }, {
    "tStartMs": 420100,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "influence gradually weakened,"
    } ]
  }, {
    "tStartMs": 423400,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "and it's now rarely seen"
    } ]
  }, {
    "tStartMs": 426633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "on social media."
    } ]
  }, {
    "tStartMs": 428066,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "You almost never see"
    } ]
  }, {
    "tStartMs": 430833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "kids dressed in very Japanese styles anymore."
    } ]
  }, {
    "tStartMs": 434800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Japanese style has returned to"
    } ]
  }, {
    "tStartMs": 436833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "a more niche status."
    } ]
  }, {
    "tStartMs": 439166,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "This is also a memory of an era."
    } ]
  }, {
    "tStartMs": 441066,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Back then, this Japanese model"
    } ]
  }, {
    "tStartMs": 442766,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": ", Rinka,"
    } ]
  }, {
    "tStartMs": 444633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "was a top model for Vivi and"
    } ]
  }, {
    "tStartMs": 447166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "launched her own fashion brand."
    } ]
  }, {
    "tStartMs": 450200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "I remember when I was in Tokyo, I often went to her"
    } ]
  }, {
    "tStartMs": 452866,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "store in Daikanyama."
    } ]
  }, {
    "tStartMs": 455533,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "Even her dolls were very popular back then."
    } ]
  }, {
    "tStartMs": 460333,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "As you can see,"
    } ]
  }, {
    "tStartMs": 461300,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "this is one of those \"black skin\" dolls"
    } ]
  }, {
    "tStartMs": 464266,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": ", so"
    } ]
  }, {
    "tStartMs": 465566,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "a black-skinned version of Hello Kitty was released,"
    } ]
  }, {
    "tStartMs": 469833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and it became incredibly popular"
    } ]
  }, {
    "tStartMs": 471233,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "in China, it was literally \"one cat hard to get\""
    } ]
  }, {
    "tStartMs": 474133,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "Now,"
    } ]
  }, {
    "tStartMs": 474600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Chinese girls"
    } ]
  }, {
    "tStartMs": 476166,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "hang these Hello Kitty dolls everywhere."
    } ]
  }, {
    "tStartMs": 479866,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "Recently, I"
    } ]
  }, {
    "tStartMs": 480800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "was thinking of buying a bicycle"
    } ]
  }, {
    "tStartMs": 483233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "to"
    } ]
  }, {
    "tStartMs": 484233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "go out for exercise,"
    } ]
  }, {
    "tStartMs": 485800,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "and I noticed"
    } ]
  }, {
    "tStartMs": 487866,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "that many girls on social media"
    } ]
  }, {
    "tStartMs": 489700,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "are hanging Hello Kitty keychains on their bicycles."
    } ]
  }, {
    "tStartMs": 493800,
    "dDurationMs": 533,
    "segs": [ {
      "utf8": "wow"
    } ]
  }, {
    "tStartMs": 494333,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Hahaha"
    } ]
  }, {
    "tStartMs": 495266,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": ", it's a new trend"
    } ]
  }, {
    "tStartMs": 496966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "a whole new way of styling!"
    } ]
  }, {
    "tStartMs": 499266,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Why do people like Hello Kitty?"
    } ]
  }, {
    "tStartMs": 501866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "People say that"
    } ]
  }, {
    "tStartMs": 502966,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "Hello Kitty's image doesn't have a mouth."
    } ]
  }, {
    "tStartMs": 506766,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "It's precisely because it doesn't have a mouth"
    } ]
  }, {
    "tStartMs": 509100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "that people use its image"
    } ]
  }, {
    "tStartMs": 512033,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "to freely express their feelings and thoughts."
    } ]
  }, {
    "tStartMs": 516000,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Also,"
    } ]
  }, {
    "tStartMs": 517300,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "Chinese people don't like to use"
    } ]
  }, {
    "tStartMs": 519266,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "their own photos as profile pictures"
    } ]
  }, {
    "tStartMs": 522933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "It's because in China, "
    } ]
  }, {
    "tStartMs": 524633,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "social media also serves a work-related function"
    } ]
  }, {
    "tStartMs": 528866,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Since you often need to use these instant messaging tools "
    } ]
  }, {
    "tStartMs": 530866,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "for work contacts too"
    } ]
  }, {
    "tStartMs": 534033,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So when setting a profile picture, "
    } ]
  }, {
    "tStartMs": 536500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "using your own personal photos as profile pictures"
    } ]
  }, {
    "tStartMs": 539500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "might seem..."
    } ]
  }, {
    "tStartMs": 541700,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Perhaps"
    } ]
  }, {
    "tStartMs": 542900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "sometimes people don't want"
    } ]
  }, {
    "tStartMs": 544666,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "to be the center of attention."
    } ]
  }, {
    "tStartMs": 547466,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Using their own photos"
    } ]
  }, {
    "tStartMs": 548766,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "doesn't accurately convey their recent state. "
    } ]
  }, {
    "tStartMs": 553533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Let me share a few "
    } ]
  }, {
    "tStartMs": 555033,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "Hello Kitty \"meme pics\"  made by netizens"
    } ]
  }, {
    "tStartMs": 558366,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": ". The first one is "
    } ]
  }, {
    "tStartMs": 560400,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "\"hua kai fu gui\" (Flowers Blooming in Prosperity)"
    } ]
  }, {
    "tStartMs": 562433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "As you can see in this picture,"
    } ]
  }, {
    "tStartMs": 564733,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "Hello Kitty appears"
    } ]
  }, {
    "tStartMs": 569200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "as an ordinary office worker"
    } ]
  }, {
    "tStartMs": 571433,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": ", surrounded by flowers. "
    } ]
  }, {
    "tStartMs": 575700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Flowers Blooming in Prosperity"
    } ]
  }, {
    "tStartMs": 577100,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "\" is an auspicious phrase in China"
    } ]
  }, {
    "tStartMs": 580766,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": ", and also"
    } ]
  }, {
    "tStartMs": 581700,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "a lucky symbol"
    } ]
  }, {
    "tStartMs": 584033,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": ", with blooming flowers representing wealth."
    } ]
  }, {
    "tStartMs": 587300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The second picture shows"
    } ]
  }, {
    "tStartMs": 589766,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "Hello... Kitty"
    } ]
  }, {
    "tStartMs": 592233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "appears in this picture as a worker , "
    } ]
  }, {
    "tStartMs": 596033,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "using a computer"
    } ]
  }, {
    "tStartMs": 600633,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": ".right?"
    } ]
  }, {
    "tStartMs": 601200,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "She's working,"
    } ]
  }, {
    "tStartMs": 602600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and there are four Chinese characters:"
    } ]
  }, {
    "tStartMs": 605066,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "yǔ shì wú zhēng (Live in Harmony with the World)"
    } ]
  }, {
    "tStartMs": 607000,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "haha"
    } ]
  }, {
    "tStartMs": 608666,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "yǔ shì wú zhēng"
    } ]
  }, {
    "tStartMs": 610133,
    "dDurationMs": 433,
    "segs": [ {
      "utf8": "ah!"
    } ]
  }, {
    "tStartMs": 610566,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "which perfectly captures the typical Chinese"
    } ]
  }, {
    "tStartMs": 613766,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "\"\"wanting it all but not showing it\"\" mentality."
    } ]
  }, {
    "tStartMs": 615933,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "I want to work hard"
    } ]
  }, {
    "tStartMs": 617966,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": ", but"
    } ]
  }, {
    "tStartMs": 618833,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "I can't show that I'm working too hard"
    } ]
  }, {
    "tStartMs": 622800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "we should  be indifferent to fame and fortune,"
    } ]
  }, {
    "tStartMs": 624766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "live detached from worldly affairs."
    } ]
  }, {
    "tStartMs": 626733,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "This kind of image can be used"
    } ]
  }, {
    "tStartMs": 628133,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "as a meme"
    } ]
  }, {
    "tStartMs": 629500,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "or an emoji"
    } ]
  }, {
    "tStartMs": 630966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "in daily communication. "
    } ]
  }, {
    "tStartMs": 633566,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "sometimes"
    } ]
  }, {
    "tStartMs": 634133,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "Some people also use as their profile picture."
    } ]
  }, {
    "tStartMs": 637366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "The third picture"
    } ]
  }, {
    "tStartMs": 638366,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "has the same background as the previous one"
    } ]
  }, {
    "tStartMs": 641466,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": ", but the text has changed,"
    } ]
  }, {
    "tStartMs": 643300,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "and the surrounding flower pattern has also changed."
    } ]
  }, {
    "tStartMs": 647466,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "It's called \"好运莲莲\" (hǎo yùn lián lián)."
    } ]
  }, {
    "tStartMs": 650266,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "Chinese culture especially likes to use homophones;"
    } ]
  }, {
    "tStartMs": 653733,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "\"好运连连\" (hǎo yùn lián lián) is an idiom."
    } ]
  }, {
    "tStartMs": 656500,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "But as you can see in this picture,"
    } ]
  }, {
    "tStartMs": 659400,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "\"连\" (lián) has been replaced with \"莲\" (lián), meaning lotus."
    } ]
  }, {
    "tStartMs": 662500,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "It's a homophone"
    } ]
  }, {
    "tStartMs": 664166,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": ", so"
    } ]
  }, {
    "tStartMs": 664866,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "you can see"
    } ]
  }, {
    "tStartMs": 667500,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "that the surrounding flowers aren't peonies"
    } ]
  }, {
    "tStartMs": 671200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "or other auspicious flowers,"
    } ]
  }, {
    "tStartMs": 673600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "but lotuses."
    } ]
  }, {
    "tStartMs": 675333,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "This picture"
    } ]
  }, {
    "tStartMs": 677366,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "shows Kitty holding a plant."
    } ]
  }, {
    "tStartMs": 683133,
