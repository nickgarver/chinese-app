  }, {
    "tStartMs": 919566,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "\"it's bad!\" and so on."
    } ]
  }, {
    "tStartMs": 921300,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I argued with her many times,"
    } ]
  }, {
    "tStartMs": 922700,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "but she just kept repeating it."
    } ]
  }, {
    "tStartMs": 925266,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's so strange,"
