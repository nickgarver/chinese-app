  }, {
    "tStartMs": 872033,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "that happened in my family"
    } ]
  }, {
    "tStartMs": 874033,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "my mom went through a phase "
