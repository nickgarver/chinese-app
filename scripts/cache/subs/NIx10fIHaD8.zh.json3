      "utf8": "zhè wán zi ne ， hěn tè bié\n这  丸  子 呢 ， 很  特 别 "
    } ]
  }, {
    "tStartMs": 613900,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "tā wài miàn bāo de shì nuò mǐ\n它 外  面   包  的 是  糯  米"
    } ]
  }, {
    "tStartMs": 618300,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "fēi cháng tè bié\n非  常    特 别 "
    } ]
  }, {
    "tStartMs": 619166,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "dàn shì tā shì ròu wán\n但  是  它 是  肉  丸 "
    } ]
  }, {
    "tStartMs": 621066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "tā wài miàn shì nuò mǐ\n它 外  面   是  糯  米"
    } ]
  }, {
    "tStartMs": 622866,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "lǐ miàn shì ròu\n里 面   是  肉 "
    } ]
  }, {
    "tStartMs": 624466,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "xiāng cháng\n香    肠   "
    } ]
  }, {
    "tStartMs": 626300,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "jī xiōng ròu xiāng cháng\n鸡 胸    肉  香    肠   "
    } ]
  }, {
    "tStartMs": 629533,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "zhè liǎng gēn xiāng cháng shì yòng jī xiōng ròu zuò de\n这  两    根  香    肠    是  用   鸡 胸    肉  做  的"
    } ]
  }, {
    "tStartMs": 635800,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "hái yǒu zhè yí gè\n还  有  这  一 个"
    } ]
  }, {
    "tStartMs": 637300,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "zhè yí gè ne ， shì huǒ guō dǐ liào\n这  一 个 呢 ， 是  火  锅  底 料  "
    } ]
  }, {
    "tStartMs": 640733,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "huǒ guō ， dà jiā dōu zhī dào ba\n火  锅  ， 大 家  都  知  道  吧"
    } ]
  }, {
    "tStartMs": 643233,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "zhōng guó zuì yǒu míng de cài — huǒ guō\n中    国  最  有  名   的 菜  — 火  锅 "
    } ]
  }, {
    "tStartMs": 646833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "huǒ guō dǐ liào\n火  锅  底 料  "
    } ]
  }, {
    "tStartMs": 648500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "dà jiā chī má là huǒ guō de shí hòu\n大 家  吃  麻 辣 火  锅  的 时  候 "
    } ]
  }, {
    "tStartMs": 651100,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "zhè ge ne ， jiù shì yòng lái fàng jìn huǒ guō lǐ de\n这  个 呢 ， 就  是  用   来  放   进  火  锅  里 的"
    } ]
  }, {
    "tStartMs": 655166,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "zhè shì zuò má là tàng de líng hún\n这  是  做  麻 辣 烫   的 灵   魂 "
    } ]
  }, {
    "tStartMs": 657933,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "rú guǒ méi yǒu tā\n如 果  没  有  它"
    } ]
  }, {
    "tStartMs": 658933,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "zhè ge wèi dào jiù bù hǎo chī 、 bú zhèng zōng le\n这  个 味  道  就  不 好  吃  、 不 正    宗   了"
    } ]
  }, {
    "tStartMs": 663366,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "hái yǒu niú nǎi\n还  有  牛  奶 "
    } ]
  }, {
    "tStartMs": 665966,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "má là tàng lǐ miàn qí shí fàng le niú nǎi\n麻 辣 烫   里 面   其 实  放   了 牛  奶 "
    } ]
  }, {
    "tStartMs": 669133,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "dà jiā zhī bu zhī dào\n大 家  知  不 知  道 "
    } ]
  }, {
    "tStartMs": 672300,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "hǎo de ， nà xiàn zài wǒ jiù lái kuài sù dì zuò gè má là tàng ba\n好  的 ， 那 现   在  我 就  来  快   速 地 做  个 麻 辣 烫   吧"
    } ]
  }, {
    "tStartMs": 680966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "diǎn huǒ\n点   火 "
    } ]
  }, {
    "tStartMs": 683000,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "bǎ huǒ dǎ kāi\n把 火  打 开 "
    } ]
  }, {
    "tStartMs": 685266,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "xiān bǎ huǒ guō dǐ liào fàng jìn qù\n先   把 火  锅  底 料   放   进  去"
    } ]
  }, {
    "tStartMs": 690600,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "yì gǔ huǒ guō de xiāng wèi jiù pū bí ér lái le\n一 股 火  锅  的 香    味  就  扑 鼻 而 来  了"
    } ]
  }, {
    "tStartMs": 694466,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "wǒ wén dào le yì gǔ hěn xiāng de huǒ guō xiāng wèi\n我 闻  到  了 一 股 很  香    的 火  锅  香    味 "
    } ]
  }, {
    "tStartMs": 698566,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "jiù shì tā fā chū lái de wèi dào\n就  是  它 发 出  来  的 味  道 "
    } ]
  }, {
    "tStartMs": 701700,
    "dDurationMs": 5733,
    "segs": [ {
      "utf8": "zhè kuài huǒ guō dǐ liào huì zài guō lǐ màn màn dì róng huà\n这  块   火  锅  底 料   会  在  锅  里 慢  慢  地 融   化 "
    } ]
  }, {
    "tStartMs": 709833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "wā ， hǎo xiāng a\n哇 ， 好  香    啊"
    } ]
  }, {
    "tStartMs": 711266,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "yào liú kǒu shuǐ le\n要  流  口  水   了"
    } ]
  }, {
    "tStartMs": 717000,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "huǒ guō dǐ liào wán quán róng huà le ， tài xiāng le\n火  锅  底 料   完  全   融   化  了 ， 太  香    了"
    } ]
  }, {
    "tStartMs": 721433,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "wǒ xiàn zài zhěng gè chú fáng dōu shì huǒ guō dǐ liào de xiāng wèi\n我 现   在  整    个 厨  房   都  是  火  锅  底 料   的 香    味 "
    } ]
  }, {
    "tStartMs": 726900,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "wǒ men kě yǐ bǎ huǒ kāi dà yì diǎn\n我 们  可 以 把 火  开  大 一 点  "
    } ]
  }, {
    "tStartMs": 730833,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "jiē xià lái ne ， wǒ men yào dǎo jìn niú nǎi le\n接  下  来  呢 ， 我 们  要  倒  进  牛  奶  了"
    } ]
  }, {
    "tStartMs": 744433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "hái yǒu dǎo shuǐ\n还  有  倒  水  "
