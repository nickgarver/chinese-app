    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "zhè yàng děng tā quán bù zhǔ shú le jiù kě yǐ chī le\n这  样   等   它 全   部 煮  熟  了 就  可 以 吃  了"
    } ]
  }, {
    "tStartMs": 878200,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "shì bu shì hěn jiǎn dān ne\n是  不 是  很  简   单  呢"
