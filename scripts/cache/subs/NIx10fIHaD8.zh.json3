  }, {
    "tStartMs": 36333,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "nǐ men zhè duàn shí jiān guò dé zěn me yàng ne\n你 们  这  段   时  间   过  得 怎  么 样   呢"
    } ]
  }, {
    "tStartMs": 39500,
    "dDurationMs": 3566,
    "segs": [ {
