  }, {
    "tStartMs": 900066,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "chī má là tàng wǒ kě yǐ chī dào hěn duō bù tóng de shí wù\n吃  麻 辣 烫   我 可 以 吃  到  很  多  不 同   的 食  物"
    } ]
  }, {
