  }, {
    "tStartMs": 5166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "jīn tiān zhè qī jié mù\n今天这期节目\nIn today's episode,"
    } ]
  }, {
    "tStartMs": 6866,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "wǒ zhǔn bèi zuò yì dà lì miàn\n我准备做意大利面\nI'm going to make spaghetti."
    } ]
  }, {
    "tStartMs": 10100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "tā shì wǒ de wǎn cān\n它是我的晚餐\nIt's my dinner."
    } ]
  }, {
    "tStartMs": 12500,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "wǒ jiāng yòng zuì zhēn shí de dòng zuò lái bāng zhù\n我将用最真实的动作来帮助\nI'll use real, everyday actions to help"
    } ]
  }, {
    "tStartMs": 16000,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "nǐ men qù xué huì zhěng gè zuò fàn de guò chéng\n你们去学会整个做饭的过程\nyou learn the entire cooking process"
    } ]
  }, {
    "tStartMs": 19966,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "dāng zhōng huì yòng dào de shí yòng zhōng wén\n当中会用到的实用中文\nand the practical Chinese used along the way."
    } ]
  }, {
    "tStartMs": 23166,
    "dDurationMs": 2200,
    "segs": [ {
