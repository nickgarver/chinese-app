  }, {
    "tStartMs": 48833,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "fēi cháng shí yòng de dòng cí ó\n非常实用的动词哦\nsome very practical verbs."
    } ]
  }, {
    "tStartMs": 50966,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "shǒu xiān wǒ xiān jiào nǐ men yí gè shí yòng de biǎo dá\n首先我先教你们一个实用的表达\nFirst, I'll teach you a useful expression."
    } ]
  }, {
    "tStartMs": 54300,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "jīn tiān wǎn shàng\n今天晚上\nTonight,"
    } ]
  }, {
    "tStartMs": 55500,
    "dDurationMs": 1533,
    "segs": [ {
