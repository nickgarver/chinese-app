    "segs": [ {
      "utf8": "ń\n嗯\nMm."
    } ]
  }, {
    "tStartMs": 983800,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "wǒ zài wēn gē huá ne\n我在温哥华呢\nHere in Vancouver,"
