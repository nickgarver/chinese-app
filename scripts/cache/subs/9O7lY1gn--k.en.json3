    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "bǎ tā gài shàng\n把它盖上\nPut the lid on."
    } ]
  }, {
    "tStartMs": 268666,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "wǒ zhè ge shì yí gè diàn cí lú diàn cí lú\n我这个是一个电磁炉电磁炉\nThis is an induction cooktop."
    } ]
  }, {
    "tStartMs": 272766,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "zán men dǎ kāi kāi guān\n咱们打开开关\nLet's turn it on."
    } ]
  }, {
    "tStartMs": 277700,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "tiáo zhěng yī xià wēn dù\n调整一下温度\nAdjust the temperature."
    } ]
  }, {
    "tStartMs": 281666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "xiàn zài kāi shǐ shāo shuǐ le\n现在开始烧水了\nNow we're heating the water."
    } ]
  }, {
    "tStartMs": 283900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "ń děng shuǐ kāi de guò chéng zhōng\n嗯等水开的过程中\nWhile we wait for it to boil,"
    } ]
  }, {
    "tStartMs": 285800,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "wǒ yào qiè yī xià xī hóng shì ń\n我要切一下西红柿嗯\nI'm going to cut the tomato."
    } ]
  }, {
    "tStartMs": 289833,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "zhè shì wǒ de xī hóng shì\n这是我的西红柿\nThis is my tomato."
    } ]
  }, {
    "tStartMs": 293800,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "tā mō qǐ lái yǐ jīng hěn ruǎn le hěn ruǎn\n它摸起来已经很软了很软\nIt already feels very soft."
    } ]
  }, {
    "tStartMs": 297433,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "yào gǎn kuài chī\n要赶快吃\nI need to eat it soon,"
    } ]
  }, {
    "tStartMs": 298700,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "bù rán gāi huài le\n不然该坏了\nor it will go bad."
    } ]
  }, {
    "tStartMs": 301000,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "hǎo wǒ men xiān bǎ zhè ge xī hóng shì xǐ yī xià\n好我们先把这个西红柿洗一下\nLet's wash the tomato first."
    } ]
  }, {
    "tStartMs": 305666,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "xǐ xǐ xǐ xī hóng shì\n洗洗洗西红柿\nWash, wash, wash the tomato."
    } ]
  }, {
    "tStartMs": 312266,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "zhè ge shì wǒ de yí gè hěn\n这个是我的一个很\nThis is my very"
    } ]
  }, {
    "tStartMs": 314066,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "xiǎo de cài bǎn cài bǎn hěn xiǎo\n小的菜板菜板很小\nsmall cutting board. It's tiny."
    } ]
  }, {
    "tStartMs": 321666,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "zhè ge shì dāo dāo\n这个是刀刀\nThis is a knife."
    } ]
  }, {
    "tStartMs": 325266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "wǒ men jiē xià lái qiè yī xià zhè ge xī hóng shì\n我们接下来切一下这个西红柿\nNext, let's cut the tomato."
    } ]
  }, {
    "tStartMs": 328033,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "bǎ tā qiè kāi\n把它切开\nCut it open."
    } ]
  }, {
    "tStartMs": 332700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "hǎo\n好\nOkay."
    } ]
  }, {
    "tStartMs": 334166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "wǒ yīng gāi zhǐ néng chī diào yí bàn\n我应该只能吃掉一半\nI can probably only eat half of it"
    } ]
  }, {
    "tStartMs": 337066,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "yīn wèi yí gè duì wǒ lái shuō tài duō le\n因为一个对我来说太多了\nbecause a whole one is too much for me."
    } ]
  }, {
    "tStartMs": 339466,
    "dDurationMs": 5534,
    "segs": [ {
      "utf8": "suǒ yǐ ne ná chū wǒ de bǎo xiān mó bǎo xiān mó\n所以呢拿出我的保鲜膜保鲜膜\nSo, I'll take out my plastic wrap."
    } ]
  }, {
    "tStartMs": 348200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "bǎ tā lā chū lái\n把它拉出来\nPull it out."
    } ]
  }, {
    "tStartMs": 349766,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "lā lā chū lái\n拉拉出来\nPull, pull it out."
    } ]
  }, {
    "tStartMs": 351700,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "rán hòu zài sī sī sī kāi\n然后再撕撕撕开\nThen tear it off."
    } ]
  }, {
    "tStartMs": 357800,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "bǎ zhè yí bàn xī hóng shì gěi tā bāo guǒ qǐ lái bāo guǒ\n把这一半西红柿给它包裹起来包裹\nWrap up this half of the tomato."
    } ]
  }, {
    "tStartMs": 365000,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "ń rán hòu wǒ men bǎ tā dòng dào bīng xiāng lǐ ń\n嗯然后我们把它冻到冰箱里嗯\nThen we'll put it in the refrigerator."
    } ]
  }, {
    "tStartMs": 369166,
    "dDurationMs": 8500,
    "segs": [ {
      "utf8": "jiē xià lái wǒ men jì xù qiē qiē qiē qiē xī hóng shì\n接下来我们继续切切切切西红柿\nNext, we'll keep cutting the tomato."
    } ]
  }, {
    "tStartMs": 377666,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "qiè chéng kuài kuài\n切成块块\nCut it into chunks."
    } ]
  }, {
    "tStartMs": 382566,
    "dDurationMs": 6267,
    "segs": [ {
      "utf8": "zài yòng yí gè wǎn bǎ xī hóng shì fàng fàng fàng jìn qù\n再用一个碗把西红柿放放放进去\nThen put the tomato into a bowl."
    } ]
  }, {
    "tStartMs": 389666,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "rán hòu wǒ men ne bǎ dāo chōng xǐ yī xià chōng xǐ\n然后我们呢把刀冲洗一下冲洗\nNow let's rinse the knife."
    } ]
  }, {
    "tStartMs": 396566,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "cài bǎn yě yào chōng xǐ yī xià\n菜板也要冲洗一下\nThe cutting board needs rinsing too."
    } ]
  }, {
    "tStartMs": 399200,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "chōng xǐ yī xià\n冲洗一下\nGive it a rinse."
    } ]
  }, {
    "tStartMs": 401200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "ó shuǐ kāi le\n哦水开了\nOh, the water is boiling!"
    } ]
  }, {
    "tStartMs": 405033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa ó\n哇哦\nWow!"
    } ]
  }, {
    "tStartMs": 406266,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "shuǐ kāi le wǒ men kě yǐ xià miàn le\n水开了我们可以下面了\nThe water is boiling, so we can add the pasta."
    } ]
  }, {
    "tStartMs": 411000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯\nMm."
    } ]
  }, {
    "tStartMs": 413766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "chà bu duō chī zhè xiē ba\n差不多吃这些吧\nThis should be about enough for me."
    } ]
  }, {
    "tStartMs": 416700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "hǎo wǒ men bǎ miàn xià jìn qù\n好我们把面下进去\nLet's put the pasta in."
    } ]
  }, {
    "tStartMs": 419100,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "wǒ men jiào xià miàn xià miàn xià miàn\n我们叫下面下面下面\nWe call this “xià miàn”—putting noodles into boiling water."
    } ]
  }, {
    "tStartMs": 424833,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "dāng rán nǐ yě kě yǐ shuō zhǔ miàn zhǔ miàn\n当然你也可以说煮面煮面\nOf course, you can also say “cook the noodles.”"
    } ]
  }, {
    "tStartMs": 429233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "nà xiàng yì dà lì miàn ne ó\n那像意大利面呢哦\nFor spaghetti,"
    } ]
  }, {
    "tStartMs": 432966,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "yì bān shuō míng shàng dū huì shuō zhǔ 10 fēn zhōng zuǒ yòu\n一般说明上都会说煮10分钟左右\nthe instructions usually say to cook it for about ten minutes."
    } ]
  }, {
    "tStartMs": 436766,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "dàn shì wǒ huì bǐ jiào xǐ huān chī ruǎn\n但是我会比较喜欢吃软\nBut I prefer"
    } ]
  }, {
    "tStartMs": 440366,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "yì diǎn de ruǎn yì diǎn de miàn tiáo\n一点的软一点的面条\nsofter noodles,"
    } ]
  }, {
    "tStartMs": 442766,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ yì bān huì zhǔ gè 15 fēn zhōng ń\n所以我一般会煮个15分钟嗯\nso I usually cook them for fifteen minutes."
    } ]
  }, {
    "tStartMs": 446866,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "nà yǒu de rén huì xǐ huān chī yìng\n那有的人会喜欢吃硬\nSome people prefer"
    } ]
  }, {
    "tStartMs": 449400,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "yì diǎn de yìng yì diǎn de miàn tiáo\n一点的硬一点的面条\nfirmer noodles."
    } ]
  }, {
    "tStartMs": 451766,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "suǒ yǐ dà jiā de è kǒu wèi dōu bù tài yī yàng\n所以大家的呃口味都不太一样\nEveryone's taste is a little different."
    } ]
  }, {
    "tStartMs": 455000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "ruǎn yìng\n软硬\nSoft or firm."
    } ]
  }, {
    "tStartMs": 456600,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "nà nǐ men xǐ huān chī ruǎn yì diǎn\n那你们喜欢吃软一点\nDo you prefer your noodles softer"
    } ]
  }, {
    "tStartMs": 458633,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "de hái shì yìng yì diǎn de ne\n的还是硬一点的呢\nor firmer?"
    } ]
  }, {
    "tStartMs": 460600,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "huān yíng nǐ zài píng lùn qū gào sù wǒ\n欢迎你在评论区告诉我\nTell me in the comments."
    } ]
  }, {
    "tStartMs": 463066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "děng yí xià zuò jiàng zhī de shí hòu ne\n等一下做酱汁的时候呢\nWhen I make the sauce later,"
    } ]
  }, {
    "tStartMs": 465066,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "wǒ huì xiǎng wǎng lǐ miàn fàng yī xiē suàn suàn\n我会想往里面放一些蒜蒜\nI want to add some garlic."
    } ]
  }, {
    "tStartMs": 468566,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "kàn zhè ge shì suàn\n看这个是蒜\nLook, this is garlic."
    } ]
  }, {
    "tStartMs": 470266,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ xiàn zài yào qiè yī xià suàn\n所以我现在要切一下蒜\nSo now I'm going to cut the garlic."
    } ]
  }, {
    "tStartMs": 473000,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "wǒ men yì bān de zuò fǎ shì pāi pāi\n我们一般的做法是拍拍\nUsually, we smash it first."
    } ]
  }, {
    "tStartMs": 476166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "zhè yàng pāi jǐ xià\n这样拍几下\nSmash it a few times,"
    } ]
  }, {
    "tStartMs": 477900,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "rán hòu tā de pí jiù gèng róng yì bō xià lái le\n然后它的皮就更容易剥下来了\nand the skin will be easier to peel off."
    } ]
  }, {
    "tStartMs": 481666,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "suǒ yǐ zhè ge dòng zuò shì pāi\n所以这个动作是拍\nSo this action is “smash.”"
    } ]
  }, {
    "tStartMs": 486366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯\nMm."
    } ]
  }, {
    "tStartMs": 487700,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "nǐ kàn zhè ge pí jiù tè bié róng yì bō xià lái\n你看这个皮就特别容易剥下来\nLook, the skin comes off very easily."
    } ]
  }, {
    "tStartMs": 495300,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "rán hòu zài bǎ tā qiè suì qiè suì\n然后再把它切碎切碎\nThen mince it."
    } ]
  }, {
    "tStartMs": 500300,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "bǎ qiè hǎo de suàn ne\n把切好的蒜呢\nTake the chopped garlic"
    } ]
  }, {
    "tStartMs": 502233,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "fàng dào zhè ge dié zi lǐ\n放到这个碟子里\nand put it on this small plate."
    } ]
  }, {
    "tStartMs": 503966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "zhè shì yí gè dié zi\n这是一个碟子\nThis is a small plate."
    } ]
  }, {
    "tStartMs": 506166,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "fàng fàng dào dié zi lǐ\n放放到碟子里\nPut it on the plate."
    } ]
  }, {
    "tStartMs": 509166,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "lái kàn kàn wǒ de miàn tiáo\n来看看我的面条\nLet's check my noodles."
    } ]
  }, {
    "tStartMs": 512300,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa\n哇\nWow."
    } ]
  }, {
    "tStartMs": 513366,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "wǒ yòng kuài zi zhè yàng zi qù jiǎo bàn\n我用筷子这样子去搅拌\nI'm stirring them like this with chopsticks."
    } ]
  }, {
    "tStartMs": 516833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "jiǎo bàn de shí hòu ne\n搅拌的时候呢\nWhile stirring,"
    } ]
  }, {
    "tStartMs": 518300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "wǒ jiù néng gǎn shòu dào zhè ge\n我就能感受到这个\nI can feel"
    } ]
  }, {
    "tStartMs": 520100,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "miàn tiáo de è ruǎn yìng chéng dù\n面条的呃软硬程度\nhow soft or firm the noodles are."
    } ]
  }, {
    "tStartMs": 524166,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "wǒ jué de xiàn zài zhè ge chà bu duō le kě yǐ le ń\n我觉得现在这个差不多了可以了嗯\nI think they're about right now. They're ready."
    } ]
  }, {
    "tStartMs": 529233,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "jiē xià lái ne\n接下来呢\nNext,"
    } ]
  }, {
    "tStartMs": 530100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "wǒ ná yí gè wǎn\n我拿一个碗\nI'll get a bowl."
    } ]
  }, {
    "tStartMs": 532200,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "ná le yí gè wǎn\n拿了一个碗\nI've got a bowl."
    } ]
  }, {
    "tStartMs": 533766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "zhǔn bèi bǎ miàn tiáo shèng chū lái\n准备把面条盛出来\nI'm getting ready to serve the noodles."
    } ]
  }, {
    "tStartMs": 536700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "wǒ yào xiān jiā jiā\n我要先夹夹\nFirst, I'll pick them up."
    } ]
  }, {
    "tStartMs": 539866,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "yòng kuài zi jiā\n用筷子夹\nPick them up with chopsticks."
    } ]
  }, {
    "tStartMs": 542166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "bǎ miàn tiáo jiā qǐ lái\n把面条夹起来\nLift the noodles up,"
    } ]
  }, {
    "tStartMs": 543666,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "rán hòu shèng dào zhè ge wǎn lǐ\n然后盛到这个碗里\nthen put them into the bowl."
    } ]
  }, {
    "tStartMs": 547200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "wa hā\n哇哈\nWow!"
    } ]
  }, {
    "tStartMs": 550366,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "yīn wèi wǒ yī zhī shǒu ná zhe xiàng jī\n因为我一只手拿着相机\nI'm holding the camera with one hand"
    } ]
  }, {
    "tStartMs": 552800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "lìng wài yī zhī shǒu yòng kuài zi jiā zhè ge miàn tiáo\n另外一只手用筷子夹这个面条\nand picking up the noodles with chopsticks in the other,"
    } ]
  }, {
    "tStartMs": 556633,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "yǒu diǎn bù tài hǎo cāo zuò\n有点不太好操作\nso it's a little difficult."
    } ]
  }, {
    "tStartMs": 560800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "āi zhè ge shí hòu yào shì yǒu yí gè\n哎这个时候要是有一个\nI wish I had"
    } ]
  }, {
    "tStartMs": 562766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "shè yǐng shī bāng wǒ pāi jiù hǎo le\n摄影师帮我拍就好了\na camera operator to film me right now."
    } ]
  }, {
    "tStartMs": 565266,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "ń zhēn de\n嗯真的\nSeriously."
    } ]
  }, {
    "tStartMs": 566900,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "zì jǐ yí gè rén pāi zhè zhǒng vlog jiù shì huì\n自己一个人拍这种vlog就是会\nWhen you film this kind of vlog by yourself,"
    } ]
  }, {
    "tStartMs": 570833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "yǒu de shí hòu huì shǒu máng jiǎo luàn\n有的时候会手忙脚乱\nsometimes everything gets a bit chaotic."
    } ]
  }, {
    "tStartMs": 573566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "zhè shì gè chéng yǔ ó jiào nǐ men\n这是个成语哦教你们\nThis is an idiom I'm teaching you:"
    } ]
  }, {
    "tStartMs": 575666,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "shǒu máng jiǎo luàn\n手忙脚乱\n“shǒu máng jiǎo luàn”—to be in a fluster."
    } ]
  }, {
    "tStartMs": 577900,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "nǐ men kě yǐ qù chá yī chá shì shén me yì si\n你们可以去查一查是什么意思\nYou can look up what it means."
    } ]
  }, {
    "tStartMs": 580733,
    "dDurationMs": 6533,
    "segs": [ {
      "utf8": "hǎo wǒ jì xù bǎ miàn tiáo jiā qǐ lái shèng dào wǎn lǐ\n好我继续把面条夹起来盛到碗里\nOkay, I'll keep lifting the noodles and serving them into the bowl."
    } ]
  }, {
    "tStartMs": 588500,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "hǎo de\n好的\nAll right."
    } ]
  }, {
    "tStartMs": 589233,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "nà jiē xià lái wǒ yào kāi shǐ zuò jiàng zhī zuò jiàng zhī\n那接下来我要开始做酱汁做酱汁\nNext, I'm going to make the sauce."
    } ]
  }, {
    "tStartMs": 594600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "nà wǒ yào huàn lìng wài yí gè guō\n那我要换另外一个锅\nI'll switch to another pan."
    } ]
  }, {
    "tStartMs": 600433,
    "dDurationMs": 7233,
    "segs": [ {
      "utf8": "zhè ge zhè ge shì yí gè chǎo guō chǎo guō ń\n这个这个是一个炒锅炒锅嗯\nThis is a wok—a stir-fry pan."
    } ]
  }, {
    "tStartMs": 608166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "yòng tā lái zuò jiàng zhī\n用它来做酱汁\nI'll use it to make the sauce."
    } ]
  }, {
    "tStartMs": 610300,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "ó duì le\n哦对了\nOh, right!"
    } ]
  }, {
    "tStartMs": 611066,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "wǒ yào dài yī xià wéi qún\n我要带一下围裙\nI need to put on an apron."
    } ]
  }, {
    "tStartMs": 614033,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "děng wǒ yī xià\n等我一下\nWait a moment."
    } ]
  }, {
    "tStartMs": 618100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "nǐ men kàn zhè ge shì wéi qún wéi qún ń\n你们看这个是围裙围裙嗯\nLook, this is an apron."
    } ]
  }, {
    "tStartMs": 623033,
    "dDurationMs": 5733,
    "segs": [ {
      "utf8": "zuò fàn zhī qián jiù yīng gāi bǎ tā dài dài shàng dài wéi qún\n做饭之前就应该把它戴戴上戴围裙\nYou should put it on before cooking—wear an apron."
    } ]
  }, {
    "tStartMs": 629833,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "wǒ yào xiān bǎ zhè ge jiàng zhī dǎ kāi\n我要先把这个酱汁打开\nFirst, I need to open this sauce."
    } ]
  }, {
    "tStartMs": 633466,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "zhè ge shì yì dà lì miàn jiàng\n这个是意大利面酱\nThis is spaghetti sauce."
    } ]
  }, {
    "tStartMs": 636066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa\n哇\nWow."
    } ]
  }, {
    "tStartMs": 637600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "zhè ge hǎo nán níng a\n这个好难拧啊\nThis is so hard to twist open."
    } ]
  }, {
    "tStartMs": 639900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "zhè ge dòng zuò shì níng níng\n这个动作是拧拧\nThis action is “twist.”"
    } ]
  }, {
    "tStartMs": 642666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "tā xiàn zài fēi cháng de jǐn\n它现在非常的紧\nIt's very tight right now."
    } ]
  }, {
    "tStartMs": 644666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "fēi cháng jǐn wǒ hěn nán níng kāi\n非常紧我很难拧开\nIt's so tight that I can't twist it open."
    } ]
  }, {
    "tStartMs": 647800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "yīn wèi tā yǒu yī xiē huá huá\n因为它有一些滑滑\nIt's also a little slippery"
    } ]
  }, {
    "tStartMs": 650433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "shàng miàn yǒu shuǐ\n上面有水\nbecause there's water on it."
    } ]
  }, {
    "tStartMs": 651866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "a yǒu diǎn huá\n啊有点滑\nIt's a bit slippery."
    } ]
  }, {
    "tStartMs": 653500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "wǒ kàn yī xià\n我看一下\nLet me see."
    } ]
  }, {
    "tStartMs": 655433,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "ná yí gè máo jīn ná yí gè máo jīn zhè yàng shì yī shì\n拿一个毛巾拿一个毛巾这样试一试\nI'll get a towel and try it this way."
    } ]
  }, {
    "tStartMs": 659300,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "a bù xíng\n啊不行\nNo, that didn't work."
    } ]
  }, {
    "tStartMs": 660000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "hái shì hěn huá\n还是很滑\nIt's still very slippery."
    } ]
  }, {
    "tStartMs": 662766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "a zěn me bàn\n啊怎么办\nWhat should I do?"
    } ]
  }, {
    "tStartMs": 665366,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "yòng lì\n用力\nUse more force."
    } ]
  }, {
    "tStartMs": 667633,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "shǐ jìn\n使劲\nPush harder!"
    } ]
  }, {
    "tStartMs": 669466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "āi yā hái shì bù xíng\n哎呀还是不行\nOh, it still won't open."
    } ]
  }, {
    "tStartMs": 671066,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "tiān nà zhè ge zhēn de hěn nán níng kāi ya\n天呐这个真的很难拧开呀\nOh my gosh, this is really hard to open!"
    } ]
  }, {
    "tStartMs": 675900,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "péng yǒu men yù dào zhè zhǒng qíng kuàng\n朋友们遇到这种情况\nFriends, when this happens,"
    } ]
  }, {
    "tStartMs": 678166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "nǐ men huì zěn me bàn\n你们会怎么办\nwhat do you do?"
    } ]
  }, {
    "tStartMs": 680500,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "wǒ zài shì shì lìng wài yí gè fāng fǎ\n我再试试另外一个方法\nI'll try another method."
    } ]
  }, {
    "tStartMs": 682966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "bǎ tā zhè yàng dào guò lái dào guò lái\n把它这样倒过来倒过来\nTurn it upside down like this."
    } ]
  }, {
    "tStartMs": 686100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "rán hòu pāi dǐ bù pāi\n然后拍底部拍\nThen tap the bottom."
    } ]
  }, {
    "tStartMs": 692166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "zhè xiē dōu shì wǒ zài wǎng shàng xué dào de fāng fǎ\n这些都是我在网上学到的方法\nI learned all these methods online."
    } ]
  }, {
    "tStartMs": 694866,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "bù zhī dào guǎn bù guǎn yòng a\n不知道管不管用啊\nI don't know if they'll work."
    } ]
  }, {
    "tStartMs": 698400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "hái shì bù xíng\n还是不行\nStill no."
    } ]
  }, {
    "tStartMs": 701900,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "qì sǐ wǒ le\n气死我了\nThis is making me so mad!"
    } ]
  }, {
    "tStartMs": 704366,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "ná yī zhāng zhǐ\n拿一张纸\nI'll get a piece of paper."
    } ]
  }, {
    "tStartMs": 709800,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "ná le yí gè zhǐ\n拿了一个纸\nI've got some paper."
    } ]
  }, {
    "tStartMs": 711466,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "miàn jīn zhǐ kàn kàn xíng bù xíng\n面巾纸看看行不行\nLet's see if a tissue works."
    } ]
  }, {
    "tStartMs": 716766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "a wǒ hū rán xiǎng qǐ lái\n啊我忽然想起来\nOh, I suddenly remembered:"
    } ]
  }, {
    "tStartMs": 718233,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "zhè shì yī píng xīn de xīn de jiàng méi kāi fēng ó\n这是一瓶新的新的酱没开封哦\nthis is a new, unopened jar of sauce!"
    } ]
  }, {
    "tStartMs": 725233,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ bì xū ne\n所以我必须呢\nSo I have to"
    } ]
  }, {
    "tStartMs": 726700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "xiān yòng sháo zi qiào yī xià tā\n先用勺子撬一下它\npry it open with a spoon first."
    } ]
  }, {
    "tStartMs": 730800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "zhè ge shì qiào\n这个是撬\nThis action is “pry.”"
    } ]
  }, {
    "tStartMs": 732800,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "yòng sháo zi zhè yàng shì qiào qiào\n用勺子这样是撬撬\nUsing a spoon like this is “prying.”"
    } ]
  }, {
    "tStartMs": 738800,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "āi nǐ men tīng dào nà ge shēng yīn le ma\n哎你们听到那个声音了吗\nHey, did you hear that sound?"
    } ]
  }, {
    "tStartMs": 742066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "zhè huí yìng gāi méi wèn tí le\n这回应该没问题了\nIt should be fine now."
    } ]
  }, {
    "tStartMs": 745633,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "a zhōng yú dǎ kāi le\n啊终于打开了\nAh, I finally opened it!"
    } ]
  }, {
    "tStartMs": 748266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wǒ xiàn zài ne\n我现在呢\nNow,"
    } ]
  }, {
    "tStartMs": 749066,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "yào chǎo yī xià zhè ge jiàng zhī\n要炒一下这个酱汁\nI'm going to cook the sauce."
    } ]
  }, {
    "tStartMs": 751800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "è\n呃\nUh..."
    } ]
  }, {
    "tStartMs": 753066,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "zài chǎo zhī qián ne\n在炒之前呢\nBefore I start cooking,"
    } ]
  }, {
    "tStartMs": 754400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "wǒ yào xiān dǎ kāi zhè ge chōu yóu yān jī\n我要先打开这个抽油烟机\nI need to turn on the range hood."
    } ]
  }, {
    "tStartMs": 757633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "zhè ge shì chōu yóu yān jī\n这个是抽油烟机\nThis is the range hood."
    } ]
  }, {
    "tStartMs": 762600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "hǎo dǎ kāi le\n好打开了\nOkay, it's on."
    } ]
  }, {
    "tStartMs": 764733,
    "dDurationMs": 5533,
    "segs": [ {
      "utf8": "rán hòu wǒ men wǎng guō lǐ dào yī xiē yóu dào yóu\n然后我们往锅里倒一些油倒油\nNow we'll pour some oil into the pan."
    } ]
  }, {
    "tStartMs": 771200,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "jiē xià lái děng yóu rè le jiù kě yǐ chǎo le\n接下来等油热了就可以炒了\nOnce the oil is hot, we can start cooking."
    } ]
  }, {
    "tStartMs": 774933,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "wǒ yì bān huì yòng shǒu qù shì yóu wēn\n我一般会用手去试油温\nI usually hold my hand over it to test the temperature."
    } ]
  }, {
    "tStartMs": 779400,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "chà bu duō le\n差不多了\nThat's about right."
    } ]
  }, {
    "tStartMs": 780933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "xiān bǎ suàn dào jìn guō lǐ\n先把蒜倒进锅里\nFirst, put the garlic into the pan."
    } ]
  }, {
    "tStartMs": 785633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "fān chǎo jǐ xià\n翻炒几下\nStir-fry it a few times."
    } ]
  }, {
    "tStartMs": 787633,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "fān chǎo fān chǎo\n翻炒翻炒\nStir-fry, stir-fry."
    } ]
  }, {
    "tStartMs": 793633,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "wǒ ne hái hěn xǐ huān zhè yàng qù wén yī xià wèi dào\n我呢还很喜欢这样去闻一下味道\nI also like to smell it like this."
    } ]
  }, {
    "tStartMs": 797433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "ń hǎo xiāng a\n嗯好香啊\nMm, it smells so good!"
    } ]
  }, {
    "tStartMs": 801066,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "hòu miàn ne\n后面呢\nAfter that,"
    } ]
  }, {
    "tStartMs": 801766,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "wǒ bǎ ròu hé xī hóng shì dōu fàng jìn le guō lǐ\n我把肉和西红柿都放进了锅里\nI put the meat and tomato into the pan."
    } ]
  }, {
    "tStartMs": 805800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "jì xù chǎo chǎo\n继续炒炒\nKeep stir-frying."
    } ]
  }, {
    "tStartMs": 812000,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "chà bu duō le\n差不多了\nThat's about right."
    } ]
  }, {
    "tStartMs": 813033,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "wǒ jiē xià lái yào bǎ jiàng zhī dào jìn qù\n我接下来要把酱汁倒进去\nNext, I'm going to pour in the sauce."
    } ]
  }, {
    "tStartMs": 820000,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "yòng sháo zi ne yǎo\n用勺子呢舀\nUse a spoon to scoop it."
    } ]
  }, {
    "tStartMs": 822166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "zhè ge shì yǎo\n这个是舀\nThis is “scoop.”"
    } ]
  }, {
    "tStartMs": 825000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "yǎo chū lái a\n舀出来啊\nScoop it out."
    } ]
  }, {
    "tStartMs": 831500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "nà wǒ zhè lǐ ne\n那我这里呢\nHere,"
    } ]
  }, {
    "tStartMs": 832500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "shì tiáo zhěng huǒ de\n是调整火的\nI can adjust the heat."
    } ]
  }, {
    "tStartMs": 836000,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "zhè ge shì jiā hào\n这个是加号\nThis is the plus sign."
    } ]
  }, {
    "tStartMs": 837600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "jiā hào jiù shì huǒ zài dà yī diǎn\n加号就是火再大一点\nThe plus sign makes the heat higher."
    } ]
  }, {
    "tStartMs": 840500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "jiǎn hào jiù shì huǒ xiǎo yì diǎn\n减号就是火小一点\nThe minus sign makes the heat lower."
    } ]
  }, {
    "tStartMs": 844500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "xiǎo huǒ\n小火\nLow heat."
    } ]
  }, {
    "tStartMs": 847100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "dà huǒ\n大火\nHigh heat."
    } ]
  }, {
    "tStartMs": 848900,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "rán hòu zhè ge de huà wǒ men jiào wǎ\n然后这个的话我们叫瓦\nThis unit is called a watt."
    } ]
  }, {
    "tStartMs": 851300,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "bǐ rú shuō zhè ge shì 800 wǎ\n比如说这个是800瓦\nFor example, this is 800 watts."
    } ]
  }, {
    "tStartMs": 854466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "1 qiān wǎ\n1千瓦\nOne thousand watts."
    } ]
  }, {
    "tStartMs": 857466,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "600 wǎ\n600瓦\nSix hundred watts."
    } ]
  }, {
    "tStartMs": 860200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "sā yī xiē yán\n撒一些盐\nSprinkle in some salt."
    } ]
  }, {
    "tStartMs": 862200,
    "dDurationMs": 2500,
    "segs": [ {
