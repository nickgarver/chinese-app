{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 33,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "嗨，大家好"
    } ]
  }, {
    "tStartMs": 1533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "欢迎回到我的频道"
    } ]
  }, {
    "tStartMs": 3733,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我是安吉拉"
    } ]
  }, {
    "tStartMs": 5600,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "今天继续咱们的中文播客"
    } ]
  }, {
    "tStartMs": 9933,
    "dDurationMs": 8967,
    "segs": [ {
      "utf8": "今天，呢我会把视频中出现的十个非常常用的汉语单词标出来"
    } ]
  }, {
    "tStartMs": 19566,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "并且把它们的意思和发音放到视频的最后"
    } ]
  }, {
    "tStartMs": 26433,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "我希望大家今天看完这个视频"
    } ]
  }, {
    "tStartMs": 30833,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "能够掌握十个汉语单词"
    } ]
  }, {
    "tStartMs": 35633,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "掌握的意思呢就是“学会”"
    } ]
  }, {
    "tStartMs": 38533,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "掌，手掌"
    } ]
  }, {
    "tStartMs": 39466,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "握，握住"
    } ]
  }, {
    "tStartMs": 42166,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "手掌握住，它就是你的东西了"
    } ]
  }, {
    "tStartMs": 45933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "你就学会了"
    } ]
  }, {
    "tStartMs": 47500,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "这就是“掌握”的意思"
    } ]
  }, {
    "tStartMs": 49900,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我希望大家今天看完这个视频"
    } ]
  }, {
    "tStartMs": 53200,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "能够掌握十个单词"
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "其实如果一段视频能够学会十个单词的话"
    } ]
  }, {
    "tStartMs": 62466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "已经非常非常厉害了"
    } ]
  }, {
    "tStartMs": 65133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "好吧咱们现在开始吧"
    } ]
  }, {
    "tStartMs": 67733,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "今天我想跟大家聊的话题是“凡尔赛”"
    } ]
  }, {
    "tStartMs": 72933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "听到凡尔赛这个词呢"
    } ]
  }, {
    "tStartMs": 75266,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "大家肯定想到的是法国的凡尔赛"
    } ]
  }, {
    "tStartMs": 80100,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "没错，凡尔赛呢是法国的一个城市"
    } ]
  }, {
    "tStartMs": 85600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "应该是在巴黎附近吧"
    } ]
  }, {
    "tStartMs": 88533,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "我没有去过"
    } ]
  }, {
    "tStartMs": 89800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "这是我在网上查的"
    } ]
  }, {
    "tStartMs": 92666,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "那在那儿呢有一个非常有名的皇宫"
    } ]
  }, {
    "tStartMs": 98233,
    "dDurationMs": 6167,
    "segs": [ {
      "utf8": "以前法国国王的一个皇宫，叫凡尔赛宫"
    } ]
  }, {
    "tStartMs": 104666,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "那这个皇宫非常的豪华"
    } ]
  }, {
    "tStartMs": 107933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "也非常的有名"
    } ]
  }, {
    "tStartMs": 109866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "像我根本没有去过法国"
    } ]
  }, {
    "tStartMs": 112466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我也听说过这个皇宫"
    } ]
  }, {
    "tStartMs": 116200,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "那很多去法国旅游的人呢"
    } ]
  }, {
    "tStartMs": 119433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "去巴黎旅游的人"
    } ]
  }, {
    "tStartMs": 121633,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "也一定会去这个凡尔赛宫打卡"
    } ]
  }, {
    "tStartMs": 126400,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "其实啊中国也有一个“凡尔赛”"
    } ]
  }, {
    "tStartMs": 129733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "今天视频的主题呢"
    } ]
  }, {
    "tStartMs": 131733,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "我就想跟大家聊一聊中国这个凡尔赛"
    } ]
  }, {
    "tStartMs": 136300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "中国的凡尔赛不是一个皇宫"
    } ]
  }, {
    "tStartMs": 140233,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "也不是一个城市"
    } ]
  }, {
    "tStartMs": 142233,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "不是一个地方"
    } ]
  }, {
    "tStartMs": 143500,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "它是汉语中、中文中最近新出现的一个单词"
    } ]
  }, {
    "tStartMs": 150333,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "一个新词"
    } ]
  }, {
    "tStartMs": 152333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "最开始的时候呢"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "它是一个网络流行语"
    } ]
  }, {
    "tStartMs": 157133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "慢慢地，用的人越来越多"
    } ]
  }, {
    "tStartMs": 160133,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "尤其是年轻人用的越来越多"
    } ]
  }, {
    "tStartMs": 164066,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "它现在已经几乎变成了一个常规词汇了"
    } ]
  }, {
    "tStartMs": 169466,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "大家在学习中文的时候"
    } ]
  }, {
    "tStartMs": 172333,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "有没有遇见过这个词呢"
    } ]
  }, {
    "tStartMs": 175700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "有没有听到过这个词呢"
    } ]
  }, {
    "tStartMs": 179200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "如果你经常刷中国的社交媒体"
    } ]
  }, {
    "tStartMs": 183833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "看中国的短视频呀"
    } ]
  }, {
    "tStartMs": 186800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "或者说你有中国的朋友"
    } ]
  }, {
    "tStartMs": 189466,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "你可能会看到这样的表达"
    } ]
  }, {
    "tStartMs": 192433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "听到这样的表达"
    } ]
  }, {
    "tStartMs": 194933,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你这人怎么这么凡尔赛呀"
    } ]
  }, {
    "tStartMs": 198033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "你别这么凡尔赛了行吗"
    } ]
  }, {
    "tStartMs": 201033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "你这是典型的凡尔赛啊"
    } ]
  }, {
    "tStartMs": 204233,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "那大家知道凡尔赛是什么意思吗"
    } ]
  }, {
    "tStartMs": 208000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "简单的来说"
    } ]
  }, {
    "tStartMs": 209300,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "凡尔赛是一种说话方式"
    } ]
  }, {
    "tStartMs": 212833,
    "dDurationMs": 7700,
    "segs": [ {
      "utf8": "它是用一种抱怨或者不满的语气来炫耀自己的一种说话方式"
    } ]
  }, {
    "tStartMs": 221433,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "炫耀自己"
    } ]
  }, {
    "tStartMs": 222933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "显摆自己"
    } ]
  }, {
    "tStartMs": 224633,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "显摆也是炫耀的意思"
    } ]
  }, {
    "tStartMs": 227866,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "炫耀自己很牛、很牛逼、很厉害"
    } ]
  }, {
    "tStartMs": 232133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "很有钱或者其他的"
    } ]
  }, {
    "tStartMs": 234833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "炫耀什么都可以"
    } ]
  }, {
    "tStartMs": 236533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "重点是呢"
    } ]
  }, {
    "tStartMs": 237700,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "它不是直接的炫耀"
    } ]
  }, {
    "tStartMs": 240133,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "而是用一种抱怨的语气"
    } ]
  }, {
    "tStartMs": 243100,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "或者不满的语气"
    } ]
  }, {
    "tStartMs": 245066,
    "dDurationMs": 6134,
    "segs": [ {
      "utf8": "在不经意之间炫耀自己的一种说话方式"
    } ]
  }, {
    "tStartMs": 251200,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我举个例子大家就知道了"
    } ]
  }, {
    "tStartMs": 254233,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "比如说一个人跟你说"
    } ]
  }, {
    "tStartMs": 257200,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "哎我的新房子太烦了"
    } ]
  }, {
    "tStartMs": 259833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "房间太多了"
    } ]
  }, {
    "tStartMs": 261866,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "每天我都要花很长的时间打扫卫生"
    } ]
  }, {
    "tStartMs": 266700,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "太累了"
    } ]
  }, {
    "tStartMs": 268733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "那表面上看呢"
    } ]
  }, {
    "tStartMs": 270500,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "他是在抱怨每天收拾房间、打扫房间很累"
    } ]
  }, {
    "tStartMs": 276400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那实际上呢"
    } ]
  }, {
    "tStartMs": 277800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "或者别人听起来呢"
    } ]
  }, {
    "tStartMs": 280033,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "其实是他想在表达他的新房子很大"
    } ]
  }, {
    "tStartMs": 284833,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "他有一个很大的房子、他很有钱"
    } ]
  }, {
    "tStartMs": 290033,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "你看啊，他没有直接说他很有钱"
    } ]
  }, {
    "tStartMs": 293900,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "没有直接地炫耀他的房子很大"
    } ]
  }, {
    "tStartMs": 297466,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "他是用一种不满的语气"
    } ]
  }, {
    "tStartMs": 300600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "用一种很烦的语气"
    } ]
  }, {
    "tStartMs": 302866,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "不经意之间炫耀了他的房子"
    } ]
  }, {
    "tStartMs": 306700,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "这就是一种典型的凡尔赛的说话方式"
    } ]
  }, {
    "tStartMs": 311533,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "那我们也把这种说话方式叫做“凡尔赛文学”"
    } ]
  }, {
    "tStartMs": 317266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "这里的文学并不是一个学科"
    } ]
  }, {
    "tStartMs": 321100,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "它是一种调侃的方式"
    } ]
  }, {
    "tStartMs": 324466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "或者说是一种开玩笑的方式"
    } ]
  }, {
    "tStartMs": 327700,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "甚至是有一些讽刺"
    } ]
  }, {
    "tStartMs": 331233,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "来讽刺这种炫耀的说话方式"
    } ]
  }, {
    "tStartMs": 334833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "对它是一种讽刺"
    } ]
  }, {
    "tStartMs": 336733,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "所以说它是凡尔赛文学"
    } ]
  }, {
    "tStartMs": 339800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "大家能理解吗"
    } ]
  }, {
    "tStartMs": 341466,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "凡尔赛这个词儿是怎么来的呢"
    } ]
  }, {
    "tStartMs": 344733,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "虽然我在生活中也会经常说这个词"
    } ]
  }, {
    "tStartMs": 349300,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "但是我还真不知道它是怎么来的"
    } ]
  }, {
    "tStartMs": 353400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "于是我就去上网查了一下"
    } ]
  }, {
    "tStartMs": 356733,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "原来是在2020年的时候"
    } ]
  }, {
    "tStartMs": 360466,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "大概六年前了"
    } ]
  }, {
    "tStartMs": 362700,
    "dDurationMs": 7300,
    "segs": [ {
      "utf8": "有一个人在网上用这种方式炫耀她自己的生活"
    } ]
  }, {
    "tStartMs": 370300,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "显摆她自己豪华的生活"
    } ]
  }, {
    "tStartMs": 373800,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "显摆她很有钱"
    } ]
  }, {
    "tStartMs": 375800,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "显摆她自己的豪宅，很豪华的房子"
    } ]
  }, {
    "tStartMs": 380233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "显摆她的老公特别宠爱她"
    } ]
  }, {
    "tStartMs": 383700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "很多人看到之后都给她评论"
    } ]
  }, {
    "tStartMs": 387500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "其中有一个人呀"
    } ]
  }, {
    "tStartMs": 389466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "认为她这种炫耀的方式"
    } ]
  }, {
    "tStartMs": 392866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "她炫耀的这些东西"
    } ]
  }, {
    "tStartMs": 395300,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "特别像一部日本漫画《凡尔赛玫瑰》"
    } ]
  }, {
    "tStartMs": 400733,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "这本漫画中描写的法国贵族的生活"
    } ]
  }, {
    "tStartMs": 405333,
    "dDurationMs": 7567,
    "segs": [ {
      "utf8": "于是呢就用凡尔赛这个词来讽刺她的这种炫耀"
    } ]
  }, {
    "tStartMs": 412900,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "慢慢地，这个词就流传开了"
    } ]
  }, {
    "tStartMs": 417100,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "现在就变成了一个大家非常常用的一个词汇了"
    } ]
  }, {
    "tStartMs": 422833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "咱们现在再举几个例子"
    } ]
  }, {
    "tStartMs": 425466,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "看看凡尔赛这种炫耀的方式有什么特点"
    } ]
  }, {
    "tStartMs": 431033,
    "dDurationMs": 6067,
    "segs": [ {
      "utf8": "第一个特点就是先贬低自己、再抬高自己"
    } ]
  }, {
    "tStartMs": 437100,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "贬低、抬高"
    } ]
  }, {
    "tStartMs": 439400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "先把自己说得很不好"
    } ]
  }, {
    "tStartMs": 442300,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "然后呢再让大家觉得他很好"
    } ]
  }, {
    "tStartMs": 446500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "这就叫先贬低自己，把自己放低"
    } ]
  }, {
    "tStartMs": 450200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "把自己弄得很低"
    } ]
  }, {
    "tStartMs": 452066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "再把自己弄得很高"
    } ]
  }, {
    "tStartMs": 454066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "贬低、抬高"
    } ]
  }, {
    "tStartMs": 456466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "也就是说"
    } ]
  }, {
    "tStartMs": 457700,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "说话的时候先说自己不好"
    } ]
  }, {
    "tStartMs": 461100,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "很烦、很烦恼、很不满"
    } ]
  }, {
    "tStartMs": 464400,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "实际上呢，是想让大家觉得他自己很厉害、很牛逼"
    } ]
  }, {
    "tStartMs": 470800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那比如说有一个人跟你说"
    } ]
  }, {
    "tStartMs": 473400,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "哎呀我每天早上太烦了"
    } ]
  }, {
    "tStartMs": 475833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "柜子里都是包儿"
    } ]
  }, {
    "tStartMs": 477700,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "我都不知道每天背哪个包儿出门"
    } ]
  }, {
    "tStartMs": 482000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "她是在烦恼吗？"
    } ]
  }, {
    "tStartMs": 484466,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "不是，她其实是在炫耀自己"
    } ]
  }, {
    "tStartMs": 487833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "她有很多名牌包儿"
    } ]
  }, {
    "tStartMs": 490433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "有很多大牌儿的包儿"
    } ]
  }, {
    "tStartMs": 492900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "再比如说"
    } ]
  }, {
    "tStartMs": 493833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "有一个人跟你说"
    } ]
  }, {
    "tStartMs": 495466,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "哎呀真烦"
    } ]
  }, {
    "tStartMs": 496533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我每天吃这么多东西"
    } ]
  }, {
    "tStartMs": 498600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我就是不长肉"
    } ]
  }, {
    "tStartMs": 500033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "我什么时候才能胖一点啊"
    } ]
  }, {
    "tStartMs": 503033,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "表面上她是在抱怨自己、嫌自己瘦"
    } ]
  }, {
    "tStartMs": 507200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "嫌自己吃东西不长肉"
    } ]
  }, {
    "tStartMs": 510100,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "实际上呢、或者别人听起来呢"
    } ]
  }, {
    "tStartMs": 513433,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "她是在炫耀自己不管怎么吃都不会长胖"
    } ]
  }, {
    "tStartMs": 518833,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "都有一个好的身材"
    } ]
  }, {
    "tStartMs": 521066,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "那么胖子听见的话会很生气的，对不对"
    } ]
  }, {
    "tStartMs": 525066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "第二个特点"
    } ]
  }, {
    "tStartMs": 526333,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "凡尔赛的人呢说话会很随意"
    } ]
  }, {
    "tStartMs": 530233,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "在不经意之间炫耀自己"
    } ]
  }, {
    "tStartMs": 534000,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "他们不会直接地炫耀"
    } ]
  }, {
    "tStartMs": 536466,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "不会直接跟你说你看我多有钱"
    } ]
  }, {
    "tStartMs": 539800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "你看我老公对我多好"
    } ]
  }, {
    "tStartMs": 542066,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "你看我多聪明"
    } ]
  }, {
    "tStartMs": 543900,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那这些不是凡尔赛"
    } ]
  }, {
    "tStartMs": 545866,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "这些太直接了"
    } ]
  }, {
    "tStartMs": 547533,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "这种直接的炫耀不是凡尔赛哦"
    } ]
  }, {
    "tStartMs": 551300,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "凡尔赛的人呢会用很随意的语气"
    } ]
  }, {
    "tStartMs": 556133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "好像不小心说出来一样"
    } ]
  }, {
    "tStartMs": 558833,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "假装自己不是在炫耀"
    } ]
  }, {
    "tStartMs": 562033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "那比如说"
    } ]
  }, {
    "tStartMs": 562833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "有一个人跟你说，"
    } ]
  }, {
    "tStartMs": 564833,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "哎，我家旁边的那个大牌，LV店"
    } ]
  }, {
    "tStartMs": 569000,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我今天路过的时候，发现有好多人啊"
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "我才想起来，我上次新买的包儿我还没背过呢"
    } ]
  }, {
    "tStartMs": 578133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "那这就是一个不经意的炫耀"
    } ]
  }, {
    "tStartMs": 581466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "她好像在随便的聊天儿"
    } ]
  }, {
    "tStartMs": 584400,
    "dDurationMs": 6666,
    "segs": [ {
      "utf8": "但是呢你又可以听出来她在炫耀自己住的地方很繁华"
    } ]
  }, {
    "tStartMs": 591300,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "旁边就是LV店"
    } ]
  }, {
    "tStartMs": 593433,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "她还有很多包儿"
    } ]
  }, {
    "tStartMs": 595100,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "她有很多LV的包儿都背不过来"
    } ]
  }, {
    "tStartMs": 598533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "太多了，没有时间背"
    } ]
  }, {
    "tStartMs": 601100,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "那这就是一种不经意之间的炫耀"
    } ]
  }, {
    "tStartMs": 605700,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "第三个特点"
    } ]
  }, {
    "tStartMs": 606933,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "凡尔赛的人呢喜欢用别人的话来夸自己"
    } ]
  }, {
    "tStartMs": 612200,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "他不是直接用自己的话来炫耀"
    } ]
  }, {
    "tStartMs": 616033,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "而是通过别人的嘴"
    } ]
  }, {
    "tStartMs": 618333,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "通过别人说的话来炫耀自己"
    } ]
  }, {
    "tStartMs": 622800,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "比如说哎呀我男朋友总说我像一个明星"
    } ]
  }, {
    "tStartMs": 627666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "他每天都说我很像那个明星"
    } ]
  }, {
    "tStartMs": 630133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我都烦死了"
    } ]
  }, {
    "tStartMs": 631466,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "我一点儿都不想和明星长得一样"
    } ]
  }, {
    "tStartMs": 634866,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "那这个就是用男朋友的话来炫耀自己长得很漂亮"
    } ]
  }, {
    "tStartMs": 641066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "长得像明星"
    } ]
  }, {
    "tStartMs": 643066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "这就是凡尔赛的三个特点"
    } ]
  }, {
    "tStartMs": 646700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "那大家可能会问"
    } ]
  }, {
    "tStartMs": 648500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "中国人为什么会凡尔赛呢"
    } ]
  }, {
    "tStartMs": 651533,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "有话直接说不好吗"
    } ]
  }, {
    "tStartMs": 654466,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这是一个很好的问题"
    } ]
  }, {
    "tStartMs": 656933,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "其实啊在中国的文化里"
    } ]
  }, {
    "tStartMs": 660233,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "大家特别喜欢谦虚"
    } ]
  }, {
    "tStartMs": 663433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "如果你直接地炫耀自己"
    } ]
  }, {
    "tStartMs": 666400,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "我很漂亮、我很牛、我很有钱"
    } ]
  }, {
    "tStartMs": 670800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "那会显得你特别不谦虚"
    } ]
  }, {
    "tStartMs": 673433,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "大家觉得你太骄傲了"
    } ]
  }, {
    "tStartMs": 676100,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "在中国的文化里"
    } ]
  }, {
    "tStartMs": 677533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "谦虚才是美德"
    } ]
  }, {
    "tStartMs": 680300,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "但是呢现在又有很多人"
    } ]
  }, {
    "tStartMs": 683233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "特别希望别人知道自己过得好"
    } ]
  }, {
    "tStartMs": 686733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "知道自己很有钱"
    } ]
  }, {
    "tStartMs": 688833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "知道自己很成功"
    } ]
  }, {
    "tStartMs": 690900,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "所以呢他们找到了这种“聪明”的方式"
    } ]
  }, {
    "tStartMs": 695000,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "用一种抱怨的语气、不满的语气来炫耀自己"
    } ]
  }, {
    "tStartMs": 700500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这样他们就可以说"
    } ]
  }, {
    "tStartMs": 702033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我没有在炫耀呀"
    } ]
  }, {
    "tStartMs": 703833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "我只是在说我自己的不满"
    } ]
  }, {
    "tStartMs": 707000,
    "dDurationMs": 6066,
    "segs": [ {
      "utf8": "可是听的人，一听就能知道他们是在炫耀自己"
    } ]
  }, {
    "tStartMs": 713300,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "所以说凡尔赛这个词，其实是有一点儿贬义的"
    } ]
  }, {
    "tStartMs": 718700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "大家其实不喜欢这种说话方式"
    } ]
  }, {
    "tStartMs": 722533,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "觉得这种说话方式太做作了"
    } ]
  }, {
    "tStartMs": 726100,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "太不真诚了"
    } ]
  }, {
    "tStartMs": 728466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "当一个人跟你说，“你别凡尔赛了”"
    } ]
  }, {
    "tStartMs": 732033,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "其实他的意思是"
    } ]
  }, {
    "tStartMs": 733600,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "行了行了，你别炫耀了，我知道你在显摆，别装了"
    } ]
  }, {
    "tStartMs": 738966,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "好啦现在你知道凡尔赛的意思了吧"
    } ]
  }, {
    "tStartMs": 742466,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "最后呢咱们再看看凡尔赛的用法"
    } ]
  }, {
    "tStartMs": 746500,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "第一种用法"
    } ]
  }, {
    "tStartMs": 747900,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "直接把它当做形容词"
    } ]
  }, {
    "tStartMs": 751133,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "你可以直接说一个人"
    } ]
  }, {
    "tStartMs": 752933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "你也太凡尔赛了"
    } ]
  }, {
    "tStartMs": 754900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那这是形容词"
    } ]
  }, {
    "tStartMs": 756833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "第二个用法呢"
    } ]
  }, {
    "tStartMs": 758333,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "是动词，你别凡尔赛了"
    } ]
  }, {
    "tStartMs": 762200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "你现在是在凡尔赛"
    } ]
  }, {
    "tStartMs": 765033,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "意思是你现在是在炫耀"
    } ]
  }, {
    "tStartMs": 768433,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "那第三种用法呢也可以当成一个名词"
    } ]
  }, {
    "tStartMs": 773533,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "比如说，你这是典型的凡尔赛"
    } ]
  }, {
    "tStartMs": 777033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "你这是典型的炫耀行为"
    } ]
  }, {
    "tStartMs": 780033,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "好了凡尔赛今天就讲到这儿"
    } ]
  }, {
    "tStartMs": 783833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "你们明白它的意思和用法了吗"
    } ]
  }, {
    "tStartMs": 787533,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "如果你们听明白了"
    } ]
  }, {
    "tStartMs": 789300,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "可以在评论区写一句凡尔赛的话"
    } ]
  }, {
    "tStartMs": 794066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "让我看看你学会了吗"
    } ]
  }, {
    "tStartMs": 796633,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "好吧今天的视频就到这儿"
    } ]
  }, {
    "tStartMs": 799600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "感谢大家的收看"
    } ]
  }, {
    "tStartMs": 801533,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "如果你喜欢我的频道"
    } ]
  }, {
    "tStartMs": 803466,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "一定要订阅哦拜拜"
    } ]
  } ]
}
