{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1000,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "hello大家好。好久好久不见了\nHello everyone. It's been a long, long time."
    } ]
  }, {
    "tStartMs": 5466,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "我好久好久没有录vlog了\nI haven't recorded a vlog in ages."
    } ]
  }, {
    "tStartMs": 20266,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "那这几天\nSo, these past few days"
    } ]
  }, {
    "tStartMs": 21766,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "我在进行一个短途旅行\nI've been on a short trip."
    } ]
  }, {
    "tStartMs": 25800,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "我在镇江\nI'm in Zhenjiang."
    } ]
  }, {
    "tStartMs": 28666,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "这个地方在上海的西北部\nThis place is northwest of Shanghai."
    } ]
  }, {
    "tStartMs": 34566,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "离上海坐火车大概只要一个半小时\nIt's only about an hour and a half from Shanghai by train."
    } ]
  }, {
    "tStartMs": 39066,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我住的酒店就在镇江\nThe hotel I'm staying at is right next to"
    } ]
  }, {
    "tStartMs": 42500,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "最著名的一个景点旁边\nZhenjiang's most famous scenic spot."
    } ]
  }, {
    "tStartMs": 45700,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "这个景点叫做西津渡\nThis spot is called Xijindu — West Ferry Crossing."
    } ]
  }, {
    "tStartMs": 49100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "在古代是一个渡口\nIn ancient times it was a ferry crossing,"
    } ]
  }, {
    "tStartMs": 52966,
    "dDurationMs": 4734,
    "segs": [ {
      "utf8": "所以镇江在古代其实挺重要的\nso Zhenjiang was actually quite important back then."
    } ]
  }, {
    "tStartMs": 58066,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "但我猜你们现在应该\nBut I'd guess that these days"
    } ]
  }, {
    "tStartMs": 60566,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "没有多少人听过这个城市\nnot many of you have heard of this city."
    } ]
  }, {
    "tStartMs": 64033,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "所以今天我就想带你们一起看一看\nSo today I want to take you along to have a look."
    } ]
  }, {
    "tStartMs": 68500,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "西津渡现在是一个\nXijindu is now a place"
    } ]
  }, {
    "tStartMs": 71833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "像商业古街一样的地方\nrather like a commercial old street."
    } ]
  }, {
    "tStartMs": 75066,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "其实这样的古街\nActually, old streets like this"
    } ]
  }, {
    "tStartMs": 76633,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "现在在中国很多景点都非常常见\nare very common at Chinese scenic spots nowadays,"
    } ]
  }, {
    "tStartMs": 81166,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "而且很多看起来都很像\nand a lot of them look very much alike."
    } ]
  }, {
    "tStartMs": 85366,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "但好在今天是周一\nBut luckily, today is Monday."
    } ]
  }, {
    "tStartMs": 89100,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "和以前周末来旅游不一样\nUnlike the weekend trips I used to take,"
    } ]
  }, {
    "tStartMs": 92633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "人少很多\nthere are far fewer people."
    } ]
  }, {
    "tStartMs": 95366,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "但也不是特别特别少\nThough not extremely few, either."
    } ]
  }, {
    "tStartMs": 98800,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "所以对我来说就有一种刚刚好的氛围\nSo for me there's a just-right atmosphere."
    } ]
  }, {
    "tStartMs": 104766,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "那像这样一条老街\nAn old street like this one"
    } ]
  }, {
    "tStartMs": 107933,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "现在就主要是传统\nis now mainly a mix of traditional"
    } ]
  }, {
    "tStartMs": 110866,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "民居和一些商铺饭店\nhouses and some shops, restaurants"
    } ]
  }, {
    "tStartMs": 114833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "民宿的结合\nand guesthouses."
    } ]
  }, {
    "tStartMs": 116766,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "有很多民宿\nThere are lots of guesthouses."
    } ]
  }, {
    "tStartMs": 118600,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "他们一楼是咖啡厅或者酒吧\nTheir ground floor is a café or a bar,"
    } ]
  }, {
    "tStartMs": 122666,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "二楼三楼或者更高的\nand the second, third or higher"
    } ]
  }, {
    "tStartMs": 125333,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "楼层就是住宿的地方\nfloors are where you stay."
    } ]
  }, {
    "tStartMs": 128866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "和很多地方一样\nAs in many places,"
    } ]
  }, {
    "tStartMs": 130733,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "这里的星巴克也建成了\nthe Starbucks here has also been built"
    } ]
  }, {
    "tStartMs": 134633,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "和当地建筑风格匹配的样子\nto match the local architectural style."
    } ]
  }, {
    "tStartMs": 140133,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "包括麦当劳也是\nThe McDonald's too."
    } ]
  }, {
    "tStartMs": 143533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "在我的印象中\nAs I remember it,"
    } ]
  }, {
    "tStartMs": 145333,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "肯德基做的本地化的尝试\nKFC's attempts at localization"
    } ]
  }, {
    "tStartMs": 149966,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "其实是比麦当劳更多的\nare actually more numerous than McDonald's."
    } ]
  }, {
    "tStartMs": 152433,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "但我觉得这样的建筑设计应该也是\nBut I think this kind of architectural design must also be"
    } ]
  }, {
    "tStartMs": 155633,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "麦当劳做的一个本地化的尝试吧\none of McDonald's attempts at localizing."
    } ]
  }, {
    "tStartMs": 160866,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "你们看这里有一个小小的装饰\nLook, there's a little decoration here."
    } ]
  }, {
    "tStartMs": 166066,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "这个写的是篆书\nThis is written in seal script."
    } ]
  }, {
    "tStartMs": 169366,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "我大概能认出来\nI can just about make it out —"
    } ]
  }, {
    "tStartMs": 171200,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "它写的就是“西津渡码头”\nit says \"Xijindu Wharf\"."
    } ]
  }, {
    "tStartMs": 178433,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "这边有一座雕塑\nThere's a sculpture over here."
    } ]
  }, {
    "tStartMs": 181733,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "我觉得应该就是以前码头的\nI think it must be modelled on"
    } ]
  }, {
    "tStartMs": 187166,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "码头的船夫的样子\nthe boatmen of the old wharf."
    } ]
  }, {
    "tStartMs": 191766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这一块特别安静\nThis corner is especially quiet."
    } ]
  }, {
    "tStartMs": 195233,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "这里眼前就是一片绿意\nRight in front of us is a stretch of green."
    } ]
  }, {
    "tStartMs": 199766,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "如果我们看到眼前有\nWhen we see before us"
    } ]
  }, {
    "tStartMs": 202400,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "一大片绿色的植物\na great expanse of green plants,"
    } ]
  }, {
    "tStartMs": 205166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "一大片绿色的自然的景观\na great expanse of green natural scenery,"
    } ]
  }, {
    "tStartMs": 207866,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "我们就可以说眼前有一片绿意\nwe can say there's \"a stretch of green\" before our eyes."
    } ]
  }, {
    "tStartMs": 211833,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这是比较诗意的说法\nIt's a rather poetic way of putting it."
    } ]
  }, {
    "tStartMs": 214966,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "但是古街我今天想带你们就看到这里\nBut that's as much of the old street as I'll show you today."
    } ]
  }, {
    "tStartMs": 220000,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "现在我要去一个我更期待的地方\nNow I'm off to a place I'm looking forward to even more,"
    } ]
  }, {
    "tStartMs": 224366,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "也希望是一个更安静的地方\nand hopefully a quieter one too."
    } ]
  }, {
    "tStartMs": 229366,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "好的，现在我们到了\nAll right, we've arrived."
    } ]
  }, {
    "tStartMs": 232466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "我们今天的第二个地方\nThis is our second stop today."
    } ]
  }, {
    "tStartMs": 235266,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "这个地方叫焦山\nThis place is called Jiaoshan — Jiao Mountain."
    } ]
  }, {
    "tStartMs": 237866,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "就是后面那座山\nIt's that mountain behind me."
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "我们现在要等渡船过来\nNow we have to wait for the ferry"
    } ]
  }, {
    "tStartMs": 243133,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "接我们去那座山\nto take us over to the mountain."
    } ]
  }, {
    "tStartMs": 246000,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "其实镇江有三座比较有名的山\nZhenjiang actually has three fairly famous mountains,"
    } ]
  }, {
    "tStartMs": 251133,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "但是我选这里是因为这座山\nbut I chose this one because it's"
    } ]
  }, {
    "tStartMs": 255433,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "是唯一一座在长江中的山\nthe only one standing in the Yangtze River."
    } ]
  }, {
    "tStartMs": 260366,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "它被江水环绕\nIt's surrounded by the river water,"
    } ]
  }, {
    "tStartMs": 264166,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "所以我觉得比较特别\nwhich I find rather special"
    } ]
  }, {
    "tStartMs": 266533,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "比较吸引我\nand rather appealing."
    } ]
  }, {
    "tStartMs": 268366,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "那也有的人把这座山叫做“江中浮玉”\nSome people also call this mountain \"Jade Afloat in the River\","
    } ]
  }, {
    "tStartMs": 273566,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "就是浮在江中的一块玉\nmeaning a piece of jade floating on the river."
    } ]
  }, {
    "tStartMs": 278166,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "可以看到现在渡船向我们开过来了\nYou can see the ferry heading our way now."
    } ]
  }, {
    "tStartMs": 289600,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "现在我们上船啦\nNow we're going aboard."
    } ]
  }, {
    "tStartMs": 316200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "现在准备靠岸\nWe're about to dock."
    } ]
  }, {
    "tStartMs": 321366,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "现在我们到焦山门口了\nNow we're at the entrance to Jiaoshan."
    } ]
  }, {
    "tStartMs": 326666,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "这就是大门口\nThis is the main gate."
    } ]
  }, {
    "tStartMs": 330333,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "上面从右往左写着“焦山胜境”\nAbove it, written right to left, is \"Jiaoshan Shengjing\"."
    } ]
  }, {
    "tStartMs": 337166,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "“胜境”一般就是用来形容一个特别好\n\"Shengjing\" is generally used to describe a place that is especially fine,"
    } ]
  }, {
    "tStartMs": 340366,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "特别美的地方\nespecially beautiful."
    } ]
  }, {
    "tStartMs": 343466,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "你们应该会注意到很多中国\nYou've probably noticed that many Chinese"
    } ]
  }, {
    "tStartMs": 346033,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "的景区都有这样的石狮子\nscenic areas have stone lions like these."
    } ]
  }, {
    "tStartMs": 349566,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "其实是一对\nThey actually come as a pair,"
    } ]
  }, {
    "tStartMs": 351966,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "一公一母\none male and one female."
    } ]
  }, {
    "tStartMs": 355133,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "母狮子的脚下一般都有一头小狮子\nUnder the female lion's paw there's usually a cub,"
    } ]
  }, {
    "tStartMs": 360966,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "而公狮子的脚下一般都会踩着一个球\nwhile the male lion usually has a ball under his."
    } ]
  }, {
    "tStartMs": 369566,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "这边还有更多石雕的狮子\nOver here there are even more carved stone lions."
    } ]
  }, {
    "tStartMs": 374733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "撅着屁股的狮子\nLions with their rear ends stuck up in the air."
    } ]
  }, {
    "tStartMs": 379333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "现在我们进了山\nNow that we're inside the mountain,"
    } ]
  }, {
    "tStartMs": 381433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "因为有了树荫\nwith the shade of the trees,"
    } ]
  }, {
    "tStartMs": 383866,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "终于感觉凉快多了\nit finally feels much cooler."
    } ]
  }, {
    "tStartMs": 391033,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "这边还有一个佛学院\nThere's a Buddhist academy over here too."
    } ]
  }, {
    "tStartMs": 406966,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "再往前走就是一座寺庙\nA little further on there's a temple."
    } ]
  }, {
    "tStartMs": 411000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这座寺庙叫定慧寺\nThis temple is called Dinghui Temple."
    } ]
  }, {
    "tStartMs": 414566,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "有三个石桥通向它\nThree stone bridges lead up to it,"
    } ]
  }, {
    "tStartMs": 420033,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "定慧寺后面又有一座塔\nand behind Dinghui Temple there's a pagoda."
    } ]
  }, {
    "tStartMs": 424733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "现在我进来\nNow that I've come inside,"
    } ]
  }, {
    "tStartMs": 426966,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "整体的感受就是\nmy overall impression is that"
    } ]
  }, {
    "tStartMs": 429566,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "整个景区非常有层次\nthe whole place has a wonderful sense of layers."
    } ]
  }, {
    "tStartMs": 432633,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "走进来一层又一层的\nYou walk in and there's layer after layer,"
    } ]
  }, {
    "tStartMs": 436566,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "每一个地方都是景色\nand every single spot is a view in itself."
    } ]
  }, {
    "tStartMs": 443133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "这些都是用来烧香的\nThese are all for burning incense."
    } ]
  }, {
    "tStartMs": 448633,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但可能因为今天是周一吧\nBut maybe because today is Monday,"
    } ]
  }, {
    "tStartMs": 451833,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "没有什么人来烧香\nhardly anyone has come to burn any."
    } ]
  }, {
    "tStartMs": 455033,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "你更多看到的是这里的\nWhat you see more of are"
    } ]
  }, {
    "tStartMs": 457733,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "工作人员或者一些僧侣走来走去\nthe staff here, or a few monks walking about."
    } ]
  }, {
    "tStartMs": 464433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "游客很少\nThere are very few tourists."
    } ]
  }, {
    "tStartMs": 467400,
    "dDurationMs": 6666,
    "segs": [ {
      "utf8": "你们看这个寺庙前面也有一对石狮子\nLook — in front of this temple there's also a pair of stone lions,"
    } ]
  }, {
    "tStartMs": 474633,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "只不过比我们刚刚在\nonly much smaller than the ones"
    } ]
  }, {
    "tStartMs": 476833,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "门口看到的小多了\nwe saw at the gate just now."
    } ]
  }, {
    "tStartMs": 481000,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "我们发现了一只非常亲人的小猫\nWe've found a very friendly little cat."
    } ]
  }, {
    "tStartMs": 486200,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "而且因为听说这上面有一些猫\nAnd since I'd heard there were cats up here,"
    } ]
  }, {
    "tStartMs": 490866,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "所以我提前准备了食物（猫粮）\nI brought food with me in advance — cat food."
    } ]
  }, {
    "tStartMs": 496733,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "啊，等一下\nAh, hold on."
    } ]
  }, {
    "tStartMs": 497733,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我解不开\nI can't get it open."
    } ]
  }, {
    "tStartMs": 506566,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "但不知道他现在饿不饿\nBut I don't know whether he's hungry right now."
    } ]
  }, {
    "tStartMs": 510033,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "等一下哦\nHang on a second."
    } ]
  }, {
    "tStartMs": 513833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "他现在躺下来了\nHe's lying down now,"
    } ]
  }, {
    "tStartMs": 515800,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "非常放松\ncompletely relaxed."
    } ]
  }, {
    "tStartMs": 519733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "等一下哦\nJust a moment."
    } ]
  }, {
    "tStartMs": 524633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "我就放一点吧\nI'll only put out a little,"
    } ]
  }, {
    "tStartMs": 526066,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "不然把这边的环境弄脏了\notherwise I'll make a mess of this place."
    } ]
  }, {
    "tStartMs": 542200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "但我觉得这边的人\nBut I think the people here"
    } ]
  }, {
    "tStartMs": 543766,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "应该也有在规律的喂它\nmust be feeding him regularly as well."
    } ]
  }, {
    "tStartMs": 549766,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "看起来被养的挺好的\nHe looks very well cared for."
    } ]
  }, {
    "tStartMs": 561733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "吃完了\nAll finished."
    } ]
  }, {
    "tStartMs": 564466,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "很满足的样子\nHe looks thoroughly satisfied."
    } ]
  }, {
    "tStartMs": 569833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "你想打招呼吗？\nDo you want to say hello?"
    } ]
  }, {
    "tStartMs": 580800,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "哇，你们看这边有一个龙的造型的钟\nWow, look — there's a bell shaped like a dragon over here."
    } ]
  }, {
    "tStartMs": 586966,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我猜应该是钟吧\nI'm guessing it's a bell,"
    } ]
  }, {
    "tStartMs": 588833,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "用来敲的\nmeant to be struck."
    } ]
  }, {
    "tStartMs": 593166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "真的一个人都没有\nThere really isn't a single person around."
    } ]
  }, {
    "tStartMs": 595566,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "我很少在寺庙有这样的体验\nI've rarely had an experience like this at a temple."
    } ]
  }, {
    "tStartMs": 599600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "看来以后真的要选工作日来寺庙\nIt seems I really should visit temples on weekdays from now on."
    } ]
  }, {
    "tStartMs": 605933,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "接下来我会安静的逛一会寺庙\nNext I'm going to wander the temple quietly for a while,"
    } ]
  }, {
    "tStartMs": 609066,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "然后把相机关掉\nso I'll turn the camera off."
    } ]
  }, {
    "tStartMs": 613633,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "现在我走到景区更里面了\nNow I've walked deeper into the scenic area,"
    } ]
  }, {
    "tStartMs": 617433,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "这边反而有更多人\nand there are actually more people here."
    } ]
  }, {
    "tStartMs": 620566,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "大家好像都在坐着乘凉休息\nEveryone seems to be sitting in the shade, resting."
    } ]
  }, {
    "tStartMs": 624800,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "可能因为天气真的太热了吧\nProbably because the weather really is too hot."
    } ]
  }, {
    "tStartMs": 627966,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "你们看\nTake a look —"
    } ]
  }, {
    "tStartMs": 629933,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "从这个角度看刚刚的\nfrom this angle, the temple and the stone bridges"
    } ]
  }, {
    "tStartMs": 633266,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "寺院和石桥那一块好美啊\nwe saw just now look so beautiful."
    } ]
  }, {
    "tStartMs": 638766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "真的就像一幅画\nIt really is just like a painting."
    } ]
  }, {
    "tStartMs": 641800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我们走近一点\nLet's go a bit closer."
    } ]
  }, {
    "tStartMs": 648800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "这垂下来的树叶就像\nThese drooping leaves are like"
    } ]
  }, {
    "tStartMs": 652000,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "画框上的装饰一样\ndecoration on a picture frame."
    } ]
  }, {
    "tStartMs": 656866,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我没想到这边还有一个\nI didn't expect there to be"
    } ]
  }, {
    "tStartMs": 663400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "碑林\na forest of steles here as well."
    } ]
  }, {
    "tStartMs": 666233,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "这特别吸引我这样的书法爱好者\nThat's especially appealing to a calligraphy lover like me."
    } ]
  }, {
    "tStartMs": 671466,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "让我们进去看一下\nLet's go in and take a look."
    } ]
  }, {
    "tStartMs": 687833,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "这一块碑是清代乾隆皇帝留下的\nThis stele was left by the Qianlong Emperor of the Qing dynasty."
    } ]
  }, {
    "tStartMs": 695800,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "哇，你们看阳光透过这一个\nWow, look at the sunlight coming through this"
    } ]
  }, {
    "tStartMs": 699533,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "花窗打在地上的阴影\nlatticed window and the shadows it casts on the ground."
    } ]
  }, {
    "tStartMs": 707466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "又一只小猫\nAnother little cat."
    } ]
  }, {
    "tStartMs": 711333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这只白猫比起我一般\nThis white cat is much bolder"
    } ]
  }, {
    "tStartMs": 713400,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "看到的白猫要大胆很多\nthan the white cats I usually meet."
    } ]
  }, {
    "tStartMs": 718800,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "一直闭着眼睛，打了个哈欠\nEyes shut the whole time — and there's a yawn."
    } ]
  }, {
    "tStartMs": 726066,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "我没想到这座碑林这么大\nI didn't expect this stele forest to be so big."
    } ]
  }, {
    "tStartMs": 733066,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "这里面还有一些石桌子石椅子\nInside there are stone tables and stone stools,"
    } ]
  }, {
    "tStartMs": 737866,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "还有一个像茶室一样的地方\nand a spot that looks like a teahouse."
    } ]
  }, {
    "tStartMs": 742466,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "整个碑林看起来就像一座小小的园林\nThe whole stele forest looks like a miniature garden."
    } ]
  }, {
    "tStartMs": 753433,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "没想到这里面还藏着一片竹林\nI didn't expect a bamboo grove to be tucked away in here either."
    } ]
  }, {
    "tStartMs": 758366,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "特别茂密的竹子\nWonderfully dense bamboo."
    } ]
  }, {
    "tStartMs": 761666,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "就好像突然会有一只熊猫出现一样\nIt feels as if a panda might suddenly appear."
    } ]
  }, {
    "tStartMs": 767866,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "这里面还有更多更多的碑刻\nAnd in here there are many, many more stone inscriptions."
    } ]
  }, {
    "tStartMs": 773133,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "真是很安静的一片地呢\nIt really is such a quiet little place."
    } ]
  }, {
    "tStartMs": 781566,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "那你们应该知道书法有不同的字体\nNow, you probably know that calligraphy has different scripts."
    } ]
  }, {
    "tStartMs": 786533,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "像这种比较规整的就是楷书\nA neat, orderly one like this is regular script, kaishu."
    } ]
  }, {
    "tStartMs": 791800,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "这种笔画之间连起来的\nThis kind, with the strokes joined together,"
    } ]
  }, {
    "tStartMs": 794866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "你们可能有点看不懂的\nwhich you may find a little hard to read,"
    } ]
  }, {
    "tStartMs": 797333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "就叫行书\nis called running script, xingshu."
    } ]
  }, {
    "tStartMs": 799733,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "如果连的不那么厉害\nIf the strokes aren't joined quite so much,"
    } ]
  }, {
    "tStartMs": 802133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我们也会叫行楷\nwe also call it xingkai — running-regular script."
    } ]
  }, {
    "tStartMs": 807933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "不仅有刻字\nThere aren't only carved characters;"
    } ]
  }, {
    "tStartMs": 809566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "还有像这样的刻画\nthere are carved pictures like this one too."
    } ]
  }, {
    "tStartMs": 812333,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这一位就是观音\nThis figure is Guanyin,"
    } ]
  }, {
    "tStartMs": 814933,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "对中国人来说很重要的神仙\na deity very important to Chinese people."
    } ]
  }, {
    "tStartMs": 818266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "还有梅花的刻画\nAnd here's a carving of plum blossom."
    } ]
  }, {
    "tStartMs": 821433,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "它没有画一整棵树的梅花\nRather than depicting a whole tree in blossom,"
    } ]
  }, {
    "tStartMs": 825533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "而是画了其中的一枝\nit shows just a single branch."
    } ]
  }, {
    "tStartMs": 829533,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "这么这么多的竹子\nSo very much bamboo"
    } ]
  }, {
    "tStartMs": 831400,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "真的让这个地方显得特别安静\nreally does make this place feel especially quiet."
    } ]
  }, {
    "tStartMs": 835833,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "如果可以\nIf I could,"
    } ]
  }, {
    "tStartMs": 837400,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "真希望在这边待一整个下午\nI'd love to spend a whole afternoon here."
    } ]
  }, {
    "tStartMs": 840966,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "而且这里面还特别凉快\nAnd it's beautifully cool in here as well."
    } ]
  }, {
    "tStartMs": 843866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但是现在已经3点多了\nBut it's already past three o'clock,"
    } ]
  }, {
    "tStartMs": 846433,
    "dDurationMs": 5567,
    "segs": [ {
      "utf8": "然后从焦山回到市区的\nand the last ferry"
    } ]
  }, {
    "tStartMs": 852933,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "渡船最晚的一班是5:45\nfrom Jiaoshan back to the city is at 5:45."
    } ]
  }, {
    "tStartMs": 857600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "所以我现在要抓紧一点\nSo I need to get a move on now"
    } ]
  }, {
    "tStartMs": 861033,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "马上爬到山顶去看一下那座塔\nand climb straight to the summit to see that pagoda."
    } ]
  }, {
    "tStartMs": 866966,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "哎，人就是不能太贪心\nAh, you really mustn't be too greedy."
    } ]
  }, {
    "tStartMs": 870533,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "就是如果想要像我这样慢慢走慢慢看\nI mean, if you want to stroll and look slowly the way I do,"
    } ]
  }, {
    "tStartMs": 875200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "还给你们录视频的话\nand film a video for you all as well,"
    } ]
  }, {
    "tStartMs": 878733,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "应该早上八九点就过来的\nyou should come at eight or nine in the morning."
    } ]
  }, {
    "tStartMs": 882200,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "可是我太懒了起不来\nBut I'm too lazy to get up."
    } ]
  }, {
    "tStartMs": 885200,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "看到了吗\nDid you see that?"
    } ]
  }, {
    "tStartMs": 886133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "一只黑猫\nA black cat."
    } ]
  }, {
    "tStartMs": 890133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "你在吃什么\nWhat are you eating?"
    } ]
  }, {
    "tStartMs": 894833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "你在做什么呢\nWhat are you up to?"
    } ]
  }, {
    "tStartMs": 897600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "你的牙齿痒吗\nAre your teeth itchy?"
    } ]
  }, {
    "tStartMs": 900333,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "没想到这里还藏着一个盆景园\nI never expected a bonsai garden to be hidden here too."
    } ]
  }, {
    "tStartMs": 905433,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "天呐\nOh my goodness."
    } ]
  }, {
    "tStartMs": 907366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "你们可以告诉我焦山\nCan you tell me — is there anything"
    } ]
  }, {
    "tStartMs": 909166,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "还有什么地方是它没有的吗？\nthat Jiaoshan doesn't have?"
    } ]
  }, {
    "tStartMs": 912466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "这个地方真的值得逛一天\nThis place really is worth a whole day."
    } ]
  }, {
    "tStartMs": 915800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "可惜我来的太晚了\nIt's a shame I came so late"
    } ]
  }, {
    "tStartMs": 918400,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "只能选择性的逛一逛\nand can only pick and choose what to see."
    } ]
  }, {
    "tStartMs": 922333,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "不过本来旅游就是有\nThen again, travelling always means"
    } ]
  }, {
    "tStartMs": 925000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "一些地方要错过的嘛\nthere are some places you have to miss."
    } ]
  }, {
    "tStartMs": 930766,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "现在这里应该就正式上山了\nFrom here, I think, the climb officially begins."
    } ]
  }, {
    "tStartMs": 935166,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我们走上台阶\nLet's go up the steps."
    } ]
  }, {
    "tStartMs": 939133,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "说实话我第一次看到这样的标识\nTo be honest, it's the first time I've seen signs like these."
    } ]
  }, {
    "tStartMs": 943633,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "两个标识都是是告诉你上山\nBoth signs just tell you \"up the mountain\","
    } ]
  }, {
    "tStartMs": 947133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "而不是去哪个地方\nrather than where they actually lead."
    } ]
  }, {
    "tStartMs": 950166,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "不知道这样的标识是否真的有意义\nI wonder whether signs like this are any use at all."
    } ]
  }, {
    "tStartMs": 955833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "那我们选择这条上山之路吧\nWell then, let's take this path up the mountain."
    } ]
  }, {
    "tStartMs": 962400,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "爬山的时候\nWhen I'm climbing a mountain,"
    } ]
  }, {
    "tStartMs": 963666,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "我特别特别喜欢这些\nI especially, especially love this"
    } ]
  }, {
    "tStartMs": 966400,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "从树叶之间照下来的阳光\nsunlight streaming down through the leaves."
    } ]
  }, {
    "tStartMs": 973566,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "从这边可以看到市区\nFrom here you can see the city,"
    } ]
  }, {
    "tStartMs": 976733,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "但是你能感觉到我们离市区很远\nbut you can feel how far away from it we are."
    } ]
  }, {
    "tStartMs": 980033,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "我们隔绝了市区的噪音啊\nWe're shut off from the city's noise"
    } ]
  }, {
    "tStartMs": 984866,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "污染啊\nand its pollution."
    } ]
  }, {
    "tStartMs": 989466,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但我觉得这座山应该不太高\nBut I don't think this mountain is very tall."
    } ]
  }, {
    "tStartMs": 993533,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "很快就可以爬到山顶了\nWe should reach the top before long."
    } ]
  }, {
    "tStartMs": 1032433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "这座亭子的名字很有意思\nThe name of this pavilion is rather interesting."
    } ]
  }, {
    "tStartMs": 1041233,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "叫做“吸江楼”\nIt's called \"Xijiang Lou\" — the River-Drinking Tower."
    } ]
  }, {
    "tStartMs": 1046033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "这个就是“吸”\nThis character here means \"to draw in, to inhale\","
    } ]
  }, {
    "tStartMs": 1048666,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "好像这座亭子要把旁边的\nas if this pavilion were going to drink up"
    } ]
  }, {
    "tStartMs": 1052333,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "长江的水全部吸进去一样\nevery drop of the Yangtze River beside it."
    } ]
  }, {
    "tStartMs": 1058933,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "我感觉我到山顶了\nI think I've made it to the top."
    } ]
  }, {
    "tStartMs": 1063266,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我觉得我的体力不如以前了\nI feel my stamina isn't what it used to be."
    } ]
  }, {
    "tStartMs": 1066366,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "可能因为前不久感染了新冠吧\nMaybe because I caught COVID not long ago."
    } ]
  }, {
    "tStartMs": 1070066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "对身体的打击真的很大\nIt really took a heavy toll on my body."
    } ]
  }, {
    "tStartMs": 1081200,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "前面就是一座塔\nJust ahead is a pagoda."
    } ]
  }, {
    "tStartMs": 1087766,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "这座塔叫“万佛塔”\nThis pagoda is called \"Wanfo Ta\" — the Ten Thousand Buddhas Pagoda,"
    } ]
  }, {
    "tStartMs": 1090666,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "因为里面据说有一万尊佛像\nbecause it's said to hold ten thousand Buddha statues inside."
    } ]
  }, {
    "tStartMs": 1096000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "但它已经不是原来的塔了\nBut it's no longer the original pagoda;"
    } ]
  }, {
    "tStartMs": 1099000,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "是重建的\nit's a reconstruction."
    } ]
  }, {
    "tStartMs": 1101466,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "应该是有七层高\nIt should be seven storeys high."
    } ]
  }, {
    "tStartMs": 1104966,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我们在这边还可以\nFrom here we can also"
    } ]
  }, {
    "tStartMs": 1106466,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "看到远处的江景和市区\nsee the river and the city in the distance."
    } ]
  }, {
    "tStartMs": 1119633,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "但是这座万佛塔看起来好像不能进去\nBut it seems you can't go inside this Ten Thousand Buddhas Pagoda."
    } ]
  }, {
    "tStartMs": 1127000,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "门上上了锁\nThe door is locked."
    } ]
  }, {
    "tStartMs": 1129433,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "但我能通过这个门缝看到里面\nStill, I can see in through the crack in the door."
    } ]
  }, {
    "tStartMs": 1134366,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "里面在施工\nThere's construction going on inside."
    } ]
  }, {
    "tStartMs": 1136366,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "难怪不能进去呢\nNo wonder you can't go in."
    } ]
  }, {
    "tStartMs": 1142333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "现在下午4:15\nIt's now 4:15 in the afternoon,"
    } ]
  }, {
    "tStartMs": 1145866,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "我准备下山啦\nand I'm getting ready to head back down."
    } ]
  }, {
    "tStartMs": 1151866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "现在我们下来了\nNow we've come down"
    } ]
  }, {
    "tStartMs": 1153733,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "到江边了\nto the riverside."
    } ]
  }, {
    "tStartMs": 1155866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "在这里可以欣赏江景\nFrom here you can take in the river view."
    } ]
  }, {
    "tStartMs": 1159333,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "虽然已经下午4点多了\nEven though it's already past four in the afternoon,"
    } ]
  }, {
    "tStartMs": 1161200,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "但是太阳还是挺晒的\nthe sun is still pretty fierce."
    } ]
  }, {
    "tStartMs": 1167600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "但说实话\nBut to be honest,"
    } ]
  }, {
    "tStartMs": 1169333,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "从这这座江中小山往\nthe view looking out into the distance"
    } ]
  }, {
    "tStartMs": 1174166,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "远处看的景色并不怎么好\nfrom this little mountain in the river isn't all that special —"
    } ]
  }, {
    "tStartMs": 1177833,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "因为它自己本身就是江上最好的景色\nbecause the mountain itself is the best view on the river."
    } ]
  } ]
}
