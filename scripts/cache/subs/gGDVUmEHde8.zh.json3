    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "wèi shén me huì duì duǎn shì pín shàng yǐn de yuán yīn zhī wài ne\n为  什   么 会  对  短   视  频  上    瘾  的 原   因  之  外  呢"
    } ]
  }, {
    "tStartMs": 490700,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "A I hái gào sù le wǒ\nA I 还  告  诉 了 我"
    } ]
  }, {
    "tStartMs": 492433,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "jǐ gè kè fú duǎn shì pín shàng yǐn de fāng fǎ\n几 个 克 服 短   视  频  上    瘾  的 方   法"
    } ]
  }, {
    "tStartMs": 496833,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "zěn me zuò cái néng ràng zì jǐ bú duì duǎn shì pín shàng yǐn\n怎  么 做  才  能   让   自 己 不 对  短   视  频  上    瘾 "
    } ]
  }, {
    "tStartMs": 502500,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "bǐ rú shuō\n比 如 说  "
    } ]
  }, {
    "tStartMs": 503533,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "tā gào sù wǒ ， xiàn zhì shuā duǎn shì pín de shí jiān\n它 告  诉 我 ， 限   制  刷   短   视  频  的 时  间  "
    } ]
  }, {
    "tStartMs": 508700,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "bǐ rú shuō\n比 如 说  "
    } ]
  }, {
    "tStartMs": 509200,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "xiàn zhì zì jǐ měi tiān zhǐ néng shuā 1 0 fēn zhōng de duǎn shì pín\n限   制  自 己 每  天   只  能   刷   1 0 分  钟    的 短   视  频 "
    } ]
  }, {
    "tStartMs": 514433,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "zhǐ néng shuā 2 0 fēn zhōng de duǎn shì pín\n只  能   刷   2 0 分  钟    的 短   视  频 "
    } ]
  }, {
    "tStartMs": 517433,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "gěi zì jǐ xiàn zhì yí gè yán gé de shí jiān\n给  自 己 限   制  一 个 严  格 的 时  间  "
    } ]
  }, {
    "tStartMs": 521266,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "nà dì èr gè ne\n那 第 二 个 呢"
    } ]
  }, {
    "tStartMs": 522500,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "wǒ jué de yě kě yǐ cháng shì yí xià\n我 觉  得 也 可 以 尝    试  一 下 "
    } ]
  }, {
    "tStartMs": 525433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "jiù shì zài shuì qián\n就  是  在  睡   前  "
    } ]
  }, {
    "tStartMs": 527000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "zài shuì jiào zhī qián bǎ shǒu jī guān jī\n在  睡   觉   之  前   把 手   机 关   机"
    } ]
  }, {
    "tStartMs": 530733,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "zhè yàng jiù bú huì zài shuì qián yì zhí kàn shǒu jī\n这  样   就  不 会  在  睡   前   一 直  看  手   机"
    } ]
  }, {
    "tStartMs": 534466,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "yǐng xiǎng shuì mián le\n影   响    睡   眠   了"
    } ]
  }, {
    "tStartMs": 536433,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "nà hái yǒu yí gè fāng fǎ\n那 还  有  一 个 方   法"
    } ]
  }, {
    "tStartMs": 537600,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "wǒ jué de tīng qǐ lái yě shì tǐng hǎo de\n我 觉  得 听   起 来  也 是  挺   好  的"
    } ]
  }, {
    "tStartMs": 540866,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "zài nǐ xiǎng shuā duǎn shì pín de shí hòu\n在  你 想    刷   短   视  频  的 时  候 "
    } ]
  }, {
    "tStartMs": 543266,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "zhuǎn yí yí xià zì jǐ de zhù yì lì\n转    移 一 下  自 己 的 注  意 力"
    } ]
  }, {
    "tStartMs": 546033,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "qù gān diǎn bié de shì qíng\n去 干  点   别  的 事  情  "
    } ]
  }, {
    "tStartMs": 548200,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "zhè xiē fāng fǎ wǒ dōu zhǔn bèi shì yí xià\n这  些  方   法 我 都  准   备  试  一 下 "
    } ]
  }, {
    "tStartMs": 551433,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "dào shí hòu gào sù nǐ men yǒu méi yǒu xiào guǒ\n到  时  候  告  诉 你 们  有  没  有  效   果 "
    } ]
  }, {
    "tStartMs": 554866,
    "dDurationMs": 5334,
    "segs": [ {
      "utf8": "nà dà jiā píng shí yǒu méi yǒu duì duǎn shì pín shàng yǐn de kùn rǎo ne\n那 大 家  平   时  有  没  有  对  短   视  频  上    瘾  的 困  扰  呢"
    } ]
  }, {
    "tStartMs": 560500,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "nǐ men shì zěn me jiě jué zhè ge wèn tí de\n你 们  是  怎  么 解  决  这  个 问  题 的"
    } ]
  }, {
    "tStartMs": 564066,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "rú guǒ nǐ men yě yǒu tóng yàng de jīng lì\n如 果  你 们  也 有  同   样   的 经   历"
    } ]
  }, {
    "tStartMs": 566666,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "hé tóng yàng de wèn tí\n和 同   样   的 问  题"
    } ]
  }, {
    "tStartMs": 568833,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "huān yíng zài píng lùn qū yì qǐ tǎo lùn\n欢   迎   在  评   论  区 一 起 讨  论 "
    } ]
  }, {
    "tStartMs": 572666,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "nà jīn tiān de shì pín jiù dào zhè ba\n那 今  天   的 视  频  就  到  这  吧"
    } ]
  }, {
    "tStartMs": 575266,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "fēi cháng gǎn xiè nǐ men de shōu kàn\n非  常    感  谢  你 们  的 收   看 "
    } ]
  }, {
    "tStartMs": 577933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "rú guǒ nǐ duì wǒ de shì pín\n如 果  你 对  我 的 视  频 "
    } ]
  }, {
    "tStartMs": 579733,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "duì wǒ de pín dào gǎn xìng qù\n对  我 的 频  道  感  兴   趣"
    } ]
  }, {
    "tStartMs": 581800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "huān yíng dìng yuè wǒ de pín dào\n欢   迎   订   阅  我 的 频  道 "
    } ]
  }, {
    "tStartMs": 584033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "hǎo ba zán men jīn tiān jiù dào zhè ba\n好  吧 咱  们  今  天   就  到  这  吧"
    } ]
  }, {
    "tStartMs": 586500,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "xià cì zài jiàn bài bài\n下  次 再  见   拜  拜 "
    } ]
  } ]
}
