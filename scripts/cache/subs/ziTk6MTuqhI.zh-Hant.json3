  "events": [ {
    "tStartMs": 60700,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "第十一集 孫悟空學會了嗎"
    } ]
  }, {
    "tStartMs": 65466,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "上一集 師父答應孫悟空"
    } ]
  }, {
    "tStartMs": 68566,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "要教牠躲避危險的方法"
    } ]
  }, {
    "tStartMs": 72366,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "孫悟空很高興"
    } ]
  }, {
    "tStartMs": 75466,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "牠認真地看著師父"
    } ]
  }, {
    "tStartMs": 79766,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "師父說 有兩個方法"
    } ]
  }, {
    "tStartMs": 84700,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "一個是三十六變"
    } ]
  }, {
    "tStartMs": 88133,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "一個是七十二變"
    } ]
  }, {
    "tStartMs": 91600,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "你想學哪一個"
    } ]
  }, {
    "tStartMs": 97200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "孫悟空想了一下"
    } ]
  }, {
    "tStartMs": 100766,
    "dDurationMs": 4634,
    "segs": [ {
      "utf8": "牠說 我要學七十二變"
    } ]
  }, {
    "tStartMs": 105800,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "七十二比三十六多"
    } ]
  }, {
    "tStartMs": 110766,
    "dDurationMs": 6634,
    "segs": [ {
      "utf8": "師父讓孫悟空靠近他"
    } ]
  }, {
    "tStartMs": 117400,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "師父在孫悟空耳邊小聲地說"
    } ]
  }, {
    "tStartMs": 123666,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "孫悟空聽了很久"
    } ]
  }, {
    "tStartMs": 127100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "牠知道怎麼變了"
    } ]
  }, {
    "tStartMs": 130133,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "孫悟空要認真地練習七十二變"
    } ]
  }, {
    "tStartMs": 137200,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "孫悟空白天練習"
    } ]
  }, {
    "tStartMs": 140266,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "晚上也練習"
    } ]
  }, {
    "tStartMs": 143100,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "牠會變成樹"
    } ]
  }, {
    "tStartMs": 145200,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "也會變成石頭"
    } ]
  }, {
    "tStartMs": 147866,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "牠還會變成很多東西"
    } ]
  }, {
    "tStartMs": 151600,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "孫悟空學會了七十二變"
    } ]
  }, {
    "tStartMs": 156733,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "一天 師父和大家來到外面"
    } ]
  }, {
    "tStartMs": 161966,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "師父問 你會飛了嗎"
    } ]
  }, {
    "tStartMs": 167733,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "孫悟空說 我會"
    } ]
  }, {
    "tStartMs": 170900,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "我飛給大家看"
    } ]
  }, {
    "tStartMs": 174966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "孫悟空跳到雲上"
    } ]
  }, {
    "tStartMs": 177766,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "走了很久"
    } ]
  }, {
    "tStartMs": 179766,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "只走了三里"
    } ]
  }, {
    "tStartMs": 182133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "牠說"
    } ]
  }, {
    "tStartMs": 183466,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "師父 我會騰雲了"
    } ]
  }, {
    "tStartMs": 188133,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "師父笑著說"
    } ]
  }, {
    "tStartMs": 190800,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "這不是騰雲"
    } ]
  }, {
    "tStartMs": 193566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "你只是在雲上走"
    } ]
  }, {
    "tStartMs": 197000,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "會騰雲的人一天可以飛過四個海"
    } ]
  }, {
    "tStartMs": 202933,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "孫悟空說"
    } ]
  }, {
    "tStartMs": 204966,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "這太難了"
    } ]
  }, {
    "tStartMs": 208466,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "孫悟空向師父行禮"
    } ]
  }, {
    "tStartMs": 212166,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "牠說 請您教我騰雲的方法"
    } ]
  }, {
    "tStartMs": 217100,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "師父說 你剛才打了一個筋斗"
    } ]
  }, {
    "tStartMs": 221800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我就教你筋斗雲"
    } ]
  }, {
    "tStartMs": 226066,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "晚上 孫悟空認真練習"
    } ]
  }, {
    "tStartMs": 229666,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "牠打了一個筋斗"
    } ]
  }, {
    "tStartMs": 231666,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "跳上了筋斗雲"
    } ]
  }, {
    "tStartMs": 234266,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "筋斗雲一下子飛到了很遠的地方"
    } ]
  }, {
    "tStartMs": 239733,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "孫悟空學會了筋斗雲"
    } ]
  } ]
}
