    "tStartMs": 1261066,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "把茶几擦干净\nbǎ chá jī cā gān jìng\nWipe the coffee table clean"
    } ]
  }, {
    "tStartMs": 1264535,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "那我现在开始整理\nnà wǒ xiàn zài kāi shǐ zhěng lǐ\nThen I’ll start organizing now"
    } ]
  }, {
    "tStartMs": 1267735,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "我先把东西都放在旁边\nwǒ xiān bǎ dōng xī dū fàng zài páng biān\nI’ll first put everything aside"
    } ]
  }, {
    "tStartMs": 1274375,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "把所有东西拿走\nbǎ suǒ yǒu dōng xī ná zǒu\nTake everything away"
    } ]
  }, {
    "tStartMs": 1277055,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "放在旁边\nfàng zài páng biān\nPut it aside"
    } ]
  }, {
    "tStartMs": 1282955,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "然后我用湿巾\nrán hòu wǒ yòng shī jīn\nThen I’ll use a wet wipe"
    } ]
  }, {
    "tStartMs": 1286217,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "湿巾就是有水的纸巾\nshī jīn jiù shì yǒu shuǐ de zhǐ jīn\nA wet wipe is a tissue with water"
    } ]
  }, {
    "tStartMs": 1292057,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "湿巾,它有水擦\nshī jīn, tā yǒu shuǐ cā\nWet wipe, it has water to wipe with"
    } ]
  }, {
    "tStartMs": 1296287,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "我要用湿巾擦茶几\nwǒ yào yòng shī jīn cā chá jī\nI’m going to wipe the coffee table with a wet wipe"
    } ]
  }, {
    "tStartMs": 1300731,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "擦，这个动作叫做擦\ncā， zhè gè dòng zuò jiào zuò cā\nWiping, this action is called wiping"
    } ]
  }, {
    "tStartMs": 1305023,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "我把茶几擦干净\nwǒ bǎ chá jī cā gān jìng\nI wipe the coffee table clean"
    } ]
  }, {
    "tStartMs": 1310857,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "擦桌子\ncā zhuō zǐ\nWipe the table"
    } ]
  }, {
    "tStartMs": 1312537,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "我在擦桌子\nwǒ zài cā zhuō zǐ\nI’m wiping the table"
    } ]
  }, {
    "tStartMs": 1316554,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "等桌子干了之后\nděng zhuō zǐ gān le zhī hòu\nAfter the table dries"
    } ]
  }, {
    "tStartMs": 1319954,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "因为湿巾有水\nyīn wèi shī jīn yǒu shuǐ\nBecause the wet wipe has water"
    } ]
  }, {
    "tStartMs": 1323088,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "有水\nyǒu shuǐ\nHas water"
    } ]
  }, {
    "tStartMs": 1324211,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "所以现在桌子是湿的\nsuǒ yǐ xiàn zài zhuō zǐ shì shī de\nSo the table is wet now"
    } ]
  }, {
    "tStartMs": 1328269,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "湿的\nshī de\nWet"
    } ]
  }, {
    "tStartMs": 1329366,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "还不能放东西\nhuán bù néng fàng dōng xī\nI can’t put anything on it yet"
    } ]
  }, {
    "tStartMs": 1331981,
    "dDurationMs": 4480,
    "segs": [ {
