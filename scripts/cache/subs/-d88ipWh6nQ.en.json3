  "events": [ {
    "tStartMs": 29895,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "你们好,我是Jade\nnǐ men hǎo, wǒ shì Jade\nHello, I’m Jade."
    } ]
  }, {
    "tStartMs": 34234,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "今天我休息在家\njīn tiān wǒ xiū xī zài jiā\nToday I’m resting at home."
    } ]
  }, {
    "tStartMs": 38855,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "所以我打算做一些家务\nsuǒ yǐ wǒ dǎ suàn zuò yī xiē jiā wù\nSo I’m going to do some housework."
    } ]
  }, {
    "tStartMs": 44694,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "打扫卫生\ndǎ sǎo wèi shēng\nCleaning."
    } ]
  }, {
    "tStartMs": 47814,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "那么在这个视频\nnà me zài zhè gè shì pín\nSo in this video"
    } ]
  }, {
    "tStartMs": 51532,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "我会说一些跟做家务和\nwǒ huì shuō yī xiē gēn zuò jiā wù hé\nI’ll talk about some Chinese words related to housework and"
    } ]
  }, {
    "tStartMs": 58121,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "打扫卫生有关的中文\ndǎ sǎo wèi shēng yǒu guān de zhōng wén\ncleaning."
    } ]
  }, {
    "tStartMs": 65987,
    "dDurationMs": 7040,
    "segs": [ {
      "utf8": "我一般会先从卧室开始打扫\nwǒ yī bān huì xiān cóng wò shì kāi shǐ dǎ sǎo\nI usually start by cleaning the bedroom."
    } ]
  }, {
    "tStartMs": 73667,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "这里是我的卧室\nzhè lǐ shì wǒ de wò shì\nThis is my bedroom."
    } ]
  }, {
    "tStartMs": 77959,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "卧室就是睡觉的地方\nwò shì jiù shì shuì jiào de dì fāng\nThe bedroom is where you sleep."
    } ]
  }, {
    "tStartMs": 83427,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "睡觉的房间叫做卧室\nshuì jiào de fáng jiān jiào zuò wò shì\nThe room where you sleep is called a bedroom."
    } ]
  }, {
    "tStartMs": 90549,
