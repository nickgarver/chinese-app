  }, {
    "tStartMs": 1036233,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "tōng guò wǒ men de rì cháng shēng huó\n通过我们的日常生活"
    } ]
  }, {
    "tStartMs": 1038233,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "yòng kě lǐ jiě xìng shū rù de fāng shì lái xué zhōng wén\n用可理解性输入的方式来学中文"
