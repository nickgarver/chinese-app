  }, {
    "tStartMs": 629833,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "wǒ yào xiān bǎ zhè ge jiàng zhī dǎ kāi\n我要先把这个酱汁打开"
    } ]
  }, {
    "tStartMs": 633466,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "zhè ge shì yì dà lì miàn jiàng\n这个是意大利面酱"
    } ]
  }, {
    "tStartMs": 636066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa\n哇"
    } ]
  }, {
    "tStartMs": 637600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "zhè ge hǎo nán níng a\n这个好难拧啊"
    } ]
  }, {
    "tStartMs": 639900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "zhè ge dòng zuò shì níng níng\n这个动作是拧拧"
    } ]
  }, {
    "tStartMs": 642666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "tā xiàn zài fēi cháng de jǐn\n它现在非常的紧"
    } ]
  }, {
    "tStartMs": 644666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "fēi cháng jǐn wǒ hěn nán níng kāi\n非常紧我很难拧开"
    } ]
  }, {
    "tStartMs": 647800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "yīn wèi tā yǒu yī xiē huá huá\n因为它有一些滑滑"
    } ]
  }, {
    "tStartMs": 650433,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "shàng miàn yǒu shuǐ\n上面有水"
    } ]
  }, {
    "tStartMs": 651866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "a yǒu diǎn huá\n啊有点滑"
    } ]
  }, {
    "tStartMs": 653500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "wǒ kàn yī xià\n我看一下"
    } ]
  }, {
    "tStartMs": 655433,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "ná yí gè máo jīn ná yí gè máo jīn zhè yàng shì yī shì\n拿一个毛巾拿一个毛巾这样试一试"
    } ]
  }, {
    "tStartMs": 659300,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "a bù xíng\n啊不行"
    } ]
  }, {
    "tStartMs": 660000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "hái shì hěn huá\n还是很滑"
    } ]
  }, {
    "tStartMs": 662766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "a zěn me bàn\n啊怎么办"
    } ]
  }, {
    "tStartMs": 665366,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "yòng lì\n用力"
    } ]
  }, {
    "tStartMs": 667633,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "shǐ jìn\n使劲"
    } ]
  }, {
    "tStartMs": 669466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "āi yā hái shì bù xíng\n哎呀还是不行"
    } ]
  }, {
    "tStartMs": 671066,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "tiān nà zhè ge zhēn de hěn nán níng kāi ya\n天呐这个真的很难拧开呀"
    } ]
  }, {
    "tStartMs": 675900,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "péng yǒu men yù dào zhè zhǒng qíng kuàng\n朋友们遇到这种情况"
    } ]
  }, {
    "tStartMs": 678166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "nǐ men huì zěn me bàn\n你们会怎么办"
    } ]
  }, {
    "tStartMs": 680500,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "wǒ zài shì shì lìng wài yí gè fāng fǎ\n我再试试另外一个方法"
    } ]
  }, {
    "tStartMs": 682966,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "bǎ tā zhè yàng dào guò lái dào guò lái\n把它这样倒过来倒过来"
    } ]
  }, {
    "tStartMs": 686100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "rán hòu pāi dǐ bù pāi\n然后拍底部拍"
    } ]
  }, {
    "tStartMs": 692166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "zhè xiē dōu shì wǒ zài wǎng shàng xué dào de fāng fǎ\n这些都是我在网上学到的方法"
    } ]
  }, {
    "tStartMs": 694866,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "bù zhī dào guǎn bù guǎn yòng a\n不知道管不管用啊"
    } ]
  }, {
    "tStartMs": 698400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "hái shì bù xíng\n还是不行"
    } ]
  }, {
    "tStartMs": 701900,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "qì sǐ wǒ le\n气死我了"
    } ]
  }, {
    "tStartMs": 704366,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "ná yī zhāng zhǐ\n拿一张纸"
    } ]
  }, {
    "tStartMs": 709800,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "ná le yí gè zhǐ\n拿了一个纸"
    } ]
  }, {
    "tStartMs": 711466,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "miàn jīn zhǐ kàn kàn xíng bù xíng\n面巾纸看看行不行"
    } ]
  }, {
    "tStartMs": 716766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "a wǒ hū rán xiǎng qǐ lái\n啊我忽然想起来"
    } ]
  }, {
    "tStartMs": 718233,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "zhè shì yī píng xīn de xīn de jiàng méi kāi fēng ó\n这是一瓶新的新的酱没开封哦"
    } ]
  }, {
    "tStartMs": 725233,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ bì xū ne\n所以我必须呢"
    } ]
  }, {
    "tStartMs": 726700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "xiān yòng sháo zi qiào yī xià tā\n先用勺子撬一下它"
    } ]
  }, {
    "tStartMs": 730800,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "zhè ge shì qiào\n这个是撬"
    } ]
  }, {
    "tStartMs": 732800,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "yòng sháo zi zhè yàng shì qiào qiào\n用勺子这样是撬撬"
    } ]
  }, {
    "tStartMs": 738800,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "āi nǐ men tīng dào nà ge shēng yīn le ma\n哎你们听到那个声音了吗"
    } ]
  }, {
    "tStartMs": 742066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "zhè huí yìng gāi méi wèn tí le\n这回应该没问题了"
    } ]
  }, {
    "tStartMs": 745633,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "a zhōng yú dǎ kāi le\n啊终于打开了"
    } ]
  }, {
    "tStartMs": 748266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wǒ xiàn zài ne\n我现在呢"
    } ]
  }, {
    "tStartMs": 749066,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "yào chǎo yī xià zhè ge jiàng zhī\n要炒一下这个酱汁"
    } ]
  }, {
    "tStartMs": 751800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "è\n呃"
    } ]
  }, {
    "tStartMs": 753066,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "zài chǎo zhī qián ne\n在炒之前呢"
    } ]
  }, {
    "tStartMs": 754400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "wǒ yào xiān dǎ kāi zhè ge chōu yóu yān jī\n我要先打开这个抽油烟机"
    } ]
  }, {
    "tStartMs": 757633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "zhè ge shì chōu yóu yān jī\n这个是抽油烟机"
    } ]
  }, {
    "tStartMs": 762600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "hǎo dǎ kāi le\n好打开了"
    } ]
  }, {
    "tStartMs": 764733,
    "dDurationMs": 5533,
    "segs": [ {
      "utf8": "rán hòu wǒ men wǎng guō lǐ dào yī xiē yóu dào yóu\n然后我们往锅里倒一些油倒油"
    } ]
  }, {
    "tStartMs": 771200,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "jiē xià lái děng yóu rè le jiù kě yǐ chǎo le\n接下来等油热了就可以炒了"
    } ]
  }, {
    "tStartMs": 774933,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "wǒ yì bān huì yòng shǒu qù shì yóu wēn\n我一般会用手去试油温"
    } ]
  }, {
    "tStartMs": 779400,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "chà bu duō le\n差不多了"
    } ]
  }, {
    "tStartMs": 780933,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "xiān bǎ suàn dào jìn guō lǐ\n先把蒜倒进锅里"
    } ]
  }, {
    "tStartMs": 785633,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "fān chǎo jǐ xià\n翻炒几下"
    } ]
  }, {
    "tStartMs": 787633,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "fān chǎo fān chǎo\n翻炒翻炒"
    } ]
  }, {
    "tStartMs": 793633,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "wǒ ne hái hěn xǐ huān zhè yàng qù wén yī xià wèi dào\n我呢还很喜欢这样去闻一下味道"
    } ]
  }, {
    "tStartMs": 797433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "ń hǎo xiāng a\n嗯好香啊"
    } ]
  }, {
    "tStartMs": 801066,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "hòu miàn ne\n后面呢"
    } ]
  }, {
    "tStartMs": 801766,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "wǒ bǎ ròu hé xī hóng shì dōu fàng jìn le guō lǐ\n我把肉和西红柿都放进了锅里"
    } ]
  }, {
    "tStartMs": 805800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "jì xù chǎo chǎo\n继续炒炒"
    } ]
  }, {
    "tStartMs": 812000,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "chà bu duō le\n差不多了"
    } ]
  }, {
    "tStartMs": 813033,
    "dDurationMs": 5067,
    "segs": [ {
      "utf8": "wǒ jiē xià lái yào bǎ jiàng zhī dào jìn qù\n我接下来要把酱汁倒进去"
    } ]
  }, {
    "tStartMs": 820000,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "yòng sháo zi ne yǎo\n用勺子呢舀"
    } ]
  }, {
    "tStartMs": 822166,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "zhè ge shì yǎo\n这个是舀"
    } ]
  }, {
    "tStartMs": 825000,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "yǎo chū lái a\n舀出来啊"
    } ]
  }, {
    "tStartMs": 831500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "nà wǒ zhè lǐ ne\n那我这里呢"
    } ]
  }, {
    "tStartMs": 832500,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "shì tiáo zhěng huǒ de\n是调整火的"
    } ]
  }, {
    "tStartMs": 836000,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "zhè ge shì jiā hào\n这个是加号"
    } ]
  }, {
    "tStartMs": 837600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "jiā hào jiù shì huǒ zài dà yī diǎn\n加号就是火再大一点"
    } ]
  }, {
    "tStartMs": 840500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "jiǎn hào jiù shì huǒ xiǎo yì diǎn\n减号就是火小一点"
    } ]
  }, {
    "tStartMs": 844500,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "xiǎo huǒ\n小火"
    } ]
  }, {
    "tStartMs": 847100,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "dà huǒ\n大火"
    } ]
  }, {
    "tStartMs": 848900,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "rán hòu zhè ge de huà wǒ men jiào wǎ\n然后这个的话我们叫瓦"
    } ]
  }, {
    "tStartMs": 851300,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "bǐ rú shuō zhè ge shì 800 wǎ\n比如说这个是800瓦"
    } ]
  }, {
    "tStartMs": 854466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "1 qiān wǎ\n1千瓦"
    } ]
  }, {
    "tStartMs": 857466,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "600 wǎ\n600瓦"
    } ]
  }, {
    "tStartMs": 860200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "sā yī xiē yán\n撒一些盐"
    } ]
  }, {
    "tStartMs": 862200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "zhè ge shì yán yán\n这个是盐盐"
    } ]
  }, {
    "tStartMs": 865000,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "sā sā\n撒撒"
    } ]
  }, {
    "tStartMs": 868766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "jiē xià lái wǒ yào bǎ gāng cái zhǔ de miàn tiáo ne\n接下来我要把刚才煮的面条呢"
    } ]
  }, {
    "tStartMs": 871233,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "yě fàng jìn qù chǎo yī xià\n也放进去炒一下"
    } ]
  }, {
    "tStartMs": 874666,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "wū hā hā hā\n呜哈哈哈"
    } ]
  }, {
    "tStartMs": 877700,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa ó\n哇哦"
    } ]
  }, {
    "tStartMs": 880000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "zhè yàng jì xù chǎo yī huì\n这样继续炒一会"
    } ]
  }, {
    "tStartMs": 883000,
    "dDurationMs": 4766,
    "segs": [ {
      "utf8": "ràng zhè ge jiàng zhī ne chōng fèn de bāo guǒ zài miàn tiáo shàng\n让这个酱汁呢充分的包裹在面条上"
    } ]
  }, {
    "tStartMs": 889166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "wa\n哇"
    } ]
  }, {
    "tStartMs": 890266,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "zhēn de hěn xiāng\n真的很香"
    } ]
  }, {
    "tStartMs": 893100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "hǎo le zuò hǎo le\n好了做好了"
    } ]
  }, {
    "tStartMs": 896400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "hǎo\n好"
    } ]
  }, {
    "tStartMs": 897833,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "ó kàn wǒ zuò le zhè me yī dà guō\n哦看我做了这么一大锅"
    } ]
  }, {
    "tStartMs": 901700,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "jiē xià lái wǒ bǎ miàn tiáo shèng chū lái\n接下来我把面条盛出来"
    } ]
  }, {
    "tStartMs": 905366,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "shèng dào pán zi lǐ\n盛到盘子里"
    } ]
  }, {
    "tStartMs": 907666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "shèng\n盛"
    } ]
  }, {
    "tStartMs": 908900,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "a hǎo zhòng\n啊好重"
    } ]
  }, {
    "tStartMs": 917166,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "hǎo la nǐ men kàn\n好啦你们看"
    } ]
  }, {
    "tStartMs": 919300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "zhè jiù shì wǒ jīn tiān de wǎn cān\n这就是我今天的晚餐"
    } ]
  }, {
    "tStartMs": 921200,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "yì dà lì miàn zuò hǎo la\n意大利面做好啦"
    } ]
  }, {
    "tStartMs": 924766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "ń kàn qǐ lái hái bú cuò\n嗯看起来还不错"
    } ]
  }, {
    "tStartMs": 928300,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "duān zhe wǒ de wǎn cān\n端着我的晚餐"
    } ]
  }, {
    "tStartMs": 930200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "duān duān pán zi hā\n端端盘子哈"
    } ]
  }, {
    "tStartMs": 932266,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "duān duān zhe tā lái chī fàn\n端端着它来吃饭"
    } ]
  }, {
    "tStartMs": 936600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "a\n啊"
    } ]
  }, {
    "tStartMs": 938766,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "hǎo wǒ xiàn zài yào chī fàn chī fàn\n好我现在要吃饭吃饭"
    } ]
  }, {
    "tStartMs": 943133,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "wǒ zhēn de jué de wǒ zì jǐ zuò de\n我真的觉得我自己做的"
    } ]
  }, {
    "tStartMs": 945066,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "yì dà lì miàn hái tǐng hǎo chī de ń\n意大利面还挺好吃的嗯"
    } ]
  }, {
    "tStartMs": 949400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯"
    } ]
  }, {
    "tStartMs": 951033,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "hěn ruǎn\n很软"
    } ]
  }, {
    "tStartMs": 952300,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "chī qǐ lái kǒu gǎn tè bié hǎo\n吃起来口感特别好"
