    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "zài zhè biān ne\n在这边呢"
    } ]
  }, {
    "tStartMs": 996466,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "ń rú guǒ nǐ chū qù chī fàn de huà huì hěn guì\n嗯如果你出去吃饭的话会很贵"
    } ]
  }, {
    "tStartMs": 999600,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "suǒ yǐ ne dà bù fèn rén è rú guǒ yǒu shí jiān\n所以呢大部分人呃如果有时间"
