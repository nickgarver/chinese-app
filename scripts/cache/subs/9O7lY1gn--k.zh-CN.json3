  }, {
    "tStartMs": 954866,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ń\n嗯"
    } ]
  }, {
    "tStartMs": 957166,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "zì jǐ zuò de fàn wèi dào zhēn de hǎo jí le\n自己做的饭味道真的好极了"
    } ]
  }, {
    "tStartMs": 961166,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "zì jǐ zuò de jiù shì hǎo chī\n自己做的就是好吃"
    } ]
  }, {
    "tStartMs": 963300,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "jiù shì jiù shì xiāng xiāng\n就是就是香香"
    } ]
  }, {
    "tStartMs": 967600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "nǐ yào píng jià yí gè shí wù de shí hòu\n你要评价一个食物的时候"
