    } ]
  }, {
    "tStartMs": 683033,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "suǒ yǐ rú guǒ yào qù hěn yuǎn hěn yuǎn hěn yuǎn de dì fāng\n所以如果要去很远很远很远的地方"
