    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "xū yào tí qián qù fēi jī chǎng\n需要提前去飞机场"
    } ]
  }, {
    "tStartMs": 662400,
    "dDurationMs": 4199,
    "segs": [ {
      "utf8": "dàn shì yǒu de shí hòu   méi yǒu bàn fǎ\n但是有的时候 没有办法"
    } ]
  }, {
    "tStartMs": 666766,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "rú guǒ nǐ cóng běi fāng qù nán fāng\n如果你从北方去南方"
    } ]
  }, {
    "tStartMs": 672100,
    "dDurationMs": 3699,
    "segs": [ {
      "utf8": "zuò fēi jī gèng kuài\n坐飞机更快"
    } ]
  }, {
    "tStartMs": 676000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "jǐ gè xiǎo shí jiù kě yǐ dào\n几个小时就可以到"
