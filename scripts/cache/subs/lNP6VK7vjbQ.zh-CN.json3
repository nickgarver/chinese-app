  }, {
    "tStartMs": 703333,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "nà zěn me zěn me zuò gōng jiāo chē\n那怎么怎么坐公交车"
    } ]
  }, {
    "tStartMs": 706866,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "zěn me zuò dì tiě   zěn me zuò huǒ chē ne\n怎么坐地铁 怎么坐火车呢"
