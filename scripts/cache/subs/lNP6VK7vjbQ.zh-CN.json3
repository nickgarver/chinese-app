    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "kàn jī piào 、 mǎi jī piào\n看机票、买机票"
    } ]
  }, {
    "tStartMs": 791500,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "suǒ yǐ rú guǒ nǐ lái zhōng guó\n所以如果你来中国"
    } ]
  }, {
    "tStartMs": 794033,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "nǐ kě yǐ yòng zhè xiē ruǎn jiàn lái\n你可以用这些软件来"
    } ]
  }, {
    "tStartMs": 798133,
    "dDurationMs": 7633,
    "segs": [ {
      "utf8": "zuò gōng jiāo chē 、 zuò dì tiě 、 huò zhě zuò huǒ chē hái yǒu fēi jī\n坐公交车、坐地铁、或者坐火车还有飞机"
    } ]
  }, {
    "tStartMs": 806000,
    "dDurationMs": 4499,
    "segs": [ {
      "utf8": "dāng rán rú guǒ nǐ xiǎng dǎ chē   nǐ kě yǐ yòng dī dī\n当然如果你想打车 你可以用滴滴"
    } ]
  }, {
    "tStartMs": 810600,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "dī dī hěn fāng biàn   wǒ men yì bān yòng dī dī dǎ chē\n滴滴很方便 我们一般用滴滴打车"
    } ]
  }, {
    "tStartMs": 816500,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "dāng rán le   wǒ . . .\n当然了 我..."
    } ]
  }, {
    "tStartMs": 818233,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "nà wǒ zuì xǐ huan de jiāo tōng fāng shì hái shì zǒu lù\n那我最喜欢的交通方式还是走路"
    } ]
  }, {
    "tStartMs": 823600,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "yīn wèi rú guǒ wǒ yào qù de dì fāng bú tài yuǎn\n因为如果我要去的地方不太远"
    } ]
  }, {
    "tStartMs": 829100,
    "dDurationMs": 6366,
    "segs": [ {
      "utf8": "bǐ rú zhǐ yǒu yì gōng lǐ 、 liǎng gōng lǐ huò zhě sān gōng lǐ\n比如只有一公里、两公里或者三公里"
    } ]
  }, {
    "tStartMs": 835466,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "wǒ huì xuǎn zé zǒu lù\n我会选择走路"
    } ]
  }, {
    "tStartMs": 838433,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "wǒ kě yǐ zǒu sān shí fēn zhōng 、\n我可以走三十分钟、"
    } ]
  }, {
    "tStartMs": 841466,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "sì shí fēn zhōng 、 huò zhě wǔ shí fēn zhōng\n四十分钟、或者五十分钟"
    } ]
  }, {
    "tStartMs": 845500,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "yí gè xiǎo shí yǐ nèi   wǒ jué de kě yǐ\n一个小时以内 我觉得可以"
    } ]
  }, {
    "tStartMs": 849933,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "wǒ zuì xǐ huan de jiāo tōng fāng shì hái shì zǒu lù\n我最喜欢的交通方式还是走路"
    } ]
  }, {
    "tStartMs": 854566,
    "dDurationMs": 6167,
    "segs": [ {
      "utf8": "nà nǐ ne   nǐ měi tiān zěn me qù shàng bān huò zhě qù shàng xué\n那你呢 你每天怎么去上班或者去上学"
    } ]
  }, {
    "tStartMs": 860733,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "zài nǐ zhù de dì fāng\n在你住的地方"
    } ]
  }, {
    "tStartMs": 863933,
    "dDurationMs": 5866,
    "segs": [ {
      "utf8": "shén me jiāo tōng fāng shì zuì shòu huān yíng 、 zuì fāng biàn\n什么交通方式最受欢迎、最方便"
    } ]
  }, {
    "tStartMs": 869800,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "nǐ zuì xǐ huan shén me jiāo tōng fāng shì\n你最喜欢什么交通方式"
    } ]
  }, {
    "tStartMs": 873566,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "huān yíng nǐ zài píng lùn qū lǐ gào sù wǒ\n欢迎你在评论区里告诉我"
    } ]
  }, {
    "tStartMs": 877066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "jīn tiān de shì pín jiù dào zhè lǐ\n今天的视频就到这里"
    } ]
  }, {
    "tStartMs": 879533,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "huān yíng nǐ guān kàn wǒ de shì pín\n欢迎你观看我的视频"
    } ]
  }, {
    "tStartMs": 882266,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "wǒ men xià gè shì pín zài jiàn   bài bài\n我们下个视频再见 拜拜"
    } ]
  } ]
