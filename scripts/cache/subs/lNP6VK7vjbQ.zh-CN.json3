  }, {
    "tStartMs": 638766,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ gèng xǐ huan zuò huǒ chē\n所以我更喜欢坐火车"
    } ]
  }, {
    "tStartMs": 642066,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "bú shì zuò fēi jī\n不是坐飞机"
    } ]
  }, {
    "tStartMs": 644200,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "yīn wèi zuò huǒ chē hěn fāng biàn\n因为坐火车很方便"
