  "events": [ {
    "tStartMs": 1000,
    "dDurationMs": 5999,
    "segs": [ {
      "utf8": "nǐ měi tiān zěn me qù shàng bān huò zhě shàng xué\n你每天怎么去上班或者上学"
    } ]
  }, {
    "tStartMs": 7366,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "nǐ kāi chē ma\n你开车吗"
    } ]
  }, {
    "tStartMs": 10866,
    "dDurationMs": 5167,
    "segs": [ {
      "utf8": "hái shì nǐ zuò dì tiě huò zhě zuò gōng jiāo chē\n还是你坐地铁或者坐公交车"
    } ]
  }, {
    "tStartMs": 16333,
    "dDurationMs": 7833,
    "segs": [ {
      "utf8": "hái shì nǐ zǒu lù huò zhě qí chē\n还是你走路或者骑车"
    } ]
  }, {
    "tStartMs": 24533,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "jīn tiān wǒ men yào liáo de huà tí shì jiāo tōng fāng shì\n今天我们要聊的话题是交通方式"
    } ]
  }, {
    "tStartMs": 30466,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "dà jiā hǎo   wǒ shì xiǎo nà\n大家好 我是小娜"
    } ]
  }, {
    "tStartMs": 32666,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "huān yíng nǐ hé wǒ yì qǐ xué zhōng wén\n欢迎你和我一起学中文"
    } ]
  }, {
    "tStartMs": 37300,
    "dDurationMs": 7199,
    "segs": [ {
      "utf8": "zài zhōng guó   zuì cháng jiàn de gōng gòng jiāo tōng fāng shì yǒu\n在中国 最常见的公共交通方式有"
    } ]
  }, {
    "tStartMs": 45266,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "gōng jiāo chē hé dì tiě\n公交车和地铁"
    } ]
  }, {
    "tStartMs": 48533,
    "dDurationMs": 6133,
    "segs": [ {
      "utf8": "rú guǒ cóng yí gè chéng shì qù lìng wài yí gè chéng shì\n如果从一个城市去另外一个城市"
    } ]
  }, {
    "tStartMs": 55133,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "yǒu huǒ chē hé fēi jī\n有火车和飞机"
    } ]
  }, {
    "tStartMs": 60166,
    "dDurationMs": 6467,
    "segs": [ {
      "utf8": "nà zhōng guó rén měi tiān zěn me qù shàng bān huò zhě shàng xué ne\n那中国人每天怎么去上班或者上学呢"
    } ]
  }, {
    "tStartMs": 67100,
    "dDurationMs": 6733,
    "segs": [ {
      "utf8": "dà bù fen rén měi tiān zuò gōng jiāo chē huò zhě zuò dì tiě\n大部分人每天坐公交车或者坐地铁"
    } ]
  }, {
    "tStartMs": 74366,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "dàn shì xiǎo chéng shì lǐ miàn méi yǒu dì tiě\n但是小城市里面没有地铁"
    } ]
  }, {
    "tStartMs": 79300,
    "dDurationMs": 3399,
    "segs": [ {
      "utf8": "dài chéng shì lǐ miàn yì bān yǒu dì tiě\n大城市里面一般有地铁"
    } ]
  }, {
    "tStartMs": 83466,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "yīn wèi dài chéng shì lǐ yǒu hěn duō chē\n因为大城市里有很多车"
    } ]
  }, {
    "tStartMs": 87066,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "suǒ yǐ huì dǔ chē\n所以会堵车"
    } ]
  }, {
    "tStartMs": 91266,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "suǒ yǐ huì yǒu dì tiě\n所以会有地铁"
    } ]
  }, {
    "tStartMs": 94933,
    "dDurationMs": 5366,
    "segs": [ {
      "utf8": "yǒu xiē rén yě huì kāi chē qù shàng bān\n有些人也会开车去上班"
    } ]
  }, {
    "tStartMs": 100533,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "bǐ rú wǒ de lǎo gōng tā měi tiān kāi chē qù shàng bān\n比如我的老公他每天开车去上班"
    } ]
  }, {
    "tStartMs": 106166,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "yīn wèi gōng gòng jiāo tōng bú shì hěn fāng biàn\n因为公共交通不是很方便"
    } ]
  }, {
    "tStartMs": 111100,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "suǒ yǐ tā měi tiān kāi chē\n所以他每天开车"
    } ]
  }, {
    "tStartMs": 115166,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "wǒ ne   wǒ měi tiān zěn me qù . . .\n我呢 我每天怎么去..."
    } ]
  }, {
    "tStartMs": 118333,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "bú jiào shàng bān\n不叫上班"
    } ]
  }, {
    "tStartMs": 120200,
    "dDurationMs": 4399,
    "segs": [ {
      "utf8": "wǒ měi tiān zěn me qù gōng zuò\n我每天怎么去工作"
    } ]
  }, {
    "tStartMs": 124700,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "yīn wèi wǒ zài jiā gōng zuò\n因为我在家工作"
    } ]
  }, {
    "tStartMs": 127900,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "huò zhě yǒu shí hòu wǒ qù kā fēi diàn gōng zuò\n或者有时候我去咖啡店工作"
    } ]
  }, {
    "tStartMs": 132400,
    "dDurationMs": 6133,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ de jiāo tōng fāng shì shì — zǒu lù\n所以我的交通方式是—走路"
    } ]
  }, {
    "tStartMs": 138533,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "duì   wǒ zǒu lù qù kā fēi diàn\n对 我走路去咖啡店"
    } ]
  }, {
    "tStartMs": 142000,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "gōng jiāo chē hé dì tiě\n公交车和地铁"
    } ]
  }, {
    "tStartMs": 145300,
    "dDurationMs": 4599,
    "segs": [ {
      "utf8": "nǐ gèng xǐ huan nǎ zhǒng jiāo tōng fāng shì\n你更喜欢哪种交通方式"
    } ]
  }, {
    "tStartMs": 149966,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "nǐ gèng xǐ huan nǎ gè\n你更喜欢哪个"
    } ]
  }, {
    "tStartMs": 152666,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "gōng jiāo chē hái shì dì tiě\n公交车还是地铁"
    } ]
  }, {
    "tStartMs": 157333,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "wǒ ne\n我呢"
    } ]
  }, {
    "tStartMs": 158766,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "wǒ gèng xǐ huan dì tiě\n我更喜欢地铁"
    } ]
  }, {
    "tStartMs": 162100,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "wǒ hěn tǎo yàn gōng jiāo chē\n我很讨厌公交车"
    } ]
  }, {
    "tStartMs": 165733,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "wèi shén me ne\n为什么呢"
    } ]
  }, {
    "tStartMs": 167666,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "yīn wèi bǐ rú   gōng jiāo chē wǒ jué de\n因为比如 公交车我觉得"
    } ]
  }, {
    "tStartMs": 173466,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "méi yǒu gù dìng de shí jiān\n没有固定的时间"
    } ]
  }, {
    "tStartMs": 177700,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "nǐ xū yào zài gōng jiāo chē zhàn děng\n你需要在公交车站等"
    } ]
  }, {
    "tStartMs": 182066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "nǐ bù zhī dào\n你不知道"
    } ]
  }, {
    "tStartMs": 183933,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "shén me shí hòu gōng jiāo chē huì lái\n什么时候公交车会来"
    } ]
  }, {
    "tStartMs": 188066,
    "dDurationMs": 5733,
    "segs": [ {
      "utf8": "suǒ yǐ méi yǒu gù dìng de shí jiān   wǒ bù xǐ huan\n所以没有固定的时间 我不喜欢"
    } ]
  }, {
    "tStartMs": 193966,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "kě néng yào děng shí fēn zhōng 、 èr shí fēn zhōng\n可能要等十分钟、二十分钟"
    } ]
  }, {
    "tStartMs": 198333,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "huò zhě bàn gè xiǎo shí\n或者半个小时"
    } ]
  }, {
    "tStartMs": 201366,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "yīn wèi gōng jiāo chē zài dì shàng zǒu\n因为公交车在地上走"
    } ]
  }, {
    "tStartMs": 206033,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "kě néng huì dǔ chē\n可能会堵车"
    } ]
  }, {
    "tStartMs": 208466,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "suǒ yǐ shí jiān bú gù dìng\n所以时间不固定"
    } ]
  }, {
    "tStartMs": 211566,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "wǒ bù xǐ huan gōng jiāo chē\n我不喜欢公交车"
    } ]
  }, {
    "tStartMs": 214466,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "rán hòu   wǒ zuò gōng jiāo chē de shí hòu\n然后 我坐公交车的时候"
    } ]
  }, {
    "tStartMs": 219100,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "wǒ huì yùn chē\n我会晕车"
    } ]
  }, {
    "tStartMs": 222233,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "jiù shì zuò gōng jiāo chē de shí hòu wǒ bù shū fú\n就是坐公交车的时候我不舒服"
    } ]
  }, {
    "tStartMs": 227400,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "wǒ huì jué de hěn nán shòu\n我会觉得很难受"
    } ]
  }, {
    "tStartMs": 231700,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "wǒ bù kě yǐ kàn shǒu jī\n我不可以看手机"
    } ]
  }, {
    "tStartMs": 234133,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "rú guǒ wǒ kàn shǒu jī wǒ huì yùn chē\n如果我看手机我会晕车"
    } ]
  }, {
    "tStartMs": 238533,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "yūn dé hěn lì hài\n晕得很厉害"
    } ]
  }, {
    "tStartMs": 240800,
    "dDurationMs": 6066,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ fēi cháng fēi cháng tǎo yàn zuò gōng jiāo chē\n所以我非常非常讨厌坐公交车"
    } ]
  }, {
    "tStartMs": 247500,
    "dDurationMs": 6399,
    "segs": [ {
      "utf8": "wǒ jué de wǒ hěn cháng shí jiān méi yǒu zuò gōng jiāo chē le\n我觉得我很长时间没有坐公交车了"
    } ]
  }, {
    "tStartMs": 253900,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "wǒ xiàn zài bú jì de\n我现在不记得"
    } ]
  }, {
    "tStartMs": 257200,
    "dDurationMs": 5666,
    "segs": [ {
      "utf8": "shàng yí cì zuò gōng jiāo chē shì shén me shí hòu le\n上一次坐公交车是什么时候了"
    } ]
  }, {
    "tStartMs": 263400,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "rán hòu wǒ hěn xǐ huan zuò dì tiě\n然后我很喜欢坐地铁"
    } ]
  }, {
    "tStartMs": 267400,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "yīn wèi dì tiě yǒu gù dìng de shí jiān\n因为地铁有固定的时间"
    } ]
  }, {
    "tStartMs": 271766,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "jǐ diǎn   jǐ diǎn   jǐ diǎn\n几点 几点 几点"
    } ]
  }, {
    "tStartMs": 274666,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "wǒ hěn xǐ huan\n我很喜欢"
    } ]
  }, {
    "tStartMs": 276266,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "dì tiě lǐ yì bān yǒu wèi shēng jiān\n地铁里一般有卫生间"
    } ]
  }, {
    "tStartMs": 281200,
    "dDurationMs": 3699,
    "segs": [ {
      "utf8": "suǒ yǐ rú guǒ nǐ xiǎng qù wèi shēng jiān\n所以如果你想去卫生间"
    } ]
  }, {
    "tStartMs": 284900,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "dì tiě kě yǐ   hěn fāng biàn\n地铁可以 很方便"
    } ]
  }, {
    "tStartMs": 288300,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "nà kāi chē ne\n那开车呢"
    } ]
  }, {
    "tStartMs": 290566,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "kāi chē zěn me yàng\n开车怎么样"
    } ]
  }, {
    "tStartMs": 294400,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "zài zhōng guó   bǐ rú zǎo shàng de shí hòu\n在中国 比如早上的时候"
    } ]
  }, {
    "tStartMs": 298900,
    "dDurationMs": 4399,
    "segs": [ {
      "utf8": "zǎo shàng qī diǎn dào jiǔ diǎn zuǒ yòu\n早上七点到九点左右"
    } ]
  }, {
    "tStartMs": 303833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "wǒ men jiào zǎo gāo fēng\n我们叫早高峰"
    } ]
  }, {
    "tStartMs": 306700,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "jiù shì zài qī diǎn dào jiǔ diǎn de shí hòu\n就是在七点到九点的时候"
    } ]
  }, {
    "tStartMs": 310366,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "hěn duō rén kāi chē qù shàng bān\n很多人开车去上班"
    } ]
  }, {
    "tStartMs": 314566,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "lù shang yǒu hěn duō gōng jiāo chē\n路上有很多公交车"
    } ]
  }, {
    "tStartMs": 317500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "yǒu hěn duō chē\n有很多车"
    } ]
  }, {
    "tStartMs": 319033,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "suǒ yǐ huì hěn dǔ chē\n所以会很堵车"
    } ]
  }, {
    "tStartMs": 322233,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "wǒ men jiào zǎo gāo fēng\n我们叫早高峰"
    } ]
  }, {
    "tStartMs": 324666,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "wǎn shàng de shí hòu\n晚上的时候"
    } ]
  }, {
    "tStartMs": 325866,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "dà gài cóng wǎn shàng wǔ diǎn dào wǎn shàng qī diǎn\n大概从晚上五点到晚上七点"
