  }, {
    "tStartMs": 351500,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "wǒ huì xuǎn zé hěn zǎo dì chū fā\n我会选择很早地出发"
    } ]
  }, {
    "tStartMs": 355800,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "zhè yàng kě yǐ bì kāi zǎo gāo fēng\n这样可以避开早高峰"
    } ]
  }, {
    "tStartMs": 360166,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "dāng rán zài zhōng guó dǎ chē yě hěn fāng biàn\n当然在中国打车也很方便"
    } ]
  }, {
    "tStartMs": 366066,
    "dDurationMs": 6567,
    "segs": [ {
      "utf8": "jiù shì dǎ chū zū chē huò zhě dǎ dī shì\n就是打出租车或者打的士"
    } ]
  }, {
    "tStartMs": 373033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "wǒ men yě shuō dǎ de\n我们也说打的"
    } ]
  }, {
    "tStartMs": 376033,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "huò zhě dǎ chū zū chē\n或者打出租车"
    } ]
  }, {
    "tStartMs": 378766,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "zài zhōng guó dǎ chē méi yǒu nà me guì\n在中国打车没有那么贵"
    } ]
  }, {
    "tStartMs": 384166,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "yǐ qián wǒ zài ōu zhōu de shí hòu\n以前我在欧洲的时候"
    } ]
  }, {
    "tStartMs": 388000,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "cóng lái méi yǒu dǎ guò chē\n从来没有打过车"
    } ]
  }, {
    "tStartMs": 391600,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "yīn wèi ōu zhōu de chū zū chē tài guì le\n因为欧洲的出租车太贵了"
    } ]
  }, {
    "tStartMs": 396566,
    "dDurationMs": 5267,
    "segs": [ {
      "utf8": "dàn shì zài zhōng guó wǒ jué de dǎ chē méi yǒu nà me guì\n但是在中国我觉得打车没有那么贵"
    } ]
  }, {
    "tStartMs": 402333,
    "dDurationMs": 6133,
    "segs": [ {
      "utf8": "zài zhōng guó wǒ men jīng cháng yòng yí gè ruǎn jiàn jiào dī dī\n在中国我们经常用一个软件叫滴滴"
    } ]
  }, {
    "tStartMs": 409000,
    "dDurationMs": 6699,
    "segs": [ {
      "utf8": "dī dī hé guó wài de u b e r huò zhě g r a b hěn xiàng\n滴滴和国外的uber或者grab很像"
    } ]
  }, {
    "tStartMs": 415800,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "zài zhōng guó wǒ men yòng dī dī dǎ chū zū chē\n在中国我们用滴滴打出租车"
    } ]
  }, {
    "tStartMs": 420333,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "hái yǒu yì zhǒng jiāo tōng fāng shì hěn tè bié\n还有一种交通方式很特别"
    } ]
  }, {
    "tStartMs": 425366,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "jiù shì qí diàn dòng chē\n就是骑电动车"
    } ]
  }, {
    "tStartMs": 430166,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "diàn dòng chē bú shì zì xíng chē   yě bú shì mó tuō chē\n电动车不是自行车 也不是摩托车"
    } ]
  }, {
    "tStartMs": 437466,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "tā shì yòng diàn de   tā kě yǐ pǎo dé hěn kuài\n它是用电的 它可以跑得很快"
    } ]
  }, {
    "tStartMs": 442800,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "nǐ bù xū yào dēng\n你不需要蹬"
    } ]
  }, {
    "tStartMs": 447500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "nǐ zhī xū yào zuò zhe\n你只需要坐着"
    } ]
  }, {
    "tStartMs": 449033,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "rán hòu yǒu diàn   suǒ yǐ tā pǎo dé hěn kuài\n然后有电 所以它跑得很快"
    } ]
  }, {
    "tStartMs": 454566,
    "dDurationMs": 5267,
    "segs": [ {
      "utf8": "zài zhōng guó yǒu hěn duō wài mài yuán qí diàn dòng chē\n在中国有很多外卖员骑电动车"
    } ]
  }, {
    "tStartMs": 460200,
    "dDurationMs": 6899,
    "segs": [ {
      "utf8": "yīn wèi xiàn zài yuè lái yuè duō de rén diǎn wài mài 、 chī wài mài\n因为现在越来越多的人点外卖、吃外卖"
    } ]
  }, {
    "tStartMs": 467266,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "suǒ yǐ sòng wài mài de rén yuè lái yuè duō\n所以送外卖的人越来越多"
    } ]
  }, {
    "tStartMs": 472400,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "qí diàn dòng chē sòng wài mài de rén yuè lái yuè duō\n骑电动车送外卖的人越来越多"
    } ]
  }, {
    "tStartMs": 477200,
    "dDurationMs": 5499,
    "segs": [ {
      "utf8": "yóu qí shì zài dài chéng shì lǐ   yǒu hěn duō diàn dòng chē\n尤其是在大城市里 有很多电动车"
    } ]
  }, {
    "tStartMs": 483166,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "ér qiě tā men qí dé hěn kuài\n而且他们骑得很快"
    } ]
  }, {
    "tStartMs": 486866,
    "dDurationMs": 6567,
    "segs": [ {
      "utf8": "suǒ yǐ nǐ zǒu lù de shí hòu yí dìng yào hěn xiǎo xīn\n所以你走路的时候一定要很小心"
    } ]
  }, {
    "tStartMs": 494500,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "qí diàn dòng chē huò zhě qí zì xíng chē\n骑电动车或者骑自行车"
    } ]
  }, {
    "tStartMs": 499800,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "zài yǒu de chéng shì lǐ wǒ jué de kě yǐ\n在有的城市里我觉得可以"
    } ]
  }, {
    "tStartMs": 504300,
    "dDurationMs": 2499,
    "segs": [ {
      "utf8": "dàn shì yǒu xiē dì fāng\n但是有些地方"
    } ]
  }, {
    "tStartMs": 506800,
    "dDurationMs": 8066,
    "segs": [ {
      "utf8": "méi yǒu gěi zì xíng chē huò zhě diàn dòng chē zǒu de lù\n没有给自行车或者电动车走的路"
    } ]
  }, {
    "tStartMs": 515000,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "zhǐ yǒu chē zǒu de lù\n只有车走的路"
    } ]
  }, {
    "tStartMs": 517166,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "méi yǒu zì xíng chē dào\n没有自行车道"
    } ]
  }, {
    "tStartMs": 520533,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "zhè yàng wǒ jué de hěn bù fāng biàn   hěn bù ān quán\n这样我觉得很不方便 很不安全"
    } ]
  }, {
    "tStartMs": 526033,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "rú guǒ nǐ xiǎng cóng yí gè chéng shì dào lìng wài yí gè chéng shì\n如果你想从一个城市到另外一个城市"
    } ]
  }, {
    "tStartMs": 532333,
    "dDurationMs": 5533,
    "segs": [ {
      "utf8": "cóng yí gè dì fāng dào lìng wài yí gè bǐ jiào yuǎn de dì fāng\n从一个地方到另外一个比较远的地方"
    } ]
  }, {
    "tStartMs": 538100,
    "dDurationMs": 7199,
    "segs": [ {
      "utf8": "nà nǐ kě yǐ zuò huǒ chē huò zhě zuò fēi jī\n那你可以坐火车或者坐飞机"
    } ]
  }, {
    "tStartMs": 546100,
    "dDurationMs": 5566,
    "segs": [ {
      "utf8": "zài zhōng guó huǒ chē yǒu chà bù duō liǎng zhǒng\n在中国火车有差不多两种"
    } ]
  }, {
    "tStartMs": 552166,
    "dDurationMs": 6367,
    "segs": [ {
      "utf8": "yì zhǒng shì hěn zhèng cháng de huǒ chē 、 hěn pǔ tōng de huǒ chē\n一种是很正常的火车、很普通的火车"
    } ]
  }, {
    "tStartMs": 558900,
    "dDurationMs": 5333,
    "segs": [ {
      "utf8": "lìng wài yì zhǒng shì hěn kuài de huǒ chē     wǒ men jiào gāo tiě\n另外一种是很快的火车  我们叫高铁"
    } ]
  }, {
    "tStartMs": 564333,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "bǐ rú rú guǒ cóng zhōng guó de běi fāng bǐ rú běi jīng\n比如如果从中国的北方比如北京"
    } ]
  }, {
    "tStartMs": 569133,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "dào zhōng guó de nán fāng shēn zhèn\n到中国的南方深圳"
    } ]
  }, {
    "tStartMs": 573700,
    "dDurationMs": 5466,
    "segs": [ {
      "utf8": "nà rú guǒ nǐ zuò pǔ tōng de huǒ chē   kě néng yào zuò hěn jiǔ\n那如果你坐普通的火车 可能要坐很久"
    } ]
  }, {
    "tStartMs": 579300,
    "dDurationMs": 6266,
    "segs": [ {
      "utf8": "yào zuò shí jǐ gè xiǎo shí huò zhě èr shí jǐ gè xiǎo shí\n要坐十几个小时或者二十几个小时"
    } ]
  }, {
    "tStartMs": 585733,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "rú guǒ nǐ zuò gāo tiě nà kě néng xū yào\n如果你坐高铁那可能需要"
    } ]
  }, {
    "tStartMs": 590100,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "( wǒ bù zhī dào ) jǐ gè xiǎo shí   jiù kě yǐ le\n(我不知道)几个小时 就可以了"
    } ]
  }, {
    "tStartMs": 593966,
    "dDurationMs": 6233,
    "segs": [ {
      "utf8": "suǒ yǐ rú guǒ nǐ yào cóng yí gè dì fāng qù yí gè hěn yuǎn de dì fāng\n所以如果你要从一个地方去一个很远的地方"
    } ]
  }, {
    "tStartMs": 600200,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "nǐ kě yǐ xuǎn zé zuò gāo tiě\n你可以选择坐高铁"
    } ]
  }, {
    "tStartMs": 602900,
    "dDurationMs": 5733,
    "segs": [ {
      "utf8": "gāo tiě gèng gèng guì   rán hòu gāo tiě gèng kuài\n高铁更更贵 然后高铁更快"
    } ]
  }, {
    "tStartMs": 609066,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "dàn shì gāo tiě méi yǒu zhàn piào\n但是高铁没有站票"
    } ]
  }, {
    "tStartMs": 613000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "méi yǒu zhàn zhe de rén\n没有站着的人"
    } ]
  }, {
    "tStartMs": 615133,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "suǒ yǐ gāo tiě rén gèng shǎo\n所以高铁人更少"
    } ]
  }, {
    "tStartMs": 619766,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "zuò fēi jī yě kě yǐ\n坐飞机也可以"
    } ]
  }, {
    "tStartMs": 622100,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "zài zhōng guó zuò fēi jī yě hěn cháng jiàn\n在中国坐飞机也很常见"
    } ]
  }, {
    "tStartMs": 627633,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "dàn shì\n但是"
    } ]
  }, {
    "tStartMs": 629666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "zuò fēi jī xū yào qù jī chǎng děng   duì bu duì\n坐飞机需要去机场等 对不对"
    } ]
  }, {
    "tStartMs": 634700,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "zuò fēi jī xū yào tí qián qù jī chǎng\n坐飞机需要提前去机场"
