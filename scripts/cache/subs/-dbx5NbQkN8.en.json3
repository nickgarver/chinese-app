{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 33,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "Welcome to my second Chinese podcast."
    } ]
  }, {
    "tStartMs": 4333,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "In this video,"
    } ]
  }, {
    "tStartMs": 6100,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "I will share my journey from China to Vietnam."
    } ]
  }, {
    "tStartMs": 11533,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "I will take you from China to Vietnam."
    } ]
  }, {
    "tStartMs": 15400,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "You can learn some"
    } ]
  }, {
    "tStartMs": 17100,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "about transportation."
    } ]
  }, {
    "tStartMs": 20533,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "Finally, I will share a little story."
    } ]
  }, {
    "tStartMs": 24400,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "which is a very unexpected thing."
    } ]
  }, {
    "tStartMs": 29300,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "Let's get started now."
    } ]
  }, {
    "tStartMs": 31466,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "Here, I would like to recommend a plugin to you."
    } ]
  }, {
    "tStartMs": 34800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "called Language Reactor."
    } ]
  }, {
    "tStartMs": 37000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "In the last video,"
    } ]
  }, {
    "tStartMs": 38200,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "someone suggested I could add pinyin."
    } ]
  }, {
    "tStartMs": 42800,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "Actually, I have uploaded subtitles."
    } ]
  }, {
    "tStartMs": 45833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Through this plugin,"
    } ]
  }, {
    "tStartMs": 47333,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "you can see pinyin, Chinese,"
    } ]
  }, {
    "tStartMs": 50433,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "and translation."
    } ]
  }, {
    "tStartMs": 52600,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It's very helpful for language learning."
    } ]
  }, {
    "tStartMs": 55800,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "I left China for Vietnam on Sunday."
    } ]
  }, {
    "tStartMs": 59800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "The flight was at eight a.m."
    } ]
  }, {
    "tStartMs": 62100,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "There was no direct flight."
    } ]
  }, {
    "tStartMs": 63200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "so I needed to transfer."
    } ]
  }, {
    "tStartMs": 65933,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The night before,"
    } ]
  }, {
    "tStartMs": 67133,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "I booked a ride-sharing car at half past five."
    } ]
  }, {
    "tStartMs": 71200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "I set an alarm for four forty-five."
    } ]
  }, {
    "tStartMs": 74000,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "I left on time at a quarter past five."
    } ]
  }, {
    "tStartMs": 76266,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "I waited for the elevator with my suitcase at the elevator."
    } ]
  }, {
    "tStartMs": 81633,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "The elevator arrived."
    } ]
  }, {
    "tStartMs": 82933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "I got on the elevator"
    } ]
  }, {
    "tStartMs": 85300,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and pressed the button for the first floor."
    } ]
  }, {
    "tStartMs": 87833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The driver was waiting for me downstairs."
    } ]
  }, {
    "tStartMs": 90200,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It took about forty minutes from my home to the airport."
    } ]
  }, {
    "tStartMs": 94233,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "I passed through a tunnel on the way."
    } ]
  }, {
    "tStartMs": 97000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Then I got on the airport expressway."
    } ]
  }, {
    "tStartMs": 100300,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "The driver paid the toll at the toll station."
    } ]
  }, {
    "tStartMs": 103800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I arrived at the International Airport."
    } ]
  }, {
    "tStartMs": 105600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "I need to check my luggage first."
    } ]
  }, {
    "tStartMs": 108500,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "to check my luggage."
    } ]
  }, {
    "tStartMs": 110500,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "The ticket I bought has a 20-kilogram baggage weight limit."
    } ]
  }, {
    "tStartMs": 114300,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "I put my suitcase on the conveyor belt."
    } ]
  }, {
    "tStartMs": 117800,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "The scale shows 14.5 kilograms."
    } ]
  }, {
    "tStartMs": 122133,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "It didn't exceed the limit of the suitcase."
    } ]
  }, {
    "tStartMs": 125500,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "The airport staff asked me if I wanted a window seat"
    } ]
  }, {
    "tStartMs": 129000,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "or aisle seat."
    } ]
  }, {
    "tStartMs": 131833,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "I told him"
    } ]
  }, {
    "tStartMs": 132833,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "I want a window seat."
    } ]
  }, {
    "tStartMs": 135500,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "because I want to see the scenery outside the window."
    } ]
  }, {
    "tStartMs": 138866,
    "dDurationMs": 367,
    "segs": [ {
      "utf8": "Of course,"
    } ]
  }, {
    "tStartMs": 139233,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "the aisle seat is more convenient."
    } ]
  }, {
    "tStartMs": 142066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Because if you want to go to the bathroom,"
    } ]
  }, {
    "tStartMs": 144666,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "you can go out directly."
    } ]
  }, {
    "tStartMs": 147633,
    "dDurationMs": 5167,
    "segs": [ {
      "utf8": "No need to ask the person next to you to stand up and make way for you"
    } ]
  }, {
    "tStartMs": 152800,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "But actually, I don't like using the toilet on the plane."
    } ]
  }, {
    "tStartMs": 156533,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "so I still chose a window seat."
    } ]
  }, {
    "tStartMs": 159400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I woke up very early in the morning."
    } ]
  }, {
    "tStartMs": 161533,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "So I started sleeping as soon as I got on the plane."
    } ]
  }, {
    "tStartMs": 164666,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "The meal on the early morning flight was some breakfast."
    } ]
  }, {
    "tStartMs": 168866,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "which includes bread,"
    } ]
  }, {
    "tStartMs": 170600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "beef cubes,"
    } ]
  }, {
    "tStartMs": 172400,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "and yogurt."
    } ]
  }, {
    "tStartMs": 173833,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "The flight is about three hours long."
    } ]
  }, {
    "tStartMs": 177633,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So I arrived at Kunming Airport at eleven am."
    } ]
  }, {
    "tStartMs": 181233,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "I need to transfer at Kunming Airport."
    } ]
  }, {
    "tStartMs": 184300,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "The next flight to Ho Chi Minh City"
    } ]
  }, {
    "tStartMs": 187133,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "is at four o'clock p.m."
    } ]
  }, {
    "tStartMs": 189200,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "I still had a long time to wait."
    } ]
  }, {
    "tStartMs": 191633,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "So I found an empty seat at the airport."
    } ]
  }, {
    "tStartMs": 194866,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "I sat down and edited the videos I took."
    } ]
  }, {
    "tStartMs": 198933,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Time passed very quickly."
    } ]
  }, {
    "tStartMs": 200600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "When I finished editing the video,"
    } ]
  }, {
    "tStartMs": 202533,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "it was already two o'clock in the afternoon."
    } ]
  }, {
    "tStartMs": 204600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "I saw on my phone that"
    } ]
  }, {
    "tStartMs": 206900,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "boarding gate was number seventy."
    } ]
  }, {
    "tStartMs": 209500,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "But at that time, I looked at their signs"
    } ]
  }, {
    "tStartMs": 213333,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "I didn't see where Gate seventy was."
    } ]
  }, {
    "tStartMs": 216900,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "So I went to ask the staff."
    } ]
  }, {
    "tStartMs": 220433,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "He told me"
    } ]
  }, {
    "tStartMs": 221733,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Gate seventy is in the international flight area."
    } ]
  }, {
    "tStartMs": 226000,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "I need to take the elevator and turn left."
    } ]
  }, {
    "tStartMs": 230733,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "when departing from the country"
    } ]
  }, {
    "tStartMs": 232066,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "customs asked me what I was doing in Vietnam,"
    } ]
  }, {
    "tStartMs": 235033,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "how long I would stay,"
    } ]
  }, {
    "tStartMs": 237033,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "and what my occupation was."
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "After confirming some information with me,"
    } ]
  }, {
    "tStartMs": 242933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "and let me go."
    } ]
  }, {
    "tStartMs": 244800,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "I waited in the waiting hall for boarding."
    } ]
  }, {
    "tStartMs": 248066,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "It takes three hours to fly from Kunming to Vietnam."
    } ]
  }, {
    "tStartMs": 251433,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "I arrived at six pm local time."
    } ]
  }, {
    "tStartMs": 255500,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "Then I needed to apply for a visa at customs."
    } ]
  }, {
    "tStartMs": 258933,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "At this time,"
    } ]
  }, {
    "tStartMs": 259900,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "something really happened"
    } ]
  }, {
    "tStartMs": 261633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "very unexpected thing happened to me."
    } ]
  }, {
    "tStartMs": 264700,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "I was very surprised."
    } ]
  }, {
    "tStartMs": 266800,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "and I also felt a little bad impression."
    } ]
  }, {
    "tStartMs": 270200,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Although I don't want to have such a preconceived impression,"
    } ]
  }, {
    "tStartMs": 275200,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "I also don't want to affect what comes next."
    } ]
  }, {
    "tStartMs": 278133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "What I feel about this country when I travel in this country"
    } ]
  }, {
    "tStartMs": 279833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "Feelings about this country"
    } ]
  }, {
    "tStartMs": 282433,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "But I still decided to tell this story."
    } ]
  }, {
    "tStartMs": 286200,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "The visa for Chinese to Vietnam is a bit special."
    } ]
  }, {
    "tStartMs": 289900,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "I applied for an e-visa online in advance."
    } ]
  }, {
    "tStartMs": 294833,
    "dDurationMs": 5833,
    "segs": [ {
      "utf8": "and then I need to apply for a paper visa upon arrival."
    } ]
  }, {
    "tStartMs": 301033,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Because China and Vietnam have a small territorial dispute."
    } ]
  }, {
    "tStartMs": 305433,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "A little dispute"
    } ]
  }, {
    "tStartMs": 306633,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "I won't go into that here."
    } ]
  }, {
    "tStartMs": 310066,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "If you are interested, you can check it out."
    } ]
  }, {
    "tStartMs": 312866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Because of this territorial dispute,"
    } ]
  }, {
    "tStartMs": 315433,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "so the Vietnamese customs"
    } ]
  }, {
    "tStartMs": 317433,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "do not stamp on Chinese passports."
    } ]
  }, {
    "tStartMs": 322133,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "They need to print out another piece of paper."
    } ]
  }, {
    "tStartMs": 325866,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "stamp on that paper."
    } ]
  }, {
    "tStartMs": 327833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "This process is actually very fast."
    } ]
  }, {
    "tStartMs": 330633,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "It should take a few minutes."
    } ]
  }, {
    "tStartMs": 333266,
    "dDurationMs": 6367,
    "segs": [ {
      "utf8": "But they made the Chinese wait for two hours,"
    } ]
  }, {
    "tStartMs": 339633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "or even three hours."
    } ]
  }, {
    "tStartMs": 341800,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "The staff asked us to hand over our passports"
    } ]
  }, {
    "tStartMs": 346066,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "and then sat there waiting."
    } ]
  }, {
    "tStartMs": 349733,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "and didn't tell us how long we had to wait."
    } ]
  }, {
    "tStartMs": 352933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "There was no process of getting a number."
    } ]
  }, {
    "tStartMs": 356066,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "I remember when I waited for an hour and a half,"
    } ]
  }, {
    "tStartMs": 358833,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "I went to ask their staff."
    } ]
  }, {
    "tStartMs": 360900,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "He didn't give me a direct answer."
    } ]
  }, {
    "tStartMs": 363066,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "He said his colleague was working inside"
    } ]
  }, {
    "tStartMs": 366966,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "to help us with the visa."
    } ]
  }, {
    "tStartMs": 369166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "and told me to go back and wait."
    } ]
  }, {
    "tStartMs": 370733,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "I actually felt a little regretful at that time."
    } ]
  }, {
    "tStartMs": 373066,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "I didn't get the visa in China."
    } ]
  }, {
    "tStartMs": 377233,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "In China,"
    } ]
  }, {
    "tStartMs": 377933,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "If I had found an agent to handle the visa,"
    } ]
  }, {
    "tStartMs": 381666,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "It might cost a little over 100 yuan more."
    } ]
  }, {
    "tStartMs": 385533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "At that time, I thought"
    } ]
  }, {
    "tStartMs": 387733,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "It should also be pretty easy to get this after you arrive."
    } ]
  }, {
    "tStartMs": 391066,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "It wouldn't take that long."
    } ]
  }, {
    "tStartMs": 392533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "So I didn't do it."
    } ]
  }, {
    "tStartMs": 395200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "Their efficiency is really low."
    } ]
  }, {
    "tStartMs": 397766,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Actually, I think"
    } ]
  }, {
    "tStartMs": 398766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "the main reason may not be low efficiency,"
    } ]
  }, {
    "tStartMs": 401233,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "but the money is not enough."
    } ]
  }, {
    "tStartMs": 405166,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Because they blatantly want tips."
    } ]
  }, {
    "tStartMs": 411000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "Some Chinese people"
    } ]
  }, {
    "tStartMs": 412966,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "they put some cash in their passports."
    } ]
  }, {
    "tStartMs": 416266,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "They don't need to wait at all."
    } ]
  }, {
    "tStartMs": 418200,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "Basically, they get their visas in one or two minutes."
    } ]
  }, {
    "tStartMs": 422733,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So I think it's all about money."
    } ]
  }, {
    "tStartMs": 426666,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "It should be said the problem of corruption."
    } ]
  }, {
    "tStartMs": 428500,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "In between, there were also some agents who cut in line."
    } ]
  }, {
    "tStartMs": 431066,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "those agents "
    } ]
  }, {
    "tStartMs": 431800,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "They were holding a stack of passports that thick in their hands."
    } ]
  }, {
    "tStartMs": 435600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Then go to the counter and hand (them)  to the customs officers."
    } ]
  }, {
    "tStartMs": 439766,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "The visas for this stack of passports were also processed very quickly."
    } ]
  }, {
    "tStartMs": 443633,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "I believe they must be paying kickbacks to customs officials."
    } ]
  }, {
    "tStartMs": 448766,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "There was a middle-aged man"
    } ]
  }, {
    "tStartMs": 452000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "maybe around forty years old."
    } ]
  }, {
    "tStartMs": 454366,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "He waited for three hours."
    } ]
  }, {
    "tStartMs": 456033,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "He was very angry."
    } ]
  }, {
    "tStartMs": 457966,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "and loudly questioned them at the customs window."
    } ]
  }, {
    "tStartMs": 462766,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "how much money you want."
    } ]
  }, {
    "tStartMs": 464366,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and took out his phone to record a video."
    } ]
  }, {
    "tStartMs": 467833,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "He said he wants to expose these agents."
    } ]
  }, {
    "tStartMs": 470933,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "because the money was completely unreasonable."
    } ]
  }, {
    "tStartMs": 473766,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "After he made such a fuss,"
    } ]
  }, {
    "tStartMs": 475766,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "the staff member was a little scared."
    } ]
  }, {
    "tStartMs": 479400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Originally, they were calling names one by one"
    } ]
  }, {
    "tStartMs": 482200,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "and let us pick up our passports and visas."
    } ]
  }, {
    "tStartMs": 485966,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "The staff member walked into the office"
    } ]
  }, {
    "tStartMs": 489400,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "and took out a stack of passports."
    } ]
  }, {
    "tStartMs": 491266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "and put them on the window"
    } ]
  }, {
    "tStartMs": 493133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "and let us take them by ourselves."
    } ]
  }, {
    "tStartMs": 494666,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "He didn't announce names anymore."
    } ]
  }, {
    "tStartMs": 497533,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "At that moment,"
    } ]
  }, {
    "tStartMs": 498933,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "I got my passport."
    } ]
  }, {
    "tStartMs": 501133,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "If this Chinese hadn't made a fuss like this,"
    } ]
  }, {
    "tStartMs": 504233,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "I didn't know how long I would have to wait."
    } ]
  }, {
    "tStartMs": 505933,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Maybe two and a half hours,"
    } ]
  }, {
    "tStartMs": 508033,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "or even three hours."
    } ]
  }, {
    "tStartMs": 509566,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "After leaving the country,"
    } ]
  }, {
    "tStartMs": 510733,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "I went to pick up my luggage."
    } ]
  }, {
    "tStartMs": 512800,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "Because it had been a long time."
    } ]
  }, {
    "tStartMs": 515933,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "the electronic screen outside didn't show"
    } ]
  }, {
    "tStartMs": 519400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "where I should pick up my luggage for that flight."
    } ]
  }, {
    "tStartMs": 522966,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "So I asked the airport staff."
    } ]
  }, {
    "tStartMs": 526333,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "I asked the third one."
    } ]
  }, {
    "tStartMs": 527466,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Finally, someone knew."
    } ]
  }, {
    "tStartMs": 530400,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "He told me"
    } ]
  }, {
    "tStartMs": 531500,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "After leaving the country,"
    } ]
  }, {
    "tStartMs": 532466,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "I got a one-month phone card at the airport."
    } ]
  }, {
    "tStartMs": 537400,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "The salesperson who sells phone cards at the airport"
    } ]
  }, {
    "tStartMs": 540066,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "Most of them can speak Chinese."
    } ]
  }, {
    "tStartMs": 542600,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "To do business with Chinese people."
    } ]
  }, {
    "tStartMs": 545166,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "and they can accept WeChat payment."
    } ]
  }, {
    "tStartMs": 547766,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "I also withdrew some Vietnamese dong from ATM."
    } ]
  }, {
    "tStartMs": 552600,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "I withdrew about two hundred dollars in Vietnamese dong."
    } ]
  }, {
    "tStartMs": 556833,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "My camera was out of power."
    } ]
  }, {
    "tStartMs": 558400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "Now I'm using a sports camera."
    } ]
  }, {
    "tStartMs": 560933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "After leaving the airport,"
    } ]
  }, {
    "tStartMs": 562200,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "I took a taxi to the homestay."
    } ]
  }, {
    "tStartMs": 564533,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "The process was quite smooth."
    } ]
  }, {
    "tStartMs": 566966,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "Because my place is not far from the airport."
    } ]
  }, {
    "tStartMs": 571766,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "This homestay is really nice."
    } ]
  }, {
    "tStartMs": 573433,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It is a standalone homestay"
    } ]
  }, {
    "tStartMs": 575833,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "It's self-service check-in."
    } ]
  }, {
    "tStartMs": 578066,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "The landlord left the key in a small box at the door."
    } ]
  }, {
    "tStartMs": 582466,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Just pick it up yourself when you arrive."
    } ]
  }, {
    "tStartMs": 585066,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 586133,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "Let me show you."
    } ]
  }, {
    "tStartMs": 587200,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "There is a separate bathroom here."
    } ]
  }, {
    "tStartMs": 590033,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "and a double bed."
    } ]
  }, {
    "tStartMs": 593066,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "There is a small sofa and a table inside."
    } ]
  }, {
    "tStartMs": 597133,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "There is also a small refrigerator underneath."
    } ]
  }, {
    "tStartMs": 599266,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "This is where I am now."
    } ]
  }, {
    "tStartMs": 601933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "I'm sitting on the bed now."
    } ]
  }, {
    "tStartMs": 604000,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "When I arrived at the homestay that night,"
    } ]
  }, {
    "tStartMs": 606433,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "I felt very tired."
    } ]
  }, {
    "tStartMs": 609566,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "I just tidied up a bit,"
    } ]
  }, {
    "tStartMs": 611533,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "took a shower and went to sleep."
    } ]
  }, {
    "tStartMs": 613533,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "The above"
    } ]
  }, {
    "tStartMs": 614266,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "is my experience of this trip."
    } ]
  }, {
    "tStartMs": 617133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "It was a bit tough,"
    } ]
  }, {
    "tStartMs": 618466,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "But luckily, it went relatively smoothly."
    } ]
  }, {
    "tStartMs": 621133,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "What do you want to watch next podcast?"
    } ]
  }, {
    "tStartMs": 624000,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "you can leave a message in the comment section."
    } ]
  }, {
    "tStartMs": 626966,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "That’s it for this episode of podcast."
    } ]
  }, {
    "tStartMs": 630766,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "Remember to like, comment, and follow me."
    } ]
  }, {
    "tStartMs": 634266,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "I will share more content next time."
    } ]
  }, {
    "tStartMs": 638066,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "See you next time."
    } ]
  } ]
}
