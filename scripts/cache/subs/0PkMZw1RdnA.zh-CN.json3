{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 133,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "每当我回想起幼年的时候\nměidāng wǒ huíxiǎng qǐ yòunián de shíhou"
    } ]
  }, {
    "tStartMs": 3600,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "我就觉得我的幼年无比快乐\nwǒ jiù juéde wǒ de yòunián wúbǐ kuàilè"
    } ]
  }, {
    "tStartMs": 8333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "幼年总是会结束的\nyòunián zǒngshì huì jiéshù de"
    } ]
  }, {
    "tStartMs": 11233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "一定要适应长大的生活\nyīdìngyào shìyìng zhǎngdà de shēnghuó"
    } ]
  }, {
    "tStartMs": 15733,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "这是8岁时的我写的\nzhè shì 8 suìshí de wǒ xiě de"
    } ]
  }, {
    "tStartMs": 19433,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "我8岁的时候就开始怀念我的幼年了\nwǒ 8 suì de shíhou jiù kāishǐ huáiniàn wǒ de yòunián le"
    } ]
  }, {
    "tStartMs": 24966,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "最近我在我的爸妈家里翻到了\nzuìjìn wǒ zài wǒ de bàmā jiālǐ fān dàoliǎo"
    } ]
  }, {
    "tStartMs": 28933,
    "dDurationMs": 5533,
    "segs": [ {
      "utf8": "这些从小学到高中的作文本\nzhèxiē cóngxiǎo xué dào gāozhōng de zuòwén běn"
    } ]
  }, {
    "tStartMs": 35100,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "7岁到17岁\n7 suì dào 17 suì"
    } ]
  }, {
    "tStartMs": 38333,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "我真的没想到他们还留着\nwǒ zhēn de méixiǎngdào tāmen hái liú zhe"
    } ]
  }, {
    "tStartMs": 41033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "所以今天我想跟你们一起看一看\nsuǒyǐ jīntiān wǒ xiǎng gēn nǐmen yīqǐ kànyīkàn"
    } ]
  }, {
    "tStartMs": 44233,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "一个中国小孩是怎么\nyígè zhōngguó xiǎohái shì zěnme"
    } ]
  }, {
    "tStartMs": 46866,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "一点一点学会用中文写作的\nyīdiǎnyīdiǎn xuéhuì yòng zhōngwén xiězuò de"
    } ]
  }, {
    "tStartMs": 51833,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "每一个在中国上小学或者中学的人\nměiyī gè zài zhōngguó shàng xiǎoxué huòzhě zhōngxué de rén"
    } ]
  }, {
    "tStartMs": 56466,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "都必须写作文\ndōu bìxū xiězuò wén"
    } ]
  }, {
    "tStartMs": 59833,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "都必须用作文通过语文考试\ndōu bìxū yòngzuò wén tōngguò yǔwén kǎoshì"
    } ]
  }, {
    "tStartMs": 64733,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "小时候我们什么都写。写人，写动物\nxiǎoshíhou wǒmen shénme dōu xiě. xiě rén, xiě dòngwù"
    } ]
  }, {
    "tStartMs": 69533,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "写植物，写一次经历，写景，写日记\nxiě zhíwù, xiě yīcì jīnglì, xiě jǐng, xiě rìjì"
    } ]
  }, {
    "tStartMs": 75700,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "后来还会写调查、议论文\nhòulái hái huì xiě diàochá、 yìlùn wén"
    } ]
  }, {
    "tStartMs": 79166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "在我的印象里\nzài wǒ de yìnxiàng lǐ"
    } ]
  }, {
    "tStartMs": 80766,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "不管是小学还是中学\nbùguǎn shì xiǎoxué háishi zhōngxué"
    } ]
  }, {
    "tStartMs": 83633,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "每个星期我们都要练习写作文\nměi gè xīngqī wǒmen dōu yào liànxí xiězuò wén"
    } ]
  }, {
    "tStartMs": 88033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "写完以后\nxiěwán yǐhòu"
    } ]
  }, {
    "tStartMs": 89300,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "老师还会批改、打分、写评语\nlǎoshī hái huì pīgǎi、 dǎfēn、 xiě píngyǔ"
    } ]
  }, {
    "tStartMs": 95233,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "那你们可以看到我有这么多的作文本\nnà nǐmen kěyǐ kàn dào wǒ yǒu zhème duō de zuòwén běn"
    } ]
  }, {
    "tStartMs": 100000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "应该你们也会好奇\nyīnggāi nǐmen yě huì hàoqí"
    } ]
  }, {
    "tStartMs": 102633,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "为什么呢？\nwèishénme ne?"
    } ]
  }, {
    "tStartMs": 104266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "写作文很重要吗？\nxiězuò wén hěn zhòngyào ma?"
    } ]
  }, {
    "tStartMs": 106800,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "是的。因为\nshìde. yīnwèi"
    } ]
  }, {
    "tStartMs": 108833,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "在当时的语文考试里\nzài dāngshí de yǔwén kǎoshì lǐ"
    } ]
  }, {
    "tStartMs": 111133,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "作文一般是很大很大的一个部分\nzuòwén yībān shì hěn dà hěn dà de yígè bùfen"
    } ]
  }, {
    "tStartMs": 115000,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "我们甚至会有一句比较夸张的话\nwǒmen shènzhì huì yǒu yījù bǐjiào kuāzhāng dehuà"
    } ]
  }, {
    "tStartMs": 118833,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "得作文者得天下\ndé zuòwén zhě dé tiānxià"
    } ]
  }, {
    "tStartMs": 122700,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "意思差不多就是\nyìsi chàbuduō jiùshì"
    } ]
  }, {
    "tStartMs": 124633,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "如果你的作文成绩好\nrúguǒ nǐ de zuòwén chéngjì hǎo"
    } ]
  }, {
    "tStartMs": 127400,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "你的语文成绩差不多就稳了一半\nnǐ de yǔwén chéngjì chàbuduō jiù wěn le yībàn"
    } ]
  }, {
    "tStartMs": 131466,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "不过\nbùguò"
    } ]
  }, {
    "tStartMs": 133133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "小学中学时的我\nxiǎoxué zhōngxué shí de wǒ"
    } ]
  }, {
    "tStartMs": 135533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "真的喜欢写作文吗？\nzhēn de xǐhuan xiězuò wén ma?"
    } ]
  }, {
    "tStartMs": 138866,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "真的能写出好作文吗？\nzhēn de néng xiě chū hǎo zuòwén ma?"
    } ]
  }, {
    "tStartMs": 142500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "今天我就想和你们一起来\njīntiān wǒ jiù xiǎng hé nǐmen yīqǐ lái"
    } ]
  }, {
    "tStartMs": 144833,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "读一读不同年级的我写的几篇作文\ndú yī dú bùtóng niánjí de wǒ xiě de jǐ piān zuòwén"
    } ]
  }, {
    "tStartMs": 149633,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "第一篇作文\ndìyī piān zuòwén"
    } ]
  }, {
    "tStartMs": 151666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "二年级的\nèr niánjí de"
    } ]
  }, {
    "tStartMs": 153233,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "8岁的我写的\n8 suì de wǒ xiě de"
    } ]
  }, {
    "tStartMs": 155900,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "题目叫《西瓜》\ntímù jiào《 xīguā》"
    } ]
  }, {
    "tStartMs": 158900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "当时的老师给了我一个优\ndāngshí de lǎoshī gěi le wǒ yígè yōu"
    } ]
  }, {
    "tStartMs": 161833,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "加三颗星\njiā sān kē xīng"
    } ]
  }, {
    "tStartMs": 165233,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "我最喜欢吃的水果是西瓜\nwǒ zuì xǐhuan chī de shuǐguǒ shì xīguā"
    } ]
  }, {
    "tStartMs": 169466,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "西瓜又大又圆\nxīguā yòu dà yòu yuán"
    } ]
  }, {
    "tStartMs": 171933,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "像个大皮球\nxiàng gè dà píqiú"
    } ]
  }, {
    "tStartMs": 174833,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "它有一条小辫子\ntā yǒu yī tiáo xiǎobiànzi"
    } ]
  }, {
    "tStartMs": 177533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "又细又短\nyòu xì yòu duǎn"
    } ]
  }, {
    "tStartMs": 179333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "像小猪的尾巴\nxiàng xiǎo zhū de wěiba"
    } ]
  }, {
    "tStartMs": 181666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "熟透的西瓜穿着一件浓淡相间的衣服\nshútòu de xīguā chuānzhuó yī jiàn nóngdàn xiāngjiàn de yīfu"
    } ]
  }, {
    "tStartMs": 187466,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "上面还点缀着一个个黑色的小斑纹\nshàngmiàn hái diǎnzhuì zhe yīgègè hēisè de xiǎo bānwén"
    } ]
  }, {
    "tStartMs": 192233,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "外形真是好看极了\nwàixíng zhēnshi hǎokàn jíle"
    } ]
  }, {
    "tStartMs": 195000,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "我本来以为8岁的我中文会特别简单\nwǒ běnlái yǐwéi 8 suì de wǒ zhōngwén huì tèbié jiǎndān"
    } ]
  }, {
    "tStartMs": 200000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "特别幼稚\ntèbié yòuzhì"
    } ]
  }, {
    "tStartMs": 201433,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "可是打开一看\nkěshì dǎkāi yī kàn"
    } ]
  }, {
    "tStartMs": 202900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "并不是这样的\nbìngbù shì zhèyàng de"
    } ]
  }, {
    "tStartMs": 204833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "里面还有很多比喻\nlǐmiàn háiyǒu hěn duō bǐyù"
    } ]
  }, {
    "tStartMs": 207133,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "很多复杂的\nhěn duō fùzá de"
    } ]
  }, {
    "tStartMs": 208433,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "可能你们也不知道的形容词\nkěnéng nǐmen yě bùzhī dào de xíngróngcí"
    } ]
  }, {
    "tStartMs": 211533,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "为什么呢？\nwèishénme ne?"
    } ]
  }, {
    "tStartMs": 212900,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "现在我想起来了\nxiànzài wǒ xiǎngqilai le"
    } ]
  }, {
    "tStartMs": 214933,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "当时一年级二年级刚进小学的时候\ndāngshí yī niánjí èr niánjí gāng jìn xiǎoxué de shíhou"
    } ]
  }, {
    "tStartMs": 220100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我们怎么可能会\nwǒmen zěnme kěnéng huì"
    } ]
  }, {
    "tStartMs": 222200,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "一开始就直接写作文呀\nyī kāishǐ jiù zhíjiē xiězuò wén ya"
    } ]
  }, {
    "tStartMs": 225333,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "当时的老师肯定是让我们先去模仿\ndāngshí de lǎoshī kěndìng shì ràng wǒmen xiān qù mófǎng"
    } ]
  }, {
    "tStartMs": 229033,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我们要学会模仿\nwǒmen yào xuéhuì mófǎng"
    } ]
  }, {
    "tStartMs": 231466,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "让自己写出来的中文像作文\nràng zìjǐ xiě chulai de zhōngwén xiàng zuòwén"
    } ]
  }, {
    "tStartMs": 236033,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "而不像直接嘴巴说出来的\nér bù xiàng zhíjiē zuǐba shuōchū lái de"
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我们模仿学到的课文\nwǒmen mófǎng xué dào de kèwén"
    } ]
  }, {
    "tStartMs": 243300,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "模仿老师教给我们的表达\nmófǎng lǎoshī jiāogěi wǒmen de biǎodá"
    } ]
  }, {
    "tStartMs": 246333,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "努力去用新学的词语\nnǔlì qù yòng xīn xué de cíyǔ"
    } ]
  }, {
    "tStartMs": 249533,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "那个阶段是不是和你们\nnàge jiēduàn shìbùshì hé nǐmen"
    } ]
  }, {
    "tStartMs": 252333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "学中文的时候有点像呢？\nxué zhōngwén de shíhou yǒudiǎn xiàng ne?"
    } ]
  }, {
    "tStartMs": 266733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "第二篇作文\ndìèr piān zuòwén"
    } ]
  }, {
    "tStartMs": 268500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "三年级写的\nsān niánjí xiě de"
    } ]
  }, {
    "tStartMs": 270533,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "当时我9岁\ndāngshí wǒ 9 suì"
    } ]
  }, {
    "tStartMs": 275100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "陪表妹玩\npéi biǎomèi wán"
    } ]
  }, {
    "tStartMs": 277466,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "每个礼拜天\nměi gè lǐbàitiān"
    } ]
  }, {
    "tStartMs": 279066,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "表妹都要来我家玩、吃饭\nbiǎomèi dōu yào lái wǒ jiā wán、 chīfàn"
    } ]
  }, {
    "tStartMs": 283000,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "表妹是我舅舅的女儿\nbiǎomèi shì wǒ jiùjiu de nǔér"
    } ]
  }, {
    "tStartMs": 285466,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "刚满4周岁\ngāng mǎn 4 zhōusuì"
    } ]
  }, {
    "tStartMs": 287800,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "废话却一箩筐\nfèihuà què yīluókuāng"
    } ]
  }, {
    "tStartMs": 290400,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "一箩筐的废话\nyīluókuāng de fèihuà"
    } ]
  }, {
    "tStartMs": 293200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "这天表妹又来了\nzhètiān biǎomèi yòuláile"
    } ]
  }, {
    "tStartMs": 296666,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "那时我正在做作业\nnàshí wǒ zhèngzài zuòzuo yè"
    } ]
  }, {
    "tStartMs": 300066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "不想陪她玩\nbùxiǎng péi tā wán"
    } ]
  }, {
    "tStartMs": 302300,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "可是不陪\nkěshì bù péi"
    } ]
  }, {
    "tStartMs": 303866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "老妈又要唠叨半天\nlǎomā yòu yào láodao bàntiān"
    } ]
  }, {
    "tStartMs": 306833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我只好不情愿的答应了\nwǒ zhǐhǎo bùqíngyuàn de dāying le"
    } ]
  }, {
    "tStartMs": 312633,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "表妹拿出我的一些玩具\nbiǎomèi náchū wǒ de yīxiē wánjù"
    } ]
  }, {
    "tStartMs": 315500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "叫我做病人\njiào wǒ zuò bìngrén"
    } ]
  }, {
    "tStartMs": 317400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "她做医生\ntā zuò yīshēng"
    } ]
  }, {
    "tStartMs": 319633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "又叫我到她跟前\nyòu jiào wǒ dào tā gēnqian"
    } ]
  }, {
    "tStartMs": 322200,
    "dDurationMs": 5333,
    "segs": [ {
      "utf8": "她装模作样的给我打针开药\ntā zhuāngmózuòyàng de gěi wǒ dǎzhēn kāiyào"
    } ]
  }, {
    "tStartMs": 327933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "搞得我哭笑不得\ngǎo dé wǒ kūxiàobùdé"
    } ]
  }, {
    "tStartMs": 332033,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "她又要玩超市游戏\ntā yòu yào wán chāoshì yóuxì"
    } ]
  }, {
    "tStartMs": 334800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "表妹让我当顾客\nbiǎomèi ràng wǒ dāng gùkè"
    } ]
  }, {
    "tStartMs": 336833,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "她当服务员\ntā dāng fúwùyuán"
    } ]
  }, {
    "tStartMs": 339200,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "我拿出一些要买的物品给表妹\nwǒ náchū yīxiē yào mǎi de wùpǐn gěi biǎomèi"
    } ]
  }, {
    "tStartMs": 343433,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "她用我的电话碰一下物品\ntā yòng wǒ de diànhuà pèng yīxià wùpǐn"
    } ]
  }, {
    "tStartMs": 347100,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "我假装拿出一些钱给她\nwǒ jiǎzhuāng náchū yīxiē qián gěi tā"
    } ]
  }, {
    "tStartMs": 351600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "她接过钱，把物品给我\ntā jiēguò qián, bǎ wùpǐn gěi wǒ"
    } ]
  }, {
    "tStartMs": 356000,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "吃饭的时间到了\nchīfàn de shíjiān dàoliǎo"
    } ]
  }, {
    "tStartMs": 357833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "我终于不用陪她玩了\nwǒ zhōngyú bùyòng péi tā wán le"
    } ]
  }, {
    "tStartMs": 360866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "谢天谢地\nxiètiānxièdì"
    } ]
  }, {
    "tStartMs": 362733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "当时的我还贴心的提醒老师\ndāngshí de wǒ hái tiēxīn de tíxǐng lǎoshī"
    } ]
  }, {
    "tStartMs": 365866,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "反面还有\nfǎnmiàn háiyǒu"
    } ]
  }, {
    "tStartMs": 367466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "这篇作文还没有结束呢\nzhè piān zuòwén hái méiyǒu jiéshù ne"
    } ]
  }, {
    "tStartMs": 372600,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "哎，你说这个表妹烦不烦？\nāi, nǐ shuō zhège biǎomèi fán bù fán?"
    } ]
  }, {
    "tStartMs": 378100,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "说实话，我看到题目《陪表妹玩》的时候\nshuōshíhuà, wǒ kàn dào tímù《 péi biǎomèi wán》 de shíhou"
    } ]
  }, {
    "tStartMs": 382633,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "我真的没有想到\nwǒ zhēn de méiyǒu xiǎngdào"
    } ]
  }, {
    "tStartMs": 383866,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "这是一篇有一点抱怨的作文\nzhè shì yī piān yǒu yīdiǎn bàoyuàn de zuòwén"
    } ]
  }, {
    "tStartMs": 387433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "但是是很真实的情绪\ndànshì shì hěn zhēnshí de qíngxù"
    } ]
  }, {
    "tStartMs": 390066,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "是很真实的故事\nshì hěn zhēnshí de gùshì"
    } ]
  }, {
    "tStartMs": 392133,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "我读的时候感觉自己\nwǒ dú de shíhou gǎnjué zìjǐ"
    } ]
  }, {
    "tStartMs": 394466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "仿佛回到了那个时候\nfǎngfú huídào le nàge shíhou"
    } ]
  }, {
    "tStartMs": 397333,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "三年级的我\nsān niánjí de wǒ"
    } ]
  }, {
    "tStartMs": 398866,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "9岁的我\n9 suì de wǒ"
    } ]
  }, {
    "tStartMs": 400333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "没有再继续模仿写作文了\nméiyǒu zài jìxù mófǎng xiězuò wén le"
    } ]
  }, {
    "tStartMs": 403433,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "而是开始真正写发生在自己身上的事\nérshì kāishǐ zhēnzhèng xiě fāshēng zài zìjǐ shēnshang de shì"
    } ]
  }, {
    "tStartMs": 408700,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "哎，现在想想\nāi, xiànzài xiǎng xiǎng"
    } ]
  }, {
    "tStartMs": 410066,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我的表妹也已经成年了\nwǒ de biǎomèi yě yǐjīng chéngnián le"
    } ]
  }, {
    "tStartMs": 413100,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "但当时的我俩其实都是\ndàn dāngshí de wǒ liǎ qíshí dōu shì"
    } ]
  }, {
    "tStartMs": 415666,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "差不了太多的小孩子\nchà bùliǎo tài duō de xiǎoháizi"
    } ]
  }, {
    "tStartMs": 418333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "三年级的时候还有一篇作文\nsān niánjí de shíhou háiyǒu yī piān zuòwén"
    } ]
  }, {
    "tStartMs": 420500,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "我也想跟你们分享\nwǒ yě xiǎng gēn nǐmen fēnxiǎng"
    } ]
  }, {
    "tStartMs": 422833,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "题目叫《我的自画像》\ntímù jiào《 wǒ de zìhuàxiàng》"
    } ]
  }, {
    "tStartMs": 426433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "不是真的是一幅画\nbùshì zhēn de shì yī fú huà"
    } ]
  }, {
    "tStartMs": 428666,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "是一篇介绍自己的作文\nshì yī piān jièshào zìjǐ de zuòwén"
    } ]
  }, {
    "tStartMs": 432500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我是一个平凡的女孩\nwǒ shì yígè píngfán de nǔhái"
    } ]
  }, {
    "tStartMs": 435733,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "今年8周岁了\njīnnián 8 zhōusuì le"
    } ]
  }, {
    "tStartMs": 438533,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我梳着蘑菇头\nwǒ shū zhe mógu tóu"
    } ]
  }, {
    "tStartMs": 441466,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "鼻子小小的\nbízi xiǎoxiǎo de"
    } ]
  }, {
    "tStartMs": 443900,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "眼睛也很小\nyǎnjing yě hěn xiǎo"
    } ]
  }, {
    "tStartMs": 446266,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "但是很有神\ndànshì hěn yǒu shén"
    } ]
  }, {
    "tStartMs": 449233,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我这个人急性子\nwǒ zhège rén jíxìngzi"
    } ]
  }, {
    "tStartMs": 452066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "做什么事都匆匆忙忙\nzuòshímǒ shì dōu cōngcōng máng máng"
    } ]
  }, {
    "tStartMs": 454733,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "但我很有好奇心\ndàn wǒ hěn yǒuhàoqíxīn"
    } ]
  }, {
    "tStartMs": 457066,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "一有什么新鲜事就跑上去凑热闹\nyī yǒu shénme xīnxiān shì jiù pǎo shàngqù còurènao"
    } ]
  }, {
    "tStartMs": 462400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我呀，兴趣爱好多着呢\nwǒ ya, xìngqù àihào duō zhene"
    } ]
  }, {
    "tStartMs": 465666,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "书法、钢琴、素描、英语\nshūfǎ、 gāngqín、 sùmiáo、 yīngyǔ"
    } ]
  }, {
    "tStartMs": 469800,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "每天晚上都要练一小时钢琴\nměitiān wǎnshang dōu yào liàn yī xiǎoshí gāngqín"
    } ]
  }, {
    "tStartMs": 472733,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "一小时书法，真累呀\nyī xiǎoshí shūfǎ, zhēn lèi ya"
    } ]
  }, {
    "tStartMs": 476800,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我最喜欢的运动是跑步、排球\nwǒ zuì xǐhuan de yùndòng shì pǎobù、 páiqiú"
    } ]
  }, {
    "tStartMs": 480800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "这就是我\nzhè jiùshì wǒ"
    } ]
  }, {
    "tStartMs": 482333,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "你愿意和我做朋友吗？\nnǐ yuànyì hé wǒ zuò péngyou ma?"
    } ]
  }, {
    "tStartMs": 486033,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "当时的老师还给了一个评语\ndāngshí de lǎoshī huángěi le yígè píngyǔ"
    } ]
  }, {
    "tStartMs": 489133,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "作文如有具体实例来写自己的特点\nzuòwén rú yǒu jùtǐ shílì lái xiě zìjǐ de tèdiǎn"
    } ]
  }, {
    "tStartMs": 493633,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就生动了\njiù shēngdòng le"
    } ]
  }, {
    "tStartMs": 495700,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "然后给了我一个优减\nránhòu gěi le wǒ yígè yōu jiǎn"
    } ]
  }, {
    "tStartMs": 497966,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "你们可别小看这个减号的力量\nnǐmen kě bié xiǎokàn zhège jiǎnhào de lìliang"
    } ]
  }, {
    "tStartMs": 502033,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "当时的“优减”对我来说比“优”差多了\ndāngshí de \"yōu jiǎn\" duìwǒláishuō bǐ \"yōu\" chà duō le"
    } ]
  }, {
    "tStartMs": 507300,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "就像c和a的差别一样\njiù xiàng c hé a de chābié yīyàng"
    } ]
  }, {
    "tStartMs": 510633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "但现在看着这篇自我介绍\ndàn xiànzài kàn zhe zhè piān zìwǒjièshào"
    } ]
  }, {
    "tStartMs": 513866,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "感觉现在的我和当时差别也不大嘛\ngǎnjué xiànzài de wǒ hé dāngshí chābié yě bùdà ma"
    } ]
  }, {
    "tStartMs": 518866,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "可能只是发型变了\nkěnéng zhǐshì fàxíng biàn le"
    } ]
  }, {
    "tStartMs": 521300,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "更加有耐心了\ngèngjiā yǒu nàixīn le"
    } ]
  }, {
    "tStartMs": 523466,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "但是还是想找人做朋友\ndànshì háishi xiǎng zhǎo rén zuò péngyou"
    } ]
  }, {
    "tStartMs": 525933,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "但是我觉得现在对我来说\ndànshì wǒ juéde xiànzài duìwǒláishuō"
    } ]
  }, {
    "tStartMs": 529200,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "自我介绍真的没那么容易了\nzìwǒjièshào zhēn de méi nàme róngyì le"
    } ]
  }, {
    "tStartMs": 532033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "有好多想说的\nyǒu hǎoduō xiǎng shuō de"
    } ]
  }, {
    "tStartMs": 533766,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "不知道跟别人说什么\nbùzhī dào gēn biéren shuōshímǒ"
    } ]
  }, {
    "tStartMs": 536333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "但是当时多简单\ndànshì dāngshí duō jiǎndān"
    } ]
  }, {
    "tStartMs": 538966,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "然后我还发现一件特别有意思的事\nránhòu wǒ hái fāxiàn yī jiàn tèbié yǒuyìsi de shì"
    } ]
  }, {
    "tStartMs": 541733,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "就是你们看这些纸\njiùshì nǐmen kàn zhèxiē zhǐ"
    } ]
  }, {
    "tStartMs": 544633,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "它们不是平的\ntāmen bùshì píng de"
    } ]
  }, {
    "tStartMs": 546833,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "它们凹凸不平\ntāmen āotūbùpíng"
    } ]
  }, {
    "tStartMs": 549800,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "因为当时写字\nyīnwèi dāngshí xiězì"
    } ]
  }, {
    "tStartMs": 551666,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我真的特别用力\nwǒ zhēn de tèbié yònglì"
    } ]
  }, {
    "tStartMs": 554066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "一笔一画都写得特别用力\nyī bǐ yī huà dōu xiě dé tèbié yònglì"
    } ]
  }, {
    "tStartMs": 558033,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "每一笔都会压到后面几张纸上\nměiyī bǐ dūhuì yā dào hòumiàn jǐ zhāng zhǐ shàng"
    } ]
  }, {
    "tStartMs": 564566,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "其实你们可以看\nqíshí nǐmen kěyǐ kàn"
    } ]
  }, {
    "tStartMs": 565833,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "现在我的中指这边还有一个老茧\nxiànzài wǒ de zhōngzhǐ zhèbiān háiyǒu yígè lǎojiǎn"
    } ]
  }, {
    "tStartMs": 570766,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "快没有了\nkuài méiyǒu le"
    } ]
  }, {
    "tStartMs": 571733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "因为现在写字不太多\nyīnwèi xiànzài xiězì bù tài duō"
    } ]
  }, {
    "tStartMs": 573800,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "但是这个老茧就是小时候用\ndànshì zhège lǎojiǎn jiùshì xiǎoshíhou yòng"
    } ]
  }, {
    "tStartMs": 576133,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "右手写字太用力抓笔留下的\nyòushǒu xiězì tài yònglì zhuā bǐ liúxià de"
    } ]
  }, {
    "tStartMs": 582600,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "所以啊\nsuǒyǐ a"
    } ]
  }, {
    "tStartMs": 583266,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "我们中国人小时候学写中文也真的\nwǒmen zhōngguórén xiǎoshíhou xué xiě zhōngwén yě zhēn de"
    } ]
  }, {
    "tStartMs": 587333,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "是一笔一画写出来、记下来的\nshì yī bǐ yī huà xiě chulai、 jì xiàlai de"
    } ]
  }, {
    "tStartMs": 592433,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "告诉你们一个秘密\ngàosu nǐmen yígè mìmì"
    } ]
  }, {
    "tStartMs": 594200,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "其实当时我们学汉字也\nqíshí dāngshí wǒmen xué hànzì yě"
    } ]
  }, {
    "tStartMs": 596833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "经常就是一个字一个词\njīngcháng jiùshì yígè zì yígè cí"
    } ]
  }, {
    "tStartMs": 599433,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "要重复写30遍50遍\nyào chóngfù xiě 30 biàn 50 biàn"
    } ]
  }, {
    "tStartMs": 603500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "这是我们的作业\nzhè shì wǒmen de zuòyè"
    } ]
  }, {
    "tStartMs": 606000,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我想\nwǒ xiǎng"
    } ]
  }, {
    "tStartMs": 607033,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "如果我也给我的学生布置这样的作业\nrúguǒ wǒ yě gěi wǒ de xuésheng bùzhì zhèyàng de zuòyè"
    } ]
  }, {
    "tStartMs": 611000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "你们会接受吗？\nnǐmen huì jiēshòu ma?"
    } ]
  }, {
    "tStartMs": 613266,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "第三篇，六年级的作文\ndì sān piān, liù niánjí de zuòwén"
    } ]
  }, {
    "tStartMs": 616633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "当时我12岁\ndāngshí wǒ 12 suì"
    } ]
  }, {
    "tStartMs": 619200,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "这篇作文我必须要跟你们分享\nzhè piān zuòwén wǒ bìxū yào gēn nǐmen fēnxiǎng"
    } ]
  }, {
    "tStartMs": 622433,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "因为它和其他的作文不太一样\nyīnwèi tā hé qítā de zuòwén bù tài yīyàng"
    } ]
  }, {
    "tStartMs": 625766,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "我写的不再是花草小动物或者我自己\nwǒ xiě de bùzài shì huācǎo xiǎo dòngwù huòzhě wǒ zìjǐ"
    } ]
  }, {
    "tStartMs": 630733,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "这篇作文的题目叫\nzhè piān zuòwén de tímù jiào"
    } ]
  }, {
    "tStartMs": 633800,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "《我班同学一个月零花钱使用统计》\n《 wǒ bān tóngxué yígè yuè línghuāqián shǐyòng tǒngjì》"
    } ]
  }, {
    "tStartMs": 637833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "随着同学们年龄的增长\nsuízhe tóngxué men niánlíng de zēngzhǎng"
    } ]
  }, {
    "tStartMs": 640866,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "所需要的东西越来越多\nsuǒxū yào de dōngxi yuèláiyuè duō"
    } ]
  }, {
    "tStartMs": 643666,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "也要有属于自己的零花钱了\nyě yàoyǒu shǔyú zìjǐ de línghuāqián le"
    } ]
  }, {
    "tStartMs": 646800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你们觉不觉得有种HSK\nnǐmen jué bùjué dé yǒuzhǒng HSK"
    } ]
  }, {
    "tStartMs": 649233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "考试阅读理解的味道\nkǎoshì yuèdúlǐjiě de wèidao"
    } ]
  }, {
    "tStartMs": 652000,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "今天我调查20个身边的同学\njīntiān wǒ diàochá 20 gè shēnbiān de tóngxué"
    } ]
  }, {
    "tStartMs": 654866,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "的零花钱数量和使用情况\nde línghuāqián shùliàng hé shǐyòng qíngkuàng"
    } ]
  }, {
    "tStartMs": 658533,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "有50%的同学每月零花钱是100元以上\nyǒu 50% de tóngxué měiyuè línghuāqián shì 100 yuán yǐshàng"
    } ]
  }, {
    "tStartMs": 663533,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "500元以下的\n500 yuán yǐxià de"
    } ]
  }, {
    "tStartMs": 665200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "是最多的\nshì zuìduō de"
    } ]
  }, {
    "tStartMs": 667166,
    "dDurationMs": 4434,
    "segs": [ {
      "utf8": "有15%的同学是500元及以上的\nyǒu 15% de tóngxué shì 500 yuán jí yǐshàng de"
    } ]
  }, {
    "tStartMs": 671766,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "我个人认为这有点多了\nwǒ gèrén rènwéi zhè yǒudiǎn duō le"
    } ]
  }, {
    "tStartMs": 675833,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "我还调查了他们零花钱的使用情况\nwǒ hái diàochá le tāmen línghuāqián de shǐyòng qíngkuàng"
    } ]
  }, {
    "tStartMs": 679800,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "有50%的学生使用零花钱主要买吃的\nyǒu 50% de xuésheng shǐyòng línghuāqián zhǔyào mǎi chī de"
    } ]
  }, {
    "tStartMs": 685466,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "看来他们都是吃货啊\nkànlai tāmen dōu shì chīhuò a"
    } ]
  }, {
    "tStartMs": 688633,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "有30%的学生是用来买自己喜欢\nyǒu 30% de xuésheng shì yònglái mǎi zìjǐ xǐhuan"
    } ]
  }, {
    "tStartMs": 693866,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "的乱七八糟的小玩意儿的\nde luànqībāzāo de xiǎowányì ér de"
    } ]
  }, {
    "tStartMs": 697000,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "看来同学们不太喜欢学习啊\nkànlai tóngxué men bù tài xǐhuan xuéxí a"
    } ]
  }, {
    "tStartMs": 700733,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "用在玩乐上的比较多\nyòng zài wánlè shàng de bǐjiào duō"
    } ]
  }, {
    "tStartMs": 704333,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "现在的我要敲敲当时的我的小脑袋\nxiànzài de wǒ yào qiāo qiāo dāngshí de wǒ de xiǎonǎo dài"
    } ]
  }, {
    "tStartMs": 708433,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "你这个人啊\nnǐ zhège rén a"
    } ]
  }, {
    "tStartMs": 709600,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "怎么能这样想\nzěnme néng zhèyàng xiǎng"
    } ]
  }, {
    "tStartMs": 711233,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那么小的我们就应该花钱在玩乐上啊\nnàme xiǎode wǒmen jiù yīnggāi huāqián zài wánlè shàng a"
    } ]
  }, {
    "tStartMs": 714966,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "花那么多钱在学习上干嘛\nhuā nàme duō qián zài xuéxí shàng gànmá"
    } ]
  }, {
    "tStartMs": 717533,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "后面那么多年等着花钱在学习上呢\nhòumiàn nàme duō nián děng zhuóhuā qián zài xuéxí shàng ne"
    } ]
  }, {
    "tStartMs": 722566,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "唉\nāi"
    } ]
  }, {
    "tStartMs": 723200,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "可能当时是为了讨好老师才这么写吧\nkěnéng dāngshí shì wèile tǎohǎo lǎoshī cái zhème xiě ba"
    } ]
  }, {
    "tStartMs": 727833,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "我觉得家长不应该给予孩子太多钱\nwǒ juéde jiāzhǎng bù yīnggāi jǐyǔ háizi tài duō qián"
    } ]
  }, {
    "tStartMs": 732566,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "父母赚钱也很辛苦的\nfùmǔ zhuànqián yě hěn xīnkǔ de"
    } ]
  }, {
    "tStartMs": 735466,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "哎，到结尾就说教起来了\nāi, dào jiéwěi jiù shuōjiào qilai le"
    } ]
  }, {
    "tStartMs": 738700,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "不行\nbùxíng"
    } ]
  }, {
    "tStartMs": 739733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "但这篇作文还真\ndàn zhè piān zuòwén hái zhēn"
    } ]
  }, {
    "tStartMs": 741333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "有点像个小型的调查报告\nyǒudiǎn xiàng gè xiǎoxíng de diàochá bàogào"
    } ]
  }, {
    "tStartMs": 744000,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "在这一个方面还是要\nzài zhè yígè fāngmiàn háishi yào"
    } ]
  }, {
    "tStartMs": 745866,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "给当时的我点个赞\ngěi dāngshí de wǒ diǎn gè zàn"
    } ]
  }, {
    "tStartMs": 748433,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "小学的最后两年\nxiǎoxué de zuìhòu liǎng nián"
    } ]
  }, {
    "tStartMs": 750600,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "我遇到了我当时非常喜欢的语文老师\nwǒ yùdào le wǒ dāngshí fēicháng xǐhuan de yǔwén lǎoshī"
    } ]
  }, {
    "tStartMs": 754766,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "现在看这些作文也能看到\nxiànzài kàn zhèxiē zuòwén yě néng kàn dào"
    } ]
  }, {
    "tStartMs": 757600,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "她当时多么会鼓励人\ntā dāngshí duōme huì gǔlì rén"
    } ]
  }, {
    "tStartMs": 760566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "你们看这一篇她写了“好棒呀”\nnǐmen kàn zhè yī piān tā xiě le \"hǎobàng ya\""
    } ]
  }, {
    "tStartMs": 763633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "这边有个笑脸\nzhèbiān yǒu gè xiàoliǎn"
    } ]
  }, {
    "tStartMs": 765433,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "这边也有个笑脸\nzhèbiān yě yǒu gè xiàoliǎn"
    } ]
  }, {
    "tStartMs": 768433,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "这边也说“丫头，真棒！”\nzhèbiān yě shuō \"yātou, zhēnbàng!\""
    } ]
  }, {
    "tStartMs": 772966,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "这边也说“相信你是好样的！” 笑脸\nzhèbiān yě shuō \"xiāngxìn nǐ shì hǎoyàngde!\" xiàoliǎn"
    } ]
  }, {
    "tStartMs": 777533,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "所以我当时写作文也是充满了热情\nsuǒyǐ wǒ dāngshí xiězuò wén yě shì chōngmǎn le rèqíng"
    } ]
  }, {
    "tStartMs": 781666,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "会在上面画这种搞怪\nhuì zài shàngmiàn huà zhèzhǒng gǎoguài"
    } ]
  }, {
    "tStartMs": 783566,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "的表情和老师互动\nde biǎoqíng hé lǎoshī hùdòng"
    } ]
  }, {
    "tStartMs": 785933,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "然后我上初中了\nránhòu wǒ shàng chūzhōng le"
    } ]
  }, {
    "tStartMs": 788633,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "我的语文老师变成了\nwǒ de yǔwén lǎoshī biànchéng le"
    } ]
  }, {
    "tStartMs": 790866,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "一个完全不同风格的老师\nyígè wánquán bùtóng fēnggé de lǎoshī"
    } ]
  }, {
    "tStartMs": 808633,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "更多圈圈点点\ngèng duō quānquandiǎndiǎn"
    } ]
  }, {
    "tStartMs": 811333,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "更多良而不是优\ngèng duō liáng ér bùshì yōu"
    } ]
  }, {
    "tStartMs": 814533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "更多圈出的错别字\ngèng duō quān chū de cuòbiézì"
    } ]
  }, {
    "tStartMs": 818133,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "圈出的用的不好的词语\nquān chū de yòng de bùhǎo de cíyǔ"
    } ]
  }, {
    "tStartMs": 821433,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "当然完全可以理解\ndāngrán wánquán kěyǐ lǐjiě"
    } ]
  }, {
    "tStartMs": 823266,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "因为到了初中\nyīnwèi dàoliǎo chūzhōng"
    } ]
  }, {
    "tStartMs": 824833,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我们对作文的要求更高\nwǒmen duì zuòwén de yāoqiú gèng gāo"
    } ]
  }, {
    "tStartMs": 827366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "老师肯定希望我们作文\nlǎoshī kěndìng xīwàng wǒmen zuòwén"
    } ]
  }, {
    "tStartMs": 829233,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "的水平能上一个台阶\nde shuǐpíng néng shàngyīge táijiē"
    } ]
  }, {
    "tStartMs": 832233,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "或者好几个台阶\nhuòzhě hǎojǐ gè táijiē"
    } ]
  }, {
    "tStartMs": 834466,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "希望我们表达的东西更广更深\nxīwàng wǒmen biǎodá de dōngxi gèng guǎng gēngshēn"
    } ]
  }, {
    "tStartMs": 838800,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "现在看我那个阶段的写作并没有多差\nxiànzài kàn wǒ nàge jiēduàn de xiězuò bìng méiyǒu duō chà"
    } ]
  }, {
    "tStartMs": 843233,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "但我可以清楚的记得当时我\ndàn wǒ kěyǐ qīngchu de jìde dāngshí wǒ"
    } ]
  }, {
    "tStartMs": 847066,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "对于写作文的热情并没有很高\nduìyú xiězuò wén de rèqíng bìng méiyǒu hěn gāo"
    } ]
  }, {
    "tStartMs": 850266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "甚至是比较抗拒的\nshènzhì shì bǐjiào kàngjù de"
    } ]
  }, {
    "tStartMs": 852433,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我记得当时的老师好像也\nwǒ jìde dāngshí de lǎoshī hǎoxiàng yě"
    } ]
  }, {
    "tStartMs": 855333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "不是很喜欢我的写作风格\nbùshì hěn xǐhuan wǒ de xiězuò fēnggé"
    } ]
  }, {
    "tStartMs": 858533,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "当然这种东西本来就是很主观的嘛\ndāngrán zhèzhǒng dōngxi běnlái jiùshì hěn zhǔguān de ma"
    } ]
  }, {
    "tStartMs": 861766,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "但是还是有篇作文我想跟你们分享\ndànshì háishi yǒu piān zuòwén wǒ xiǎng gēn nǐmen fēnxiǎng"
    } ]
  }, {
    "tStartMs": 865166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "第四篇作文\ndì sì piān zuòwén"
    } ]
  }, {
    "tStartMs": 866800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "七年级的\nqī niánjí de"
    } ]
  }, {
    "tStartMs": 868466,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "13岁的我写的\n13 suì de wǒ xiě de"
    } ]
  }, {
    "tStartMs": 871766,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "题目叫《罚抄的领悟》\ntímù jiào《 fá chāo de lǐngwù》"
    } ]
  }, {
    "tStartMs": 876233,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "罚抄你们知道是什么东西吗？\nfá chāo nǐmen zhīdào shì shénme dōngxi ma?"
    } ]
  }, {
    "tStartMs": 878933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "就是惩罚你抄写\njiùshì chéngfá nǐ chāoxiě"
    } ]
  }, {
    "tStartMs": 881200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "就是你做错了一道题\njiùshì nǐ zuòcuò le yīdào tí"
    } ]
  }, {
    "tStartMs": 883466,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "尤其是那种你非常不应该错的\nyóuqíshì nàzhǒng nǐ fēicháng bù yīnggāi cuò de"
    } ]
  }, {
    "tStartMs": 886800,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "老师为了让你深刻的记住这个错误\nlǎoshī wèile ràng nǐ shēnkè de jìzhu zhège cuòwù"
    } ]
  }, {
    "tStartMs": 890566,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "从错误中学习\ncóng cuòwù zhōngxué xí"
    } ]
  }, {
    "tStartMs": 892666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "会让你罚抄这个题目\nhuì ràng nǐ fá chāo zhège tímù"
    } ]
  }, {
    "tStartMs": 895333,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "那罚抄到底是怎样的体验呢？\nnà fá chāo dàodǐ shì zěnyàng de tǐyàn ne?"
    } ]
  }, {
    "tStartMs": 897666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "我们来读一下吧\nwǒmen lái dú yīxià ba"
    } ]
  }, {
    "tStartMs": 901866,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "今天数学作业发下来\njīntiān shùxué zuòyè fā xiàlai"
    } ]
  }, {
    "tStartMs": 904866,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "上面有四个鲜红的字映入我眼帘\nshàngmiàn yǒu sì gè xiānhóng de zì yìng rù wǒ yǎnlián"
    } ]
  }, {
    "tStartMs": 908933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "订正10遍\ndìngzhèng 10 biàn"
    } ]
  }, {
    "tStartMs": 911000,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "我顿时感到跌到了万丈深渊\nwǒ dùnshí gǎndào diē dàoliǎo wànzhàng shēnyuān"
    } ]
  }, {
    "tStartMs": 914366,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "脸上一黑\nliǎn shàng yī hēi"
    } ]
  }, {
    "tStartMs": 917400,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "赶紧拿出本子奋笔疾书起来\ngǎnjǐn náchū běnzi fènbǐjíshū qilai"
    } ]
  }, {
    "tStartMs": 921233,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "没过多久\nméi guòduō jiǔ"
    } ]
  }, {
    "tStartMs": 922600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "我画了一半了\nwǒ huà le yībàn le"
    } ]
  }, {
    "tStartMs": 924600,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "语文课开始了\nyǔwén kè kāishǐ le"
    } ]
  }, {
    "tStartMs": 926966,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "老师叫我们默新课文的单词\nlǎoshī jiào wǒmen mò xīn kèwén de dāncí"
    } ]
  }, {
    "tStartMs": 930166,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "这课单词都很难\nzhè kè dāncí dōu hěn nán"
    } ]
  }, {
    "tStartMs": 932200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "我还没预习就开默了\nwǒ hái méi yùxí jiù kāi mò le"
    } ]
  }, {
    "tStartMs": 935366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "一共默5个\nyīgòng mò 5 gè"
    } ]
  }, {
    "tStartMs": 936933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我就错了两个\nwǒ jiù cuò le liǎng gè"
    } ]
  }, {
    "tStartMs": 939266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "全班只有几个同学全对\nquánbān zhǐ yǒu jǐge tóngxué quán duì"
    } ]
  }, {
    "tStartMs": 942833,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这里我要说一句\nzhèlǐ wǒ yàoshuō yījù"
    } ]
  }, {
    "tStartMs": 944600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "所以你们可以看到\nsuǒyǐ nǐmen kěyǐ kàn dào"
    } ]
  }, {
    "tStartMs": 946800,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "中国人也很难记住一些字怎么写的\nzhōngguórén yě hěn nánjì zhù yīxiē zì zěnme xiě de"
    } ]
  }, {
    "tStartMs": 950733,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "老师便很生气\nlǎoshī biàn hěn shēngqì"
    } ]
  }, {
    "tStartMs": 952600,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "要求我们把课后的词语每个抄5遍\nyāoqiú wǒmen bǎ kè hòu de cíyǔ měi gè chāo 5 biàn"
    } ]
  }, {
    "tStartMs": 956466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "我当时就傻眼了\nwǒ dāngshí jiù shǎyǎn le"
    } ]
  }, {
    "tStartMs": 959133,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "下课后我使劲的抄写\nxiàkè hòu wǒ shǐjìn de chāoxiě"
    } ]
  }, {
    "tStartMs": 962266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "外面的朋友都在活动\nwàimiàn de péngyou dōu zài huódòng"
    } ]
  }, {
    "tStartMs": 965066,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我还是抑制住玩的欲望\nwǒ háishi yìzhì zhù wán de yùwàng"
    } ]
  }, {
    "tStartMs": 967866,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "笔头快速的移动\nbǐtóu kuàisù de yídòng"
    } ]
  }, {
    "tStartMs": 970833,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "终于在放学前\nzhōngyú zài fàngxué qián"
    } ]
  }, {
    "tStartMs": 972833,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我全部写完了\nwǒ quánbù xiěwán le"
    } ]
  }, {
    "tStartMs": 975200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "如释重负\nrúshìzhòngfù"
    } ]
  }, {
    "tStartMs": 976966,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "最搞笑的是当时的老师给我的评语是\nzuì gǎoxiào de shì dāngshí de lǎoshī gěi wǒ de píngyǔ shì"
    } ]
  }, {
    "tStartMs": 981133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "吃一堑长一智\nchī yī qiàn zhǎng yī zhì"
    } ]
  }, {
    "tStartMs": 984533,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "意思就是\nyìsi jiùshì"
    } ]
  }, {
    "tStartMs": 986000,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "当你从一个事情中间吃了教训\ndāng nǐ cóng yígè shìqing zhōngjiān chī le jiàoxun"
    } ]
  }, {
    "tStartMs": 990266,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "你才能记住\nnǐ cáinéng jìzhu"
    } ]
  }, {
    "tStartMs": 991833,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "下次不再犯错误\nxiàcì bùzài fàncuò wù"
    } ]
  }, {
    "tStartMs": 994233,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "接下来就是高中\njiēxiàlái jiùshì gāozhōng"
    } ]
  }, {
    "tStartMs": 996333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我记得到了高中\nwǒ jìde dàoliǎo gāozhōng"
    } ]
  }, {
    "tStartMs": 998166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我写作文的兴趣又上去了\nwǒ xiězuò wén de xìngqù yòu shàngqù le"
    } ]
  }, {
    "tStartMs": 1001133,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "我又比较喜欢写了\nwǒ yòu bǐjiào xǐhuan xiě le"
    } ]
  }, {
    "tStartMs": 1003433,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "因为当时遇到了欣赏\nyīnwèi dāngshí yùdào le xīnshǎng"
    } ]
  }, {
    "tStartMs": 1005200,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "我写作风格的老师\nwǒ xiězuò fēnggé de lǎoshī"
    } ]
  }, {
    "tStartMs": 1007300,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "而且我也有非常多东西想讨论\nérqiě wǒ yě yǒu fēichángduō dōngxi xiǎng tǎolùn"
    } ]
  }, {
    "tStartMs": 1010433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "想去表达\nxiǎng qù biǎodá"
    } ]
  }, {
    "tStartMs": 1012000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "你们也可以看到当时高中我\nnǐmen yě kěyǐ kàn dào dāngshí gāozhōng wǒ"
    } ]
  }, {
    "tStartMs": 1014533,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "的字迹发生了很大的变化\nde zìjì fāshēng le hěn dà de biànhuà"
    } ]
  }, {
    "tStartMs": 1017433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "其实还挺潦草的\nqíshí hái tǐng liáocǎo de"
    } ]
  }, {
    "tStartMs": 1019766,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "现在让我看有些字都\nxiànzài ràng wǒ kàn yǒuxiē zì dōu"
    } ]
  }, {
    "tStartMs": 1022933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "要花几秒才能看懂\nyào huā jǐ miǎo cáinéng kàndǒng"
    } ]
  }, {
    "tStartMs": 1026266,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "当时我写作的兴趣也发生了变化\ndāngshí wǒ xiězuò de xìngqù yě fāshēng le biànhuà"
    } ]
  }, {
    "tStartMs": 1029733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "我变得更理性了\nwǒ biànde gèng lǐxìng le"
    } ]
  }, {
    "tStartMs": 1031666,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我喜欢去写议论文\nwǒ xǐhuan qù xiě yìlùn wén"
    } ]
  }, {
    "tStartMs": 1034266,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "当然议论文也是高中我们\ndāngrán yìlùn wén yě shì gāozhōng wǒmen"
    } ]
  }, {
    "tStartMs": 1037033,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "才会着重去训练的东西\ncái huì zhuózhòng qù xùnliàn de dōngxi"
    } ]
  }, {
    "tStartMs": 1041433,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "我变得不那么喜欢写太长的故事\nwǒ biànde bù nàme xǐhuan xiě tài zhǎng de gùshì"
    } ]
  }, {
    "tStartMs": 1046000,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "反而我喜欢去抓住一个点\nfǎnér wǒ xǐhuan qù zhuāzhù yígè diǎn"
    } ]
  }, {
    "tStartMs": 1048666,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "把它向深了挖\nbǎ tā xiàng shēn le wā"
    } ]
  }, {
    "tStartMs": 1050833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "向深了讨论\nxiàng shēn le tǎolùn"
    } ]
  }, {
    "tStartMs": 1052466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "当时我还有一件很迷恋的事\ndāngshí wǒ háiyǒu yī jiàn hěn míliàn de shì"
    } ]
  }, {
    "tStartMs": 1055833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "就是喜欢把中文写的很高级\njiùshì xǐhuan bǎ zhōngwén xiě de hěn gāojí"
    } ]
  }, {
    "tStartMs": 1060633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "甚至比较艰深\nshènzhì bǐjiào jiānshēn"
    } ]
  }, {
    "tStartMs": 1062933,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "给你们来读一段\ngěi nǐmen lái dú yī duàn"
    } ]
  }, {
    "tStartMs": 1065366,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "这应该是高二的作文本\nzhè yīnggāi shì gāo èr de zuòwén běn"
    } ]
  }, {
    "tStartMs": 1069200,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "很奇怪，难道我们的内心世界\nhěn qíguài, nándào wǒmen de nèixīnshìjiè"
    } ]
  }, {
    "tStartMs": 1072266,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "不应本就是自由国度吗？\nbù yīng běn jiùshì zìyóu guódù ma?"
    } ]
  }, {
    "tStartMs": 1075966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "何以就成了围城？\nhéyǐ jiù chéngle wéichéng?"
    } ]
  }, {
    "tStartMs": 1078766,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "而再回到我关闭朋友圈后\nér zài huídào wǒ guānbì péngyouquān hòu"
    } ]
  }, {
    "tStartMs": 1081566,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "为什么会不安的问题\nwèishénme huì bùān de wèntí"
    } ]
  }, {
    "tStartMs": 1084400,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "究其因是我内心有鬼\njiū qí yīn shì wǒ nèixīn yǒu guǐ"
    } ]
  }, {
    "tStartMs": 1087766,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "审视自己的邪鬼\nshěnshì zìjǐ de xié guǐ"
    } ]
  }, {
    "tStartMs": 1089900,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "而非什么手持天平的明眼人\nér fēi shénme shǒu chí tiānpíng de míngyǎnrén"
    } ]
  }, {
    "tStartMs": 1093600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "我自认为不可见之于人的东西\nwǒ zìrèn wèi bùkě jiàn zhī yú rén de dōngxi"
    } ]
  }, {
    "tStartMs": 1097100,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "是我自己最不愿也最不敢直面之物\nshì wǒ zìjǐ zuì bùyuàn yě zuì bù gǎn zhí miàn zhī wù"
    } ]
  }, {
    "tStartMs": 1101300,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "天呐\ntiān nà"
    } ]
  }, {
    "tStartMs": 1102033,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "我这个语言也太复杂了\nwǒ zhège yǔyán yě tài fùzá le"
    } ]
  }, {
    "tStartMs": 1104800,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "就是它甚至不是现代人\njiùshì tā shènzhì bùshì xiàndàirén"
    } ]
  }, {
    "tStartMs": 1107233,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "在写作时会常用的语言\nzài xiězuò shí huì chángyòng de yǔyán"
    } ]
  }, {
    "tStartMs": 1110066,
    "dDurationMs": 5434,
    "segs": [ {
      "utf8": "它有点位于古代汉语和现代汉语之间\ntā yǒudiǎn wèiyú gǔdài hànyǔ hé xiàndài hànyǔ zhījiān"
    } ]
  }, {
    "tStartMs": 1115500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "现在我觉得高级的语言\nxiànzài wǒ juéde gāojí de yǔyán"
    } ]
  }, {
    "tStartMs": 1117133,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "反而是简单的清楚的\nfǎnér shì jiǎndān de qīngchu de"
    } ]
  }, {
    "tStartMs": 1120633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "而且如果我还是用这么复杂的语言\nérqiě rúguǒ wǒ háishi yòng zhème fùzá de yǔyán"
    } ]
  }, {
    "tStartMs": 1123633,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我是不可能去教人中文的\nwǒ shì bùkěnéng qù jiào rénzhōng wén de"
    } ]
  }, {
    "tStartMs": 1126900,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "但怎么办呢\ndàn zěnmebàn ne"
    } ]
  }, {
    "tStartMs": 1128433,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "我当时就是喜欢这样的语言\nwǒ dāngshí jiùshì xǐhuan zhèyàng de yǔyán"
    } ]
  }, {
    "tStartMs": 1132500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "我现在也不可能去批评当时的我\nwǒ xiànzài yě bùkěnéng qù pīpíng dāngshí de wǒ"
    } ]
  }, {
    "tStartMs": 1135733,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "每个人在不同阶段都会有不同的想法\nměigerén zài bùtóng jiēduàn dūhuì yǒu bùtóng de xiǎngfǎ"
    } ]
  }, {
    "tStartMs": 1140933,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "当时的我喜欢长句\ndāngshí de wǒ xǐhuan chángjù"
    } ]
  }, {
    "tStartMs": 1142733,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "喜欢引用\nxǐhuan yǐnyòng"
    } ]
  }, {
    "tStartMs": 1144033,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "喜欢让一句话显得很有分量\nxǐhuan ràng yījùhuà xiǎnde hěn yǒufèn liàng"
    } ]
  }, {
    "tStartMs": 1147466,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "觉得一句话长、复杂就等于深刻\njuéde yījùhuà zhǎng、 fùzá jiù děngyú shēnkè"
    } ]
  }, {
    "tStartMs": 1152200,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "所以从小学到高中\nsuǒyǐ cóngxiǎo xué dào gāozhōng"
    } ]
  }, {
    "tStartMs": 1157000,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "我的中文写作水平到底变了多少呢？\nwǒ de zhōngwén xiězuò shuǐpíng dàodǐ biàn le duōshǎo ne?"
    } ]
  }, {
    "tStartMs": 1162300,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "我只能说\nwǒ zhǐnéng shuō"
    } ]
  }, {
    "tStartMs": 1163433,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "我看到的变化不是一条线性的变化\nwǒ kàn dào de biànhuà bùshì yī tiáo xiànxìng de biànhuà"
    } ]
  }, {
    "tStartMs": 1167300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "也不是说我的水平越来越高\nyě bùshì shuō wǒ de shuǐpíng yuèláiyuè gāo"
    } ]
  }, {
    "tStartMs": 1170333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我的写作越来越高级的变化\nwǒ de xiězuò yuèláiyuè gāojí de biànhuà"
    } ]
  }, {
    "tStartMs": 1174100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "我看到的更多是我和\nwǒ kàn dào de gèng duō shì wǒ hé"
    } ]
  }, {
    "tStartMs": 1176566,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "写作之间关系的变化\nxiězuò zhījiān guānxi de biànhuà"
    } ]
  }, {
    "tStartMs": 1179133,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "觉得看到这些对你们来说\njuéde kàn dào zhèxiē duì nǐmen lái shuō"
    } ]
  }, {
    "tStartMs": 1181666,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "应该也挺有意思的\nyīnggāi yě tǐng yǒuyìsi de"
    } ]
  }, {
    "tStartMs": 1184500,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "也许这可以让你们感受到\nyěxǔ zhè kěyǐ ràng nǐmen gǎnshòu dào"
    } ]
  }, {
    "tStartMs": 1187600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "学一门语言不仅仅是\nxué yī mén yǔyán bùjǐn jǐn shì"
    } ]
  }, {
    "tStartMs": 1190200,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "从简单走向高级，或者走向复杂\ncóng jiǎndān zǒuxiàng gāojí, huòzhě zǒuxiàng fùzá"
    } ]
  }, {
    "tStartMs": 1194733,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "它更多是让你去慢慢的学会\ntā gèng duō shì ràng nǐ qù mànmàn de xuéhuì"
    } ]
  }, {
    "tStartMs": 1198233,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "怎么更好的去用语言表达自己\nzěnme gèng hǎo de qù yòngyǔ yán biǎodá zìjǐ"
    } ]
  }, {
    "tStartMs": 1202566,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "表现自己\nbiǎoxiànzìjǐ"
    } ]
  }, {
    "tStartMs": 1204233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "怎么让你去感受\nzěnme ràng nǐ qù gǎnshòu"
    } ]
  }, {
    "tStartMs": 1207966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "越来越多\nyuèláiyuè duō"
    } ]
  }, {
    "tStartMs": 1209333,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "越来越深\nyuèláiyuè shēn"
    } ]
  }, {
    "tStartMs": 1210333,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "你和这门你学习的语言之间的连接\nnǐ hé zhè mén nǐ xuéxí de yǔyán zhījiān de liánjiē"
    } ]
  }, {
    "tStartMs": 1215166,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "说到这里\nshuō dào zhèlǐ"
    } ]
  }, {
    "tStartMs": 1216066,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "我也很好奇\nwǒ yě hěn hàoqí"
    } ]
  }, {
    "tStartMs": 1217633,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "在你们的母语考试中间\nzài nǐmen de mǔyǔ kǎoshì zhōngjiān"
    } ]
  }, {
    "tStartMs": 1221433,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "写作有多重要呢？\nxiězuò yǒu duōchóng yào ne?"
    } ]
  }, {
    "tStartMs": 1224433,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "它让你害怕？\ntā ràng nǐ hàipà?"
    } ]
  }, {
    "tStartMs": 1226166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "还是让你兴奋？\nháishi ràng nǐ xīngfèn?"
    } ]
  }, {
    "tStartMs": 1227733,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "你们需要训练写作的时间多吗？\nnǐmen xūyào xùnliàn xiězuò de shíjiān duō ma?"
    } ]
  }, {
    "tStartMs": 1231433,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "你们又是怎么训练的呢？\nnǐmen yòu shì zěnme xùnliàn de ne?"
    } ]
  }, {
    "tStartMs": 1233733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "也会有这么多作文本吗？\nyě huì yǒu zhème duō zuòwén běn ma?"
    } ]
  }, {
    "tStartMs": 1237700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "其实今天带你们看的只是\nqíshí jīntiān dài nǐmen kàn de zhǐshì"
    } ]
  }, {
    "tStartMs": 1240233,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "这些作文里的很小一部分\nzhèxiē zuòwén lǐ de hěn xiǎo yībùfen"
    } ]
  }, {
    "tStartMs": 1242933,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "里面还有其他很多东西\nlǐmiàn háiyǒu qítā hěn duō dōngxi"
    } ]
  }, {
    "tStartMs": 1244900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "比如一些奇怪的作文题目\nbǐrú yīxiē qíguài de zuòwén tímù"
    } ]
  }, {
    "tStartMs": 1247900,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "老师的评语\nlǎoshī de píngyǔ"
    } ]
  }, {
    "tStartMs": 1249533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "还有很多我现在都完全\nháiyǒu hěn duō wǒ xiànzài dōu wánquán"
    } ]
  }, {
    "tStartMs": 1251866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "不记得自己写过的东西\nbù jìde zìjǐ xiě guò de dōngxi"
    } ]
  }, {
    "tStartMs": 1255200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "如果你们喜欢\nrúguǒ nǐmen xǐhuan"
    } ]
  }, {
    "tStartMs": 1256633,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "我之后还可以再出一期相关的视频\nwǒ zhīhòu hái kěyǐ zài chū yī qī xiāngguān de shìpín"
    } ]
  }, {
    "tStartMs": 1260633,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "比如我们可以来一期视频\nbǐrú wǒmen kěyǐ lái yī qī shìpín"
    } ]
  }, {
    "tStartMs": 1263200,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "专门看一看中国的\nzhuānmén kànyīkàn zhōngguó de"
    } ]
  }, {
    "tStartMs": 1265333,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "学生是怎么写作文的\nxuésheng shì zěnme xiězuò wén de"
    } ]
  }, {
    "tStartMs": 1267700,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "或者看一看中国的\nhuòzhě kànyīkàn zhōngguó de"
    } ]
  }, {
    "tStartMs": 1269266,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "老师是怎么批改作文的\nlǎoshī shì zěnme pīgǎi zuòwén de"
    } ]
  }, {
    "tStartMs": 1272066,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "那今天的视频就到这里结束了\nnà jīntiān de shìpín jiù dào zhèlǐ jiéshù le"
    } ]
  }, {
    "tStartMs": 1275466,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "我们下期视频再见吧，拜拜\nwǒmen xià qī shìpín zàijiàn ba, báibái"
    } ]
  } ]
}
