{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 6367,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "亲爱的听众朋友们，大家周末好！"
    } ]
  }, {
    "tStartMs": 8333,
    "dDurationMs": 4634,
    "segs": [ {
      "utf8": "欢迎收听新一期的《每天中文》，我是李明。"
    } ]
  }, {
    "tStartMs": 13000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "(笑) 嗨，大家好，我是王雨！"
    } ]
  }, {
    "tStartMs": 14933,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "转眼到了九月，秋天的天气越来越舒服了。"
    } ]
  }, {
    "tStartMs": 18567,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "各位小伙伴最近工作和学习都还顺利吗？"
    } ]
  }, {
    "tStartMs": 21800,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "今天坐在麦克风前，听到窗外的微风，"
    } ]
  }, {
    "tStartMs": 24533,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "我的心情格外好！"
    } ]
  }, {
    "tStartMs": 26133,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "(笑) 是啊，"
    } ]
  }, {
    "tStartMs": 27533,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "九月不管是对于刚开学的同学，"
    } ]
  }, {
    "tStartMs": 30167,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "还是在职场打拼的朋友，"
    } ]
  }, {
    "tStartMs": 32267,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "都是一个充满新开始的季节。"
    } ]
  }, {
    "tStartMs": 35200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "不过说到人生的新规划，王雨，"
    } ]
  }, {
    "tStartMs": 37733,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "你最近看社交平台上的讨论了吗？"
    } ]
  }, {
    "tStartMs": 40300,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "很多年轻人都在分享同一种烦恼。"
    } ]
  }, {
    "tStartMs": 43300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我正想跟你说这个呢！"
    } ]
  }, {
    "tStartMs": 45067,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "很多人都在讨论“来自父母的压力”。"
    } ]
  }, {
    "tStartMs": 48500,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "比如自己想留在喜欢的城市发展、"
    } ]
  }, {
    "tStartMs": 51267,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "或者换一份想做的工作，"
    } ]
  }, {
    "tStartMs": 54000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "但父母总是在电话里叹气说："
    } ]
  }, {
    "tStartMs": 56567,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "“我们做的一切都是为你好，"
    } ]
  }, {
    "tStartMs": 58800,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "你怎么就不能听话一次呢？”"
    } ]
  }, {
    "tStartMs": 61367,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "很多人吐槽说，"
    } ]
  }, {
    "tStartMs": 62567,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "好像只要不按父母的安排生活，"
    } ]
  }, {
    "tStartMs": 65100,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "就立刻成了“不孝顺”的孩子。"
    } ]
  }, {
    "tStartMs": 67400,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "没错，这句话真的让很多人感到委屈和焦虑。"
    } ]
  }, {
    "tStartMs": 71667,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "“听话”难道真的就等于“孝顺”吗？"
    } ]
  }, {
    "tStartMs": 75100,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "在当代社会，面对家庭的期待与压力，"
    } ]
  }, {
    "tStartMs": 78267,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "年轻人到底该怎么做？"
    } ]
  }, {
    "tStartMs": 80300,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "今天"
    } ]
  }, {
    "tStartMs": 80967,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "我们就来好好聊一聊“孝”与“顺”的区别，"
    } ]
  }, {
    "tStartMs": 84800,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "顺便看看两千多年前的古人，"
    } ]
  }, {
    "tStartMs": 87400,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "到底是怎么教我们应对父母的！"
    } ]
  }, {
    "tStartMs": 90200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "听到李明这么问，我猜"
    } ]
  }, {
    "tStartMs": 91867,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "你肯定准备了很有意思的历史故事。"
    } ]
  }, {
    "tStartMs": 94767,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "大家千万别以为"
    } ]
  }, {
    "tStartMs": 96100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "“盲目听话”是中国自古以来的传统，"
    } ]
  }, {
    "tStartMs": 99133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "其实并不是这样的，对不对？"
    } ]
  }, {
    "tStartMs": 100867,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "没错。在讲大道理之前，"
    } ]
  }, {
    "tStartMs": 102933,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "我想先给大家讲一个"
    } ]
  }, {
    "tStartMs": 104700,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "在历史上非常著名的典故。"
    } ]
  }, {
    "tStartMs": 107567,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这个故事记录在《孔"
    } ]
  }, {
    "tStartMs": 109133,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "子家语》这本书里，"
    } ]
  }, {
    "tStartMs": 110767,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "故事的主角是孔子和他最得"
    } ]
  }, {
    "tStartMs": 113467,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "意的弟子之一，叫做曾子。"
    } ]
  }, {
    "tStartMs": 116467,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "曾子？我知道他，在很多历史故事里，"
    } ]
  }, {
    "tStartMs": 120000,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "曾子可是出了名的大孝子啊！"
    } ]
  }, {
    "tStartMs": 122300,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "对，曾子非常敬重他的父亲。"
    } ]
  }, {
    "tStartMs": 125200,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "有一天，曾子在瓜田里帮父亲干农活，"
    } ]
  }, {
    "tStartMs": 128800,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "除草的时候，"
    } ]
  }, {
    "tStartMs": 129767,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "他不小心把一棵瓜苗的根给弄断了。"
    } ]
  }, {
    "tStartMs": 133533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "他的父亲脾气非常暴躁，"
    } ]
  }, {
    "tStartMs": 135733,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "看到儿子弄坏了庄稼，顿时火冒三丈，"
    } ]
  }, {
    "tStartMs": 139300,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "随手从旁边捡起一根又粗又大的木棍，"
    } ]
  }, {
    "tStartMs": 142400,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "狠狠地朝着曾子的后背打过去。"
    } ]
  }, {
    "tStartMs": 145200,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "哎呀，只是弄断了一棵苗而已，"
    } ]
  }, {
    "tStartMs": 148100,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "用大棍子打，这下手也太狠了吧！"
    } ]
  }, {
    "tStartMs": 151400,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "那曾子是怎么反应的？"
    } ]
  }, {
    "tStartMs": 153100,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "他跑了吗？"
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "曾子没有跑。"
    } ]
  }, {
    "tStartMs": 155400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "他当时心里想：“我是个孝顺的儿子，"
    } ]
  }, {
    "tStartMs": 158533,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "父亲要打我，我怎么能逃跑呢？"
    } ]
  }, {
    "tStartMs": 161267,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "我必须站在原地接受父亲的惩罚，"
    } ]
  }, {
    "tStartMs": 164367,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "这才是听话，这才是孝顺。”"
    } ]
  }, {
    "tStartMs": 167133,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "于是，曾子一动不动地站在那里挨打。"
    } ]
  }, {
    "tStartMs": 170467,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "结果因为父亲下手实在太重，"
    } ]
  }, {
    "tStartMs": 172900,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "曾子被打倒在地上，"
    } ]
  }, {
    "tStartMs": 174200,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "甚至当场晕了过去，"
    } ]
  }, {
    "tStartMs": 176167,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "过了好久才慢慢苏醒过来。"
    } ]
  }, {
    "tStartMs": 178533,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "天哪，都打到昏迷了！"
    } ]
  }, {
    "tStartMs": 180800,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "这也太危险了！"
    } ]
  }, {
    "tStartMs": 182500,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "那他醒过来之后呢？"
    } ]
  }, {
    "tStartMs": 184067,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "有没有生气？"
    } ]
  }, {
    "tStartMs": 185133,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "更有意思的就在这里。"
    } ]
  }, {
    "tStartMs": 186733,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "曾子醒过来以后，不仅一点儿没生气，"
    } ]
  }, {
    "tStartMs": 190000,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "反而立刻拍拍尘土"
    } ]
  }, {
    "tStartMs": 191800,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "站起来，整理好衣服，走到父亲面前鞠躬。"
    } ]
  }, {
    "tStartMs": 195367,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "他微笑着对父亲说：“父亲，"
    } ]
  }, {
    "tStartMs": 197700,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "刚才我犯了错，您用力打我，"
    } ]
  }, {
    "tStartMs": 200400,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "您的身体没有累着吧？”"
    } ]
  }, {
    "tStartMs": 202533,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "说完之后，曾子还特意回到房间里，"
    } ]
  }, {
    "tStartMs": 204700,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "大声地弹琴唱歌，"
    } ]
  }, {
    "tStartMs": 206700,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "就是为了让父亲听见，"
    } ]
  }, {
    "tStartMs": 208300,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "证明自己身体没事，好让父亲放心。"
    } ]
  }, {
    "tStartMs": 211367,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "(笑) 哇，如果"
    } ]
  }, {
    "tStartMs": 212533,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "按照我们现代一些长辈的标准来看，"
    } ]
  }, {
    "tStartMs": 215167,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "曾子这简直是“满分孝子”啊！"
    } ]
  }, {
    "tStartMs": 218200,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "不管父母怎么发脾气，"
    } ]
  }, {
    "tStartMs": 219867,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "不仅不还手、不逃跑，"
    } ]
  }, {
    "tStartMs": 221767,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "被打晕了还反过来安慰父母。"
    } ]
  }, {
    "tStartMs": 224367,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "大家肯定都觉得孔子会好好表扬曾子吧？"
    } ]
  }, {
    "tStartMs": 227900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "哈哈，恰恰相反！"
    } ]
  }, {
    "tStartMs": 229933,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "孔子听到这件事情之后，勃然大怒。"
    } ]
  }, {
    "tStartMs": 233100,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "孔子非常生气，"
    } ]
  }, {
    "tStartMs": 234500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "直接对门口的守门弟子说："
    } ]
  }, {
    "tStartMs": 236767,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "“如果曾子来了，"
    } ]
  }, {
    "tStartMs": 238200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "千万不要让他进我的门，"
    } ]
  }, {
    "tStartMs": 240133,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "我不想再见到这个学生！”啊？为什么呀？"
    } ]
  }, {
    "tStartMs": 243767,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "曾子这么听话，"
    } ]
  }, {
    "tStartMs": 245167,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "孔子为什么要生那么大的气呢？"
    } ]
  }, {
    "tStartMs": 247567,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "曾子当时也觉得特别委屈，"
    } ]
  }, {
    "tStartMs": 249867,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "完全想不通自己到底错在哪里。"
    } ]
  }, {
    "tStartMs": 252600,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "于是他托人去向孔子请教。"
    } ]
  }, {
    "tStartMs": 255400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "孔子知道后，非常严肃地批评了曾子。"
    } ]
  }, {
    "tStartMs": 258533,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "孔子说：“当年舜帝孝敬父母，"
    } ]
  }, {
    "tStartMs": 261667,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "父亲用小木条打他的时候，"
    } ]
  }, {
    "tStartMs": 263933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "他就老老实实地站着受罚；但是"
    } ]
  }, {
    "tStartMs": 266567,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "当父亲拿着大木棍要打他的时候，"
    } ]
  }, {
    "tStartMs": 269133,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "舜帝拔腿就跑！"
    } ]
  }, {
    "tStartMs": 270767,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "为什么？因为如果站在那里不跑，"
    } ]
  }, {
    "tStartMs": 273933,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "父亲万一下手太重把你打残废了，"
    } ]
  }, {
    "tStartMs": 277000,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "甚至把你打死了，"
    } ]
  }, {
    "tStartMs": 278567,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "你岂不是陷父亲于不义吗？”"
    } ]
  }, {
    "tStartMs": 281100,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "陷父亲于不义？这句话的意思是……"
    } ]
  }, {
    "tStartMs": 284300,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "孔子的意思是说，"
    } ]
  }, {
    "tStartMs": 285800,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "如果你的父亲在冲动之下"
    } ]
  }, {
    "tStartMs": 288100,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "失手把你打死了，"
    } ]
  }, {
    "tStartMs": 289800,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "你的父亲就变成了杀人犯，"
    } ]
  }, {
    "tStartMs": 292000,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "不仅要受到法律的制裁，"
    } ]
  }, {
    "tStartMs": 294067,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "还会被天下所有人唾骂，背上一辈子的罪名。"
    } ]
  }, {
    "tStartMs": 298467,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "你以为你在顺从父母，但事实上，"
    } ]
  }, {
    "tStartMs": 301267,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "你却用这种愚蠢的听话，害了你的父亲！"
    } ]
  }, {
    "tStartMs": 305000,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "孔子接着说：“你身为天子的子民，"
    } ]
  }, {
    "tStartMs": 307900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "却让天子失去一个百姓；"
    } ]
  }, {
    "tStartMs": 310133,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "你身为父母的儿子，"
    } ]
  }, {
    "tStartMs": 311767,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "却让父母背上杀子的恶名。"
    } ]
  }, {
    "tStartMs": 314500,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "这怎么能叫孝顺？"
    } ]
  }, {
    "tStartMs": 316400,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "这简直是天下最大的不孝！”"
    } ]
  }, {
    "tStartMs": 319200,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "孔子的这番话真是太深刻了！"
    } ]
  }, {
    "tStartMs": 321900,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "骂得太清醒了！"
    } ]
  }, {
    "tStartMs": 323667,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "原来在两千多年前，"
    } ]
  }, {
    "tStartMs": 325367,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "孔子就明确反对这种盲目的服从。"
    } ]
  }, {
    "tStartMs": 328467,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "是的，这就是中国古代非常著名的成语"
    } ]
  }, {
    "tStartMs": 331700,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "典故，叫做“小杖则受，大杖则走”。"
    } ]
  }, {
    "tStartMs": 336400,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "小棍子打你，那是教育，你可"
    } ]
  }, {
    "tStartMs": 338400,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "以忍受；大棍子打你，那是伤害，"
    } ]
  }, {
    "tStartMs": 341500,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "你必须立刻跑开！"
    } ]
  }, {
    "tStartMs": 343667,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "孔子用这种极端的方式告诉我们："
    } ]
  }, {
    "tStartMs": 346267,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "真正的“孝”，是充满智慧和道德的爱；"
    } ]
  }, {
    "tStartMs": 349967,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "而盲目的“顺”，根本不是孝，"
    } ]
  }, {
    "tStartMs": 352567,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "那只是一种不动脑筋的愚蠢。"
    } ]
  }, {
    "tStartMs": 355300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "这个典故放在今天来看，"
    } ]
  }, {
    "tStartMs": 357133,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "依然太有现实意义了。"
    } ]
  }, {
    "tStartMs": 359100,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "现代社会虽然很少有父母用大棍子打孩子了"
    } ]
  }, {
    "tStartMs": 362767,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "但是很多父母在用“语言”和“情绪”的大木棍打孩子。"
    } ]
  }, {
    "tStartMs": 367167,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这个比喻非常精彩！"
    } ]
  }, {
    "tStartMs": 369200,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "语言上的否定，情绪上的控制，"
    } ]
  }, {
    "tStartMs": 372100,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "精神上的绑架，"
    } ]
  }, {
    "tStartMs": 373667,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "其实就是现代生活中的“大木棍”。"
    } ]
  }, {
    "tStartMs": 376500,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "比如很多父母会对孩子说："
    } ]
  }, {
    "tStartMs": 378967,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "“你要是不听我的安排，"
    } ]
  }, {
    "tStartMs": 380567,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "我就不认你这个孩子！”"
    } ]
  }, {
    "tStartMs": 382133,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "或者“你选这个专业，以后肯定没出息，"
    } ]
  }, {
    "tStartMs": 385533,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "你会后悔一辈子的！”"
    } ]
  }, {
    "tStartMs": 387733,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "这种压力对于年轻人来说，"
    } ]
  }, {
    "tStartMs": 390000,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "就像是精神上的毒打。"
    } ]
  }, {
    "tStartMs": 392533,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "没错！"
    } ]
  }, {
    "tStartMs": 393300,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "很多年轻朋友就像当年的曾子一样，"
    } ]
  }, {
    "tStartMs": 396133,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "站在原地一动不动地挨打。"
    } ]
  }, {
    "tStartMs": 398667,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "他们不敢反抗，甚至为了让父母安心，"
    } ]
  }, {
    "tStartMs": 401567,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "放弃了自己喜欢的人，"
    } ]
  }, {
    "tStartMs": 403467,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "放弃了想去的大城市，"
    } ]
  }, {
    "tStartMs": 405567,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "辞掉了喜欢的有前途的工作，"
    } ]
  }, {
    "tStartMs": 408067,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "回老家过着毫无生气的日子。"
    } ]
  }, {
    "tStartMs": 411000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "他们以为自己做到了“孝顺”，"
    } ]
  }, {
    "tStartMs": 413133,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "但实际上整天郁郁寡欢，"
    } ]
  }, {
    "tStartMs": 415700,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "心里对父母积攒了无数的怨恨。"
    } ]
  }, {
    "tStartMs": 418700,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "这正是我们要分析的核心问题："
    } ]
  }, {
    "tStartMs": 421300,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "为什么我们一定要把“孝”和“顺”"
    } ]
  }, {
    "tStartMs": 423867,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "区分开来？"
    } ]
  }, {
    "tStartMs": 425000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "李明，你能不能给我们具体拆解一下，"
    } ]
  }, {
    "tStartMs": 427933,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "这两个字在心理和生活层面上，"
    } ]
  }, {
    "tStartMs": 430567,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "到底有什么不同？"
    } ]
  }, {
    "tStartMs": 432000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "好。首先看“孝”。"
    } ]
  }, {
    "tStartMs": 434133,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "在汉字里，"
    } ]
  }, {
    "tStartMs": 435167,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "“孝”字上面是一个“老”字的一半，"
    } ]
  }, {
    "tStartMs": 437933,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "下面是一个“子”字，形象地代表着"
    } ]
  }, {
    "tStartMs": 441133,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "长辈和晚辈之间的支撑与关爱。"
    } ]
  }, {
    "tStartMs": 444767,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "孝的核心是“敬爱”和“感恩”。"
    } ]
  }, {
    "tStartMs": 447767,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "父母抚养我们长大，付出了很多"
    } ]
  }, {
    "tStartMs": 450133,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "心血，我们在他们生病时照顾他们，"
    } ]
  }, {
    "tStartMs": 453000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "在他们孤独时陪伴他们，"
    } ]
  }, {
    "tStartMs": 455133,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "在精神上尊重他们，用物质回报他们，"
    } ]
  }, {
    "tStartMs": 458567,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "这是天经地义的美德。"
    } ]
  }, {
    "tStartMs": 460933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "对，这种爱是双向的，"
    } ]
  }, {
    "tStartMs": 463267,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "是发自内心的温暖，没有任何压迫感。"
    } ]
  }, {
    "tStartMs": 466900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "那“顺”呢？“顺”指的是顺从、"
    } ]
  }, {
    "tStartMs": 469667,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "附和。很多父母把“顺”理解成了："
    } ]
  }, {
    "tStartMs": 472933,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "你的想法必须和我一模一样，"
    } ]
  }, {
    "tStartMs": 475267,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "你的价值观必须完全复制我的价值观，"
    } ]
  }, {
    "tStartMs": 478600,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "我的决定就是你的圣旨。"
    } ]
  }, {
    "tStartMs": 481200,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "如果父母要求你必须事事顺从，"
    } ]
  }, {
    "tStartMs": 483900,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "这种关系就不是基于爱，而是基于“控制”。"
    } ]
  }, {
    "tStartMs": 488000,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我觉得这是一种很可怕的控制。"
    } ]
  }, {
    "tStartMs": 490333,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "因为每个人都是一个独立的个体。"
    } ]
  }, {
    "tStartMs": 492967,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "父母生活在他们的时代，"
    } ]
  }, {
    "tStartMs": 494900,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "年轻人生长在新的时代。"
    } ]
  }, {
    "tStartMs": 497133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "如果孩子一辈子只是父母的复制品，"
    } ]
  }, {
    "tStartMs": 500067,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "那人类社会怎么进步呢？"
    } ]
  }, {
    "tStartMs": 502400,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "确实是这样。"
    } ]
  }, {
    "tStartMs": 503500,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "有一位心理学家曾经说过，"
    } ]
  }, {
    "tStartMs": 505600,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "一个健康的家庭，"
    } ]
  }, {
    "tStartMs": 507067,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "必须要有清晰的“边界感”。"
    } ]
  }, {
    "tStartMs": 509600,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "什么是边界感呢？"
    } ]
  }, {
    "tStartMs": 511200,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "就是父母要明白："
    } ]
  }, {
    "tStartMs": 512700,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "孩子借由你的身体来到这个世界上，"
    } ]
  }, {
    "tStartMs": 515700,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "但他不是你的私有财产。"
    } ]
  }, {
    "tStartMs": 517800,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "他的人生道路，必须由他自己一步一步去走。"
    } ]
  }, {
    "tStartMs": 521700,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "跌倒了、摔痛了，也是他自己成长中"
    } ]
  }, {
    "tStartMs": 524900,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "不可缺少的一部分。"
    } ]
  }, {
    "tStartMs": 526767,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "但是李明，我们换位思考一下，"
    } ]
  }, {
    "tStartMs": 529167,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "站在父母的角度来看，"
    } ]
  }, {
    "tStartMs": 531067,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "很多父母之所以想控制孩子，"
    } ]
  }, {
    "tStartMs": 533500,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "其实并不是真的坏，"
    } ]
  }, {
    "tStartMs": 535167,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "他们只是太害怕了，对不对？"
    } ]
  }, {
    "tStartMs": 537467,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "你的同理心非常好。"
    } ]
  }, {
    "tStartMs": 539533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "确实，大多数中国父母逼迫孩子，"
    } ]
  }, {
    "tStartMs": 542533,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "核心动机不是为了折磨孩子，"
    } ]
  }, {
    "tStartMs": 544933,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "而是出于深深的“焦虑”和“安全感匮乏”。"
    } ]
  }, {
    "tStartMs": 548733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "他们年轻的时候经历过物质匮乏、"
    } ]
  }, {
    "tStartMs": 551367,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "社会剧烈变动的时代，"
    } ]
  }, {
    "tStartMs": 553500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "在他们的认知里，铁饭碗、"
    } ]
  }, {
    "tStartMs": 555767,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "稳定的体制内工作、按部就班的家庭，"
    } ]
  }, {
    "tStartMs": 558900,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "就是抵抗生活风险唯一的盾牌。"
    } ]
  }, {
    "tStartMs": 562267,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "是的，当他们看到年轻人去创业、"
    } ]
  }, {
    "tStartMs": 565133,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "做自由职业、"
    } ]
  }, {
    "tStartMs": 566367,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "或者到了三十岁还不结婚，"
    } ]
  }, {
    "tStartMs": 568567,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "他们理解不了这种现代生活方式，"
    } ]
  }, {
    "tStartMs": 571267,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "他们的大脑就会本能地报警，"
    } ]
  }, {
    "tStartMs": 573567,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "觉得孩子要掉进悬崖里了。"
    } ]
  }, {
    "tStartMs": 576067,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "所以他们拼命拉住孩子，哪怕手段非常粗暴。"
    } ]
  }, {
    "tStartMs": 580567,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "所以，面对这种情况，"
    } ]
  }, {
    "tStartMs": 582367,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "现代年轻人最聪明的做法，"
    } ]
  }, {
    "tStartMs": 584767,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "既不是做那个站在原地"
    } ]
  }, {
    "tStartMs": 586533,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "挨打的“愚蠢曾子”，"
    } ]
  }, {
    "tStartMs": 588400,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "也不是变成一个完全不理父母、"
    } ]
  }, {
    "tStartMs": 591100,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "和家庭彻底决裂的叛逆者。"
    } ]
  }, {
    "tStartMs": 593900,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我们要做的"
    } ]
  }, {
    "tStartMs": 594867,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "是一个拥有现代智慧的“成年人”。"
    } ]
  }, {
    "tStartMs": 598200,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "那作为成年人，我们到底该如何"
    } ]
  }, {
    "tStartMs": 601167,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "具体地面对这种家庭压力呢？"
    } ]
  }, {
    "tStartMs": 603600,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "你有没有什么可操作的建议可以分享给大家？"
    } ]
  }, {
    "tStartMs": 607100,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我觉得可以总结为三句话。"
    } ]
  }, {
    "tStartMs": 609600,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "第一句话叫做：态度要极其温柔，"
    } ]
  }, {
    "tStartMs": 612900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "但底线要极其坚定。"
    } ]
  }, {
    "tStartMs": 615333,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "态度温柔，底线坚定。"
    } ]
  }, {
    "tStartMs": 618000,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "这个具体怎么理解？"
    } ]
  }, {
    "tStartMs": 619733,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "很多年轻人在和父母意见不合的时候，"
    } ]
  }, {
    "tStartMs": 622600,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "很容易情绪失控，大喊大叫："
    } ]
  }, {
    "tStartMs": 625400,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "“你们的思想太老套了！"
    } ]
  }, {
    "tStartMs": 627400,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "你们根本不懂现在的社会！”"
    } ]
  }, {
    "tStartMs": 629933,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "这种说话方式，表面上看起来很强硬，"
    } ]
  }, {
    "tStartMs": 633267,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "其实在心理学上表现得像个无助的小孩。"
    } ]
  }, {
    "tStartMs": 637133,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "你越愤怒，父母越觉得你不成熟，"
    } ]
  }, {
    "tStartMs": 640333,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "越觉得你无法对自己负责。"
    } ]
  }, {
    "tStartMs": 642767,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "有道理！成熟的标志不是声音大，"
    } ]
  }, {
    "tStartMs": 645867,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "而是情绪稳定。"
    } ]
  }, {
    "tStartMs": 647533,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "没错。你可以给父母倒一杯茶，"
    } ]
  }, {
    "tStartMs": 650067,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "握着他们的手，微笑着说：“爸爸妈妈，"
    } ]
  }, {
    "tStartMs": 652933,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "我特别理解你们是在为我担心。"
    } ]
  }, {
    "tStartMs": 655500,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "如果我是你们，"
    } ]
  }, {
    "tStartMs": 656567,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "看到现在的我，可能也会焦虑。"
    } ]
  }, {
    "tStartMs": 658867,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我很感谢你们这么爱我。”"
    } ]
  }, {
    "tStartMs": 661100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这就是态度的极其温柔。"
    } ]
  }, {
    "tStartMs": 663333,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "但是接下来，"
    } ]
  }, {
    "tStartMs": 664300,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "你要用平静且坚定的语气说："
    } ]
  }, {
    "tStartMs": 667000,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "“但是我已经是二十多岁的大人了，"
    } ]
  }, {
    "tStartMs": 669567,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "如果我一辈子按照你们的意愿生活，"
    } ]
  }, {
    "tStartMs": 672100,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "一旦失败了，我心里会怨恨你们一辈子。"
    } ]
  }, {
    "tStartMs": 675533,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我希望为我自己的生命买单，"
    } ]
  }, {
    "tStartMs": 677867,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "哪怕摔跟头，也是我自己选择的路。"
    } ]
  }, {
    "tStartMs": 680933,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "希望你们能试着相信我一次。”太棒了！"
    } ]
  }, {
    "tStartMs": 684167,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "把情绪抽离出来，只陈述事实和边界。"
    } ]
  }, {
    "tStartMs": 687800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "那第二句话是什么呢？"
    } ]
  }, {
    "tStartMs": 689367,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "第二句话叫做：用行动证明你的独立，"
    } ]
  }, {
    "tStartMs": 693200,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "而不是用语言去争论。"
    } ]
  }, {
    "tStartMs": 695500,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "这点太关键了！"
    } ]
  }, {
    "tStartMs": 697567,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "有些年轻人一边喊着“我要自由，"
    } ]
  }, {
    "tStartMs": 700300,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "我要独立”，"
    } ]
  }, {
    "tStartMs": 701267,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "一边每个月还要花父母的钱，"
    } ]
  }, {
    "tStartMs": 703767,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "或者生活上一团糟，衣服不会洗，"
    } ]
  }, {
    "tStartMs": 706900,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "房间不会收拾，生病了也照顾不好自己。"
    } ]
  }, {
    "tStartMs": 710667,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "如果我是父母，我肯定也不放心放手啊！"
    } ]
  }, {
    "tStartMs": 714133,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "完全正确！"
    } ]
  }, {
    "tStartMs": 715400,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "如果你想拥有人生的决定权，"
    } ]
  }, {
    "tStartMs": 717933,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "你首先要拥有独立生活的能力。"
    } ]
  }, {
    "tStartMs": 721400,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "你在大城市生活，你的工作能不能养活自己？"
    } ]
  }, {
    "tStartMs": 725133,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "你的身体是不是健康？"
    } ]
  }, {
    "tStartMs": 727100,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "你的生活规律吗？"
    } ]
  }, {
    "tStartMs": 728767,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "当你能够把自己的生活打理得井井"
    } ]
  }, {
    "tStartMs": 731467,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "有条，甚至还能在父母需要的时候"
    } ]
  }, {
    "tStartMs": 734567,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "为他们遮风挡雨，"
    } ]
  }, {
    "tStartMs": 736267,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "父母心里的安全感自然就会慢慢建立起来。"
    } ]
  }, {
    "tStartMs": 739967,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "当他们看到你过得比他们想象中"
    } ]
  }, {
    "tStartMs": 742567,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "还要好的时候，很多逼迫自然就烟消云散了。"
    } ]
  }, {
    "tStartMs": 747167,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "事实胜于雄辩。"
    } ]
  }, {
    "tStartMs": 748967,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "经济独立和生活自理，"
    } ]
  }, {
    "tStartMs": 751100,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "才是向父母证明自己最有力的通行证。"
    } ]
  }, {
    "tStartMs": 754400,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "那第三句话呢？"
    } ]
  }, {
    "tStartMs": 755933,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "第三句话，回到我们今天的主题，"
    } ]
  }, {
    "tStartMs": 758800,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "叫做：多做“孝”的事，"
    } ]
  }, {
    "tStartMs": 761333,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "少纠结“顺”的要求。"
    } ]
  }, {
    "tStartMs": 763900,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "怎么理解多做“孝”的事呢？"
    } ]
  }, {
    "tStartMs": 766467,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "比如，在人生的重大选择上，"
    } ]
  }, {
    "tStartMs": 769133,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "比如职业、伴侣、生活城市，"
    } ]
  }, {
    "tStartMs": 772567,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我们要坚持自己的内心，"
    } ]
  }, {
    "tStartMs": 774733,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "不必盲目去“顺”；"
    } ]
  }, {
    "tStartMs": 776600,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "但是在日常生活的细节上，"
    } ]
  }, {
    "tStartMs": 778800,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "我们要尽最大的可能去尽“孝”。"
    } ]
  }, {
    "tStartMs": 781733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "比如按时带他们"
    } ]
  }, {
    "tStartMs": 783367,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "体检，给他们买合身的衣服，"
    } ]
  }, {
    "tStartMs": 786067,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "节假日多打几个视频电话，"
    } ]
  }, {
    "tStartMs": 788500,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "耐心地听他们讲讲家长里短，"
    } ]
  }, {
    "tStartMs": 791167,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "教他们怎么用手机看病买菜。"
    } ]
  }, {
    "tStartMs": 794267,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "明白了！"
    } ]
  }, {
    "tStartMs": 795167,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "在不涉及人生方向的小事上，"
    } ]
  }, {
    "tStartMs": 798100,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "多体贴、多包容、"
    } ]
  }, {
    "tStartMs": 799900,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "多给予情绪价值；在人生的大方向上，"
    } ]
  }, {
    "tStartMs": 803600,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "把稳方向盘，不轻易妥协。"
    } ]
  }, {
    "tStartMs": 806333,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "这样父母既能感受到你浓浓的爱意，"
    } ]
  }, {
    "tStartMs": 809467,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "又不得不接受你已经独立的事实。"
    } ]
  }, {
    "tStartMs": 812333,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "就像我们刚才提到的孔子的教导："
    } ]
  }, {
    "tStartMs": 815167,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "面对父母情绪的“大棍子”，"
    } ]
  }, {
    "tStartMs": 817600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我们要学会巧妙地避开，"
    } ]
  }, {
    "tStartMs": 819933,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "保护好自己的精神世界；"
    } ]
  }, {
    "tStartMs": 822400,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "面对父母对爱的渴望，"
    } ]
  }, {
    "tStartMs": 824467,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "我们要张开双臂，给他们最温暖的拥抱。"
    } ]
  }, {
    "tStartMs": 828167,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "这才是新时代年轻人该有的健康孝道。"
    } ]
  }, {
    "tStartMs": 832333,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "听完今天的分享，"
    } ]
  }, {
    "tStartMs": 833700,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "真的让我有一种豁然开朗的感觉。"
    } ]
  }, {
    "tStartMs": 836400,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "特别是曾子的那个典故，"
    } ]
  }, {
    "tStartMs": 838400,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我相信不仅对学习中文"
    } ]
  }, {
    "tStartMs": 840567,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "和中国文化的朋友们很有启发，"
    } ]
  }, {
    "tStartMs": 843267,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "对于很多正在经历"
    } ]
  }, {
    "tStartMs": 844900,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "家庭压力的中国年轻人来说，"
    } ]
  }, {
    "tStartMs": 847300,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "也是一剂非常好的解药。"
    } ]
  }, {
    "tStartMs": 849400,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "是的，中华文化并不是死板教条的。"
    } ]
  }, {
    "tStartMs": 853200,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "真正的文化经典里，往往"
    } ]
  }, {
    "tStartMs": 855533,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "充满了对人性和人生的深刻理解。"
    } ]
  }, {
    "tStartMs": 859167,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "今天我们聊了这么多，"
    } ]
  }, {
    "tStartMs": 860700,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "相信大家对“孝”和“顺”有了全新的认识。"
    } ]
  }, {
    "tStartMs": 864567,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "节目到这里也快要接近尾声了。"
    } ]
  }, {
    "tStartMs": 867167,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "我们照例来帮大家梳理一下"
    } ]
  }, {
    "tStartMs": 869333,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "今天节目中出现的几个非常核心的中文"
    } ]
  }, {
    "tStartMs": 872667,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "词汇和文化概念。"
    } ]
  }, {
    "tStartMs": 874767,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "第一个核心词，"
    } ]
  }, {
    "tStartMs": 876133,
    "dDurationMs": 5167,
    "segs": [ {
      "utf8": "是典故里的成语：“小杖则受，大杖则走”。"
    } ]
  }, {
    "tStartMs": 881333,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "意思是说，"
    } ]
  }, {
    "tStartMs": 882333,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "面对父母合理的管教我们要接受，"
    } ]
  }, {
    "tStartMs": 885467,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "但面对过度且危险的惩罚，"
    } ]
  }, {
    "tStartMs": 888267,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "我们要懂得保护自己，及时避开，"
    } ]
  }, {
    "tStartMs": 891367,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "不要陷父母于不义。"
    } ]
  }, {
    "tStartMs": 893500,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "第二个核心概念，是区分“孝”与“顺”。"
    } ]
  }, {
    "tStartMs": 897333,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "“孝”是出于内心的爱、尊重与感恩；"
    } ]
  }, {
    "tStartMs": 900933,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "而“顺”是无条件的服从。"
    } ]
  }, {
    "tStartMs": 903500,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "真正的孝，不需要以完全放弃自我为代价。"
    } ]
  }, {
    "tStartMs": 907267,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "第三个核心概念，"
    } ]
  }, {
    "tStartMs": 908733,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "是心理学上的“边界感”与“情绪"
    } ]
  }, {
    "tStartMs": 911567,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "独立”。面对家庭的期待，"
    } ]
  }, {
    "tStartMs": 913667,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "我们要学会用成熟"
    } ]
  }, {
    "tStartMs": 915367,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "成年人的姿态去面对，"
    } ]
  }, {
    "tStartMs": 917100,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "做到“态度温柔，立场坚定”。"
    } ]
  }, {
    "tStartMs": 920567,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "希望大家把这几个概念"
    } ]
  }, {
    "tStartMs": 922300,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "不仅记在中文笔记本上，更能够运用"
    } ]
  }, {
    "tStartMs": 925000,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "到自己的生活和人际交往中。"
    } ]
  }, {
    "tStartMs": 927500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "在节目的最后，我们也想留一个思考题"
    } ]
  }, {
    "tStartMs": 930367,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "给收音机前的朋友们："
    } ]
  }, {
    "tStartMs": 932133,
    "dDurationMs": 2634,
    "segs": [ {
      "utf8": "在你们的母语文化或者家庭环境里，"
    } ]
  }, {
    "tStartMs": 934800,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "父母和子女之间也是这种紧密连接的关系吗？"
    } ]
  }, {
    "tStartMs": 938467,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "当你和父母的想法产生"
    } ]
  }, {
    "tStartMs": 940067,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "巨大分歧的时候，"
    } ]
  }, {
    "tStartMs": 941333,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "你通常会如何选择和沟通呢？"
    } ]
  }, {
    "tStartMs": 944133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "欢迎大家在评论区"
    } ]
  }, {
    "tStartMs": 945567,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "留下你们的经历和见解，"
    } ]
  }, {
    "tStartMs": 947533,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "用中文写下你们的故事，"
    } ]
  }, {
    "tStartMs": 949533,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "我们非常期待读到大家的真实感受！"
    } ]
  }, {
    "tStartMs": 952300,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "感谢大家收听这一期的《每天中文》。"
    } ]
  }, {
    "tStartMs": 954900,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "愿我们每一个人，"
    } ]
  }, {
    "tStartMs": 956100,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "都能在深深爱着家人的同时，"
    } ]
  }, {
    "tStartMs": 958367,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "坚定而勇敢地走在做自己的道路上。"
    } ]
  }, {
    "tStartMs": 961900,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "祝大家生活愉快，我们下期节目不见不散！"
    } ]
  }, {
    "tStartMs": 965000,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "朋友们，下期见，再见！拜拜！"
    } ]
  } ]
}
