  "events": [ {
    "tStartMs": 333,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "rú guǒ nǐ de péng yǒu gēn nǐ shuō\nIf your friend tells you"
    } ]
  }, {
    "tStartMs": 4033,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "tā / tā zuò le yí jiàn shén me shén me shì qíng\nthat he/she did something"
    } ]
  }, {
    "tStartMs": 8700,
    "dDurationMs": 1699,
    "segs": [ {
      "utf8": "dàn shì nǐ xiǎng zhī dào\nbut you want to know"
    } ]
  }, {
    "tStartMs": 10400,
    "dDurationMs": 3999,
    "segs": [ {
      "utf8": "tā / tā shì shén me shí hòu zuò de zhè jiàn shì qíng\nwhen he/she did it"
    } ]
  }, {
    "tStartMs": 14433,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "tā / tā shì zài nǎ lǐ zuò de\nwhere he/she did it"
    } ]
  }, {
    "tStartMs": 17333,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "tā / tā shì hé shuí yì qǐ zuò de zhè jiàn shì qíng\nwho he/she did it with"
    } ]
  }, {
    "tStartMs": 21000,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "tā / tā shì zěn me zuò de zhè jiàn shì qíng\nhow he/she did it"
    } ]
  }, {
    "tStartMs": 24466,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "zhè ge shí hòu nǐ yào yòng\nthen you should use"
    } ]
  }, {
    "tStartMs": 26433,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "shì . . . . . . de\n\"shi......de\""
    } ]
  }, {
    "tStartMs": 29766,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "dà jiā hǎo wǒ shì xiǎo nà\nHello everyone, I'm Xiaona"
    } ]
  }, {
    "tStartMs": 32366,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "X i a o n i t a\nXiaonita"
    } ]
  }, {
    "tStartMs": 34133,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "jīn tiān\nToday"
    } ]
  }, {
    "tStartMs": 35000,
    "dDurationMs": 4699,
    "segs": [ {
      "utf8": "wǒ xiǎng hé nǐ yì qǐ liáo yí xià “ shì . . . . . . de ”\nI want to chat with you about \"shi...de\""
    } ]
  }, {
    "tStartMs": 40200,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "zhè ge yǔ fǎ\nthis grammar point"
    } ]
  }, {
    "tStartMs": 41233,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "dàn shì wǒ men bù liáo yǔ fǎ\nBut we won't talk grammar"
    } ]
  }, {
    "tStartMs": 44400,
    "dDurationMs": 5299,
    "segs": [ {
      "utf8": "wǒ xiǎng yòng hěn jiǎn dān de hěn zì rán de zhōng wén\nI want to use simple, natural Chinese"
    } ]
  }, {
    "tStartMs": 50000,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "gěi nǐ jiè shào yí xià zěn me yòng “ shì . . . . . . de ”\nto introduce how to use \"shi...de\""
    } ]
  }, {
    "tStartMs": 56033,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "xiàn zài ne wǒ yào jǔ yí gè lì zǐ\nNow, let me give an example"
    } ]
  }, {
    "tStartMs": 60300,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "wǒ yào gěi wǒ de hǎo péng yǒu tíng tíng dǎ diàn huà\nI'm going to call my good friend Tingting"
    } ]
  }, {
    "tStartMs": 66000,
    "dDurationMs": 6099,
    "segs": [ {
      "utf8": "rán hòu nǐ tīng yí xià wǒ hé tíng tíng de diàn huà\nSo listen to my phone call with Tingting"
    } ]
  }, {
    "tStartMs": 72633,
    "dDurationMs": 7333,
    "segs": [ {
      "utf8": "rán hòu nǐ kàn yí xià wǒ shì zěn me yòng “ shì . . . . . . de ” de\nThen watch how I use \"是......的\""
    } ]
  }, {
    "tStartMs": 80300,
    "dDurationMs": 1399,
    "segs": [ {
      "utf8": "zhǔn bèi hǎo le ma\nReady?"
    } ]
  }, {
    "tStartMs": 81833,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "hǎo de wǒ men kāi shǐ\nOkay, let's start"
    } ]
  }, {
    "tStartMs": 87166,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "wèi wèi tíng tíng\nHey hey, Tingting"
    } ]
  }, {
    "tStartMs": 91733,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "nǐ zài nǐ zài gān ma\nWhat are you up to?"
    } ]
  }, {
    "tStartMs": 94100,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "nǐ zài zuò shén me\nWhat are you doing?"
    } ]
  }, {
    "tStartMs": 96766,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "a xià bān le\nAh, off work now"
    } ]
  }, {
    "tStartMs": 98200,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "ǹg hǎo de\nMm, okay"
    } ]
  }, {
    "tStartMs": 101033,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "wǒ gěi nǐ dǎ diàn huà\nI'm calling you"
    } ]
  }, {
    "tStartMs": 103033,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "shì xiǎng zhī dào nǐ zhè zhōu mò yǒu shén me ān pái\nto see what your plans are for this weekend"
    } ]
  }, {
    "tStartMs": 108833,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "wǒ men yào bu yào jiàn gè miàn\nShould we meet up?"
    } ]
  }, {
    "tStartMs": 113566,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "a nǐ bú zài běi jīng\nOh, you're not in Beijing?"
    } ]
  }, {
    "tStartMs": 118333,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "ò\nOh."
    } ]
  }, {
    "tStartMs": 120766,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "nǐ chū qù wán le\nYou went out to travel?"
    } ]
  }, {
    "tStartMs": 124166,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "a\nAh."
    } ]
  }, {
    "tStartMs": 126933,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "nǐ qù guǎng zhōu le\nYou went to Guangzhou?"
    } ]
  }, {
    "tStartMs": 129033,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "ò\nOh."
    } ]
  }, {
    "tStartMs": 131566,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "nǐ nǐ shì shén me shí hòu qù de guǎng zhōu\nWhen did you go to Guangzhou?"
    } ]
  }, {
    "tStartMs": 137500,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "a\nHuh?"
    } ]
  }, {
    "tStartMs": 139300,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "zuó tiān\nYesterday."
    } ]
  }, {
    "tStartMs": 141366,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "a\nAh"
    } ]
  }, {
    "tStartMs": 142933,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "nǐ shì zuó tiān qù de guǎng zhōu\nYou went to Guangzhou yesterday"
    } ]
  }, {
    "tStartMs": 145800,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "wǒ hái yǐ wéi nǐ zài běi jīng ne\nI thought you were in Beijing"
    } ]
  }, {
    "tStartMs": 149400,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "nà nǐ shì nǐ shì zěn me qù de\nSo how did you get there"
    } ]
  }, {
    "tStartMs": 152633,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "nǐ shì zěn me qù de guǎng zhōu\nHow did you get to Guangzhou"
    } ]
  }, {
    "tStartMs": 158033,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "shì zuò huǒ chē ma\nBy train?"
    } ]
  }, {
    "tStartMs": 160000,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "ò   bú shì zuò huǒ chē qù de\nOh, not by train"
    } ]
  }, {
    "tStartMs": 163400,
    "dDurationMs": 5399,
    "segs": [ {
      "utf8": "duì   zuò huǒ chē tài yuǎn le\nRight, the train is too far"
    } ]
  }, {
    "tStartMs": 169400,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "nǐ shì zuò fēi jī qù de\nYou flew there"
    } ]
  }, {
    "tStartMs": 172566,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "ǹg duì duì duì\nYeah, yeah, yeah"
    } ]
  }, {
    "tStartMs": 174733,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "zuò fēi jī hái xíng\nThe flight was okay"
    } ]
  }, {
    "tStartMs": 177966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "nà nǐ zuò le duō jiǔ de fēi jī\nHow long was the flight"
    } ]
  }, {
    "tStartMs": 183500,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "sān gè bàn xiǎo shí   ǹg   hěn yuǎn\nThree and a half hours, yeah, quite far"
    } ]
  }, {
    "tStartMs": 187200,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "nà nǐ hé shuí yì qǐ qù de\nWho did you go with"
    } ]
  }, {
    "tStartMs": 191033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "nǐ zì jǐ ma\nJust yourself"
    } ]
  }, {
    "tStartMs": 193500,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "bú shì   nǐ bú shì yí gè rén qù de\nNo, you didn't go alone"
    } ]
  }, {
    "tStartMs": 197133,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "nǐ shì hé nǐ lǎo gōng yì qǐ qù de\nYou went with your husband"
    } ]
  }, {
    "tStartMs": 201000,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "hěn hǎo\nThat's nice"
    } ]
  }, {
    "tStartMs": 202600,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "duì duì duì shì de\nYeah, yeah, that's right"
    } ]
  }, {
    "tStartMs": 205566,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "liǎng gè rén yì qǐ wán gèng yǒu yì sī\nIt's more fun together"
    } ]
  }, {
    "tStartMs": 208966,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "ǹg\nYeah"
    } ]
  }, {
    "tStartMs": 213000,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "nà\nSo"
    } ]
  }, {
    "tStartMs": 217833,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "kě yǐ kě yǐ méi yǒu wèn tí\nSure, sure, no problem"
    } ]
  }, {
    "tStartMs": 219600,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "nà děng nǐ huí běi jīng yǐ hòu wǒ men zài yuē\nThen we'll meet up again after you're back in Beijing"
    } ]
  }, {
    "tStartMs": 224966,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "kě yǐ de méi yǒu wèn tí\nSure, no problem"
    } ]
  }, {
    "tStartMs": 227800,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "nà nǐ men zài guǎng zhōu hǎo hǎo wán\nHave a great time in Guangzhou"
    } ]
  }, {
    "tStartMs": 230733,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "hǎo de   nà wǒ men huí tóu zài liáo\nOkay, let's catch up later"
    } ]
  }, {
    "tStartMs": 235000,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "kě yǐ   huí tóu wǒ men zài yuē\nSure, we'll set it up later"
    } ]
  }, {
    "tStartMs": 237033,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "hǎo de   bài bài zài jiàn\nOkay, bye, see you"
    } ]
  }, {
    "tStartMs": 242133,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "nǐ tīng dào le ma\nDid you hear that?"
    } ]
  }, {
    "tStartMs": 243566,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "yīn wèi wǒ de péng yǒu\nBecause my friend"
    } ]
  }, {
    "tStartMs": 246700,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "tíng tíng tā yǐ jīng qù le guǎng zhōu\nTingting has already gone to Guangzhou"
    } ]
  }, {
    "tStartMs": 251133,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "tā gēn wǒ shuō tā qù guǎng zhōu wán le\nShe told me she went to Guangzhou for fun"
    } ]
  }, {
    "tStartMs": 255066,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "suǒ yǐ rú guǒ wǒ xiǎng zhī dào\nSo if I want to know"
    } ]
  }, {
    "tStartMs": 258066,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "tā shì shén me shí hòu qù de guǎng zhōu\nWhen she went to Guangzhou"
    } ]
  }, {
    "tStartMs": 261766,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "tā shì zěn me qù de guǎng zhōu\nHow she went to Guangzhou"
    } ]
  }, {
