    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "wā nǐ de zhōng wén hǎo bàng a\nWow, your Chinese is amazing"
    } ]
  }, {
    "tStartMs": 330733,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "nǐ de zhōng wén shuō dé hěn hǎo\nYou speak Chinese very well"
    } ]
  }, {
    "tStartMs": 334400,
    "dDurationMs": 7699,
    "segs": [ {
      "utf8": "nǐ shì cóng shén me shí hòu kāi shǐ xué de zhōng wén\nWhen did you start learning Chinese?"
    } ]
  }, {
    "tStartMs": 344966,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "nǐ shì cóng 2 0 2 4 nián\nDid you start in 2024?"
    } ]
  }, {
    "tStartMs": 350100,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "nǐ shì cóng liǎng nián qián kāi shǐ xué de zhōng wén\nYou started learning Chinese two years ago."
    } ]
  }, {
    "tStartMs": 354366,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "nǐ jué de zhōng wén nán ma\nDo you find Chinese difficult?"
    } ]
  }, {
    "tStartMs": 359600,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "duì   yǒu diǎn nán   shì de\nYeah, it's a bit hard, yes."
    } ]
  }, {
    "tStartMs": 361766,
    "dDurationMs": 5167,
    "segs": [ {
