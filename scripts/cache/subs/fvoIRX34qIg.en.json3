    "segs": [ {
      "utf8": "tā shì hé shuí yì qǐ qù de guǎng zhōu\nWho she went to Guangzhou with"
    } ]
  }, {
    "tStartMs": 267900,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "nà wǒ huì yòng “ shì . . . . . . de ”\nThen I would use \"shi...de\""
    } ]
  }, {
    "tStartMs": 271600,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "yīn wèi zhè shì guò qù de shì qíng\nBecause this is something in the past"
    } ]
  }, {
    "tStartMs": 275133,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "wǒ xiǎng zhī dào\nI want to know"
    } ]
  }, {
    "tStartMs": 276966,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "gèng duō de xìn xī\nMore information"
    } ]
  }, {
    "tStartMs": 279300,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "suǒ yǐ wǒ huì yòng “ shì . . . . . . de ”\nSo I'll use \"shi...de\""
    } ]
  }, {
    "tStartMs": 283700,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "hǎo xiàn zài ne\nOkay, now then"
    } ]
  }, {
    "tStartMs": 285033,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "wǒ men jǔ lìng wài yí gè lì zǐ\nLet's take another example"
    } ]
  }, {
    "tStartMs": 289233,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "bǐ rú nǐ\nFor instance, you"
    } ]
  }, {
    "tStartMs": 291933,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "nǐ zài xué zhōng wén   duì ba\nYou're learning Chinese, right"
    } ]
  }, {
    "tStartMs": 295700,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "rú guǒ nǐ lái le zhōng guó\nIf you come to China"
    } ]
  }, {
    "tStartMs": 298400,
    "dDurationMs": 4299,
    "segs": [ {
      "utf8": "nà nǐ huì yù dào hěn duō zhōng guó rén\nYou'll meet many Chinese people"
    } ]
  }, {
    "tStartMs": 302733,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "tā men huì gēn nǐ liáo tiān\nThey'll chat with you"
    } ]
  }, {
    "tStartMs": 305433,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "xiàn zài\nNow"
    } ]
  }, {
    "tStartMs": 306966,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "wǒ men jiù jiǎ shè\nLet's just say"
    } ]
  }, {
    "tStartMs": 309600,
    "dDurationMs": 2533,
    "segs": [ {
