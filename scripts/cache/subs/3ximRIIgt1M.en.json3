  }, {
    "tStartMs": 470033,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "Warm up before exercising"
    } ]
  }, {
    "tStartMs": 474333,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Look what I brought"
