  }, {
    "tStartMs": 426566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "yīn wèi wǒ jiā lǐ yǒu yí gè kā fēi jī\n因 为 我 家 里 有 一 个 咖 啡 机\nbecause I have a coffee maker at home,"
    } ]
  }, {
    "tStartMs": 428566,
    "dDurationMs": 1834,
    "segs": [ {
