  }, {
    "tStartMs": 383533,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Wǒ jiù hěn xǐhuan dào hǎibiān\n我就很喜欢到海边\nI just love going to the beach"
    } ]
  }, {
    "tStartMs": 385900,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Yī gè rén dào hǎibiān a\n一个人到海边啊\nGoing to the beach by myself"
