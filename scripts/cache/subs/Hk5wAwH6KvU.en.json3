  }, {
    "tStartMs": 437133,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Hāhāhā hǎo xīngfèn a\n哈哈哈好兴奋啊\nHahaha, I'm so excited"
    } ]
  }, {
    "tStartMs": 440100,
    "dDurationMs": 2566,
    "segs": [ {
