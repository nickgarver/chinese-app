  }, {
    "tStartMs": 409366,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "Kěyǐ bāng wǒmen qù jiǎnqīng hěnduō de yālì\n可以帮我们去减轻很多的压力\nIt can help us relieve a lot of stress"
    } ]
  }, {
    "tStartMs": 412666,
    "dDurationMs": 2867,
    "segs": [ {
