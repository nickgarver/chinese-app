  "events": [ {
    "tStartMs": 7200,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Hāi péngyǒumen\n嗨朋友们\nHey guys"
    } ]
  }, {
    "tStartMs": 8166,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Wǒ shì Mini\n我是Mini\nI'm Mini"
    } ]
  }, {
    "tStartMs": 9166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Huānyíng nǐ lái dào wǒ de píndào\n欢迎你来到我的频道\nWelcome to my channel"
    } ]
  }, {
    "tStartMs": 11400,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "Jīntiān zhè qī jiémù ne\n今天这期节目呢\nSo in today's episode"
    } ]
  }, {
    "tStartMs": 12833,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "Zánmen yīkuàir zài Wēngēhuá de\n咱们一块在温哥华的\nwe're going to take a walk together"
    } ]
  }, {
    "tStartMs": 16066,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "bàngwǎn shífēn chūlái zǒu yī zǒu sàn sàn bù\n傍晚时分出来走一走散散步\naround Vancouver in the evening"
    } ]
  }, {
    "tStartMs": 20200,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "Yībiān sànbù ne\n一边散步呢\nWhile we're walking"
    } ]
  }, {
    "tStartMs": 21466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "yībiān liáo liáo tiān\n一边聊聊天\nwe can chat a bit"
    } ]
  }, {
    "tStartMs": 23166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "Hāhāhā nǐmen kàn\n哈哈哈你们看\nHahaha look at this"
    } ]
  }, {
    "tStartMs": 25933,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Zhèlǐ yǒu yī zhī niú\n这里有一只牛\nThere's a cow here"
    } ]
  }, {
    "tStartMs": 28033,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Ó bùshì yī zhī o\n哦不是一只哦\nOh wait, not just one"
    } ]
  }, {
    "tStartMs": 29266,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Shì hǎo jǐ zhī\n是好几只\nThere are several"
    } ]
  }, {
    "tStartMs": 33166,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Xiànzài shì wǎnshàng liù diǎn duō nǐmen kàn\n现在是晚上6点多你们看\nIt's just past 6 p.m. now, look"
    } ]
  }, {
    "tStartMs": 36600,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "Tàiyáng kuàiyào luòshān le\n太阳快要落山了\nThe sun is about to set"
    } ]
  }, {
    "tStartMs": 38733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Zhège shì xīyáng xīyáng\n这个是夕阳夕阳\nThis is the sunset, the sunset"
    } ]
  }, {
    "tStartMs": 41766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "À\n啊\nAh"
    } ]
  }, {
    "tStartMs": 43233,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "Bàngwǎn shífēn jǐngsè yě hěn měi\n傍晚时分景色也很美\nThe scenery in the evening is really beautiful too"
    } ]
  }, {
    "tStartMs": 47133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ńg\n嗯\nMm"
    } ]
  }, {
    "tStartMs": 48366,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Háishì néng wén dào nàge niú de wèidào hāhāhā\n还是能闻到那个牛的味道哈哈哈\nI can still smell the cows hahaha"
    } ]
  }, {
    "tStartMs": 52200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "Yīnwèi gāngcái guòqù nàbiān yǒu hǎo duō zhī niú\n因为刚才过去那边有好多只牛\nBecause we just passed by a bunch of cows over there"
    } ]
  }, {
    "tStartMs": 55766,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Ránhòu yǒu yī gǔ niúfèn de wèidào hāhāhā\n然后有一股牛粪的味道哈哈哈\nAnd there's a smell of cow manure hahaha"
    } ]
  }, {
    "tStartMs": 60266,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "Wā zhège wèidào\n哇这个味道\nWow, that smell"
    } ]
  }, {
    "tStartMs": 61966,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Ńg bù tài hǎo wén\n嗯不太好闻\nMm, not great"
    } ]
  }, {
    "tStartMs": 63933,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "Xiànzài shì jiǔ yuèfèn le qiūtiān le\n现在是9月份了秋天了\nIt's September now, it's autumn"
    } ]
  }, {
    "tStartMs": 66933,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "Ńg nǐmen nàbiān de tiānqì zěnmeyàng ne\n嗯你们那边的天气怎么样呢\nMm, how's the weather where you are?"
    } ]
  }, {
    "tStartMs": 69633,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "Shì bùshì yě kāishǐ biàn lěng le\n是不是也开始变冷了\nHas it started getting cold there too?"
    } ]
  }, {
    "tStartMs": 73533,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Wēngēhuá yě shì zhèyàng\n温哥华也是这样\nVancouver's the same"
    } ]
  }, {
    "tStartMs": 74833,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Xiànzài Wēngēhuá de zǎochén hé wǎnshàng dōu hěn lěng\n现在温哥华的早晨和晚上都很冷\nRight now mornings and evenings in Vancouver are pretty cold"
    } ]
  }, {
    "tStartMs": 79733,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Xūyào chuān wàitào\n需要穿外套\nYou need to wear a jacket"
    } ]
  }, {
    "tStartMs": 81933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Bǐrú shuō xiàng wǒ xiànzài zhè jiàn\n比如说像我现在这件\nLike the one I'm wearing right now"
    } ]
  }, {
    "tStartMs": 84566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Wǒ jīntiān ne chuān le yī gè\n我今天呢穿了一个\nToday I'm wearing a"
    } ]
  }, {
    "tStartMs": 86133,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "zhège shì chōngfēngyī chōngfēngyī\n这个是冲锋衣冲锋衣\nthis is a windbreaker, a windbreaker"
    } ]
  }, {
    "tStartMs": 89400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Zhè zhǒng chōngfēngyī zài Wēngēhuá\n这种冲锋衣在温哥华\nThis kind of jacket in Vancouver"
    } ]
  }, {
    "tStartMs": 91133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "zhèlǐ chuān jiù fēicháng héshì\n这里穿就非常合适\nis perfect to wear here"
    } ]
  }, {
    "tStartMs": 93866,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Tā ne bùjǐn kěyǐ fáng fēng fáng fēng\n它呢不仅可以防风防风\nIt's not only windproof, windproof"
    } ]
  }, {
    "tStartMs": 97566,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "érqiě hái fáng yǔ fáng yǔ\n而且还防雨防雨\nbut also waterproof, waterproof"
    } ]
  }, {
    "tStartMs": 100633,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "Ńg xiànzài chuān fēicháng de shūfu duì\n嗯现在穿非常的舒服对\nMm, it's really comfortable to wear right now, yeah"
    } ]
  }, {
    "tStartMs": 104633,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Ránhòu Wēngēhuá xiànzài de\n然后温哥华现在的\nAnd Vancouver's current"
    } ]
  }, {
    "tStartMs": 106433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "tiānqì jiùshì zǎowǎn bǐjiào liáng\n天气就是早晚比较凉\nweather is cool in the mornings and evenings"
    } ]
  }, {
    "tStartMs": 109266,
    "dDurationMs": 4534,
    "segs": [ {
      "utf8": "È xiàwǔ de shíhòu yǒu tàiyáng jiù huì hěn rè ňg\n呃下午的时候有太阳就会很热嗯\nUh, in the afternoon when the sun's out it gets pretty hot, mm"
    } ]
  }, {
    "tStartMs": 114266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "À xiànzài tàiyáng hái méi luòshān nǐmen kàn\n啊现在太阳还没落山你们看\nAh, the sun hasn't set yet, look"
    } ]
  }, {
    "tStartMs": 118666,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "Yángguāng sǎ zài wǒ de liǎn shàng\n阳光洒在我的脸上\nThe sunlight is on my face"
    } ]
  }, {
    "tStartMs": 121366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Háishì juéde hěn wēnnuǎn hāhāhā\n还是觉得很温暖哈哈哈\nIt still feels really warm hahaha"
    } ]
  }, {
    "tStartMs": 125200,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "Bàngwǎn de shíhòu ne sàn sàn bù a\n傍晚的时候呢散散步啊\nTaking a walk in the evening"
    } ]
  }, {
    "tStartMs": 128533,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "Gǎnjué jīntiān yī tiān gōngzuò de yālì dōu méiyǒu le\n感觉今天一天工作的压力都没有了\nmakes all the stress from the day just melt away"
    } ]
  }, {
    "tStartMs": 133600,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "Hěn shūfu hěn zìzài hěn qièyì\n很舒服很自在很惬意\nSo comfortable, so relaxed, so nice"
    } ]
  }, {
    "tStartMs": 137833,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "Ńg gānggāng wǒ shuō de zhè sān gè cí\n嗯刚刚我说的这三个词\nMm, these three words I just said"
    } ]
  }, {
    "tStartMs": 140800,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "Kěyǐ xíngróng wǒmen xīnqíng rúhé\n可以形容我们心情如何\ncan describe how we're feeling"
    } ]
  }, {
    "tStartMs": 144400,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Shūfu zìzài qièyì\n舒服自在惬意\nComfortable, relaxed, nice"
    } ]
  }, {
    "tStartMs": 148033,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Zhè sān gè cí jīngcháng shǐyòng o\n这3个词经常使用哦\nThese three words are used all the time"
    } ]
  }, {
    "tStartMs": 149733,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Nǐmen kěyǐ jìzhù tāmen\n你们可以记住它们\nYou guys can memorize them"
    } ]
  }, {
    "tStartMs": 152566,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Wā nǐmen kàn xīyáng duō měi a\n哇你们看夕阳多美啊\nWow, look how beautiful the sunset is"
    } ]
  }, {
    "tStartMs": 158000,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "Tīng dào le ma\n听到了吗\nDid you hear that?"
    } ]
  }, {
    "tStartMs": 158866,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "Niú zài jiào hāhāhā\n牛在叫哈哈哈\nThe cows are mooing hahaha"
    } ]
  }, {
    "tStartMs": 161933,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Ránhòu zhèlǐ ne\n然后这里呢\nAnd over here"
    } ]
  }, {
    "tStartMs": 162833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "Yǒu hěnduō zhèyàng de xiǎo huā nǐmen kàn\n有很多这样的小花你们看\nthere are lots of little flowers like this, look"
    } ]
  }, {
    "tStartMs": 166133,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Zhège shì huā\n这个是花\nThis is a flower"
    } ]
  }, {
    "tStartMs": 168266,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "Xiǎo huā hāhā\n小花哈哈\nLittle flower haha"
    } ]
  }, {
    "tStartMs": 170333,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Hǎo piàoliang o\n好漂亮哦\nSo pretty"
    } ]
  }, {
    "tStartMs": 173566,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "Hòumiàn hái yǒu hěnduō de cǎo cǎo\n后面还有很多的草草\nAnd there's lots of grass behind, grass"
    } ]
  }, {
    "tStartMs": 178066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Nà wǒ xiànzài ne\n那我现在呢\nSo right now"
    } ]
  }, {
    "tStartMs": 179333,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Jiù yánzhe zhè tiáo hǎi'ànxiàn nǐmen kàn\n就沿着这条海岸线你们看\nI'm just walking along this coastline, look"
    } ]
  }, {
    "tStartMs": 183933,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Nàbiān shì dàhǎi\n那边是大海\nThe ocean's over there"
    } ]
  }, {
    "tStartMs": 185166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Ránhòu yánzhe zhè tiáo hǎi'ànxiàn\n然后沿着这条海岸线\nAnd along this coastline"
    } ]
  }, {
    "tStartMs": 188066,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Wǒmen yīzhí wǎng qián zǒu wǎng qián zǒu\n我们一直往前走往前走\nwe just keep walking forward, keep going"
    } ]
  }, {
    "tStartMs": 191733,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "Zǒu dào hǎibiān qù ňg\n走到海边去嗯\nall the way to the beach, mm"
    } ]
  }, {
    "tStartMs": 196433,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "Dàgài jùlí yǒu liǎng sān gōnglǐ zuǒyòu ba\n大概距离有两三公里左右吧\nIt's probably about two or three kilometers"
    } ]
  }, {
    "tStartMs": 201833,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "Qíshí zhèyàng mànman zǒu guòqù yě hěn kuài ňg\n其实这样慢慢走过去也很快嗯\nActually walking there slowly doesn't take that long, mm"
    } ]
  }, {
    "tStartMs": 208066,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Zhège jùlí de huà\n这个距离的话\nFor this distance"
    } ]
  }, {
    "tStartMs": 209333,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Qí zìxíngchē shì zuì hǎo de\n骑自行车是最好的\nbiking is the best way"
    } ]
  }, {
    "tStartMs": 212266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "Nǐ huì kàndào hěnduō qí zìxíngchē de rén duì\n你会看到很多骑自行车的人对\nYou'll see lots of people biking, yeah"
    } ]
  }, {
    "tStartMs": 216766,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "À wǒ juéde zhèbiān de fángzi zhēn de hěn hǎo āi\n啊我觉得这边的房子真的很好哎\nAh, I think the houses here are really nice"
    } ]
  }, {
    "tStartMs": 221633,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Zhèxiē shì fángzi fángzi\n这些是房子房子\nThese are houses, houses"
    } ]
  }, {
    "tStartMs": 224533,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Nà zhù zài zhèlǐ ne\n那住在这里呢\nSo if you live here"
    } ]
  }, {
    "tStartMs": 226400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "Duìmiàn ó nǐ kàn zhège fángzi de duìmiàn\n对面哦你看这个房子的对面\nAcross the street, oh look, right across from this house"
    } ]
  }, {
    "tStartMs": 229966,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "Jiùshì zhème měihǎo de fēngjǐng\n就是这么美好的风景\nthere's just this gorgeous view"
    } ]
  }, {
    "tStartMs": 232400,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "Yuǎnchù jiùshì hǎibiān\n远处就是海边\nThe beach is right there in the distance"
    } ]
  }, {
    "tStartMs": 234833,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Wǒ yàoshi néng zhù zài zhèlǐ gāi duō hǎo\n我要是能住在这里该多好\nI wish I could live here"
    } ]
  }, {
    "tStartMs": 239366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Wǒ juéde zhù zài zhè fēngjǐng zhēn de hěn hǎo\n我觉得住在这风景真的很好\nI think living here, the scenery is really amazing"
    } ]
  }, {
    "tStartMs": 242400,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "Měitiān dōu kěyǐ kànzhe xīyáng kàn rìchū\n每天都可以看着夕阳看日出\nYou could watch the sunset and sunrise every day"
    } ]
  }, {
    "tStartMs": 246966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Hēhē duì\n呵呵对\nHehe, yeah"
    } ]
  }, {
    "tStartMs": 248166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Wǒ jiāo nǐmen zhège cí hā\n我教你们这个词哈\nLet me teach you guys this word"
    } ]
  }, {
    "tStartMs": 249866,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "Xiànzài de shíjiān\n现在的时间\nRight now"
    } ]
  }, {
    "tStartMs": 251133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "Bàngwǎn shífēn ma\n傍晚时分嘛\nit's evening"
    } ]
  }, {
    "tStartMs": 252633,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Ránhòu zhège luòrì ne\n然后这个落日呢\nAnd this sunset"
    } ]
  }, {
    "tStartMs": 254666,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "Jiàozuò xīyáng xīyáng\n叫做夕阳夕阳\nis called \"xīyáng,\" sunset"
    } ]
  }, {
    "tStartMs": 257366,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "Ránhòu zǎochén de shíhòu\n然后早晨的时候\nAnd in the morning"
    } ]
  }, {
    "tStartMs": 259233,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Tàiyáng gāng chūlái de\n太阳刚出来的\nwhen the sun just comes up"
    } ]
  }, {
    "tStartMs": 260466,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "Nàge jiào rìchū rìchū ňg\n那个叫日出日出嗯\nthat's called \"rìchū,\" sunrise, mm"
    } ]
  }, {
    "tStartMs": 264600,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "Zhèlǐ yǒu liǎng gè chángyǐ liǎng gè chángyǐ\n这里有两个长椅两个长椅\nThere are two benches here, two benches"
    } ]
  }, {
    "tStartMs": 268833,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Kěyǐ zuò zài zhè xiūxi kàn fēngjǐng\n可以坐在这休息看风景\nYou can sit here and relax and enjoy the view"
    } ]
  }, {
    "tStartMs": 273666,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "Wǒ juéde bàngwǎn shífēn\n我觉得傍晚时分\nI think in the evening"
    } ]
  }, {
    "tStartMs": 275766,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "Zhège shíhòu de guāng hěn róuhé róuhé nǐmen kàn\n这个时候的光很柔和柔和你们看\nthe light at this time is really soft, soft, look"
    } ]
  }, {
    "tStartMs": 280833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Jiùshì dǎ zài rén de liǎn shàng\n就是打在人的脸上\nIt just hits your face"
    } ]
  }, {
    "tStartMs": 283366,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Gǎnjué fēicháng piàoliang\n感觉非常漂亮\nand looks really beautiful"
    } ]
  }, {
    "tStartMs": 285633,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "Hěn zìrán ňg\n很自然嗯\nVery natural, mm"
    } ]
  }, {
    "tStartMs": 288633,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Bùguò ne yīnwèi shì hǎibiān de yuányīn ba\n不过呢因为是海边的原因吧\nBut since it's by the beach"
    } ]
  }, {
    "tStartMs": 291933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "Chóngzi háishì hěnduō de\n虫子还是很多的\nthere are still lots of bugs"
    } ]
  }, {
    "tStartMs": 293766,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "Wǒ hěn pà chóngzi\n我很怕虫子\nI'm really scared of bugs"
    } ]
  }, {
    "tStartMs": 295466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Yóuqí shì wénzi\n尤其是蚊子\nEspecially mosquitoes"
    } ]
  }, {
    "tStartMs": 297533,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "Zhīqián ne shàng gè yuè bùshì yǒu wénzi bǎ\n之前呢上个月不是有蚊子把\nRemember last month a mosquito"
    } ]
  }, {
    "tStartMs": 300800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Wǒ de yǎnjing yǎo zhǒng le ma\n我的眼睛咬肿了吗\nbit my eye and made it swell up?"
    } ]
  }, {
    "tStartMs": 302733,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Dāngshí zhǒng de hěn lìhài o\n当时肿的很厉害哦\nIt swelled up really bad"
    } ]
  }, {
    "tStartMs": 305466,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "Érqiě hěn tòngkǔ hěn nánshòu a\n而且很痛苦很难受啊\nAnd it was really painful and awful"
    } ]
  }, {
    "tStartMs": 309400,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "Gānggāng zǒu guòlái de shíhòu yě yǒu chóngzi zài zhè fēi\n刚刚走过来的时候也有虫子在这飞\nJust now when I was walking over here there were bugs flying around"
    } ]
  }, {
    "tStartMs": 312466,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Āiyōu hǎo pà\n哎呦好怕\nUgh, so scary"
    } ]
  }, {
    "tStartMs": 314833,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Wā fàngyǎn wàng qù o\n哇放眼望去哦\nWow, looking out"
    } ]
  }, {
    "tStartMs": 317766,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Zhèlǐ ne shì yī piàn de lǜsè\n这里呢是一片的绿色\nthis whole area is green"
    } ]
  }, {
    "tStartMs": 320666,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "Lǜsè de cǎo\n绿色的草\nGreen grass"
    } ]
  }, {
    "tStartMs": 322466,
    "dDurationMs": 5334,
    "segs": [ {
      "utf8": "Ránhòu yuǎnchù ne shì jīnhuángsè de tàiyáng jīnhuángsè\n然后远处呢是金黄色的太阳金黄色\nAnd in the distance there's the golden sun, golden"
    } ]
  }, {
    "tStartMs": 327800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "Wā nǐmen kàn\n哇你们看\nWow, look"
    } ]
  }, {
    "tStartMs": 328533,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Mǎshàng jiù yào xiàshān lou\n马上就要下山喽\nIt's about to go down"
