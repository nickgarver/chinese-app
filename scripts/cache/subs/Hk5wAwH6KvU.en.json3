  }, {
    "tStartMs": 348366,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "Tiānsè tiānsè àn xiàlái le àn\n天色天色暗下来了暗\nIt's getting dark, getting dark"
    } ]
  }, {
    "tStartMs": 351833,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "Wǒmen kuài zǒu liǎng bù kuài zǒu\n我们快走两步快走\nLet's walk a bit faster, come on"
    } ]
  }, {
    "tStartMs": 355466,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Yīzhí wǎng qián zǒu qù hǎibiān\n一直往前走去海边\nKeep walking straight ahead to the beach"
    } ]
  }, {
    "tStartMs": 359200,
    "dDurationMs": 4966,
    "segs": [ {
      "utf8": "Kàn zhèlǐ yǒu yī gè zhǐshìpái zhǐshìpái\n看这里有一个指示牌指示牌\nLook, there's a sign here, a sign"
    } ]
  }, {
    "tStartMs": 364166,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "Yīzhí wǎng qián zǒu wǎng qián zǒu\n一直往前走往前走\nKeep going straight, keep going"
    } ]
  }, {
    "tStartMs": 369733,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Wǒ qíshí hěn xǐhuan kàn hǎi\n我其实很喜欢看海\nI actually really love looking at the ocean"
    } ]
  }, {
    "tStartMs": 372500,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "Yóuqí shì dāng nǐ gǎnjué xīnqíng bù hǎo de shíhòu\n尤其是当你感觉心情不好的时候\nEspecially when you're feeling down"
    } ]
  }, {
    "tStartMs": 376366,
    "dDurationMs": 2834,
    "segs": [ {
