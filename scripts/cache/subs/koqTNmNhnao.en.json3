  }, {
    "tStartMs": 309800,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Oh wow."
    } ]
  }, {
    "tStartMs": 310300,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "That's the honey."
    } ]
  }, {
    "tStartMs": 311199,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "How do you lick it?"
    } ]
  }, {
    "tStartMs": 312966,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "Hahaha."
    } ]
  }, {
    "tStartMs": 314933,
    "dDurationMs": 200,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 315133,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "This treats lungs and cancer and things like that."
    } ]
  }, {
    "tStartMs": 317399,
    "dDurationMs": 401,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 317800,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "This, this—"
    } ]
  }, {
    "tStartMs": 318533,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "Very sweet, very sweet."
    } ]
  }, {
    "tStartMs": 319966,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "How far do you have to go?"
    } ]
  }, {
    "tStartMs": 321300,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "He lives—he lives—"
    } ]
  }, {
    "tStartMs": 324000,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "He lives over there."
    } ]
  }, {
    "tStartMs": 326366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "Sometimes it's close."
    } ]
  }, {
    "tStartMs": 328333,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "You walk a few steps and you find some. Also,"
    } ]
  }, {
    "tStartMs": 330566,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "sometimes you search"
    } ]
  }, {
    "tStartMs": 332333,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "all day and don't find a single one."
    } ]
  }, {
    "tStartMs": 334366,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Try one."
    } ]
  }, {
    "tStartMs": 335066,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Try the half-red plum."
    } ]
  }, {
    "tStartMs": 336199,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "Half-red plum, good."
    } ]
  }, {
    "tStartMs": 337133,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "This is half-red plum."
    } ]
  }, {
    "tStartMs": 343333,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "Quite tasty."
    } ]
  }, {
    "tStartMs": 344100,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "Quite tasty."
    } ]
  }, {
    "tStartMs": 344866,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "High water content?"
    } ]
  }, {
    "tStartMs": 345600,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "High altitude."
    } ]
  }, {
    "tStartMs": 346333,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "The altitude is about—"
    } ]
  }, {
    "tStartMs": 347366,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It reaches over two thousand meters here."
    } ]
  }, {
    "tStartMs": 349899,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Weigh out a catty for me."
    } ]
  }, {
    "tStartMs": 351399,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Okay?"
    } ]
  }, {
    "tStartMs": 352266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Sure."
    } ]
  }, {
    "tStartMs": 353399,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "These are our local cured meats."
    } ]
  }, {
    "tStartMs": 355600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Hahaha."
    } ]
  }, {
    "tStartMs": 356600,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "Local hind-leg meat."
    } ]
  }, {
    "tStartMs": 359166,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Smells good."
    } ]
  }, {
    "tStartMs": 361066,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "Local peaches."
    } ]
  }, {
    "tStartMs": 362766,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "The peach."
    } ]
  }, {
    "tStartMs": 364566,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "This is our local cured meat."
    } ]
  }, {
    "tStartMs": 367133,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Ham meat cured for the New Year."
    } ]
  }, {
    "tStartMs": 369300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I'll give you a gift."
    } ]
  }, {
    "tStartMs": 371366,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Mm, okay."
    } ]
  }, {
    "tStartMs": 373366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Wow, what is this?"
    } ]
  }, {
    "tStartMs": 374800,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Fig."
    } ]
  }, {
    "tStartMs": 375866,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Is this really a fig?"
    } ]
  }, {
    "tStartMs": 377166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 378266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "What the heck!"
    } ]
  }, {
    "tStartMs": 379566,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Can I eat this fig?"
    } ]
  }, {
    "tStartMs": 381166,
    "dDurationMs": 334,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 381500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "You can eat it."
    } ]
  }, {
    "tStartMs": 382600,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "There are two kinds."
    } ]
  }, {
    "tStartMs": 384066,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "One is soft,"
    } ]
  }, {
    "tStartMs": 384800,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "and one is firm."
    } ]
  }, {
    "tStartMs": 385666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 387199,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "So you just eat it like this, right? Wow."
    } ]
  }, {
    "tStartMs": 392666,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Locals call it \"Da-ma-lu.\""
    } ]
  }, {
    "tStartMs": 394133,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Da-ma-lu."
    } ]
  }, {
    "tStartMs": 395266,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Da-ma-lu."
    } ]
  }, {
    "tStartMs": 396199,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Da-mao-lu."
    } ]
  }, {
    "tStartMs": 397133,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "Actually, they call it \"Ma-lu\" fruit."
    } ]
  }, {
    "tStartMs": 398366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ma-lu fruit."
    } ]
  }, {
    "tStartMs": 399166,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "It's wild."
    } ]
  }, {
    "tStartMs": 400966,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "Wow."
    } ]
  }, {
    "tStartMs": 401600,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "As for its benefits,"
    } ]
  }, {
    "tStartMs": 402300,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "men should eat more of it."
    } ]
  }, {
    "tStartMs": 404333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 405399,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "It's good for men's health."
    } ]
  }, {
    "tStartMs": 406533,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "How is it good for a man's fertility?"
    } ]
  }, {
    "tStartMs": 411000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ha ha ha."
    } ]
  }, {
    "tStartMs": 411933,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "They told us that this is not fully ripe,"
    } ]
  }, {
    "tStartMs": 414366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "so it's not as good."
    } ]
  }, {
    "tStartMs": 415366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "But you see, it looks like a big fig."
    } ]
  }, {
    "tStartMs": 417300,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "There are lots of tiny seeds in it."
    } ]
  }, {
    "tStartMs": 420166,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "But this is definitely—"
    } ]
  }, {
    "tStartMs": 421733,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "it's the biggest fig I've ever seen."
    } ]
  }, {
    "tStartMs": 423366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 424533,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "Uh, they told me this is not fully ripe,"
    } ]
  }, {
    "tStartMs": 426699,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "so it's not as good."
    } ]
  }, {
    "tStartMs": 428500,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "If you see something like honey inside,"
    } ]
  }, {
    "tStartMs": 430666,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "then it means that it's good enough."
    } ]
  }, {
    "tStartMs": 434066,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "Hmm, so this is sweet—"
    } ]
  }, {
    "tStartMs": 436133,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "a little bit like fig."
    } ]
  }, {
    "tStartMs": 437733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And the guy is right:"
    } ]
  }, {
    "tStartMs": 438933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "it's not a hundred percent ready."
    } ]
  }, {
    "tStartMs": 441699,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Leaving the market behind,"
    } ]
  }, {
    "tStartMs": 442966,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "we continued climbing deeper"
    } ]
  }, {
    "tStartMs": 444266,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "into the mountains."
    } ]
  }, {
    "tStartMs": 445533,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The valley was still warm,"
    } ]
  }, {
    "tStartMs": 447333,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "but the higher we went,"
    } ]
  }, {
    "tStartMs": 448600,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "the colder the air became."
    } ]
  }, {
    "tStartMs": 456766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 471399,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hello."
    } ]
  }, {
    "tStartMs": 472199,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Hello."
    } ]
  }, {
    "tStartMs": 476466,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Entering the border management zone."
    } ]
  }, {
    "tStartMs": 481466,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "We're quite high right now."
    } ]
  }, {
    "tStartMs": 482966,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I can feel the temperature dropping."
    } ]
  }, {
    "tStartMs": 486300,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "It's even a bit chilly here."
    } ]
  }, {
    "tStartMs": 492566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "After passing a checkpoint,"
    } ]
  }, {
    "tStartMs": 493800,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "we drove another few dozen kilometers"
    } ]
  }, {
    "tStartMs": 495800,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "before finally reaching Pianma."
    } ]
  }, {
    "tStartMs": 498266,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "At first glance,"
    } ]
  }, {
    "tStartMs": 499266,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "it looks like an ordinary border town,"
    } ]
  }, {
    "tStartMs": 501800,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "but this quiet place"
    } ]
  }, {
    "tStartMs": 503166,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "witnessed one of the most"
    } ]
  }, {
    "tStartMs": 504966,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "dangerous aviation missions"
    } ]
  }, {
    "tStartMs": 506600,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "of the Second World War:"
    } ]
  }, {
    "tStartMs": 508066,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "the Hump route."
    } ]
  }, {
    "tStartMs": 510600,
    "dDurationMs": 3799,
    "segs": [ {
      "utf8": "The Hump airlift, 1942–1945."
    } ]
  }, {
    "tStartMs": 517733,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "Hey, I think many of you"
    } ]
  }, {
    "tStartMs": 519366,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "who are watching this video right now"
    } ]
  }, {
    "tStartMs": 521899,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "probably have never heard of"
    } ]
  }, {
    "tStartMs": 523933,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "the Hump air force operation."
    } ]
  }, {
    "tStartMs": 526166,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And even I only got to learn about this"
    } ]
  }, {
    "tStartMs": 529166,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "earlier this year,"
    } ]
  }, {
    "tStartMs": 530333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "when I came across"
    } ]
  }, {
    "tStartMs": 531666,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "a post on Xiaohongshu,"
    } ]
  }, {
    "tStartMs": 533100,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "uh, which I will talk about later."
    } ]
  }, {
    "tStartMs": 535500,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "But the Hump airlift was"
    } ]
  }, {
    "tStartMs": 537899,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "the most difficult and most epic"
    } ]
  }, {
    "tStartMs": 541766,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "airlift operation"
    } ]
  }, {
    "tStartMs": 543399,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "during the Second World War."
    } ]
  }, {
    "tStartMs": 545733,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "This is what the Hump route was actually like."
    } ]
  }, {
    "tStartMs": 548299,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "So it started from Assam in India,"
    } ]
  }, {
    "tStartMs": 550733,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "which is in northeast India,"
    } ]
  }, {
    "tStartMs": 552333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "over Myanmar to Kunming."
    } ]
  }, {
    "tStartMs": 554566,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And this happened because the Burma Road was"
    } ]
  }, {
    "tStartMs": 556666,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "closed by the Japanese"
    } ]
  }, {
    "tStartMs": 557566,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "in the Second World War."
    } ]
  }, {
    "tStartMs": 559266,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "And basically, the U.S. and China,"
    } ]
  }, {
    "tStartMs": 561700,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "back then,"
    } ]
  }, {
    "tStartMs": 562366,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "collaborated to provide important materials to"
    } ]
  }, {
    "tStartMs": 566600,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "Kunming, to Yunnan Province, to support the locals,"
    } ]
  }, {
    "tStartMs": 569700,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "because the Burma Road was closed."
    } ]
  }, {
    "tStartMs": 572066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And this mission was extremely dangerous"
    } ]
  }, {
    "tStartMs": 574066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "for the pilots,"
    } ]
  }, {
    "tStartMs": 574866,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "because back then"
    } ]
  }, {
    "tStartMs": 576100,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "there was no GPS."
    } ]
  }, {
    "tStartMs": 577733,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "All the navigation systems"
    } ]
  }, {
    "tStartMs": 579233,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "weren't as advanced as they are today."
    } ]
  }, {
    "tStartMs": 581533,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "So I think that's an animation,"
    } ]
  }, {
    "tStartMs": 583399,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "but this is kind of what it looked like."
    } ]
  }, {
    "tStartMs": 585100,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "And they named this Hump route"
    } ]
  }, {
    "tStartMs": 586766,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "because the hills in the"
    } ]
  }, {
    "tStartMs": 588466,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "eastern Himalayas"
    } ]
  }, {
    "tStartMs": 589466,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "look like humps from a camel."
    } ]
  }, {
    "tStartMs": 591600,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "And this is why they"
    } ]
  }, {
    "tStartMs": 592733,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "named it like this."
    } ]
  }, {
    "tStartMs": 593933,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "But unfortunately,"
    } ]
  }, {
    "tStartMs": 595333,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "many people died—"
    } ]
  }, {
    "tStartMs": 596366,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "I think fifteen hundred pilots"
    } ]
  }, {
    "tStartMs": 597899,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "lost their lives,"
    } ]
  }, {
    "tStartMs": 598600,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "and they crashed more than"
    } ]
  }, {
    "tStartMs": 599966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "five hundred airplanes."
    } ]
  }, {
    "tStartMs": 601766,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "The operation was so difficult"
    } ]
  }, {
    "tStartMs": 603700,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "and so many aircraft"
    } ]
  }, {
    "tStartMs": 605333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "were lost that later the pilots"
    } ]
  }, {
    "tStartMs": 607866,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "could navigate from the"
    } ]
  }, {
    "tStartMs": 609600,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "reflection of the crash planes in the valley."
    } ]
  }, {
    "tStartMs": 612700,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "So sometimes they also called the valley"
    } ]
  }, {
    "tStartMs": 615000,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "the \"Aluminum Valley.\""
    } ]
  }, {
    "tStartMs": 617899,
    "dDurationMs": 5201,
    "segs": [ {
      "utf8": "And among more than five hundred lost aircraft,"
    } ]
  }, {
    "tStartMs": 623466,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "this is perhaps"
    } ]
  }, {
    "tStartMs": 624700,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "the only one that they found almost complete."
    } ]
  }, {
    "tStartMs": 628666,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This one was found somewhere in Myanmar"
    } ]
  }, {
    "tStartMs": 631133,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and then brought back"
    } ]
  }, {
    "tStartMs": 634466,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "to China."
    } ]
  }, {
    "tStartMs": 635133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It's a Chinese aircraft."
    } ]
  }, {
    "tStartMs": 637933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "From here you can see—"
    } ]
  }, {
    "tStartMs": 640466,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "I think it's kind of some wreckage."
    } ]
  }, {
    "tStartMs": 644399,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "That's the fuel tank."
    } ]
  }, {
    "tStartMs": 649333,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Wow, crazy."
    } ]
  }, {
    "tStartMs": 655299,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "Yeah, and I think the rest of the plane"
    } ]
  }, {
    "tStartMs": 657033,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "they kind of rebuilt."
    } ]
  }, {
    "tStartMs": 658200,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "Its captain is an American guy from Texas."
    } ]
  }, {
    "tStartMs": 661733,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Together with him are two other Chinese—"
    } ]
  }, {
    "tStartMs": 664166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "one is a co-pilot,"
    } ]
  }, {
    "tStartMs": 666100,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "and the other is a radio operator."
    } ]
  }, {
    "tStartMs": 669100,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "They all lost their lives."
    } ]
  }, {
    "tStartMs": 671166,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "It's just insane."
    } ]
  }, {
    "tStartMs": 673066,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "Fascinating piece of history."
    } ]
  }, {
    "tStartMs": 675266,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "And those are the real pieces of the"
    } ]
  }, {
    "tStartMs": 678100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "crashed planes that they found."
    } ]
  }, {
    "tStartMs": 681133,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "Most of the pilots"
    } ]
  }, {
    "tStartMs": 682266,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "during that operation—"
    } ]
  }, {
    "tStartMs": 683799,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "I think they have already passed away,"
    } ]
  }, {
    "tStartMs": 685600,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "but there are a few"
    } ]
  }, {
    "tStartMs": 686799,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "who are still alive."
    } ]
  }, {
    "tStartMs": 688366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And among all of them, some"
    } ]
  }, {
    "tStartMs": 690866,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "uh, lived very long."
    } ]
  }, {
    "tStartMs": 692166,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "On this board, you will see all the airmen"
    } ]
  }, {
    "tStartMs": 694100,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "and also pilots who lost their lives."
    } ]
  }, {
    "tStartMs": 697500,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "And for those who survived the operation,"
    } ]
  }, {
    "tStartMs": 700799,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "I think if they're still alive right now,"
    } ]
  }, {
    "tStartMs": 703366,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "they must be over a hundred years old."
    } ]
  }, {
    "tStartMs": 705866,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "And among all the pilots,"
    } ]
  }, {
    "tStartMs": 707633,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "I read that there was one called"
    } ]
  }, {
    "tStartMs": 711033,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Peter Goutiere. In total,"
    } ]
  }, {
    "tStartMs": 713466,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "he flew six hundred and eighty times,"
    } ]
  }, {
    "tStartMs": 716899,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "and he passed away at the age"
    } ]
  }, {
    "tStartMs": 719500,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "of one hundred and eight."
    } ]
  }, {
    "tStartMs": 722200,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "And also earlier this year,"
    } ]
  }, {
    "tStartMs": 724066,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "I came across a post on Xiaohongshu."
    } ]
  }, {
    "tStartMs": 725833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So there was a Chinese girl"
    } ]
  }, {
    "tStartMs": 727933,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "who visited the house of an old pilot"
    } ]
  }, {
    "tStartMs": 730666,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "in the United States,"
    } ]
  }, {
    "tStartMs": 732500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and he turned out to be"
    } ]
  }, {
    "tStartMs": 734500,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "a member of the Hump operation."
    } ]
  }, {
    "tStartMs": 737700,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And I just did a screenshot here."
    } ]
  }, {
    "tStartMs": 740200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If you are watching this from the U.S.,"
    } ]
  }, {
    "tStartMs": 742833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "or if you know this guy,"
    } ]
  }, {
    "tStartMs": 745666,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "please send us your greetings, because"
    } ]
  }, {
    "tStartMs": 748633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "the Hump operation"
    } ]
  }, {
    "tStartMs": 750566,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "was extremely important"
    } ]
  }, {
    "tStartMs": 753000,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "at that time."
    } ]
  }, {
    "tStartMs": 754233,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "It was the lifeline that"
    } ]
  }, {
    "tStartMs": 756299,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "kept China in the war against Japan."
    } ]
  }, {
    "tStartMs": 759466,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "We are at the border now,"
    } ]
  }, {
    "tStartMs": 760666,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "and unfortunately,"
    } ]
  }, {
    "tStartMs": 761799,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "we cannot cross."
    } ]
  }, {
    "tStartMs": 763266,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "It used to be easy to travel to Myanmar,"
    } ]
  }, {
    "tStartMs": 765500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "but ever since the civil war,"
    } ]
  }, {
    "tStartMs": 767799,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "um, China closed all the border crossings"
    } ]
  }, {
    "tStartMs": 771333,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "to tourists."
    } ]
  }, {
    "tStartMs": 772566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "There are quite some border"
    } ]
  }, {
    "tStartMs": 774566,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "crossings on the Yunnan-Myanmar border."
    } ]
  }, {
    "tStartMs": 777100,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "It used to be really easy,"
    } ]
  }, {
    "tStartMs": 778766,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "but now only traders can go to the other side."
    } ]
  }, {
    "tStartMs": 782600,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But you see, this is the gate,"
    } ]
  }, {
    "tStartMs": 784600,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "and that mountain—"
    } ]
  }, {
    "tStartMs": 785966,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "it's already Myanmar."
    } ]
  }, {
    "tStartMs": 789700,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "Myanmar lies just across the mountains."
    } ]
  }, {
    "tStartMs": 792366,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Close enough to see,"
    } ]
  }, {
    "tStartMs": 793566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "yet impossible to reach today."
    } ]
  }, {
    "tStartMs": 795966,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "But beneath the thick jungle,"
    } ]
  }, {
    "tStartMs": 797766,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "the wreckage of countless aircraft"
    } ]
  }, {
    "tStartMs": 799933,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "remains hidden,"
    } ]
  }, {
    "tStartMs": 801500,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "a silent reminder of that history."
    } ]
  }, {
    "tStartMs": 815100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Tonight, when we reached Lushi,"
    } ]
  }, {
    "tStartMs": 817000,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "we ordered another famous dish"
    } ]
  }, {
    "tStartMs": 819033,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "called \"Yuejin Bridge Fire-Roasted Chicken.\""
    } ]
  }, {
    "tStartMs": 820833,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "So basically,"
    } ]
  }, {
    "tStartMs": 821566,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "it's just one piece of grilled chicken—"
    } ]
  }, {
    "tStartMs": 824799,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "a whole one."
    } ]
  }, {
    "tStartMs": 826233,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "And what's interesting is that"
    } ]
  }, {
    "tStartMs": 828100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "in Yunnan, it always comes"
    } ]
  }, {
    "tStartMs": 830066,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "together with this \"zhan shui,\""
    } ]
  }, {
    "tStartMs": 831799,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "which is ground chili peppers"
    } ]
  }, {
    "tStartMs": 834666,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "and Sichuan pepper. We also got"
    } ]
  }, {
    "tStartMs": 837366,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "some green vegetables—water spinach—and rice."
    } ]
  }, {
    "tStartMs": 840700,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "I hope you can try your best to finish it today."
    } ]
  }, {
    "tStartMs": 844066,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Because there's quite a lot today."
    } ]
  }, {
    "tStartMs": 845066,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "I will."
    } ]
  }, {
    "tStartMs": 846466,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "It was lots of riding today,"
    } ]
  }, {
    "tStartMs": 848399,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "so very exhausted."
    } ]
  }, {
    "tStartMs": 849266,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "We haven't eaten for a long time."
    } ]
  }, {
    "tStartMs": 851500,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "And tomorrow we're going to go"
    } ]
  }, {
    "tStartMs": 853399,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "to the land of volcanoes and"
    } ]
  }, {
    "tStartMs": 855899,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "hot springs—"
    } ]
  }, {
    "tStartMs": 856833,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "hot springs—"
    } ]
  }, {
    "tStartMs": 857666,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "in Tengchong. So,"
    } ]
  }, {
    "tStartMs": 858799,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "uh, thanks for watching."
    } ]
  }, {
    "tStartMs": 860566,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We'll see you in the next episode. Bye-bye."
    } ]
  }, {
    "tStartMs": 862600,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Bye-bye."
    } ]
  } ]
}
