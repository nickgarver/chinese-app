  "events": [ {
    "tStartMs": 266,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "The operation was so difficult."
    } ]
  }, {
    "tStartMs": 2266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "And so many aircraft were lost."
    } ]
  }, {
    "tStartMs": 4400,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "And among more than five hundred lost aircraft,"
    } ]
  }, {
    "tStartMs": 9900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "this is perhaps the only one"
    } ]
  }, {
    "tStartMs": 11900,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "that they found almost complete."
    } ]
  }, {
    "tStartMs": 15766,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "In our last episode,"
    } ]
  }, {
    "tStartMs": 17133,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "we uncovered the story of"
    } ]
  }, {
    "tStartMs": 18566,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "China's most Christian region."
    } ]
  }, {
    "tStartMs": 21166,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Today we continued our journey along the"
    } ]
  }, {
    "tStartMs": 23466,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "Nujiang River to the Myanmar border,"
    } ]
  }, {
    "tStartMs": 25399,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "where more than five hundred aircraft"
    } ]
  }, {
    "tStartMs": 27866,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "disappeared into the mountains."
    } ]
  }, {
    "tStartMs": 44500,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Good morning, everyone."
    } ]
  }, {
    "tStartMs": 45600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Welcome back to the channel."
    } ]
  }, {
    "tStartMs": 48166,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "Right now we are in Laomuden."
    } ]
  }, {
    "tStartMs": 49700,
    "dDurationMs": 2699,
    "segs": [ {
      "utf8": "So it's a village on half of the"
    } ]
  }, {
    "tStartMs": 52399,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "mountain, on the slope in the Nujiang Valley."
    } ]
  }, {
    "tStartMs": 55533,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "That is the Nujiang Valley."
    } ]
  }, {
    "tStartMs": 57399,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "And behind those mountains is Myanmar."
    } ]
  }, {
    "tStartMs": 60100,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "And today we are going"
    } ]
  }, {
    "tStartMs": 62000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "to Pianma, which is a border town"
    } ]
  }, {
    "tStartMs": 65500,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "that is just at"
    } ]
  }, {
    "tStartMs": 67366,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "the Burmese border."
    } ]
  }, {
    "tStartMs": 68700,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "And I just pulled out the map."
    } ]
  }, {
    "tStartMs": 71666,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Look at this. It's just one hundred fifty kilometers,"
    } ]
  }, {
    "tStartMs": 74099,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "but it takes like three and a half hours."
    } ]
  }, {
    "tStartMs": 75866,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "And the whole road basically goes like this."
    } ]
  }, {
    "tStartMs": 79099,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "To be honest,"
    } ]
  }, {
    "tStartMs": 80000,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "I wasn't so convinced of going to the border,"
    } ]
  }, {
    "tStartMs": 83133,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "because first of all,"
    } ]
  }, {
    "tStartMs": 84000,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "we have a limited amount of time"
    } ]
  }, {
    "tStartMs": 86099,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "for this trip in Yunnan."
    } ]
  }, {
    "tStartMs": 87766,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "We have about ten days, and this"
    } ]
  }, {
    "tStartMs": 90866,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "is a plan that only"
    } ]
  }, {
    "tStartMs": 92266,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "was brought up yesterday night."
    } ]
  }, {
    "tStartMs": 94466,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "If we go there,"
    } ]
  }, {
    "tStartMs": 95700,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "I might risk losing the time for the"
    } ]
  }, {
    "tStartMs": 100933,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mushroom trips that I've always wanted."
    } ]
  }, {
    "tStartMs": 104066,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "But we are going there"
    } ]
  }, {
    "tStartMs": 105233,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "for one single reason,"
    } ]
  }, {
    "tStartMs": 106333,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "which is the Hump."
    } ]
  }, {
    "tStartMs": 107566,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "The Hump was one of the"
    } ]
  }, {
    "tStartMs": 108966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "most hidden and epic"
    } ]
  }, {
    "tStartMs": 110266,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "air missions during the Second World War,"
    } ]
  }, {
    "tStartMs": 112333,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "where more than five hundred planes"
    } ]
  }, {
    "tStartMs": 114566,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "have crashed and"
    } ]
  }, {
    "tStartMs": 115799,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "five hundred pilots lost their lives."
    } ]
  }, {
    "tStartMs": 118099,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "And in this place, Pianma,"
    } ]
  }, {
    "tStartMs": 119700,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "you can still witness some of this history."
    } ]
  }, {
    "tStartMs": 122900,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "This street—"
    } ]
  }, {
    "tStartMs": 128466,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "Pianma is a tiny border crossing"
    } ]
  }, {
    "tStartMs": 130800,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "connecting China with Myanmar's Kachin State,"
    } ]
  }, {
    "tStartMs": 133733,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "home to the same mountain peoples"
    } ]
  }, {
    "tStartMs": 135366,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "known as Jingpo and Lisu in China."
    } ]
  }, {
    "tStartMs": 138400,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Worried that we might run out of fuel,"
    } ]
  }, {
    "tStartMs": 141133,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Flore dropped me off at a fork in the road"
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "and drove ahead to find a gas station."
    } ]
  }, {
    "tStartMs": 146733,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "At a crossroad,"
    } ]
  }, {
    "tStartMs": 147900,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "there was a small local market where"
    } ]
  }, {
    "tStartMs": 150166,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "villagers gathered to sell wild herbs,"
    } ]
  }, {
    "tStartMs": 152966,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "forest products, and other mountain goods."
    } ]
  }, {
    "tStartMs": 156800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Hey, what is this?"
    } ]
  }, {
    "tStartMs": 159599,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Fig."
    } ]
  }, {
    "tStartMs": 160599,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "How much is one?"
    } ]
  }, {
    "tStartMs": 161766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Fifteen yuan."
    } ]
  }, {
    "tStartMs": 162599,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Fifteen yuan each?"
    } ]
  }, {
    "tStartMs": 164133,
    "dDurationMs": 333,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 164466,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "This is a wild fig."
    } ]
  }, {
    "tStartMs": 166066,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Can I eat it?"
    } ]
  }, {
    "tStartMs": 166966,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "Yes, you can."
    } ]
  }, {
    "tStartMs": 168133,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Then I'll take one."
    } ]
  }, {
    "tStartMs": 169666,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "Uh, fifteen yuan."
    } ]
  }, {
    "tStartMs": 170666,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 171599,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "There are only these three."
    } ]
  }, {
    "tStartMs": 172699,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 173199,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "Which one do you want?"
    } ]
  }, {
    "tStartMs": 174300,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Just one is fine."
    } ]
  }, {
    "tStartMs": 175133,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Let me try it."
    } ]
  }, {
    "tStartMs": 176000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yeah, right."
    } ]
  }, {
    "tStartMs": 176966,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Boss, what kind of mushroom is this?"
    } ]
  }, {
    "tStartMs": 179266,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "This is what we call \"Malu\" mushroom."
    } ]
  }, {
    "tStartMs": 181400,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Malu mushroom?"
    } ]
  }, {
    "tStartMs": 182466,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 183366,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "And what about this one?"
    } ]
  }, {
    "tStartMs": 186333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "This one?"
    } ]
  }, {
    "tStartMs": 187400,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "This is black boletus."
    } ]
  }, {
    "tStartMs": 188733,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "Black boletus mushroom."
    } ]
  }, {
    "tStartMs": 190500,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "I hope that I can go with them"
    } ]
  }, {
    "tStartMs": 192400,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "for mushroom hunting as well."
    } ]
  }, {
    "tStartMs": 195933,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Looks like chopsticks."
    } ]
  }, {
    "tStartMs": 198699,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Termite mushroom."
    } ]
  }, {
    "tStartMs": 202199,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "This one—what mushroom is this, boss?"
    } ]
  }, {
    "tStartMs": 204300,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Termite mushroom, termite mushroom."
    } ]
  }, {
    "tStartMs": 204800,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "Oh, this is termite mushroom."
    } ]
  }, {
    "tStartMs": 206300,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "Oh wow, that's the famous—"
    } ]
  }, {
    "tStartMs": 208199,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "I think Yunnan people really love it."
    } ]
  }, {
    "tStartMs": 214000,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Two nine two?"
    } ]
  }, {
    "tStartMs": 215199,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "This is egg mushroom."
    } ]
  }, {
    "tStartMs": 217400,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Chicken claw mushroom."
    } ]
  }, {
    "tStartMs": 219099,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "Egg mushroom?"
    } ]
  }, {
    "tStartMs": 219866,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Mm."
    } ]
  }, {
    "tStartMs": 220766,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Egg mushroom."
    } ]
  }, {
    "tStartMs": 222900,
    "dDurationMs": 799,
    "segs": [ {
      "utf8": "Egg mushroom."
    } ]
  }, {
    "tStartMs": 225199,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "I have never heard of those mushrooms."
    } ]
  }, {
    "tStartMs": 228000,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh wow."
    } ]
  }, {
    "tStartMs": 229099,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "This is my paradise."
    } ]
  }, {
    "tStartMs": 231800,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "Wow, these are the big termite mushrooms that just grew out."
    } ]
  }, {
    "tStartMs": 234699,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 235800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Termite mushrooms, big termite mushrooms."
    } ]
  }, {
    "tStartMs": 237133,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Oh wow."
    } ]
  }, {
    "tStartMs": 237966,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 238533,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "Yes, yes, that's right."
    } ]
  }, {
    "tStartMs": 239400,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Since I'm recording, I wouldn't dare to overcharge."
    } ]
  }, {
    "tStartMs": 240966,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Hahaha."
    } ]
  }, {
    "tStartMs": 242133,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "Right?"
    } ]
  }, {
    "tStartMs": 242766,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Yes, yes. Thank you."
    } ]
  }, {
    "tStartMs": 243933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "I only sell it for fifty yuan a catty."
    } ]
  }, {
    "tStartMs": 245366,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "Because it's already opened up."
    } ]
  }, {
    "tStartMs": 247566,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "How much per catty?"
    } ]
  }, {
    "tStartMs": 248000,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "If it's opened, it will naturally weigh more."
    } ]
  }, {
    "tStartMs": 250699,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "Fifty yuan."
    } ]
  }, {
    "tStartMs": 251333,
    "dDurationMs": 766,
    "segs": [ {
      "utf8": "Fifty yuan per catty."
    } ]
  }, {
    "tStartMs": 252099,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Other people sell it for seventy or eighty yuan per catty."
    } ]
  }, {
    "tStartMs": 253500,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "Is termite mushroom the most expensive?"
    } ]
  }, {
    "tStartMs": 256133,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "You can't exactly say that."
    } ]
  }, {
    "tStartMs": 258199,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "Next time around,"
    } ]
  }, {
    "tStartMs": 259300,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "it's about the same price."
    } ]
  }, {
    "tStartMs": 261133,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "If this one hadn't opened up,"
    } ]
  }, {
    "tStartMs": 264266,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "it could sell for eighty yuan per catty."
    } ]
  }, {
    "tStartMs": 267166,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Haha, brother."
    } ]
  }, {
    "tStartMs": 268500,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "Sister, let me put it this way."
    } ]
  }, {
    "tStartMs": 269766,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "I'll speak directly."
    } ]
  }, {
    "tStartMs": 271966,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Then we'll do it together."
    } ]
  }, {
    "tStartMs": 274566,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Taste it and you won't want to leave."
    } ]
  }, {
    "tStartMs": 276166,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Very sweet, very sweet."
    } ]
  }, {
    "tStartMs": 277066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Quite sweet."
    } ]
  }, {
    "tStartMs": 279066,
    "dDurationMs": 633,
    "segs": [ {
      "utf8": "How much per catty?"
    } ]
  }, {
    "tStartMs": 279699,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "Eight yuan, to be honest."
    } ]
  }, {
    "tStartMs": 281333,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Okay, weigh some."
    } ]
  }, {
    "tStartMs": 282933,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "Speak directly."
    } ]
  }, {
    "tStartMs": 283966,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Don't be upset."
    } ]
  }, {
    "tStartMs": 285166,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "Okay. The big milk-cap mushrooms."
    } ]
  }, {
    "tStartMs": 287933,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "The big milk-cap mushrooms from the mountain."
    } ]
  }, {
    "tStartMs": 289566,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The big milk-cap mushrooms from the mountain."
    } ]
  }, {
    "tStartMs": 290766,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "These are white milk-cap mushrooms."
    } ]
  }, {
    "tStartMs": 292333,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "Oh, white milk-cap mushrooms."
    } ]
  }, {
    "tStartMs": 293933,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "White milk-cap mushrooms, yes."
    } ]
  }, {
    "tStartMs": 296333,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Ah."
    } ]
  }, {
    "tStartMs": 298199,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Okay, haha, thank you."
    } ]
  }, {
    "tStartMs": 301000,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "Was this also found from the mountain?"
    } ]
  }, {
    "tStartMs": 303899,
    "dDurationMs": 101,
    "segs": [ {
      "utf8": "Oh."
    } ]
  }, {
    "tStartMs": 304000,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "The beehive."
    } ]
  }, {
    "tStartMs": 305133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "The honey is inside. Wow."
    } ]
  }, {
    "tStartMs": 308133,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "Yes, there's a little bit on top."
