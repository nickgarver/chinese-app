  "events": [ {
    "tStartMs": 18733,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Do you all recognize these two characters?"
    } ]
  }, {
    "tStartMs": 21933,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "That's the word for \"restaurant\"."
    } ]
  }, {
    "tStartMs": 28033,
    "dDurationMs": 5167,
    "segs": [ {
      "utf8": "Today I've come to a special restaurant to eat."
    } ]
  }, {
    "tStartMs": 33200,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "This restaurant is extremely popular."
    } ]
  }, {
    "tStartMs": 35833,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "Even though it doesn't look like anything special,"
    } ]
  }, {
    "tStartMs": 39700,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and isn't that pretty,"
    } ]
  }, {
    "tStartMs": 42000,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "there are still lots of people waiting in line to eat."
    } ]
  }, {
    "tStartMs": 47600,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "So let's go inside and take a look now."
    } ]
  }, {
    "tStartMs": 68133,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Air conditioning fan"
    } ]
  }, {
    "tStartMs": 70300,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "The weather has been so hot recently"
    } ]
  }, {
    "tStartMs": 73466,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "Can't survive without a fan or air conditioning"
    } ]
  }, {
    "tStartMs": 80800,
    "dDurationMs": 7333,
    "segs": [ {
      "utf8": "As soon as I entered, I saw these very traditional decorations"
    } ]
  }, {
    "tStartMs": 90333,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Rarely see these decorations in restaurants"
    } ]
  }, {
    "tStartMs": 95500,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "Because this is a restaurant in a rural area"
    } ]
  }, {
    "tStartMs": 99533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "That's why there are these decorations"
    } ]
  }, {
    "tStartMs": 103233,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "I think it's quite unique"
    } ]
  }, {
    "tStartMs": 109200,
    "dDurationMs": 5933,
    "segs": [ {
      "utf8": "This is a machine where you can rent a power bank."
    } ]
  }, {
    "tStartMs": 117633,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "Power bank."
    } ]
  }, {
    "tStartMs": 120100,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "If your phone battery is dead,"
    } ]
  }, {
    "tStartMs": 122100,
    "dDurationMs": 3966,
    "segs": [ {
      "utf8": "you can rent a power bank here."
    } ]
  }, {
    "tStartMs": 133700,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "Can you tell what fruit this is?"
    } ]
  }, {
    "tStartMs": 136433,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Pineapple, because the most famous fruit in this area"
    } ]
  }, {
    "tStartMs": 140233,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "is pineapple."
    } ]
  }, {
    "tStartMs": 145533,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "Across from the entrance of this restaurant, there is a small stall."
    } ]
  }, {
    "tStartMs": 150833,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They sell some fruits"
    } ]
  }, {
    "tStartMs": 153233,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and some snacks."
    } ]
  }, {
    "tStartMs": 154833,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "They also sell things they grow themselves,"
    } ]
  }, {
    "tStartMs": 157333,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "like lemons and bananas."
    } ]
  }, {
    "tStartMs": 160766,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Business is pretty good."
    } ]
  }, {
    "tStartMs": 167700,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Inside this restaurant,"
    } ]
  }, {
    "tStartMs": 170133,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "there's actually a drink shop."
    } ]
  }, {
    "tStartMs": 176233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "Its name is also quite interesting."
    } ]
  }, {
    "tStartMs": 178166,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "It's called the 'Pineapple Tea Bureau'"
    } ]
  }, {
    "tStartMs": 181966,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "I told you this restaurant is extremely popular"
    } ]
  }, {
    "tStartMs": 184300,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "There's often a queue"
    } ]
  }, {
    "tStartMs": 186233,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It's just past 5 PM on a weekday now"
    } ]
  }, {
    "tStartMs": 192366,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "If we need to queue up,"
    } ]
  }, {
    "tStartMs": 194300,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "we can sit on these red stools"
    } ]
  }, {
    "tStartMs": 199833,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This is a kind of stool commonly seen in Guangdong"
    } ]
  }, {
    "tStartMs": 204700,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "Over here is the cashier counter"
    } ]
  }, {
    "tStartMs": 206966,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "The place to pay"
    } ]
  }, {
    "tStartMs": 216500,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "Braised pork belly is on sale now"
    } ]
  }, {
    "tStartMs": 217733,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "Braised pork belly is on sale"
    } ]
  }, {
    "tStartMs": 218700,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "No crab congee"
    } ]
  }, {
    "tStartMs": 220133,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "BBQ pork, spare ribs, roasted goose"
    } ]
  }, {
    "tStartMs": 226600,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "White cut chicken, and soy sauce chicken"
    } ]
  }, {
    "tStartMs": 229933,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "'Soy sauce' means 'soy sauce' in Chinese"
    } ]
  }, {
    "tStartMs": 234133,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "The prices are like this"
    } ]
  }, {
    "tStartMs": 235766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "65 yuan for half a chicken"
    } ]
  }, {
    "tStartMs": 237533,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "120 yuan for a whole chicken"
    } ]
  }, {
    "tStartMs": 243400,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "This is the food pickup window"
    } ]
  }, {
    "tStartMs": 245600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "Finished dishes are placed here"
    } ]
  }, {
    "tStartMs": 252633,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "On the other side"
    } ]
  }, {
    "tStartMs": 254000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "There are some seafood"
    } ]
  }, {
    "tStartMs": 258866,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "We can pick our own seafood here"
    } ]
  }, {
    "tStartMs": 262600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Just like at a market"
    } ]
  }, {
    "tStartMs": 270033,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "Small crabs"
    } ]
  }, {
    "tStartMs": 276100,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "This one looks really scary"
    } ]
  }, {
    "tStartMs": 279866,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "This kind is called \"yellow eel\""
    } ]
  }, {
    "tStartMs": 282933,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "This fish is called \"yellow eel\""
    } ]
  }, {
    "tStartMs": 291333,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "Wow, there's a big fish head here"
    } ]
  }, {
    "tStartMs": 300333,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "Different kinds of crabs"
    } ]
  }, {
    "tStartMs": 304500,
    "dDurationMs": 1066,
    "segs": [ {
      "utf8": "Fish"
    } ]
  }, {
    "tStartMs": 308200,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "And these (diving beetles, water cockroaches)"
    } ]
  }, {
    "tStartMs": 313000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Would you dare to eat them?"
    } ]
  }, {
    "tStartMs": 316333,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "They're still moving, they can swim."
    } ]
  }, {
    "tStartMs": 329200,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "It feels like stepping into a seafood market."
    } ]
  }, {
    "tStartMs": 342466,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "Up there, they usually make it into a menu."
    } ]
  }, {
    "tStartMs": 346600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "He has displayed all these dishes."
    } ]
  }, {
    "tStartMs": 350066,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "Making it convenient for everyone to order."
    } ]
  }, {
    "tStartMs": 354300,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "There are also some fresh vegetables here."
    } ]
  }, {
    "tStartMs": 357966,
    "dDurationMs": 6834,
    "segs": [ {
      "utf8": "Showing guests what vegetables the restaurant offers today."
    } ]
  }, {
    "tStartMs": 365966,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Down here, there's another ingredient."
    } ]
  }, {
    "tStartMs": 370433,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "It's called 'bamboo worm.'"
    } ]
  }, {
    "tStartMs": 373500,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It's also a type of insect."
    } ]
  }, {
    "tStartMs": 377066,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "They're hiding now."
    } ]
  }, {
    "tStartMs": 383866,
    "dDurationMs": 6234,
    "segs": [ {
      "utf8": "Here is a big, fat worm—the bamboo worm."
    } ]
  }, {
    "tStartMs": 390333,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "But I've heard it's very nutritious."
    } ]
  }, {
    "tStartMs": 395566,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Very high in protein."
    } ]
  }, {
    "tStartMs": 404366,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "In Guangdong, this kind of worm is edible."
    } ]
  }, {
    "tStartMs": 407833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "And the price is not cheap."
    } ]
  }, {
    "tStartMs": 411600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "In this restaurant,"
    } ]
  }, {
    "tStartMs": 413166,
    "dDurationMs": 5434,
    "segs": [ {
      "utf8": "we can also see some carp"
    } ]
  }, {
    "tStartMs": 421733,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "and turtles."
    } ]
  }, {
    "tStartMs": 427600,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "There is a small pond here."
    } ]
  }, {
    "tStartMs": 432400,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "Here, there is a whiteboard."
    } ]
  }, {
    "tStartMs": 435233,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "On it are some dish names."
    } ]
  }, {
    "tStartMs": 439066,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "This is a handwritten menu."
    } ]
  }, {
    "tStartMs": 450766,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Most rural restaurants look like this."
    } ]
  }, {
    "tStartMs": 455566,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The decor doesn't have to be fancy,"
    } ]
  }, {
    "tStartMs": 458366,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "but the food must be delicious."
    } ]
  }, {
    "tStartMs": 461233,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "When Cantonese people eat out,"
    } ]
  }, {
    "tStartMs": 462533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "they don't care about the environment,"
    } ]
  }, {
    "tStartMs": 464733,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "but they definitely care about the taste."
    } ]
  }, {
    "tStartMs": 471733,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "This is the kitchen of the restaurant."
    } ]
  }, {
    "tStartMs": 480033,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "This restaurant also offers free soup."
    } ]
  }, {
    "tStartMs": 483166,
    "dDurationMs": 5134,
    "segs": [ {
      "utf8": "So you can hold your bowl and line up here for soup."
    } ]
  }, {
    "tStartMs": 489133,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I heard the soup here is very delicious."
    } ]
  }, {
    "tStartMs": 491933,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So many people are lining up."
    } ]
  }, {
    "tStartMs": 498366,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "Look, the seats are already full of people waiting in line."
    } ]
  }, {
    "tStartMs": 505600,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "This restaurant has a second floor."
    } ]
  }, {
    "tStartMs": 508133,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "The first floor is already full."
    } ]
  }, {
    "tStartMs": 509300,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So we need to go upstairs."
    } ]
  }, {
    "tStartMs": 535866,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "This is what the second floor looks like."
    } ]
  }, {
    "tStartMs": 540833,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "But the second floor looks hotter."
    } ]
  }, {
    "tStartMs": 543933,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "Because it's an open space."
    } ]
  }, {
    "tStartMs": 546666,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "There's no air conditioning."
    } ]
  }, {
    "tStartMs": 548333,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "Only fans."
    } ]
  }, {
    "tStartMs": 550133,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "But the advantage of the second floor is that the view is prettier."
    } ]
  }, {
    "tStartMs": 557033,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "You can see a small river over there."
    } ]
  }, {
    "tStartMs": 569366,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Luckily we came early."
    } ]
  }, {
    "tStartMs": 570766,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "Otherwise we'd have to wait in line."
    } ]
  }, {
    "tStartMs": 583333,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "The best-selling item here is the pineapple slush."
    } ]
  }, {
    "tStartMs": 588500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It's only 9.9 yuan."
    } ]
  }, {
    "tStartMs": 591000,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "Top one, top seller, number one."
    } ]
  }, {
    "tStartMs": 598633,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "Barely open for business."
    } ]
  }, {
    "tStartMs": 608600,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "A very uniquely shaped decoration."
    } ]
  }, {
    "tStartMs": 614400,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "Got a cup of their signature drink."
    } ]
  }, {
    "tStartMs": 618766,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "Pineapple slush."
    } ]
  }, {
    "tStartMs": 620900,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "Summer really can't go without ice."
    } ]
  }, {
    "tStartMs": 625100,
    "dDurationMs": 1866,
    "segs": [ {
      "utf8": "There's even a little pineapple on top."
    } ]
  }, {
    "tStartMs": 627166,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "So cute!"
    } ]
  }, {
    "tStartMs": 629333,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Then while eating this slush,"
    } ]
  }, {
    "tStartMs": 632633,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "I enjoy the river view."
    } ]
  }, {
    "tStartMs": 637333,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "Perfect."
    } ]
  } ]
}
