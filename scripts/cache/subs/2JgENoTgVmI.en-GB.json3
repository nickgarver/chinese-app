  "events": [ {
    "tStartMs": 69766,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "Episode 10"
    } ]
  }, {
    "tStartMs": 71700,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Three Dangers"
    } ]
  }, {
    "tStartMs": 75200,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "Sun Wukong entered his master's room"
    } ]
  }, {
    "tStartMs": 80500,
    "dDurationMs": 5333,
    "segs": [ {
      "utf8": "His master was indeed waiting for him inside"
    } ]
  }, {
    "tStartMs": 85966,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "Sun Wukong knelt before his master"
    } ]
  }, {
    "tStartMs": 90366,
    "dDurationMs": 4834,
    "segs": [ {
      "utf8": "His master was going to teach him how to become immortal"
    } ]
  }, {
    "tStartMs": 97600,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "His master taught him in a low voice"
    } ]
  }, {
    "tStartMs": 101666,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Sun Wukong listened carefully"
    } ]
  }, {
    "tStartMs": 106000,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "Before he knew it"
    } ]
  }, {
    "tStartMs": 108266,
    "dDurationMs": 4734,
    "segs": [ {
      "utf8": "dawn had come"
    } ]
  }, {
    "tStartMs": 114266,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Sun Wukong went out through the back door"
    } ]
  }, {
    "tStartMs": 118966,
    "dDurationMs": 6167,
    "segs": [ {
      "utf8": "and returned to the room he shared with the others"
    } ]
  }, {
    "tStartMs": 125300,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "The others were still asleep"
    } ]
  }, {
    "tStartMs": 128533,
    "dDurationMs": 5667,
    "segs": [ {
      "utf8": "They did not know the master had taught Sun Wukong"
    } ]
  }, {
    "tStartMs": 137766,
    "dDurationMs": 8167,
    "segs": [ {
      "utf8": "During the day Sun Wukong studied with the others"
    } ]
  }, {
    "tStartMs": 146166,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "When no one was around"
    } ]
  }, {
    "tStartMs": 148466,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "he practiced alone"
    } ]
  }, {
    "tStartMs": 152766,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "At night"
    } ]
  }, {
    "tStartMs": 154333,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "he also practiced diligently"
    } ]
  }, {
    "tStartMs": 158666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "Three years passed"
    } ]
  }, {
    "tStartMs": 163800,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "The master asked Have you learned it"
    } ]
  }, {
    "tStartMs": 168666,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Sun Wukong said"
    } ]
  }, {
    "tStartMs": 170500,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "I have learned it"
    } ]
  }, {
    "tStartMs": 174000,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "The master said That is still not enough"
    } ]
  }, {
    "tStartMs": 178400,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "You will face three dangers in the future"
    } ]
  }, {
    "tStartMs": 184966,
    "dDurationMs": 5467,
    "segs": [ {
      "utf8": "The first danger is a mighty thunderbolt"
    } ]
  }, {
    "tStartMs": 190566,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Five hundred years later it will strike"
    } ]
  }, {
    "tStartMs": 194800,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "You must avoid it"
    } ]
  }, {
    "tStartMs": 198666,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Sun Wukong listened carefully"
    } ]
  }, {
    "tStartMs": 203566,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "After another five hundred years"
    } ]
  }, {
    "tStartMs": 206700,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "fire will come"
    } ]
  }, {
    "tStartMs": 209733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "This is no ordinary fire"
    } ]
  }, {
    "tStartMs": 212333,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "The fire will burn from inside your body"
    } ]
  }, {
    "tStartMs": 217566,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "This danger"
    } ]
  }, {
    "tStartMs": 219500,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "must also be avoided"
    } ]
  }, {
    "tStartMs": 223766,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "After another five hundred years"
    } ]
  }, {
    "tStartMs": 226566,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "a powerful wind will come"
    } ]
  }, {
    "tStartMs": 231066,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "The wind will enter your body"
    } ]
  }, {
    "tStartMs": 235466,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "You must avoid this danger too"
    } ]
  }, {
    "tStartMs": 240400,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "Sun Wukong was frightened by what he heard"
    } ]
  }, {
    "tStartMs": 247166,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "Sun Wukong bowed to his master"
    } ]
  }, {
    "tStartMs": 251266,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "He said"
    } ]
  }, {
    "tStartMs": 252866,
    "dDurationMs": 5167,
    "segs": [ {
      "utf8": "Please teach me how to avoid these dangers"
    } ]
  }, {
    "tStartMs": 258333,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "The master said But you are different from humans"
    } ]
  }, {
    "tStartMs": 266800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "Sun Wukong asked"
    } ]
  }, {
    "tStartMs": 269000,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "How am I different"
    } ]
  }, {
    "tStartMs": 273133,
    "dDurationMs": 6133,
    "segs": [ {
      "utf8": "The master said Your cheeks are smaller than a human's"
    } ]
  }, {
    "tStartMs": 279500,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "Sun Wukong touched his face"
    } ]
  }, {
    "tStartMs": 283100,
    "dDurationMs": 7033,
    "segs": [ {
      "utf8": "He said But I have a small pouch in my mouth for storing things"
    } ]
  }, {
    "tStartMs": 290366,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "The master laughed"
    } ]
  }, {
    "tStartMs": 293100,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "and said All right I will teach you"
    } ]
  }, {
    "tStartMs": 297800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "What will his master teach him"
    } ]
  }, {
    "tStartMs": 300200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "To be continued"
    } ]
  } ]
}
