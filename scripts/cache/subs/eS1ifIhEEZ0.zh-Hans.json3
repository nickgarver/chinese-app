  }, {
    "tStartMs": 52333,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "假如你是一个上班族"
    } ]
  }, {
    "tStartMs": 55266,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "今天是你非常忙碌的一天"
    } ]
  }, {
    "tStartMs": 58766,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "从早上到下午"
    } ]
  }, {
    "tStartMs": 61033,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "一直有会议"
    } ]
  }, {
    "tStartMs": 62733,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "你一直要开会开会开会"
    } ]
  }, {
    "tStartMs": 66133,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "你就可以跟你的朋友抱怨"
    } ]
  }, {
    "tStartMs": 68966,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "“啊，我今天真的累成狗了！”"
    } ]
  }, {
    "tStartMs": 71933,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "你的朋友就会立刻明白你今天有多累"
