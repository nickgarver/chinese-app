  }, {
    "tStartMs": 198066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "给大家一个情景"
    } ]
  }, {
    "tStartMs": 200066,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "你刚学习中文不久"
