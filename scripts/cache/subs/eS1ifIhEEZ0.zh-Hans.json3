  }, {
    "tStartMs": 32666,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "但是在生活当中"
    } ]
  }, {
    "tStartMs": 34733,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "你可能会听到别人这样说"
    } ]
  }, {
    "tStartMs": 38066,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "“哎呀，今天我真的是累成狗了！”"
    } ]
  }, {
    "tStartMs": 41800,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "累成狗，累得跟狗一样"
    } ]
  }, {
    "tStartMs": 46333,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "这不是在骂人"
