    "tStartMs": 492566,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "啊对不起，我的钥匙落在公司了"
    } ]
  }, {
    "tStartMs": 496766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "你可以回来帮我开一下门吗"
    } ]
  }, {
    "tStartMs": 500433,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "那你肯定...嗯没关系，我可以去帮他对不对"
    } ]
  }, {
    "tStartMs": 504166,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "因为这是第一次发生的情况"
    } ]
  }, {
    "tStartMs": 506700,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "那如果接下来一个星期"
    } ]
  }, {
    "tStartMs": 509433,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "他连续发生了三次这样的情况"
    } ]
  }, {
    "tStartMs": 513666,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "你就会有点觉得无语"
    } ]
  }, {
    "tStartMs": 516333,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "怎么这么没有记性呢"
    } ]
  }, {
    "tStartMs": 518866,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我真的服了"
    } ]
  }, {
    "tStartMs": 520666,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "一个星期内发生了三次这样的情况"
    } ]
  }, {
    "tStartMs": 524333,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "“我真的服了！”"
    } ]
  }, {
    "tStartMs": 526866,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "接下来第七个表达就是"
    } ]
  }, {
    "tStartMs": 535700,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "对，中间有三个英文字母"
    } ]
  }, {
    "tStartMs": 539233,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "EMO来自英文词emotion"
    } ]
  }, {
    "tStartMs": 543000,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "它表示的是难过、伤心"
    } ]
  }, {
    "tStartMs": 547200,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "失落、心情不好的意思"
    } ]
  }, {
    "tStartMs": 550633,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "在课本上，你可能学的是"
    } ]
  }, {
    "tStartMs": 553466,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "“我很伤心”"
    } ]
  }, {
    "tStartMs": 555200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "“我很难过”"
    } ]
  }, {
    "tStartMs": 556633,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "“我心情不好”"
    } ]
  }, {
    "tStartMs": 558666,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "但是现实生活当中"
    } ]
  }, {
    "tStartMs": 561600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "特别是年轻人"
    } ]
  }, {
    "tStartMs": 563166,
    "dDurationMs": 5734,
    "segs": [ {
      "utf8": "他们很喜欢用“我EMO啦！”这样的表达方式"
    } ]
  }, {
    "tStartMs": 569200,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "我有个朋友"
    } ]
  }, {
    "tStartMs": 570966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "我经常会叫他Emo哥"
    } ]
  }, {
    "tStartMs": 573633,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "为什么"
    } ]
  }, {
    "tStartMs": 574733,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "因为他经常在晚上的时候就emo了"
    } ]
  }, {
    "tStartMs": 578966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "在晚上不愿意睡觉"
    } ]
  }, {
    "tStartMs": 581633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "听着悲伤的歌"
    } ]
  }, {
    "tStartMs": 583733,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "看着手机里的消息"
    } ]
  }, {
    "tStartMs": 586566,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "伤心、难过、失落"
    } ]
  }, {
    "tStartMs": 589800,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "然后就会发一些很悲伤的动态"
    } ]
  }, {
    "tStartMs": 594966,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "他非常喜欢EMO"
    } ]
  }, {
    "tStartMs": 596966,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "所以我给他取了个名字，叫“emo哥”"
    } ]
  }, {
    "tStartMs": 600033,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "来到第8个表达方式了"
    } ]
  }, {
    "tStartMs": 608633,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "你可能会问：有东西？"
    } ]
  }, {
    "tStartMs": 611233,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "有什么东西"
    } ]
  }, {
    "tStartMs": 613466,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "这句话的意思呢"
    } ]
  }, {
    "tStartMs": 615066,
    "dDurationMs": 6567,
    "segs": [ {
      "utf8": "其实它是表达不错、比想象中好这样的意思"
    } ]
  }, {
    "tStartMs": 621933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "有点东西"
    } ]
  }, {
    "tStartMs": 624166,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "有一天，你的朋友带你去了一家餐厅"
    } ]
  }, {
    "tStartMs": 628566,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "你其实没有什么期待"
    } ]
  }, {
    "tStartMs": 630600,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "那家餐厅它的样子也是比较普通的"
    } ]
  }, {
    "tStartMs": 635800,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "你坐下来"
    } ]
  }, {
    "tStartMs": 637066,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "然后点菜"
    } ]
  }, {
    "tStartMs": 639233,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "上菜、你尝了一口"
    } ]
  }, {
    "tStartMs": 643566,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "惊艳到了"
    } ]
  }, {
    "tStartMs": 644766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "比你想象中的要好"
    } ]
  }, {
    "tStartMs": 648200,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "还挺不错的"
    } ]
  }, {
    "tStartMs": 649766,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "还挺好的"
    } ]
  }, {
    "tStartMs": 650666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "挺厉害的"
    } ]
  }, {
    "tStartMs": 652133,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "你就可以说"
    } ]
  }, {
    "tStartMs": 653666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "“哎，这家店有点东西哦！”"
    } ]
  }, {
    "tStartMs": 656533,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "这家店有点东西"
    } ]
  }, {
    "tStartMs": 659533,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "第九个表达方式"
    } ]
  }, {
    "tStartMs": 665533,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "或者是对......上头"
    } ]
  }, {
    "tStartMs": 669400,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "上头"
    } ]
  }, {
    "tStartMs": 673266,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "它的意思呢"
    } ]
  }, {
    "tStartMs": 674300,
    "dDurationMs": 4266,
    "segs": [ {
      "utf8": "就是代表喜欢、上瘾这样的意思"
    } ]
  }, {
    "tStartMs": 678566,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "上头"
    } ]
  }, {
    "tStartMs": 680933,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "现在啊，TikTok"
    } ]
  }, {
    "tStartMs": 682533,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "很多人对Tiktok上头"
    } ]
  }, {
    "tStartMs": 684166,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "因为刷视频是一种很上头的行为"
    } ]
  }, {
    "tStartMs": 688433,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "很容易上瘾的行为"
    } ]
  }, {
    "tStartMs": 691433,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "这个是“上头”"
    } ]
  }, {
    "tStartMs": 693133,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "我已经刷了一晚上的手机了"
    } ]
  }, {
    "tStartMs": 696566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我停不下来"
    } ]
  }, {
    "tStartMs": 698433,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "太上头了"
    } ]
  }, {
    "tStartMs": 700333,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "短视频太让人上头了"
    } ]
  }, {
    "tStartMs": 703800,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "那如果你说"
    } ]
  }, {
    "tStartMs": 705733,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "“我现在对他上头了！”"
    } ]
  }, {
    "tStartMs": 711566,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "那是什么意思"
    } ]
  }, {
    "tStartMs": 712533,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "那就是你现在非常喜欢这个人的意思"
    } ]
  }, {
    "tStartMs": 717233,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "你对他很着迷"
    } ]
  }, {
    "tStartMs": 719433,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "你很喜欢他"
    } ]
  }, {
    "tStartMs": 720766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我对他上头了"
    } ]
  }, {
    "tStartMs": 722966,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "会用了吗"
    } ]
  }, {
    "tStartMs": 724433,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "最后一个"
    } ]
  }, {
    "tStartMs": 730666,
    "dDurationMs": 5234,
    "segs": [ {
      "utf8": "大家可能看到这里又有一个英文词-CPU"
    } ]
  }, {
    "tStartMs": 736766,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "你们知道CPU它是电脑的一个零部件吗"
    } ]
  }, {
    "tStartMs": 741433,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "中央处理器"
    } ]
  }, {
    "tStartMs": 743733,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "烧，不是用火烧这样的意思"
    } ]
  }, {
    "tStartMs": 747766,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "是损坏了，不能用了这个意思"
    } ]
  }, {
    "tStartMs": 751100,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "CPU烧了"
    } ]
  }, {
    "tStartMs": 752600,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "如果你电脑的CPU坏了"
    } ]
  }, {
    "tStartMs": 754833,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "电脑是不能用的"
    } ]
  }, {
    "tStartMs": 757000,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "对，用不了了"
    } ]
  }, {
    "tStartMs": 759166,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "那在生活当中"
    } ]
  }, {
    "tStartMs": 760600,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "我们说这句话的时候呢"
    } ]
  }, {
    "tStartMs": 762866,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "除了可以用在电脑方面"
    } ]
  }, {
    "tStartMs": 765000,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "也可以用在你的脑子上"
    } ]
  }, {
    "tStartMs": 770000,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "什么意思"
    } ]
  }, {
    "tStartMs": 771166,
    "dDurationMs": 5334,
    "segs": [ {
      "utf8": "CPU烧了，就是一些很费脑、很烧脑"
    } ]
  }, {
    "tStartMs": 776566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "很复杂的情况"
    } ]
  }, {
    "tStartMs": 777800,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "你想不明白"
    } ]
  }, {
    "tStartMs": 779233,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "你就可以用“CPU烧了”（这个表达）"
    } ]
  }, {
    "tStartMs": 782166,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "举个例子"
    } ]
  }, {
    "tStartMs": 783366,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "你有一个程序员的朋友"
    } ]
  }, {
    "tStartMs": 786633,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "他很擅长写一些代码"
    } ]
  }, {
    "tStartMs": 790233,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "但是代码对你来说是非常难的"
    } ]
  }, {
    "tStartMs": 793466,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "像天书一样看不懂"
    } ]
  }, {
    "tStartMs": 797166,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "他给你讲"
    } ]
  }, {
    "tStartMs": 798566,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "这个是为什么"
    } ]
  }, {
    "tStartMs": 799600,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "这个是为什么"
    } ]
  }, {
    "tStartMs": 800900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你也很认真地听"
    } ]
  }, {
    "tStartMs": 802900,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "但是你就是不明白"
    } ]
  }, {
    "tStartMs": 805566,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "想不明白"
    } ]
  }, {
    "tStartMs": 806700,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "脑子转不过来了"
    } ]
  }, {
    "tStartMs": 809066,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "哎呀，不要再跟我说了"
    } ]
  }, {
    "tStartMs": 811066,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我CPU烧了"
    } ]
  }, {
    "tStartMs": 813766,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "它想表达的意思就是想不明白"
    } ]
  }, {
    "tStartMs": 817333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "脑子转不过来"
    } ]
  }, {
    "tStartMs": 819266,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "但是这是一个非常生动的表达"
    } ]
  }, {
    "tStartMs": 822933,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "如果你的中国朋友听到你说这句话"
    } ]
  }, {
    "tStartMs": 826500,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "他肯定会被你逗笑的"
    } ]
  }, {
    "tStartMs": 829066,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "今天的10个表达你都学会了吗"
    } ]
  }, {
    "tStartMs": 833266,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "马上找机会跟你的中国朋友"
    } ]
  }, {
    "tStartMs": 836400,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "或者跟你的中文老师说这几个词"
    } ]
  }, {
    "tStartMs": 841633,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "看看他们的反应是怎么样的"
    } ]
  }, {
    "tStartMs": 845466,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "如果大家想学习更多"
    } ]
  }, {
    "tStartMs": 847566,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "这样真实、自然、地道的中文"
    } ]
  }, {
    "tStartMs": 851033,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "请给我一个赞"
    } ]
  }, {
    "tStartMs": 853633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我会拍更多的视频给大家"
    } ]
  }, {
    "tStartMs": 856233,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "那今天的视频就到这儿了"
    } ]
  }, {
    "tStartMs": 858266,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "感谢大家看到这里"
    } ]
  }, {
    "tStartMs": 860100,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我们下个视频见，拜拜"
    } ]
  } ]
}
