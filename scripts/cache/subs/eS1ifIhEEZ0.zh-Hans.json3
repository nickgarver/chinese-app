  }, {
    "tStartMs": 28000,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "“我很累”"
    } ]
  }, {
    "tStartMs": 29333,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "“我非常累”"
    } ]
  }, {
    "tStartMs": 30700,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "“我累死了”"
