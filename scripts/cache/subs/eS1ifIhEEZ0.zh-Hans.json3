  }, {
    "tStartMs": 84366,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "在课本上，你可能学到的是"
    } ]
  }, {
    "tStartMs": 88100,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "“我很开心”"
    } ]
  }, {
    "tStartMs": 89700,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "“我很高兴”"
    } ]
  }, {
    "tStartMs": 91133,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "“今天真的太好了”"
    } ]
  }, {
    "tStartMs": 93800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "但是在生活当中"
    } ]
  }, {
    "tStartMs": 95766,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "中国人经常会说"
    } ]
  }, {
    "tStartMs": 97933,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "“哇，太爽了！”"
    } ]
  }, {
    "tStartMs": 100100,
    "dDurationMs": 5933,
    "segs": [ {
      "utf8": "表示特别开心、特别满足、特别舒服的意思"
    } ]
  }, {
    "tStartMs": 106366,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "举个例子"
    } ]
  }, {
    "tStartMs": 107366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "现在是夏天嘛"
    } ]
  }, {
    "tStartMs": 109166,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "气温都很高，很炎热"
    } ]
  }, {
    "tStartMs": 112466,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "你想一想"
    } ]
  }, {
    "tStartMs": 113500,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "在夏天，下午最炎热的时候"
    } ]
  }, {
    "tStartMs": 118566,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "35度，36度"
    } ]
  }, {
    "tStartMs": 121300,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "很热很热的天气"
    } ]
  }, {
    "tStartMs": 123900,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "你突然喝到了一杯冰咖啡"
    } ]
  }, {
    "tStartMs": 128100,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "或者冰奶茶"
    } ]
  }, {
    "tStartMs": 130166,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "或者冰啤酒"
    } ]
  }, {
    "tStartMs": 135833,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "“啊！太爽了！”"
    } ]
  }, {
    "tStartMs": 140633,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "就是说你很满足、很舒服、很开心的意思"
    } ]
  }, {
    "tStartMs": 145666,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "再举个例子"
    } ]
  }, {
    "tStartMs": 147066,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "如果你放一个星期假"
    } ]
  }, {
    "tStartMs": 150400,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "一个星期不用上班"
