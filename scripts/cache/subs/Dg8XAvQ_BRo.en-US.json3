  }, {
    "tStartMs": 90800,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "天气怎么样"
    } ]
  }, {
    "tStartMs": 92333,
    "dDurationMs": 6533,
    "segs": [ {
      "utf8": "和一些坐高铁时的注意事项"
