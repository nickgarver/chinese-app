  }, {
    "tStartMs": 1232200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "如果这个视频能帮助到你们"
    } ]
  }, {
    "tStartMs": 1234600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "我会很开心哦"
    } ]
  }, {
    "tStartMs": 66,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "Friends, let's experience it together."
    } ]
  }, {
    "tStartMs": 3400,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "Let's take the high-speed rail in China."
    } ]
  }, {
    "tStartMs": 6133,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "In this video,"
    } ]
  }, {
    "tStartMs": 7933,
    "dDurationMs": 5867,
    "segs": [ {
      "utf8": "Let's see what facilities are available on the high-speed rail."
    } ]
  }, {
    "tStartMs": 13800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "What can you do?"
    } ]
  }, {
    "tStartMs": 15600,
    "dDurationMs": 6333,
    "segs": [ {
      "utf8": "And how to order takeout on the high-speed rail in China."
    } ]
  }, {
    "tStartMs": 21933,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "Are you curious?"
    } ]
  }, {
    "tStartMs": 23466,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "Let's take a look together."
    } ]
  }, {
    "tStartMs": 69800,
    "dDurationMs": 6033,
    "segs": [ {
      "utf8": "The electronic screen shows the current car number"
    } ]
  }, {
    "tStartMs": 75833,
    "dDurationMs": 7033,
    "segs": [ {
      "utf8": "car number and the speed of the train at this moment."
