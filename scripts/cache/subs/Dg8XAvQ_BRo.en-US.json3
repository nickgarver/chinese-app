  }, {
    "tStartMs": 739833,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "我们刚吃了零食"
    } ]
  }, {
    "tStartMs": 742866,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "但是我们想吃饭"
    } ]
  }, {
    "tStartMs": 745233,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "我们现在尝试一下"
    } ]
  }, {
    "tStartMs": 747100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "在高铁怎么点外卖"
    } ]
  }, {
    "tStartMs": 751300,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "来"
    } ]
  }, {
    "tStartMs": 752033,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "车上有一个二维码"
    } ]
  }, {
    "tStartMs": 753633,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这个二维码它写的是第二个"
    } ]
  }, {
    "tStartMs": 755700,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "第二个是互联网订餐"
    } ]
  }, {
    "tStartMs": 760033,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "好我们选择这个互联网点餐"
    } ]
  }, {
    "tStartMs": 764133,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "好的开始点餐"
    } ]
  }, {
    "tStartMs": 765866,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "输入你的车次"
    } ]
  }, {
    "tStartMs": 769166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "开始点餐"
    } ]
  }, {
    "tStartMs": 770733,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "选择你的出发站和到达站"
    } ]
  }, {
    "tStartMs": 773700,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "大同南到成都东OK"
    } ]
  }, {
    "tStartMs": 776333,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "开始订餐"
    } ]
  }, {
    "tStartMs": 778266,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "（我们）可以选择下一站西安北站的（外卖）"
    } ]
  }, {
    "tStartMs": 782933,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "对西安北站的东西"
    } ]
  }, {
    "tStartMs": 784366,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "我们有肯德基啊"
    } ]
  }, {
    "tStartMs": 785733,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "有麦当劳"
    } ]
  }, {
    "tStartMs": 787166,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "对还有这个西安的特色肉夹馍"
    } ]
  }, {
    "tStartMs": 789700,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "西安的特色肉夹馍"
    } ]
  }, {
    "tStartMs": 792533,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "那我们点肉夹馍"
    } ]
  }, {
    "tStartMs": 795666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "两个肉夹馍"
    } ]
  }, {
    "tStartMs": 797133,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "肉夹馍"
    } ]
  }, {
    "tStartMs": 799033,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "老潼关肉夹馍"
    } ]
  }, {
    "tStartMs": 800333,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "这是他们的非遗特色"
    } ]
  }, {
    "tStartMs": 802700,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "然后再来一个鱼香茄子套餐"
    } ]
  }, {
    "tStartMs": 805566,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "咱们为什么这么能吃"
    } ]
  }, {
    "tStartMs": 807133,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "60减8了吗减74减"
    } ]
  }, {
    "tStartMs": 810033,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "够（配送）了"
    } ]
  }, {
    "tStartMs": 811433,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "开始输入你的姓名什么的"
    } ]
  }, {
    "tStartMs": 816066,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "车厢我们是2车厢"
    } ]
  }, {
    "tStartMs": 820866,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "13AB"
    } ]
  }, {
    "tStartMs": 823933,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "选择你的车的座位"
    } ]
  }, {
    "tStartMs": 826666,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "然后选择你的手机号码"
    } ]
  }, {
    "tStartMs": 828433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "可以选择你餐具的数量"
    } ]
  }, {
    "tStartMs": 830833,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "两个人就两份OK"
    } ]
  }, {
    "tStartMs": 834466,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "立即支付"
    } ]
  }, {
    "tStartMs": 837633,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "继续支付"
    } ]
  }, {
    "tStartMs": 842100,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "看一下我们的订单"
    } ]
  }, {
    "tStartMs": 844133,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "这是现在商家已经接单了"
    } ]
  }, {
    "tStartMs": 846433,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "他正在做"
    } ]
  }, {
    "tStartMs": 847533,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "到时候乘务员"
    } ]
  }, {
    "tStartMs": 848700,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "会把这个东西大概送到我们的座位上"
    } ]
  }, {
    "tStartMs": 852033,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "给我的朋友分享"
    } ]
  }, {
    "tStartMs": 853366,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "一下我的旅行好搭档"
    } ]
  }, {
    "tStartMs": 856366,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "你猜这是什么"
    } ]
  }, {
    "tStartMs": 858033,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "抱枕"
    } ]
  }, {
    "tStartMs": 858533,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "不是抱枕"
    } ]
  }, {
    "tStartMs": 860133,
    "dDurationMs": 733,
    "segs": [ {
      "utf8": "靠枕"
    } ]
  }, {
    "tStartMs": 860866,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "不是靠枕"
    } ]
  }, {
    "tStartMs": 861900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "什么枕"
    } ]
  }, {
    "tStartMs": 863100,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "颈枕"
    } ]
  }, {
    "tStartMs": 867666,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "这是一条蛇"
    } ]
  }, {
    "tStartMs": 870366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "对这不错"
    } ]
  }, {
    "tStartMs": 872266,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "对呀"
    } ]
  }, {
    "tStartMs": 873233,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "就"
    } ]
  }, {
    "tStartMs": 874366,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "这边可以拆下来把它洗一洗"
    } ]
  }, {
    "tStartMs": 879166,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "你的头掉不下去"
    } ]
  }, {
    "tStartMs": 884033,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "我觉得（她欲言又止...）"
    } ]
  }, {
    "tStartMs": 887000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "像落枕了你这个"
    } ]
  }, {
    "tStartMs": 888966,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "哼"
    } ]
  }, {
    "tStartMs": 890433,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "哦不太好"
    } ]
  }, {
    "tStartMs": 891700,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "有垃圾吗"
    } ]
  }, {
    "tStartMs": 893633,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "好"
    } ]
  }, {
    "tStartMs": 896100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "这个不扔谢谢"
    } ]
  }, {
    "tStartMs": 898566,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "然后还可以抱着它，可以抱着它"
    } ]
  }, {
    "tStartMs": 902766,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "它的造型可以多变"
    } ]
  }, {
    "tStartMs": 904866,
    "dDurationMs": 1834,
    "segs": [ {
      "utf8": "你可以就是这个样子"
    } ]
  }, {
    "tStartMs": 906700,
    "dDurationMs": 4866,
    "segs": [ {
      "utf8": "也可以也可以这样子把你撑着"
    } ]
  }, {
    "tStartMs": 911566,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "如果你要睡觉"
    } ]
  }, {
    "tStartMs": 916766,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "也可以把这个弄过来"
    } ]
  }, {
    "tStartMs": 919500,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "把你的头放在里面"
    } ]
  }, {
    "tStartMs": 924166,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "你看我这个兔子还有尾巴"
    } ]
  }, {
    "tStartMs": 926766,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "谁家兔子没尾巴"
    } ]
  }, {
    "tStartMs": 929466,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你快拍一下"
    } ]
  }, {
    "tStartMs": 931466,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "我的朋友说她的兔子有尾巴看看啊"
    } ]
  }, {
    "tStartMs": 935766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "什么样的兔子有尾巴"
    } ]
  }, {
    "tStartMs": 937566,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "太厉害了"
    } ]
  }, {
    "tStartMs": 940666,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "现在我们到了西安北站"
    } ]
  }, {
    "tStartMs": 943066,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "停下来 这一站停的时间比较长"
    } ]
  }, {
    "tStartMs": 946400,
    "dDurationMs": 1366,
    "segs": [ {
      "utf8": "大同靠近内蒙古"
    } ]
  }, {
    "tStartMs": 947766,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "所以是很北方"
    } ]
  }, {
    "tStartMs": 948900,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "西安现在其实已经接近了"
    } ]
  }, {
    "tStartMs": 951333,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "尤其是这个西安的这个"
    } ]
  }, {
    "tStartMs": 953066,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "秦岭它比较接近南北方的分界线"
    } ]
  }, {
    "tStartMs": 956733,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "所以它这边的气候跟"
    } ]
  }, {
    "tStartMs": 958100,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "我们那边是不一样的"
    } ]
  }, {
    "tStartMs": 959433,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "我们出去感受一下"
    } ]
  }, {
    "tStartMs": 960700,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "它是不是非常的热"
    } ]
  }, {
    "tStartMs": 962166,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "这里是西安北站"
    } ]
  }, {
    "tStartMs": 964233,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "各位旅客"
    } ]
  }, {
    "tStartMs": 965466,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "为保障广大旅客的"
    } ]
  }, {
    "tStartMs": 967633,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "每小时350千米"
    } ]
  }, {
    "tStartMs": 969733,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "看到了吗"
    } ]
  }, {
    "tStartMs": 970233,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "这是复兴号"
    } ]
  }, {
    "tStartMs": 971366,
    "dDurationMs": 6967,
    "segs": [ {
      "utf8": "咱这也是复兴号"
    } ]
  }, {
    "tStartMs": 978333,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "对啊"
    } ]
  }, {
    "tStartMs": 981933,
    "dDurationMs": 5767,
    "segs": [ {
      "utf8": "这边是可以便捷换乘"
    } ]
  }, {
    "tStartMs": 987700,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "看看那是和谐号，(这是）复兴号"
    } ]
  }, {
    "tStartMs": 995700,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "像子弹头一样"
    } ]
  }, {
    "tStartMs": 997500,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "现在我们来接水喽"
    } ]
  }, {
    "tStartMs": 1000033,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "这个红色的按钮呢"
    } ]
  }, {
    "tStartMs": 1001500,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "是儿童安全锁"
    } ]
  }, {
    "tStartMs": 1003600,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "要把它先按一下才可以出水"
    } ]
  }, {
    "tStartMs": 1006533,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "这里有纸杯"
    } ]
  }, {
    "tStartMs": 1008833,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "用劲儿"
    } ]
  }, {
    "tStartMs": 1009933,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "你往边上点"
    } ]
  }, {
    "tStartMs": 1011100,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "刚看见那个人好像 （水流歪的了）"
    } ]
  }, {
    "tStartMs": 1016233,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 1017866,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "你看它这个就容易烫到"
    } ]
  }, {
    "tStartMs": 1019600,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我那个水杯都不适合接是吧"
    } ]
  }, {
    "tStartMs": 1022433,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "嗯"
    } ]
  }, {
    "tStartMs": 1026233,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "停ok了"
    } ]
  }, {
    "tStartMs": 1029300,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "这边"
    } ]
  }, {
    "tStartMs": 1030466,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "再来一杯？"
    } ]
  }, {
    "tStartMs": 1032800,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "再来一杯"
    } ]
  }, {
    "tStartMs": 1034133,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "那那就是给你倒进去吗"
    } ]
  }, {
    "tStartMs": 1037733,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "他这个杯子太小了"
    } ]
  }, {
    "tStartMs": 1038933,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "我们只能倒进去"
    } ]
  }, {
    "tStartMs": 1044633,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "再接一杯"
    } ]
  }, {
    "tStartMs": 1046066,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "盖住"
    } ]
  }, {
    "tStartMs": 1047400,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "啊"
    } ]
  }, {
    "tStartMs": 1049133,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "不好意思哦"
    } ]
  }, {
    "tStartMs": 1050700,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "为什么（你不给它盖住）"
    } ]
  }, {
    "tStartMs": 1060100,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "OK干净"
    } ]
  }, {
    "tStartMs": 1061866,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "干净了然后呢"
    } ]
  }, {
    "tStartMs": 1063733,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "然后等待吃饭"
    } ]
  }, {
    "tStartMs": 1067300,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "等一下吧"
    } ]
  }, {
    "tStartMs": 1068333,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "我们现在等待"
    } ]
  }, {
    "tStartMs": 1069866,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "他什么时候能把这个饭给我们送过来"
    } ]
  }, {
    "tStartMs": 1072900,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "你那个盖子 要不要找一下"
    } ]
  }, {
    "tStartMs": 1075633,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "嗯盖子"
    } ]
  }, {
    "tStartMs": 1076633,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "哦对，盖子"
    } ]
  }, {
    "tStartMs": 1079133,
    "dDurationMs": 6667,
    "segs": [ {
      "utf8": "现在来找盖子"
    } ]
  }, {
    "tStartMs": 1085800,
