    } ]
  }, {
    "tStartMs": 85366,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "the high-speed rail station you are approaching."
    } ]
  }, {
    "tStartMs": 88733,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "What's the temperature outside?"
    } ]
  }, {
    "tStartMs": 90800,
    "dDurationMs": 1533,
    "segs": [ {
