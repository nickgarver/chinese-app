    "tStartMs": 277733,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Use it to hold on if you're unsteady."
    } ]
  }, {
    "tStartMs": 281233,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "There is some English."
    } ]
  }, {
    "tStartMs": 283166,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Oh, the yellow one above"
    } ]
  }, {
    "tStartMs": 284833,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "It's a box for aromatherapy tablets."
    } ]
  }, {
    "tStartMs": 286500,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "There is a scent inside."
    } ]
  }, {
    "tStartMs": 289433,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "This is the toilet."
    } ]
  }, {
    "tStartMs": 292966,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Next to it is a sink."
    } ]
  }, {
    "tStartMs": 294966,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "with a push-button faucet."
    } ]
  }, {
    "tStartMs": 297233,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Below is the trash can."
    } ]
  }, {
    "tStartMs": 298933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "It's the same here."
    } ]
  }, {
    "tStartMs": 300766,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "and a magic mirror above."
    } ]
  }, {
    "tStartMs": 304566,
    "dDurationMs": 4134,
    "segs": [ {
      "utf8": "It's for hanging clothes, luggage, and bags."
    } ]
  }, {
    "tStartMs": 308700,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "Let's go out now."
    } ]
  }, {
    "tStartMs": 398233,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Behind each seat, like an airplane,"
    } ]
  }, {
    "tStartMs": 400533,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "there is a cleaning bag."
    } ]
  }, {
    "tStartMs": 402566,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "You can put your garbage in the cleaning bag."
    } ]
  }, {
    "tStartMs": 406266,
    "dDurationMs": 3734,
    "segs": [ {
      "utf8": "The cleaners will come to collect it later."
    } ]
  }, {
    "tStartMs": 410000,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "This is a special reminder card for the quiet car."
    } ]
  }, {
    "tStartMs": 413866,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "There is also an English version."
    } ]
  }, {
    "tStartMs": 415200,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "Don't worry."
    } ]
  }, {
    "tStartMs": 422666,
    "dDurationMs": 4967,
    "segs": [ {
      "utf8": "This is a small table, with a weight limit of ten kilograms."
    } ]
  }, {
    "tStartMs": 427633,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "and under your seat."
    } ]
  }, {
    "tStartMs": 430366,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "there is actually a charging port."
    } ]
  }, {
    "tStartMs": 433433,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "I will show you in the video later"
    } ]
  }, {
    "tStartMs": 435466,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "how to charge it."
    } ]
  }, {
    "tStartMs": 439966,
    "dDurationMs": 4534,
    "segs": [ {
      "utf8": "Look, there is a buckle next to the armrest."
    } ]
  }, {
    "tStartMs": 444500,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Do you see it?"
    } ]
  }, {
    "tStartMs": 445300,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "If you lift it up,"
    } ]
  }, {
    "tStartMs": 447900,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "your seat back will adjust its position."
    } ]
  }, {
    "tStartMs": 451733,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Just like this."
    } ]
  }, {
    "tStartMs": 456533,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "This is the charger mentioned earlier"
    } ]
  }, {
    "tStartMs": 457933,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "The charger (socket) under the seat."
    } ]
  }, {
    "tStartMs": 461000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "You can charge your phone, computer,"
    } ]
  }, {
    "tStartMs": 463200,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "or even a data cable."
    } ]
  }, {
    "tStartMs": 466433,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Here is a hook."
    } ]
  }, {
    "tStartMs": 468833,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "This hook can hang your clothes, hats, and other things."
    } ]
  }, {
    "tStartMs": 472700,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "It must be something lighter,"
    } ]
  }, {
    "tStartMs": 475233,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "Because if it's heavy,"
    } ]
  }, {
    "tStartMs": 477200,
    "dDurationMs": 7500,
    "segs": [ {
      "utf8": "the conductor will come and ask you to take it down."
    } ]
  }, {
    "tStartMs": 484700,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "You can see a QR code on the armrest."
    } ]
  }, {
    "tStartMs": 486400,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "Are you curious?"
    } ]
  }, {
    "tStartMs": 487566,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Let's scan it."
    } ]
  }, {
    "tStartMs": 488800,
    "dDurationMs": 2166,
    "segs": [ {
      "utf8": "and see what it is."
    } ]
  }, {
    "tStartMs": 490966,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "Open this mini program interface."
    } ]
  }, {
    "tStartMs": 493533,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "you can see the train you are taking."
    } ]
  }, {
    "tStartMs": 496733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "its model and its"
    } ]
  }, {
    "tStartMs": 498933,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "business class, first class, and second class seats."
    } ]
  }, {
    "tStartMs": 502500,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "what these seats look like."
    } ]
  }, {
    "tStartMs": 517566,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The train we are taking is from"
    } ]
  }, {
    "tStartMs": 520466,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "from the north to the south of China."
    } ]
  }, {
    "tStartMs": 523933,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "and the scenery at each stop is also different."
    } ]
  }, {
    "tStartMs": 526966,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "You can see the vegetation outside the window,"
    } ]
  }, {
    "tStartMs": 530366,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "mountains,"
    } ]
  }, {
    "tStartMs": 531833,
    "dDurationMs": 6567,
    "segs": [ {
      "utf8": "scenery, and weather and climate are also different."
    } ]
  }, {
    "tStartMs": 644000,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "I'm back now."
    } ]
  }, {
    "tStartMs": 1226466,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "This is today's video."
    } ]
  }, {
    "tStartMs": 1229000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Thank you for riding the high-speed train with me"
    } ]
  }, {
    "tStartMs": 1232200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "If this video can help you,"
    } ]
  }, {
    "tStartMs": 1234600,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "I will be very happy."
    } ]
  }, {
    "tStartMs": 1236500,
    "dDurationMs": 1566,
    "segs": [ {
      "utf8": "See u next one 下次见！\nBe happy！❤😊"
    } ]
  } ]
}
