  }, {
    "tStartMs": 105700,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "你会看到座位号码a b c或d f"
    } ]
  }, {
    "tStartMs": 110733,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "在这些号码旁边会看到绿色黄色红色"
    } ]
  }, {
    "tStartMs": 116033,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "像这个座位"
    } ]
  }, {
    "tStartMs": 117300,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "它有三个绿色"
    } ]
  }, {
    "tStartMs": 118700,
    "dDurationMs": 4100,
    "segs": [ {
