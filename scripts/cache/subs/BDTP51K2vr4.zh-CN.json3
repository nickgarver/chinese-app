  }, {
    "tStartMs": 556333,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "我就会发现"
    } ]
  }, {
    "tStartMs": 557466,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "天呐 就是他听的歌"
