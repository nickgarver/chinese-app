  }, {
    "tStartMs": 575966,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "就我非常惊讶"
    } ]
  }, {
    "tStartMs": 577566,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "哈哈哈 是的"
    } ]
  }, {
    "tStartMs": 579200,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "我也不知道为什么"
    } ]
  }, {
    "tStartMs": 580233,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但是可能你在外面经常听到这些歌"
