  }, {
    "tStartMs": 660733,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "还有中文的新闻"
    } ]
  }, {
    "tStartMs": 663300,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "现在可能少一点了"
    } ]
  }, {
    "tStartMs": 665166,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "嗯 肯定是那时候稍微多一点"
    } ]
  }, {
    "tStartMs": 667933,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "包括和我的那时候的工作也有关系"
    } ]
  }, {
    "tStartMs": 671233,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "看一些文章什么的"
    } ]
  }, {
    "tStartMs": 672866,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "现在还有"
    } ]
  }, {
    "tStartMs": 673733,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "那是肯定没有那么多"
    } ]
  }, {
    "tStartMs": 675200,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "对 是的 我自己总结是这4个点"
    } ]
  }, {
    "tStartMs": 679666,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "那关于为什么你的发音这么好呢"
    } ]
  }, {
    "tStartMs": 684033,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "我觉得还是因为你爱模仿"
    } ]
  }, {
    "tStartMs": 687633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "还有什么原因 为什么你的发音这么好"
    } ]
  }, {
    "tStartMs": 691333,
    "dDurationMs": 1033,
    "segs": [ {
      "utf8": "发音这么好"
    } ]
  }, {
    "tStartMs": 692366,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "那可能是因为这个模仿的事情"
    } ]
  }, {
    "tStartMs": 695433,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "包括我也不知道为什么"
    } ]
  }, {
    "tStartMs": 697000,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "但是我自己发现"
    } ]
  }, {
    "tStartMs": 699766,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "我有一个很大的口音"
    } ]
  }, {
    "tStartMs": 701600,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "我就不太舒服"
    } ]
  }, {
    "tStartMs": 703933,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "我说英语什么的也是这样子"
    } ]
  }, {
    "tStartMs": 705966,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "我就希望我可以最越标准越好"
    } ]
  }, {
    "tStartMs": 710200,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "英语的话也是"
    } ]
  }, {
    "tStartMs": 712566,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "包括如果我和一个英语母语者说话"
    } ]
  }, {
    "tStartMs": 716266,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "那我也喜欢"
    } ]
  }, {
    "tStartMs": 717433,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "可能比较自然地"
    } ]
  }, {
    "tStartMs": 718933,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "适应到他的说话的方式"
    } ]
  }, {
    "tStartMs": 721866,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "如果是一个英国的英语口音"
    } ]
  }, {
    "tStartMs": 724800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "那我可能自己也会"
    } ]
  }, {
    "tStartMs": 726600,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "突然变成那种英式英语对吧"
    } ]
  }, {
    "tStartMs": 730533,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "对你这个调整哈"
    } ]
  }, {
    "tStartMs": 732833,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "对调整 如果是和一个美国的什么的"
    } ]
  }, {
    "tStartMs": 736766,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "我可能也会有这个变化"
    } ]
  }, {
    "tStartMs": 738933,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "在中国也是"
    } ]
  }, {
    "tStartMs": 740266,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "如果我和南方人说话"
    } ]
  }, {
    "tStartMs": 742000,
    "dDurationMs": 4233,
    "segs": [ {
      "utf8": "我的口音慢慢就会变成南方口音"
    } ]
  }, {
    "tStartMs": 746233,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "如果我和北方"
    } ]
  }, {
    "tStartMs": 747666,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "或者一般那种说普通话的人说话"
    } ]
  }, {
    "tStartMs": 750566,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我就是比较标准的普通话"
    } ]
  }, {
    "tStartMs": 752933,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "有点难说"
    } ]
  }, {
    "tStartMs": 754100,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "对 你之前还是台湾腔来着"
    } ]
  }, {
    "tStartMs": 756566,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "然后你到了北京"
    } ]
  }, {
    "tStartMs": 757633,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "就变成这种标准的普通话的样子"
    } ]
  }, {
    "tStartMs": 760866,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "对 是有一点点这样子"
    } ]
  }, {
    "tStartMs": 762533,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "当然不是完全会说这些方言什么的"
    } ]
  }, {
    "tStartMs": 766133,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "但是就有一点点这样子的口音"
    } ]
  }, {
    "tStartMs": 768166,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 768800,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "就是你受不了有口音"
    } ]
  }, {
    "tStartMs": 770766,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "所以你也会比较努力的"
    } ]
  }, {
    "tStartMs": 772566,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "让自己发各种语言都更标准"
    } ]
  }, {
    "tStartMs": 775766,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "有点吧"
    } ]
  }, {
    "tStartMs": 776400,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "有点好像是一个比较自然的东西"
    } ]
  }, {
    "tStartMs": 778533,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "我都不会自己选择这样"
    } ]
  }, {
    "tStartMs": 780866,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "但是我就自然的适应"
    } ]
  }, {
    "tStartMs": 783166,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "我不知道为什么"
    } ]
  }, {
    "tStartMs": 784600,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "那下一个问题就是"
    } ]
  }, {
    "tStartMs": 787133,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "中文好有为你的生活带来什么好处吗"
    } ]
  }, {
    "tStartMs": 791833,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "我先说一个"
    } ]
  }, {
    "tStartMs": 793066,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "哦 你说"
    } ]
  }, {
    "tStartMs": 793666,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "哈哈哈哈"
    } ]
  }, {
    "tStartMs": 796066,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "就是如果你的中文不好"
    } ]
  }, {
    "tStartMs": 799400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你就不会有这个老婆"
    } ]
  }, {
    "tStartMs": 801800,
    "dDurationMs": 5633,
    "segs": [ {
      "utf8": "就因为我在和你见面以前"
    } ]
  }, {
    "tStartMs": 807433,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我已经下定决心"
    } ]
  }, {
    "tStartMs": 809166,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "是我不要和一个不了解我的文化"
    } ]
  }, {
    "tStartMs": 812766,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "和不会说我语言的人在一起"
    } ]
  }, {
    "tStartMs": 815600,
    "dDurationMs": 3266,
    "segs": [ {
      "utf8": "所以我发现你的中文那么好的时候"
    } ]
  }, {
    "tStartMs": 818933,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "然后我我才会愿意和你去约会"
    } ]
  }, {
    "tStartMs": 822633,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "幸好我那时候也会说中文"
    } ]
  }, {
    "tStartMs": 826133,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "不然就没有没有这个老婆了是吧"
    } ]
  }, {
    "tStartMs": 828533,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "对 还没有这个孩子  啊也没有这个孩子"
    } ]
  }, {
    "tStartMs": 831533,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "对"
    } ]
  }, {
    "tStartMs": 832200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "然后我觉得这确实是一个很大的好处"
    } ]
  }, {
    "tStartMs": 835400,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "当然我们认识的是一个(好处)"
    } ]
  }, {
    "tStartMs": 837866,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "但是那时候肯定不是这个目的"
    } ]
  }, {
    "tStartMs": 840366,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "然后现在我们有一个孩子是吧"
    } ]
  }, {
    "tStartMs": 845233,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "然后她快三岁 然后她在学两种语言"
    } ]
  }, {
    "tStartMs": 849666,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "中文和德文"
    } ]
  }, {
    "tStartMs": 850833,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "然后我现在这个样子"
    } ]
  }, {
    "tStartMs": 852733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "我就无论我们在说什么语言"
    } ]
  }, {
    "tStartMs": 855333,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我都可以都会听得懂"
    } ]
  }, {
    "tStartMs": 857033,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "所以我觉得这是一个很大的好处"
    } ]
  }, {
    "tStartMs": 859333,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "但是除了这些个人的原因之外"
    } ]
  }, {
    "tStartMs": 861966,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "我觉得"
    } ]
  }, {
    "tStartMs": 863733,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "能够了解"
    } ]
  }, {
    "tStartMs": 865000,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "深入了解一个像中国对我来说"
    } ]
  }, {
    "tStartMs": 868800,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "那么陌生的一个地方"
    } ]
  }, {
    "tStartMs": 870533,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "刚开始陌生的地方"
    } ]
  }, {
    "tStartMs": 872200,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "我觉得是一个很大的优势"
    } ]
  }, {
    "tStartMs": 876133,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "如果你是不知道可能别的国家"
    } ]
  }, {
    "tStartMs": 881000,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "欧洲的国家什么的"
    } ]
  }, {
    "tStartMs": 882966,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "那可能很多人还是会说英语什么的"
    } ]
  }, {
    "tStartMs": 886666,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "你可能还会有很多"
    } ]
  }, {
    "tStartMs": 888433,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "关于这个国家的英语资源什么的"
    } ]
  }, {
    "tStartMs": 891000,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "可能都还可以"
    } ]
  }, {
    "tStartMs": 893166,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "但是在中国如果你不会中文的话"
    } ]
  }, {
    "tStartMs": 896333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "那你基本上没有办法深入了解"
    } ]
  }, {
    "tStartMs": 899133,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "那这其实也是可以回去我刚刚说的这个"
    } ]
  }, {
    "tStartMs": 901933,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "为什么开始学中文 那时候"
    } ]
  }, {
    "tStartMs": 905566,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "那就是因为我在那感觉"
    } ]
  }, {
    "tStartMs": 907833,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "如果你不会这个语言"
    } ]
  }, {
    "tStartMs": 910600,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "你肯定也可以在那玩的很开心"
    } ]
  }, {
    "tStartMs": 913266,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "但是你就在这个表面上"
    } ]
  }, {
    "tStartMs": 915600,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "你没有办法深入的了解"
    } ]
  }, {
    "tStartMs": 917566,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "就是其实中国是完全另外一个世界"
    } ]
  }, {
    "tStartMs": 921766,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "如果你不会中文的话"
    } ]
  }, {
    "tStartMs": 923466,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "你很难去探索到这个世界"
    } ]
  }, {
    "tStartMs": 925766,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "是的"
    } ]
  }, {
    "tStartMs": 926666,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "所以我觉得这就是一个很大的好处"
    } ]
  }, {
    "tStartMs": 929400,
    "dDurationMs": 4866,
    "segs": [ {
      "utf8": "然后我就很开心我做到了这个大任务"
    } ]
  }, {
    "tStartMs": 934466,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我们的孩儿来了"
    } ]
  }, {
    "tStartMs": 935766,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "对我们的孩儿来了"
    } ]
  }, {
    "tStartMs": 936966,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "好那最后一个呢"
    } ]
  }, {
    "tStartMs": 939766,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "就是你可以给学中文的人一些建议吗"
    } ]
  }, {
    "tStartMs": 944466,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "怎么学好中文"
    } ]
  }, {
    "tStartMs": 946266,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "okay首先我觉得如果你想学中文的话"
    } ]
  }, {
    "tStartMs": 949566,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "你就需要一个很大的动力"
    } ]
  }, {
    "tStartMs": 951833,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "我觉得"
    } ]
  }, {
    "tStartMs": 952533,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "因为作为最起码作为一个欧洲人"
    } ]
  }, {
    "tStartMs": 956166,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "或者一个西方人"
    } ]
  }, {
    "tStartMs": 957733,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "学中文的话就是一个很难的事情"
    } ]
  }, {
    "tStartMs": 960333,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "你肯定要花很多时间"
    } ]
  }, {
    "tStartMs": 962066,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "然后这个过程肯定会很痛苦"
    } ]
  }, {
    "tStartMs": 964466,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "我觉得是"
    } ]
  }, {
    "tStartMs": 965933,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "然后"
    } ]
  }, {
    "tStartMs": 967200,
    "dDurationMs": 5166,
    "segs": [ {
      "utf8": "如果你想怎么说熬过这个痛苦"
    } ]
  }, {
    "tStartMs": 972366,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "那你就必须有一个很强的目的"
    } ]
  }, {
    "tStartMs": 976000,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "或者一个很强的动力才行"
    } ]
  }, {
    "tStartMs": 978966,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "我刚刚已经说了一些我个人的动力"
    } ]
  }, {
    "tStartMs": 982766,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "但是可能每个人有自己的动力"
    } ]
  }, {
    "tStartMs": 985333,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "可能是跟个人方面有关系"
    } ]
  }, {
    "tStartMs": 989766,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "或者跟他们的事业有关系"
    } ]
  }, {
    "tStartMs": 992000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "或者可能和他们的 不知道"
    } ]
  }, {
    "tStartMs": 997000,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "旅行方式什么的都可以"
    } ]
  }, {
    "tStartMs": 999133,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "或者自己家庭可能也有中国人 谁知道"
    } ]
  }, {
    "tStartMs": 1002366,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "但是我觉得"
    } ]
  }, {
    "tStartMs": 1003733,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "有一只猫在树上"
    } ]
  }, {
    "tStartMs": 1007400,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "sorry"
    } ]
  }, {
    "tStartMs": 1008533,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "但是我觉得如果你有这个动力的话"
    } ]
  }, {
    "tStartMs": 1012400,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "就好"
    } ]
  }, {
    "tStartMs": 1013666,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "然后这样子你已经有一个很好的基础"
    } ]
  }, {
    "tStartMs": 1016600,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "从这个基础开始"
    } ]
  }, {
    "tStartMs": 1018233,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "我觉得你找一些你自己感兴趣的话题"
    } ]
  }, {
    "tStartMs": 1021566,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "或者你感兴趣的资源"
    } ]
  }, {
    "tStartMs": 1023933,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "然后你的这个学习的过程"
    } ]
  }, {
    "tStartMs": 1026866,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "会稍微舒服一点"
    } ]
  }, {
    "tStartMs": 1029066,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "不会那么的强迫学习"
    } ]
  }, {
    "tStartMs": 1031366,
    "dDurationMs": 1567,
    "segs": [ {
      "utf8": "多多使用这个语言"
    } ]
  }, {
    "tStartMs": 1033066,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "然后去一些有这个中文环境的地方"
    } ]
  }, {
    "tStartMs": 1037533,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "你可以去东南亚某一些地方"
    } ]
  }, {
    "tStartMs": 1039633,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "你可以中国大陆呀"
    } ]
  }, {
    "tStartMs": 1040866,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "你可以去台湾呀什么的 无所谓反正"
    } ]
  }, {
    "tStartMs": 1043833,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "或者你在美国什么的"
    } ]
  }, {
    "tStartMs": 1045466,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "去一个Chinatown都可以"
    } ]
  }, {
    "tStartMs": 1047366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "反正你就需要这个环境"
    } ]
  }, {
    "tStartMs": 1049266,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "那边是粤语和闽南语"
    } ]
  }, {
    "tStartMs": 1051566,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "哈哈哈那非常有可能啊"
    } ]
  }, {
    "tStartMs": 1053433,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "非常有可能"
    } ]
  }, {
    "tStartMs": 1054433,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "我觉得动力这个是真的"
    } ]
  }, {
    "tStartMs": 1057566,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "就为什么我学德语那么痛苦"
    } ]
  }, {
    "tStartMs": 1060533,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "然后进步很慢呢"
    } ]
  }, {
    "tStartMs": 1061966,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "是因为我完全没有动力"
    } ]
  }, {
    "tStartMs": 1064666,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "就我们认识这么多年"
    } ]
  }, {
    "tStartMs": 1067066,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "完全没有动力？哈哈哈"
    } ]
  }, {
    "tStartMs": 1069800,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "就一直说中文我们甚至英语都不说"
    } ]
  }, {
    "tStartMs": 1072766,
    "dDurationMs": 3034,
    "segs": [ {
      "utf8": "所以我就一直觉得不是很有必要"
    } ]
  }, {
    "tStartMs": 1075833,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "然后在柏林也是"
    } ]
  }, {
    "tStartMs": 1077333,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "说英语你也可以活下去"
    } ]
  }, {
    "tStartMs": 1079166,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "所以我就是因为没有太大的动力"
    } ]
  }, {
    "tStartMs": 1082266,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "所以我就一直进步很慢"
    } ]
  }, {
    "tStartMs": 1085466,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "嗯是的 然后我觉得"
    } ]
  }, {
    "tStartMs": 1087833,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "如果想真正的学习这个语言"
    } ]
  }, {
    "tStartMs": 1090666,
    "dDurationMs": 4867,
    "segs": [ {
      "utf8": "最好去那待一年左右什么的最少"
    } ]
  }, {
    "tStartMs": 1095600,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "然后就慢慢的适应这个环境"
    } ]
  }, {
    "tStartMs": 1098733,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "那这样进步肯定是最快的"
    } ]
  }, {
    "tStartMs": 1101666,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "然后你发现你的进步快"
    } ]
  }, {
    "tStartMs": 1104200,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "你的动力也会更强"
    } ]
  }, {
    "tStartMs": 1106600,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "那今天的视频就要结束了"
    } ]
  }, {
    "tStartMs": 1109333,
    "dDurationMs": 2467,
    "segs": [ {
      "utf8": "我们的孩子要跑过来了"
    } ]
  }, {
    "tStartMs": 1111866,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "那就拜拜了"
    } ]
  }, {
    "tStartMs": 1114033,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "拜拜"
    } ]
  }, {
    "tStartMs": 1115200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "bye bye 加油"
    } ]
  }, {
    "tStartMs": 1118666,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "加油学中文"
    } ]
  }, {
    "tStartMs": 1120066,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "jiayouchinese"
    } ]
  }, {
    "tStartMs": 1124266,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "if you'd like to support my work you can join as a YouTube member"
    } ]
  }, {
    "tStartMs": 1128600,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "you'll get early access to new videos"
    } ]
  }, {
    "tStartMs": 1131233,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "full transcripts and core vocabulary in pinyin"
    } ]
  }, {
    "tStartMs": 1134466,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Chinese and English as well as audio files"
    } ]
  }, {
    "tStartMs": 1137933,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "your support means a lot to me"
    } ]
  } ]
}
