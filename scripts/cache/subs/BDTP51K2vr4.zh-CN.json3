  }, {
    "tStartMs": 562933,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "这些非常经典的歌"
    } ]
  }, {
    "tStartMs": 564800,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "甚至他知道的歌比我知道的还要更多"
