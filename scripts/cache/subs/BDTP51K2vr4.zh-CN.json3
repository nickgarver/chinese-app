{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 200,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "如果你的中文不好"
    } ]
  }, {
    "tStartMs": 2200,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "你就不会有这个老婆"
    } ]
  }, {
    "tStartMs": 5000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我有时候就接电话"
    } ]
  }, {
    "tStartMs": 6600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "然后我说话"
    } ]
  }, {
    "tStartMs": 7433,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "他们完全不知道我是外国人"
    } ]
  }, {
    "tStartMs": 9400,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "经常我用中文和他吵架"
    } ]
  }, {
    "tStartMs": 12000,
    "dDurationMs": 1766,
    "segs": [ {
      "utf8": "嗯...我吵不赢"
    } ]
  }, {
    "tStartMs": 13933,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "你整个学习中文的过程"
    } ]
  }, {
    "tStartMs": 16333,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "大概就是两两三年是吧"
    } ]
  }, {
    "tStartMs": 19266,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "啊对差不多"
    } ]
  }, {
    "tStartMs": 20733,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "大家好我是佳佳"
    } ]
  }, {
    "tStartMs": 24133,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "今天我们要聊的话题是怎么学好中文"
    } ]
  }, {
    "tStartMs": 30366,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "当然不是我来聊这个话题"
    } ]
  }, {
    "tStartMs": 34566,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "因为中文是我的母语"
    } ]
  }, {
    "tStartMs": 37833,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "我邀请了一位嘉宾"
    } ]
  }, {
    "tStartMs": 40866,
    "dDurationMs": 6667,
    "segs": [ {
      "utf8": "那他是我认识的这么多外国朋友当中"
    } ]
  }, {
    "tStartMs": 47533,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "中文最好的"
    } ]
  }, {
    "tStartMs": 49400,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "发音最好的一个外国人"
    } ]
  }, {
    "tStartMs": 53633,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "那他就是"
    } ]
  }, {
    "tStartMs": 56800,
    "dDurationMs": 966,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 59233,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "大家好"
    } ]
  }, {
    "tStartMs": 60166,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "他就是我的老公Simon"
    } ]
  }, {
    "tStartMs": 64366,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "你好 大家好"
    } ]
  }, {
    "tStartMs": 65633,
    "dDurationMs": 5033,
    "segs": [ {
      "utf8": "在上一次我们发完了亚琛的视频以后"
    } ]
  }, {
    "tStartMs": 70733,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "下面好多的评论在夸你的中文好"
    } ]
  }, {
    "tStartMs": 74933,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "然后很多人也很好奇"
    } ]
  }, {
    "tStartMs": 78000,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "你是怎么学中文的"
    } ]
  }, {
    "tStartMs": 80566,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "所以今天我们和大家来聊一聊这个话题"
    } ]
  }, {
    "tStartMs": 84833,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "好的 没问题"
    } ]
  }, {
    "tStartMs": 85933,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "哈哈 那我们开始吧"
    } ]
  }, {
    "tStartMs": 87366,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "首先来说一下"
    } ]
  }, {
    "tStartMs": 89266,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "你的中文现在是什么水平"
    } ]
  }, {
    "tStartMs": 92733,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "这个很难说"
    } ]
  }, {
    "tStartMs": 94133,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "但是我上次考了一个中文考试"
    } ]
  }, {
    "tStartMs": 96733,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "那就是HSK六级的"
    } ]
  }, {
    "tStartMs": 98933,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "可能是三四年前左右吧"
    } ]
  }, {
    "tStartMs": 101833,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "嗯对 就是官方的水平呢"
    } ]
  }, {
    "tStartMs": 104466,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "是HSK6"
    } ]
  }, {
    "tStartMs": 106333,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "因为他考的时候还没有更新到HSK9"
    } ]
  }, {
    "tStartMs": 110866,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "对不对"
    } ]
  }, {
    "tStartMs": 111400,
    "dDurationMs": 666,
    "segs": [ {
      "utf8": "嗯是的"
    } ]
  }, {
    "tStartMs": 112066,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "嗯对"
    } ]
  }, {
    "tStartMs": 113066,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "那他的中文到底有多好呢"
    } ]
  }, {
    "tStartMs": 115766,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "我可以给大家一些例子"
    } ]
  }, {
    "tStartMs": 118533,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "因为我和他生活了这么多年 对吧"
    } ]
  }, {
    "tStartMs": 122866,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "然后呢 就有几几个具体的情况"
    } ]
  }, {
    "tStartMs": 127000,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "比如说我和他在成都生活的时候"
    } ]
  }, {
    "tStartMs": 131566,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "就每一次出去他都会被夸"
    } ]
  }, {
    "tStartMs": 135166,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "就比如说出租车司机"
    } ]
  }, {
    "tStartMs": 138066,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "然后餐厅的服务员都会夸你的中文好"
    } ]
  }, {
    "tStartMs": 142466,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "嗯对"
    } ]
  }, {
    "tStartMs": 143400,
    "dDurationMs": 2633,
    "segs": [ {
      "utf8": "这个还是经常经常遇到的"
    } ]
  }, {
    "tStartMs": 146033,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "不过好像很多外国人都有这个经验"
    } ]
  }, {
    "tStartMs": 148766,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "就是说一个什么\"你好 谢谢\"什么的"
    } ]
  }, {
    "tStartMs": 151166,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "然后就"
    } ]
  }, {
    "tStartMs": 152000,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "哇 你的中文这么好"
    } ]
  }, {
    "tStartMs": 153433,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "好厉害哦"
    } ]
  }, {
    "tStartMs": 155133,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "对 但是在四川有一点不一样"
    } ]
  }, {
    "tStartMs": 158533,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "因为大家都是说四川话"
    } ]
  }, {
    "tStartMs": 160800,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "然后很多老一辈的四川人"
    } ]
  }, {
    "tStartMs": 164166,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "他其实普通话不太好"
    } ]
  }, {
    "tStartMs": 166566,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "所以我们在成都的时候"
    } ]
  }, {
    "tStartMs": 169033,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "很多人对他说"
    } ]
  }, {
    "tStartMs": 171200,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "你的普通话比我还要标准"
    } ]
  }, {
    "tStartMs": 173633,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "你说的太标准了这样的"
    } ]
  }, {
    "tStartMs": 176233,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "啊是的"
    } ]
  }, {
    "tStartMs": 177033,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "这偶尔还是会有"
    } ]
  }, {
    "tStartMs": 178200,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "但是可能就是"
    } ]
  }, {
    "tStartMs": 179000,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "就是跟这个普通话的这个发音有关系"
    } ]
  }, {
    "tStartMs": 183433,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "应该不是词汇什么的"
    } ]
  }, {
    "tStartMs": 184666,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "对就我们还是有川普（四川普通话）"
    } ]
  }, {
    "tStartMs": 187766,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "然后还有一个例子"
    } ]
  }, {
    "tStartMs": 189633,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "比如说"
    } ]
  }, {
    "tStartMs": 190933,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "就我们在成都经常点外卖"
    } ]
  }, {
    "tStartMs": 193633,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "然后经常外卖员给他打电话"
    } ]
  }, {
    "tStartMs": 196533,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "他们沟通 沟通 沟通"
    } ]
  }, {
    "tStartMs": 198600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "最后开门的时候"
    } ]
  }, {
    "tStartMs": 200200,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "外卖员发现 啊"
    } ]
  }, {
    "tStartMs": 201833,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "你是个老外呀"
    } ]
  }, {
    "tStartMs": 203033,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "我还以为是个老中"
    } ]
  }, {
    "tStartMs": 205000,
    "dDurationMs": 2766,
    "segs": [ {
      "utf8": "是的这个刚开始还有点难"
    } ]
  }, {
    "tStartMs": 207966,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "因为我的发音我觉得比较早"
    } ]
  }, {
    "tStartMs": 209966,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "已经还可以了"
    } ]
  }, {
    "tStartMs": 211366,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "然后我有时候就接电话"
    } ]
  }, {
    "tStartMs": 213166,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "然后我说话"
    } ]
  }, {
    "tStartMs": 214000,
    "dDurationMs": 1933,
    "segs": [ {
      "utf8": "他们完全不知道我是外国人"
    } ]
  }, {
    "tStartMs": 215933,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "然后他们说的很快"
    } ]
  }, {
    "tStartMs": 217333,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我就听不太清楚"
    } ]
  }, {
    "tStartMs": 218833,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "然后有时候有点难"
    } ]
  }, {
    "tStartMs": 220166,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "因为他们以为我是中国人"
    } ]
  }, {
    "tStartMs": 222933,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "但是本来不是"
    } ]
  }, {
    "tStartMs": 225266,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "然后还有一个例子就是"
    } ]
  }, {
    "tStartMs": 227366,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "我是中国人  对吧"
    } ]
  }, {
    "tStartMs": 230100,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "但是经常我用中文和他吵架"
    } ]
  }, {
    "tStartMs": 233566,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "嗯...我吵不赢"
    } ]
  }, {
    "tStartMs": 236766,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "那我还没有什么可以加的吧"
    } ]
  }, {
    "tStartMs": 239966,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "哈哈哈 我可能本来就比较喜欢吵架"
    } ]
  }, {
    "tStartMs": 243633,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "或者辩论嗯"
    } ]
  }, {
    "tStartMs": 244933,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "good for you"
    } ]
  }, {
    "tStartMs": 245600,
    "dDurationMs": 1133,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 246733,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "接下来"
    } ]
  }, {
    "tStartMs": 247333,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "我们来聊一聊你学中文的经历吧"
    } ]
  }, {
    "tStartMs": 251200,
    "dDurationMs": 1433,
    "segs": [ {
      "utf8": "就是你怎么开始的"
    } ]
  }, {
    "tStartMs": 252633,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "然后学了什么 这样的"
    } ]
  }, {
    "tStartMs": 255133,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "是的我刚开始就是"
    } ]
  }, {
    "tStartMs": 257266,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "可能从我第一次去台湾的时候要开始"
    } ]
  }, {
    "tStartMs": 261033,
    "dDurationMs": 2233,
    "segs": [ {
      "utf8": "那个时候我还完全不会中文"
    } ]
  }, {
    "tStartMs": 263266,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "那时候我其实也没有学中文的兴趣"
    } ]
  }, {
    "tStartMs": 267033,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "因为我以为我就在那半年左右读书"
    } ]
  }, {
    "tStartMs": 270766,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "然后就回国"
    } ]
  }, {
    "tStartMs": 272166,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "可能再也没有机会说中文"
    } ]
  }, {
    "tStartMs": 274666,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "所以那时候我就完全不想学习"
    } ]
  }, {
    "tStartMs": 277600,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "但是后面我就很喜欢在这边的生活"
    } ]
  }, {
    "tStartMs": 280833,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "包括这个文化呀历史呀什么的"
    } ]
  }, {
    "tStartMs": 285633,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "而且经济那么动态"
    } ]
  }, {
    "tStartMs": 287400,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "所以我觉得非常的活跃"
    } ]
  }, {
    "tStartMs": 289766,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "我就觉得很有意思"
    } ]
  }, {
    "tStartMs": 291133,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "然后我就决定我要再次来"
    } ]
  }, {
    "tStartMs": 295000,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "可能在那上班或者实习"
    } ]
  }, {
    "tStartMs": 298733,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "或者什么再来读书"
    } ]
  }, {
    "tStartMs": 300800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "然后那时候就决定如果我再次来的话"
    } ]
  }, {
    "tStartMs": 304000,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "我一定要学中文"
    } ]
  }, {
    "tStartMs": 305466,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "所以我可以比较深入了解这个文化"
    } ]
  }, {
    "tStartMs": 308233,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "这个地方"
    } ]
  }, {
    "tStartMs": 309766,
    "dDurationMs": 2767,
    "segs": [ {
      "utf8": "那时候我就开始自学了"
    } ]
  }, {
    "tStartMs": 312533,
    "dDurationMs": 1867,
    "segs": [ {
      "utf8": "后面也上课 对吧"
    } ]
  }, {
    "tStartMs": 314400,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "但是上课的时间可能"
    } ]
  }, {
    "tStartMs": 316966,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "大概一两年左右"
    } ]
  }, {
    "tStartMs": 318933,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "主要在台湾和北京"
    } ]
  }, {
    "tStartMs": 321366,
    "dDurationMs": 2867,
    "segs": [ {
      "utf8": "然后那个时候可能进步是最大的"
    } ]
  }, {
    "tStartMs": 324266,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "语言环境当然很重要"
    } ]
  }, {
    "tStartMs": 327466,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "但是不是每一个人都有机会"
    } ]
  }, {
