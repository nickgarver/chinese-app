  "events": [ {
    "tStartMs": 287,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "你们好，我是 Jade。\nnǐ men hǎo， wǒ shì Jade。\nHello, I’m Jade."
    } ]
  }, {
    "tStartMs": 3279,
    "dDurationMs": 2406,
    "segs": [ {
      "utf8": "我现在在厨房，\nwǒ xiàn zài zài chú fáng，\nI’m in the kitchen right now,"
    } ]
  }, {
    "tStartMs": 5967,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "厨房。这里是厨房，\nchú fáng。 zhè lǐ shì chú fáng，\nthe kitchen. This is the kitchen,"
    } ]
  }, {
    "tStartMs": 10207,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "我在家里的厨房。\nwǒ zài jiā lǐ de chú fáng。\nI’m in the kitchen at home."
    } ]
  }, {
    "tStartMs": 13087,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "因为我准备自己煮点东西吃。\nyīn wèi wǒ zhǔn bèi zì jǐ zhǔ diǎn dōng xī chī。\nbecause I’m preparing to cook something for myself."
    } ]
  }, {
    "tStartMs": 18207,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "我现在肚子很饿，\nwǒ xiàn zài dǔ zi hěn è，\nI’m really hungry right now,"
    } ]
  }, {
    "tStartMs": 22287,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我肚子饿了，\nwǒ dǔ zi è le，\nI’m hungry,"
    } ]
  }, {
    "tStartMs": 24127,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "很想吃东西。\nhěn xiǎng chī dōng xī。\nand I really want to eat something."
    } ]
  }, {
    "tStartMs": 26573,
    "dDurationMs": 3315,
    "segs": [ {
      "utf8": "我打算自己煮点吃的。\nwǒ dǎ suàn zì jǐ zhǔ diǎn chī de。\nI’m planning to cook something for myself."
    } ]
  }, {
    "tStartMs": 30607,
    "dDurationMs": 2398,
    "segs": [ {
      "utf8": "那我要煮什么呢？\nnà wǒ yào zhǔ shén me ne ？\nSo what am I going to cook?"
    } ]
  }, {
    "tStartMs": 33407,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "就是螺丝粉。\njiù shì luó sī fěn。\nIt’s luosifen."
    } ]
  }, {
    "tStartMs": 36527,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "螺丝粉，它是一种米粉。\nluó sī fěn， tā shì yī zhǒng mǐ fěn。\nLuosifen is a type of rice noodle."
    } ]
  }, {
    "tStartMs": 40687,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "米粉，它的味道很特别，\nmǐ fěn， tā de wèi dào hěn tè bié，\nRice noodles have a very distinctive flavor,"
    } ]
  }, {
    "tStartMs": 44847,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "味道很特别的一种米粉叫做\nwèi dào hěn tè bié de yī zhǒng mǐ fěn jiào zuò\na type of rice noodle with a very distinctive flavor is called"
    } ]
  }, {
    "tStartMs": 49334,
    "dDurationMs": 2393,
    "segs": [ {
      "utf8": "螺蛳粉。好了，\nluó sī fěn。 hǎo le，\nluosifen. Okay,"
    } ]
  }, {
    "tStartMs": 52047,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "我现在要开始煮螺丝粉。\nwǒ xiàn zài yào kāi shǐ zhǔ luó sī fěn。\nI’m going to start cooking luosifen now."
    } ]
  }, {
    "tStartMs": 59721,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "这是一个锅，\nzhè shì yí gè guō，\nThis is a pot,"
    } ]
  }, {
    "tStartMs": 62441,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "一个小锅，它不大，\nyí gè xiǎo guō， tā bù dà，\na small pot. It’s not big,"
    } ]
  }, {
    "tStartMs": 66281,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "它比较小，\ntā bǐ jiào xiǎo，\nit’s relatively small,"
    } ]
  }, {
    "tStartMs": 68361,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "所以是一个小的锅。\nsuǒ yǐ shì yí gè xiǎo de guō。\nso it’s a small pot."
