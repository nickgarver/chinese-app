  }, {
    "tStartMs": 18166,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "如果你對此感興趣"
    } ]
  }, {
    "tStartMs": 19800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "那就千萬不要錯過"
    } ]
  }, {
    "tStartMs": 23566,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "不 知道"
    } ]
  }, {
    "tStartMs": 25333,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "大家"
    } ]
  }, {
    "tStartMs": 27833,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "有沒有"
    } ]
  }, {
    "tStartMs": 29200,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "看過"
    } ]
  }, {
    "tStartMs": 31266,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "我上一"
    } ]
  }, {
    "tStartMs": 33866,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "期 的視頻呢"
    } ]
  }, {
    "tStartMs": 37900,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "Laduree Macaron馬卡龍形狀的物品"
    } ]
  }, {
    "tStartMs": 40966,
    "dDurationMs": 1767,
    "segs": [ {
      "utf8": "到底是什麼呢"
    } ]
  }, {
    "tStartMs": 43566,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "很遺憾哦"
    } ]
  }, {
    "tStartMs": 44633,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "直到目前為止"
    } ]
  }, {
    "tStartMs": 45933,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "沒有任何人回答正確"
    } ]
  }, {
    "tStartMs": 48566,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "但是有一位朋友提到了肥皂"
    } ]
  }, {
    "tStartMs": 52666,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "已經很接近了"
    } ]
  }, {
    "tStartMs": 54133,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "它和任何的cosmetic不相關"
    } ]
  }, {
    "tStartMs": 57333,
    "dDurationMs": 367,
    "segs": [ {
      "utf8": "哈哈"
    } ]
  }, {
    "tStartMs": 57700,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "完全不相關啊"
    } ]
  }, {
    "tStartMs": 59166,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我覺得上一期的視頻呢"
    } ]
  }, {
    "tStartMs": 60666,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "我好像沒有展示的很清楚"
    } ]
  }, {
    "tStartMs": 62766,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "我 給大家再看一下"
