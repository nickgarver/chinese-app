  }, {
    "tStartMs": 163766,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "聊 呢"
    } ]
  }, {
    "tStartMs": 167766,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "Kitty呢"
