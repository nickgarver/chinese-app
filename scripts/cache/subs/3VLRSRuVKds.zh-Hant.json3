  }, {
    "tStartMs": 100566,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "哈哈哈"
    } ]
  }, {
    "tStartMs": 101400,
    "dDurationMs": 366,
    "segs": [ {
      "utf8": "所以呢"
    } ]
  }, {
    "tStartMs": 101766,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "這個是橡皮擦哦"
