  }, {
    "tStartMs": 91566,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "英國的叫法不太一樣"
    } ]
  }, {
    "tStartMs": 94066,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "現在大家用鉛筆的情況多嗎"
    } ]
  }, {
    "tStartMs": 97333,
    "dDurationMs": 3233,
    "segs": [ {
      "utf8": "小學的小朋友應該用的是比較多的"
