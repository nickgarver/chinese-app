  }, {
    "tStartMs": 66266,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "它是硬擦"
    } ]
  }, {
    "tStartMs": 67733,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "的它不是那種要"
