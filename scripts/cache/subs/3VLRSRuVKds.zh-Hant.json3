  }, {
    "tStartMs": 69566,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "軟的它"
    } ]
  }, {
    "tStartMs": 72466,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "是那種要"
    } ]
  }, {
    "tStartMs": 74566,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "軟"
    } ]
  }, {
    "tStartMs": 76233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "的"
    } ]
  }, {
    "tStartMs": 81166,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "它"
