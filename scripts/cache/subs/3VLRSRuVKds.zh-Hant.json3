  }, {
    "tStartMs": 85133,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "我小時候學英文"
    } ]
  }, {
    "tStartMs": 86800,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "橡皮擦的英文是叫Eraser"
