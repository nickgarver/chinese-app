{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "他平常可能沒在照顧"
    } ]
  }, {
    "tStartMs": 1334,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "照顧可能是"
    } ]
  }, {
    "tStartMs": 1868,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "另外一個家人"
    } ]
  }, {
    "tStartMs": 3136,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "死掉之後"
    } ]
  }, {
    "tStartMs": 4004,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "比較沒照顧的人就會說"
    } ]
  }, {
    "tStartMs": 7307,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "所以我需要做解剖"
    } ]
  }, {
    "tStartMs": 8241,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "可是你看這個老人"
    } ]
  }, {
    "tStartMs": 9709,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "可能就已經"
    } ]
  }, {
    "tStartMs": 10577,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "80~90 歲 100 歲了"
    } ]
  }, {
    "tStartMs": 11711,
    "dDurationMs": 768,
    "segs": [ {
      "utf8": "這時候我再做解剖"
    } ]
  }, {
    "tStartMs": 12479,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "我就覺得這個人就是"
    } ]
  }, {
    "tStartMs": 14314,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "已經年紀到了"
    } ]
  }, {
    "tStartMs": 15248,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "對 年紀到該走了"
    } ]
  }, {
    "tStartMs": 16282,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "其實只是為了"
    } ]
  }, {
    "tStartMs": 17083,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "子孫們在那邊吵"
    } ]
  }, {
    "tStartMs": 18118,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "然後你就覺得"
    } ]
  }, {
    "tStartMs": 18718,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "做這個案件\n到底為了什麼"
    } ]
  }, {
    "tStartMs": 20120,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "解剖遺體"
    } ]
  }, {
    "tStartMs": 21221,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "其實是一個論件計酬的"
    } ]
  }, {
    "tStartMs": 21855,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "其實是一個論件計酬的"
    } ]
  }, {
    "tStartMs": 23390,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "這是真的嗎"
    } ]
  }, {
    "tStartMs": 24357,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "如果你去查的話"
    } ]
  }, {
    "tStartMs": 25158,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "就發現說"
    } ]
  }, {
    "tStartMs": 25759,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "專任跟兼任價錢"
    } ]
  }, {
    "tStartMs": 26726,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "給的是不一樣的"
    } ]
  }, {
    "tStartMs": 29996,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "差到 3 倍"
    } ]
  }, {
    "tStartMs": 31031,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 47847,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "Hiho 大家好 我是志祺"
    } ]
  }, {
    "tStartMs": 49149,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "歡迎回到強者我朋友"
    } ]
  }, {
    "tStartMs": 50383,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "屍體真的會說話嗎"
    } ]
  }, {
    "tStartMs": 51651,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "法醫究竟要怎麼樣分辨一個人是自殺 他殺"
    } ]
  }, {
    "tStartMs": 54554,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "還是意外身亡"
    } ]
  }, {
    "tStartMs": 55755,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "又要怎麼樣從看似毫不起眼的傷"
    } ]
  }, {
    "tStartMs": 57924,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "拼湊出死者生前的最後遭遇"
    } ]
  }, {
    "tStartMs": 60660,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "真實生活當中的法醫"
    } ]
  }, {
    "tStartMs": 61828,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "真的會如同影集演的那麼神嗎"
    } ]
  }, {
    "tStartMs": 64497,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "今天我們邀請到了張晏維法醫一起來聊聊"
    } ]
  }, {
    "tStartMs": 67100,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "晏維是法務部法醫研究所病理組副研究員"
    } ]
  }, {
    "tStartMs": 70703,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "我們要來問問晏維法醫究竟都在做些什麼"
    } ]
  }, {
    "tStartMs": 73673,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "如何透過遺體判斷死因"
    } ]
  }, {
    "tStartMs": 75809,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "以及台灣法醫制度究竟出了什麼樣的問題"
    } ]
  }, {
    "tStartMs": 78845,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "不過在開始之前先讓我們進一段工商服務時間"
    } ]
  }, {
    "tStartMs": 136402,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "好 一開始請張法醫先跟我們觀眾打個招呼吧"
    } ]
  }, {
    "tStartMs": 138872,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "志祺你好"
    } ]
  }, {
    "tStartMs": 139506,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "各位強者我朋友的觀眾朋友大家好"
    } ]
  }, {
    "tStartMs": 142142,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "我是張晏維法醫師"
    } ]
  }, {
    "tStartMs": 143443,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "等一下我們應該怎麼稱呼你比較好"
    } ]
  }, {
    "tStartMs": 145245,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "叫我綽號叫小菊好了"
    } ]
  }, {
    "tStartMs": 146546,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "一開始我想先問問小菊"
    } ]
  }, {
    "tStartMs": 147847,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "就是你當法醫多久了"
    } ]
  }, {
    "tStartMs": 149682,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "從事法醫大概 4 年多"
    } ]
  }, {
    "tStartMs": 151584,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "你到目前為止是解剖過多少具的遺體了呢"
    } ]
  }, {
    "tStartMs": 155188,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "應該快 1000 件了"
    } ]
  }, {
    "tStartMs": 156956,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "1000 件"
    } ]
  }, {
    "tStartMs": 157991,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "對 在台灣來說"
    } ]
  }, {
    "tStartMs": 159425,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "所以基本上每天都一個"
    } ]
  }, {
    "tStartMs": 161261,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "沒有 因為我們通常案件是照排的"
    } ]
  }, {
    "tStartMs": 163997,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "有時候就會一天做 2~3 件"
    } ]
  }, {
    "tStartMs": 165698,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "有時候就不用出去"
    } ]
  }, {
    "tStartMs": 166900,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "可是要留下來寫報告"
    } ]
  }, {
    "tStartMs": 168568,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "好 等等我們是想要請小菊"
    } ]
  }, {
    "tStartMs": 170370,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "跟我們完整地介紹一下"
    } ]
  }, {
    "tStartMs": 172038,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "就是法醫工作到底怎麼進行"
    } ]
  }, {
    "tStartMs": 174040,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "然後要如何透過傷口來判斷凶器這樣子"
    } ]
  }, {
    "tStartMs": 177410,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "一開始我們先跟大家打一下預防針"
    } ]
  }, {
    "tStartMs": 179546,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "因為今天這集的一開始"
    } ]
  }, {
    "tStartMs": 181681,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "會有一些讓人比較不舒服的這種傷口的畫面"
    } ]
  }, {
    "tStartMs": 185151,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "如果大家是對這種比較敏感的觀眾的話"
    } ]
  }, {
    "tStartMs": 187954,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "可以建議就斟酌收看"
    } ]
  }, {
    "tStartMs": 189656,
    "dDurationMs": 2869,
    "segs": [ {
      "utf8": "不想看的 觀眾也可以跳到這個時間點去"
    } ]
  }, {
    "tStartMs": 192525,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "好 一開始我們先從這個"
    } ]
  }, {
    "tStartMs": 194160,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "法醫病理學的教科書上面"
    } ]
  }, {
    "tStartMs": 196029,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "挑選了幾張傷口照片"
    } ]
  }, {
    "tStartMs": 198097,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "我們請小菊來幫我們判斷一下"
    } ]
  }, {
    "tStartMs": 202001,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "第一個"
    } ]
  }, {
    "tStartMs": 203102,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "這個覺得會是什麼造成的呢"
    } ]
  }, {
    "tStartMs": 205405,
    "dDurationMs": 3069,
    "segs": [ {
      "utf8": "因為通常我們對傷口的評估來說"
    } ]
  }, {
    "tStartMs": 208474,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "都會是先去描述它損傷的程度"
    } ]
  }, {
    "tStartMs": 211177,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "然後它的外觀"
    } ]
  }, {
    "tStartMs": 212478,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "它沒有辦法直接從傷口對應到某個凶器"
    } ]
  }, {
    "tStartMs": 215381,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "除非你現場有擺出幾個凶器"
    } ]
  }, {
    "tStartMs": 217183,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "讓我們去對應這樣子"
    } ]
  }, {
    "tStartMs": 219018,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "對 所以像這一個來說"
    } ]
  }, {
    "tStartMs": 220253,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "我可能會說以這個角度來說"
    } ]
  }, {
    "tStartMs": 222455,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "大概是 1 點鐘方向"
    } ]
  }, {
    "tStartMs": 223556,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "看起來稍微是比較尖端一點"
    } ]
  }, {
    "tStartMs": 225725,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "7 點鐘方向算是鈍端"
    } ]
  }, {
    "tStartMs": 227393,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "它是個長條形的東西"
    } ]
  }, {
    "tStartMs": 229128,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "它的深度大概就只是破壞到皮膚層"
    } ]
  }, {
    "tStartMs": 231631,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "可以看到下面的皮下的組織"
    } ]
  }, {
    "tStartMs": 233533,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "然後沒有一些什麼藕斷絲連的那種組織"
    } ]
  }, {
    "tStartMs": 235668,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "所以看起來比較像是個銳器傷"
    } ]
  }, {
    "tStartMs": 237637,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "但是就只能到此了"
    } ]
  }, {
    "tStartMs": 239305,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "但其實已經很精準了"
    } ]
  }, {
    "tStartMs": 240607,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "答案是單刃刀"
    } ]
  }, {
    "tStartMs": 242442,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "這跟剛剛描述的東西非常地相似"
    } ]
  }, {
    "tStartMs": 244611,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "單刃刀我本來預期它可能會更深什麼的"
    } ]
  }, {
    "tStartMs": 247013,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "圖上沒辦法看到深度的部分"
    } ]
  }, {
    "tStartMs": 248648,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "所以這部分就沒有辦法做評估"
    } ]
  }, {
    "tStartMs": 250817,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "我們再來看看下一張圖"
    } ]
  }, {
    "tStartMs": 254287,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "這個完全看不出來是什麼"
    } ]
  }, {
    "tStartMs": 256589,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "對 這個是教科書上面的圖"
    } ]
  }, {
    "tStartMs": 259592,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "這是教科書上面的圖"
    } ]
  }, {
    "tStartMs": 261027,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "你看得出來這是什麼嗎"
    } ]
  }, {
    "tStartMs": 262729,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "好 首先這個圖一樣就是它是皮膚的一個傷口"
    } ]
  }, {
    "tStartMs": 266065,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "這張是比較偏向黑色的部分"
    } ]
  }, {
    "tStartMs": 267800,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "所以我會認為說這個傷口被發現的時候"
    } ]
  }, {
    "tStartMs": 269769,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "應該是已經有一段時間了"
    } ]
  }, {
    "tStartMs": 271838,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "就是有腐敗的過程"
    } ]
  }, {
    "tStartMs": 273506,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "在 6 點鐘方向相對是比較尖端的"
    } ]
  }, {
    "tStartMs": 275975,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "12 點鐘相對比較鈍端的"
    } ]
  }, {
    "tStartMs": 277644,
    "dDurationMs": 3637,
    "segs": [ {
      "utf8": "所以它其實也是一個比較像是有單邊比較銳利"
    } ]
  }, {
    "tStartMs": 281281,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "另外一邊比較鈍端的東西"
    } ]
  }, {
    "tStartMs": 283049,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "一樣只能看到說它是個皮下組織有損傷的情況"
    } ]
  }, {
    "tStartMs": 286085,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "我還能夠看出這應該是腳毛"
    } ]
  }, {
    "tStartMs": 288154,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "大概是"
    } ]
  }, {
    "tStartMs": 289756,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "腿部"
    } ]
  }, {
    "tStartMs": 290990,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "對 腿部倒是蠻有可能的"
    } ]
  }, {
    "tStartMs": 292759,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "好 這一題的答案是剪刀"
    } ]
  }, {
    "tStartMs": 294894,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "我之前有遇過剪刀的案件"
    } ]
  }, {
    "tStartMs": 296663,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "有的是兩個刃打開的刺"
    } ]
  }, {
    "tStartMs": 299065,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "所以它會變的是一個兩個洞"
    } ]
  }, {
    "tStartMs": 300633,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "合在一起就變一個洞"
    } ]
  }, {
    "tStartMs": 302502,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "剪刀傷口形狀的複雜度其實很高"
    } ]
  }, {
    "tStartMs": 304737,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "對 就是他怎麼拿跟怎麼刺會有不同的形狀"
    } ]
  }, {
    "tStartMs": 308074,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "再來圖 3"
    } ]
  }, {
    "tStartMs": 309208,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "我們來看一下下一張"
    } ]
  }, {
    "tStartMs": 310777,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "這個是一個洞了"
    } ]
  }, {
    "tStartMs": 313279,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "對 前面兩張圖你會發現說把它併起來的話"
    } ]
  }, {
    "tStartMs": 316115,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "它是可以併成一條比較細的縫這樣感覺"
    } ]
  }, {
    "tStartMs": 318651,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "像這個是你沒有辦法把皮膚併起來的"
    } ]
  }, {
    "tStartMs": 320486,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "因為它等於有缺損的情況"
    } ]
  }, {
    "tStartMs": 322088,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "像這個洞其實我會第一個直覺"
    } ]
  }, {
    "tStartMs": 324390,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "其實我就覺得它比較像是一個穿透的損傷"
    } ]
  }, {
    "tStartMs": 327960,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "最常見的可能就是個所謂的槍傷的部分"
    } ]
  }, {
    "tStartMs": 330530,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "槍傷是長這個樣子"
    } ]
  }, {
    "tStartMs": 332632,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "對 至於它是射入口或射出口的話"
    } ]
  }, {
    "tStartMs": 335902,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "可能要伴隨著旁邊的皮膚的一些變化"
    } ]
  }, {
    "tStartMs": 338938,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "如果像我們知道什麼像火藥刺青什麼之類的"
    } ]
  }, {
    "tStartMs": 341574,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "那是比較去判斷說它是近距離 遠距離"
    } ]
  }, {
    "tStartMs": 343910,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "那個是在皮膚的周邊會留下一些組織的變化"
    } ]
  }, {
    "tStartMs": 347180,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "顏色上的變化"
    } ]
  }, {
    "tStartMs": 348481,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "像這個只有皮膚破損的話"
    } ]
  }, {
    "tStartMs": 350516,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "就比較難直接說它一定是槍傷"
    } ]
  }, {
    "tStartMs": 352618,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "但我覺得就是類似那種東西"
    } ]
  }, {
    "tStartMs": 354520,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "都可以造成這個損傷"
    } ]
  }, {
    "tStartMs": 355888,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "這邊我們有個好奇"
    } ]
  }, {
    "tStartMs": 357490,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "就是假設這個東西都是圓的"
    } ]
  }, {
    "tStartMs": 359625,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "我的器械有很多可能是圓錐狀的"
    } ]
  }, {
    "tStartMs": 362495,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "我要怎麼樣去分辨是圓錐的器械"
    } ]
  }, {
    "tStartMs": 364931,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "還是是這種穿透的槍傷"
    } ]
  }, {
    "tStartMs": 366899,
    "dDurationMs": 4405,
    "segs": [ {
      "utf8": "那就決定在說它怎麼對人體造成的衝擊"
    } ]
  }, {
    "tStartMs": 371304,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "或者是動力"
    } ]
  }, {
    "tStartMs": 372305,
    "dDurationMs": 3236,
    "segs": [ {
      "utf8": "因為如果你比如說拿的是圓錐去刺他的話"
    } ]
  }, {
    "tStartMs": 375541,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "應該就會像我們拿的銳器或什麼之類的"
    } ]
  }, {
    "tStartMs": 378244,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "它造成的是圓形的損傷"
    } ]
  }, {
    "tStartMs": 379846,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "但如果是槍炮彈藥類的話"
    } ]
  }, {
    "tStartMs": 382181,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "它是類似擊發的概念"
    } ]
  }, {
    "tStartMs": 385084,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "所以它會有一個火藥爆炸之後"
    } ]
  }, {
    "tStartMs": 386719,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "把這個東西打出去"
    } ]
  }, {
    "tStartMs": 388087,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "這個像這種子彈類的東西"
    } ]
  }, {
    "tStartMs": 389355,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "它其實周邊會伴隨一些火藥的剩下的殘餘物"
    } ]
  }, {
    "tStartMs": 392725,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "燃燒的殘餘物"
    } ]
  }, {
    "tStartMs": 393726,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "穿透到人體之後"
    } ]
  }, {
    "tStartMs": 394827,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "它就會在皮膚上留下一些痕跡"
    } ]
  }, {
    "tStartMs": 396896,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "如果近距離的話"
    } ]
  }, {
    "tStartMs": 397897,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "如果遠距離 遠一點的話"
    } ]
  }, {
    "tStartMs": 399031,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "那些火藥痕跡會慢慢散掉之後"
    } ]
  }, {
    "tStartMs": 400500,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "就不見得會看到些東西"
    } ]
  }, {
    "tStartMs": 402001,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "所以判斷的本身不一定是單看這個傷口"
    } ]
  }, {
    "tStartMs": 404237,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "還看傷口沾了些什麼樣子的東西"
    } ]
  }, {
    "tStartMs": 406939,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "這題的答案真的就是槍"
    } ]
  }, {
    "tStartMs": 409308,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "好厲害"
    } ]
  }, {
    "tStartMs": 409842,
    "dDurationMs": 4438,
    "segs": [ {
      "utf8": "下一個我們來看看還會有什麼樣子的傷口"
    } ]
  }, {
    "tStartMs": 415314,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "這兩個黑黑的"
    } ]
  }, {
    "tStartMs": 416749,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "剛剛講過的時候"
    } ]
  }, {
    "tStartMs": 417617,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "看到黑黑的可能代表這個已經擺了一陣子"
    } ]
  }, {
    "tStartMs": 420353,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 421120,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "好 你會覺得這是什麼呢"
    } ]
  }, {
    "tStartMs": 424023,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "這個時候就要考慮說它到底是同一時間造成"
    } ]
  }, {
    "tStartMs": 427493,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "還是同一個東西造成兩次的傷害"
    } ]
  }, {
    "tStartMs": 430163,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "這會有不同的判斷方式"
    } ]
  }, {
    "tStartMs": 432131,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "類似這種夾子類的東西刺出來"
    } ]
  }, {
    "tStartMs": 434133,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "也是可以這種樣子"
    } ]
  }, {
    "tStartMs": 435301,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "傷口有點大"
    } ]
  }, {
    "tStartMs": 436002,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "所以我比較不認為是這種東西"
    } ]
  }, {
    "tStartMs": 438171,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "另外一個當然是要排除它有沒有可能"
    } ]
  }, {
    "tStartMs": 440306,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "是兩次的傷口造成的結果"
    } ]
  }, {
    "tStartMs": 443176,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "現在圖片只有呈現到皮膚上的狀況"
    } ]
  }, {
    "tStartMs": 446345,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "並沒有皮膚下"
    } ]
  }, {
    "tStartMs": 447747,
    "dDurationMs": 2869,
    "segs": [ {
      "utf8": "這兩個有沒有可能中間其實是貫通的"
    } ]
  }, {
    "tStartMs": 450616,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "因為這樣我並沒有辦法判斷它是貫通的"
    } ]
  }, {
    "tStartMs": 452485,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "如果是貫通的話"
    } ]
  }, {
    "tStartMs": 453186,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "可能是同一件事情"
    } ]
  }, {
    "tStartMs": 454253,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "只是從左到右 從右到左都可以發生"
    } ]
  }, {
    "tStartMs": 457356,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "沒關係 不用知道答案"
    } ]
  }, {
    "tStartMs": 458825,
    "dDurationMs": 2869,
    "segs": [ {
      "utf8": "光是猜測的這個過程本身就非常地有趣"
    } ]
  }, {
    "tStartMs": 461694,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 462428,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "我是注意到它右邊有一個形狀"
    } ]
  }, {
    "tStartMs": 465398,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "對\n那個形狀是有可能是"
    } ]
  }, {
    "tStartMs": 467300,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "就是一個十字起子造成的嗎"
    } ]
  }, {
    "tStartMs": 469101,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "除非把皮膚擠回去看那個形狀"
    } ]
  }, {
    "tStartMs": 471637,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "不然如果單純被撐開的樣子的話"
    } ]
  }, {
    "tStartMs": 473573,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "其實沒辦法猜測"
    } ]
  }, {
    "tStartMs": 474273,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "倒是右邊十字起子比較明顯"
    } ]
  }, {
    "tStartMs": 475775,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "左邊其實看不太出來"
    } ]
  }, {
    "tStartMs": 477043,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "好 這題的答案就是十字起子"
    } ]
  }, {
    "tStartMs": 479178,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "所以它真的是刺兩次嗎"
    } ]
  }, {
    "tStartMs": 481047,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "可能是被刺了兩次"
    } ]
  }, {
    "tStartMs": 482515,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "對 好奇"
    } ]
  }, {
    "tStartMs": 483850,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "好 最後一個"
    } ]
  }, {
    "tStartMs": 485485,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "這就是一個淤青的傷口"
    } ]
  }, {
    "tStartMs": 488087,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "這個要怎麼樣去判斷"
    } ]
  }, {
    "tStartMs": 489388,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "但這邊有比例尺"
    } ]
  }, {
    "tStartMs": 490823,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "我只能跟你說它就是淤青"
    } ]
  }, {
    "tStartMs": 492558,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "因為我們通常對於傷口來形容的話"
    } ]
  }, {
    "tStartMs": 495027,
    "dDurationMs": 3471,
    "segs": [ {
      "utf8": "應該會說是它是個鈍力傷或是銳器傷"
    } ]
  }, {
    "tStartMs": 498498,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "通常鈍力傷就是指說被鈍物打到"
    } ]
  }, {
    "tStartMs": 501400,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "這種東西其實打出來的時候"
    } ]
  }, {
    "tStartMs": 503069,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "就是不會造成皮膚的破損"
    } ]
  }, {
    "tStartMs": 504770,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "這時候我只能說它就是鈍力傷"
    } ]
  }, {
    "tStartMs": 506973,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "它比較不像是被剛才講的是一些銳器刺到"
    } ]
  }, {
    "tStartMs": 509675,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "所以造成了一個有開放性的傷口這樣子"
    } ]
  }, {
    "tStartMs": 512044,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "看起來比較像是圓形的東西"
    } ]
  }, {
    "tStartMs": 513946,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "因為它其實看起來就整個是圓的"
    } ]
  }, {
    "tStartMs": 515681,
    "dDurationMs": 968,
    "segs": [ {
      "utf8": "但只能這樣子"
    } ]
  }, {
    "tStartMs": 516649,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "沒有一個很明確的一個形狀說"
    } ]
  }, {
    "tStartMs": 519218,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "可以告訴我說它一定是個"
    } ]
  }, {
    "tStartMs": 520920,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "比如說是棍棒類還什麼"
    } ]
  }, {
    "tStartMs": 522288,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "這倒沒有這麼地漂亮"
    } ]
  }, {
    "tStartMs": 524123,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "我好奇就是實際上你們在要講說"
    } ]
  }, {
    "tStartMs": 527493,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "這個大概是什麼的時候"
    } ]
  }, {
    "tStartMs": 529495,
    "dDurationMs": 3137,
    "segs": [ {
      "utf8": "這會需要搭配現場的各種殘留物嗎"
    } ]
  }, {
    "tStartMs": 532632,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "以目前的法醫來說的話"
    } ]
  }, {
    "tStartMs": 534534,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "基本上不會單純從傷口去講完所有故事"
    } ]
  }, {
    "tStartMs": 537570,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "那是不可能的"
    } ]
  }, {
    "tStartMs": 538671,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "所以一定是配合現場的留下來的東西來做判斷"
    } ]
  }, {
    "tStartMs": 541908,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "鑑識人員可能在一些物品上"
    } ]
  }, {
    "tStartMs": 543643,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "發現說有一些殘留的跡證"
    } ]
  }, {
    "tStartMs": 545878,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "然後問我們說哪一個比較合適"
    } ]
  }, {
    "tStartMs": 547713,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "或者是哪個才是比較容易造成這個傷口的狀況"
    } ]
  }, {
    "tStartMs": 550383,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "然後來做判斷"
    } ]
  }, {
    "tStartMs": 551717,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "剛剛最後一個的答案是球棒"
    } ]
  }, {
    "tStartMs": 554453,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "所以球棒可能就是打到一下那樣子"
    } ]
  }, {
    "tStartMs": 557056,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "但因為那看起來 對 就是"
    } ]
  }, {
    "tStartMs": 558591,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "或是前面圓圓的"
    } ]
  }, {
    "tStartMs": 559892,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "我在想說是不是直接拿來捶的那種"
    } ]
  }, {
    "tStartMs": 561961,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "因為如果是棒子這樣打到的話"
    } ]
  }, {
    "tStartMs": 563462,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "應該比較像是有條狀的感覺"
    } ]
  }, {
    "tStartMs": 565498,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "對 它剛才看到比較像是圓的"
    } ]
  }, {
    "tStartMs": 567266,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "對 有可能是截圖的問題"
    } ]
  }, {
    "tStartMs": 568834,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "所以可能下面有一條長的也說不定這樣"
    } ]
  }, {
    "tStartMs": 570970,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "好 剛剛我們聊了很多"
    } ]
  }, {
    "tStartMs": 572238,
    "dDurationMs": 2869,
    "segs": [ {
      "utf8": "已經讓我覺得法醫這個學問非常地有趣"
    } ]
  }, {
    "tStartMs": 575107,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "這邊我想要先問第一個好奇"
    } ]
  }, {
    "tStartMs": 576909,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "就是如果屍體的腐敗程度"
    } ]
  }, {
    "tStartMs": 578844,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "已經很難去辨別這個傷口"
    } ]
  }, {
    "tStartMs": 580513,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "還有什麼樣的方式可以去檢測他的死因嗎"
    } ]
  }, {
    "tStartMs": 583149,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "因為腐敗對我們法醫來說"
    } ]
  }, {
    "tStartMs": 584517,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "是個最具挑戰性的議題"
    } ]
  }, {
    "tStartMs": 587453,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "因為腐敗就是會破壞所有我們已知的狀況"
    } ]
  }, {
    "tStartMs": 590723,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "你能閉回去根據它原本的形狀"
    } ]
  }, {
    "tStartMs": 592992,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "說不定已經開始有跑掉"
    } ]
  }, {
    "tStartMs": 594327,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "這個傷口如果只對軟組織造成損傷"
    } ]
  }, {
    "tStartMs": 597263,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "但是沒有造成骨頭損傷"
    } ]
  }, {
    "tStartMs": 598831,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "這時候如果腐敗又只剩下骨頭的話"
    } ]
  }, {
    "tStartMs": 600466,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "我就完全不知道這個東西"
    } ]
  }, {
    "tStartMs": 602268,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "所以其實反過來說"
    } ]
  }, {
    "tStartMs": 604036,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "如果腐敗到很嚴重的程度的話"
    } ]
  }, {
    "tStartMs": 605738,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "我們其實大部分都不會知道他怎麼死的"
    } ]
  }, {
    "tStartMs": 608240,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "再來我想要先回到你的本身"
    } ]
  }, {
    "tStartMs": 610643,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "你有這個中西醫的雙學士"
    } ]
  }, {
    "tStartMs": 612778,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "照理來說你可以走的行醫路線"
    } ]
  }, {
    "tStartMs": 614614,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "其實應該是蠻廣的才對"
    } ]
  }, {
    "tStartMs": 616082,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "是\n為何你最後會選擇是做法醫"
    } ]
  }, {
    "tStartMs": 618384,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "然後面對死者呢"
    } ]
  }, {
    "tStartMs": 619652,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "我到大學之前"
    } ]
  }, {
    "tStartMs": 621721,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "應該說我只是目標就是做個醫生"
    } ]
  }, {
    "tStartMs": 623990,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "但我那時候其實並沒有真的很決定說"
    } ]
  }, {
    "tStartMs": 626492,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "一定要對哪一個科別有興趣"
    } ]
  }, {
    "tStartMs": 628294,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "只是因為我們到大五 大六左右之後"
    } ]
  }, {
    "tStartMs": 630229,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "其實你開始要考慮自己要走了哪個分科"
    } ]
  }, {
    "tStartMs": 632565,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "開始要有一點準備"
    } ]
  }, {
    "tStartMs": 633733,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "因為畢業之後你考完試之後"
    } ]
  }, {
    "tStartMs": 635701,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "其實就開始要面試說你要去走哪一個次專科"
    } ]
  }, {
    "tStartMs": 638738,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "同時那時候從大一開始"
    } ]
  }, {
    "tStartMs": 639972,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "就非常喜歡看那種犯罪現場"
    } ]
  }, {
    "tStartMs": 641574,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "就是美國 CSI"
    } ]
  }, {
    "tStartMs": 642608,
    "dDurationMs": 401,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 643009,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "然後就發現說在各個科別都不太喜歡的情況下"
    } ]
  }, {
    "tStartMs": 646045,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "怎麼好像有科別就是蠢蠢欲動地"
    } ]
  }, {
    "tStartMs": 648114,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "在那邊角落那種掙扎"
    } ]
  }, {
    "tStartMs": 649448,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "想說好像有一個科別好像可以走看看"
    } ]
  }, {
    "tStartMs": 651717,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "所以是從那時候就開始說"
    } ]
  }, {
    "tStartMs": 652885,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "我有這個興趣"
    } ]
  }, {
    "tStartMs": 654086,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "因為台灣沒有的訓練"
    } ]
  }, {
    "tStartMs": 654987,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "所以之前的前輩們都是出國去進修"
    } ]
  }, {
    "tStartMs": 657590,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "那我那時候其實並沒有選擇這條路"
    } ]
  }, {
    "tStartMs": 659592,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "反而選了另外一個方法"
    } ]
  }, {
    "tStartMs": 661594,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "怎麼樣啊"
    } ]
  }, {
    "tStartMs": 662228,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "就是我順利取得病理專科之後"
    } ]
  }, {
    "tStartMs": 664463,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "那時候我去就讀了台大的法醫學研究所"
    } ]
  }, {
    "tStartMs": 667566,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "所以還有個特別的研究所"
    } ]
  }, {
    "tStartMs": 669335,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "對 這是台灣就是唯一一個"
    } ]
  }, {
    "tStartMs": 671437,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "法醫學研究所的部分"
    } ]
  }, {
    "tStartMs": 672738,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "好 再來聊聊法醫師"
    } ]
  }, {
    "tStartMs": 674840,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "可以先跟我們分享一下處理一件案子"
    } ]
  }, {
    "tStartMs": 676742,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "它需要經手的工作有哪一些嗎"
    } ]
  }, {
    "tStartMs": 678644,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "非自然死大概就是什麼自殺 他殺 意外這種的"
    } ]
  }, {
    "tStartMs": 681681,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "疑似非自然死是它理論上看起來像自然死"
    } ]
  }, {
    "tStartMs": 684517,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "但好像有一點怪怪的時候"
    } ]
  }, {
    "tStartMs": 686986,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "這種案件都會被警察報到地檢署"
    } ]
  }, {
    "tStartMs": 689689,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "檢察官帶著地檢署法醫師去第一現場"
    } ]
  }, {
    "tStartMs": 692458,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "就是殯儀館或是什麼看一下遺體的狀況"
    } ]
  }, {
    "tStartMs": 694860,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "警察會去調閱一些現場的檢查"
    } ]
  }, {
    "tStartMs": 696996,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "然後調閱醫院紀錄"
    } ]
  }, {
    "tStartMs": 698564,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "如果有的話"
    } ]
  }, {
    "tStartMs": 699265,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "有就醫紀錄的話"
    } ]
  }, {
    "tStartMs": 700166,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "地檢署法醫師如果單純沒辦法從這些東西"
    } ]
  }, {
    "tStartMs": 702134,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "去判斷死因的話"
    } ]
  }, {
    "tStartMs": 703502,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "他就會把這個案件報到"
    } ]
  }, {
    "tStartMs": 705604,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "所謂的法務部法醫研究所"
    } ]
  }, {
    "tStartMs": 707073,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "也就是我工作的地方"
    } ]
  }, {
    "tStartMs": 708407,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "這時候就由我們單位去指派解剖法醫師"
    } ]
  }, {
    "tStartMs": 711243,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "到各個縣市的殯儀館去做解剖"
    } ]
  }, {
    "tStartMs": 714013,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "解剖一具遺體需要花費多少的時間"
    } ]
  }, {
    "tStartMs": 717283,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "在台灣的話 大概都排在一個小時左右"
    } ]
  }, {
    "tStartMs": 720119,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "一個小時而已"
    } ]
  }, {
    "tStartMs": 721053,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "對 一方面是案件很多"
    } ]
  }, {
    "tStartMs": 722154,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "一方面其實是基本的 SOP 為主的情況下"
    } ]
  }, {
    "tStartMs": 725091,
    "dDurationMs": 634,
    "segs": [ {
      "utf8": "來做檢查"
    } ]
  }, {
    "tStartMs": 725725,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "大概一個小時"
    } ]
  }, {
    "tStartMs": 726726,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "但當然案件複雜度有差"
    } ]
  }, {
    "tStartMs": 728260,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "譬如說凶殺案的話"
    } ]
  }, {
    "tStartMs": 729495,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "刀傷比較多那種的話"
    } ]
  }, {
    "tStartMs": 730763,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "可能就要花比較多的時間"
    } ]
  }, {
    "tStartMs": 732398,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "你會有就是走進去"
    } ]
  }, {
    "tStartMs": 733799,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "然後一看就知道說這個我知道了"
    } ]
  }, {
    "tStartMs": 736602,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "會有到這麼明確的狀況嗎"
    } ]
  }, {
    "tStartMs": 738137,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "還是每一個都要好好地就是要拆"
    } ]
  }, {
    "tStartMs": 740473,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "然後要研究一下"
    } ]
  }, {
    "tStartMs": 741640,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "其實像凶殺案這種的話"
    } ]
  }, {
    "tStartMs": 742875,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "其實大家都知道他一定被銳器刺殺死的"
    } ]
  }, {
    "tStartMs": 746145,
    "dDurationMs": 2869,
    "segs": [ {
      "utf8": "這時候解剖的目的就不是為了去證實這件事情"
    } ]
  }, {
    "tStartMs": 749014,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "而是為了留存證據說他真的刺到多深"
    } ]
  }, {
    "tStartMs": 751617,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "也許你現場可以探說他真的刺很深"
    } ]
  }, {
    "tStartMs": 753819,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "他一定傷到某個大器官之類"
    } ]
  }, {
    "tStartMs": 755454,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "導致大出血"
    } ]
  }, {
    "tStartMs": 756455,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "但傷到什麼器官不確定"
    } ]
  }, {
    "tStartMs": 758124,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "要把來龍去脈搞清楚"
    } ]
  }, {
    "tStartMs": 759959,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "對 所以其實這時候是死因很明確"
    } ]
  }, {
    "tStartMs": 762628,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "我只是幫忙做個紀錄說"
    } ]
  }, {
    "tStartMs": 764530,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "他到底真的傷到哪些地方"
    } ]
  }, {
    "tStartMs": 766332,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "另外我們查資料的時候還查到一件事情"
    } ]
  }, {
    "tStartMs": 768601,
    "dDurationMs": 4271,
    "segs": [ {
      "utf8": "就是說解剖遺體其實是一個論件計酬的"
    } ]
  }, {
    "tStartMs": 772872,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "這是真的嗎"
    } ]
  }, {
    "tStartMs": 774240,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "對 這是真的"
    } ]
  }, {
    "tStartMs": 775641,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "就是你在網路上如果你打這個法醫"
    } ]
  }, {
    "tStartMs": 778844,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "論件計酬或者是價錢"
    } ]
  }, {
    "tStartMs": 780379,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "你就會在立法院得到一個公布的價格"
    } ]
  }, {
    "tStartMs": 783315,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "這個解剖一具會是多少錢"
    } ]
  }, {
    "tStartMs": 785284,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "這時候就要講到解剖法醫師的本身的資格裡面"
    } ]
  }, {
    "tStartMs": 788020,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "還有分成兩大類的人"
    } ]
  }, {
    "tStartMs": 790122,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "一個是專任的法醫師"
    } ]
  }, {
    "tStartMs": 792224,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "專任法醫師就是你全職的工作"
    } ]
  }, {
    "tStartMs": 794026,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "都是在做法醫的部分"
    } ]
  }, {
    "tStartMs": 796362,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "所以他是被編制在法務部法醫研究所裡面"
    } ]
  }, {
    "tStartMs": 799131,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "目前的編制只有 4 位"
    } ]
  }, {
    "tStartMs": 800666,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "全台灣 4 位"
    } ]
  }, {
    "tStartMs": 801734,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "應該說是公務的缺就是這樣子"
    } ]
  }, {
    "tStartMs": 803803,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "其他人的話就會被歸類在所謂的兼任法醫師"
    } ]
  }, {
    "tStartMs": 805738,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "其他人的話就會被歸類在所謂的兼任法醫師"
    } ]
  }, {
    "tStartMs": 806705,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "剩下的兼任醫師"
    } ]
  }, {
    "tStartMs": 808073,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "都是在各大醫院的病理科在工作"
    } ]
  }, {
    "tStartMs": 811076,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "案件太多的時候會請他們幫忙"
    } ]
  }, {
    "tStartMs": 812878,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "為什麼要特別提到專任跟兼任"
    } ]
  }, {
    "tStartMs": 814480,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "是因為如果你去查的話就會發現說"
    } ]
  }, {
    "tStartMs": 816448,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "專任跟兼任價錢給的是不一樣的"
    } ]
  }, {
    "tStartMs": 819385,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "專任的相對薪水是比較低的"
    } ]
  }, {
    "tStartMs": 822188,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "兼任給的是比較高"
    } ]
  }, {
    "tStartMs": 823722,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "大概差 3 倍左右"
    } ]
  }, {
    "tStartMs": 825658,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "差到 3 倍"
    } ]
  }, {
    "tStartMs": 826692,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 827459,
    "dDurationMs": 3371,
    "segs": [ {
      "utf8": "一件的話解剖加上報告出去大概 6000 塊"
    } ]
  }, {
    "tStartMs": 830830,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "兼任給的話是 19000"
    } ]
  }, {
    "tStartMs": 832364,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "差好多"
    } ]
  }, {
    "tStartMs": 833465,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "對 就 3 倍多"
    } ]
  }, {
    "tStartMs": 834934,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "有沒有可能解剖完還是沒有辦法發現死因"
    } ]
  }, {
    "tStartMs": 838070,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "會 其實一定有"
    } ]
  }, {
    "tStartMs": 839338,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "譬如說在醫院死掉"
    } ]
  }, {
    "tStartMs": 840472,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "其實很多時候譬如說都是心律不整死掉"
    } ]
  }, {
    "tStartMs": 843275,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "那種做心電圖很明顯"
    } ]
  }, {
    "tStartMs": 844643,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "但是我解剖怎麼可能看到一個心電圖在那邊"
    } ]
  }, {
    "tStartMs": 847413,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "他就死掉了"
    } ]
  }, {
    "tStartMs": 848247,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "糖尿病或是慢性腎病那種"
    } ]
  }, {
    "tStartMs": 850049,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "相對是長期的慢性病"
    } ]
  }, {
    "tStartMs": 851917,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "可能有一些電解質的問題"
    } ]
  }, {
    "tStartMs": 854353,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "這種東西也不可能在解剖看到"
    } ]
  }, {
    "tStartMs": 856155,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "這種遺體我沒有辦法去做檢驗"
    } ]
  }, {
    "tStartMs": 857923,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "因為這個人死掉之後"
    } ]
  }, {
    "tStartMs": 859124,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "如果沒有馬上抽血"
    } ]
  }, {
    "tStartMs": 860726,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "身體的所有細胞都開始腐敗"
    } ]
  }, {
    "tStartMs": 862795,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "這些數值就會完全跟人體還活著的時候的數值"
    } ]
  }, {
    "tStartMs": 865798,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "完全不一樣"
    } ]
  }, {
    "tStartMs": 866866,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "這不能做一個參考"
    } ]
  }, {
    "tStartMs": 868367,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "所以像這種沒有一個明確的疾病之類的情況下"
    } ]
  }, {
    "tStartMs": 872071,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "說要做判斷是相對困難"
    } ]
  }, {
    "tStartMs": 874373,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "只能說他好像有罹患這疾病"
    } ]
  }, {
    "tStartMs": 876075,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "所以我比較傾向是這個方向死掉"
    } ]
  }, {
    "tStartMs": 878410,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "但就相對來說比較沒有這麼準確"
    } ]
  }, {
    "tStartMs": 880512,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "有沒有處理過什麼案件讓你印象深刻的"
    } ]
  }, {
    "tStartMs": 883449,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "比如說發現了一些關鍵證據"
    } ]
  }, {
    "tStartMs": 885651,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "進而協助破案的那一種"
    } ]
  }, {
    "tStartMs": 887319,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "有 其實多少都還是會發生這種情況"
    } ]
  }, {
    "tStartMs": 889922,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "這也是我覺得法醫其實相對比較有趣的"
    } ]
  }, {
    "tStartMs": 892091,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "因為有時候其實從外觀就是看不到什麼東西"
    } ]
  }, {
    "tStartMs": 895094,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "然後在你打開的時候發現一個真相"
    } ]
  }, {
    "tStartMs": 898297,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "有什麼故事可以跟我們分享一下嗎"
    } ]
  }, {
    "tStartMs": 899865,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "有一個倒在路邊的一個人"
    } ]
  }, {
    "tStartMs": 901734,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "然後可能就是路過的人發現說叫不醒"
    } ]
  }, {
    "tStartMs": 903736,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "當場就發現他死掉"
    } ]
  }, {
    "tStartMs": 904670,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "所以沒有送醫急救"
    } ]
  }, {
    "tStartMs": 905871,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "因為外觀看起來沒有什麼特別的外傷"
    } ]
  }, {
    "tStartMs": 908874,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "問起來 問家屬說他其實有一些酗酒史"
    } ]
  }, {
    "tStartMs": 911777,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "可能想說會不會是喝完酒"
    } ]
  }, {
    "tStartMs": 913579,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "就是酒精濃度過高中毒死掉之類的"
    } ]
  }, {
    "tStartMs": 915881,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "但因為沒有外傷"
    } ]
  }, {
    "tStartMs": 916749,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "所以還是要做解剖的部分"
    } ]
  }, {
    "tStartMs": 918851,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "我只是沒有想到打開之後發現就是"
    } ]
  }, {
    "tStartMs": 922421,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "這時候就要找出他出血的原因是什麼"
    } ]
  }, {
    "tStartMs": 923956,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "然後就發現說他是個脾臟破裂"
    } ]
  }, {
    "tStartMs": 926659,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "脾臟是在左腹的地方"
    } ]
  }, {
    "tStartMs": 928460,
    "dDurationMs": 668,
    "segs": [ {
      "utf8": "像這個地方"
    } ]
  }, {
    "tStartMs": 929128,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "它其實沒事不太會破掉"
    } ]
  }, {
    "tStartMs": 930162,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "它其實沒事不太會破掉"
    } ]
  }, {
    "tStartMs": 931964,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "這時候就只能提供給檢察官說"
    } ]
  }, {
    "tStartMs": 934066,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "你可能要找一下它的外力來源在哪裡"
    } ]
  }, {
    "tStartMs": 937269,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "後來發現就是其實家屬在找他的時候"
    } ]
  }, {
    "tStartMs": 939939,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "就是有稍微踢了一下他"
    } ]
  }, {
    "tStartMs": 941473,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "踹了一下他這樣子"
    } ]
  }, {
    "tStartMs": 942541,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "對 當然發現他附近的肋骨有稍微骨折"
    } ]
  }, {
    "tStartMs": 944610,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "這也是打開才知道的情況"
    } ]
  }, {
    "tStartMs": 946378,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "至於為什麼他們做這個行為"
    } ]
  }, {
    "tStartMs": 947980,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "當然不是我的工作的範圍"
    } ]
  }, {
    "tStartMs": 949882,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "我只是聽說最後是這樣討論"
    } ]
  }, {
    "tStartMs": 951884,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "因為我的報告上我只會呈現說"
    } ]
  }, {
    "tStartMs": 953319,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "他是個腹部受到一個撞擊"
    } ]
  }, {
    "tStartMs": 955888,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "導致的脾臟破裂出血"
    } ]
  }, {
    "tStartMs": 957589,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "這個其實已經可以寫小說了"
    } ]
  }, {
    "tStartMs": 960659,
    "dDurationMs": 3304,
    "segs": [ {
      "utf8": "這是有辦法判斷說他是在死掉之前被踢"
    } ]
  }, {
    "tStartMs": 963963,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "還是死掉之後被踢的嗎"
    } ]
  }, {
    "tStartMs": 966065,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "像我剛才講的所謂大量出血的話"
    } ]
  }, {
    "tStartMs": 968667,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "基本上只有在生命還活著的時候"
    } ]
  }, {
    "tStartMs": 971236,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "才有辦法大量出血"
    } ]
  }, {
    "tStartMs": 972504,
    "dDurationMs": 3471,
    "segs": [ {
      "utf8": "我就算破壞遺體都不見得會大量出血"
    } ]
  }, {
    "tStartMs": 975975,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "對 所以這個大概是我可以判斷說"
    } ]
  }, {
    "tStartMs": 978177,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "它一定是生前造成的"
    } ]
  }, {
    "tStartMs": 979244,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "當然另外一個是這個出血裡面還有一些血塊"
    } ]
  }, {
    "tStartMs": 982614,
    "dDurationMs": 3437,
    "segs": [ {
      "utf8": "血塊是在生前流出來的血之後比較容易凝結"
    } ]
  }, {
    "tStartMs": 986051,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "死後流出來是叫血水或屍水"
    } ]
  }, {
    "tStartMs": 988520,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "比較不容易凝結在一起"
    } ]
  }, {
    "tStartMs": 989822,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "你會有什麼不想要碰到的 Case 嗎"
    } ]
  }, {
    "tStartMs": 992458,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "有 其實一定有"
    } ]
  }, {
    "tStartMs": 993826,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "這也是可以稍微選擇一下的嗎"
    } ]
  }, {
    "tStartMs": 995794,
    "dDurationMs": 401,
    "segs": [ {
      "utf8": "不行"
    } ]
  }, {
    "tStartMs": 996195,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "不行 但是還是會遇到"
    } ]
  }, {
    "tStartMs": 997529,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "我們之所以不能選案件"
    } ]
  }, {
    "tStartMs": 999064,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "是因為看今天誰有空就排誰去做解剖"
    } ]
  }, {
    "tStartMs": 1001767,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "所以我當然不會預期說"
    } ]
  }, {
    "tStartMs": 1003202,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "我今天可以遇到哪些案件"
    } ]
  }, {
    "tStartMs": 1004436,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "或者說我今天就是不想接這種案件"
    } ]
  }, {
    "tStartMs": 1006138,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "比較不喜歡的案件大概有幾個類型"
    } ]
  }, {
    "tStartMs": 1008340,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "一個就是之前炒得沸沸揚揚的虐童案"
    } ]
  }, {
    "tStartMs": 1011210,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "對 其實是小孩子很可憐"
    } ]
  }, {
    "tStartMs": 1013278,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "對 你看到的就是一堆傷的情況"
    } ]
  }, {
    "tStartMs": 1015614,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "雖然我還是要幫他完成"
    } ]
  }, {
    "tStartMs": 1016882,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "但我覺得心理上相對來說是比較不舒服的"
    } ]
  }, {
    "tStartMs": 1019118,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "另外一個是老人家"
    } ]
  }, {
    "tStartMs": 1021320,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "老人家"
    } ]
  }, {
    "tStartMs": 1022221,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "他平常可能沒在照顧"
    } ]
  }, {
    "tStartMs": 1023222,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "照顧可能是另外一個家人"
    } ]
  }, {
    "tStartMs": 1025357,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "死掉之後這個相對來說比較沒照顧的人"
    } ]
  }, {
    "tStartMs": 1027993,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "就會說會不會是你照顧的人造成他死掉"
    } ]
  }, {
    "tStartMs": 1030529,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "會不會是你殺害他"
    } ]
  }, {
    "tStartMs": 1031463,
    "dDurationMs": 935,
    "segs": [ {
      "utf8": "所以我需要做解剖"
    } ]
  }, {
    "tStartMs": 1032398,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "可是你看這個老人"
    } ]
  }, {
    "tStartMs": 1033832,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "可能就已經 80~90 歲 100 歲了"
    } ]
  }, {
    "tStartMs": 1035868,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "這時候我在做解剖就覺得這個人就是"
    } ]
  }, {
    "tStartMs": 1038704,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "已經年紀到了"
    } ]
  }, {
    "tStartMs": 1039638,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "對 年紀到該走了"
    } ]
  }, {
    "tStartMs": 1040672,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "甚至我做過一個 101 歲的"
    } ]
  }, {
    "tStartMs": 1042307,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "我想說這個就讓他安詳地走就好"
    } ]
  }, {
    "tStartMs": 1044209,
    "dDurationMs": 668,
    "segs": [ {
      "utf8": "為什麼要"
    } ]
  }, {
    "tStartMs": 1044877,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "做這種事情"
    } ]
  }, {
    "tStartMs": 1045744,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "就是其實只是為了子孫們在那邊吵"
    } ]
  }, {
    "tStartMs": 1047946,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "然後就覺得就是做這個案件到底為了什麼"
    } ]
  }, {
    "tStartMs": 1050349,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "難怪之前有些劇會用法醫當做是核心的角色"
    } ]
  }, {
    "tStartMs": 1053852,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "因為可以從這邊探討出很多人性的一些"
    } ]
  }, {
    "tStartMs": 1056722,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "邊緣的故事"
    } ]
  }, {
    "tStartMs": 1057823,
    "dDurationMs": 467,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 1058290,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "從一開始接觸到後面"
    } ]
  }, {
    "tStartMs": 1060626,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "這個心態之間有什麼樣子的轉換嗎"
    } ]
  }, {
    "tStartMs": 1062861,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "其實我從一開始就知道"
    } ]
  }, {
    "tStartMs": 1065064,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "這個行業本來就會一直接觸到各個面向"
    } ]
  }, {
    "tStartMs": 1068734,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "就是包括人性"
    } ]
  }, {
    "tStartMs": 1069802,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "然後包括各種遺體的樣態"
    } ]
  }, {
    "tStartMs": 1071804,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "講比較不好聽一點就是我其實有一點期待"
    } ]
  }, {
    "tStartMs": 1075374,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "我每次遇到的案件"
    } ]
  }, {
    "tStartMs": 1076408,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "因為它其實就是一個不太確定的案件"
    } ]
  }, {
    "tStartMs": 1078544,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "才會到我手上"
    } ]
  }, {
    "tStartMs": 1079845,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "對 我會期待說我可以幫他解決什麼事情"
    } ]
  }, {
    "tStartMs": 1082414,
    "dDurationMs": 968,
    "segs": [ {
      "utf8": "我們在做這一集的時候"
    } ]
  }, {
    "tStartMs": 1083382,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "一找資料才發現就全台灣的法醫"
    } ]
  }, {
    "tStartMs": 1085451,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "居然只有 20 位左右"
    } ]
  }, {
    "tStartMs": 1086952,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "然後專任的公職法醫甚至只有 4 位"
    } ]
  }, {
    "tStartMs": 1089721,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "這樣子的人力一年到底要負責多少件的解剖案"
    } ]
  }, {
    "tStartMs": 1093525,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "每一年相驗案件大概 2 萬件"
    } ]
  }, {
    "tStartMs": 1095360,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "其中大概 8% 左右是解剖案件"
    } ]
  }, {
    "tStartMs": 1098197,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "所以一年做 1600~1700"
    } ]
  }, {
    "tStartMs": 1099932,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "剛才我講到說就是因為薪資分配的問題"
    } ]
  }, {
    "tStartMs": 1103469,
    "dDurationMs": 4304,
    "segs": [ {
      "utf8": "所以希望專任的法醫師能做多一點點"
    } ]
  }, {
    "tStartMs": 1107773,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "所以大概負責 6 成到 7 成的解剖業務"
    } ]
  }, {
    "tStartMs": 1110609,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "也就是大概 1000 多件"
    } ]
  }, {
    "tStartMs": 1112111,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "這樣的人力應該是完全不夠的 對嗎"
    } ]
  }, {
    "tStartMs": 1114146,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "一定相對不夠"
    } ]
  }, {
    "tStartMs": 1115147,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "你覺得實際上應該要到多少位是比較合理的"
    } ]
  }, {
    "tStartMs": 1117950,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "如果以專任來說我覺得再多兩位專任"
    } ]
  }, {
    "tStartMs": 1120285,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "應該是大家工作如果平均分配的話"
    } ]
  }, {
    "tStartMs": 1122488,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "大概是比較合理的"
    } ]
  }, {
    "tStartMs": 1123689,
    "dDurationMs": 4337,
    "segs": [ {
      "utf8": "我們現在已經談論到算是台灣的法醫制度了"
    } ]
  }, {
    "tStartMs": 1128026,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "如果要健全這個制度"
    } ]
  }, {
    "tStartMs": 1129461,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "你覺得當務之急會是什麼"
    } ]
  }, {
    "tStartMs": 1131330,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "我覺得台灣的制度最大的問題"
    } ]
  }, {
    "tStartMs": 1135400,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "其實應該是各縣市案件"
    } ]
  }, {
    "tStartMs": 1137069,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "然後就在各縣市做解剖的部分"
    } ]
  }, {
    "tStartMs": 1139171,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "因為其實我之前到日本進修"
    } ]
  }, {
    "tStartMs": 1142074,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "或者是前輩們到美國去邁阿密什麼進修之類"
    } ]
  }, {
    "tStartMs": 1144810,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "它們都會有一個法醫中心"
    } ]
  }, {
    "tStartMs": 1146645,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "也就是說所有的遺體會運到同一個中心"
    } ]
  }, {
    "tStartMs": 1149515,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "去進行解剖業務"
    } ]
  }, {
    "tStartMs": 1150249,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "進行後續的檢查"
    } ]
  }, {
    "tStartMs": 1151483,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "然後再把遺體運走"
    } ]
  }, {
    "tStartMs": 1152684,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "台灣其實反過來是你要說服家屬"
    } ]
  }, {
    "tStartMs": 1156221,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "移動到跨縣市都很困難"
    } ]
  }, {
    "tStartMs": 1158023,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "我相信這個是習俗上的問題"
    } ]
  }, {
    "tStartMs": 1159725,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "連一開始你要說服他去做解剖這個事情"
    } ]
  }, {
    "tStartMs": 1162127,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "都很困難"
    } ]
  }, {
    "tStartMs": 1163362,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "就不用講說我希望他可以移動個跨縣市"
    } ]
  }, {
    "tStartMs": 1166265,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "到其他地方"
    } ]
  }, {
    "tStartMs": 1167266,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "這當然是一個層面的部分"
    } ]
  }, {
    "tStartMs": 1169134,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "另外當然是我們台灣跟其他國家的制度"
    } ]
  }, {
    "tStartMs": 1171236,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "其實有點不一樣"
    } ]
  }, {
    "tStartMs": 1172704,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "因為像日本的制度"
    } ]
  }, {
    "tStartMs": 1173572,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "大概就是只要這個案件有問題"
    } ]
  }, {
    "tStartMs": 1175474,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "警察就會包含所有介入"
    } ]
  }, {
    "tStartMs": 1177209,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "介入之後就是包括運送那些都是由警察來負責"
    } ]
  }, {
    "tStartMs": 1180345,
    "dDurationMs": 3137,
    "segs": [ {
      "utf8": "但台灣比較不一樣是殯葬業者會直接先進來"
    } ]
  }, {
    "tStartMs": 1183482,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "做遺體的保存之類的"
    } ]
  }, {
    "tStartMs": 1185617,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "這時候所有的運送都是由殯葬業者來負責"
    } ]
  }, {
    "tStartMs": 1188153,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "那會差很多"
    } ]
  }, {
    "tStartMs": 1189821,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "目前來說我們大部分的工作就是到各縣市去"
    } ]
  }, {
    "tStartMs": 1193625,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "像我就是全台灣每個縣市都去過了"
    } ]
  }, {
    "tStartMs": 1195894,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "光交通時間就很浪費了"
    } ]
  }, {
    "tStartMs": 1197563,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "對 其實如果到各縣市去做解剖的話"
    } ]
  }, {
    "tStartMs": 1200332,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "工作的地方是各縣市殯儀館的解剖室"
    } ]
  }, {
    "tStartMs": 1201366,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "工作的地方是各縣市殯儀館的解剖室"
    } ]
  }, {
    "tStartMs": 1203435,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "我會希望把它統整在一起這件事情"
    } ]
  }, {
    "tStartMs": 1206772,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "是因為我覺得遺體保存是一個問題"
    } ]
  }, {
    "tStartMs": 1208640,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "另外一個是我檢體運送的問題"
    } ]
  }, {
    "tStartMs": 1210776,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "我取下來檢體之後就開始腐敗了"
    } ]
  }, {
    "tStartMs": 1212811,
    "dDurationMs": 4104,
    "segs": [ {
      "utf8": "我從南部再帶上來或者是冷藏什麼運送上來"
    } ]
  }, {
    "tStartMs": 1216915,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "那些運送過程中所花費的時間"
    } ]
  }, {
    "tStartMs": 1219051,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "都可能造成檢體的一些腐敗的狀況"
    } ]
  }, {
    "tStartMs": 1221453,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "那都會影響到判讀的情況"
    } ]
  }, {
    "tStartMs": 1223121,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "對 所以你集中在一起等於我取完之後"
    } ]
  }, {
    "tStartMs": 1225524,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "我馬上就可以送到實驗室去做後續的整理"
    } ]
  }, {
    "tStartMs": 1228060,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "這時候是不是就相對來說可以減少這些"
    } ]
  }, {
    "tStartMs": 1231063,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "死後腐敗導致的一些變化"
    } ]
  }, {
    "tStartMs": 1233232,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "如果再更講白一點"
    } ]
  }, {
    "tStartMs": 1234700,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "就是另外一個就是證據鏈的部分"
    } ]
  }, {
    "tStartMs": 1236768,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "我可以很明確說證據鏈就是都在我實驗室裡面"
    } ]
  }, {
    "tStartMs": 1239371,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "我實驗室可以經得起考驗"
    } ]
  }, {
    "tStartMs": 1240706,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "我不用擔心說運送過程中"
    } ]
  }, {
    "tStartMs": 1242274,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "會不會有人幫我把它調包"
    } ]
  }, {
    "tStartMs": 1244309,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "對 這當然是比較外在的影響因子"
    } ]
  }, {
    "tStartMs": 1246511,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "當然不會有人去做這件事情"
    } ]
  }, {
    "tStartMs": 1247980,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "只是說這個東西如果要被挑戰的話"
    } ]
  }, {
    "tStartMs": 1249881,
    "dDurationMs": 935,
    "segs": [ {
      "utf8": "是可以被挑戰的"
    } ]
  }, {
    "tStartMs": 1250816,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "在最後一 Part"
    } ]
  }, {
    "tStartMs": 1251783,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "我覺得我們可以回到個人的職涯部分"
    } ]
  }, {
    "tStartMs": 1254586,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "就是在做這份工作之前"
    } ]
  }, {
    "tStartMs": 1255921,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "你心中對於法醫這個角色是有一些想像的嗎"
    } ]
  }, {
    "tStartMs": 1258924,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "就是你那個時候有沒有希望自己"
    } ]
  }, {
    "tStartMs": 1260993,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "成為什麼樣子的法醫"
    } ]
  }, {
    "tStartMs": 1262461,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "其實我一樣我是從影集上得到的法醫這個概念"
    } ]
  }, {
    "tStartMs": 1266031,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "可是你看很多法醫的影集"
    } ]
  }, {
    "tStartMs": 1267399,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "除非它是以法醫為主的角色"
    } ]
  }, {
    "tStartMs": 1269468,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "如果不是的話"
    } ]
  }, {
    "tStartMs": 1270335,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "像 CSI 這種的話法醫出現大概 5 分鐘吧"
    } ]
  }, {
    "tStartMs": 1271503,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "像 CSI 這種的話法醫出現大概 5 分鐘吧"
    } ]
  }, {
    "tStartMs": 1272738,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "比較片面一點"
    } ]
  }, {
    "tStartMs": 1273839,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "對 我也知道說法醫本來所佔的角色 地位"
    } ]
  }, {
    "tStartMs": 1278343,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "就是一個你只要把你的遺體"
    } ]
  }, {
    "tStartMs": 1280712,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "提供了證據給負責人就好"
    } ]
  }, {
    "tStartMs": 1283148,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "所以我其實一開始就知道說"
    } ]
  }, {
    "tStartMs": 1284383,
    "dDurationMs": 2435,
    "segs": [ {
      "utf8": "法醫本來就不是整個案件的中心"
    } ]
  }, {
    "tStartMs": 1286818,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "因為以目前的科技發展來說"
    } ]
  }, {
    "tStartMs": 1288787,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "不可能只有遺體可以講證據"
    } ]
  }, {
    "tStartMs": 1290789,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "這個案件還是需要倚賴現場的狀況"
    } ]
  }, {
    "tStartMs": 1293058,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "尤其像台灣監視器很方便"
    } ]
  }, {
    "tStartMs": 1294826,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "所以調查監視器就是警察或是監視單位的工作"
    } ]
  }, {
    "tStartMs": 1298163,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "像這種需要綜合所有東西的情況下"
    } ]
  }, {
    "tStartMs": 1300565,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "其實法醫的角色就是你只要做好你的本分就好"
    } ]
  }, {
    "tStartMs": 1303368,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "那樣子不會有一種我自己是一個小螺絲的感覺"
    } ]
  }, {
    "tStartMs": 1307039,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "然後很沒有主體性嗎"
    } ]
  }, {
    "tStartMs": 1308473,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "就是這樣才能把這個工作做好"
    } ]
  }, {
    "tStartMs": 1310809,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "因為你知道你自己該做的事在那邊"
    } ]
  }, {
    "tStartMs": 1312611,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "而不要去過度膨大自己的工作"
    } ]
  }, {
    "tStartMs": 1316315,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "不要把自己看得太大了"
    } ]
  }, {
    "tStartMs": 1317649,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "譬如說像如果剛才一開始第一張"
    } ]
  }, {
    "tStartMs": 1319318,
    "dDurationMs": 2435,
    "segs": [ {
      "utf8": "我就跟你說這就是某一把水果刀之類刺出來的"
    } ]
  }, {
    "tStartMs": 1321753,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "這樣反而會影響到"
    } ]
  }, {
    "tStartMs": 1323088,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "對 就是"
    } ]
  }, {
    "tStartMs": 1325457,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "對 就類似這種"
    } ]
  }, {
    "tStartMs": 1326224,
    "dDurationMs": 3104,
    "segs": [ {
      "utf8": "所以我覺得就是反過來是應該讓自己更健全說"
    } ]
  }, {
    "tStartMs": 1329328,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "對 就是這一類的證據為主"
    } ]
  }, {
    "tStartMs": 1330929,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "假設今天有一個觀眾他是期望去從事法醫的"
    } ]
  }, {
    "tStartMs": 1334533,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "或者是可能他剛當上法醫好了"
    } ]
  }, {
    "tStartMs": 1336835,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "你會想要對這些後輩說什麼樣的話嗎"
    } ]
  }, {
    "tStartMs": 1339037,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "前輩以前都講就是說幫死者說話"
    } ]
  }, {
    "tStartMs": 1341640,
    "dDurationMs": 3236,
    "segs": [ {
      "utf8": "但我其實一直都覺得其實最主要的是"
    } ]
  }, {
    "tStartMs": 1344876,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "你能不能把事情解決"
    } ]
  }, {
    "tStartMs": 1347079,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "所謂的解決是說這件案件最主要的兩個個體"
    } ]
  }, {
    "tStartMs": 1350849,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "一個是檢察官"
    } ]
  }, {
    "tStartMs": 1352117,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "檢察官如果有任何意見"
    } ]
  }, {
    "tStartMs": 1353352,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "你要想辦法解決檢察官的問題"
    } ]
  }, {
    "tStartMs": 1355520,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "第二個是家屬"
    } ]
  }, {
    "tStartMs": 1356755,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "家屬如果有任何意見你要解決家屬的問題"
    } ]
  }, {
    "tStartMs": 1359424,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "如果都沒有的話"
    } ]
  }, {
    "tStartMs": 1361159,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "這個人怎麼死的"
    } ]
  }, {
    "tStartMs": 1362294,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "其實我反而覺得它沒有這麼重要"
    } ]
  }, {
    "tStartMs": 1365030,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "也就是說檢察官的證據確鑿了"
    } ]
  }, {
    "tStartMs": 1367699,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "家屬也沒有任何疑慮"
    } ]
  }, {
    "tStartMs": 1369101,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "但為什麼我要去很執著堅持說"
    } ]
  }, {
    "tStartMs": 1371603,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "我一定要知道說這個人怎麼死的"
    } ]
  }, {
    "tStartMs": 1372971,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "然後去做進一步的檢查"
    } ]
  }, {
    "tStartMs": 1375140,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "我覺得這個部分其實反過來"
    } ]
  }, {
    "tStartMs": 1377042,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "應該是心態上的問題"
    } ]
  }, {
    "tStartMs": 1378643,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "因為我知道有些人想要從事法醫"
    } ]
  }, {
    "tStartMs": 1380679,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "就說看到影集好帥"
    } ]
  }, {
    "tStartMs": 1382280,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "就是找到某個關鍵證據就一定知道他怎麼死的"
    } ]
  }, {
    "tStartMs": 1384983,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "可是我覺得這時候你是不是應該先考慮到"
    } ]
  }, {
    "tStartMs": 1387719,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "家屬的心情"
    } ]
  }, {
    "tStartMs": 1388720,
    "dDurationMs": 4104,
    "segs": [ {
      "utf8": "因為我覺得活著的人才是最主要需要注意的人"
    } ]
  }, {
    "tStartMs": 1392824,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "而不是死者"
    } ]
  }, {
    "tStartMs": 1394092,
    "dDurationMs": 434,
    "segs": [ {
      "utf8": "對"
    } ]
  }, {
    "tStartMs": 1394526,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "好 今天非常謝謝小菊精彩的分享"
    } ]
  }, {
    "tStartMs": 1396495,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "這集就先到這邊"
    } ]
  }, {
    "tStartMs": 1397596,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "如果大家喜歡今天影片不要忘了把它分享出去"
    } ]
  }, {
    "tStartMs": 1399331,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "或是可以點這個地方看看其他相關影片"
    } ]
  }, {
    "tStartMs": 1401466,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "那麼今天的志祺七七就到這邊告一段落"
    } ]
  }, {
    "tStartMs": 1403068,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "我們就明晚再見囉"
    } ]
  }, {
    "tStartMs": 1404369,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "掰掰"
    } ]
  } ]
}
